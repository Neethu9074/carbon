{
  // Place your ui-client workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.

  "Import CSS module locals": {
    "prefix": "implocals",
    "body": "import locals from './$TM_FILENAME_BASE.mless';"
  },
  "classNameLocals": {
    "prefix": "cnl",
    "body": ["className={locals.$0}"],
    "description": "Add className."
  },
  "classNameJoin": {
    "prefix": "cnj",
    "body": ["className={classNames(locals.$1, locals.$0)}"],
    "description": "Join several classnames."
  },
  "classNameEvaluate": {
    "prefix": "cne",
    "body": ["className={classNames({\n[locals.$1]: $2, \n[locals.$3]: $4})}"],
    "description": "Evaluate class names by condition."
  }
}

:local {
  .wrapper {
    padding: 1rem;
    background: #acbec3;
  }

  .header {
    margin: 0 0 2rem;
  }

  .violationsForEntity {
    padding: 1rem;
    background: #fff;
    min-height: 100%;
  }

  .event {
    padding: 1rem;
    border-top: 1px solid var(--ids-color-option-neutral-400);
    background: var(--ids-color-option-neutral-50);
    color: var(--ids-color-option-neutral-600);
    display: flex;
    align-items: center;
  }

  .duration {
    margin: 0 1rem 0 0;
    min-width: 4rem;
    display: block;
  }

  .metric {
    margin: 0 1rem 0 0;
    min-width: 4rem;
    display: block;
    font-weight: 500;
  }

  .icon {
    margin: 0 1rem 0 0;
  }

  .title {
    font-weight: 500;
    font-size: 0.85rem;
  }
}

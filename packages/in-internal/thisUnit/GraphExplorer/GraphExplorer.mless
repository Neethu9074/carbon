@import '~in-themes/active.less';

:local {
  .view {
    position: absolute;
    top: 3rem;
    bottom: 0;
    left: 0;
    right: 0;

    margin: 1rem;
    box-shadow: 0px 0px 25px 0px rgba(0, 0, 0, 0.1);
  }

  .map {
    margin-top: 1rem;
  }

  .input {
    width: 20rem;
  }

  .flexWrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .incomingList,
  .outgoingList {
    display: flex;
    flex-direction: column;

    margin: 0;
    padding: 0;
  }

  .incomingList {
    align-items: flex-end;
  }

  .outgoingList {
    align-items: flex-start;
  }

  .listItem {
    list-style: none;
  }

  .entry {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.25rem 0.5rem;
    margin: 0.125rem;

    border-radius: 3px;
    background: @lib__colors__N200;
    color: @lib__colors__N800Dark;
    cursor: pointer;

    &:hover {
      background: @lib__colors__N300;
    }
  }

  .outEntry {
    justify-content: flex-end;
    flex-direction: row-reverse;
  }

  .relation {
    margin: 0 0.5rem;
    text-transform: uppercase;
  }

  .inIcon,
  .outIcon {
    position: absolute;
    top: 0.25rem;

    fill: @lib__colors__N500;
  }

  .inIcon {
    left: ~'calc(100% + 1rem)';
  }

  .outIcon {
    right: ~'calc(100% + 1rem)';
  }
}

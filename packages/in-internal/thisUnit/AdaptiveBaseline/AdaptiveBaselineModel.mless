:local {
  .view {
    padding: 1rem;
  }

  .header {
    display: flex;
    align-items: center;
  }

  .input {
    width: 20rem;
    margin-right: 0.25rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    padding-bottom: 24px;
  }

  .codeWrapper {
    margin-top: 2rem;
  }
}

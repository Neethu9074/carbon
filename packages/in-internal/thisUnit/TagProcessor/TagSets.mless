:local {
  .view {
    margin-bottom: 5rem;
  }

  .inputs {
    display: flex;
    flex-direction: row;
  }

  .input {
    font-family: monospace;
  }

  .rawTagSet {
    max-height: 30rem;
    overflow: scroll;
  }

  .diff {
    font-family: monospace;
    display: flex;
    flex-direction: row;
  }

  .changes {
    display: flex;
    flex-direction: column;
  }

  .changeOverflow {
    display: flex;
    flex-direction: row;
  }
}

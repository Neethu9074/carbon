@import '~in-themes/active.less';

:local {
  .stickyHeader {
    background: @lib__colors__N050;
    border-bottom: 1px solid @lib__colors__N300;
    height: 3.5rem;
  }

  .wrapper {
    margin: 0 1rem 1rem;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: center;

    margin: 1rem 0 3rem;
  }

  .links {
    font-size: 1rem;
  }

  .subTitle {
    font-weight: bold;
    margin: 0.313rem 0;
  }
}

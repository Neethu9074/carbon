:local {
  .list {
    font-size: 0.9rem;
  }

  .item + .item {
    margin-top: 0.5rem;
  }

  .item > .list {
    margin: 0.6rem 0 1rem;
  }

  .title {
    font-weight: 500;
  }

  .description {
    margin: 0.2rem 0 0;
    font-weight: 300;
    font-size: 0.8rem;
  }
}

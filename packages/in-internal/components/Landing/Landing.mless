@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0 2rem;
    border-top: 1px solid @lib__colors__N300;
  }

  .tip {
    display: block;
    margin: 0 auto;
    max-width: 60rem;

    font-size: 1rem;
    line-height: 1.4;
    font-style: italic;
    text-align: center;
    font-weight: 300;
  }
}

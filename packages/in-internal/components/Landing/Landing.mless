:local {
  .header {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1rem 0 3rem;
  }

  .tip {
    display: block;
    margin: 0 auto;
    max-width: 60rem;

    font-size: 1rem;
    line-height: 1.4;
    font-style: italic;
    text-align: center;
    font-weight: 300;
  }
}

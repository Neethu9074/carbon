:local {
  .zones {
    display: flex;
    justify-content: center;
  }

  .zone {
    display: inline-block;
    margin: 0 2rem;
  }

  .sleepy {
    opacity: 0.5;
  }

  .label {
    font-weight: lighter;
    font-size: 0.9rem;
    text-transform: uppercase;
  }

  .time {
    font-weight: normal;
    font-size: 2rem;
    // we do not want a monospace font. But at the same time we do not want
    // the presentation to be jumpy on number / time changes
    min-width: 6rem;
    margin-bottom: 0;
  }
}

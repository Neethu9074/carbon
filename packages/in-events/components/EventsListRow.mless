@import '~in-themes/mixins.less';
@import '~in-themes/mediaQueries.less';

:local {
  .entityWrapper {
    display: flex;
    align-items: center;
    max-width: 100%;
  }

  .entityIcon {
    margin-right: 0.313rem;
    flex-shrink: 0;
    fill: black;
  }

  .text,
  .smallColumn,
  .title {
    .ellipsis();
  }

  .title {
    max-width: 40rem;
  }

  @media @min-medium-screen {
    .smallColumn {
      max-width: 25rem;
    }
  }

  .timelineWrapper {
    position: relative;

    height: 10px;

    overflow: hidden;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--ids-color-option-neutral-600);
    border-radius: var(--ids-border-radius-option-large);
  }

  .smallColumn {
    max-width: 18rem;
  }
}

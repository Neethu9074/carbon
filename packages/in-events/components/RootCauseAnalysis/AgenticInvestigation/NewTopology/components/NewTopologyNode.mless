:local {
  .NodeBase {
    cursor: pointer;
  }

  .selectedNode {
    border: 4px solid var(--cds-link-inverse-hover);
  }

  .rootCauseEntityNode {
    background: var(--cds-link-visited);
    border: 0.0625rem var(--cds-link-visited) solid;
  }

  .rootCauseEntityNode:hover {
    background: var(--cds-link-inverse-visited);
  }

  .rootCauseEntityNode:active {
    background: var(--cds-link-inverse-visited);
  }

  .rootCauseEntityNode:focus {
    background: var(--cds-link-inverse-visited);
  }

  .triggeringEntityNode {
    background: var(--cds-link-inverse-hover);
    border: 0.0625rem var(--ids-color-option-blue-400) solid;
  }

  .regularNode {
    background: var(--ids-color-option-blue-100);
    border: 0.0625rem var(--ids-color-option-blue-400) solid;
  }

  .healthIcon {
    position: absolute;
    left: 3.2rem;
    cursor: pointer;
  }

  .nodeWrapper {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
}

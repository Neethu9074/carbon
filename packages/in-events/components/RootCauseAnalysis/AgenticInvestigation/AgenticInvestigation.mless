:local {
  .investigateContainer {
    // TODO: remove this once we get rid of row and columns.
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .cardWithBorder {
    border: 1px solid var(--cds-layer-accent);
    height: 100%;
    :global .c4p--card__header-wrapper {
      height: 100%;
      display: flex;
      flex-direction: column;

      :global .c4p--card__title-container {
        width: 100%;

        :global .c4p--card__title {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        :global .cds--tag {
          margin: 0;
        }
      }

      :global .c4p--card__body {
        height: 100%;
      }
    }
  }

  .grid {
    padding: 0;
  }
}

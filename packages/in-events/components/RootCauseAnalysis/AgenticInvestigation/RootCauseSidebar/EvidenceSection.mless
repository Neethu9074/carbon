:local {
  .evidenceContainer {
    display: flex;
    flex-direction: column;
  }

  .evidenceColumns {
    display: flex;
    flex-direction: row;
  }

  .evidenceColumn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.75rem;
  }

  .percentValue {
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
}

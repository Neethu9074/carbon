@import '~in-themes/mixins.less';

:local {
  .entityLink {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--cds-spacing-02);
  }

  .treeView {
    display: flex;
    align-items: center;
    width: 24px;
    height: 24px;
    position: relative;
  }

  .verticalLine {
    position: absolute;
    width: 2px;
    height: 32px;
    background-color: var(--cds-border-subtle-02, #e0e0e0);
    left: 50%;
    transform: translateX(-50%);
  }

  .verticalLineShort {
    position: absolute;
    width: 2px;
    height: 16px;
    background-color: var(--cds-border-subtle-02, #e0e0e0);
    left: 50%;
    transform: translateX(-50%) translateY(-50%);
  }

  .horizontalLine {
    position: absolute;
    height: 2px;
    width: 52%;
    background-color: var(--cds-border-subtle-02, #e0e0e0);
    right: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  .decorator {
    display: inline-flex;
    max-width: 90%;
    align-items: center;
    border-radius: 6rem;

    > .decoratorLabel {
      font-size: var(--cds-label-01-font-size, 0.75rem);
      font-weight: var(--cds-label-01-font-weight, 400);
      line-height: var(--cds-label-01-line-height, 1.33333);
      letter-spacing: var(--cds-label-01-letter-spacing, 0.32px);
      position: relative;
      display: inline-flex;
      height: 1.5rem;
      align-items: center;
      padding: 0 0.5rem;
      border-width: 0.0625rem 0 0.0625rem 0.0625rem;
      border-style: solid;
      border-color: var(--cds-border-subtle-02, #e0e0e0);
      border-radius: 6rem 0 0 6rem;
      background-color: var(--cds-layer, #f4f4f4);
      color: var(--cds-text-secondary, #525252);
      line-height: 1.8;
      gap: 0.25rem;
    }

    > .decoratorValue {
      font-size: var(--cds-label-01-font-size, 0.75rem);
      font-weight: var(--cds-label-01-font-weight, 400);
      line-height: var(--cds-label-01-line-height, 1.33333);
      letter-spacing: var(--cds-label-01-letter-spacing, 0.32px);
      position: relative;
      display: inline-flex;
      overflow: hidden;
      height: 1.5rem;
      align-items: normal;
      padding: 0 0.5rem;
      border-width: 0.0625rem 0.0625rem 0.0625rem 0.0625rem;
      border-style: solid;
      border-color: var(--cds-border-subtle-02, #e0e0e0);
      border-radius: 0 6rem 6rem 0;
      background-color: var(--cds-layer-01, #f4f4f4);
      line-height: 1.8;
      .ellipsis();
      max-width: 200px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .labelText {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    width: 100%;
  }
}

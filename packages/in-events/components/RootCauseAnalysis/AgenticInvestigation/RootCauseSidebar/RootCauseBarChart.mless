:local {
  .container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .chartContent {
    display: flex;
    flex-direction: column;
  }

  .barGroup {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .label {
    width: 5rem;
    text-align: left;
    flex-shrink: 0;
    color: #525252;
  }

  .barWrapper {
    flex: 1;
    display: flex;
    position: relative;
  }

  .barContainer {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
  }

  .rootCauseBar {
    height: 1rem;
    background-color: #6929c4; /* Carbon purple70 */
    transition: width 0.3s ease;
  }

  .otherEntitiesBar {
    height: 1rem;
    background-color: #e8daff; /* Carbon purple20 */
    transition: width 0.3s ease;
  }

  .skeletonBar {
    height: 1rem;
  }

  .valueLabel {
    margin-left: 0.5rem;
    white-space: nowrap;
  }

  .axisLine {
    width: 1px;
    background-color: var(--cds-layer-accent);
    align-self: stretch;
    margin-right: 0;
  }
}

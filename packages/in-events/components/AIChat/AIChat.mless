:local {
  .aiChatDraggableButton {
    position: fixed;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: var(--ids-z-index-option-overlays);
    color: #fff;
    border-radius: 28px;
    width: 57px;
    height: 57px;
    right: 30px;
    bottom: 30px;
    --cds-layout-density-padding-inline-local: none;
    border-radius: 30px 30px 10px 30px;

    &:hover {
      .draggableSvg {
        background: var(--cds-button-primary-hover);
      }
    }

    &:active {
      box-shadow: 0 0 0 3px var(--cds-button-primary-active, #002d9c), inset 0 0 0 2px white;
      .draggableSvg {
        background: var(--cds-button-primary-active);
        cursor: move;
      }
    }
  }

  .draggableSvg {
    position: absolute;
    margin-left: 34px;
    margin-top: 34px;
    padding: 5px;
    border-radius: 5px 10px 5px 10px;
    transform: rotate(90deg);
    background: var(--cds-button-primary);
    cursor: move;
  }

  .previewPill:global(.cds--tag) {
    position: absolute;
    margin-top: -1.9rem;
    right: 5rem;
  }

  .watsonXInfo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .previewDisclaimer {
    margin-top: 1rem;
    color: var(--cds-text-secondary);
  }

  .modelSection {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--cds-border-subtle);
    display: flex;
    flex-direction: column;
  }

  .graniteLink {
    display: inline-flex;
    align-items: center;
    color: var(--cds-link-primary);
    cursor: pointer;

    &:hover {
      color: var(--cds-link-primary-hover);
      text-decoration: underline;
    }
  }

  .launchIcon {
    margin-inline-start: 0.5rem;
    display: inline-flex;
    align-self: center;
  }

  .secondaryTitle {
    color: var(--cds-text-secondary);
  }
}

:local {
  .showHidButton {
    display: inline;
    color: var(--cds-link-primary, #0f62fe);
    margin-left: 5px;
    cursor: pointer;
  }

  .panel {
    height: 32rem;
    overflow: auto;
  }

  .listHeader {
    :global(.cds--contained-list__header) {
      display: none;
    }
  }

  .tabsWidth {
    :global(.cds--tab--list) {
      width: 100%;
    }
  }

  .tabHeader {
    :global(.cds--tabs__nav-item-label-wrapper) {
      justify-content: center;
    }
  }
}

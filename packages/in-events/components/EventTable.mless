:local {
  .closeIcon {
    cursor: pointer;
    fill: var(--ids-color-option-neutral-500);
    display: block;
    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .icon {
    margin-right: 0.5rem;
  }

  .centerAlignLink {
    display: flex;
    align-items: center;
  }

  .incidentHeader {
    background: var(--cds-layer);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .container {
    display: inline-flex;
    margin-right: 1rem;
  }

  .label {
    font-weight: bold;
    font-size: 0.75rem;
    line-height: 1rem;
    margin-right: 0.25rem;
    text-transform: capitalize;
  }

  .entityIcon {
    margin: 0.0625rem 0.25rem 0;
    fill: @lib__colors__primary2;
  }

  .entity {
    display: inline-flex;
    align-items: center;
  }

  .link {
    white-space: normal;
    text-overflow: ellipsis;
    .breakWord();
  }
}

@import '~in-themes/mixins.less';

:local {
  .item {
    max-width: 15rem;
    display: block;
    font-weight: 400;
    font-size: 0.8rem;

    &.active {
      .label {
        font-weight: bold;
      }
    }
  }

  .label {
    display: block;
    max-width: 100%;
    .ellipsis();
  }

  .secondRow {
    display: flex;
    justify-content: space-between;
    margin: 0.3rem 0 0;
    color: var(--ids-color-option-neutral-700);
  }
}

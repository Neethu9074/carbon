@import '~in-themes/mediaQueries.less';

:local {
  .navigatorSplitScreen {
    display: flex;
    height: 100%;
  }

  .navigator {
    width: 20rem;
    flex-grow: 0;
    flex-shrink: 0;
    border-right: 1px solid #d5dfe4;
    z-index: 125;
  }

  .dialogIndex:has(:global(.carbonDeleteModalOpen)) {
    z-index: calc(var(--ids-z-index-option-dialog) - 6);
  }

  .detailView {
    width: ~'calc(100% - 20rem)';

    &.useFullWidth {
      width: ~'calc(100% - 3rem)';
    }
  }

  .header {
    background: var(--ids-color-option-neutral-50);
    padding: 0.5rem 1rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .toggleBar {
    width: 3rem;
    border-right: 1px solid #d5dfe4;
    z-index: 125;
  }

  .toggleWrapper {
    background: var(--ids-color-option-neutral-50);
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0;
  }

  .toggle,
  .next,
  .prev {
    cursor: pointer;
    fill: var(--ids-color-option-neutral-500);
    display: block;

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .actions .toggle {
    margin-left: 1rem;
  }

  .actions {
    display: flex;
    align-items: center;
  }
}

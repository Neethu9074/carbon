:local {
  .icon {
    margin-right: 0.125rem;
  }

  .aggregatedEntityListSkeleton {
    margin-top: 0;
    display: block;
    width: 100%;
    height: 2.5rem;
  }

  .collapsibleContent {
    padding: 0rem 1rem;
  }

  .cardPadding {
    :global .card-header {
      padding-left: 1rem;
    }
    padding-left: 0rem;
    padding-right: 0rem;
  }

  .withPadding {
    padding: 0 1rem;
  }
}

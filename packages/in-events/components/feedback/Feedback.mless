:local {
  .feedbackImage {
    width: 34.375rem;
  }

  .feedbackButtomImg {
    width: 2rem;
  }

  .feedbackButton {
    background: var(--ids-color-option-neutral-100);
  }

  .feedbackDescription {
    color: var(--ids-color-option-neutral-500);
  }
  .feedbackTextArea {
    width: 95%;
    height: 5rem;
  }
  .dialog {
    width: 42rem;
  }
  .dialogContent {
    padding-left: 1.75rem;
    padding-bottom: 6rem;
  }
  .dialogContentNoPadding {
    padding-bottom: 6rem;
  }
  .loadingEnd {
    background: var(--ids-color-option-blue-400);
    height: 0.3rem;
  }
  .controls {
    padding: 1rem 0;
    position: absolute;
    bottom: 0;
    right: 0;
    left: 0;

    button {
      min-width: 6.25rem;
    }
  }
  .inputContainer {
    width: 100%;
  }
}

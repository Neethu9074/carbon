:local {
  .timelineColumn {
    max-width: 18.75rem;
    min-width: 6.25rem;
  }

  .widgetCard {
    width: 100%;
    height: 100%;
    overflow: auto;
    min-height: 20rem;
  }

  .carbonLoadMore {
    &:hover {
      background: #fff;
    }
    display: grid;
  }

  .topRowGap {
    width: 100%;
    padding-left: 1rem;
    color: white;
  }

  .topRowBorder {
    background-color: #0f62fe;
  }

  .divider {
    height: 1rem;
    width: 0.0625rem;
    background-color: white;
  }

  .failedEventTable {
    max-height: 20rem;
    overflow-y: scroll;
  }
}

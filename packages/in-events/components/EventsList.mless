@import '~in-themes/active.less';
@import '~in-themes/mediaQueries.less';

:local {
  .noEvents {
    text-align: center;
    font-style: italic;
  }

  .entityWrapper {
    display: flex;
    align-items: center;
    max-width: 100%;
  }

  .entityIcon {
    margin-right: 0.313rem;
    flex-shrink: 0;
    fill: black;
  }

  .text,
  .title {
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .title {
    max-width: 15rem;
  }

  @media @min-medium-screen {
    .title {
      max-width: 22rem;
    }
  }

  .icon {
    fill: @lib__colors__N700Medium;
  }
}

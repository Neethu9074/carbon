:local {
  .timeline {
    width: 100%;
    padding: 0.2rem 0;
  }

  .probabilityPill {
    width: fit-content;
    height: 1.365rem;
    padding: 0.25rem 0.5rem;
  }
  .techPreviewPill {
    height: fit-content;
    background-color: var(--ids-color-option-blue-400);
  }
  .rcaAIPill {
    height: fit-content;
    background-color: #8257d933;
  }
  .rcaAIPill > span {
    color: var(--ids-color-option-deep-purple-500);
  }
  .rcaRegenerate {
    height: fit-content;
  }
  .errorMessageContainer {
    width: 28rem;
  }
  .entityDescription {
    background: var(--ids-color-option-neutral-50);
    border: 0.1rem var(--ids-color-option-neutral-300) solid;
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 0.25rem;
    width: 99.4%;
  }
  .confidencePilled {
    margin-left: auto;
  }

  .highProbabilityText {
    color: var(--ids-color-option-green-800);
  }
  .moderateProbabilityText {
    color: var(--ids-color-option-yellow-800);
  }
  .lowProbabilityText {
    color: var(--ids-color-option-red-700);
  }
  .naProbabilityText {
    color: var(--ids-color-option-neutral-800);
  }
  .highProbabilityText,
  .moderateProbabilityText,
  .lowProbabilityText,
  .naProbabilityText {
    line-height: 0.875rem;
  }
  .loadingEntity {
    width: 2.8rem;
    height: 1rem;
  }
  .alertChannelsList {
    width: 100%;
    margin-top: -2rem;
  }
  .containerForIncidentSummaryBullets {
    width: 100%;
  }
}

:local {
  .timeline {
    width: 100%;
    padding: 0.2rem 0;
  }

  .probabilityPill {
    width: fit-content;
    height: 1.375rem;
    padding: 0.25rem 0.5rem;
  }
  .techPreviewPill {
    height: fit-content;
  }
  .rcaAIPill {
    height: fit-content;
    background-color: #8257d933;
  }
  .rcaAIPill > span {
    color: var(--ids-color-option-deep-purple-500);
  }
  .cardIndicator {
    height: 0.25rem;
    border-radius: 0.5rem 0.5rem 0 0;
    background: var(--ids-color-option-deep-purple-500);
  }
  .rcaRegenerate {
    height: fit-content;
  }
  .errorMessageContainer {
    width: 28rem;
  }
  .entityDescription {
    border-radius: 0.25rem;
    width: 99.4%;
  }
  .tabPanel {
    background: var(--ids-color-option-neutral-50);
  }
  .confidencePilled {
    margin-left: auto;
  }

  .highProbabilityText {
    color: var(--ids-color-option-green-800);
  }
  .moderateProbabilityText {
    color: var(--ids-color-option-yellow-800);
  }
  .lowProbabilityText {
    color: var(--ids-color-option-red-700);
  }
  .naProbabilityText {
    color: var(--ids-color-option-neutral-800);
  }
  .primaryProbabilityHeader {
    background: #8257d933;
  }
  .highProbabilityHeader {
    background: var(--ids-color-option-green-100);
  }
  .moderateProbabilityHeader {
    background: var(--ids-color-option-yellow-100);
  }
  .lowProbabilityHeader {
    background: var(--ids-color-option-red-100);
  }
  .infraLineDown {
    position: relative;
    width: 0.125rem;
    height: 0.625rem;
    background-color: var(--ids-color-option-neutral-400);
  }

  .infraLineRight {
    position: relative;
    width: 0.625rem;
    height: 0.125rem;
    background-color: var(--ids-color-option-neutral-400);
  }

  .highProbabilityText,
  .moderateProbabilityText,
  .lowProbabilityText,
  .naProbabilityText {
    line-height: 0.875rem;
  }
  .loadingEntity {
    width: 2.8rem;
    height: 1rem;
  }
  .alertChannelsList {
    width: 100%;
    margin-top: -2rem;
  }
  .containerForIncidentSummaryBullets {
    width: 100%;
  }
  .regenerateButton {
    width: fit-content;
  }
  .cardIndicator {
    height: 0.25rem;
    border-radius: 0.5rem 0.5rem 0 0;
  }
  .associatedEventsCardHeader {
    cursor: pointer;
    background: var(--ids-color-option-neutral-50);
    padding: 0;
  }
  .associatedEventsCard {
    background: var(--ids-color-option-neutral-50);
    padding: 0;
    min-height: 0;
  }
  .sectionLine {
    height: 0.063rem;
    width: 100%;
    background: var(--ids-color-option-neutral-300);
    margin-bottom: 0.5rem;
    margin-top: 0.75rem;
  }
  .analyzeButton {
    width: fit-content;
  }

  .cardWithoutPadding {
    padding: 0.5rem 1rem;
  }
  .innerRCACard {
    background: var(--ids-color-option-neutral-50);
    padding: 1rem;
  }
  .failureTextWrapper {
    max-width: 43.75rem;
  }

  .layerBackground {
    background: var(--cds-layer);
  }

  .accordionContent {
    padding: 0 1rem;
  }

  .noShrink {
    flex-shrink: 0;
  }

  .feedbackContainer {
    padding: 0 1rem;
    background: var(--cds-layer);
  }

  .descriptionText {
    p {
      margin-bottom: 0;
    }
  }

  .hovered {
    background: var(--cds-layer-hover);
  }
}

@import '~in-themes/active.less';

:local {
  .timeline {
    width: 100%;
    padding: 0.2rem 0;
  }
  .rcaAIMessage {
    color: @lib__colors__deep-purple800;
    background-color: #e6ddf7; //Above colour tinted to 20% opactiy
    padding: 0 0.25rem;
  }
  .rcaRegenerate {
    height: fit-content;
  }
  .errorMessageContainer {
    width: 28rem;
  }
  .errorImg {
    width: 3rem;
  }
  .entityDescription {
    background: var(--ids-color-option-neutral-50);
    border: 0.1rem var(--ids-color-option-neutral-300) solid;
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 0.25rem;
    width: 99.4%;
  }
}

@import '~in-themes/active.less';

:local {
  .inEventViewIncidentEventListItem {
    --time-indicator-margin-right: 0.625rem;
    --time-indicator-width: 4rem;
    --background-left: 0.438rem;
    --right-max-width: calc(
      100% - var(--time-indicator-margin-right) - var(--time-indicator-width) - var(--background-left)
    );

    position: relative;

    display: flex;
    align-items: stretch;
    justify-content: space-between;

    &:first-child {
      .line {
        top: 1.375rem;
      }
    }

    &:last-child {
      .line {
        bottom: ~'calc(100% - 1.375rem)';
      }
    }
  }

  .serviceImpact {
    margin-top: 1.5rem;

    .line {
      top: -1.5rem;
    }
  }

  .timeIndicator {
    position: relative;
    margin-right: var(--time-indicator-margin-right);
    min-width: var(--time-indicator-width);
    max-width: var(--time-indicator-width);
  }

  .time,
  .line,
  .dot {
    position: absolute;
  }

  .time {
    top: 1rem;
    text-decoration: underline;
  }
  .skeletonTime {
    width: 3.5rem;
  }

  .triggeringTime {
    font-weight: bold;
  }

  .line {
    top: 0;
    bottom: 0;
    right: -2px;
    width: 2px;
    background-color: #d5dfe4;
  }

  .dot {
    top: 1.375rem;
    right: -0.188rem;

    background: #6b8088;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: var(--ids-border-radius-option-round);
  }

  .right {
    position: relative;
    border: 0.1rem solid transparent; // so the card doesn't expand when user hovers over event in timeline
    width: 100%;
    max-width: var(--right-max-width);
    margin-bottom: 0.25rem;

    transition: background 0.25s ease-in-out;
    &--highlighted {
      background: yellow !important;
    }
  }

  .leftBorder,
  .background {
    position: absolute;
    top: 0;
    bottom: 0;
  }

  .background {
    right: 0;
    left: var(--background-left);
    z-index: 1;
    opacity: 0.1;
    border-radius: 0 0.25rem 0.25rem 0;

    transition: opacity 0.25s ease-in-out;
    .in-event-view-incident-event-list-item:hover & {
      opacity: 0.3;
    }
  }

  .leftBorder {
    left: 0;
    width: 0.438rem;
    z-index: 2;
    opacity: 0.3;
    border-top-left-radius: 0.25rem;
    border-bottom-left-radius: 0.25rem;

    transition: opacity 0.25s ease-in-out;
    .in-event-view-incident-event-list-item:hover & {
      opacity: 0.5;
    }
  }

  .border {
    height: 1px;
    width: ~'calc(100% - .438rem)';
    margin-left: 0.438rem;
    opacity: 0.3;
  }

  .contentWrapper {
    position: relative; // only required for z-index stacking
    z-index: 4;
  }
  // potential for Stack component
  .heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.1rem 0.75rem 0.25rem 0.625rem;
    cursor: pointer;
  }

  .expandedDetails {
    padding: 0.5rem;
    padding-left: 1rem;
  }

  .iconWrapper {
    display: flex;
    align-items: center;
    justify-content: center;

    min-width: 1.625rem;
    min-height: 1.625rem;
    margin-right: 0.25rem;
    border-radius: var(--ids-border-radius-option-round);
  }

  .problemText {
    margin-right: 0.5rem;
  }

  .left {
    display: flex;
    align-items: center;
  }

  .entity {
    padding-left: 0.5rem;
    border-left: 1px solid #d5dfe4;
  }

  .affectedServiceMarker,
  .triggeringEventMarker {
    position: absolute;
    bottom: ~'calc(100% - 2px)';

    border-radius: var(--ids-border-radius-option-medium) var(--ids-border-radius-option-medium) 0 0;
    z-index: 3;
  }

  .affectedServiceMarker {
    left: 4.625rem;
  }

  .triggeringEventMarker {
    left: 11rem;
  }
  .highlighted {
    border: 0.1rem solid var(--ids-color-option-blue-400);
    border-radius: var(--ids-border-radius-option-medium) var(--ids-border-radius-option-medium) 0 0;
  }
}

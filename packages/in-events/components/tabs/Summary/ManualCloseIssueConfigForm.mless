:local {
  .dialog {
    max-width: 30rem;
    max-height: 32rem;
    padding-bottom: 4rem;
  }
  .description {
    color: var(--ids-color-option-neutral-600);
  }

  .comments {
    margin: 0 0 0 0rem;
  }

  .commentsTextArea {
    width: 100%;
    min-height: 11.25rem;
  }
  .red {
    color: var(--ids-color-option-red-500);
  }
  .warningBox {
    width: 100%;
  }
}

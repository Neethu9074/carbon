:local {
  .commentInputWrapperNotes {
    display: inline-flex;

    .commentInputIcon {
      position: absolute;
      right: 0;
      fill: blue;
    }
    :global(.cds--text-area) {
      border: none;
      padding: 15px 35px 15px 10px;
      resize: none;
    }
    :global(.carbonIconButton) {
      display: flex;
      align-items: center;
    }
  }

  .bumpUp {
    margin-top: -2rem;
  }

  .bumpDown {
    margin-top: 2rem;
  }
}

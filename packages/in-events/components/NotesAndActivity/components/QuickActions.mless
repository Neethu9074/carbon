:local {
  .quickActionWrapper {
    display: flex;
    padding: 1rem 1rem 0rem 1rem;
  }

  .consentWrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  // This is used for transitional effects when scrolling
  .transitionDown {
    margin-top: -2.5rem;
    padding-top: 2.5rem;
    padding-bottom: 0.5rem;
    transition: margin-top linear 0.25s;
    gap: 0.5rem;
  }

  // This is used for transitional effects when scrolling
  .extraPadding {
    padding-left: 3.125rem;
    padding-top: 4rem;
    padding-bottom: 0.5rem;
    margin-top: -3.75rem;
    transition: margin-top linear 0.25s;
  }

  .quickActionsHeader {
    font-weight: 600;
    font-size: 14px;
    padding-bottom: 0.75rem;
    display: inline-flex;
    align-items: baseline;
    width: 100%;
  }

  .feedbackWrapper {
    margin-left: auto;
  }

  .quickActionsDescription {
    font-weight: 400;
    font-size: 12px;
    color: var(--cds-text-secondary);
    padding-bottom: 1rem;
  }

  .quickActionButtonContents {
    display: block;
    padding-right: 0.625rem;
  }

  .actionsButton {
    border-radius: 25px 25px 25px 25px;
    height: 0px;
    padding-inline-end: 1.25rem;
    transition: border-color 0.25s ease;
  }

  .generating {
    display: contents;
  }
}

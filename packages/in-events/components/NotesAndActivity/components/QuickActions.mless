:local {
  .quickActionWrapper {
    display: flex;
    padding: 1rem 1rem 0rem 1rem;
  }

  .transitionDown {
    margin-top: -2.5rem;
    padding-top: 3.75rem;
    transition: margin-top linear 0.25s;
    gap: 0.5rem;
  }

  .extraPadding {
    padding-left: 3.125rem;
    padding-top: 5rem;
    margin-top: -3.75rem;
    transition: margin-top linear 0.25s;
  }

  .quickActionsHeader {
    font-weight: 600;
    font-size: 14px;
    padding-bottom: 0.75rem;
  }

  .quickActionsDescription {
    font-weight: 400;
    font-size: 12px;
    color: grey;
    padding-bottom: 1rem;
  }

  .quickActionButtonContents {
    display: block;
    padding-right: 0.625rem;
  }

  .actionsButton {
    border-radius: 25px 25px 25px 25px;
    height: 0px;
    padding-inline-end: 1.25rem;
  }
}

:local {
  .contentWrapper {
    border-top: 1px solid var(--cds-border-subtle);
  }
  .innerContent {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .experienceSection {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .followUpSection {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
}

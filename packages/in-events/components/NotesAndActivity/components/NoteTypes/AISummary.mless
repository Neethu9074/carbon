:local {
  .contentsHeader {
    font-weight: 700;
    padding-bottom: 5px;
    display: flex;
    gap: 0.5rem;
  }

  .watsonxAvatar {
    width: 25px;
  }

  .summaryList {
    display: flex;
    gap: 1rem;

    :global(.cds--popover-container) {
      margin-left: auto;
      align-items: center;
    }

    :global(.cds--inline-loading) {
      margin-left: auto;
      inline-size: unset;
    }
  }

  .summarySection {
    padding-top: 1rem;
  }

  .shareCopyWrapper {
    display: flex;
    padding-top: 0.5rem;
  }

  .bold {
    font-weight: 700;
  }

  .feedbackSurveyBtn {
    border-radius: 25px 25px 25px 25px;
    height: 0px;
    padding-inline-end: 1.25rem;
    margin-top: 0.5rem;
  }
  .surveyBtnContents {
    display: block;
    padding-right: 0.625rem;
  }
}

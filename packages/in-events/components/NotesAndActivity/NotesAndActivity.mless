:local {
  .notes {
    position: fixed;
    right: 0;
    width: 20rem;
    margin-top: 1rem;
    border-color: var(--cds-border-subtle-01);
    border-style: solid;
    border-width: 0.5px;
    background-color: var(--cds-layer-01);
  }

  .notesHeaderWrapper {
    width: 279px;
  }

  .headerWrapper {
    display: inline-flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 16px;
    line-height: 28px;
    color: var(--cds-text-primary);
  }

  .closedNotesWrapper {
    color: var(--cds-link-primary, #0f62fe);
    display: flex;
    flex-flow: row;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .notesIcon {
    padding-top: 5px;
  }

  .addNoteButton {
    width: 100%;
  }

  .loading {
    height: 75vh;
    display: flex;
    padding: 10rem;
  }

  .inputSection {
    border-bottom-color: var(--cds-border-subtle-01);
    border-bottom-style: solid;
    border-bottom-width: 0.5px;
    padding: 15px;
  }

  .notesSection {
    padding: 0px 15px 45px 15px;
    height: calc(100vh - 28rem);
    overflow: auto;
  }

  .verticalBorderNotes {
    border-left-color: var(--cds-border-subtle-01);
    border-left-style: solid;
    border-left-width: 0.5px;
    margin-top: -20px;
    margin-bottom: -20px;
  }

  .bubble {
    padding: 10px 15px 10px 15px;
    margin-top: 10px;
    margin-left: 30px;
  }

  .myBubble {
    background: var(--Notification-notification-info-background, #edf5ff);
    border-radius: 8px 0px 8px 8px;
  }

  .otherBubble {
    background: var(--Layer-accent-layer-accent-01, #e0e0e0);
    border-radius: 0px 8px 8px 8px;
  }

  .chatEntry {
    display: flex;
    padding-top: 25px;
  }

  .myChatEntry {
    justify-content: flex-end;
  }

  .chatEntryInfo {
    padding-top: 5px;
    padding-left: 5px;
  }
}

:local {
  .notesInPanel {
    position: fixed;
    display: inline-flex;
    flex-direction: column;
    height: calc(100% - 4rem);
  }

  .sidePanelContainer {
    top: 11rem;
    height: calc(100% - 11rem);
  }

  .closedNotesWrapper {
    color: var(--cds-link-primary, #0f62fe);
    display: flex;
    flex-flow: row;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    cursor: pointer;
  }

  .notesIcon {
    z-index: 100;
  }

  .searchBar {
    margin-bottom: 1rem;
  }

  .loading {
    padding: 80% 0px 0px 50%;
  }

  .emptyWrapper {
    padding-left: 2rem;
    padding-right: 2rem;
    padding-top: 10rem;
    height: 100%;
  }

  .emptyHeader {
    font-size: 24px;
    font-weight: 400;
  }

  .emptyInfo {
    line-height: 1rem;
  }

  :global(#NotesAndActivityWrapper .c4p--side-panel .c4p--side-panel__inner-content) {
    padding: 0px;
  }

  :global(#NotesAndActivityWrapper .c4p--side-panel .c4p--side-panel__inner-content--no-animated-title) {
    padding-top: 0px;
  }

  // Using this to position the expand and search buttons next to the close button
  :global(#NotesAndActivityWrapper .c4p--side-panel .c4p--side-panel__subtitle-text) {
    padding-bottom: 0px;
    position: absolute;
    top: 0;
    right: 0;
  }

  // Needed so that the header cannot continue too far right (different languages)
  // Because we are positioning additional buttons in the top right corner
  :global(#NotesAndActivityWrapper .c4p--side-panel .c4p--side-panel__title-text) {
    padding-right: 7rem;
  }
}

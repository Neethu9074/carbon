:local {
  .notesHeaderWrapper {
    // same as the notes width - right padding in the header - left padding in notes
    width: calc(26rem - 1.5rem - 15px);
  }

  .headerWrapper {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    font-size: 16px;
    line-height: 28px;
    color: var(--cds-text-primary);
  }

  .notes {
    position: fixed;
    display: flex;
    flex-direction: column;
    width: 26rem;
    margin-top: 0.75rem;
    height: calc(100% - 15rem);
    right: 0;
    border: 1px solid var(--ids-color-option-neutral-300);
    background-color: var(--cds-layer-01);
  }

  .stretch {
    width: 50rem;
  }

  .tagIconWrapper {
    display: inline-flex;
    gap: 0.5rem;
  }

  .closedNotesWrapper {
    color: var(--cds-link-primary, #0f62fe);
    display: flex;
    flex-flow: row;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    cursor: pointer;
  }

  .notesIcon {
    padding-top: 5px;
    z-index: 100;
  }

  .loading {
    padding: 80% 0px 0px 50%;
  }

  .emptyWrapper {
    padding-left: 2rem;
    padding-right: 2rem;
    padding-top: 10rem;
  }

  .emptyHeader {
    font-size: 24px;
    font-weight: 400;
  }

  .emptyInfo {
    line-height: 1rem;
  }

  .expandIcon {
    position: absolute;
    right: 0;
    top: 0;
  }

  .expandIconSearch {
    top: 2.5rem;
  }
}

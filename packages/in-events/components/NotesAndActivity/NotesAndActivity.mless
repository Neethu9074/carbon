:local {
  .notes {
    position: fixed;
    display: flex;
    flex-direction: column;
    width: 22rem;
    // New header size
    margin-top: 0.75rem;
    height: calc(100% - 15rem);
    right: 0;
    border: 1px solid var(--ids-color-option-neutral-300);
    background-color: var(--cds-layer-01);
  }

  .notesHeaderWrapper {
    // same as the notes width - right padding in the header - left padding in notes
    width: calc(22.5rem - 1.5rem - 15px);
  }

  .headerWrapper {
    display: inline-flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 16px;
    line-height: 28px;
    color: var(--cds-text-primary);
  }

  .questionIcon {
    padding-right: 10px;
  }

  .quickActionWrapper {
    display: flex;
    padding: 15px;
    box-shadow: 0 10px 30px -20px gray;
    z-index: 10;
  }

  .quickActionsHeader {
    font-weight: 600;
    font-size: 14px;
    padding-bottom: 10px;
  }

  .quickActionsDescription {
    font-weight: 400;
    font-size: 12px;
    color: grey;
    padding-bottom: 15px;
  }

  .quickActionButtonContents {
    display: block;
    padding-right: 10px;
  }

  .actionsButton {
    border-radius: 25px 25px 25px 25px;
    height: 0px;
    padding-inline-end: 20px;
  }

  .closedNotesWrapper {
    color: var(--cds-link-primary, #0f62fe);
    display: flex;
    flex-flow: row;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    cursor: pointer;
  }

  .notesIcon {
    padding-top: 5px;
  }

  .userIcon {
    fill: #595959;
  }

  .aiIcon {
    fill: white;
    background-color: var(--cds-chat-avatar-user);;
    border-radius: 25px 25px 25px 25px;
  }
  
  .aiIconSlug {
    border: 1px solid black;
  }

  .noteButtonWrapper {
    width: 50%;
    display: inline-flex;
  }

  .loading {
    height: 75vh;
    display: flex;
    padding: 10rem;
  }

  .notesSection {
    padding: 0px 15px 35px 15px;
    overflow: auto;
    display: flex;
    flex-direction: column-reverse;
    height: 100%;
  }

  .notesPresentHeight {
    height: calc(100vh - 32.25rem);
  }

  .notesEmptyHeight {
    height: calc(100vh - 29.75rem);
  }

  .bubble {
    padding: 10px 15px 10px 15px;
    margin-top: 10px;
    margin-left: 30px;
    white-space: pre-wrap;
  }

  .myBubble {
    background: var(--cds-chat-bubble-user, #edf5ff);
    border-radius: 8px 0px 8px 8px;
  }

  .otherBubble {
    background: var(--cds-chat-bubble-agent, #e0e0e0);
    border-radius: 0px 8px 8px 8px;
  }

  .ext {
    background: var(--cds-field-01, #e0e0e0);
    border-radius: 0px 8px 8px 8px;
    border: 1px solid black;
  }

  .chatEntry {
    display: flex;
    padding-top: 25px;
  }

  .myChatEntry {
    justify-content: flex-end;
  }

  .chatEntryInfo {
    padding-top: 5px;
    padding-left: 5px;
    color: var(--cds-text-secondary);
  }

  .emptyWrapper {
    padding-left: 15px;
    padding-right: 15px;
    position: relative;
  }

  .emptyHeader {
    font-size: var(--cds-heading-03-font-size, 1.25rem);
    font-weight: var(--cds-heading-03-font-weight, 400);
    line-height: var(--cds-heading-03-line-height, 1.4);
    letter-spacing: var(--cds-heading-03-letter-spacing, 0);
    padding-bottom: 0.5rem;
    margin: 0;
  }

  .emptyInfo {
    font-size: var(--cds-body-01-font-size, 0.875rem);
    font-weight: var(--cds-body-01-font-weight, 400);
    line-height: var(--cds-body-01-line-height, 1.42857);
    letter-spacing: var(--cds-body-01-letter-spacing, 0.16px);
    padding-bottom: 1rem;
    color: var(--cds-text-secondary, #525252);
  }

  .commentInputWrapperNotes {
    display: inline-flex;

    .commentInputIcon {
      position: absolute;
      right: 0;
      fill: blue;
    }
    :global(.cds--text-area) {
      border: none;
      padding: 15px 35px 15px 10px;
      resize: none;
    }
    :global(.carbonIconButton) {
      display: flex;
      align-items: center;
    }
  }
}

:local {
  .infiniteScrollingContainer {
    overflow: auto; //our scrollable table container
    position: relative; //needed for sticky header

    .table {
      .tableHeaderRow {
        display: flex;
        align-items: center;
        min-block-size: 3rem; // needed for sortable rows increasing size

        .tableHeader {
          display: flex;
          align-items: center;
        }
      }

      .tableBody {
        display: flex;
        flex-direction: column;
        position: relative;

        .tableRow {
          display: flex;
          align-items: center;
          min-block-size: 2.5rem;
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;

          .tableCell {
            height: 100%;
            > td {
              height: 100%;
            }
          }
        }
        .tableExpandedRow {
          block-size: 50rem;
        }
      }
    }
  }

  .tableToolbar {
    display: flex;
    justify-content: flex-start;
  }

  .sidePanel {
    top: 28.5rem;
    left: 4.5rem !important;
    height: calc(100vh - 465px);
    z-index: 129;

    > :global(.c4p--side-panel__inner-content) {
      padding: 0;
    }
  }

  .filterContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .filterOption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .appliedFilters {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    width: 100%;
    background: var(--cds-layer);
    padding-left: 15px;
  }

  .sidePanelAccordionTitle {
    display: flex;
    justify-content: space-between;
  }

  .emptyTable {
    width: 100%;
    padding: 2.5rem 2rem;
    background-color: var(--ids-color-option-white);
  }
}

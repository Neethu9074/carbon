:local {
  .tableContainer {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: scroll;

    :global(.cds--data-table) {
      table-layout: fixed;
      width: 100%;
    }

    .fixedTable {
      /* Ensure tables maintain their column widths */
      table-layout: fixed;
    }

    :global(.cds--table-toolbar) {
      z-index: 2;
    }
  }

  .stickyHeader {
    position: sticky;
    top: 0;
    z-index: 1;
    width: 100%;
    overflow: hidden;
  }

  .tableBody {
    overflow: auto;
    width: 100%;
    flex: 1;
    min-height: 0; /* Important for flex containers to allow scrolling */
  }

  .tableToolbar {
    display: flex;
    justify-content: flex-start;
  }

  .sidePanel {
    top: 28.5rem;
    left: 4.5rem !important;
    height: calc(100vh - 465px);
    z-index: 129;

    > :global(.c4p--side-panel__inner-content) {
      padding: 0;
    }
  }

  .filterContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .filterOption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .appliedFilters {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    width: 100%;
    background: var(--cds-layer);
    padding-left: 15px;
  }

  .sidePanelAccordionTitle {
    display: flex;
    justify-content: space-between;
  }
}

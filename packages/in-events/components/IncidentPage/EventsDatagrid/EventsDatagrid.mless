:local {
  .infiniteScrollingContainer {
    overflow: auto; //our scrollable table container
    position: relative; //needed for sticky header

    .table {
      display: grid;

      .tableHead {
        display: grid;
        position: sticky;
        top: 0;
        z-index: 1;

        .tableHeaderRow {
          display: flex;
          align-items: center;
          width: 100%;
          height: 100%;
        }
      }

      .tableBody {
        display: grid;
        position: relative;

        .tableRow {
          display: flex;
          position: absolute;
          width: 100%;

          .tableCell {
            display: flex;
            align-items: center;
          }
        }
      }
    }
  }

  .tableToolbar {
    display: flex;
    justify-content: flex-start;
  }

  .sidePanel {
    top: 28.5rem;
    left: 4.5rem !important;
    height: calc(100vh - 465px);
    z-index: 129;

    > :global(.c4p--side-panel__inner-content) {
      padding: 0;
    }
  }

  .filterContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .filterOption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .appliedFilters {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    width: 100%;
    background: var(--cds-layer);
    padding-left: 15px;
  }

  .sidePanelAccordionTitle {
    display: flex;
    justify-content: space-between;
  }

  .emptyTable {
    width: 100%;
    padding: 2.5rem 2rem;
    background-color: var(--ids-color-option-white);
  }
}

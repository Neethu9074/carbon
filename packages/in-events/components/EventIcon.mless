:local {
  .waringIcon {
    fill: var(--cds-support-warning);
    path:first-of-type {
      fill: var(--ids-color-option-black);
    }
    path:last-of-type {
      fill: var(--cds-support-warning);
    }
  }

  .iconRegularButton {
    padding: 0.2rem 0.05rem 0.2rem 0.5rem;
    margin-right: 0.25rem;
  }

  .iconButton {
    padding-block-start: 0.2rem;
  }
}

@import '~in-themes/mixins.less';

:local {
  .htmlText {
    font-size: 0.875rem;
    color: currentColor;

    .breakWord();
    white-space: normal;
  }

  .presenterWrapper {
    grid-column-start: 2;
    grid-column-end: -1;
  }

  .padding {
    padding: 0 1rem 1rem 1rem;
  }

  .descriptionHeadline {
    font-size: 0.875rem;
    font-weight: bold;
    margin: 1rem 0 0.25rem;
  }

  .note {
    font-size: 0.875rem;
    color: currentColor;
    margin-top: 1.5rem;
    .breakWord();
    white-space: normal;
  }
}

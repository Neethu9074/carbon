@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .actionModalPadding {
    padding: 0 1.5rem 1.5rem;
  }
  .actionModalFontSize {
    font-size: 0.8rem;
  }
  .dialog {
    width: 65%;
    > div > div {
      width: 95%;
    }
  }
  .actionDescriptionMargin dt {
    margin-bottom: 0.25rem;
  }

  .subTextFormField {
    color: @lib__colors__N600Light;
    margin: 0.5rem 0 0 0.5rem;
  }

  .subErrorTextFormField {
    margin-left: 0.5rem;
  }
  .title {
    color: @lib__colors__N900Primary;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 2rem;
    margin: 0;
    padding: 0;
    .ellipsis();
  }
}

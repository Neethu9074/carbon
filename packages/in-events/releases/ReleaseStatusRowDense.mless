@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .row {
    background: @lib__colors__N500 !important;
  }

  .item {
    max-width: 15rem;
    display: block;
    font-weight: 400;
    font-size: 0.8rem;

    &.active {
      .label {
        font-weight: bold;
      }
    }
  }

  .icon {
    fill: @lib__colors__white;
  }

  .label {
    color: @lib__colors__white;
    display: block;
    max-width: 100%;
    .ellipsis();
  }

  .secondRow {
    display: flex;
    justify-content: space-between;
    margin: 0.3rem 0 0;
    color: @lib__colors__N400;
  }
}

:local {
  .aiChatDraggableDiv {
    position: fixed;
    z-index: 90000000000000;
    background-color: var(--cds-button-primary, #0f62fe);
    text-align: center;
    right: 30px;
    bottom: 50px;
    border-radius: 28px;
  }

  .aiChatDraggableButton {
    padding: 10px;
    z-index: 10;
    background-color: var(--cds-button-primary, #0f62fe);
    color: #fff;
    border-radius: 28px;
    border: none;
    width: 50px;
    height: 50px;
  }

  .aiChatDraggableButton:active {
    box-shadow: 0 0 0 3px var(--cds-button-primary, #0f62fe), inset 0 0 0 2px white;
  }
}

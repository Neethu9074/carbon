:local {
  .aiChatDraggableButton {
    position: fixed;
    z-index: var(--ids-z-index-option-overlays);
    background-color: var(--cds-button-primary, #0f62fe);
    border: none;
    color: #fff;
    border-radius: 28px;
    width: 56px;
    height: 56px;
    right: 30px;
    bottom: 30px;
  }

  .aiChatDraggableButton:active {
    box-shadow: 0 0 0 3px var(--cds-button-primary, #0f62fe), inset 0 0 0 2px white;
  }
}

@import '~in-themes/active.less';

:local {
  .callsAndGroupsIndicatorWrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chartIcon {
    fill: @lib__colors__N400;
    cursor: pointer;

    &:hover {
      fill: @lib__colors__blue800;
    }
  }

  .activeChartIcon {
    fill: @lib__colors__blue800;
  }
}

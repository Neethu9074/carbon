@import '~in-themes/active.less';

:local {
  .rect {
    width: 0.75rem;
    height: 0.75rem;

    margin-right: 0.5rem;
  }

  .rectPlaceHolder {
    display: inline-block;
    width: 0.5rem;
  }

  .labelCell {
    position: relative;

    &:hover {
      .filterButton {
        display: block;
      }
    }
  }

  .cell {
    display: flex;
    align-items: center;
  }

  .filterButton {
    position: absolute;
    right: 1rem;

    display: none;
  }

  .groupLabel {
    color: @lib__colors__navy900;
  }

  .metricValue {
    font-size: 0.875rem;
  }

  .serviceIcon,
  .timeIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }

  .serviceLink {
    color: @lib__colors__N600Light;
  }
}

@import '~in-themes/active.less';

:local {
  .editForm {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .selectBox {
    min-width: 6.25rem;
  }

  .keyList {
    display: flex;
    align-items: center;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .key {
    position: relative;
    margin-right: 0.5rem;

    &:after {
      position: absolute;
      left: 100%;
      top: 50%;

      content: '';
      width: 0.5rem;
      height: 1px;
      background: @lib__colors__N400;
    }

    &:last-child {
      margin-right: 0;

      &:after {
        width: 0;
        height: 0;
      }
    }
  }

  .fieldSeperator {
    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0.125rem 0.5rem 0.25rem;
    margin: 0.25rem 0.5rem 0;

    color: #fff;
    background: @lib__colors__N400;
    border-radius: @lib__shapes__radius_medium;
    font-size: 1rem;
    font-weight: bold;
  }

  .valueFormGroup {
    flex-grow: 1;
  }
}

@import '~in-themes/active.less';

:local {
  .editForm {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .keyList {
    display: flex;
    align-items: center;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fieldSeperator {
    margin: 0.5rem;
    min-width: 1.25rem;
  }

  .categoryList {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .categoryButton {
    margin: 0 0.25rem 0.25rem 0;
    border: none;
    background: @lib__colors__N200;
    font-weight: 100;
    text-transform: capitalize;

    &:hover {
      border: none;
      background: @lib__colors__N300;
    }
  }

  .activeCategoryButton {
    background: #000;
    border: none;
    color: #fff;
    cursor: default;

    &:hover {
      border: none;
      background: #000;
      color: #fff;
    }
  }

  .namedSection {
    display: flex;
    align-items: flex-start;

    &:last-child {
      min-height: 5rem;
    }
  }

  .name {
    margin-top: 0.625rem;
    min-width: 5rem;
    color: @lib__colors__N600Light;
  }

  .content {
    width: 100%;
  }

  .fixedOperator,
  .operator {
    min-width: 2.25rem;
    height: 1.25rem;
    margin: 0.375rem 0.25rem 0;

    background: @lib__colors__N500;
    color: #fff;
    border: 0;
  }

  .fixedOperator {
    max-width: 3.5rem;
    padding-left: 0.5rem;
    border-radius: @lib__shapes__radius_large;

    &[disabled] {
      color: #fff;
    }
  }

  .loadingSelectPlaceholder {
    display: flex;
    align-items: center;
  }

  .loadingSelectPlaceholderInput {
    flex-grow: 1;
    margin-right: 0.25rem;
  }

  .loadingIcon {
    fill: @lib__colors__blue800;
  }

  .helpText {
    color: @lib__colors__N700Medium;
    background: @lib__colors__N050;
    padding: 1rem;
  }
}

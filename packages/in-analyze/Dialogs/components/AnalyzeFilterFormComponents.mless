:local {
  .flexWrapper {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .helpText {
    color: var(--ids-color-option-neutral-700);
    background: var(--ids-color-option-neutral-50);
    padding: 1rem;
  }

  .namedSection {
    display: flex;
    align-items: flex-start;

    &:last-child {
      min-height: 5rem;
    }
  }

  .namedSectionName {
    margin-top: 0.625rem;
    min-width: 5rem;
    min-height: 4rem;
    color: var(--ids-color-option-neutral-600);
  }

  .namedSectionContent {
    width: 100%;
  }

  .keyGroup {
    min-width: 15rem;
    max-width: 15rem;
  }

  .customKeyGroup {
    min-width: 13rem;
    max-width: 13rem;
  }

  .fieldSeperator {
    margin: 0.5rem;
    min-width: 1.25rem;
  }

  .fixedOperator,
  .operator {
    min-width: 2.25rem;
    height: 1.25rem;
    margin: 0.375rem 0.25rem 0;

    background: var(--ids-color-option-neutral-500);
    color: #fff;
    border: 0;
  }

  .fixedOperator {
    max-width: 3.5rem;
    padding-left: 0.5rem;
    border-radius: var(--ids-border-radius-option-large);

    &[disabled] {
      color: #fff;
    }
  }

  .valueFormGroup {
    min-width: 13rem;
    max-width: 13rem;
  }

  .loadingSelectPlaceholder {
    display: flex;
    align-items: center;
  }

  .loadingSelectPlaceholderInput {
    flex-grow: 1;
    margin-right: 0.25rem;
  }

  .validationMessage {
    color: var(--ids-color-option-neutral-600);
  }
}

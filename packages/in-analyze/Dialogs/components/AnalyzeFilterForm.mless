@import '~in-themes/active.less';

:local {
  .editForm {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .selectBox {
    min-width: 6.25rem;
  }

  .keyList {
    display: flex;
    align-items: center;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .key {
    position: relative;
    margin-right: 0.5rem;

    &:after {
      position: absolute;
      left: 100%;
      top: 50%;

      content: '';
      width: 0.5rem;
      height: 1px;
      background: @lib__colors__N400;
    }

    &:last-child {
      margin-right: 0;

      &:after {
        width: 0;
        height: 0;
      }
    }
  }

  .fieldSeperator {
    margin: 0.5rem;
    min-width: 1.25rem;
  }

  .valueFormGroup {
    flex-grow: 1;
    min-width: 12.5rem;
  }

  .fixedValue {
    &[disabled] {
      color: @lib__colors__navy900;
    }
  }

  .categoryList {
    display: flex;
    align-items: center;

    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .categoryButton {
    margin-right: 0.25rem;
    border: none;
    background: @lib__colors__N200;
    font-weight: 100;
    text-transform: capitalize;

    &:hover {
      border: none;
      background: @lib__colors__N300;
    }
  }

  .activeCategoryButton {
    background: #000;
    border: none;
    color: #fff;
    cursor: default;

    &:hover {
      border: none;
      background: #000;
      color: #fff;
    }
  }

  .namedSection {
    display: flex;
    align-items: flex-start;

    &:last-child {
      min-height: 5rem;
    }
  }

  .name {
    margin-top: 0.625rem;
    min-width: 5rem;
    color: @lib__colors__N600Light;
  }

  .content {
    width: 100%;
  }
}

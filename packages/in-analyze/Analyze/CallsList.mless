@import '~in-themes/active.less';

:local {
  .headerWrapper {
    background: @lib__colors__navy800;
    padding: 0.5rem 0;
  }

  .header {
    display: flex;
    align-items: center;

    background: @lib__colors__navy800;
    font-size: 1rem;
    font-weight: lighter;
    overflow: hidden;

    color: #fff;
  }

  .icon {
    fill: @lib__colors__primary1;
    margin-right: 0.25rem;
  }
}

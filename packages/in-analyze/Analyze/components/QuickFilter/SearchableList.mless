@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    flex-direction: column;

    min-width: 25rem;
    max-width: 25rem;

    padding: 1.5rem;
    background: #fff;
  }

  .searchRow {
    display: flex;
    align-items: center;
    padding-bottom: 1.5rem;
  }

  .searchInputWrapper {
    flex-grow: 1;
  }

  .searchInput {
    width: 100%;

    &:focus {
      width: 100%;
    }
  }

  .loadingIcon {
    fill: @lib__colors__light-blue800;
  }

  .noSuggestionsLabel {
    color: @lib__colors__N600Light;
  }

  .containsItemIcon {
    position: absolute;
    right: 0.5rem;

    fill: @lib__colors__primary1;
  }
}

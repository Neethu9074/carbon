@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .suggestionList {
    margin: 0;
    padding: 0;

    overflow-y: auto;
    overflow-x: hidden;
    max-height: 12rem;
  }

  .suggestion {
    position: relative;

    display: flex;
    align-items: center;

    padding: 0.5rem 2.5rem 0.5rem 0.5rem;
    list-style: none;
    background: #fff;
    cursor: pointer;

    &:hover {
      background: @lib__colors__N100;
    }
  }

  .containsItem {
    cursor: not-allowed;

    &:hover {
      background: #fff;
    }
  }

  .entityIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N700Medium;
  }

  .itemText {
    color: @lib__colors__N700Medium;
    .ellipsis();
  }

  .containsItemIcon {
    position: absolute;
    right: 0.5rem;

    fill: @lib__colors__primary1;
  }
}

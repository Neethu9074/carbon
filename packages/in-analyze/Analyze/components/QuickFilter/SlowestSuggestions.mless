:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 1.5rem;
    background: #fff;
  }

  .text {
    margin-right: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .input {
    flex-grow: 1;
    max-width: 4.5rem;
    margin-right: 0.25rem;
  }

  .millis {
    margin-right: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
}

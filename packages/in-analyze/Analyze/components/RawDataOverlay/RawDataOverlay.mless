@import '~in-themes/active.less';

:local {
  .contentWrapper {
    min-width: ~'calc(100% - 4rem)';
    max-width: ~'calc(100% - 4rem)';
  }

  .customHeader {
    background: #fff;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.5rem 0.5rem 0.5rem;
  }

  .left {
    display: flex;
    align-items: center;
  }

  .groupName {
    margin-left: 1rem;
    font-size: 1rem;
    color: @lib__colors__N900Primary;
  }

  .closeIcon {
    fill: @lib__colors__N400;
    cursor: pointer;

    &:hover {
      fill: @lib__colors__N600Light;
    }
  }

  .content {
    background: #fff;

    min-height: 85vh;
    max-height: 85vh;
  }
}

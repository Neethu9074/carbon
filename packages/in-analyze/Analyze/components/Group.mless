@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .group {
    display: flex;
    align-items: center;

    margin-right: 1rem;
    padding: 0.4375rem 0.625rem;

    color: #fff;
    background: @lib__colors__light-blue800;

    font-size: 0.875rem;
    border-radius: @lib__shapes__radius_large;

    overflow: hidden;
    cursor: pointer;
    .ellipsis();

    &:hover {
      background: #178cc7;
      box-shadow: @lib__shadows__subtle;
    }
  }
}

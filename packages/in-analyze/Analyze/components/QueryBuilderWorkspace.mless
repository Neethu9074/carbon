@import '~in-themes/active.less';

:local {
  .firstRow {
    background: @lib__colors__N300;
  }

  .firstRowMaxWidthFullscreenContainer {
    position: relative;

    display: flex;
    align-items: center;

    padding: 0.5rem 0;
  }

  .quickFilterRow {
    display: flex;
    align-items: center;
  }

  .filterRowWrapper {
    display: flex;
    align-items: center;

    width: 100%;
    padding: 0.5rem 0;
  }

  .filterRow {
    margin-bottom: 2rem;
  }

  .moreFilterLabel {
    font-weight: 600;
  }

  .groupRow {
    display: flex;
    align-items: center;
  }

  .groupByLabel {
    margin-right: 1rem;

    color: @lib__colors__N600Light;
    font-size: 0.75rem;
  }
}

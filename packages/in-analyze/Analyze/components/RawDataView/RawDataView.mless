@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    align-items: center;

    padding: 0.6875rem 0;
    background: @lib__colors__N300;
  }

  .groupName {
    margin-left: 1rem;
    font-size: 1rem;
    color: @lib__colors__N900Primary;
  }

  .content {
    background: #fff;

    min-height: 85vh;
    max-height: 85vh;
  }
}

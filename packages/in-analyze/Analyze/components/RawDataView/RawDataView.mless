@import '~in-themes/active.less';

:local {
  .headerWrapper {
    background: @lib__colors__N300;
  }

  .header {
    display: flex;
    align-items: center;

    padding: 0.5rem 0;
  }

  .groupName {
    font-size: 0.875rem;
    color: @lib__colors__N600Light;
  }

  .content {
    background: #fff;

    min-height: 85vh;
    max-height: 85vh;
  }
}

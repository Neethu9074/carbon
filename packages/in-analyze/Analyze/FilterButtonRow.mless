:local {

  .fullWidthHorizontalRule {
    background-color: white;
    border-bottom: 1px solid #e8eef0;
  }

  .row {
    padding: .5rem 0;
  }

  .label {
    margin-right: .5rem;

    &:not(:first-child) {
      margin-left: 1rem;
    }
  }

  .info {
    margin-right: .5rem;
  }

  .badge {
    margin-right: .1rem;
  }
}

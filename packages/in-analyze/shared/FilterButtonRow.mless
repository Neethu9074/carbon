@import '~in-themes/active.less';
:local {
  .fullWidthHorizontalRule {
    background-color: @lib__colors__N050;
    border-bottom: 1px solid #e8eef0;
  }

  .row {
    padding: 0.5rem 0;
  }

  .label {
    margin-right: 0.5rem;

    &:not(:first-child) {
      margin-left: 1rem;
    }
  }

  .info {
    margin-right: 0.5rem;
  }

  .badge {
    margin-right: 0.5rem;
  }

  .filterList {
    display: flex;
  }
}

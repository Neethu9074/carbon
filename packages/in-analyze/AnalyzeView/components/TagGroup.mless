@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .tagGroupWrapper {
    position: relative;

    display: flex;
    align-items: center;
    width: 100%;
  }

  .tagGroup {
    display: flex;
    align-items: center;

    width: 100%;
    height: 2.375rem;

    padding: 0 0.5rem;

    color: @lib__colors__N900Primary;
    border: 1px solid @lib__colors__N400;
    background: #fff;
    border-radius: @lib__shapes__radius_medium;
    font-size: 0.875rem;
    cursor: pointer;
    overflow: hidden;

    &:hover {
      background: @lib__colors__N050;
      box-shadow: @lib__shadows__subtle;
    }
  }

  .icon {
    fill: @lib__colors__N500;
    margin-right: 0.25rem;
  }

  .name {
    color: @lib__colors__N500;
    .ellipsis();
  }

  .value {
    margin-left: 0.5rem;
    color: @lib__colors__N900Primary;
    font-weight: 600;
    .ellipsis();
  }

  .removeIcon {
    margin-left: 2rem;
    fill: @lib__colors__N500;
    cursor: pointer;

    &:hover {
      fill: @lib__colors__N500;
    }
  }

  .iconExtraMargin {
    margin-left: 4rem;
  }

  .firstOperatorPlaceholder,
  .operatorPlaceholder,
  .spacedOperatorPlaceholder,
  .onlyOperatorPlaceholder,
  .lastOperatorPlaceholder {
    min-width: 2.25rem;
    max-width: 2.25rem;
  }

  .firstOperatorPlaceholder,
  .firstSpacedOperatorPlaceholder,
  .lastOperatorPlaceholder {
    min-width: 1.125rem;
    max-width: 1.125rem;
    margin-right: 1.125rem;
  }

  .firstOperatorPlaceholder,
  .firstSpacedOperatorPlaceholder {
    position: relative;

    &::before {
      position: absolute;
      top: 50%;
      left: 0;
      content: '';
      height: 1px;
      width: 10px;
      background: @lib__colors__N300;
    }

    &::after {
      position: absolute;
      top: 100%;
      left: 100%;
      content: '';
      height: 1.9rem;
      width: 1px;
      background: @lib__colors__N300;
    }
  }

  .firstSpacedOperatorPlaceholder {
    &::after {
      position: absolute;
      top: 100%;
      left: 100%;
      content: '';
      height: 3.125rem;
      width: 1px;
      background: @lib__colors__N300;
    }
  }

  .operator {
    margin-left: 0.5rem;
    padding: 0.125rem 0.25rem;
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_large;
    color: @lib__colors__N500;
  }

  .operatorPlaceholder {
    position: relative;

    &::after {
      position: absolute;
      top: 100%;
      left: 50%;
      content: '';
      height: 1.9rem;
      width: 1px;
      background: @lib__colors__N300;
    }
  }

  .spacedOperatorPlaceholder {
    position: relative;

    &::after {
      position: absolute;
      top: 100%;
      left: 50%;
      content: '';
      height: 3.1875rem;
      width: 1px;
      background: @lib__colors__N300;
    }
  }

  .lastOperatorPlaceholder {
    position: relative;
    height: 1px;
    background: @lib__colors__N300;

    &::after {
      position: absolute;
      bottom: 100%;
      left: 100%;
      content: '';
      height: 1.9rem;
      width: 1px;
      background: @lib__colors__N300;
    }
  }

  .readonly {
    cursor: not-allowed;
    pointer-events: none;
  }
}

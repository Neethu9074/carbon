:local {
  .wrapper {
    border: 1px solid var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-option-small);
    margin-bottom: 1rem;
  }

  .disabled {
    pointer-events: none;
    opacity: 0.6;
  }

  .bar {
    border-top-left-radius: var(--ids-border-radius-option-small);
    border-top-right-radius: var(--ids-border-radius-option-small);
    background: var(--ids-color-option-neutral-200);
    padding: 0 1rem;
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
  }

  .list {
    border-bottom-left-radius: var(--ids-border-radius-option-small);
    border-bottom-right-radius: var(--ids-border-radius-option-small);
    background: #fff;
  }
}

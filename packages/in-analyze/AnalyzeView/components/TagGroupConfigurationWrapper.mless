@import '~in-themes/active.less';

:local {
  .wrapper {
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_small;
    margin-bottom: 1rem;
  }

  .disabled {
    pointer-events: none;
    opacity: 0.6;
  }

  .bar {
    border-top-left-radius: @lib__shapes__radius_small;
    border-top-right-radius: @lib__shapes__radius_small;
    background: @lib__colors__N200;
    padding: 0 1rem;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .barBottom {
    padding: 0 1rem;
    border-top: 1px solid @lib__colors__N300;
  }

  .list {
    border-bottom-left-radius: @lib__shapes__radius_small;
    border-bottom-right-radius: @lib__shapes__radius_small;
    background: #fff;
    padding: 1rem;
  }

  .empty {
    text-align: center;
    color: @lib__colors__N500;
    font-size: 0.875rem;
  }

  .barBottomContent {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.75rem 0;
  }

  .barBottomLeft {
    display: flex;
    align-items: flex-start;
    color: @lib__colors__N700Medium;
  }

  .barBottomDrop {
    align: top;
    padding: 0 0.75rem;
  }

  .barBottomToggle {
    margin-top: 1.5rem;
  }

  .barBottomLabel {
    margin-top: 1.8rem;
    padding: 0 0.75rem 0 0;
  }

  .select {
    width: 10rem;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_large;
    margin-bottom: 1rem;
  }

  .disabled {
    pointer-events: none;
    opacity: 0.6;
  }

  .bar {
    border-top-left-radius: @lib__shapes__radius_large;
    border-top-right-radius: @lib__shapes__radius_large;
    background: @lib__colors__N200;
    padding: 0 1rem;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .list {
    border-bottom-left-radius: @lib__shapes__radius_large;
    border-bottom-right-radius: @lib__shapes__radius_large;
    background: #fff;
    padding: 1rem;
  }

  .empty {
    text-align: center;
    color: @lib__colors__N500;
    font-size: 0.875rem;
  }
}

@import '~in-themes/active.less';

:local {
  .tagList {
    display: flex;
    flex-direction: column;
    align-items: stretch;

    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .operatorBeginPlaceholder {
    position: relative;

    height: 0;
    width: 1.625rem;
    margin: 0 0 0 1.125rem;

    border-bottom: 1px solid @lib__colors__N300;

    &::after {
      position: absolute;
      top: 100%;
      left: 0;
      content: '';
      height: 1.9rem;
      width: 1px;
      background: @lib__colors__N300;
    }
  }

  .operatorEndPlaceholder {
    position: relative;

    width: 1.625rem;
    margin: 1.25rem 0 1rem 1.125rem;

    border-bottom: 1px solid @lib__colors__N300;

    &::after {
      position: absolute;
      bottom: 0;
      left: 0;
      content: '';
      height: 1.625rem;
      width: 1px;
      background: @lib__colors__N300;
    }
  }

  .operatorPlaceholder {
    width: 2.75rem;
  }

  .operator {
    position: relative;

    margin-right: 0.5rem;
    min-width: 2.25rem;
    max-width: 2.25rem;

    &::after {
      position: absolute;
      top: 100%;
      left: 50%;
      content: '';
      height: 1.875rem;
      width: 1px;
      background: @lib__colors__N300;
    }
  }

  .item {
    display: flex;
    align-items: center;

    list-style: none;
    margin-bottom: 0.25rem;
  }

  .extraMargin {
    margin-bottom: 1.5rem;
  }
}

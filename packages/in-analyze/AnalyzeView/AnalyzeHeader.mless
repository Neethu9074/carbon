@import '~in-themes/active.less';

:local {
  .headerWrapper {
    padding: 1rem 0;
    background: @lib__colors__N050;
  }

  .header {
    display: flex;
    align-items: center;
    padding-left: 0.5rem;
  }

  .label {
    text-transform: capitalize;
  }

  .analyzeIcon {
    fill: @lib__colors__primary1;
    margin-right: 0.25rem;
  }
}

@import '~in-themes/active.less';

:local {
  .headerWrapper {
    background: @lib__colors__N050;
    padding: 0.5rem 0;
  }

  .header {
    display: flex;
    align-items: center;
  }

  .label {
    text-transform: capitalize;
  }

  .analyzeIcon {
    fill: @lib__colors__primary1;
    margin-right: 0.25rem;
  }
}

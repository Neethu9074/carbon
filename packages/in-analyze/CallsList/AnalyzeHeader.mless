@import '~in-themes/active.less';

:local {
  .analyzeHeader {
    background: @lib__colors__N100;
  }

  .heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    height: 4.5rem;
    padding-bottom: 1rem;
  }

  .titleWrapper {
    display: flex;
    align-items: center;

    cursor: pointer;
    &:hover {
      .expandIcon {
        fill: @lib__colors__N600Light;
      }
    }
  }

  .title {
    max-width: 70vw;
    margin: 0 0.25rem 0 0;

    color: @lib__colors__N900Primary;
    font-size: @lib__typography__h300__font-size;
    font-weight: 600;
  }

  .expandIcon {
    fill: @lib__colors__N500;
  }

  .filterRow {
    padding: 0.5rem 0;

    transition: height 0.125s ease-in-out;
  }
}

@import '~in-themes/active.less';

:local {
  .analyzeHeader {
    position: relative;
    height: 7.5rem;
  }

  .heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    height: 4.5rem;
    padding-bottom: 0.25rem;
  }

  .titleWrapper {
    display: flex;
    align-items: center;

    cursor: pointer;
    &:hover {
      .expandIcon {
        fill: @lib__colors__N600Light;
      }
    }
  }

  .title {
    max-width: 70vw;
    margin: 0;

    color: @lib__colors__N900Primary;
    font-size: @lib__typography__h300__font-size;
    font-weight: 600;
  }

  .expandIcon {
    fill: @lib__colors__N500;
  }

  .filterRow {
    position: absolute;
    top: 4.5rem;
    left: 0;
    right: 0;

    padding: 0.5rem 0;

    background: #fff;
    border-bottom: 1px solid @lib__colors__N300;
    box-shadow: 0px 2px 3px 0px rgba(0, 0, 0, 0.1);

    transition: height 0.125s ease-in-out;
  }
}

@import '~in-themes/active.less';

:local {
  .content {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .filterListing {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .filtersFilterGroup {
    margin-bottom: 0.75rem;
  }

  .addFilterIcon {
    margin: 1rem 0.5rem;
    cursor: pointer;

    fill: @lib__colors__primary1;
    &:hover {
      fill: #12978e;
    }
  }

  .filter {
    margin-bottom: 0.25rem;
  }
}

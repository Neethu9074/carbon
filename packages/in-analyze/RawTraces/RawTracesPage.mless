@import '~in-themes/active.less';

:local {
  .cell {
    display: flex;
    align-items: center;
  }

  .metricValue {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .serviceIcon,
  .timeIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }

  .link {
    color: @lib__colors__N900Primary;
  }
}

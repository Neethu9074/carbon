:local {
  .overlay {
    width: 25rem;
    max-height: 80vh;
    overflow-y: auto;
    padding: 1.5rem;
    background: #fff;
  }

  .extraWide {
    width: 53rem;
  }

  .extraExtraWide {
    width: 70rem;
  }

  .allowOverflow {
    overflow: unset;
  }

  @media (min-height: 600px) {
    .overlay {
      max-height: 25rem;
    }
  }
}

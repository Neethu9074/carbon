@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .listForSelected {
    margin: 0.4rem 0 1rem;
    padding: 0 0 0.5rem;
    list-style: none;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .listWithoutSelected {
    margin-top: 1rem;
  }

  .item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem;
    text-decoration: none;

    &:hover {
      background: @lib__colors__N100;
      text-decoration: none;
    }
  }

  .selectedItem {
    font-weight: bold;
  }

  .itemText {
    color: @lib__colors__N700Medium;
    display: flex;
    overflow: hidden;
    .ellipsis();
  }

  .selectedIcon {
    flex-shrink: 0;
    flex-grow: 0;
    width: 1.5rem;
    fill: @lib__colors__primary1;
  }

  .loading {
    margin: 0 auto;
  }

  .more {
    margin: 1rem 1rem 0;
    text-align: center;
    color: @lib__colors__N600Light;
  }
}

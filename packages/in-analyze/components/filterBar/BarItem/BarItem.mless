@import '~in-themes/mixins.less';

:local {
  .item {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    color: var(--ids-color-option-neutral-600);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    margin-right: 1rem;
    padding: 0.25rem 0.5rem;
    text-decoration: none;
    border-radius: 0.625rem;
    text-transform: capitalize;
  }

  .withIcon {
    padding-right: 0.3rem;
  }

  .active,
  .item:hover {
    background: var(--ids-color-option-neutral-600);
    color: #fff;
    text-decoration: none;

    .icon {
      fill: #fff;
    }
  }

  .notAvailable {
    color: var(--ids-color-option-neutral-500);
    cursor: not-allowed;

    .icon {
      fill: var(--ids-color-option-neutral-500);
    }

    &:hover {
      color: var(--ids-color-option-neutral-500);
      background: var(--ids-color-option-neutral-300);

      .icon {
        fill: var(--ids-color-option-neutral-500);
      }
    }
  }

  .icon {
    fill: var(--ids-color-option-neutral-600);
    position: relative;
    top: 1px;
  }

  .withoutTextTransform {
    text-transform: initial;
  }

  .text {
    max-width: 13rem;
    // adjust for overflow-hidden that will hide parts of certain characters
    line-height: 1.3;
    .ellipsis();
  }
}

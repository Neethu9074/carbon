:local {
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.75rem 0;
  }

  .left {
    display: flex;
    align-items: center;
  }

  .filter {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-right: 2rem;
    font-size: var(--ids-font-size-option-body-regular);
    color: var(--ids-color-option-neutral-600);
  }

  .icon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-600);
  }

  @media (min-width: 1280px) {
    .options {
      white-space: nowrap;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .bar {
    display: flex;
    align-items: center;

    padding: 0.75rem 0;
  }

  .filter {
    display: flex;
    align-items: center;
    margin-right: 2rem;
    font-size: @lib__typography__body__font-size;
    color: @lib__colors__N600Light;
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }
}

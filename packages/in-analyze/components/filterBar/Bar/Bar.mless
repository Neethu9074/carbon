@import '~in-themes/active.less';

:local {
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.75rem 0;
  }

  .left {
    display: flex;
    align-items: center;
  }

  .filter {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-right: 2rem;
    font-size: @lib__typography__body__font-size;
    color: @lib__colors__N600Light;
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }

  @media (min-width: 1280px) {
    .options {
      white-space: nowrap;
    }
  }
}

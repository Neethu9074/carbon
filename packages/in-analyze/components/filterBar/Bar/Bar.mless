@import '~in-themes/active.less';

:local {
  .wrapper {
    padding: 0.75rem 0.7rem;
  }

  .backgroundColor {
    background: @lib__colors__N300;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .removePadding {
    padding: 0;
  }

  .removeBackgroundColor {
    background-color: transparent;
  }
}

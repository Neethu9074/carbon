@import '~in-themes/active.less';

:local {
  .inputGroup {
    display: flex;
  }

  .textLabel {
    color: @lib__colors__N700Medium;
  }

  .radioInput {
    margin-top: 0.5rem;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid @lib__colors__primary2;
    cursor: pointer;
    width: 50%;
    padding: 0.125rem 0;
  }

  .radioInputChecked {
    border: @lib__colors__primary2;
    background: @lib__colors__primary2;
    color: @lib__colors__white;
    fill: @lib__colors__white;
    font-weight: bold;
  }

  .radioInputDisabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .inputGroup [type='radio'] {
    position: absolute;
    border: 0;
    clip: rect(0 0 0 0);
    height: 1px;
    width: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
  }
}

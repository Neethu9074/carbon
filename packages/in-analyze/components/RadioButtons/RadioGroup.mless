@import '~in-themes/active.less';

:local {
  .inputGroup {
    display: flex;
  }
  .radioInput {
    margin: .5rem .5rem 1rem 0;
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid  @lib__colors__primary2;
    min-width: 7.8125rem;
  }

  .radioInputChecked {
    border: @lib__colors__primary2;
    background:  @lib__colors__primary2;
    color: @lib__colors__white;
    fill: @lib__colors__white;
    font-weight: bold;
  }

  .radioInputDisabled {
    opacity: .5;
    pointer-events: none;
  }

  [type="radio"] {
    position: absolute;
    border: 0;
    clip: rect(0 0 0 0);
    height: 1px; margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    width: 1px;
  }

  .icon {
    padding-left: .5rem;
  }

  .label {
    padding: 0 1rem;
    justify-self: flex-end;
  }
}
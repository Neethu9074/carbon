@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    margin-left: 1rem;
  }

  .label {
    margin-right: 0.5rem;
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
  }

  .grouping {
    font-weight: bold;
    font-size: 0.75rem;
    margin-right: 0.5rem;
  }

  .removeGrouping {
    cursor: pointer;
    fill: @lib__colors__N500;
    margin: 0 1rem 0 0.3rem;
    position: relative;
    top: 1px;

    &:hover {
      fill: @lib__colors__N700Medium;
    }
  }
}

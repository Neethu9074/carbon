@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    margin: 0 0 0.25rem;
    padding: 0;
    display: flex;
    align-items: center;

    &:last-child .conjunction::after {
      display: none;
    }
  }

  .itemBlock {
    width: 100%;
    padding: 0.3rem 0.5rem;
    display: flex;
    align-items: center;

    color: @lib__colors__N900Primary;
    border: 1px solid @lib__colors__N400;
    background: #fff;
    border-radius: @lib__shapes__radius_medium;
    font-size: 0.875rem;
    cursor: pointer;
    overflow: hidden;
    text-decoration: none;

    &:hover {
      background: @lib__colors__N050;
      box-shadow: @lib__shadows__subtle;
      text-decoration: none;
    }
  }

  .tag {
    color: @lib__colors__N500;
    .ellipsis();
  }

  .operator {
    margin-left: 0.5rem;
    padding: 0.125rem 0.25rem;
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_large;
    color: @lib__colors__N500;
  }

  .value {
    margin-left: 0.5rem;
    color: @lib__colors__N900Primary;
    font-weight: 600;
    .ellipsis();
  }

  .icon {
    fill: @lib__colors__N500;
    margin-right: 0.25rem;
  }

  .removeIcon {
    flex-shrink: 0;
    margin-left: 1rem;
    fill: @lib__colors__N400;
    cursor: pointer;

    &:hover {
      fill: @lib__colors__N500;
    }
  }

  .conjunction {
    text-transform: uppercase;
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_large;
    color: @lib__colors__N500;
    margin-left: 0.5rem;
    padding: 0.125rem 0.25rem;
    position: relative;

    // horizontal connection line
    &::before {
      position: absolute;
      top: 50%;
      left: -10px;
      content: '';
      height: 1px;
      width: 10px;
      background: @lib__colors__N400;
    }

    // vertical connection line
    &::after {
      position: absolute;
      top: 100%;
      left: 50%;
      content: '';
      height: 1.6rem;
      width: 1px;
      background: @lib__colors__N400;
    }
  }
}

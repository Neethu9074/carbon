@import '~in-themes/active.less';

:local {
  .entity {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_large;
    color: @lib__colors__N500;
    fill: @lib__colors__N500;
    padding: 0 0.5rem 0 0.25rem;
    margin-right: 0.5rem;
  }
}

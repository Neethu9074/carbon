@import '~in-themes/active.less';

:local {
  .help {
    color: @lib__colors__N700Medium;
    background: @lib__colors__N050;
    padding: 1rem;
    margin-top: 0;
    max-width: 31.25rem;
  }

  .form {
    display: flex;
    align-items: flex-start;
    width: 31.25rem;
    max-width: 31.25rem;
  }

  .metricGroup {
    flex-grow: 1;
    margin: 0 0.5rem 0 0;
  }

  .aggregationGroup {
    flex-grow: 1;
    margin: 0 0.5rem 0 0;
  }

  .addButton {
    flex-shrink: 0;
    flex-grow: 0;
    margin: 1.3rem 0 0;
  }

  .header {
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0 0 0.7rem;
  }

  .selectedMetricHeader {
    margin-top: 2rem;
  }

  .metricList {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .metric {
    margin: 4px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    line-height: 1.5;
  }

  .metricLeftSide {
    display: flex;
    align-items: center;
  }

  .draggableIndicator {
    fill: @lib__colors__N700Medium;
    margin: 0 0.5rem 0 0;
  }

  .metricNotAvailable {
    fill: @lib__colors__N700Medium;
    margin: 0 0 0 0.3rem;
  }

  .separator {
    margin: 2rem 0 1rem;
    border-bottom: 1px solid @lib__colors__N400;
    border-top: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin: 1rem 0 0;
  }
}

@import '~in-themes/active.less';

:local {
  .table {
    border-top: 1px solid @lib__colors__N400;
  }

  .headerWrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding: 0.3rem 0 0.5rem;
  }
  .label {
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
  }
  .labelWrapper {
    display: flex;
    align-items: center;
  }
}

@import '~in-themes/mixins.less';

:local {
  .shorten {
    max-width: 16rem;
    display: inline-block;
    .ellipsis();
  }

  @media (min-width: 1280px) {
    .shorten {
      max-width: 40rem;
    }
  }

  @media (min-width: 1400px) {
    .shorten {
      max-width: 50rem;
    }
  }
}

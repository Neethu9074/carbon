@import '~in-themes/mixins.less';

:local {
  .shorten {
    max-width: 16rem;
    display: inline-block;
    .ellipsis();
  }

  @media screen and (min-width: 1280px) {
    .shorten {
      max-width: 40rem;
    }
  }

  @media screen and (min-width: 1400px) {
    .shorten {
      max-width: 50rem;
    }
  }
}

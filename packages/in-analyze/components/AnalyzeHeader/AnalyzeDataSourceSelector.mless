:local {
  .wrapper {
    width: 20rem;
    max-height: 70vh;
    overflow: hidden auto;
  }

  .iconAndType {
    display: flex;
    align-items: center;

    & > svg {
      margin-right: 0.5rem;
    }
  }

  .active {
    font-weight: bold;
  }

  .betaPill {
    margin-left: 0.5rem;
  }
}

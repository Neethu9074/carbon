@import '~in-themes/mixins.less';

:local {
  .button {
    line-height: 1.15;
  }

  .label {
    .flexbox();
    font-size: 1.375rem;
    font-weight: 500;
  }

  .productAreaIcon,
  .dataSourceIcon {
    margin-right: 0.5rem;
  }

  .productAreaIcon {
    fill: var(--ids-color-option-neutral-600);
  }

  .productAreaLabel {
    color: var(--ids-color-option-neutral-600);
  }

  .dataSourceIcon {
    fill: var(--ids-color-option-neutral-900);
  }

  .dataSourceLabel {
    color: var(--ids-color-option-neutral-900);
  }

  .separator {
    margin: 0 0.5rem;
    color: var(--ids-color-option-neutral-600);
  }

  .metaInformation {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;

    // workaround for missing margin for showing outline when focused
    margin-left: 2px;
    margin-right: 2px;
  }
}

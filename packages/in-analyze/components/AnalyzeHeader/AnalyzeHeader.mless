@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .button {
    line-height: @lib__typography__line-height;
  }

  .label {
    .flexbox();
    font-size: 1.375rem;
    font-weight: 500;
  }

  .productAreaIcon, .dataSourceIcon {
    margin-right: 0.5rem;
  }

  .productAreaIcon {
    fill: @lib__colors__N600Light;
  }

  .productAreaLabel {
    color: @lib__colors__N600Light;
  }

  .dataSourceIcon {
    fill: @lib__colors__N900Primary;
  }

  .dataSourceLabel {
    color: @lib__colors__N900Primary;
  }

  .separator {
    margin: 0 0.5rem;
    color: @lib__colors__N600Light;
  }

  .betaMarker {
    background: @lib__colors__N100;
    border-radius: @lib__shapes__radius_small;
    color: @lib__colors__N800Dark;
    border: 1px solid @lib__colors__N400;
    padding: 0.5rem 0.625rem;
    height: 2.6875rem;
    display: flex;
    align-items: center;
  }

  .betaPill {
    margin-right: 0.4rem;
  }

  .betaLink {
    margin-left: .2rem;
  }
}

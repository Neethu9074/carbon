@import '~in-themes/active.less';

:local {
  .help {
    margin: 0 0 1rem;
  }

  .labelWithLoader {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .loading {
    display: flex;
    align-items: center;
  }

  .loadingIcon {
    margin-right: 0.125rem;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 1rem 0 0;
  }

  .onlyOneAction {
    justify-content: flex-end;
  }
}

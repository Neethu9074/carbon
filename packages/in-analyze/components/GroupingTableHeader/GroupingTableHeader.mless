@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid @lib__colors__N400;
    padding: 0.3rem 0 0.5rem;
  }

  .leftSide {
    display: flex;
    align-items: center;
  }
  .label {
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
  }
  .labelWrapper {
    display: flex;
    align-items: center;
  }
}

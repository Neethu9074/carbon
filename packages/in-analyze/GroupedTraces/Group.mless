@import '~in-themes/active.less';

:local {
  .rect {
    width: 0.75rem;
    height: 0.75rem;

    margin-right: 0.5rem;
  }

  .rectPlaceHolder {
    display: inline-block;
    width: 0.5rem;
  }

  .cell {
    display: flex;
    align-items: center;
  }

  .metricValue {
    font-size: 0.875rem;
  }

  .timeIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }
}

@import '~in-themes/active.less';

:local {
  .traceGroupsCharts {
    margin: 1rem;
  }

  .buttonGroup {
    display: flex;
    margin-bottom: 1.5rem;
  }

  .chartSelectButton {
    margin-right: 0.5rem;
    padding: 0.25rem 0.5rem;
    text-decoration: none;
    color: @lib__colors__N700Medium;
    font-size: 0.875rem;
    border-radius: @lib__shapes__radius_small;
    cursor: pointer;

    &:hover {
      background: @lib__colors__N300;
      text-decoration: none;
    }
  }

  .chartSelectedButton {
    color: #fff;
    background: @lib__colors__light-blue800;

    &:hover {
      background: @lib__colors__light-blue800;
      cursor: default;
    }
  }

  .chartSelector {
    margin-bottom: 1rem;
  }

  .whitespace {
    margin-bottom: 1rem;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .filter {
    min-width: 17rem;
    max-width: 17rem;
  }

  .rowWrapper {
    display: flex;
    flex-direction: column;
    .ellipsis();
  }

  .title {
    color: @lib__colors__N500;
    margin-bottom: 0.25rem;
    font-size: 0.75rem;
  }

  .content {
    .ellipsis();
  }
}

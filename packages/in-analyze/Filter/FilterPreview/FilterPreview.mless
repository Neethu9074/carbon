@import '~in-themes/active.less';

:local {
  .filterPreview {
    display: flex;
    align-items: center;

    color: @lib__colors__N900Primary;

    &:first-child,
    & + .filterPreview:not(:last-child) {
      margin-right: 1rem;
    }
  }

  .title {
    margin-right: 0.5rem;
    color: @lib__colors__N500;
  }

  .items {
    display: flex;
    flex-wrap: wrap;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    display: flex;
    align-items: center;

    margin-right: 0.25rem;
    padding: 0.3125rem 0.5rem;

    border: 1px solid @lib__colors__N400;
    border-left: 3px solid @lib__colors__N800Dark;
    border-radius: @lib__shapes__radius_medium;

    &:last-child {
      margin-right: 0;
    }
  }

  .static {
    border: 1px solid @lib__colors__navy800;
    border-left: 1px solid @lib__colors__navy800;
    background: @lib__colors__navy800;
    color: #fff;
  }

  .icon {
    margin-right: 0.25rem;
    fill: @lib__colors__N900Primary;
  }

  .badge {
    margin-left: 0.25rem;
  }
}

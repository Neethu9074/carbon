@import '~in-themes/active.less';

:local {
  .editView {
    display: flex;
    align-items: flex-start;
  }

  .selectBox {
    min-width: 6.25rem;
  }

  .keyList {
    display: flex;
    align-items: center;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .key {
    position: relative;
    margin-right: 0.5rem;

    &:after {
      position: absolute;
      left: 100%;
      top: 50%;

      content: '';
      width: 0.5rem;
      height: 1px;
      background: @lib__colors__N400;
    }

    &:last-child {
      &:after {
        width: 0;
        height: 0;
      }
    }
  }

  .keyValueSeperator {
    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0.125rem 0.5rem 0.25rem;
    margin: 0.25rem 0.5rem 0 0;

    color: @lib__colors__N600Light;
    font-size: 1rem;
    font-weight: bold;
  }

  .valueFormGroup {
    width: 100%;
  }
}

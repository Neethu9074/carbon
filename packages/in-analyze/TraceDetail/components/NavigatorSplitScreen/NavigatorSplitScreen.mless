@import '~in-themes/active.less';

:local {
  .navigatorSplitScreen {
    display: flex;
  }

  .navigator {
    width: 37.5rem;
    flex-grow: 0;
    flex-shrink: 0;
    border-right: 1px solid #d5dfe4;
  }

  .traceDetail {
    width: ~"calc(100% - 37.5rem)";
  }

  .header {
    background: @lib__colors__N050;
    border-bottom: 1px solid @lib__colors__N300;
    padding: 0.3rem 1.5rem 1.1rem;
  }
}

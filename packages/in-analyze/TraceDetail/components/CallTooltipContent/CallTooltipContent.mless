@import '~in-themes/active.less';

:local {
  .content {
    width: 13rem;
    padding: 0.5rem;
  }

  .heading {
    margin-bottom: 1rem;
  }

  .timingValueList {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timingValue {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .label {
    color: @lib__colors__N800Dark;
  }

  .value {
    font-weight: bold;
    color: @lib__colors__N900Primary;
  }
}

@import '~in-themes/active.less';

:local {
  .serviceLine {
    display: flex;
    border: 1px solid @lib__colors__N600Light;
    border-radius: 3px;
    padding: 0.75rem;
    overflow: hidden;
  }
  .serviceLineInfo {
    display: flex;
    flex-wrap: wrap;
    flex-grow: 1;
    align-items: center;
  }
  .unmonitored {
    border: 1px dashed @lib__colors__N600Light;
  }
  .hasError {
    border: 1px solid @lib__colors__failure;
  }

  .locationText {
    text-transform: uppercase;
    margin: 0 0.5rem 0 0;
  }
  .text {
    margin: 0 0.25rem;
    font-size: 1rem;
  }

  .link {
    display: flex;
    align-items: center;
    fill: @lib__colors__primary2;
    font-size: 1rem;
  }

  .infoIcon {
    fill: @lib__colors__N600Light;
    justify-self: flex-end;
  }

  .unmonitoredText {
    display: flex;
    align-items: center;
    color: @lib__colors__N600Light;
    fill: @lib__colors__N600Light;
    font-size: 1rem;
  }

  .simplePluginIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }

  .skeletonContainer {
    display: flex;
    flex-grow: 1;
  }
  .skeleton {
    width: 100%;
    height: 1rem;
    margin: 0 0 0.25rem;
    display: block;
  }
}

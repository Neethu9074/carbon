@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .stackTrace {
    margin: 0 0 1.5rem 0;
    border-top: 2px solid @lib__colors__N200;
  }

  .title {
    width: 10rem;
    flex-grow: 0;
    flex-shrink: 0;
    padding-top: 1rem;
    font-weight: 500;
    .ellipsis();
  }

  .list {
    border-radius: 0.125rem;
    padding: 0.25rem 0.688rem;
    font-size: 0.625rem;
    background: #f8f8f8;
    margin: 0;
    list-style: none;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .noPadding {
    padding: 0;
  }

  .method {
    font-weight: bold;
  }

  .in {
    color: #aaa;
    margin: 0 0.1rem;
  }

  .noCodeLinkMessage {
    padding: 0.3rem 0.6rem 0;
    margin: 0;
    font-weight: 300;
  }
}

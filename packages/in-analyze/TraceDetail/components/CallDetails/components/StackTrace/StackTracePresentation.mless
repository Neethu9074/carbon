:local {
  .stackTrace {
    margin: 0 0 1.5rem 0;
  }

  .list {
    border-radius: 0.125rem;
    padding: 0.25rem 0.688rem;
    font-size: 0.625rem;
    background: #f8f8f8;
    margin: 0;
    list-style: none;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .noPadding {
    padding: 0;
  }

  .method {
    font-weight: bold;
  }

  .in {
    color: #aaa;
    margin: 0 0.1rem;
  }

  .noCodeLinkMessage {
    padding: 0.3rem 0.6rem 0;
    margin: 0;
    font-weight: 300;
  }
}

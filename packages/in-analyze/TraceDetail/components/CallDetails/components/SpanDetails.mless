
@import '~in-themes/mixins.less';

:local {
  .spanType {
    display: flex;
    margin-bottom: 0.25rem;
  }

  .title {
    width: 30%;
    max-width: 8.75rem;
    font-weight: bold;
    margin: 0 0 0.063rem;
    font-size: 0.688rem;
    .ellipsis();
  }

  .text {
    font-size: 0.688rem;
    width: 70%;
    .ellipsis();
  }
}

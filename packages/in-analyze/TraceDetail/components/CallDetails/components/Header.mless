@import '~in-themes/active.less';

:local {
  .header {
    position: relative;

    display: flex;
    align-items: flex-end;

    margin-bottom: 2rem;
  }

  .closeIcon {
    position: absolute;
    top: 0;
    right: 0;

    cursor: pointer;
    fill: @lib__colors__N600Light;
  }

  .callLabel {
    font-size: 1rem;
    color: #0c1415;
    margin-right: 1rem;
  }
}

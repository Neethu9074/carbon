@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .title {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .message {
    margin-left: 1rem;
  }

  .closeIcon {
    cursor: pointer;
    fill: @lib__colors__N400;

    &:hover {
      fill: @lib__colors__N500;
    }
  }

  .entityInformation {
    display: flex;
    align-items: center;
    padding: 0 1rem;
    overflow: hidden;

    svg {
      margin-right: 0.5rem;
    }
  }

  .callLabel {
    font-size: 1rem;
    color: @lib__colors__N900Primary;
    margin-right: 1rem;
    .ellipsis();
  }

  .serviceLabel,
  .infraLabel {
    font-size: 0.75rem;
    color: @lib__colors__N900Primary;
  }

  .infraLabel {
    margin-top: 0.6rem;
    display: block;
  }

  .serviceLine,
  .infraLine {
    display: flex;
    align-items: center;
    margin-top: 0.5rem;
    color: @lib__colors__blue800;
  }

  .infraLink,
  .infraLink:hover {
    color: @lib__colors__blue800;
    margin: 0.1rem 0;

    svg {
      margin-right: 0.5rem;
      margin-left: 0.1rem;
      fill: @lib__colors__blue800 !important;
    }
  }

  .rect {
    min-width: 1.375rem;
    min-height: 1.375rem;

    margin-right: 0.5rem;
  }

  .entityIcon {
    margin-right: 0.25rem;
    fill: @lib__colors__blue800;
  }

  .batchSizeIndicator {
    margin-right: 0.5rem;
  }

  .link {
    .ellipsis();
  }

  .text {
    margin: 0 0.5rem;
    color: @lib__colors__N600Light;
  }

  .skeleton {
    width: 70%;
    height: 1rem;
    margin: 0 0 0.25rem;
    display: block;
  }
}

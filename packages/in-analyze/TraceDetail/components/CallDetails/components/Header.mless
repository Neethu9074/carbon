@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .title {
    font-size: 1.1rem;
    color: @lib__colors__N900Primary;
    font-weight: 400;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .closeIcon {
    cursor: pointer;
    fill: @lib__colors__N400;

    &:hover {
      fill: @lib__colors__N500;
    }
  }

  .entityInformation {
    display: flex;
    align-items: flex-start;

    margin-bottom: 1rem;
    padding-right: 1.5rem;
  }

  .callLabel {
    font-size: 1rem;
    color: @lib__colors__N900Primary;
    margin-right: 1rem;
    .ellipsis();
  }

  .serviceLabel, .infraLabel {
    font-size: 0.75rem;
    color: @lib__colors__N900Primary;
  }

  .infraLabel {
    margin-top: 0.6rem;
    display: block;
  }

  .serviceLine, .infraLine {
    display: flex;
    align-items: center;
    margin-top: 0.5rem;
    color: @lib__colors__blue800;
  }

  .infraLink, .infraLink:hover {
    color: @lib__colors__blue800;
    margin: 0.1rem 0;

    svg {
      margin-right: 0.5rem;
      margin-left: 0.1rem;
      fill: @lib__colors__blue800 !important;
    }
  }

  .rect {
    min-width: 0.75rem;
    min-height: 0.75rem;

    margin-right: 0.5rem;
  }

  .chevron {
    margin: 0 0.25rem;
    fill: @lib__colors__N600Light;
  }

  .entityIcon {
    margin-right: 0.25rem;
    fill: @lib__colors__blue800;
  }

  .link {
    .ellipsis();
  }
}

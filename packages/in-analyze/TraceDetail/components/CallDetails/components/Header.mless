:local {
  .header {
    position: relative;

    display: flex;
    align-items: flex-end;

    margin-bottom: 2rem;
  }

  .closeButton {
    position: absolute;
    top: 0;
    right: 0;

    display: flex;
    align-items: center;
    font-size: 0.875rem;

    color: #00a9ab;
    cursor: pointer;

    &:hover {
      color: #02d8d9;
    }
  }

  .closeIcon {
    margin-right: 0.5rem;
  }

  .callLabel {
    font-size: 1rem;
    color: #0c1415;
  }
}

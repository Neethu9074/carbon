@import '~in-themes/active.less';

:local {
  .callErrorDetailsWrapper {
    display: flex;
    align-items: center;

    padding: 0.5rem 0.75rem;

    background: @lib__colors__N050;
    color: @lib__colors__N900Primary;
  }

  .errorIndicator,
  .callErrorDetails {
    display: flex;
    align-items: center;

    margin-right: 2rem;
  }

  .infoIcon {
    margin-right: 0.5rem;
  }

  .errorIndicator {
    color: @lib__colors__failure;
  }

  .errorIconWrapper {
    margin-right: 5px;
    width: .875rem;
    height: .875rem;
    border-radius: 50%;
    background: #ff5d3b;
    color: white;
    font-size: .75rem;
    text-align: center;
  }
}

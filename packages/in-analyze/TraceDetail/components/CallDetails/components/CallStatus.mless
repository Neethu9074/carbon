@import '~in-themes/active.less';

:local {
  .callStatus {
    display: flex;
    align-items: center;

    padding: 0.5rem 0.75rem;

    background: @lib__colors__N050;
    color: @lib__colors__N900Primary;
  }

  .errorIndicator,
  .callStatusInformation {
    display: flex;
    align-items: center;

    margin-right: 2rem;
  }

  .infoIcon {
    margin-right: 0.5rem;
  }

  .errorIndicator {
    color: @lib__colors__failure;
  }

  .errorIconWrapper {
    display: flex;
    align-items: center;
    justify-content: center;

    margin-right: 0.5rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: #ff5d3b;
    color: white;
  }
}

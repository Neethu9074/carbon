:local {
  .tabView {
    display: flex;
    align-items: flex-end;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tab {
    padding-right: 1rem;
    border-bottom: 1px solid black;
    cursor: pointer;
    white-space: nowrap;

    &:hover {
      color: red;
      border-bottom: 1px solid blue;
    }

    &:last-child {
      padding-right: 0;
    }
  }

  .selectedTab {
    border-bottom: 1px solid red;
  }

  .emptyEnddingTab {
    width: 100%;
    border-bottom: 1px solid black;
  }
}

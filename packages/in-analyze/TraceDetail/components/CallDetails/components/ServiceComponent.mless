@import '~in-themes/active.less';

:local {
  .arrowWrapper {
    display: grid;
    grid-template-columns: 16px 1fr;
    grid-template-rows: auto auto auto;
    overflow: hidden;
  }

  .verticalLineTop {
    grid-column-start: 1;
    grid-column-end: 2;
    grid-row-start: 1;
    grid-row-end: 2;
    border-left: 1px solid @lib__colors__N600Light;
    border-top: 1px solid @lib__colors__N600Light;
    border-radius: 0.25rem 0 0 0;
    align-self: end;
    height: 50%;
  }

  .verticalLine {
    grid-column-start: 1;
    grid-column-end: 2;
    grid-row-start: 2;
    grid-row-end: 3;
    border-left: 1px solid @lib__colors__N600Light;
  }

  .verticalLineBottom {
    grid-column-start: 1;
    grid-column-end: 2;
    grid-row-start: 3;
    grid-row-end: 4;
    border-left: 1px solid @lib__colors__N600Light;
    border-bottom: 1px solid @lib__colors__N600Light;
    border-radius: 0 0 0 0.25rem;
    align-self: start;
    height: 50%;
    position: relative;
  }

  .lineArrow {
    position: absolute;
    bottom: -0.375rem;
    right: 0px;
    height: 0.75rem;
  }

  .sourceChildren {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0.75rem 0 0 1rem;
  }

  .destinationChildren {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0.75rem 0 0 2rem;
  }

  .onlyChildren {
    padding: 0.75rem 0 0 0.75rem;
  }

  .infraTitle {
    display: flex;
    align-items: center;
    flex-grow: 1;

    & > span {
      margin: 0 0.5rem 0 0;
    }
  }

  .skeletonContainer {
    display: flex;
    flex-grow: 1;
  }

  .skeleton {
    width: 100%;
    height: 1rem;
    margin: 0 0 0.25rem;
    display: block;
  }
}

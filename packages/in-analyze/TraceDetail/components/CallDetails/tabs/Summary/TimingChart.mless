:local {
  .timingChart {
    display: flex;
    position: relative;
    width: 100%;
    height: 4.5rem;
  }

  .blockWrapper {
    position: absolute;
    height: 100%;
    min-width: 5px;
    border-right: 1px solid #e7eef0;
    &:first-child {
      border-left: 1px solid #e7eef0;
    }
  }

  .timeLabel {
    text-align: center;
    color: #8c969a;
    padding: 0 0 0.5rem 0;
    overflow: hidden;
    white-space: pre-wrap;
    line-height: 1.5rem;
    height: 1.5rem;
  }

  .timeLabel::before {
    content: ' '
  }

  .timeBlock {
    height: 2rem;
    padding: 0.5rem 0;
    overflow-x: hidden;
    text-overflow: ellipsis;
  }

  .timeBlockLabel {
    margin-left: 0.5rem;
  }

  .callBlock {
    height: 0.5rem;
  }
}

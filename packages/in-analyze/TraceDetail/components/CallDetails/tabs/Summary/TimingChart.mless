:local {
  .timingChart {
    display: flex;
  }

  .blocksWrapper {
    position: relative;
    padding: 1rem 0;
    width: 100%;
    height: 4rem;

    border-left: 1px solid #e7eef0;
    &:last-child {
      border-right: 1px solid #e7eef0;
    }
  }

  .durationBlock {
    position: absolute;
    height: 2rem;
    padding: 0.5rem 0;
    white-space: nowrap;
    overflow-x: hidden;
    text-overflow: ellipsis;
  }

  .durationBlockLabel {
    margin-left: 0.5rem;
  }

  .callBlock {
    position: absolute;
    height: 0.5rem;
    top: 3rem;
  }
}

@import '~in-themes/active.less';

:local {
  .timingChart {
    display: flex;
    position: relative;
    width: 100%;
    height: 4.5rem;
  }

  .blockWrapper {
    position: absolute;
    height: 100%;
    min-width: 5px;
    border-right: 1px solid @lib__colors__N500;
    &:first-child {
      border-left: 1px solid @lib__colors__N500;
    }
  }

  .timeLabel {
    text-align: center;

    color: @lib__colors__N800Dark;
    padding: 0 0 0.5rem 0;
    overflow: hidden;
    white-space: pre-wrap;
    line-height: 1.5rem;
    height: 1.5rem;
  }

  .timeLabel::before {
    content: ' ';
  }

  .timeBlock {
    height: 2rem;
    padding: 0.625rem 0 0.5rem;
    overflow-x: hidden;
    text-overflow: ellipsis;
    color: #fff;
  }

  .timeBlockLabel {
    margin-left: 0.5rem;
  }

  .callBlock {
    height: 0.5rem;
  }

  .tooltip {
    width: 8rem;
    display: flex;
    justify-content: space-between;
    padding: 0.125rem 0;
    margin: 0 0.125rem;
    font-weight: bold;
  }
}

:local {
  .timingChart {
    display: flex;
    position: relative;
    width: 100%;
    height: 4.5rem;
  }

  .blockWrapper {
    position: absolute;
    height: 100%;
    border-left: 1px solid #e7eef0;
    &:last-child {
      border-right: 1px solid #e7eef0;
    }
  }

  .timeLabel {
    text-align: center;
    color: #8c969a;
    padding: 0 0 0.5rem 0;
    overflow: hidden;
  }

  .durationBlock {
    height: 2rem;
    padding: 0.5rem 0;
    white-space: nowrap;
    overflow-x: hidden;
    text-overflow: ellipsis;
  }

  .durationBlockLabel {
    margin-left: 0.5rem;
  }

  .callBlock {
    position: relative;
    height: 0.5rem;
    top: 2rem;
  }
}

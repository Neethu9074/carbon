@import '~in-themes/active.less';

:local {
  .entryExitInformation {
    position: relative;
  }

  .serviceEndpointInformationFrom,
  .serviceEndpointInformationTo {
    margin: 0 0 1.5rem 1.5rem;
  }

  .serviceEndpointInformationFrom {
    min-height: 4.3125rem;
  }

  .serviceEndpointInformationTo {
    margin-left: 3.5rem;
  }

  .serviceRow,
  .endpointRow {
    display: flex;
    align-items: center;
  }

  .endpointRow {
    margin-left: 2rem;
  }

  .connectionLineWrapper {
    position: absolute;
    top: 4.1875rem;
    bottom: 0;
    left: 1.5625rem;

    display: flex;
    flex-direction: column;
    align-items: center;

    width: 0.625rem;
  }

  .connectionLineVertical {
    height: 4.6875rem;
    width: 2px;
    border-left: 1px solid @lib__colors__N300;
  }

  .connectionLineHorizontal {
    height: 2px;
    width: 1rem;
    margin-left: 0.875rem;
    border-top: 1px solid @lib__colors__N300;
  }

  .label {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: normal;
    color: @lib__colors__N900Primary;
  }

  .serviceIcon,
  .endpointIcon {
    margin-right: 0.75rem;
    fill: @lib__colors__N700Medium;
  }

  .serviceLabel {
    font-size: 0.875rem;
    color: @lib__colors__N700Medium;
    white-space: nowrap;
  }

  .link {
    font-size: 0.875rem;
  }
}

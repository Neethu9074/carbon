:local {
  .entryExitInformation {
    position: relative;
  }

  .serviceEndpointInformation {
    margin: 0 0 1.5rem 1.5rem;
  }

  .connectionLineWrapper {
    position: absolute;
    top: 2.1875rem;
    bottom: 1.75rem;

    display: flex;
    flex-direction: column;
    align-items: center;

    width: 0.625rem;
  }

  .connectionLine {
    height: 6.25rem;
    width: 2px;
    border-left: 1px dashed #009fd9;
  }

  .connectionAnchor {
    min-width: 0.375rem;
    min-height: 0.375rem;

    border-radius: 50%;
    border: 1px solid #009fd9;
  }

  .label {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: normal;
    color: #16363e;
  }

  .serviceRow,
  .endpointRow {
    display: flex;
    align-items: center;
  }

  .serviceRow {
    margin-bottom: 0.5rem;
  }

  .endpointRow {
    margin-left: 2rem;
  }

  .serviceIcon {
    margin-right: 1rem;
  }

  .endpointIcon {
    margin-right: 0.5rem;
  }

  .serviceLabel {
    font-size: 1rem;
    color: #47626a;
    white-space: nowrap;
  }

  .endpointLabel {
    font-size: 0.875rem;
    color: #5e777f;
    white-space: nowrap;
  }

  .link {
    text-decoration: none;
  }
}

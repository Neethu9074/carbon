@import '~in-themes/active.less';

:local {
  .timingInformation {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    margin: 1rem 0 2rem;
  }

  .callStartLabel {
    margin: 0 2rem;
  }

  .timeBlock {
    margin-right: 2rem;
    display: flex;
    align-items: center;
  }

  .timeColorIndicator,
  .label,
  .duration {
    font-size: 0.875rem;
  }

  .timeColorIndicator {
    margin-right: 0.5rem;
    min-width: 0.75rem;
    min-height: 0.75rem;
  }

  .label {
    margin-right: 0.5rem;
    color: @lib__colors__N700Medium;
    white-space: nowrap;
  }

  .duration {
    margin-right: 0.25rem;
    color: @lib__colors__N900Primary;
    font-weight: 500;
  }

  .durationInPercent {
    font-size: 0.75rem;
    color: @lib__colors__N600Light;
  }
}

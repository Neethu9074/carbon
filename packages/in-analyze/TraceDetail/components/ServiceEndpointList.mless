:local {
  .cell {
    display: flex;
    align-items: center;

    color: #47626a;
  }

  .colorIndicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 1px;
    margin-right: 0.5rem;
  }

  .label {
    white-space: nowrap;
  }

  .serviceIcon,
  .endpointIcon {
    margin-right: 0.5rem;
  }

  .aggregatedTime {
    color: #0c1415;
  }

  .timeIcon {
    margin-left: 0.5rem;
  }

  .errorIndicator {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    font-size: 0.625rem;
    background: #ff5d3b;
    color: white;
  }
}

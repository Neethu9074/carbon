@import '~in-themes/active.less';

:local {
  .cell {
    display: flex;
    align-items: center;
  }

  .colorIndicator {
    width: 0.75rem;
    height: 0.75rem;
    margin-right: 0.5rem;
  }

  .link {
    white-space: nowrap;
  }

  .serviceIcon,
  .endpointIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }

  .aggregatedTime {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .metricValue {
    font-size: 0.875rem;
    font-weight: 500;
  }
}

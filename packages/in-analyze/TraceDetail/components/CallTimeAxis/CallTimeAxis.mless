.timeAxis {
  width: 100%;
}

.axisLabel {
  position: relative;

  color: #fff;
  background: #00babb;
  border-radius: 2px;
  padding: 0.4em 0.6em;
  margin-bottom: 0.25rem;

  &::after {
    position: absolute;
    top: 1.4375rem;
    left: 0;

    width: 0;
    height: 0;

    content: '';
    border-bottom: 0.5rem solid transparent;
    border-right: 0.5rem solid transparent;
    border-left: 0.5rem solid #00babb;
  }
}

.icon {
}

@import '~in-themes/active.less';

:local {
  .callStartLabel {
    position: relative;

    color: @lib__colors__N700Medium;
    padding: 0.4em 0.6em 0.4em 1rem;
    margin-bottom: 0.25rem;
  }

  .icon {
    position: absolute;
    top: 0;
    left: -1rem;
    fill: @lib__colors__N700Medium;
  }
}

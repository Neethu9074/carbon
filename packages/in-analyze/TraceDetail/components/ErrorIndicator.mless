@import '~in-themes/active.less';

:local {
  .errorIcon {
    width: 1.375rem;
    height: 1.375rem;
    background-color: @lib__colors__failure;
    color: #fff;
    font-size: 1rem;
    border-radius: @lib__shapes__radius_small;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 .5rem 0 0;
  }
}
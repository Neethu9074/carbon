@import '~in-themes/active.less';

:local {
  .errorIcon {
    background-color: @lib__colors__failure;
    color: #fff;
    border-radius: @lib__shapes__radius_small;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0.5rem 0 0;
  }

  .errorIconDefault {
    width: 1.375rem;
    height: 1.375rem;
    font-size: 1rem;
  }

  .inChart {
    width: 100%;
    max-width: 1.375rem;
    height: 1.375rem;
    font-size: 1rem;
  }

  .errorIconSmall {
    width: 1rem;
    height: 1rem;
    font-size: 0.875rem;
  }
}

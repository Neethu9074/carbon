@import '~in-themes/active.less';

:local {
  .serviceEndpointInformation {
    display: flex;
    align-items: center;

    margin: 0.25rem 0 0 1.625rem;
  }

  .serviceIcon,
  .arrowIcon,
  .endpointIcon {
    margin-right: 4px;
    fill: @lib__colors__N600Light;
  }

  .arrowIcon {
    margin: 0 0.0625rem 0 0.25rem;
  }

  .link {
    white-space: nowrap;
    margin-bottom: 0.0625rem;

    &:hover {
      color: @lib__colors__N700Medium;
    }
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  @lineColor: @lib__colors__N400;

  .wrapper {
    position: relative;
  }

  .row {
    transition: background 0.4s ease-in-out;
    height: 3.5rem;
    padding: 0 5rem 0 0;
  }

  .rootRow {
    // this is used to get the call visualization in touch with the headers axis
    margin-top: -0.375rem;
  }

  .openedRow,
  .selectedRow {
    background: #f8f8f8;
    border-radius: 4px;
  }

  .openedRow.erroneousCall,
  .selectedRow.erroneousCall {
    background: #fdf4f9;
  }

  .detailGroup {
    display: flex;
    align-items: center;

    width: 100%;
  }

  .left {
    display: flex;
    align-items: center;

    min-width: 40%;
    max-width: 40%;
  }

  .leftLargeTrace {
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .expandIcon {
    border-radius: @lib__shapes__radius_small;
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.5rem;
    fill: @lib__colors__primary1;
    cursor: pointer;

    &:hover {
      fill: #12978e;
    }
  }

  .label {
    margin-right: 0.5rem;
    font-size: 0.875rem;

    .ellipsis();
  }

  .labelSelected {
    margin-right: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;

    .ellipsis();
  }

  .clickable {
    cursor: pointer;

    &:hover {
      text-decoration: underline;
    }
  }

  .batchSizeIndicator {
    margin-right: 0.5rem;
  }

  .dashedLine {
    border-bottom: 1px dashed @lineColor;
    flex-grow: 1;
  }

  .leftLine {
    border-bottom: 1px solid @lineColor;
    margin-right: 4px;
  }

  .intermediateLine,
  .lineEnd {
    position: absolute;
    top: -1.75rem;

    margin-left: 8px;
    border-right: 1px solid @lineColor;
    background: @lineColor;
  }

  .intermediateLine {
    bottom: 0;
  }

  .lineEnd {
    height: 2.5rem;
  }
}

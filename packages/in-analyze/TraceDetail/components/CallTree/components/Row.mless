@import '~in-themes/active.less';

:local {
  @lineColor: @lib__colors__N400;

  .wrapper {
    position: relative;
  }

  .row {
    padding-bottom: 1.25rem;
    transition: background 0.4s ease-in-out;
  }

  .rootRow {
    // this is used to get the call visualization in touch with the headers axis
    margin-top: -0.375rem;
  }

  .openedRow,
  .selectedRow {
    background: @lib__colors__N300;
  }

  .detailGroup {
    display: flex;
    align-items: center;

    width: 100%;
  }

  .left {
    display: flex;
    align-items: center;

    min-width: 40%;
    max-width: 40%;
  }

  .expandIcon {
    border-radius: @lib__shapes__radius_small;
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.5rem;
    fill: @lib__colors__primary1;
    cursor: pointer;

    &:hover {
      fill: #12978e;
    }
  }

  .label {
    margin-right: 0.5rem;
    color: @lib__colors__primary1;
    font-size: 0.875rem;

    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .clickable {
    cursor: pointer;

    &:hover {
      text-decoration: underline;
    }
  }

  .batchSizeIndicator {
    margin-right: 0.5rem;
  }

  .dashedLine {
    border-bottom: 1px dashed @lineColor;
    flex-grow: 1;
  }

  .leftLine {
    border-bottom: 1px solid @lineColor;
    margin-right: 4px;
  }

  .intermediateLine,
  .lineEnd {
    position: absolute;
    top: -35px;

    margin-left: 8px;
    border-right: 1px solid @lineColor;
    background: @lineColor;
  }

  .intermediateLine {
    bottom: 0;
  }

  .lineEnd {
    height: 45px;
  }
}

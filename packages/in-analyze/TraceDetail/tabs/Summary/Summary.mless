:local {
  .wrapper {
    display: flex;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    margin-top: 1.5rem;
  }

  .left {
    width: 100%;
  }

  .icicleChartWrapper {
    padding: 1rem 1rem 0;
  }

  .attemptRendering {
    display: block;
    margin: 1rem 0 0 0;
  }

  .startDate {
    font-size: 1.2rem;
    display: block;
    margin-top: 0.1rem;
  }
}

:local {
  .wrapper {
    display: flex;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    margin-top: 1.5rem;
  }

  .left {
    width: 100%;
  }

  .icicleChartWrapper {
    padding: 1rem 1rem 0;
  }

  .attemptRendering {
    display: block;
    margin: 1rem 0 0 0;
  }

  .startDate {
    font-weight: lighter;
    font-size: 1.3rem;
    margin: 0 0.4rem 0;
    white-space: nowrap;
  }
}

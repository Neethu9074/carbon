@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #F1F4F6;
    color: #47525D;
    padding: 0.5rem;
    font-size: .875rem;
    margin: 1rem 0;
    flex-wrap: wrap;
  }

  .leftSide {
    display: flex;
    align-items: center;
  }

  .icon {
    fill: @lib__colors__navy800;
    margin: 0 .188rem 0 0;
  }

  .title {
    color: #3D464D;
    font-weight: 600;
    margin: 0 0.5rem 0 0;
  }
}

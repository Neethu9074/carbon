:local {
  .container {
    display: inline-flex;
    margin-right: 1rem;
  }

  .label {
    font-weight: bold;
    margin-right: 0.25rem;
    text-transform: capitalize;
  }

  .skeleton {
    width: 5rem;
    height: 1rem;
    display: block;
    margin-right: 1rem;
  }

  .compactLi {
    padding: 0rem;
  }
}

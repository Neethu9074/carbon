@import '~in-themes/active.less';

:local {
  .kpiSection {
    display: flex;
    align-items: center;
    margin: 0 0 1rem 0;

    .in-dashboard__content-heading {
      display: none;
    }
  }
  .kpiKV {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;

    border-left: 3px solid @lib__colors__N200;
    padding: 0.3rem 2.5rem 0.3rem 1rem;
  }

  .key {
    display: block;
    color: @lib__colors__N700Medium;
    font-size: 1rem;
    font-weight: 200;
  }

  .value {
    font-size: 2.375rem;
    color: @lib__colors__N900Primary;
  }
}

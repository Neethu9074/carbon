@import '~in-themes/active.less';

:local {
  .kpiSection {
    display: flex;

    background: #fff;
    padding: 1rem;

    .in-dashboard__content-heading {
      display: none;
    }

    &__heading,
    &__kv {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;

      border-left: 3px solid @lib__colors__N200;
      padding: 0.3rem 2.5rem 0.3rem 1rem;
    }

    &__heading {
      font-weight: bold;
      font-size: 1.2rem;
      border-left: 0;
    }

    &__key {
      display: block;
      color: @lib__colors__N700Medium;
      font-size: 1rem;
      font-weight: 200;
    }

    &__value {
      font-size: 1.5rem;
      color: @lib__colors__N900Primary;
    }

    &__top-level-interaction {
      position: absolute;
      right: 1rem;

      display: flex;
      justify-content: flex-end;
    }
  }
}
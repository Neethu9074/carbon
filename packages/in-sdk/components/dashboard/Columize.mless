@import '~in-themes/mediaQueries.less';

:local {
  @media (min-width: 1200px) {
    .columize {
      display: flex;
      flex-direction: row;

      & > div {
        width: 100%;
        flex-grow: 0;
        padding-right: 1rem;

        &:last-child {
          padding-right: 0;
        }
      }
    }
  }
}

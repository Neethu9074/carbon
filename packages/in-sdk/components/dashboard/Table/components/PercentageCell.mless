@import '~in-themes/active.less';

:local {
  .percentageCell {
    position: relative;
    height: 100%;
    margin: 0 -0.5rem;
    display: flex;
    align-items: center;
  }
  .percentageCellLevel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background: @lib__colors__N400;
  }

  .percentageCellValue {
    // Position above level indicator.
    position: relative;

    display: flex;
    align-items: center;
    padding: 0 0.5rem;
  }
}

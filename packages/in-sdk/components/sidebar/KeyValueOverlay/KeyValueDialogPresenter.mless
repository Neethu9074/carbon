@import '~in-themes/mixins.less';

:local {
  .body {
    width: 36rem;
    max-height: 18.75rem;
    background: #fff;
    overflow-y: auto;
    padding: 0 1.5rem;
    z-index: var(--ids-z-index-option-detail-popup-presenter);
  }
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    background: var(--ids-color-option-neutral-200);
    color: var(--ids-color-option-neutral-700);
    font-size: var(--ids-font-size-option-heading-200);
    font-weight: 300;
  }

  .keyValueItem {
    display: flex;
    padding: 1rem 0;
    border-top: 1px solid var(--ids-color-option-neutral-200);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .listItem {
    display: flex;
    border-top: 1px solid var(--ids-color-option-neutral-200);
    padding: 1rem 0;
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-900);
    font-weight: bold;
    line-height: 1.15;
  }

  .key {
    width: 50%;
    padding-right: 0.2rem;
    word-break: break-all;
  }

  .value {
    width: 50%;
    text-align: right;
    padding-right: 0.2rem;
    word-break: break-all;
    margin-bottom: 0;
  }
}

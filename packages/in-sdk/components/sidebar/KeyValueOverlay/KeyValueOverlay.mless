@import '~in-themes/active.less';

:local {
  .item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .header {
    font-size: 0.75rem;
    white-space: nowrap;
    color: #6b8088;
  }

  .button,
  .buttonOpen {
    border-radius: 0.1875rem;
    padding: 0.25rem 0.1875rem;
    cursor: pointer;
  }

  .button:hover,
  .buttonOpen {
    background: @lib__colors__N800Dark;
    .icon {
      fill: white;
    }
  }

  .icon {
    margin: 0 0.3125rem;
    fill: @lib__colors__light-blue800;
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .item {
    border-bottom: 1px solid @lib__colors__N300;
    cursor: pointer;
    font-size: 0.75rem;
    padding: .75rem 1rem;
    margin: 0;
    color: @lib__colors__blue800;
    .breakWord();

    &:hover {
      color: lighten(@lib__colors__blue800, 20%);
      text-decoration: underline;
    }

    &:last-child {
      border-bottom: 0px;
    }
  }

  .link {
    display: block;
    text-decoration: none;
    color: inherit;

    &:hover,
    &:focus {
      color: inherit;
    }
  }

  .labelWithIcon {
    display: flex;
    align-items: center;
  }

  .pluginIcon {
    margin-right: 0.5rem;
    fill: #777777;
  }
}
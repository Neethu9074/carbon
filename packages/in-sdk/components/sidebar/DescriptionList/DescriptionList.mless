@import '~in-themes/mixins.less';

:local {
  .descriptionList {
    margin: 0;
    padding: 0 1rem;
  }

  .descriptionListItem {
    justify-content: space-between;
    padding: 0.5rem 0;
  }

  .itemTitle {
    display: block;
    font-size: 0.75rem;
    color: var(--ids-color-option-navy-800);
    font-weight: bold;
    margin: 0 0 0.063rem;
    word-break: break-all;
  }

  .itemText {
    font-size: 0.75rem;
    display: block;
    color: var(--ids-color-option-neutral-700);
    word-break: break-all;
    margin: 0;
  }

  .descriptionList:empty + .descriptionListNoDetails {
    display: block;
  }

  .descriptionListNoDetails {
    display: none;
    padding: 0.75rem 1rem 0;
    font-size: 0.75rem;
  }
}

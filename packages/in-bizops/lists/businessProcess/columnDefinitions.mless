@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .label {
    font-weight: var(--ids-font-weight-option-heading-400);
    margin-bottom: 0.25rem;
  }

  .processName {
    display: inline-block;
  }

  .ellipsis {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    line-clamp: 1;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    line-break: anywhere;
  }
}

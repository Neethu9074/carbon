:local {
  .tearsheetOuter {
    z-index: 130 !important;
  }

  .mainDiv {
    margin: var(--cds-spacing-07);
  }

  .headline {
    font-size: var(--cds-heading-03-font-size);
    font-weight: var(--cds-heading-01-font-weight);
    margin-bottom: var(--cds-spacing-03);
  }

  .subtitle {
    color: var(--cds-text-secondary);
    font-size: var(--cds-label-02-font-size);
    margin-bottom: var(--cds-spacing-05);
  }

  .textInput {
    margin-bottom: var(--cds-spacing-06);
    width: 40%;
  }

  .textArea {
    margin-bottom: var(--cds-spacing-06);
  }

  .teamsSelect {
    margin-bottom: var(--cds-spacing-08);
  }

  .listHeader {
    display: flex;
    align-content: flex-end;
    align-items: flex-end;
    gap: 10px;
  }

  .listHeadline {
    font-size: var(--cds-heading-03-font-size);
    font-weight: var(--cds-heading-01-font-weight);
  }

  .influencerCard {
    margin: 0;
    padding: var(--cds-spacing-05) 0 0 0;
  }

  .filterCard {
    border: 1px solid var(--cds-border-subtle-02);
  }

  .filterCardFlex {
    display: flex;
    justify-content: space-between;
  }

  .emptyState {
    margin: var(--cds-spacing-05);
  }
}

:global {
  /* We need to increase the width of the influencer to fit the content */
  .c4p--tearsheet__influencer--wide:has(.bizops-processes-live-list) {
    flex-basis: 375px;
    background-color: var(--cds-layer);
  }
}

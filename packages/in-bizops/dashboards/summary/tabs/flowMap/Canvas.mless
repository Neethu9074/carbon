:local {
  .svg {
    display: flex;
  }

  /*
    We needed to expand the canvas content area to the entire width of the browser window,
    and the height up to the tab bar since the parent component <TabView/> adds unsightly
    padding to the canvas.

    The margin is set to the exact dimensions of not needed padding in
    packages/in-components/layout/LeftRightPadding/LeftRightPadding.mless
  */
  .canvas {
    margin: -1.5rem;
    height: calc(100vh - 218px);
  }
}

@import '~in-themes/active.less';

:local {
  .title {
    font-size: 1.375rem;
    margin-top: 1.5rem;
    font-weight: 500;
  }

  .button {
    margin-right: 0.5rem;
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .linkEntityIcon,
  .entityIcon {
    margin-right: 0.25rem;
  }

  .linkEntityIcon {
    fill: @lib__colors__blue800;
  }

  .entityIcon {
    fill: @lib__colors__N700Medium;
  }
}

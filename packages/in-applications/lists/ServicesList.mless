@import '~in-themes/active.less';

:local {
  .filter {
    z-index: 4;
  }

  .filter,
  .button {
    margin-right: 0.5rem;
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .linkEntityIcon,
  .entityIcon {
    margin-right: 0.25rem;
  }

  .linkEntityIcon {
    fill: @lib__colors__blue800;
  }

  .entityIcon {
    fill: @lib__colors__N700Medium;
  }

  .tableHeader {
    margin-top: -3.1875rem;
  }
}

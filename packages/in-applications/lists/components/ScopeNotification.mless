@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    border: 1px solid var(--ids-color-option-neutral-400);
    margin-bottom: 0.5rem;
    height: 2.5625rem;
    padding: 0 0.5rem;
  }

  .notificationText {
    flex-grow: 1;
  }

  .bold {
    font-weight: 600;
  }

  .icon {
    fill: var(--ids-color-option-neutral-600);
    margin-right: 0.25rem;
  }
}

:local {
  .wrapper {
    display: flex;
    margin: 3rem 0 1rem;
    padding: 0;
    border-bottom: 2px solid #d5dfe4;
    list-style: none;
  }

  .link {
    margin: 0.25rem 1rem -2px 0;
    text-decoration: none;
    font-size: 1rem;
    font-weight: bold;
    padding-bottom: 0.75rem;
    color: #71868d;

    &:hover {
      text-decoration: none;
    }
  }

  .active {
    border-bottom: 2px solid black;
    color: black;
  }
}

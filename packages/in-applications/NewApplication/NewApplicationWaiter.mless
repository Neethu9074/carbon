  :local {

    .wrapper {
      display: flex;
      justify-content: center;
      flex-direction: column;
      align-items: center;
      height:100%
    }


    .heading {
      margin: 0 0 2rem;
      justify-content: center;
    }

    .headingIcon {
        fill: #000;
        background: #fff;
        padding: 6px;
      }

     .spinner {
          margin-right: 1rem;
          fill: #000;
      }


  }


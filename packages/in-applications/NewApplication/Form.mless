@import '~in-themes/active.less';

:local {
  .matchSpecification {
    display: flex;
    align-items: flex-start;

    & + .matchSpecification {
      margin-top: 1rem;
    }
  }

  .matchHelp {
    margin: 0 0 1rem;
  }

  .formGroup {
    margin: 0;
    width: 100%;

    & + .formGroup {
      margin-left: 1rem;
    }
  }

  .removeMatchRule {
    margin: 1.4rem 0 0 1rem;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin: @grid__gutter * 1px 0 0;
  }

  .saveErrors {
    margin: 0 1rem 0 0;
  }

  .addRule {
    display: flex;
    align-items: center;

    margin-top: 1rem;
    color: #00babb;
    cursor: pointer;

    &:hover {
      color: #00a1a3;

      .addRuleIcon {
        fill: #00a1a3;
      }
    }
  }

  .addRuleIcon {
    fill: #00babb;
    margin-right: 0.5rem;
  }
}

@import '~in-themes/active.less';

:local {
  .container {
    padding: 0 1rem;
  }

  .descriptionText {
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .filter {
    margin: 0.25rem;
  }

  .addRuleButtonWrapper {
    display: flex;
    justify-content: flex-end;

    width: 100%;

    margin-bottom: 0.5rem;
  }

  .heading {
    font-size: 1rem;
    color: var(--ids-color-option-neutral-900);
    margin-bottom: 1.5rem;
  }

  .loadingIndicator {
    min-height: 25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contributionFilter {
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
  }

  .queryBuilder {
    margin: 1rem 0;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .queryBuilderExpression {
    flex-grow: 1;
  }

  .errorMessage {
    margin-top: 0.5rem;
  }
  .listItem {
    width: 64.2rem;
  }
}

@import '~in-themes/active.less';

:local {
  .container {
    padding: 0 1rem;
  }

  .descriptionText {
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .filter {
    margin: 0.25rem;
  }

  .addRuleButtonWrapper {
    display: flex;
    justify-content: flex-end;

    width: 100%;

    margin-bottom: 0.5rem;
  }

  .heading {
    font-size: 1rem;
    color: @lib__colors__N900Primary;
    margin-bottom: 1.5rem;
  }

  .queryBuilder {
    margin: 1rem 0;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .queryBuilderExpression {
    flex-grow: 1;
  }

  .errorMessage {
    margin-top: 0.5rem;
  }
}

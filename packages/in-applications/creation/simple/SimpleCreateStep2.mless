@import '~in-themes/active.less';

:local {
  .filterWrapper {
    grid-column: 1 / span 2;
    padding: 0 0.5rem;
    margin-top: 0.5rem 0 1rem;
    overflow-y: auto;
  }

  .descriptionText {
    font-size: 0.8rem;
    line-height: 1.5;
  }
}

@import '~in-themes/active.less';

:local {
  .applicationScopeSwitchContainer {
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_small;
    padding: 1rem 0rem;
    margin-bottom: 1rem;
  }

  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
      padding-top: 0.2rem;
      padding-bottom: 0.2rem;
    }

    &.optionBoxUnchecked {
      svg {
        fill: @lib__colors__N600Light;
      }

      * {
        color: @lib__colors__N600Light;
      }
    }
  }
}

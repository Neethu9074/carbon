:local {
  .applicationScopeSwitchContainer {
    border: 1px solid var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-small);
    padding: 1rem 0rem;
    margin-bottom: 1rem;
  }

  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
      padding-top: 0.2rem;
      padding-bottom: 0.2rem;
    }

    &.optionBoxUnchecked {
      svg {
        fill: var(--ids-color-option-neutral-600);
      }

      * {
        color: var(--ids-color-option-neutral-600);
      }
    }
  }
}

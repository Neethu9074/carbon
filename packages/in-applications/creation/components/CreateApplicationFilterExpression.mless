@import '~in-themes/active.less';

:local {
  .contributionFilter {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
  }
  .queryBuilder {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .queryBuilderExpression {
    flex-grow: 1;
  }
  .listItem {
    width: 35.8rem;
  }
}

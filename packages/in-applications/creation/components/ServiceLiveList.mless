@import '~in-themes/active.less';

:local {
  .cardContainer {
    margin: 0 1rem 1rem 0;
    height: fit-content;
  }

  .header {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
  }

  .filtersPrompt {
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--ids-color-option-neutral-600);
    margin: 1rem;
  }

  .center {
    display: flex;
    justify-content: center;
    align-items: center;
  }
}

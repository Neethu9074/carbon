@import '~in-themes/active.less';

:local {
  .cardContainer {
    margin: 0 1rem 1rem 0;
    height: fit-content;
  }

  .header {
    border-bottom: 1px solid @lib__colors__N300;
  }

  .filtersPrompt {
    font-size: 0.75rem;
    font-weight: 300;
    color: @lib__colors__N600Light;
    margin: 1rem;
  }
}

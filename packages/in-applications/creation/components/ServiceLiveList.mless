@import '~in-themes/active.less';

:local {
  .cardContainer {
    margin-right: 1rem;
    height: fit-content;
  }

  .header {
    border-bottom: 1px solid @lib__colors__N300;
  }

  .listContainer {
    max-height: 22rem;
    overflow-y: auto;
  }

  .filtersPrompt {
    font-size: 0.75rem;
    font-weight: 300;
    color: @lib__colors__N600Light;
    margin: 1rem;
  }
}

:local {
  .contribution_filter_label_txt {
    color: var(--ids-color-option-neutral-700);
  }
  .contribution_filter_label_description {
    font-weight: 400;
    margin-bottom: 0;
  }
  .dropdownCarbonButton {
    max-width: none;
    align-items: center;
    &:global(.carbonButton) {
      color: var(--cds-text-primary);
    }
  }
  .showEllipsisForLongText {
    max-width: 100%;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }
}

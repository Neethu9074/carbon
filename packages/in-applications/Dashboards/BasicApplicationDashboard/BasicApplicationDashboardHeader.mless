:local {
  .basicDashboardHeader {
    display: flex;
    flex-direction: column;

    min-height: 3.75rem;
    max-height: 3.75rem;
    overflow: hidden;

    padding-top: 0.5rem;
  }

  .type {
    margin-bottom: 0.5rem;
    color: #5229bd;
    font-weight: bold;
    text-transform: uppercase;
  }

  .label {
    font-weight: bold;
    font-size: 1rem;
  }
}

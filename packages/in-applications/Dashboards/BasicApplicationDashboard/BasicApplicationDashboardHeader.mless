:local {
  .basicDashboardHeader {
    display: flex;

    align-items: center;
    min-height: 3.375rem;
    max-height: 3.375rem;
    overflow: hidden;

    padding-top: 0.5rem;
  }

  .type {
    margin-bottom: 0.5rem;
    color: #5229bd;
    font-weight: bold;
    text-transform: uppercase;
  }

  .label {
    font-weight: bold;
    font-size: 1rem;
  }
}

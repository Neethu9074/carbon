:local {
  .header {
    padding: 1.65rem 0 1.175rem;
  }

  .type {
    display: block;
    margin: 0 0 4px;

    font-size: .875rem;
    color: #16363E;
    font-weight: 600;
  }

  .label {
    margin: 0 1rem 0 0;

    font-weight: 600;
    font-size: 1.625rem;
    color: #0C2227;
  }

  .labelAligned {
    display: flex;
    align-items: center;
  }

  .typeSkeleton {
    width: 6.25rem;
    height: 1rem;
    margin: 0 0 .25rem;
    display: block;
  }

  .labelSkeleton {
    width: 12.5rem;
    height: 1.813rem;
    display: block;
  }
}

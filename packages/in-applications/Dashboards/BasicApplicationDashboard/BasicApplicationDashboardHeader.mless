@import '~in-themes/mixins.less';

:local {
  .header {
    padding: 1.65rem 0;
    position: relative;
  }

  .type {
    display: block;
    margin: 0 0 4px;

    font-size: 0.875rem;
    color: #16363e;
    font-weight: 500;
  }

  .label {
    margin: 0 1rem 0 0;

    font-weight: 400;
    font-size: 1.625rem;
    color: #0c2227;

    max-width: 70vw;
    .ellipsis()
  }

  .labelAligned {
    display: flex;
    align-items: center;
  }

  .typeSkeleton {
    width: 6.25rem;
    height: 1rem;
    margin: 0 0 0.25rem;
    display: block;
  }

  .labelSkeleton {
    width: 12.5rem;
    height: 1.813rem;
    display: block;
  }

  .actions {
    position: absolute;
    right: 0;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
}

@import '~in-themes/active.less';

:local {
  .row + .row {
    margin-top: 0.5rem;
  }

  .contributed {
    display: inline-block;

    font-size: 0.75rem;
    font-weight: bold;
    color: @lib__colors__N900Primary;
  }

  .contributedAlignmentHelper {
    display: block;
  }

  .leftAlignedContribution {
    margin-left: ~'calc(-100% - 6px)';
  }

  .hairLine {
    width: 1px;
    height: 12px;
    margin-top: -10px;
    position: relative;
    left: -1px;
  }

  .bar {
    position: relative;
    width: 100%;
    height: 0.25rem;
    background: @lib__colors__N300;
    overflow: hidden;
    border-radius: 0.125rem;
  }

  .barInner {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    border-radius: 0.125rem 0 0 0.125rem;
  }

  .description {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .left {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .right {
    display: flex;
    justify-content: flex-end;
  }

  .icon {
    fill: @lib__colors__N700Medium;
  }

  .label {
    margin: 0 0.4rem;
    font-size: 0.875rem;
    color: @lib__colors__N700Medium;
  }

  .numberOfTracesIndicator {
    color: @lib__colors__N600Light;
    font-size: 0.875rem;
  }

  .total {
    font-size: 0.875rem;
    font-weight: 600;
    color: @lib__colors__N900Primary;
  }
}

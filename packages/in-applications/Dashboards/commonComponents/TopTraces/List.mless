@import '~in-themes/active.less';

:local {
  .topList {
    width: 100%;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contributedService {
    display: flex;
    align-items: center;

    white-space: nowrap;
    overflow: hidden;
  }

  .serviceIcon {
    margin-right: 0.25rem;
    fill: @lib__colors__N900Primary;
  }

  .serviceLabel {
    margin-right: 0.25rem;
    color: @lib__colors__N700Medium;
  }
}

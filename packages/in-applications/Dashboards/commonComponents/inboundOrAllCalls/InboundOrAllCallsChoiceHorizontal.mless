@import '~in-themes/active.less';

:local {
  .headerPreview {
    color: var(--ids-color-option-teal-500);
    font-size: 1rem;
    font-weight: normal;
    vertical-align: middle;
  }

  .headerIcon {
    margin-right: 1rem;
    fill: var(--ids-color-option-teal-500);
    vertical-align: middle;
  }

  .card {
    margin-bottom: 1.5rem;
  }

  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
    }

    &.optionBoxUnchecked {
      svg {
        fill: var(--ids-color-option-neutral-600);
      }

      * {
        color: var(--ids-color-option-neutral-600);
      }
    }

    &.noPaddingBottom {
      padding-bottom: 0;
    }
  }

  .icon {
    margin-left: 0.5rem;
  }
}

@import '~in-themes/active.less';

:local {
  li.menuitem {
    block-size: min-content !important;
    min-width: fit-content !important;
  }

  li.menuitem:first-child {
    padding-top: 0.25rem;
  }

  li.menuitem:not(first-child) {
    border-bottom: 0.0625rem solid var(--cds-border-subtle);
    padding-bottom: 0.25rem;
    padding-top: 0.25rem;
  }

  li.menuitem:not(last-child) {
    padding-bottom: 0.25rem;
  }

  li.menuitem:last-child {
    border-bottom: none;
  }

  .selected {
    background: var(--cds-layer-selected);
  }

  .menubutton {
    display: flex;
    align-items: center;
    :global {
      .carbonTooltipPopoverWrapper {
        max-height: 18px;
        max-width: 18px;
      }
    }
  }

  .icon {
    margin-right: 0.25rem;
  }

  svg.svg-icon.tooltipIcon {
    transform: unset;
  }

  .tooltipIcon {
    margin-left: 0.25rem;
    transform: unset !important;
  }

  .option {
    min-width: fit-content;
    display: grid;
    grid-template-columns: 2rem auto;
  }

  .optionText {
    display: flex;
    flex-direction: column;
  }

  .optionIcon {
    align-self: center;
  }

  .label {
    grid-column-start: 2;
    font-size: var(--cds-heading-01-font-size);
    font-weight: var(--cds-heading-01-font-weight);
    line-height: var(--cds-heading-01-line-height);
    letter-spacing: var(--cds-heading-01-letter-spacing);
  }

  .description {
    font-size: var(--cds-label-01-font-size);
    font-weight: var(--cds-label-01-font-weight);
    line-height: var(--cds-label-01-line-height);
    letter-spacing: var(--cds-label-01-letter-spacing);
    margin-top: 0.5rem;
    grid-column-start: 2;
    text-wrap: wrap;
    overflow: hidden;
  }

  ul:has(.menuitem) {
    padding: 0;
  }

  svg.icon {
    transform: unset;
  }
}

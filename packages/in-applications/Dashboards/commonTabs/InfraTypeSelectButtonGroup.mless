@import '~in-themes/active.less';

:local {
  .buttonGroup {
    display: flex;
    margin-right: 0.5rem;
  }

  .selected {
    color: #fff;
    background: @lib__colors__light-blue800;

    &:hover {
      color: #fff;
      background: @lib__colors__light-blue800;
      cursor: default;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .cell {
    display: inline-flex;
    align-items: center;
    cursor: not-allowed;
    color: var(--ids-color-option-neutral-500);
  }

  .simplePluginIcon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-500);
  }

  .linkWithMetaEntities {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .metaRow {
    display: flex;
    align-items: center;

    color: var(--ids-color-option-neutral-500);
    font-size: 0.75rem;
  }

  .entitiyIcon {
    margin-left: 0.125rem;
    fill: var(--ids-color-option-neutral-500);
  }

  .entityLink {
    margin-right: 0.25rem;
    color: var(--ids-color-option-neutral-500);
  }
}

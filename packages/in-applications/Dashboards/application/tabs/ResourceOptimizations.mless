:local {
  .contentContainer {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .charts {
    display: flex;
    justify-content: flex-start;
    gap: 24px;
    margin-left: 16px;
    margin-right: 16px;
  }
  .box1 {
    height: 328px;
    width: 35%;
  }

  .box2 {
    height: 328px;
    width: 65%;
  }
}

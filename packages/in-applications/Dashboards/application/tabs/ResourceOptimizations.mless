:local {
  .contentContainer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2.5rem;
  }
  .charts {
    display: flex;
    justify-content: flex-start;
    gap: 1.5rem;
  }
  .categoriesChart {
    height: 328px;
    width: 35%;
  }

  .latencyAndDistributionChart {
    height: 328px;
    width: 65%;
  }
}

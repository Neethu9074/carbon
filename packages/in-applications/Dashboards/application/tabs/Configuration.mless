@import '~in-themes/active.less';

:local {
  .notificationContainer {
    display: flex;
    justify-content: center;
    margin: 1rem;
  }

  .successIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__success;
  }

  .successLabel {
    color: @lib__colors__success;
    font-weight: bold;
  }

  .errorIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__failure;
  }

  .errorLabel {
    color: @lib__colors__failure;
    font-weight: bold;
  }
}

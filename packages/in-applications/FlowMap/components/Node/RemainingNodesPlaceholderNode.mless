@import '~in-themes/active.less';

:local {
  .wrapper {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 15.625rem;
    height: 2rem;
    padding: 0 0.5rem;

    background: white;
    border-radius: var(--ids-border-radius-medium);
  }

  .loadingIcon,
  .errorIcon {
    margin-left: 0.5rem;
  }

  .loadingIcon {
    fill: var(--ids-color-option-blue-500);
  }

  .errorIcon {
    fill: var(--ids-color-option-red-500);
  }

  .totalReminaingNodesLabel {
    color: var(--ids-color-option-neutral-500);
    margin-left: 0.5rem;
  }
}

@import '~in-themes/active.less';

:local {
  .metrics {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    height: 2rem;
    padding: 0 0.5rem 0.375rem;

    background: var(--ids-color-option-neutral-300);
    color: var(--ids-color-option-neutral-800);
    border-radius: 0 0 var(--ids-border-radius-option-medium) var(--ids-border-radius-option-medium);
  }
}

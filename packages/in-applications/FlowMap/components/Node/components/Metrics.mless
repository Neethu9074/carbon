@import '~in-themes/active.less';

:local {
  .metrics {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    height: 2rem;
    padding: 0 0.5rem 0.375rem;

    background: @lib__colors__N300;
    color: @lib__colors__N800Dark;
    border-radius: 0 0 3px 3px;
  }
}

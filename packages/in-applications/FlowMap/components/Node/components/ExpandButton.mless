@import '~in-themes/active.less';

:local {
  .expandButtonRight,
  .expandButtonLeft {
    position: absolute;
    bottom: 0.5rem;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 1.375rem;
    height: 1.375rem;
    background: var(--ids-color-option-teal-500);
    border-radius: 50%;

    cursor: pointer;

    &:hover {
      background: #12978e;
    }
  }

  .expandButtonRight {
    right: -1.5625rem;
  }

  .expandButtonLeft {
    left: -1.5625rem;
  }

  .expandIcon {
    fill: #fff;
  }

  .errorneousExpandIcon {
    background: var(--ids-color-option-red-500);
  }
}

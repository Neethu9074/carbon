@import '~in-themes/active.less';

:local {
  .node {
    position: absolute;

    display: flex;
    flex-direction: column;
    justify-content: flex-start;

    height: 2.5rem;
    top: -1.25rem;
    width: 15.625rem;
    left: -7.8125rem;
  }

  .serviceLabel {
    position: absolute;
    bottom: 100%;

    display: flex;
    align-items: center;

    color: @lib__colors__N600Light;
  }

  .serviceLabelHeatMapEnabled {
    bottom: ~'calc(100% + .5rem)';
  }

  .serviceIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }

  .childList {
    position: relative;

    margin: 0;
    padding: 0;
    list-style: none;
  }

  .childWrapper {
    position: relative;

    margin-bottom: 2.5rem;
  }
}

:local {
  .progressLineWrapper {
    position: relative;

    width: 100%;
    height: 1px;
    background: #e7ecec;
  }

  .progressLine {
    position: absolute;
    top: 0;
    left: 0;

    height: 2px;
    background: #5229bd;
    transition: width 0.125s ease-in-out;
  }

  .errorLine {
    background: #ff4229;
  }
}

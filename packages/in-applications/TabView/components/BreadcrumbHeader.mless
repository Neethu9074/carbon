:local {
  .breadcrumbHeader {
    display: flex;
    align-items: center;

    height: 3.125rem;
    padding: 0 0.625rem;
    margin: 0;
    list-style: none;

    background: #5229bd;
    color: #fff;
    overflow: hidden;
  }

  .container {
       margin-left: 0.9rem;
       display: flex;
     }

  .chevron {
    margin: 0 0.5rem;
  }
}

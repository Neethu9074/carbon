@import '~in-themes/active.less';

:local {
  .breadcrumbHeader {
    background: #5229bd;
    color: #fff;
    overflow: hidden;
  }

  .container {
    max-width: @max-width * 1px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    align-items: center;
    height: 3.125rem;
   }

  .chevron {
    margin: 0 0.5rem;
  }
}

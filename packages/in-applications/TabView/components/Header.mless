:local {
  .header {
    display: flex;
    flex-direction: column;
    background: white;

    height: 5rem;
  }

  .tabList {
    display: flex;

    list-style: none;
    margin: 0;
    padding: 0;

    border-bottom: 2px solid #cbd6dc;
    font-size: 14px;
  }

  .link {
    text-decoration: none;
    color: #4d5c5d;

    &:hover {
      color: black;
      text-decoration: none;
    }
  }

  .tab {
    margin-right: 1rem;
    padding-bottom: 0.5rem;
    margin-bottom: -2px;
    cursor: pointer;
  }

  .selected {
    border-bottom: 2px solid #5229bd;
  }

  .selectedLink {
    color: #5229bd;
  }
}

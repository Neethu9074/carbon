:local {
  .header {
    background: white;
    border-bottom: 1px solid #D5DFE4;
  }

  .tabList {
    display: flex;

    list-style: none;
    margin: 0;
    padding: 0;

    font-size: 14px;
  }

  .link {
    text-decoration: none;
    color: #698189;
    padding-bottom: 0.5rem;
    display: block;
    font-weight: 500;
    cursor: pointer;

    &:hover {
      color: black;
      text-decoration: none;
    }
  }

  .tab {
    margin-right: 1rem;
    margin-bottom: -2px;
  }

  .selected {
    border-bottom: 3px solid #1FB7B9;
  }

  .selectedLink {
    color: #16363E;
  }
}

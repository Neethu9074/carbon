:local {
  .header {
    background: white;
    border-bottom: 1px solid #d5dfe4;
  }

  .tabList {
    display: flex;

    list-style: none;
    margin: 0;
    padding: 0;

    font-size: 14px;
  }

  .link {
    text-decoration: none;
    color: #698189;
    padding-bottom: 0.5rem;
    display: block;
    font-weight: 400;
    cursor: pointer;

    &:hover {
      color: black;
      text-decoration: none;
    }
  }

  .tab {
    margin-right: 1rem;
    margin-bottom: -1px;
  }

  .selected {
    border-bottom: 3px solid #1fb7b9;
  }

  .selectedLink {
    color: #16363e;
  }
}

:local {
  .header {
    display: flex;
    flex-direction: column;
    background: white;

    height: 5rem;
  }

  .tabList {
    display: flex;

    font-size: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link {
    text-decoration: none;
    color: #4d5c5d;

    &:hover {
      color: black;
      text-decoration: none;
    }
  }

  .tab {
    margin-right: 1rem;
    padding-bottom: 0.25rem;
    cursor: pointer;
  }

  .selected {
    border-bottom: 1px solid #293a3b;
  }
}

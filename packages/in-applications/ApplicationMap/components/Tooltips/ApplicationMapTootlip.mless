:local {
  .wrapper {
    display: flex;
    align-items: flex-start;
    flex-direction: column;

    width: 19rem;
    padding: 1rem;

    background: #fff;
    border-radius: var(--ids-border-radius-option-large);
    border: 1px solid var(--ids-color-option-neutral-400);

    overflow: hidden;
  }

  .header {
    width: 100%;
  }

  .line {
    width: ~'calc(100% + 2rem)';
    height: 1px;
    margin: 1rem -1rem 0 -1rem;

    background: var(--ids-color-option-neutral-300);
  }

  .content {
    width: 100%;
    margin-top: 1rem;
  }
}

@import '~in-themes/mixins.less';

:local {
  .connectionTooltipMounter {
    position: absolute;
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .icon {
    fill: var(--ids-color-option-neutral-700);
    margin-right: 0.5rem;
  }

  .labelFlexWrapper {
    display: flex;
    flex-direction: column;

    overflow: hidden;
  }

  .label {
    font-size: 1rem;
    color: var(--ids-color-option-neutral-900);

    .ellipsis();
  }

  .metrics {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
  }

  .metricLabel {
    margin-bottom: 0.25rem;
    font-weight: 500;
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-700);
  }
}

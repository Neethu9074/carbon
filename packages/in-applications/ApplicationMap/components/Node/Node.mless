@import '~in-themes/mixins.less';

:local {
  .wrapper {
    position: absolute;

    display: flex;
    align-items: center;
    justify-content: center;

    transition: opacity 0.25s ease-in-out;
  }

  .shape {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--ids-color-option-neutral-700);
    border-radius: 50%;
    cursor: pointer;

    &:hover {
      box-shadow: 0px 2px 4px -2px var(--ids-color-option-neutral-300);
    }

    .icon {
      fill: #fff;
    }
  }

  .isExternal {
    background: var(--ids-color-option-neutral-400);

    .icon {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .health_healthy {
    border: 1px solid var(--ids-color-option-neutral-700);

    &:hover {
      border: 1px solid var(--ids-color-option-neutral-300);
    }
  }

  .health_warning {
    border: 5px solid var(--ids-color-option-yellow-500);
  }

  .health_danger {
    border: 5px solid var(--ids-color-option-red-500);
  }

  .label {
    position: absolute;
    top: ~'calc(100% + 0.125rem)';

    display: flex;
    align-items: center;

    height: 1.5rem;
    padding: 0 0.5rem;
    font-size: 0.875rem;

    background: var(--ids-color-option-neutral-200);
    border-radius: var(--ids-border-radius-small);
    color: var(--ids-color-option-neutral-900);
    .ellipsis();
  }
}

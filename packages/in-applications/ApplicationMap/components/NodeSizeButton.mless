:local {
  .sizeMetricLabel {
    font-size: 0.875rem;
    color: var(--ids-color-option-neutral-600);
  }

  .labelWrapper {
    display: flex;
    align-items: center;

    margin-left: 0.25rem;
  }

  .expandIcon {
    fill: var(--ids-color-option-neutral-600);
  }

  .contextMenu {
    padding: 1rem;
    margin: 0;

    background: #fff;
  }

  .metric {
    position: relative;

    display: flex;
    align-items: center;

    padding: 0.5rem;
    list-style: none;
    background: #fff;
    cursor: pointer;

    &:hover {
      background: var(--ids-color-option-neutral-100);
    }
  }

  .sizeMetricLabelSeperator {
    margin: 0 0.25rem;
    color: var(--ids-color-option-neutral-600);
  }
}

:local {
  .wrapper {
    position: relative;

    width: 100%;
    height: 100%;
    background: #fff;
    overflow: hidden;

    border: 1px solid var(--ids-color-option-neutral-100);
  }

  .overlay,
  .centerWrapper {
    position: absolute;

    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }

  .icon {
    fill: var(--ids-color-option-neutral-500);
  }

  .canvas {
    display: block;
    width: 100%;
  }
}

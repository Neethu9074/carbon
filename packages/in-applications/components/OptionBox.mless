@import '~in-themes/mixins.less';

:local {
  .wrapper {
    padding: 1rem 0.5rem 1rem 1rem;
    border: 1px solid var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-option-large);
  }

  .icononly {
    margin-right: 0.25rem;
  }

  .content {
    width: 85%;
  }

  .titlediv {
    display: flex;
    align-items: flex-start;
    flex-direction: row;
  }

  .description {
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--ids-color-option-neutral-600);
    margin-top: 0.5rem;

    .betaBadge {
      margin-top: 8px;
      width: max-content;
    }
  }

  .space {
    margin-top: 0.5rem;
  }
}

:local {
  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .labelWrapper {
    display: flex;
    flex-direction: column;
  }

  .context {
    font-size: 0.75rem;
    line-height: 0.75rem;
    color: var(--ids-color-option-neutral-600);
  }

  .icon {
    margin-right: 0.5rem;
  }

  .link {
    color: var(--ids-color-option-neutral-600);
  }

  .toggleIcon {
    fill: var(--ids-color-option-neutral-500);
    margin-left: 0.125rem;
  }

  .label {
    display: flex;
    align-items: center;

    font-size: 0.875rem;
    line-height: 0.875rem;
  }
}

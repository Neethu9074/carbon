@import '~in-themes/active.less';

:local {
  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .labelWrapper {
    display: flex;
    flex-direction: column;
  }

  .context {
    font-size: 0.75rem;
    line-height: 0.75rem;
    color: @lib__colors__N600Light;
  }

  .icon {
    margin-right: 0.5rem;
  }

  .link {
    color: @lib__colors__N600Light;
  }

  .toggleIcon {
    fill: @lib__colors__N500;
    margin-left: 0.125rem;
  }

  .label {
    display: flex;
    align-items: center;

    font-size: 0.875rem;
    line-height: 0.875rem;
  }
}

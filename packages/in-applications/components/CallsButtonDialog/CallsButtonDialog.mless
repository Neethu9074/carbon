@import '~in-themes/active.less';

:local {
  .wrapper {
    width: 26rem;
  }

  .header {
    position: relative;

    padding: 1.5rem;
    background: @lib__colors__navy800;
    overflow: hidden;
  }

  .title {
    font-size: 1.375rem;
    color: #fff;
    font-weight: 400;
  }

  .text {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 100;
    line-height: 1.1875rem;
    color: #ffffffa3;
  }

  .backgroundIcon {
    position: absolute;
    top: -10px;
    right: 27px;

    fill: #fff;
    opacity: 0.1;
  }

  .traceList {
    padding: 1.5rem;
  }

  .cta {
    display: flex;
    justify-content: center;
  }
}

@import '~in-themes/active.less';

:local {
  .row {
    display: block;

    width: 100%;
    padding: 0.5rem;
  }

  .selectableRow {
    &:hover {
      background: @lib__colors__N100;
    }
  }

  .heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    color: @lib__colors__N900Primary;
  }

  .outerBar,
  .innerBar {
    height: 0.25rem;
    border-radius: 0.1875rem;
  }

  .outerBar {
    position: relative;

    background: #e8eef0;
  }

  .valueAndPercentageWrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin-left: 2rem;
  }

  .link {
    &:hover {
      text-decoration: none;
    }
  }

  .percentage {
    color: #698189;
    font-size: 0.75rem;
  }

  .innerBar {
    position: absolute;
    top: 0;
    left: 0;

    background: #75dedd;
  }
}

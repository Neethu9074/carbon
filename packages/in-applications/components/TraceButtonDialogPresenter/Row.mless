:local {
  .row {
    width: 100%;
  }

  .heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    color: #16363e;
  }

  .outerBar,
  .innerBar {
    height: 0.25rem;
    border-radius: 0.1875rem;
  }

  .outerBar {
    position: relative;

    background: #e8eef0;
    margin-bottom: 0.75rem;
  }

  .valueAndPercentageWrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0 0 0 2rem;
  }

  .percentage {
    color: #698189;
    font-size: 0.75rem;
  }

  .innerBar {
    position: absolute;
    top: 0;
    left: 0;

    background: #75dedd;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;

    padding: 0.25rem 0;
  }

  .icon {
    margin-right: 0.25rem;
    fill: @lib__colors__N600Light;
  }

  .label {
    margin-right: 0.5rem;
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
    font-weight: 500;
  }
}

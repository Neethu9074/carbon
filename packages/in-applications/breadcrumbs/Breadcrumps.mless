:local {

  .breadcrumb {
    display: flex;
    flex-direction: column;
  }

  .entityLabel {
    font-weight: bold;
  }

  .submenu {
    position: absolute;
    list-style: none;
    background-color: #fff;
    padding: 1rem;
    margin-top: .5rem;
    box-shadow: 0px 0px 25px 0px rgba(0, 0, 0, 0.3);
  }

  .submenuItem {
    color: #000;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    padding: 0.25rem 0.5rem;
    border: 1px solid transparent;
    border-radius: @lib__shapes__radius_medium;

    &:hover {
      border: 1px solid @lib__colors__N700Medium;

      .toggleIcon {
        fill: @lib__colors__N700Medium;
      }

      .appName {
        color: @lib__colors__N700Medium;
      }
    }
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .appName {
    color: @lib__colors__N500;
    margin-right: 0.25rem;
  }

  .toggleIcon {
    fill: @lib__colors__N500;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    padding: 0.25rem 0.5rem;
    border: 1px solid transparent;
    border-radius: @lib__shapes__radius_medium;

    &:hover {
      border: 1px solid #ffffff52;

      .toggleIcon {
        fill: #ffffffb8;
      }

      .appName {
        color: #ffffffb8;
      }
    }
  }

  .appName {
    color: #ffffff8f;
  }

  .toggleIcon {
    fill: #ffffff8f;
    margin-left: 0.5rem;
  }
}

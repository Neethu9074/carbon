@import '~in-themes/active.less';

:local {
  .wrapper {
    &:hover {
      .toggleIcon {
        fill: @lib__colors__N050;
      }
    }
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .appName {
    margin-right: 0.25rem;
    font-size: 0.875rem;
    line-height: 0.875rem;
  }

  .toggleIcon {
    fill: @lib__colors__N500;
  }
}

:local {
  .menu {
    position: absolute;
    top: 2.65rem;
    width: 25rem;
    margin: 0;
    padding: 1rem;
    list-style: none;
    background: #FFFFFF;
    border: 1px solid #E8EEF0;
    box-shadow: 0 1px 4px 0 rgba(0,0,0,0.15);
    border-radius: 3px;
    display: block;

    // position above the dashboard content
    z-index: 1;
  }

  .row + .row {
    display: block;
    margin-top: 0.4rem;
  }

  .link {
    color: #47626A;
    text-decoration: none;
    font-weight: 400;
    display: block;
    font-size: .875rem;
  }
}

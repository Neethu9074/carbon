:local {
  .menu {
    width: 25rem;
    margin: 0;
    padding: 1rem;
    list-style: none;
    display: block;
  }

  .row + .row {
    display: block;
    margin-top: 0.4rem;
  }

  .link {
    color: #47626A;
    text-decoration: none;
    font-weight: 400;
    display: block;
    font-size: .875rem;
  }
}

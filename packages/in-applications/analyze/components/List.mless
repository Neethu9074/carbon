@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
  }
  .hitsAndFacetedSearch {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .table {
    width: 100%;
    min-width: 0;
    padding-left: 1rem;
  }
  .tableWithoutPadding {
    padding: 0;
  }
  .list {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    overflow: hidden;
  }
  .labelColumn {
    display: flex;
    flex-direction: row;
    overflow: hidden;
    min-width: 30%;
  }
  .metricColumn {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    padding-left: 0.5rem;
  }
  .metric {
    margin: 0 0.4rem;
    min-width: 9rem;
  }
  .actionColumn {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
  }
  .erroneous {
    display: flex;
    align-items: center;
  }
  .dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background-color: @lib__colors__N700Medium;
  }
  .header {
    display: flex;
    flex-direction: row-reverse;
    padding: 0.3rem 0 0.5rem;
  }
  .unspecified {
    background: @lib__colors__N200;
  }
  .center {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }
  .tag {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .rect {
    width: 0.75rem;
    height: 0.75rem;
  }
  .italic {
    font-style: italic;
  }
  .noData {
    background-color: transparent;
  }
  .message {
    width: 100%;
  }
  .preview {
    display: flex;
    align-items: center;
    color: @lib__colors__N600Light;
  }
}

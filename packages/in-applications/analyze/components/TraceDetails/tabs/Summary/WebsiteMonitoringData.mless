:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f1f4f6;
    color: var(--ids-color-option-neutral-700);
    padding: 0.5rem;
    font-size: 0.875rem;
    margin: 1rem 0;
    flex-wrap: wrap;
  }

  .leftSide {
    display: flex;
    align-items: center;
    margin: 0.5rem 0;
  }

  .icon {
    fill: var(--ids-color-option-navy-800);
    margin: 0 0.188rem 0 0;
  }

  .title {
    display: flex;
    align-items: center;
  }

  .link {
    margin: 0 0.5em 0 0.5em;
  }
}

:local {
  .errorIcon {
    background-color: var(--ids-color-option-red-500);
    color: #fff;
    border-radius: var(--ids-border-radius-small);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0.5rem 0 0;
  }

  .errorIconDefault {
    width: 1.375rem;
    height: 1.375rem;
    font-size: 1rem;
  }

  .inChart {
    width: 100%;
    max-width: 1.375rem;
    height: 1.375rem;
    font-size: 1rem;
  }

  .errorIconSmall {
    width: 1rem;
    height: 1rem;
    font-size: 0.875rem;
  }
}

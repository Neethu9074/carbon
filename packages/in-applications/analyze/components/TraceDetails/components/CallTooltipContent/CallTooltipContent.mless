:local {
  .content {
    padding: 0.5rem;
  }

  .heading {
    margin-bottom: 0.75rem;
  }

  .headingLabel {
    font-weight: bold;
    margin-left: 0.5rem;
  }

  .errorCount {
    font-weight: light;
    color: var(--ids-color-option-red-500);
    margin-bottom: 0.5rem;
  }

  .timingValueList {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timingValue {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .batchSizeIndicator {
    margin-left: 0.5rem;
  }

  .label {
    color: var(--ids-color-option-neutral-800);
    font-weight: 500;
  }

  .duration {
    color: var(--ids-color-option-neutral-900);
  }

  .durationInPercent {
    margin-left: 0.25rem;
    color: var(--ids-color-option-neutral-500);
  }

  .horizontalLine {
    display: block;
    height: 1px;
    border: 0;
    border-top: 1px solid #ccc;
    margin: 1em 0;
    padding: 0;
  }

  .timingValueTotal {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
  }
}

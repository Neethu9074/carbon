@import '~in-themes/mixins.less';

:local {
  .title {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .message {
    margin-left: 1rem;
  }

  .closeIcon {
    cursor: pointer;
    fill: var(--ids-color-option-neutral-400);

    &:hover {
      fill: var(--ids-color-option-neutral-500);
    }
  }

  .entityInformation {
    display: flex;
    align-items: center;
    padding: 0 1rem;
    overflow: hidden;

    svg {
      margin-right: 0.5rem;
    }
  }

  .callLabel {
    font-size: 1rem;
    color: var(--ids-color-option-neutral-900);
    margin-right: 1rem;
    .ellipsis();
  }

  .serviceLabel,
  .infraLabel {
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-900);
  }

  .infraLabel {
    margin-top: 0.6rem;
    display: block;
  }

  .serviceLine,
  .infraLine {
    display: flex;
    align-items: center;
    margin-top: 0.5rem;
    color: var(--ids-color-option-blue-500);
  }

  .infraLink,
  .infraLink:hover {
    color: var(--ids-color-option-blue-500);
    margin: 0.1rem 0;

    svg {
      margin-right: 0.5rem;
      margin-left: 0.1rem;
      fill: var(--ids-color-option-blue-500) !important;
    }
  }

  .rect {
    min-width: 1.375rem;
    min-height: 1.375rem;

    margin-right: 0.5rem;
  }

  .entityIcon {
    margin-right: 0.25rem;
    fill: var(--ids-color-option-blue-500);
  }

  .batchSizeIndicator {
    margin-right: 0.5rem;
  }

  .link {
    .ellipsis();
  }

  .text {
    margin: 0 0.5rem;
    color: var(--ids-color-option-neutral-600);
  }

  .loadingSkeleton {
    width: 15rem;
    height: 1rem;
    display: block;
  }

  .pillWidth {
    min-width: auto;
  }
}

@import '~in-themes/mixins.less';

:local {
  .key,
  .rightAlignedValue,
  .leftAlignedValue {
    .ellipsis();
  }

  .key {
    text-align: left;

    flex-shrink: 0;
    flex-grow: 1;
    max-width: 80%;
  }

  .rightAlignedValue,
  .leftAlignedValue {
    flex-shrink: 1;
    flex-grow: 0;
    min-width: 6ch;
    max-width: 50%;
  }

  .rightAlignedValue {
    text-align: right;
  }

  .leftAlignedValue {
    text-align: left;
  }

  .root {
    position: relative;
    gap: 1rem;
  }

  .root:hover .clipboard {
    display: block;
  }

  .clipboard {
    display: none;
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translate(0, -50%);
  }

  .tagsCard {
    margin-top: 1.5rem;
  }
  .tagsCardNoMargin {
    margin-top: 0;
  }

  .wrapper {
    display: flex;
    gap: 1rem;
    width: 100%;
    justify-content: space-between;
  }

  .tooltipWrapper {
    width: 100%;
  }
}

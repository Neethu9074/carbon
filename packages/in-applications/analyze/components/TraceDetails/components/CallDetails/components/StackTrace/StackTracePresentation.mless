:local {
  .stackTrace {
    display: flex;
    flex-direction: column;
    margin-top: -0.75rem;
  }

  .list {
    border-radius: var(--ids-border-radius-option-small);
    padding: 0.25rem 0.688rem;
    font-size: 0.625rem;
    background: #f8f8f8;
    margin: 0;
    list-style: none;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .noPadding {
    padding: 0;
  }

  .copyButton {
    align-self: flex-end;
  }
}

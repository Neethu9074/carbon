@import '~in-themes/active.less';

:local {
  .skeleton {
    width: 100%;
    height: 1rem;
    margin: 0 0 0.25rem;
    display: block;
  }

  .noLink {
    display: flex;
    align-items: center;
    color: @lib__colors__N600Light;
    fill: @lib__colors__N600Light;

    svg {
      margin: 0 0.5rem 0 0;
    }
  }

  .simplePluginIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }
}

:local {
  .skeleton {
    width: 100%;
    height: 1rem;
    margin: 0 0 0.25rem;
    display: block;
  }

  .noLink {
    display: flex;
    align-items: center;
    color: var(--ids-color-option-neutral-600);
    fill: var(--ids-color-option-neutral-600);

    svg {
      margin: 0 0.5rem 0 0;
    }
  }

  .simplePluginIcon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-600);
  }
}

:local {
  .serviceLine {
    display: flex;
    border: 1px solid var(--ids-color-option-neutral-600);
    border-radius: var(--ids-border-radius-option-medium);
    padding: 0.75rem;
    overflow: hidden;
  }
  .serviceLineInfo {
    display: flex;
    flex-wrap: wrap;
    flex-grow: 1;
    align-items: center;
  }
  .unmonitored {
    border: 1px dashed var(--ids-color-option-neutral-600);
  }
  .hasError {
    border: 1px solid var(--ids-color-option-red-500);
  }

  .locationText {
    text-transform: uppercase;
    margin: 0 0.5rem 0 0;
  }
  .text {
    margin: 0 0.25rem;
    font-size: 1rem;
  }

  .link {
    display: flex;
    align-items: center;
    fill: var(--ids-color-option-blue-500);
    font-size: 1rem;
  }

  .infoIcon {
    fill: var(--ids-color-option-neutral-600);
    justify-self: flex-end;
  }

  .unmonitoredText {
    display: flex;
    align-items: center;
    color: var(--ids-color-option-neutral-600);
    fill: var(--ids-color-option-neutral-600);
    font-size: 1rem;
  }

  .simplePluginIcon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-600);
  }

  .skeletonContainer {
    display: flex;
    flex-grow: 1;
  }
  .skeleton {
    width: 100%;
    height: 1rem;
    margin: 0 0 0.25rem;
    display: block;
  }
}

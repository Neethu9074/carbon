@import '~in-themes/mixins.less';

:local {
  .wrapper {
    background-color: var(--ids-color-option-neutral-50);
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0.75rem 0 0.75rem 0.5rem;
  }

  .headerContent {
    display: flex;
    align-items: flex-start;
    padding-top: 0.375rem;
  }

  .headerLabels {
    display: flex;
    align-items: center;
    margin-left: 0.75rem;
  }

  .headerLabelsExpanded {
    display: flex;
    flex-direction: column;
    margin-left: 0.75rem;
    .breakWord();
  }

  .severityLabelFailure {
    font-size: 0.75rem;
    font-weight: 600;
    margin-right: 0.5rem;
    color: var(--ids-color-option-red-500);
  }
  .severityLabelWarning {
    font-size: 0.75rem;
    font-weight: 600;
    margin-right: 0.5rem;
    color: var(--ids-color-option-yellow-500);
  }

  .severityLabelExpanded {
    font-weight: normal;
  }

  .label {
    font-weight: 600;
    font-size: 0.75rem;
  }

  .labelExpanded {
    font-size: 1rem;
    margin-top: 0.25rem;
  }

  .expandIcon {
    border-radius: var(--ids-border-radius-small);
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-500);
    cursor: pointer;

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .stackTraceWrapper {
    padding: 0.75rem 0 0.75rem 0.5rem;
    word-break: break-all;
  }

  .stackTraceWrapperHeader {
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .logParameters {
    padding: 0.25rem 0.688rem;
  }
}

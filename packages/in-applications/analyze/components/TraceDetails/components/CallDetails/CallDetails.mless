:local {
  .callDetails {
    min-height: 100%;
    overflow: hidden;
    padding: 1.5rem 0.125rem;
  }

  .downloadLink {
    padding-right: 0.125rem;
    padding-top: 4px;
  }
  .iconContainer {
    display: flex;
    align-items: center;
  }
  .icon {
    margin-left: 0.5rem;
  }
}

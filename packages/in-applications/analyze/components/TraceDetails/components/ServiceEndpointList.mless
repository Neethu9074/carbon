@import '~in-themes/mixins.less';

:local {
  .cell {
    display: flex;
    align-items: center;
  }

  .colorIndicator {
    width: 0.75rem;
    height: 0.75rem;
    margin-right: 0.5rem;
    flex-shrink: 0;
  }

  .serviceIcon,
  .endpointIcon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-600);
  }

  .aggregatedTime {
    font-size: 0.875rem;
  }

  .metricValue {
    font-size: 0.875rem;
  }
  .link {
    .ellipsis();
  }
}

:local {
  .content {
    width: 18rem;
  }

  .content,
  .restrictedContent {
    padding: 0.5rem;
  }

  .severityLabelFailure {
    font-size: 0.75rem;
    font-weight: 600;
    margin: 0 0.5rem 0.5rem 0;
    color: var(--ids-color-option-red-500);
  }

  .severityLabelWarning {
    font-size: 0.75rem;
    font-weight: 600;
    margin: 0 0.5rem 0.5rem 0;
    color: var(--ids-color-option-yellow-500);
  }

  .headingLabel {
    font-weight: 600;
    color: var(--ids-color-option-neutral-900);
  }

  .icon {
    fill: var(--ids-color-option-neutral-900);
  }

  .batchCount {
    padding-top: 0.75rem;
    color: var(--ids-color-option-neutral-700) m;
  }

  .pill {
    margin-right: 0.25rem;
  }
}

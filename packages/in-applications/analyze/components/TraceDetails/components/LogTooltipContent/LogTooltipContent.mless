@import '~in-themes/active.less';

:local {
  .content {
    width: 18rem;
  }

  .content,
  .restrictedContent {
    padding: 0.5rem;
  }

  .severityLabelFailure {
    font-size: 0.75rem;
    font-weight: 600;
    margin: 0 0.5rem 0.5rem 0;
    color: @lib__colors__failure;
  }

  .severityLabelWarning {
    font-size: 0.75rem;
    font-weight: 600;
    margin: 0 0.5rem 0.5rem 0;
    color: @lib__colors__warning;
  }

  .headingLabel {
    font-weight: 600;
    color: @lib__colors__N900Primary;
  }

  .icon {
    fill: @lib__colors__N900Primary;
  }

  .batchCount {
    padding-top: 0.75rem;
    color: @lib__colors__N700Medium;
  }

  .pill {
    margin-right: 0.25rem;
  }
}

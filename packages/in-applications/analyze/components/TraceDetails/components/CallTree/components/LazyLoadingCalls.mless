@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  @lineColor: @lib__colors__N400;

  .skeleton {
    width: 100%;
    height: 50%;
    margin: -5px 0 0.25rem;
    display: block;
  }

  .treeWrapper {
    margin-top: -10px;
  }

  .tryAgainButton {
    color: var(--ids-color-option-teal-500);
    padding-left: 1.125rem;
    cursor: pointer;
  }
}

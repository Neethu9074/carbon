:local {
  .treeHeader,
  .axisWrapper {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-right: 5rem;
  }

  .counter {
    font-size: 1.1875rem;
    color: #92a5ae;
  }

  .axis,
  .axis2 {
    width: 60%;
    margin-left: 40%;
  }

  .axis2 {
    margin-bottom: 16px;
  }

  .treeHeader2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .started {
    display: flex;
    align-items: center;
    width: 100%;
    color: var(--ids-color-option-neutral-700);
    p {
      margin: 0;
    }
    svg {
      padding-right: 0.75rem;
    }
  }

  .latency {
    white-space: nowrap;
    color: var(--ids-color-option-neutral-700);
    margin: 0;
  }
}

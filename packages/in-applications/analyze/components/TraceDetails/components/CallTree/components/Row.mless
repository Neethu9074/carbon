@import '~in-themes/mixins.less';

:local {
  @lineColor: var(--ids-color-option-neutral-400);

  .wrapper {
    position: relative;
  }

  .row {
    transition: background 0.4s ease-in-out;
    height: 3.5rem;
    padding: 0 5rem 0 0;
  }

  .rootRow {
    // this is used to get the call visualization in touch with the headers axis
    margin-top: -0.375rem;
  }

  .openedRow,
  .selectedRow {
    background: #ffc80088;
    border-radius: 4px;
  }

  .openedRow.erroneousCall,
  .selectedRow.erroneousCall {
    background: #fdf4f9;
  }

  .detailGroup {
    display: flex;
    align-items: center;

    width: 100%;
  }

  .detailGroupWithLazyNode {
    height: 100%;
  }

  .horizontalWithLazyNode {
    align-self: flex-start;
    margin-top: 11px;
  }

  .left {
    display: flex;
    align-items: center;

    min-width: 40%;
    max-width: 40%;
  }

  .leftLargeTrace {
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .expandIcon {
    border-radius: var(--ids-border-radius-option-small);
    min-width: 0.75rem;
    max-width: max-content;
    justify-content: start;
    min-height: 0.75rem;
    margin-right: 0.5rem;
    fill: var(--ids-color-option-teal-500);
    cursor: pointer;
    z-index: 1;
    block-size: unset;

    &:hover {
      fill: #12978e;
    }
  }

  .label {
    margin-right: 0.5rem;
    font-size: 0.875rem;

    .ellipsis();
  }

  .labelSelected {
    margin-right: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;

    .ellipsis();
  }

  .callLabelWrapper {
    display: grid;
  }

  .clickable {
    cursor: pointer;
    // This is to compensate for the horizontal growth that "collapses" elements
    // We want to force this into a minimum width to not have the text collapse completely
    min-width: 100px;
    position: relative;
    z-index: 1;

    &:hover {
      text-decoration: underline;
    }
  }

  .batchSizeIndicator {
    margin-right: 0.5rem;
  }

  .pillFixer {
    z-index: 2;
    min-width: fit-content;
  }

  .dashedLine {
    border-bottom: 1px dashed @lineColor;
    flex-grow: 1;
  }

  .leftLine {
    border-bottom: 1px solid @lineColor;
    margin-right: 4px;
    position: relative;
  }

  // only temporary until legacy is removed
  .left {
    :global(.legacyIconButton .iconButton--primary) {
      padding: 0;
    }
  }

  .intermediateLine,
  .intermediateLine2,
  .lineEnd,
  .firstLine,
  .nodeTypeParent {
    position: absolute;
    top: -1.6rem;

    margin-left: 8px;
    border-right: 1px solid @lineColor;
    background: @lineColor;
  }

  .intermediateLine {
    bottom: 0;
  }

  .intermediateLine2 {
    top: -2rem;
    bottom: 0;
  }

  .lineEnd {
    height: 2.5rem;
  }

  .nodeTypeParent {
    height: 1.4rem;
    top: -0.7rem;
  }

  .axisWrapper {
    width: calc(100% - 5rem);
    position: absolute;
    top: -30px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    // We remove pointer-events on this element
    // Because of the nature of 'absolute' position this element blocks button clicks to
    // the load parent button
    pointer-events: none;
  }

  .horizontalAxis {
    width: 60%;
    margin-left: 40%;
  }

  .orphan {
    position: absolute;
    right: -3px;
    top: -8px;
  }
}

:local {
  .serviceEndpointInformation {
    display: flex;
    align-items: center;

    margin: 0.25rem 0 0 1.625rem;
  }

  .serviceIcon,
  .arrowIcon,
  .endpointIcon {
    margin-right: 4px;
    fill: var(--ids-color-option-neutral-600);
  }

  .text {
    margin: 0 0.5rem 0.125rem 0.5rem;
    color: var(--ids-color-option-neutral-600);
    white-space: nowrap;
  }

  .link {
    white-space: nowrap;
    margin-bottom: 0.0625rem;
    overflow: hidden;
    text-overflow: ellipsis;

    &:hover {
      color: var(--ids-color-option-neutral-700);
    }
  }
}

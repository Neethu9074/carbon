@import '~in-themes/active.less';

:local {
  .loading {
    margin-top: 0.75rem;
    width: 100%;
    display: flex;
    justify-content: center;
    .circle {
      background-color: @lib__colors__white;
    }
  }
  .suggestion {
    margin-top: 0.75rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    width: 100%;
    &:hover {
      color: @lib__colors__light-blue800;
    }
    .label {
      font-size: 0.75rem;
      text-overflow: ellipsis;
      overflow: hidden;
      white-space: nowrap;
    }
  }
  .noResult {
    margin-top: 0.75rem;
  }
  .showMore {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    padding: 0;
  }
}

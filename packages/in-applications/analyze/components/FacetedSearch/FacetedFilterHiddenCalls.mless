@import '~in-themes/active.less';

:local {
  .typoSettings {
    font-size: 0.75rem;
    line-height: 0.75rem;
  }

  .label {
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    .typoSettings();
  }

  .checkboxWrapper {
    cursor: pointer;
  }

  .leftAlignedCheckbox {
    transform: scale(0.667) translateX(-0.25rem);
    margin-right: 0.2rem;
  }
}

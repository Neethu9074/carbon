@import '~in-themes/active.less';

:local {
  .facetedCard {
    border-radius: 0;
    box-shadow: none;
  }
  .facetedCardHeader {
    padding: 1rem;
  }
  .suggestion {
    margin-top: 0.75rem;
    &:first-child {
      margin-top: 0;
    }
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    width: 100%;
    &:hover {
      color: @lib__colors__light-blue800;
    }
    .addSuggestion {
      font-size: 0.75rem;
      display: flex;
      justify-content: space-between;
      width: 100%;
      .label {
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
      }
      .count {
        margin-left: 1rem;
      }
    }
  }
  .loading {
    margin-top: 0.75rem;
    width: 100%;
    display: flex;
    justify-content: center;
    .circle {
      background-color: @lib__colors__white;
    }
  }
  .noResult {
    margin-top: 0.75rem;
  }
  .showMore {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    padding: 0;
  }
  div.search {
    padding: 0;
  }
}

@import '~in-themes/active.less';

:local {
  .typoSettings {
    font-size: 0.75rem;
    line-height: 0.75rem;
  }

  .facetedCard {
    border-radius: 0;
    box-shadow: none;
    background: none;
    margin-bottom: 1rem;
  }

  .facetedCardHeader {
    margin: 0.25rem 0.5rem;
    padding: 0.5rem;
    cursor: pointer;
  }

  .facetedCardBody {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .suggestion {
    margin-top: 0.75rem;
    &:first-child {
      margin-top: 0;
    }
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    color: @lib__colors__N800Dark;
    &:hover {
      color: @lib__colors__light-blue800;
    }
    .addSuggestion {
      .typoSettings();
      display: flex;
      justify-content: space-between;
      width: 100%;
      .count {
        margin-left: 1rem;
      }
    }
  }

  .suggestionDisabled {
    &:hover {
      color: unset;
    }
  }

  .noResult {
    margin-top: 0.75rem;
  }

  .buttonRow {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .loadMore {
    margin-top: 0.75rem;
    .typoSettings();
    padding: 0;
    color: @lib__colors__light-blue800;
    &:hover {
      background: transparent;
      color: @lib__colors__light-blue800;
    }
  }

  .addAsGroup {
    margin-top: 0.75rem;
    .typoSettings();
    padding: 0;
    color: @lib__colors__light-blue800;
    &:hover {
      background: transparent;
      color: @lib__colors__light-blue800;
    }
  }

  div.search {
    padding: 0;
  }

  .label {
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    .typoSettings();
  }

  .checkboxWrapper {
    cursor: pointer;
  }

  .existingLabel {
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    .typoSettings();
    color: @lib__colors__light-blue800;
  }

  .existingIcon {
    fill: @lib__colors__light-blue800;
  }

  .errorMessage {
    margin: 0 0.75rem;
  }

  .latencyForm {
    margin-bottom: 0;
  }

  .latencyInput {
    height: 1.75rem;
  }

  .search {
    padding: 0 0.25rem;
    height: 1.5rem;
  }

  .skeletonContainer {
    display: block;
    width: 100%;
    height: 0.75rem;
    border-radius: 0.25rem;
  }
}

@import '~in-themes/active.less';

:local {
  .suggestion {
    margin-top: 0.75rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    width: 100%;
    &:hover {
      color: @lib__colors__light-blue800;
    }
    .label {
      font-size: 0.75rem;
      text-overflow: ellipsis;
      overflow: hidden;
      white-space: nowrap;
    }
  }
}

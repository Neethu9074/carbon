@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid @lib__colors__N400;
    padding: 0.3rem 0 0.5rem;
  }

  .resultInformation {
    display: flex;
    align-items: center;
  }

  .configurationWrapper {
    display: flex;
    align-items: center;
  }

  .header {
    padding-left: 0.25rem;
  }

  .list {
    width: 100%;

    & + .list {
      margin-top: 0.125rem;
    }
  }
}

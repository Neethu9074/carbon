:local {
  .popoverContent {
    padding: 0.75rem;
    width: 22rem;
    max-height: 25rem;
    overflow: auto;
    :global(.cds--contained-list__header) {
      inset-block-start: unset;
    }
  }
  .emptyState {
    padding: 2rem;
  }
}

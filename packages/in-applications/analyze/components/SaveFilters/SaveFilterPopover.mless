:local {
  .saveFilterPopoverContainer {
    max-width: 18rem;
    padding: 0.75rem;
  }
  .buttonWrapper {
    display: flex;
    justify-content: space-between;
    margin: auto;
    width: 100%;
    button {
      min-width: 8rem;
    }
  }
  .textInputContainer {
    position: relative;
  }
  .charactercounter {
    position: absolute;
    right: 0;
  }
  .subTitle {
    font-size: 12px;
    color: var(--cds-text-secondary);
  }
}

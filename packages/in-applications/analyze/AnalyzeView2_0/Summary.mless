:local {
  .left {
    width: 100%;
  }

  .icicleChartWrapper {
    padding: 1rem;
  }

  .attemptRendering {
    display: block;
    margin: 1rem 0 0 0;
  }

  .kpiSkeleton {
    width: 100%;
    height: 50%;
    margin-top: 0.25rem;
    display: block;
  }

  .logsCardDescription {
    color: #637282;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1rem;
  }

  .logCard {
    > div:first-child {
      padding: 0 0 0.75rem 0;
    }
    > div:nth-child(2) {
      > ul {
        margin: 1rem 0 0 0 !important;
      }
    }
  }
}

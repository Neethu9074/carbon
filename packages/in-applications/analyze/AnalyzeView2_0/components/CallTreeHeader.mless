:local {
  .callTreeHeader {
    background: var(--ids-color-option-neutral-50);
    border: 1px solid var(--ids-color-option-neutral-300);
    cursor: pointer;

    &.small {
      padding: 0.563rem 1rem;
    }

    &.regular {
      padding: 0.938rem 1rem;
    }
  }

  .callTreeButton {
    font-size: 14px;
    font-weight: var(--ids-font-weight-option-body-bold);
    color: var(--ids-color-option-teal-500);
  }

  .errorState {
    color: var(--ids-color-text-primary-on-light);
    cursor: default;
  }
}

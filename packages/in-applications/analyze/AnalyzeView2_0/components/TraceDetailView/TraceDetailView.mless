@import '~in-themes/active.less';

:local {
  .carbonAnalyzeButton {
    margin-left: 0.5rem;
  }
  .closeIcon {
    cursor: pointer;
    fill: var(--ids-color-option-neutral-500);
    display: block;
    margin: 0 0 0 0.5rem;

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }
  .traceId {
    font-family: var(--ids-font-family-option-monospace);
    padding-right: 0.5rem;
  }

  .betaPill {
    margin-left: 0.5rem;
  }
  .label {
    color: var(--ids-color-option-indigo-500);
    background-color: var(--ids-color-option-blue-100) !important;
  }

  .errorMessage {
    margin: (@grid__gutter * 1px) 0;
  }
  .errorReasons {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    span {
      width: 100%;
    }
    ul {
      margin-bottom: 0;
    }
  }

  .downloadDropdown {
    display: flex;
    flex-direction: column;
  }
  .downloadOption {
    justify-content: flex-start;
    width: 100%;
  }
}

@import '~in-themes/mixins.less';

:local {
  .healthIcon {
    padding-inline-start: 1rem;
  }

  .link {
    display: block;
    .ellipsis();
  }

  .batchedLine {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .latencyDistribution {
    border-top: 1px solid var(--ids-color-option-neutral-400);
    padding: 1rem;
    background: white;
    height: 14rem;
  }
}

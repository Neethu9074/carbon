@import '~in-themes/mixins.less';

:local {
  .link {
    display: block;
    .ellipsis();
  }

  .dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: var(--ids-border-radius-option-round);
    background-color: var(--ids-color-option-neutral-700);
  }

  .erroneous {
    display: flex;
    align-items: center;
  }

  .batchedLine {
    display: flex;
    flex-direction: row;
  }

  .latencyDistribution {
    border-top: 1px solid var(--ids-color-option-neutral-400);
    padding: 1rem;
    background: white;
    height: 14rem;
  }
}

@import '~in-themes/active.less';

:local {
  .closeIcon {
    cursor: pointer;
    fill: @lib__colors__N500;
    display: block;
    margin: 0 0 0 0.5rem;

    &:hover {
      fill: @lib__colors__N700Medium;
    }
  }

  .analyticsLink {
    color: @lib__colors__N600Light;
  }

  .traceId {
    font-family: @font-family-monospace;
    padding-right: 0.5rem;
  }

  .betaPill {
    margin-left: 0.5rem;
  }
  .label {
    color: @lib__colors__indigo800;
    background-color: var(--ids-color-option-blue-100) !important;
  }
}

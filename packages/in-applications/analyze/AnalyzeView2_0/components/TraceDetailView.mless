:local {
  .closeIcon {
    cursor: pointer;
    fill: var(--ids-color-option-neutral-500);
    display: block;
    margin: 0 0 0 0.5rem;

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .analyticsLink {
    color: var(--ids-color-option-neutral-600);
    font-size: 1.375rem;

    &:hover,
    &:visited:hover,
    &:active,
    &:active:visited,
    &:focus {
      color: var(--ids-color-option-neutral-600) !important ;
      outline: none;
    }
    &:visited {
      color: var(--ids-color-option-neutral-600);
      text-decoration: none;
    }
  }

  .traceId {
    font-family: var(--ids-font-family-option-monospace);
    padding-right: 0.5rem;
  }

  .betaPill {
    margin-left: 0.5rem;
  }
  .label {
    color: var(--ids-color-option-indigo-500);
    background-color: var(--ids-color-option-blue-100) !important;
  }
}

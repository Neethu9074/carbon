@import '~in-themes/active.less';

:local {
  .serviceIcon {
    margin-right: 0.125rem;

    fill: @lib__colors__N600Light;
  }

  .serviceName {
    margin-bottom: 0.25rem;

    cursor: pointer;
    text-decoration: underline;
    color: @lib__colors__light-blue800;
  }

  .logMessageWrapper {
    padding: 1rem 1rem 0 1rem;
  }
}

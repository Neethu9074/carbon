@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    margin-top: 2rem;
    padding: 0 25%;
    width: 100%;
    height: 25rem;
    background: var(--ids-color-option-neutral-50);
  }

  .icon {
    fill: var(--ids-color-option-neutral-600);
    margin-bottom: 0.75rem;
  }

  .title {
    margin-bottom: 1rem;
  }

  .text {
    text-align: center;
    color: var(--ids-color-option-neutral-700);
    line-height: 1.25rem;
    margin-bottom: 1rem;
  }

  .loadingIcon {
    fill: var(--ids-color-option-blue-400);
  }
}

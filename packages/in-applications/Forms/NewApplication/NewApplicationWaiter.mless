  :local {

    .wrapper {
      display: flex;
      justify-content: center;
      flex-direction: column;
      align-items: center;
      height:100%
    }

    .heading {
      margin: 0 0 2rem;
    }

    .headingIcon {
      fill: #000;
      background: #fff;
      padding: 0.375rem;
    }

    .spinner {
      fill: #000;
    }

    .loading {
      display: flex;
      align-items: center;
      flex-direction: column;
    }
  }


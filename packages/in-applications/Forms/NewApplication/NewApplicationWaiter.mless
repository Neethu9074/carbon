@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    margin-top: 2rem;
    padding: 0 25%;
    width: 100%;
    height: 25rem;
    background: @lib__colors__N050;
  }

  .icon {
    fill: @lib__colors__N600Light;
    margin-bottom: 0.75rem;
  }

  .title {
    margin-bottom: 1rem;
  }

  .text {
    text-align: center;
    color: @lib__colors__N700Medium;
    line-height: 1.25rem;
    margin-bottom: 1rem;
  }

  .loadingIcon {
    fill: @lib__colors__light-blue800;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    height: 4.75rem;
    padding: 1rem 0.5rem 1rem 1rem;
    border: 1px solid @lib__colors__N300;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: space-around;
  }

  .icon {
    fill: @lib__colors__teal800;
  }
  .content {
    width: 85%;
  }

  .title {
    color: @lib__colors__teal800;
    font-size: 1rem;
  }

  .description {
    font-size: 0.75rem;
    font-weight: 300;
    color: @lib__colors__N600Light;
    margin-top: 0.5rem;
  }
}

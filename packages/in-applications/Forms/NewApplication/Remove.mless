@import '~in-themes/active.less';

:local {
  .maxWidthFullscreenContainer {
    max-width: 38rem;
    padding-bottom: 5rem;
  }

  .header {
    display: flex;
  }

  .heading {
    margin-bottom: 0;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    width: 100%;
  }

  .removeButton {
    display: block;
    margin: 1rem 0 0;
  }
}

@import '~in-themes/active.less';

:local {
  .maxWidthFullscreenContainer {
    max-width: 56.25rem;
    padding-bottom: 5rem;
  }

  .header {
    display: flex;
  }

  .heading {
    margin-bottom: 0;
  }

  .checkbox {
    font-size: 0.75rem;
    &:hover {
      cursor: pointer;
    }
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    width: 100%;
  }

  .removeButton {
    display: block;
    margin: 1rem 0 0;
  }
}

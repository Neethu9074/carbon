@import '~in-themes/active.less';

:local {
  .maxWidthFullscreenContainer {
    max-width: 56.25rem;
    padding-bottom: 5rem;
    margin-top: 1rem;
  }

  .applicationNameText {
    margin-top: 1rem;
  }

  .filter {
    margin: 0.25rem;
  }

  .addRuleButtonWrapper {
    display: flex;
    justify-content: flex-end;

    width: 100%;

    margin-bottom: 0.5rem;
  }

  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
      padding-top: 0.2rem;
      padding-bottom: 0.2rem;
    }

    &.optionBoxUnchecked {
      svg {
        fill: @lib__colors__N600Light;
      }

      * {
        color: @lib__colors__N600Light;
      }
    }
  }
}

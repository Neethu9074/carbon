@import '~in-themes/active.less';

:local {
  .maxWidthFullscreenContainer {
    max-width: 56.25rem;
    padding-bottom: 5rem;
    margin-top: 1rem;
  }

  .applicationNameText {
    margin-top: 1rem;
  }

  .contributionFilter {
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
  }

  .contributionFilterDropdownItem {
    width: 45rem;
    justify-content: flex-start;
    color: var(--ids-color-option-neutral-700);
  }

  .filter {
    margin: 0.25rem;
  }

  .addRuleButtonWrapper {
    display: flex;
    justify-content: flex-end;

    width: 100%;

    margin-bottom: 0.5rem;
  }

  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
      padding-top: 0.2rem;
      padding-bottom: 0.2rem;
    }

    &.optionBoxUnchecked {
      svg {
        fill: var(--ids-color-option-neutral-600);
      }

      * {
        color: var(--ids-color-option-neutral-600);
      }
    }
  }
  .loadingSkeleton {
    width: 100%;
    height: 1rem;
    display: block;
    margin-top: 0.25rem;
  }
}

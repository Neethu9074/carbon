@import '~in-themes/active.less';

:local {
  .maxWidthFullscreenContainer {
    max-width: 38rem;
    padding-bottom: 5rem;
  }

  .applicationNameText {
    margin-top: 1rem;
  }

  .filter {
    margin: 0.25rem;
  }

  .addRuleButtonWrapper {
    display: flex;
    justify-content: flex-end;

    width: 100%;

    margin-bottom: 0.5rem;
  }

  .scopeForm {
    margin-top: 3rem;
  }
}

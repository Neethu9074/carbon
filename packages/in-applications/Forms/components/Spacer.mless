@import '~in-themes/active.less';

:local {
  .spacer {
    margin: 0.75rem 0;
  }

  .dark,
  .light {
    width: 100%;
    height: 1px;
  }

  .dark {
    background: @lib__colors__N400;
  }
  .light {
    background: @lib__colors__N300;
  }

  .double {
    margin: 1.5rem 0;
  }
}

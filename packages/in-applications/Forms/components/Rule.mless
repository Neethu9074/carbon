@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .rule {
    padding: 1rem 0.5rem 1rem 1.5rem;
    margin-bottom: 0.5rem;

    background: #fff;
    color: var(--ids-color-option-neutral-900);
    border: 1px solid var(--ids-color-option-neutral-300);
    border-left: 4px solid var(--ids-color-option-green-500);
    border-radius: @lib__shapes__radius_large;
    font-size: 1rem;
    cursor: default;
  }

  .fixed {
    height: 4.75rem;
  }

  .disabled {
    color: var(--ids-color-option-neutral-600);
    border-left: 4px solid var(--ids-color-option-neutral-300);
  }

  .reorderable {
    cursor: unset;
    &:hover {
      box-shadow: @lib__shadows__subtle;
    }
  }

  .fixedContent {
    width: 100%;
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .reorder {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-basis: 1rem;
    flex-grow: 0;
    .reorderIcon {
      fill: var(--ids-color-option-neutral-400);
    }
    margin-right: 1rem;
  }

  .left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-basis: 80%;
    flex-grow: 1;
    overflow: hidden;
  }

  .right {
    display: flex;
    flex-grow: 0;
    align-items: center;
  }

  .expandableContent {
    width: 60%;
    margin-top: 1rem;
  }

  .icon {
    cursor: pointer;
    fill: var(--ids-color-option-neutral-400);

    &:hover {
      fill: var(--ids-color-option-neutral-500);
    }
  }

  .iconPlaceholder {
    width: 1.5rem;
  }

  .query {
    .breakWord();
    .ellipsis();
  }
}

@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    padding-top: 2.5rem;
  }

  .heading {
    margin-bottom: 0;
    font-size: 1.375rem;
    line-height: 2rem;
    font-weight: 500;
  }

  .helpTextIcon {
    fill: var(--ids-color-option-teal-500);
    margin-left: 0.5rem;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
  }
}

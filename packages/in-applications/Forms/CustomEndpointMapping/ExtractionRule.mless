@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .query {
    margin-right: 1rem;

    font-weight: 300;
    width: 100%;
    .ellipsis();
  }

  .successTestResult,
  .notTestedTestResult,
  .failedTestResult,
  .queryNote {
    margin-top: 0.25rem;

    color: @lib__colors__N600Light;
    font-weight: 300;
    font-size: 0.75rem;
  }

  .successTestResult {
    color: @lib__colors__success;
  }

  .failedTestResult {
    color: @lib__colors__failure;
  }

  .notTestedTestResult {
    color: @lib__colors__N600Light;
  }

  .labelRow {
    display: flex;
  }

  .loadingIcon {
    fill: @lib__colors__light-blue800;
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .query {
    margin-right: 1rem;

    font-weight: 300;
    width: 100%;
    .ellipsis();
  }

  .successTestResult,
  .notTestedTestResult,
  .failedTestResult,
  .queryNote {
    margin-top: 0.25rem;

    color: var(--ids-color-option-neutral-600);
    font-weight: 300;
    font-size: 0.75rem;
  }

  .successTestResult {
    color: var(--ids-color-option-green-500);
  }

  .failedTestResult {
    color: var(--ids-color-option-red-500);
  }

  .notTestedTestResult {
    color: var(--ids-color-option-neutral-600);
  }

  .labelRow {
    display: flex;
  }

  .loadingIcon {
    fill: var(--ids-color-option-blue-400);
  }
}

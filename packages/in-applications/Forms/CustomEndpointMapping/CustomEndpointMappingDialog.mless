@import '~in-themes/active.less';

:local {
  .maxWidthFullscreenContainer {
    max-width: 38rem;
    padding-bottom: 5rem;
  }

  .addRuleButtonWrapper {
    display: flex;
    width: 100%;

    margin: 1rem 0 0.5rem;

    button {
      padding-left: 0;
    }
  }
  .endpointCaseContainer {
    padding-left: 35px;
  }
  .explanation {
    font-size: 12px;
  }
  .wrapperClassName {
    margin: 12px 0px;
  }
  .radioButton {
    position: relative;
    top: 12px;
  }
}

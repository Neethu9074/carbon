@import '~in-themes/active.less';

:local {
  .ruleTesterWrapper {
    padding: 0.5rem 1rem;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
  }

  .title {
    color: @lib__colors__N900Primary;
  }

  .list {
    margin: 0;
    padding: 0;
  }

  .item {
    margin: 0.25rem 0;
    list-style: none;
  }

  .inputRow {
    display: flex;
    align-items: center;
  }

  .input {
    width: 100%;
  }

  .removeTestCaseIcon {
    margin-left: 0.5rem;
    cursor: pointer;
    fill: @lib__colors__N500;
    &:hover {
      fill: @lib__colors__N700Medium;
    }
  }

  .loadingIcon {
    fill: @lib__colors__light-blue800;
  }

  .successTestResult,
  .failedTestResult {
    padding: 0.5rem 0 0.1875rem;
  }

  .successTestResult {
    color: @lib__colors__success;
  }

  .failedTestResult {
    color: @lib__colors__failure;
  }
}

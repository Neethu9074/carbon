@import '~in-themes/active.less';

:local {
  .ruleTesterWrapper {
    padding: 0.5rem 1rem;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
  }

  .title {
    color: var(--ids-color-option-neutral-900);
  }

  .list {
    margin: 0;
    padding: 0;
  }

  .item {
    margin: 0.25rem 0;
    list-style: none;
  }

  .inputRow {
    display: flex;
    align-items: center;
  }

  .input {
    width: 100%;
  }

  .removeTestCaseIcon {
    margin-left: 0.5rem;
    cursor: pointer;
    fill: var(--ids-color-option-neutral-500);
    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .loadingIcon {
    fill: var(--ids-color-option-blue-400);
  }

  .successTestResult,
  .failedTestResult {
    padding: 0.5rem 0 0.1875rem;
  }

  .successTestResult {
    color: var(--ids-color-option-green-500);
  }

  .failedTestResult {
    color: var(--ids-color-option-red-500);
  }
}

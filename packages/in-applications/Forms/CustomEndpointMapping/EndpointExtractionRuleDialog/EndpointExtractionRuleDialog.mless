@import '~in-themes/active.less';

:local {
  .queryFormSection {
    background: var(--ids-color-option-neutral-200);
    padding: 0 1rem 0.25rem;
  }

  .queryHelpText {
    margin-top: 1rem;

    color: var(--ids-color-option-neutral-600);
    font-size: 0.75rem;
  }

  .footer {
    display: flex;
    align-items: flex-end;
    flex-direction: row-reverse;
    justify-content: space-between;

    padding: 1rem 1rem 0;
    border-top: 1px solid var(--ids-color-option-neutral-400);
  }
}

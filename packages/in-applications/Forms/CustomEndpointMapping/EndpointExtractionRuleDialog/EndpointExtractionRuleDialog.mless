@import '~in-themes/active.less';

:local {
  .queryFormSection {
    background: @lib__colors__N200;
    padding: 0 1rem 0.25rem;
  }

  .queryHelpText {
    margin-top: 1rem;

    color: @lib__colors__N600Light;
    font-size: 0.75rem;
  }

  .footer {
    display: flex;
    align-items: flex-end;
    flex-direction: row-reverse;
    justify-content: space-between;

    padding: 1rem 1rem 0;
    border-top: 1px solid @lib__colors__N400;
  }
}

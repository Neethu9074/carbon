@import '~in-themes/active.less';

:local {
  .customHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 0.375rem 0.625rem 0.25rem 1rem;
    box-sizing: border-box;
    background: @lib__colors__N200;
    border-radius: @lib__shapes__radius_small @lib__shapes__radius_small 0 0;
    font-size: 0.75rem;
    font-weight: bold;
    color: #fff;
  }

  .contentWrapper {
    min-width: 25rem;
    overflow: unset;
  }

  .content {
    max-width: 40rem;

    padding: 0 0 1rem 0;

    overflow: unset;
    border-radius: 0 0 @lib__shapes__radius_small @lib__shapes__radius_small;
  }

  .title {
    color: @lib__colors__N800Dark;
    font-weight: 500;
    margin: 0;
    padding: 0;
  }

  .cancelIcon {
    cursor: pointer;
    fill: @lib__colors__N500;
    &:hover {
      fill: @lib__colors__N700Medium;
    }
  }

  .queryFormSection {
    background: @lib__colors__N200;
    padding: 0 1rem 0.25rem;
  }

  .queryHelpText {
    margin-top: 1rem;

    color: @lib__colors__N600Light;
    font-size: 0.75rem;
  }

  .footer {
    display: flex;
    align-items: flex-end;
    flex-direction: row-reverse;
    justify-content: space-between;

    padding: 1rem 1rem 0;
    border-top: 1px solid @lib__colors__N400;
  }
}

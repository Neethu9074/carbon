@import '~in-themes/active.less';

:local {
  .applicationNameText {
    margin-top: 1rem;
  }

  .matchSpecification {
    display: flex;
    align-items: flex-start;
  }

  .matchSpecificationGroupKey {
    flex-grow: 1;
  }

  .matchSpecificationGroupValue {
    flex-grow: 2;
    margin-left: 1rem;
  }

  .removeMatchRuleIcon {
    margin: 1.5rem 0 0 0.25rem;
    fill: @lib__colors__N500;
  }

  .addRuleButtonWrapper {
    width: 100%;
    display: flex;
    justify-content: center;
  }
}

@import '~in-themes/active.less';

:local {
  .queryFormSection {
    background: var(--ids-color-option-neutral-200);
    padding: 0 1rem 0.25rem;
  }

  .description {
    padding: 0.5rem 0;
  }

  .helpText {
    margin-top: 1rem;

    color: var(--ids-color-option-neutral-600);
    font-size: 0.75rem;
  }

  .matchSpecification {
    display: flex;
    align-items: flex-start;
    max-width: 38rem;
  }

  .matchSpecificationGroupKey {
    flex-grow: 1;
  }

  .matchSpecificationGroupValue {
    flex-grow: 2;
    margin-left: 1rem;
  }

  .operatorPill {
    margin-bottom: 0.5rem;
    color: var(--ids-color-option-neutral-500);
  }

  .removeMatchRuleIcon {
    margin: 1.5rem 0 1.5rem 0.25rem;
    fill: var(--ids-color-option-neutral-500);
  }

  .addMatchSpecificationButton {
    display: flex;
    width: 100%;
    margin: 1rem 0 0.5rem;
  }

  .preview {
    margin: 1rem 0;
    padding: 0 1rem 0.25rem;
    .label {
      font-size: 1rem;
      color: var(--ids-color-option-neutral-900);
    }
    .render {
      margin-top: 0.5rem;
    }
  }
  .footer {
    display: flex;
    align-items: flex-end;
    flex-direction: row-reverse;
    justify-content: space-between;

    padding: 1rem 1rem 0;
    border-top: 1px solid var(--ids-color-option-neutral-400);
  }
}

:local {
  .dialog {
    width: 66.25rem;
    height: 35rem;
    padding: 0 1.5rem 1.5rem;
    background-color: var(--ids-color-option-white);
    background-clip: content-box;
  }
  .formFooter {
    display: flex;
    background-color: #fff;
    justify-content: space-between;
  }
}

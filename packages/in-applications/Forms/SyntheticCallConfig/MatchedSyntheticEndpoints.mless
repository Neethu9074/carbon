@import '~in-themes/active.less';

:local {
  .message {
    font-size: 0.75rem;
    color: @lib__colors__N600Light;
  }

  .tr {
    &:nth-child(even) {
      background: #fff;
    }

    &:hover {
      background: #fff;
    }
  }

  .th {
    font-weight: bold;
    border-bottom: 0px;
  }

  .td {
    border-top: 0px;
  }

  .alignRight {
    text-align: right;
    padding-right: 1rem;
  }

  .loadMore {
    &:hover {
      background: #fff;
    }
  }
}

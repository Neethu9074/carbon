@import '~in-themes/active.less';

:local {
  .nameSection {
    background: @lib__colors__N200;
    padding: 0 1rem 0.25rem;
  }

  .addDescriptionButton {
    margin-right: 0.5rem;
    background: @lib__colors__N200;
  }

  .conditionSection {
    padding: 0.5rem 1rem;
  }

  .helpText {
    margin: 1rem 0 0.5rem 0;
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
  }

  .footer {
    display: flex;
    align-items: flex-end;
    flex-direction: row-reverse;
    justify-content: space-between;

    padding: 1rem 1rem 0;
    border-top: 1px solid @lib__colors__N400;
  }
}

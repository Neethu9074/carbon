@import '~in-themes/active.less';

:local {
  .ruleDescription {
    color: var(--ids-color-option-neutral-600);
    font-weight: 300;
    font-size: 0.75rem;
    margin-top: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }

  .addRuleButtonWrapper {
    margin: 1rem 0 1rem 0;
  }

  .ruleWrapper {
    margin-top: 1rem;
  }

  .message {
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-600);
  }
  .color {
    color: var(--cds-text-primary);
  }
}

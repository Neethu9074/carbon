@import '~in-themes/active.less';

:local {
  .analyzeButtonWrapper {
    display: flex;
    justify-content: flex-end;
  }

  .filterList {
    padding: 0 1rem;
    position: relative;
  }

  .disableHover {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: @z-index__timeline;
  }
}

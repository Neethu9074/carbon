@import '~in-themes/active.less';

:local {
  .avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    margin-right: 1rem;
  }

  .narrowColumn {
    width: 3rem;
  }

  .text {
    height: 2.625rem;
  }

  .fullName {
    font-weight: bold;
    padding: 0 0 2px;
  }

  .time {
    font-weight: 300;
  }


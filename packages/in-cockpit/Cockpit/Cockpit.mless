:local {
  .wrapper {
    display: grid;
  }

  .wrapperWithRightContent {
    grid-template-columns: auto 16rem;
  }

  .tuInformation {
    color: var(--ids-color-option-neutral-600);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .left {
    flex-grow: 1;

    padding: 0 1rem;
    min-width: 0;
  }

  .contentNoPaddingRight {
    padding-right: 0rem;
  }

  .icon {
    margin-right: 0.25rem;

    fill: var(--ids-color-option-neutral-600);
  }

  .iconSelected {
    fill: var(--ids-color-option-neutral-900);
  }

  .nav {
    position: fixed;
  }

  .item {
    margin-bottom: 2rem;
  }

  .customEventDeprecatedWarning {
    margin-bottom: 1.5rem;
  }

  .marginTop57 {
    margin-top: 2%;
  }
}

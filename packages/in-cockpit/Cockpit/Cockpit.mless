@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
  }

  .tuInformation {
    color: @lib__colors__N600Light;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .left {
    flex-grow: 1;

    padding: 0 3rem 0 1rem;
  }

  .right {
    width: 16rem;
  }

  .icon {
    margin-right: 0.25rem;

    fill: @lib__colors__N600Light;
  }

  .iconSelected {
    fill: @lib__colors__N900Primary;
  }

  .nav {
    position: fixed;
  }

  .item {
    margin-bottom: 2rem;
  }
}

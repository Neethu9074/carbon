@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
  }

  .lettering {
    height: 1.25rem;
    width: 8rem;

    margin-right: 1rem;

    filter: brightness(0.1);
  }

  .tuInformation {
    color: @lib__colors__N600Light;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .left {
    flex-grow: 1;
  }

  .right {
    width: 16rem;
  }

  .icon {
    margin-right: 0.25rem;

    fill: @lib__colors__N600Light;
  }

  .iconSelected {
    fill: @lib__colors__N900Primary;
  }

  .nav {
    position: fixed;
  }
}

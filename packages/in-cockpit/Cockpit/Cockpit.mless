@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
  }

  .tuInformation {
    color: @lib__colors__N600Light;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .left {
    flex-grow: 1;
  }

  .right {
    width: 16rem;
  }

  .icon {
    margin-right: 0.25rem;
  }

  .nav {
    margin-top: -1rem;
  }
}

:local {
  .header {
    position: relative;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }

  .cardWithStrongShadow {
    box-shadow: var(--ids-shadow-option-strong);
  }

  .dragHandleIcon {
    cursor: grab;
    margin-left: 0.5rem;

    fill: var(--ids-color-option-neutral-300);
    &:hover {
      fill: var(--ids-color-option-neutral-400);
    }
  }

  .link {
    margin: 1.5rem 0 0.75rem;

    font-size: 0.875rem;
    font-weight: 600;
  }

  .linkPlaceHolder {
    height: 1rem;
  }
}

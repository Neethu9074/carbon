@import '~in-themes/active.less';

:local {
  .list {
    width: 100%;

    & + .list {
      margin-top: 0.125rem;
    }
  }

  .listItem {
    justify-content: flex-start;
  }

  .skeleton {
    display: block;

    width: 100%;
    height: 1rem;

    margin: 0.5rem 0;
  }
}

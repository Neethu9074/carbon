:local {
  .buttonHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 1rem;
  }

  .buttonHeaderReverse {
    flex-direction: row-reverse;
  }

  .message {
    border: none;
    background: none;
  }
}

:local {
  .buttonHeader {
    margin-bottom: 1rem;
  }

  .buttonHeaderReverse {
    flex-direction: row-reverse;
  }

  .message {
    border: none;
    background: none;
  }

  .unitSelector {
    min-width: 15rem;
  }

  .ampTimeSelectionWrapper {
    display: inline-flex;
    gap: 1rem;
  }
}

:local {
  .learnMore {
    :global(.cds--accordion__item) {
      border-block-end: none;
    }
    :global(.cds--accordion__heading),
    :global(.cds--accordion__title),
    :global(.cds--accordion__content) {
      margin-left: 0;
      padding-left: 0;
    }
  }

  .accordionBody {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    > div {
      flex: 1;
    }
  }
}

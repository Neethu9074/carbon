@import '~in-themes/active.less';

:local {
  .subViewHeading {
    display: flex;
    align-items: flex-start;

    h1 {
      line-height: 0.5rem;
    }
  }

  .domains {
    color: @lib__colors__N500;
  }

  .message {
    margin-top: 1rem;
  }

  .icon {
    margin: 0 0.25rem 0.25rem 0;
    fill: @lib__colors__N500;
  }

  .row {
    display: flex;
    align-items: center;

    margin-top: 1rem !important;
  }

  .title {
    width: 8.5rem;
  }

  .label {
    width: 100%;

    font-size: 0.875rem;
    font-weight: 600;
  }

  .heading {
    font-size: 0.75rem;
    font-weight: 600;
  }
}

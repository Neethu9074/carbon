:local {
  .container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .dropdown {
    width: 70%;
    margin: 1rem;
  }

  .entriesContainer {
    margin-top: 1rem;
  }

  .entry {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin: 0.25rem 0;
  }

  .iconContainer {
    width: 1rem;
    margin-right: 0.5rem;
  }

  .checkIcon {
    fill: var(--ids-color-option-green-500);
  }

  .activationDropdown {
    min-width: 12rem;
  }
}

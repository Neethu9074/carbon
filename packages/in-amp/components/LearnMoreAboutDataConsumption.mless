:local {
  .learnMore {
    :global(.cds--accordion__item) {
      border-block-end: none;
    }
  }
  .accordionBody {
    display: flex;
    flex-direction: row;
    margin-left: 1rem;
    gap: 2rem;

    > div {
      flex: 1;
    }
  }
}

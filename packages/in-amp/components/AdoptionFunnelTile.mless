:local {
  .kpiRow {
    display: flex;
    flex-direction: row;
  }

  .kpiActive,
  .kpiInactive {
    display: flex;
    flex-direction: row;
    color: var(--ids-color-option-white);
    margin: 0.25rem 0.125rem;
    padding: 0.5rem;
    border-radius: 0.25rem;
  }

  .kpiActive {
    background-color: var(--ids-color-option-green-500);
  }

  .kpiInactive {
    background-color: var(--ids-color-option-neutral-500);
  }

  .kpiTitle {
    font-weight: bold;
    margin-right: 0.5rem;
  }
}

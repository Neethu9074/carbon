@import '~in-themes/active.less';

:local {
  .message {
    margin-bottom: 1rem;
  }

  .icon {
    margin: 0 0.25rem 0.25rem 0;
    fill: @lib__colors__N500;
  }

  .row {
    display: flex;
    align-items: center;

    margin-top: 1rem !important;
  }

  .label {
    width: 4.5rem;

    margin: 0 1rem 0 0;

    font-weight: 600;
  }

  .inputLabel {
    margin: 0;

    font-size: 1rem;
  }

  .input {
    width: 100%;

    margin-right: 2rem;
  }

  .heading {
    font-size: 0.75rem;
    font-weight: 600;
  }
}

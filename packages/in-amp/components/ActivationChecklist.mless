:local {
  .container  {
    display: flex;
    flex-direction: row;
    margin: 1rem;
  }
  .combocontainer  {
    margin-top: 2rem;
  }

  .sideEntriesContainer {
    flex: 1;
  }

  .sideEntry {
    display: flex;
    align-items: center;
    font-size: 0.875rem;
    padding: 1rem;
    cursor: pointer;
  }
  .comboboxEntry {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 1rem 0;
    font-size: 0.875rem;
  }

  .sideEntryActive {
    font-weight: bold;
    border: 1px solid var(--ids-color-option-neutral-400);
    border-right: none;
    border-radius: 0.25rem 0 0 0.25rem;
  }

  .infoIcon {
    margin-left: 0.5rem;
    fill: var(--ids-color-option-neutral-400);
  }

  .checklistContainer  {
    flex: 2;
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: 0 0.25rem 0.25rem 0;
  }

  .checklist  {
    margin: 0.5rem;
  }
  .checklist_margin  {
    margin: 0.5rem;
    margin-top: 2rem;
  }

  .checklistEntry {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 1rem;
    font-size: 0.875rem;
  }

  .timestamp {
    color: var(--ids-color-option-neutral-600);
  }

  .checkIcon {
    fill: var(--ids-color-option-green-500);
  }
  .CheckIconSuccess {
    fill: var(--cds-support-success);
  }
  .iconWrapper {
    margin-right: 0.5rem;
    margin-top: 0.2rem;
  }
  .iconAndText {
    display: flex;
    margin-left: 0;
    align-items: flex-start;
  }
}

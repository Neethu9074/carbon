@import '~in-themes/active.less';

:local {
  .input {
    box-sizing: border-box;
    height: 2rem;
    padding: 0 0.5rem;
    color: var(--ids-color-option-neutral-900);
    background: var(--ids-color-option-neutral-50);
    background-image: none;
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-small);
    transition: border-color ease-in-out 0.15s;

    &[disabled] {
      color: rgba(58, 75, 81, 0.48);
      cursor: not-allowed;
    }
  }

  .error:not(:focus),
  .error:focus:not(.hideValidityInformationOnFocus) {
    border-color: var(--ids-color-option-red-500);
  }

  .withIcon {
    display: flex;
    align-items: center;
  }

  .icon {
    margin: 0 0 0 0.5rem;
    fill: var(--ids-color-option-neutral-800);
  }
}

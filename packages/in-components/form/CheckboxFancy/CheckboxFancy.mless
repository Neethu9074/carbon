@import '~in-themes/active.less';

:local {
  .labelWrapper {
    display: grid;
    grid-template-columns: min-content auto;
    align-items: center;
    line-height: 1.25rem;
    font-size: 0.875rem;
  }

  .control {
    grid-column-start: 1;
    grid-row-start: 1;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 1.5rem;
    height: 1.5rem;
  }

  .label {
    grid-column-start: 2;
    grid-row-start: 1;
  }

  .verticalLabel {
    display: flex;
    align-items: center;
  }

  .explanation {
    grid-column-start: 2;
    grid-row-start: 2;
  }

  .sizeDefault {
    transform: scale(0.5);
  }

  .sizeLarge {
    transform: scale(0.667);
    margin-right: 0.2rem;
  }

  .sizeLarger {
    transform: scale(0.75);
    margin-right: 0.4rem;
  }

  .sizeLargest {
    transform: scale(1);
    margin-right: 0.6rem;
  }

  .checkbox {
    background-image: url('data:image/svg+xml;base64,');
  }

  .checkbox:checked {
    background-image: url('data:image/svg+xml;base64,');
  }

  .checkbox:indeterminate {
    background-image: url('data:image/svg+xml;base64,');
  }

  .checkbox:disabled {
    background-image: url('data:image/svg+xml;base64,');
  }

  .checkbox:checked:disabled {
    background-image: url('data:image/svg+xml;base64,');
  }

  .radiobutton {
    background-image: url('data:image/svg+xml;base64,');
  }

  .radiobutton:checked {
    background-image: url('data:image/svg+xml;base64,');
  }

  .radiobutton:disabled {
    background-image: url('data:image/svg+xml;base64,');
  }

  .radiobutton:checked:disabled {
    background-image: url('data:image/svg+xml;base64,');
  }

  .withControlsGrayscale {
    filter: grayscale(1);
  }

  .hiddenCheckbox {
    display: none;
  }
}

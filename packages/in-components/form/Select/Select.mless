@import '~in-themes/active.less';

:local {
  .selectWrapper {
    position: relative;
    display: inline-flex;
    align-items: center;

    &:after {
      --arrow-height: 6px;
      content: '';
      position: absolute;
      top: calc(50% - var(--arrow-height) / 2);
      right: calc(var(--arrow-height) + 2px);
      border-width: var(--arrow-height) 4px;
      border-style: solid;
      pointer-events: none;
      border-color: var(--ids-color-option-neutral-500) transparent transparent transparent;
    }
  }

  .selectWrapperDisabled {
    color: rgba(58, 75, 81, 0.48);
    cursor: not-allowed;
  }

  .useFullWidth {
    display: flex;
  }

  .select {
    box-sizing: border-box;
    height: 2rem;
    // 1.5rem padding to the right to account for the absolute positioned arrow
    padding: 0 1.5rem 0 0.5rem;
    color: var(--ids-color-option-neutral-900);
    background-color: var(--ids-color-option-neutral-50);
    background-image: none;
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-small);
    transition: border-color ease-in-out 0.15s, box-shadow ease-in-out 0.15s;
    width: 100%;

    &[disabled] {
      pointer-events: none;
    }
    position: relative;
    -webkit-appearance: none;
    appearance: none;

    &:hover {
      cursor: pointer;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .selectWrapper {
    position: relative;
    display: inline-flex;
    align-items: center;

    &:after {
      --arrow-height: 6px;
      content: '';
      position: absolute;
      top: calc(50% - var(--arrow-height) / 2);
      right: calc(var(--arrow-height) + 2px);
      border-width: var(--arrow-height) 4px;
      border-style: solid;
      pointer-events: none;
      border-color: @lib__colors__N500 transparent transparent transparent;
    }
  }

  .selectWrapperDisabled {
    color: rgba(58, 75, 81, 0.48);
    cursor: not-allowed;
  }

  .useFullWidth {
    display: flex;
  }

  .select {
    box-sizing: border-box;
    height: 2rem;
    // 1.5rem padding to the right to account for the absolute positioned arrow
    padding: 0 1.5rem 0 0.5rem;
    color: @lib__colors__N900Primary;
    background-color: @lib__colors__N050;
    background-image: none;
    border: 1px solid @lib__colors__N400;
    border-radius: @lib__shapes__radius_small;
    transition: border-color ease-in-out 0.15s, box-shadow ease-in-out 0.15s;
    width: 100%;

    &[disabled] {
      pointer-events: none;
    }
    position: relative;
    -webkit-appearance: none;
    appearance: none;

    &:hover {
      cursor: pointer;
    }
  }
}

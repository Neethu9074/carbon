:local {
  .controls {
    display: flex;
    justify-content: center;
    align-items: center;

    height: 4rem;

    background-color: var(--ids-color-option-neutral-100);
    border-top: 1px solid var(--ids-color-option-neutral-300);
  }

  .withRoundedBottomBorder {
    border-radius: 0 0 var(--ids-border-radius-option-small) var(--ids-border-radius-option-small);
  }

  .button {
    min-width: 6.25rem;
  }
}

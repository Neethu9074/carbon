@import '~in-themes/active.less';

:local {
  .label {
    color: var(--ids-color-option-neutral-700);
    margin-bottom: 0.5rem;

    &[disabled] {
      color: rgab(63757d, 0.48);
    }
  }

  .hasError {
    color: var(--ids-color-option-red-500);
  }
}

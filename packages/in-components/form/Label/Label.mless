@import '~in-themes/active.less';

:local {
  .label {
    color: @lib__colors__N700Medium;
    margin-bottom: 0.5rem;

    &[disabled] {
      color: rgab(63757d,0.48);
    }
  }

  .hasError {
    color: @lib__colors__failure;
  }
}

:local {
  .icon {
    user-select: none;
  }

  .spinningCounterClockwise {
    animation: svg-icon-spin-counter-clockwise 2s infinite linear;
  }

  .clickable {
    cursor: pointer;
  }

  .icons {
    .icon {
      fill: #000;
    }
  }
}

@keyframes svg-icon-spin-counter-clockwise {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(-359deg);
  }
}

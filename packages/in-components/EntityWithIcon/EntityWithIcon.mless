@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;

    min-width: 0;
  }

  .entityIcon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-600);
  }

  .label {
    color: var(--ids-color-option-neutral-900);
    font-size: 0.875rem;
    display: block;
    align-items: center;
    .ellipsis();
  }

  .rootOrUnknown {
    font-style: italic;
    color: var(--ids-color-option-neutral-600);
  }
}

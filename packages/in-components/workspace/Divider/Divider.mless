@import '~in-themes/active.less';

:local {
  .divider {
    width: 16.875rem;
    height: 0.25rem;
    margin: 0 auto;
    background-color: var(--ids-color-option-neutral-200);
    border-radius: var(--ids-border-radius-small);
    border: 0;
  }
}

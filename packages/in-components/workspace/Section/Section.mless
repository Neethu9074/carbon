:local {
  .section {
    display: flex;
    align-items: flex-start;
    align-items: center;
    width: 100%;
    min-height: 2rem;
  }

  .title {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    width: var(--titleWidth);
  }

  .hasError {
    color: var(--ids-color-option-red-500);
  }

  .titleText {
    margin: 0 0 0 0.5rem;

    &:first-child {
      margin-left: 0;
    }
  }

  .content {
    width: calc(100% - var(--titleWidth));
    flex-grow: 1;
  }

  .actions {
    flex-shrink: 0;
  }
}

@import '~in-themes/mixins.less';

:local {
  .section {
    min-height: 3rem;
    border-top: 1px solid var(--ids-color-option-neutral-400);
    .spaceBetweenFlexbox();
    background: var(--ids-color-option-neutral-100);
  }

  // Increase specificity to allow guaranteed button style overwrite
  .section .button {
    font-weight: 400;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    border-radius: 0;

    & + .button {
      margin-left: 0;
    }
  }

  .left .button {
    border-right: 1px solid var(--ids-color-option-neutral-400);
  }

  .right {
    padding-right: 2rem;
  }
  .right .button {
    border-left: 1px solid var(--ids-color-option-neutral-400);
  }
}

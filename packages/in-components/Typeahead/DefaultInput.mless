:local {
  .inputGroup {
    display: flex;
    align-items: center;
    color: #333;
    background-color: var(--ids-color-option-neutral-50);
    background-image: none;
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-medium);
    font-size: 0.75rem;
    position: relative;
  }

  .inputGroupOpen {
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background: #fff;
    border-color: #b3b3b3 #ccc #d9d9d9;
    position: relative;
  }

  .input {
    flex-grow: 1;
    background: none transparent;
    border: 0 none;
    cursor: default;
    display: inline-block;
    box-shadow: none;
    font-family: inherit;
    font-size: inherit;
    margin: 0;
    outline: none;
    line-height: 1.0625rem;
    padding: 0.5rem 0 0.5rem 0.625rem;
  }

  .toggleButton {
    fill: #999;
  }
}

@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
  }

  .specialIndicator {
    position: absolute;
    left: 0.5625rem;
    top: 1.75rem;
    height: 6px;
    width: 6px;
    background-color: var(--ids-color-option-orange-500);
    border-radius: var(--ids-border-radius-option-round);
    display: inline-block;
  }
}

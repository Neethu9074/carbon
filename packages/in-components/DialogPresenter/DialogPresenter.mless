@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;

    z-index: @z-index__dialog;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;
  }

  .lastWrapper {
    background: rgba(0, 0, 0, 0.5);
  }
}

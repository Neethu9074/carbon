:local {
  .bar {
    border-radius: var(--ids-border-radius-small);
  }

  .barBg {
    .bar();
    background-color: var(--ids-color-option-neutral-200);
    height: 4px;
  }

  .barInner {
    .bar();
    height: 100%;
    transition: 0.5s ease-out;
  }

  .stepTitles {
    display: flex;
    justify-content: space-around;
    color: var(--ids-color-option-neutral-600);
    font-size: var(--ids-font-size-option-body-regular);
    margin-top: 0.5rem;
  }

  .titleSelectedStep {
    font-weight: 600;
  }

  .titleAlignCenter {
    text-align: center;
  }
}

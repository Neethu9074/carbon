:local {
  .iconButton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: pointer;
    background: none;
    border: solid 1px transparent;
    border-radius: var(--ids-border-radius-option-round);
    padding: 0.5rem;
    margin-right: 0.25rem;

    &.disabled {
      pointer-events: none;
    }
  }

  .iconButton:before {
    position: absolute;
    border-radius: var(--ids-border-radius-option-round);
    opacity: 0;
    pointer-events: none;
    top: 0%;
    left: 0%;
    width: 100%;
    height: 100%;
    content: '';
  }

  .iconButton:hover:before {
    opacity: 0.05;
  }

  .iconButton--primary:before {
    background-color: var(--ids-color-option-teal-500);
  }

  .iconButton--primaryv2:before {
    background-color: var(--ids-color-option-blue-400);
  }

  .iconButton--action:before {
    background-color: var(--ids-color-option-neutral-800);
  }

  .iconButton--secondary:before {
    background-color: var(--ids-color-option-neutral-50);
  }

  .iconButton--create:before {
    background-color: var(--ids-color-option-green-500);
  }

  .iconButton--danger:before {
    background-color: var(--ids-color-option-red-500);
  }

  .iconButton--warning:before {
    background-color: var(--ids-color-option-yellow-500);
  }

  .iconButton--info:before {
    background-color: var(--ids-color-option-neutral-500);
  }

  .icon {
    pointer-events: none;
  }

  .icon--primary {
    fill: var(--ids-color-option-teal-500);

    &.disabled {
      fill: rgba(244, 169, 160, 0.48);
    }
  }

  .icon--primaryv2 {
    fill: var(--ids-color-option-blue-400);
    &.disabled {
      fill: #86cff3;
    }
  }

  .icon--action {
    fill: var(--ids-color-option-neutral-800);
    &.disabled {
      fill: var(--ids-color-option-neutral-300);
    }
  }

  .icon--secondary {
    fill: var(--ids-color-option-neutral-50);
    &.disabled {
      fill: #fcfcfd;
    }
  }

  .icon--create {
    fill: var(--ids-color-option-green-500);
    &.disabled {
      fill: #91dab0;
    }
  }

  .icon--danger {
    fill: var(--ids-color-option-red-500);
    &.disabled {
      fill: rgba(220, 75, 65, 0.48);
    }
  }

  .icon--warning {
    fill: var(--ids-color-option-yellow-500);
    &.disabled {
      fill: #ffd86d;
    }
  }

  .icon--info {
    fill: var(--ids-color-option-neutral-500);
    &.disabled {
      fill: var(--ids-color-option-neutral-400);
    }
  }

  .compact {
    padding: 0.25rem;
    margin-right: 0.5rem;

    .rightAligned {
      margin-right: -0.75rem;
    }

    .leftAligned {
      margin-left: -0.75rem;
    }
  }

  .rightAligned {
    margin-right: -0.75rem;
  }

  .leftAligned {
    margin-left: -0.75rem;
  }

  .disabled,
  .disabled:focus,
  .disabled:hover {
    cursor: not-allowed;
  }
}

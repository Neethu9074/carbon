@import '~in-themes/active.less';

:local {
  .list {
    max-height: 20rem;
    overflow-y: auto;
  }

  .group {
    font-size: 0.75rem;
    color: var(--ids-color-option-teal-500);
    padding: 0.4rem 0.8rem;
  }

  .option {
    font-size: 0.75rem;
    max-width: 23rem;
    justify-content: flex-start;
  }

  .optionValueMargin {
    margin-left: 0.5rem;
  }

  .align-left {
    justify-content: flex-start;
  }

  .searchWrapper {
    padding: 0.5rem;
  }

  .search {
    height: 2rem;
    font-size: 0.875rem;
  }

  .searchContainer {
    border-radius: var(--ids-border-radius-option-small);
    background-color: var(--ids-color-option-neutral-100);
  }
}

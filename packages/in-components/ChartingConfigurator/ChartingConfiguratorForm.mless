@import '~in-themes/active.less';

:local {
  .metric,
  .aggregation,
  .renderer {
    line-height: 2;
    padding: 0 0.375rem;

    &:not(:last-child) {
      border-right: 1px solid #dfe4e8;
    }

    &:first-child {
      padding-left: 0;
      margin-left: 0.3rem;
    }
  }

  .aggregation,
  .renderer {
    font-weight: 400;
  }

  .singleMetric {
    cursor: default;
  }

  .singleAggregation {
    cursor: default;
  }

  .selectable {
    &:focus,
    &:active,
    &:hover {
      outline: none;
      color: var(--ids-color-option-blue-400);

      .icon {
        fill: var(--ids-color-option-blue-400);
      }
    }
  }

  .removeIcon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem 0 -0.5rem 0;

    fill: var(--ids-color-option-neutral-400);
    cursor: pointer;

    &:hover,
    &:active,
    &:focus {
      fill: var(--ids-color-option-blue-400);
      outline: none;
    }
  }
}

:local {
  .wrapper {
    margin-left: 0.125rem;
    margin-right: 0.25rem;
    font-weight: 600;
    font-size: 0.75rem;
    max-height: 1.6875rem;

    color: var(--query-builder-element-color);

    width: fit-content;

    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-medium);

    display: flex;
    align-items: center;
    cursor: pointer;
  }
}

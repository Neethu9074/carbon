@import '~in-themes/active.less';

:local {
  .buttonWithBorder {
    border-radius: 0;
    border-right: 1px solid var(--ids-color-option-neutral-400);
    font-size: 12px;
    padding: 0 0.625rem;
  }
  .label {
    font-weight: 600;
    margin-left: 0.1875rem;
    color: var(--typography-font-color-dark);
  }

  .templateDescription {
    color: var(--ids-color-option-neutral-500);
    font-size: 12px;
    font-weight: 400;
    margin-left: 0.375rem;
  }
}

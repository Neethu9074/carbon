:local {
  .groupingConfigurator {
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1.6;

    color: var(--query-builder-element-color);
    max-height: 1.6875rem;

    padding: 0.1875rem 0.3rem 0.1875rem 0.4375rem;
    background: var(--ids-color-option-neutral-50);
    width: fit-content;

    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-medium);

    display: flex;
    align-items: center;

    cursor: pointer;

    margin-left: 0.125rem;
  }

  .groupName {
    margin-right: 0.5rem;

    &:focus,
    &:active,
    &:hover {
      outline: none;
      color: var(--ids-color-option-blue-400);

      .icon {
        fill: var(--ids-color-option-blue-400);
      }
    }
  }

  .srcDest {
    margin-right: 0.5rem;
    padding: 0.0225rem 0.3125rem;
    margin-top: -0.25rem;
    margin-bottom: -0.25rem;
    border-right: 1px solid var(--ids-color-option-neutral-300);
    border-bottom: none;
    border-top: none;
  }

  .icon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem;

    fill: var(--ids-color-option-neutral-400);
  }

  .key {
    border-left: 1px solid var(--ids-color-option-neutral-400);
  }

  .removeIconContainer {
    border-left: none;
    line-height: 2.1;
  }

  .nextToKey {
    border-left: 1px solid var(--ids-color-option-neutral-400);
  }

  .removeIcon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem -0.5rem 0rem;

    fill: var(--ids-color-option-neutral-400);
    cursor: pointer;

    &:hover,
    &:active,
    &:focus {
      fill: var(--ids-color-option-blue-400);
      outline: none;
    }
  }

  .entityIcon {
    // The icon's size triggers a very weird flexbox behavior for its parent element.
    // Work around this behavior by positioning this one absolutely to its wrapper.
    // position: absolute;
    // top: -.45rem;
    // left: 0;

    fill: var(--ids-color-option-neutral-700);
    cursor: pointer;

    &:hover,
    &:active,
    &:focus {
      fill: var(--ids-color-option-blue-400);
      outline: none;
    }
  }

  .container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
}

:local {
  .inputs {
    display: flex;
    align-items: flex-start;
  }

  .controls {
    display: flex;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .to {
    margin: 0.5rem 1rem 0 1rem;

    font-size: 0.75rem;
    font-weight: 500;
  }

  .button {
    width: 9rem;
    height: 2rem;
    margin-left: auto;
  }

  .notes {
    height: 1rem;

    margin-top: 0.5rem;
  }

  .error {
    margin: 0;
  }

  .icon {
    fill: var(--ids-color-option-neutral-600);
    margin-right: 0.5rem;
  }

  .help {
    color: var(--ids-color-option-neutral-600);
  }

  .mark {
    display: flex;
    flex-direction: column;
    align-items: center;

    color: var(--ids-color-option-neutral-600);
  }

  // This is required to offset the lack of margin that appears when hiding the label of the slider
  .formContainer {
    margin-top: 1rem;
  }

  // The following CSS applies the same styling as the class .cds--visually-hidden from Carbon
  // Source code: https://github.com/carbon-design-system/carbon/blob/main/packages/styles/scss/utilities/_visually-hidden.scss
  .labelHidden {
    & label {
      position: absolute;
      overflow: hidden;
      padding: 0;
      border: 0;
      margin: -1px;
      block-size: 1px;
      clip: rect(0, 0, 0, 0);
      inline-size: 1px;
      visibility: inherit;
      white-space: nowrap;
    }
  }
}

:local {
  .inputs {
    display: flex;
    align-items: flex-start;
  }

  .controls {
    display: flex;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .to {
    margin: 0.5rem 1rem 0 1rem;

    font-size: 0.75rem;
    font-weight: 500;
  }

  .button {
    width: 9rem;
    height: 2rem;
    margin-left: auto;
  }

  .notes {
    height: 1rem;

    margin-top: 0.5rem;
  }

  .error {
    margin: 0;
  }

  .icon {
    fill: var(--ids-color-option-neutral-600);
    margin-right: 0.5rem;
  }

  .help {
    color: var(--ids-color-option-neutral-600);
  }

  .mark {
    display: flex;
    flex-direction: column;
    align-items: center;

    color: var(--ids-color-option-neutral-600);
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    background: var(--ids-color-option-neutral-50);
    padding: 1.5rem 2rem;

    & + .wrapper {
      border-top: 1px solid var(--ids-color-option-neutral-300);
    }
  }

  .lightWrapper {
    background: var(--ids-color-option-white);
  }

  .header {
    font-size: 1rem;
    font-weight: normal;

    color: var(--ids-color-option-neutral-700);
  }
}

:local {
  .wrapper {
    display: flex;
    flex-direction: column;
  }

  .inputs {
    display: flex;
    gap: 0.5rem;
    :global(.carbonDateInput .cds--date-picker.cds--date-picker--single .cds--date-picker__input) {
      inline-size: 10rem;
    }
  }

  .field {
    width: 7rem;
  }
}

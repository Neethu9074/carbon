@import '~in-themes/active.less';

:local {
  .presetsContainer {
    display: grid;
    grid-gap: 0.5rem;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr;
  }

  .preset {
    display: flex;
    align-items: center;

    padding: 0.5rem;
    height: 3.5rem;

    border: 1px solid var(--ids-color-option-neutral-300);
    background: var(--ids-color-option-white);

    color: var(--ids-color-option-neutral-900);
    &:hover {
      color: inherit;
      text-decoration: none;
    }
    &:visited {
      color: inherit !important;
    }

    font-weight: 500;

    &:hover {
      cursor: pointer;
      box-shadow: @lib__shadows__subtle;
      border-radius: @lib__shapes__radius_medium;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .iconWrapper {
    position: relative;
  }

  .dark {
    .timeIcon {
      fill: #fff;
    }

    .indicator {
      background: var(--ids-color-option-navy-900);
      border: 1px solid var(--ids-color-option-navy-900);
    }
  }

  .light {
    .timeIcon {
      fill: var(--ids-color-option-neutral-800);
    }

    .indicator {
      background: #fff;
      border: 1px solid #fff;
    }
  }

  .timeIcon {
    display: block;
  }

  .timeIconExpanded {
    fill: #fff;
  }

  .indicator {
    position: absolute;
    top: -0.25rem;
    left: -0.5rem;

    border-radius: var(--ids-border-radius-option-round);

    fill: var(--ids-color-option-teal-500);
  }
}

:local {
  .carbonTimePicker {
    margin-right: -1px;
    height: 3rem;
    z-index: 1;

    svg {
      margin-block-start: 0.5rem;
    }
  }
  .carbonDisplayTimeWrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .carbonTimeSetting {
    font-size: 0.875rem;
  }
  .carbonTimeSettingTop {
    font-size: 0.75rem;
  }
}

@import '~in-themes/active.less';

:local {
  .viewAll {
    display: flex;
    justify-content: center;
    margin: 1rem 0 0;
  }

  .viewAllLink {
    font-size: 0.875rem;
    font-weight: 400;
    text-decoration: none;

    transition: color 0.25s ease-in-out;

    &:hover {
      text-decoration: none;
    }
  }
}

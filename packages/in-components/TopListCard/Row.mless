:local {
  .topListRow {
    margin-bottom: 1rem;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .titles {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bar {
    position: relative;
    width: 100%;
    height: 0.1875rem;
    margin: 0.25rem 0 1.5rem 0;
    background: var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-small);
  }

  .barInner {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    border-radius: var(--ids-border-radius-small) 0 0 var(--ids-border-radius-small);
  }

  .hairLine {
    position: absolute;
    width: 1px;
    height: 12px;
    left: -1px;
  }

  .contributedContentLeftAligned,
  .contributedContentRightAligned {
    position: absolute;
    top: 0.25rem;
  }

  .contributedContentLeftAligned {
    left: 0.25rem;
  }

  .contributedContentRightAligned {
    right: 0.25rem;
  }

  .label {
    margin-right: 1rem;

    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;

    font-size: 0.875rem;
    color: var(--ids-color-option-neutral-700);
  }

  .metricWrapper {
    white-space: nowrap;
  }

  .metric {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ids-color-option-neutral-900);
  }

  .companion {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ids-color-option-neutral-600);
    padding-left: 0.5rem;
    text-align: right;
  }
}

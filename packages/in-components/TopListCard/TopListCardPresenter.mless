@import '~in-themes/mixins.less';

:local {
  .loadingBarContainer {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: left;
    justify-content: flex-start;
  }

  .horizontalIndicator {
    margin-bottom: -3px;
  }

  .skeletonWrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-around;
  }

  .itemSkeleton {
    display: block;
    width: 100%;
    height: 1rem;
    margin-bottom: 1.9375rem;
  }
  .infoIconWithoutPadding {
    padding: 0;
  }
  .disabledWidget {
    background-color: var(--ids-color-option-neutral-50);
  }

  .scrollbar {
    .visibleScrollbar();
  }

  .modal {
    .widgetInModal();
  }
}

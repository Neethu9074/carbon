@import '~in-themes/active.less';

:local {
  .pill {
    display: inline-block;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    vertical-align: baseline;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.125rem 0.25rem;
    border-radius: @lib__shapes__radius_medium;
    color: var(--ids-color-option-deep-purple-500);
  }

  .bold {
    color: @lib__colors__white;
  }

  .inverted {
    background: @lib__colors__white;
  }

  .primary {
    background: var(--ids-color-option-blue-400);
    color: @lib__colors__white;
  }

  .info {
    background: @lib__colors__chart__self100;
    color: @lib__colors__white;
  }
}

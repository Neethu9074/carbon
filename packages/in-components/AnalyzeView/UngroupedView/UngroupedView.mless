:local {
  .resultContainer {
    flex: 1;
    overflow: hidden;
    &.withOverflow {
      overflow: visible;
    }
    padding-bottom: 1.5rem;
  }

  .helpIcon {
    fill: var(--ids-color-option-neutral-600);
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .infiniteScrollContainer {
    opacity: 0;
    height: 1px;
  }

  .displayBlock {
    display: block;
  }

  .logsLoadedToast {
    display: flex;
    align-items: center;
    height: 100%;
  }
}

@import '~in-themes/active.less';

:local {
  .chartWrapper {
    width: 100%;
    height: 14rem;
    padding: 0.75rem 1rem;
    border-right: 1px solid @lib__colors__N400;
    border-top: 1px solid @lib__colors__N400;

    &:last-child {
      border-right: none;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .chartWrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 14rem;
    padding: 0.5rem 1rem;
    border-right: 1px solid var(--ids-color-option-neutral-400);
    border-top: 1px solid var(--ids-color-option-neutral-400);

    &:last-child {
      border-right: none;
    }
  }

  .header {
    &:empty {
      height: 1rem;
    }
  }

  .titleWrapper {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }

  .title {
    font-weight: 600;
  }
}

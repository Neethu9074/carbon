@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .typoSettings {
    font-size: 0.75rem;
    line-height: 0.75rem;
  }

  .buttonRow {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 0.5rem;

    > button {
      padding: 0;
    }
  }

  .loadMore {
    .typoSettings();
    color: @lib__colors__teal800;

    &:hover {
      background: transparent;
      color: @lib__colors__teal800;
    }
  }

  .clearFacet {
    .typoSettings();
    color: @lib__colors__teal800;

    &:hover {
      background: transparent;
      color: @lib__colors__teal800;
      text-decoration: none;
    }
  }

  .search {
    padding: 0 0.25rem;
    height: 1.5rem;
    font-size: 0.875rem;
  }

  .searchContainer {
    border-radius: 0.125rem;
    background-color: @lib__colors__N100;
  }
}

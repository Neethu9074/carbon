@import '~in-themes/mixins.less';

:local {
  .typoSettings {
    font-size: 0.75rem;
    line-height: 0.75rem;
  }

  .buttonRow {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 0.5rem;

    > button {
      padding: 0;
    }
  }

  .loadMore {
    .typoSettings();
    color: var(--ids-color-option-teal-500);

    &:hover {
      background: transparent;
      color: var(--ids-color-option-teal-500);
    }

    &:global(.cds--btn) {
      min-block-size: unset;
    }
  }

  .clearFacet {
    .typoSettings();
    padding: 0;

    &:hover {
      background: transparent;
    }

    &:global(.cds--btn) {
      min-block-size: unset;
    }
  }

  .search {
    padding: 0 0.25rem;
    height: 1.5rem;
    font-size: 0.875rem;
    background-color: var(--ids-color-option-neutral-100);
  }

  .searchContainer {
    border-radius: var(--ids-border-radius-option-small);
    background-color: var(--ids-color-option-neutral-100);
  }
}

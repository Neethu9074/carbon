@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .suggestion {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    width: 100%;
    &:hover {
      color: @lib__colors__light-blue800;
    }
  }

  .label {
    .ellipsis();
    color: @lib__colors__N900Primary;
  }
}

@import '~in-themes/active.less';

:local {
  .typoSettings {
    font-size: 0.75rem;
    line-height: 0.75rem;
  }

  .rangeForm {
    margin-bottom: 0;
  }

  .errorMessage {
    margin-left: 0.75rem;
    margin-right: 0.75rem;
  }

  .rangeInput {
    height: 1.75rem;
  }

  .buttonRow {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 0.5rem;

    > button {
      padding: 0;
    }
  }

  .clearFacet {
    .typoSettings();
    color: @lib__colors__teal800;

    &:hover {
      background: transparent;
      color: var(--ids-color-option-teal-500);
      text-decoration: none;
    }
  }
}

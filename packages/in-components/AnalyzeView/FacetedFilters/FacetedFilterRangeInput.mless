:local {
  .typoSettings {
    font-size: 0.75rem;
    line-height: 0.75rem;
  }

  .rangeForm {
    margin-bottom: 0;
  }

  .errorMessage {
    margin-left: 0.75rem;
    margin-right: 0.75rem;
  }

  .rangeInput {
    :global(.cds--number__controls) {
      inline-size: 3rem;
    }
    :global(.cds--number input) {
      padding-inline-start: 0.5rem;
    }
    :global(.cds--number--sm.cds--number input[type='number'][data-invalid]) {
      padding-inline-end: 0;
    }
    :global(svg.cds--number__invalid) {
      display: none;
    }
  }

  .buttonRow {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 0.5rem;

    > button {
      padding: 0;
    }
  }

  .clearFacet {
    .typoSettings();
    padding: 0;

    &:hover {
      background: transparent;
    }

    &:global(.cds--btn) {
      min-block-size: unset;
    }
  }
}

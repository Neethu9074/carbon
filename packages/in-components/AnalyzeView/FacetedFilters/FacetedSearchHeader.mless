@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .typoSettings {
    font-size: 0.75rem;
    line-height: 0.75rem;
  }

  .header {
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid lightgray;

    position: sticky;
    top: 0;
    background: #fff;
    z-index: 2;
  }

  .facetCount {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5rem;
  }

  .clearAll {
    .typoSettings();
    padding: 0;
    color: @lib__colors__teal800;

    &:hover {
      background: transparent;
      color: @lib__colors__teal800;
      text-decoration: none;
    }
  }
}

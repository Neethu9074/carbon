@import '~in-themes/mixins.less';

:local {
  .leftAlignedCheckbox {
    transform: scale(0.667) translateX(-0.25rem);
    margin-right: 0.2rem;
  }

  .label {
    height: 1rem;
    line-height: 1rem;
    font-size: 0.75rem;

    .ellipsis();
  }

  .count {
    display: flex;
    margin-left: 1rem;
    color: var(--ids-color-option-neutral-600);
  }
}

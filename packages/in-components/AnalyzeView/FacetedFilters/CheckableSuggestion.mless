@import '~in-themes/mixins.less';

:local {
  .checkableSuggestion {
    display: flex;
    align-items: center;
    justify-content: space-between;

    // since we use a smaller font size for the label, we need to center it vertically
    :global .cds--checkbox-label-text {
      display: flex;
      align-items: center;
    }
  }

  .label {
    display: block;
    font-size: 0.75rem;
    inline-size: 6rem;
    .ellipsis();
  }

  .count {
    display: flex;
    margin-left: 1rem;
    color: var(--ids-color-option-neutral-600);
  }
}

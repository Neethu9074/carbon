@import '~in-themes/mixins.less';

:local {
  .suggestion {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .label {
    .ellipsis();
    color: var(--ids-color-option-teal-500);
  }

  .icon {
    fill: var(--ids-color-option-teal-500);
  }
}

@import '~in-themes/mixins.less';

:local {
  .typoSettings {
    font-size: 0.75rem;
    line-height: 0.75rem;
  }

  .suggestion {
    cursor: pointer;
    display: block;
    justify-content: space-between;
    width: 100%;
  }

  .addSuggestion {
    .typoSettings();
    display: flex;
    justify-content: space-between;
    width: 100%;
    &:hover > .count {
      color: var(--ids-color-option-teal-500);
    }
    &:hover > .label {
      color: var(--ids-color-option-teal-500);
    }
  }

  .count {
    display: flex;
    margin-left: 1rem;
    color: var(--ids-color-option-neutral-600);
  }

  .label {
    .ellipsis();
    color: var(--ids-color-option-neutral-800);
  }

  .buttonRow {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .loadMore {
    .typoSettings();
    padding: 0;
    color: var(--ids-color-option-teal-500);
    &:hover {
      background: transparent;
      color: var(--ids-color-option-teal-500);
    }
    &:global(.cds--btn) {
      min-block-size: unset;
    }
  }

  .addAsGroup {
    .typoSettings();
    padding: 0;
    color: var(--ids-color-option-teal-500);
    &:hover {
      background: transparent;
      color: var(--ids-color-option-teal-500);
    }
  }

  .skeletonContainer {
    display: block;
    width: 100%;
    height: 0.75rem;
    border-radius: 0.25rem;
  }
}

@import '~in-themes/active.less';

:local {
  .headerButton {
    position: relative;
    background: transparent;
    right: -1rem;
    padding: 0;
    border: none;

    svg {
      fill: @lib__colors__N900Primary;
    }

    &:hover {
      background: transparent;
      color: @lib__colors__N900Primary;
      border: none;

      svg {
        fill: @lib__colors__N900Primary;
      }
    }
  }
}

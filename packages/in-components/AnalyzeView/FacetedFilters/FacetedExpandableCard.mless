@import '~in-themes/active.less';

:local {
  .facetedCard {
    border-radius: 0;
    box-shadow: none;
    background: none;
    margin-bottom: 1rem;
  }

  .facetedCardHeader {
    margin: 0.25rem 0.5rem;
    padding: 0.5rem;
    cursor: pointer;
  }

  .facetedCardBody {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
}

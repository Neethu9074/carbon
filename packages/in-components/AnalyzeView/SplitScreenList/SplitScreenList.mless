:local {
  .wrapper {
    display: flex;
    height: 100%;
  }

  .details {
    width: ~'calc(100% - 20rem)';

    &.useFullWidth {
      width: ~'calc(100% - 3rem)';
    }
  }

  .expanded {
    width: 20rem;
    flex-grow: 0;
    flex-shrink: 0;
  }

  .header {
    background: var(--ids-color-option-neutral-50);
    padding: 1.375rem 1.25rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
    border-right: 1px solid #d5dfe4;
  }

  .actions {
    margin-left: 1rem;
  }

  .actions {
    display: flex;
    align-items: center;
  }

  .collapsed {
    width: 3rem;
    border-right: 1px solid #d5dfe4;
  }

  .collapsedToggleWrapper {
    background: var(--ids-color-option-neutral-50);
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.63rem 0;

    z-index: 125;
    position: fixed;
    width: 2.95rem;
  }
}

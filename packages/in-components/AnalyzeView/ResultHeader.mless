@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
  }

  .withMargin {
    margin: 1.5rem 0 0.5rem 0;
  }

  .result {
    margin-right: 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ids-color-option-neutral-900);
  }

  .number {
    color: var(--ids-color-option-neutral-700);
    font-size: 1rem;
    margin-right: 0.5rem;
  }

  .withMaxWidth {
    .ellipsis();
    display: inline-block;
    max-width: 7rem;
  }

  .adjustmentIcon {
    fill: var(--ids-color-option-neutral-500);
  }
  .text {
    line-height: 16px;
    margin: 4px 0px 0px 2px;
  }
  .labelWrapper {
    display: flex;
    align-items: center;
  }
}

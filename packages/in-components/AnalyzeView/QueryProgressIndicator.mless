@import '~in-themes/active.less';

:local {
  .stateWrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .progressText {
    font-size: 1.125rem;
    padding-bottom: 0.5rem;
  }

  .infoBlock {
    display: flex;
    align-items: center;
  }

  .icon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-600);
  }

  .description {
    margin: 1rem;
  }

  .bigIconContainer {
    position: relative;
    height: 6.25rem;
    width: 6.25rem;
    margin: 1rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spinningIcon {
    fill: var(--ids-color-option-blue-400);
  }

  .traceIcon {
    fill: var(--ids-color-option-neutral-500);
    position: absolute;
    top: calc(50% - 1.5rem);
    left: calc(50% - 1.5rem);
  }

  .loadingSpinnerContainer {
    position: relative;
    height: 6.25rem;
    width: 6.25rem;
  }

  .loadingBarContainer {
    width: 15rem;
    height: 0.625rem;
    margin: 1rem 0 0.5rem;
  }

  .horizontalIndicator {
    height: 0.5rem;
    border-radius: var(--ids-border-radius-large);
  }

  .warnIcon {
    fill: var(--ids-color-option-yellow-500);
  }

  .errorIcon {
    fill: var(--ids-color-option-red-500);
  }

  .noData {
    background: transparent;
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .collapsibleOpen {
    background: linear-gradient(-180deg, #f0f3f4 0%, #e8ebed 100%);
    padding-bottom: 0.75rem;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid @lib__colors__N300;

    word-break: break-all;
    font-size: 0.75rem;
    cursor: pointer;

    transition: color 0.25s ease-in-out;

    &:hover {
      color: lighten(#6b8088, 20%);

      .toggle {
        fill: lighten(#6b8088, 20%);
      }
    }
  }

  .toggle {
    position: relative;

    transition: fill 0.25s ease-in-out;
  }
}

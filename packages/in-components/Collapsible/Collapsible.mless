@import '~in-themes/mixins.less';

:local {
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    .breakWord();
    font-size: 0.75rem;
    color: #6b8088;
    cursor: pointer;

    transition: color 0.25s ease-in-out;

    &:hover {
      color: lighten(#6b8088, 20%);

      .toggle {
        fill: lighten(#6b8088, 20%);
      }
    }
  }

  .content {
    margin: 0.438rem 0 0 0.625rem;
  }

  .toggle {
    position: relative;

    transition: fill 0.25s ease-in-out;
  }
}

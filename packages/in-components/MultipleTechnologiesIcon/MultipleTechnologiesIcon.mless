:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 0.5rem;
    min-width: 2.25rem;
  }

  .remainderLabel {
    color: var(--ids-color-option-neutral-600);
    font-weight: 600;
    letter-spacing: -1px;
  }

  .entityIconSmall {
    fill: var(--ids-color-option-neutral-600);
    margin-right: 0.125rem;
  }

  .entityIcon {
    fill: var(--ids-color-option-neutral-600);
  }
}

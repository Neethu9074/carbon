:local {
  .wrapper {
    width: 20rem;
    max-width: 30rem;
  }

  .ready {
    padding: 1rem;
  }

  .copyRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .input {
    width: 100%;
  }

  .copy {
    margin-left: 0.5rem;
    flex-shrink: 0;
  }

  .explanation {
    padding: 0.3rem 0.5rem;
    background: var(--ids-color-option-neutral-100);
  }

  .bottomTimeRow {
    display: block;
    font-weight: 600;
  }
}

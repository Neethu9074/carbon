@import '~in-themes/mixins.less';

:local {
  .dashboardHeader {
    padding: 0 1.5rem;
    .print(none);
  }

  .borderBottom {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
  }

  .default {
    background: var(--ids-color-option-neutral-50);
  }
  .light {
    background: var(--ids-color-option-white);
  }
  .dark {
    background: var(--ids-color-option-neutral-800);
    .label {
      color: var(--ids-color-option-white);
    }
    .icon {
      fill: var(--ids-color-option-white);
    }
    .contextIcon,
    .contextEndIcon {
      fill: var(--ids-color-option-neutral-400);
    }
    .context {
      color: var(--ids-color-option-neutral-400);
    }
  }

  .firstLine,
  .leftContent,
  .rightContent,
  .buttonLine {
    .flexbox();
  }

  .leftContent {
    // Let the left content area shrink so that both the left+right content fit the viewport
    overflow: hidden;
  }

  .rightContent {
    flex-shrink: 0;
    justify-content: flex-end;
  }

  .firstLine {
    justify-content: space-between;
    padding: 1rem 0;
    max-width: 100%;
  }

  .contextIcon,
  .contextEndIcon,
  .icon {
    margin-right: 0.5rem;
  }

  .contextIcon,
  .contextEndIcon {
    fill: var(--ids-color-option-neutral-600);
  }

  .contextEndIcon {
    margin-left: 0.5rem;
  }

  .icon {
    fill: var(--ids-color-option-neutral-900);
  }

  .contextWrapper {
    .flexbox();

    & + .contextWrapper {
      margin-left: 0.5rem;
    }
  }

  .context,
  .label {
    font-size: 1.375rem;
    line-height: 2rem;
    font-weight: 500;
    .ellipsis();
    margin-bottom: 0; //cancel h1 margin
  }

  .context {
    color: var(--ids-color-option-neutral-600);
  }

  .label {
    color: var(--ids-color-option-neutral-900);
    margin-right: 0.75rem;
  }

  .buttonLine {
    display: inline-flex;
    min-height: 3.125rem;
    padding-bottom: 1rem;
    width: 100%;

    & > div {
      display: inherit;
    }
  }

  .withSecondary {
    display: flex;
    justify-content: space-between;
  }

  .secondaryActions {
    justify-self: flex-end;
    gap: 0.25rem;
  }
  .specialIndicator {
    height: 8px;
    width: 8px;
    background-color: var(--ids-color-option-orange-500);
    border-radius: var(--ids-border-radius-option-round);
  }

  .headerLink {
    font-size: 1.375rem;
    line-height: 2rem;
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }
}

// loading state definitions
.labelSkeleton {
  width: 12.5rem;
  height: 1.813rem;
  display: block;
}

.buttonSkeleton {
  width: 7.5rem;
  height: 2rem;
  display: block;
}

.iconSkeleton {
  width: 2rem;
  height: 2rem;
  display: block;
}

:local {
  .default {
    background: var(--ids-color-option-neutral-50);
  }
  .light {
    background: var(--ids-color-option-white);
  }
  .dark {
    background: var(--ids-color-option-neutral-800);
  }

  .defaultWithTopBorder,
  .lightWithTopBorder {
    border-top: 1px solid var(--ids-color-option-neutral-300);
  }

  .defaultWithBottomBorder,
  .lightWithBottomBorder {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
  }

  .darkWithTopBorder {
    border-top: 1px solid var(--ids-color-option-neutral-600);
  }

  .darkWithBottomBorder {
    border-bottom: 1px solid var(--ids-color-option-neutral-600);
  }
}

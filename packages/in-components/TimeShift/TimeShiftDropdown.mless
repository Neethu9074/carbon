:local {
  .overlay {
    min-width: 30rem;
    max-width: 30rem;
  }

  .label {
    color: var(--ids-color-option-neutral-600);
    font-size: 1rem;
  }

  .description {
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--ids-color-option-neutral-600);
    margin-top: 0.5rem;
  }
}

:local {
  .content {
    padding: 1.5rem 0 0 0;
    margin: 0; // reset everything
  }

  .bottomMargin {
    margin-bottom: 1.5rem;
  }

  .noTopPadding {
    padding: 0;
  }

  .stickToHeader {
    padding-top: 0;
  }

  .stickToBottom {
    padding-bottom: 0;
  }
}

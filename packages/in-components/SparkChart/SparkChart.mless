@import '~in-themes/active.less';

:local {
  .withHorizontalMetricValueWrapper {
    display: flex;
    align-items: flex-end;
  }

  .withVerticalMetricValueWrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .horizontalMetricValue {
    margin-left: 0.25rem;
    white-space: nowrap;
  }

  .verticalMetricValue {
    margin-bottom: 0.25rem;
    white-space: nowrap;
  }

  .label {
    margin-left: 0.25rem;
    white-space: nowrap;
    font-size: 0.75rem;
    padding: 0 0 0.25rem 0;
  }

  .sparkChart {
    position: relative;

    display: flex;
    align-items: flex-end;
  }

  .canvas {
    display: block;
  }

  .number {
    margin-left: 0.5rem;
  }

  .iconValueWrapper {
    display: flex;
    align-items: center;
  }

  .aggregationIcon {
    fill: @lib__colors__N600Light;
    margin-right: 0.25rem;
  }

  .keyValue {
    margin-left: 0.25rem;
  }
}

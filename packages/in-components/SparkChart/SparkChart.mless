:local {
  .withHorizontalMetricValueWrapper {
    display: flex;
    align-items: flex-end;
  }

  .withVerticalMetricValueWrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .horizontalMetricValue {
    margin-left: 0.25rem;
    white-space: nowrap;
  }

  .verticalMetricValue {
    margin-bottom: 0.25rem;
    white-space: nowrap;
  }

  .sparkChart {
    position: relative;

    display: flex;
    align-items: flex-end;
  }

  .canvas {
    display: block;
  }

  .number {
    margin-left: 0.5rem;
  }
}

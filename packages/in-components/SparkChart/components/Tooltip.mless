@import '~in-themes/active.less';

:local {
  .tooltip {
    position: absolute;
    top: 0;
    z-index: 1;
  }

  .glassPane {
    position: absolute;
    z-index: 2;
    top: 2px;
    bottom: 2px;
    left: 0;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;

    border-left: 1px solid rgba(0, 0, 0, 0.24);
  }

  .value {
    font-weight: bold;
    padding: 0.125rem 0.438rem;
    background: @lib__colors__white;
    color: @lib__colors__N800Dark;
    border-radius: @lib__shapes__radius_large;
    box-shadow: @lib__shadows__subtle;
    white-space: nowrap;
  }
}

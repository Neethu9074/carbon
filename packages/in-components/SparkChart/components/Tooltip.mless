:local {
  .tooltip {
    position: absolute;
    top: 0;
  }

  .glassPane {
    position: absolute;
    left: 2px;
    top: 2px;
    height: 26px;
    width: 96px;
  }

  .line {
    position: absolute;
    top: 0;

    border-left: 1px solid red;
    height: 1.875rem;
  }

  .value {
    margin-left: 5px;
  }

  .leftAligned {
    margin-left: ~'calc(-100% - 5px)';
  }
}

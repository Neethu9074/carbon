:local {
  .tooltip {
    position: absolute;
    top: 0;
    z-index: 1;
  }

  .glassPane {
    position: absolute;
    z-index: 2;
    top: 2px;
    bottom: 2px;
    left: 0;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;

    border-left: 1px solid red;
  }

  .value {
    font-weight: bold;
    padding: 0.125rem 0.438rem;
    background: #21282e;
    color: white;
    border-radius: 0.188rem;
  }
}

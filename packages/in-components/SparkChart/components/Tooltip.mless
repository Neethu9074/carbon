@import '~in-themes/active.less';

:local {
  .tooltip {
    position: absolute;
    top: 0;
    z-index: 1;
  }

  .glassPane {
    position: absolute;
    z-index: 2;
    top: 2px;
    bottom: 2px;
    left: 0;
    width: 100%;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;

    border-left: 1px solid rgba(0, 0, 0, 0.24);
  }

  .value {
    font-weight: bold;
    padding: 0.125rem 0.438rem;
    background: var(--ids-color-option-white);
    color: var(--ids-color-option-neutral-800);
    border-radius: var(--ids-border-radius-option-large);
    box-shadow: var(--ids-shadow-option-subtle);
    white-space: nowrap;
  }
}

:local {
  .searchInputWrapper {
    padding: 0.5rem;
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    background: var(--ids-color-option-neutral-50);
    height: 3.25rem;
  }

  .searchInput {
    background: #fff;
  }

  .overlay {
    width: 26rem;
    @height: 20rem;
    min-height: @height;
    height: @height;
    max-height: @height;

    border-radius: var(--ids-border-radius-option-medium);
  }

  .filterList {
    border-bottom: 1px solid var(--ids-color-option-neutral-400);
  }

  .option {
    justify-content: space-between;
    font-weight: normal;
  }

  .loading {
    margin: 0 auto;
  }
}

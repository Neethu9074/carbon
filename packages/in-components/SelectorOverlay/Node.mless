@import '~in-themes/active.less';

:local {
  .icon {
    fill: @lib__colors__N600Light;
  }

  .option {
    font-weight: normal;
    font-size: 0.75rem;
    padding: 0.4rem 0.8rem;

    &.disabled {
      font-weight: lighter;
      font-size: 0.1rem;
      cursor: not-allowed;
      background-color: @lib__colors__N200;
      opacity: 0.5;
    }
  }

  .keyValue {
    gap: 0.25rem;
  }
}

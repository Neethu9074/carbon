:local {
  .option {
    font-weight: normal;
    font-size: 0.75rem;
    padding: 0.4rem 0.8rem;

    &.disabled {
      font-weight: lighter;
      font-size: 0.1rem;
      cursor: not-allowed;
      background-color: var(--ids-color-option-neutral-200);
      opacity: 0.5;
    }
  }

  .keyValue {
    gap: 0.25rem;
  }
}

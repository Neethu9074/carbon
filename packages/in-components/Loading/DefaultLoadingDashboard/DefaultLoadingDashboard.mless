@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .firstRow {
    margin-top: @grid__gutter * 1px;
  }

  .skeletonKpi {
    width: 100%;
    height: 7.625rem;
    display: block;
  }

  .skeletonChart {
    width: 100%;
    height: 15.563rem;
    display: block;
  }

  .lightMode {
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-large);
    box-shadow: var(--ids-shadow-option-subtle);
  }
}

@import '~in-themes/active.less';

@spacing: 1rem;

:local {
  .container {
    position: fixed;
    bottom: @spacing;
    right: @spacing;
    padding: 0;
    display: flex;
    z-index: var(--ids-z-index-option-sticky-header);

    > *:not(:last-child) {
      margin-right: @spacing;
    }
  }
}

@import '~in-themes/mixins.less';

@spacing: 1rem;

:local {
  .container {
    bottom: 1.5rem;

    display: flex;
    flex-direction: column-reverse;
    align-items: flex-end;

    ul {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      list-style: none;
      row-gap: @spacing;
    }

    :global(.cds--btn) {
      background-color: var(--cds-button-secondary);
      &:hover {
        background-color: var(--cds-button-secondary-hover);
      }
    }
  }

  .buttonLabelContainer {
    .flexbox();

    label {
      opacity: 1;
      width: 2.5rem;
      overflow: hidden;
      transition: all linear 0.2s;

      &.labelHidden {
        width: 0;
        opacity: 0;
      }
      &:hover {
        cursor: pointer;
      }
    }
  }

  .withShadow {
    box-shadow: var(--ids-shadow-option-pronounced);
  }

  .rotate {
    transform: rotate(45deg);
    transition: all ease-in-out 0.25s;
  }

  .menuOpen {
    max-height: 100%;
  }

  .menuClosed {
    max-height: 0px;
    width: 0;
    margin: 0;
  }

  .dropdown {
    overflow: hidden;
    bottom: 4rem;
  }
}

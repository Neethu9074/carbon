:local {
  .button {
    border-radius: 1.5rem;
    border: none;
    color: var(--ids-color-option-white);
    padding: 0.75rem;
    transition: background-color 250ms;

    &:hover {
      cursor: pointer;
      text-decoration: none;
    }
  }

  .primaryv2 {
    background-color: var(--ids-color-option-blue-400);
    &:hover {
      background-color: #148cc8;
    }
  }

  .action {
    background-color: var(--ids-color-option-neutral-800);
    &:hover {
      background-color: var(--ids-color-option-neutral-800);
    }
  }

  // :global(.g10) can be removed after the carbonG10ThemeEnabled feature flag is removed
  :global(.g10) {
    .primaryv2 {
      background-color: var(--cds-button-primary);
      &:hover {
        background-color: var(--cds-button-primary-hover);
      }
    }

    .action {
      background-color: var(--cds-button-secondary);
      &:hover {
        background-color: var(--cds-button-secondary-hover);
      }
    }
  }

  .hasIcon {
    padding-right: 1.25rem;
  }

  .withShadow {
    box-shadow: var(--ids-shadow-option-pronounced);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon {
    fill: var(--ids-color-option-white);
  }
  .iconHasMargin {
    margin-right: 0.5rem;
  }

  .label {
    font-size: var(--ids-font-size-option-body-regular);
    font-weight: bold;
    line-height: 1.25rem;
    text-transform: uppercase;
  }
}

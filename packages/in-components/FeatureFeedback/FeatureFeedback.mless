@import '~in-themes/active.less';

:local {
  .betaMarker {
    background: var(--ids-color-option-neutral-100);
    border-radius: @lib__shapes__radius_small;
    color: var(--ids-color-option-neutral-800);
    border: 1px solid var(--ids-color-option-neutral-400);
    padding: 0.5rem 0.625rem;
    height: 2.6875rem;
    display: flex;
    align-items: center;
  }

  .betaPill {
    margin-right: 0.4rem;
  }

  .betaLink {
    margin-left: 0.2rem;
  }
}

:local {
  .menu {
    max-width: 12.5rem;
    max-height: 31.25rem;
    overflow: hidden auto;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--ids-color-option-white);
    box-shadow: var(--ids-shadow-option-pronounced);
  }
}

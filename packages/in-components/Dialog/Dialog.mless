@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;

    background-color: rgba(var(--ids-color-option-neutral-700), 0.5);
    z-index: @z-index__dialog;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;
  }

  .dialog {
    min-width: 25rem;
    max-width: 90vw;
    cursor: auto;
  }

  .header {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;

    height: 5rem;
    padding: 1.5rem;
    background: var(--ids-color-option-white);
    border-radius: @lib__shapes__radius_small @lib__shapes__radius_small 0 0;
  }

  .title {
    color: var(--ids-color-option-neutral-900);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 2rem;
    margin: 0;
    padding: 0;
    .ellipsis();
  }

  .body {
    background: #fff;
    padding: 0 1.5rem 1.5rem;
    // 5rem to account for header, 4rem for typical footers and a little bit more to make it
    // feel spacious.
    max-height: ~'calc(100vh - 12rem)';
    overflow: hidden auto;
  }

  .withRoundedBottomBorder {
    border-radius: 0 0 @lib__shapes__radius_small @lib__shapes__radius_small;
  }

  .withoutPadding {
    padding: 0;
  }

  .withoutBottomPadding {
    padding-bottom: 0;
  }

  .showOverflow {
    overflow: visible;
  }

  .closeIcon {
    cursor: pointer;
    fill: var(--ids-color-option-neutral-500);
    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .customCloseBehaviour {
    display: flex;
    font-size: @lib__typography__body__font-size;
    margin-left: auto;
    padding-right: 0.5rem;
  }

  .customTitle {
    display: flex;
    align-items: center;
    line-height: 2rem;

    h1 {
      margin-left: 0.5rem;
    }

    svg {
      fill: var(--ids-color-option-neutral-800);
    }
  }

  .cursorDefault {
    cursor: default;
  }

  .scrollShadow {
    box-shadow: @lib__shadows__subtle;
  }
}

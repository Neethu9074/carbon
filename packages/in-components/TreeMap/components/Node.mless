@import '~in-themes/mixins.less';

:local {
  .node {
    position: absolute;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    padding: 0.5rem;

    background: var(--ids-color-option-neutral-400);

    overflow: hidden;
    white-space: normal;
    cursor: pointer;
  }

  .nodeSmallHeight {
    padding-top: 0.125rem;
    padding-bottom: 0.125rem;
  }

  .nodeSmallWidth {
    padding-left: 0.125rem;
    padding-right: 0.125rem;
  }

  .label,
  .value {
    max-width: 100%;

    text-align: center;
    .ellipsis();
  }

  .fullLabel {
    white-space: normal;
  }

  .label {
    font-size: 0.75rem;
    color: var(--cds-text-primary);
  }

  .value {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--cds-text-primary);
  }
}

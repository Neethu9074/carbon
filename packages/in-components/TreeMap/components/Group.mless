@import '~in-themes/mixins.less';

:local {
  .group {
    position: absolute;

    background: #ebf0f2;
    .ellipsis();
  }

  .header {
    display: flex;
    align-items: center;
    width: 100%;

    height: 2rem;
    padding: 0 0.5rem;
    cursor: pointer;

    &:hover {
      background: var(--ids-color-option-neutral-400);

      .hoverLayer {
        width: 100%;
        bottom: 0;
      }

      .label,
      .value {
        color: #fff;
      }
    }
  }

  .hoverLayer {
    position: absolute;
    top: 32px;
    bottom: 100%;
    left: 0;
    right: 0;

    background: rgba(0, 0, 0, 0.125);
    pointer-events: none;
  }

  .label {
    max-width: 100vw;
    margin-right: 0.5rem;

    font-size: 0.75rem;
    color: var(--cds-text-primary);
    .ellipsis();
  }

  .value {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--cds-text-primary);
  }

  .link {
    &:hover {
      text-decoration: none;
    }
  }
}

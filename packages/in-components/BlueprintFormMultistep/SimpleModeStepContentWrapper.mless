@import '~in-themes/active.less';

:local {
  .container {
    display: grid;
    grid-template-columns: 1fr 2fr 2fr;
    grid-template-rows: min-content auto;
    grid-column-gap: 0.5rem;
    grid-row-gap: 0.5rem;
    padding-top: 2rem;
    width: 100%;
    height: 100%;
  }

  .headline {
    grid-column: 1 / span 3;
    color: var(--ids-color-option-neutral-900);
    font-size: var(--ids-font-size-option-heading-400);
    line-height: 2.5rem;
    margin: 0.5rem;
    font-weight: normal;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
}

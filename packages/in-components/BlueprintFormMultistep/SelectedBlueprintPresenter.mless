:local {
  .container {
    margin: 0.5rem;
  }

  .headline {
    color: var(--ids-color-option-neutral-600);
    font-size: var(--ids-font-size-option-heading-200);
    font-weight: 600;
    line-height: 1.5rem;
    // allow beta badge placed besides the title
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .description {
    color: var(--ids-color-option-neutral-900);
    font-size: var(--ids-font-size-option-body-bold);
    font-weight: var(--ids-font-weight-option-body-large);
    line-height: 1.25rem;
    width: 100%;
  }
}

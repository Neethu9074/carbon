@import '~in-themes/active.less';

:local {
  .container {
    margin: 0.5rem;
  }

  .headline {
    color: var(--ids-color-option-neutral-600);
    font-size: @lib__typography__h200__font-size;
    font-weight: 600;
    line-height: 1.5rem;
    // allow beta badge placed besides the title
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .description {
    color: var(--ids-color-option-neutral-900);
    font-size: @lib__typography__body-bold__font-size;
    font-weight: @lib__typography__body-bold__font-weight;
    line-height: 1.25rem;
    width: 100%;
  }
}

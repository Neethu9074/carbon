@import '~in-themes/active.less';

:local {
  .container {
    margin: 8px;
  }

  .list {
    list-style: none;
    // reset some browser styles
    margin: 0;
    padding: 0;
  }

  .item.selected {
    background-color: var(--ids-color-option-neutral-600);
    color: var(--ids-color-option-white);
  }

  .item {
    align-items: center;
    border-radius: var(--ids-border-radius-option-small);
    color: var(--ids-color-option-neutral-700);
    display: flex;
    justify-content: space-between;
    font-size: var(--ids-font-size-option-body-regular);
    min-height: 2rem;
    padding: 0.5rem;

    &:not(.selected):hover {
      background: var(--ids-color-option-neutral-300);
    }

    &:hover {
      cursor: pointer;
    }

    &:not(:last-child) {
      margin-bottom: 0.5rem;
    }
  }

  .rightSeparator {
    border-right: 1px solid var(--ids-color-option-neutral-300);
    padding-right: 1rem;
  }
}

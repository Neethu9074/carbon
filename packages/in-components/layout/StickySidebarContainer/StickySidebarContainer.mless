@import '~in-themes/active.less';

:local {
  .rightColumn {
    border-left: 1px solid var(--ids-color-option-neutral-400);
  }

  .sideBarSticky {
    position: sticky;

    /*
      Offset: top, needed when any fixed header on page.
      It also reduces the max. available height for scrolling
      E.g. in settings area context: 11rem for overall header
     */
    top: var(--topOffset);
    height: min-content;

    bottom: 0;
  }
}

:local {
  .view {
    overflow-x: hidden;
    overflow-y: auto;
    position: relative;
  }

  .scrollableIndicator {
    background: #fff;
    height: 100px;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to bottom, rgba(247, 249, 250, 0) 0%, #f7f9fa 100%);
    pointer-events: none;
  }
}

@import '~in-themes/active.less';

:local {
  .tvMode {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background: var(--ids-color-option-neutral-100);
    z-index: var(--ids-z-index-option-tv-mode);
    overflow: hidden auto;
  }
}

@import '~in-themes/active.less';

:local {

  .scrollHintOuter {
    width: 100%;
    height: 0;
    overflow-y: visible;

    display: none;

    &.visible {
      display: inherit;
    }
  }

  .scrollHintInnerTop {
    width: 100%;
    height: 0.3rem;
    opacity: 0.5;
    background: linear-gradient(to bottom, @lib__colors__N400, @lib__colors__transparent);
  }

  .scrollHintInnerBottom {
    width: 100%;
    height: 0.3rem;
    position: relative;
    top: -0.3rem;
    opacity: 0.5;
    background: linear-gradient(to top, @lib__colors__N400, @lib__colors__transparent);
  }
}

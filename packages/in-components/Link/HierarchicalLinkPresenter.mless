@import '~in-themes/active.less';

:local {
  .link {
    display: flex;
    align-items: center;
    font-size: 0.75rem;
  }

  .pluginIcon {
    margin: 0 0.25rem 0 0;
    fill: @lib__colors__primary2;
  }

  .infoIcon {
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.25rem;
    cursor: pointer;
  }
}

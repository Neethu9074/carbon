:local {
  .link {
    display: flex;
    align-items: center;
  }

  .dark {
    color: #2d4048;

    &:hover {
      color: #8c969a;
    }
  }

  .light {
    color: #8c969a;

    &:hover {
      color: #fff;
    }
  }

  .pluginIcon {
    margin: 0 0.25rem 0 0;
  }

  .infoIcon {
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin: 0 0.5rem 0 0.15rem;
    cursor: pointer;

    &--dark {
      fill: #2d4048;

      &:hover {
        fill: #8c969a;
      }
    }

    &--light {
      fill: #8c969a;

      &:hover {
        fill: #fff;
      }
    }
  }
}

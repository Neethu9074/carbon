:local {
  .link {
    display: flex;
    font-size: 0.75rem;
    align-items: center;
  }

  .pluginIcon {
    margin: 0 0.25rem 0 0;
    fill: var(--ids-color-option-blue-500);
  }

  .infoIcon {
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.25rem;
    cursor: pointer;
  }
}

@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    background: var(--ids-color-option-white);
    border-radius: var(--ids-border-radius-option-small) var(--ids-border-radius-option-small) 0 0;
    height: 5rem;
    padding: 1.5rem;
  }

  .scrollShadow {
    box-shadow: var(--ids-shadow-option-subtle);
  }

  .titleContainer {
    display: flex;
    align-items: center;
  }

  .title {
    color: var(--ids-color-option-neutral-800);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 2rem;
    margin-bottom: 0;
  }
}

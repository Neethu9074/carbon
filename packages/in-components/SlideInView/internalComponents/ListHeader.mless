:local {
  .header {
    display: flex;
    align-items: center;

    height: 3.5rem;
    padding-left: 0.5rem;

    background: var(--ids-color-option-white);
  }

  .titleContainer {
    display: flex;
    align-items: center;
  }

  .icon {
    fill: var(--ids-color-option-neutral-900);
    margin-right: 0.5rem;

    &:hover,
    &:focus {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .title {
    color: var(--ids-color-option-neutral-800);

    font-size: 0.875rem;
    font-weight: 500;
  }
}

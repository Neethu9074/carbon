:local {
  .temporyMessageWrapper {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
  }

  .notificationIconSuccess,
  .notificationIconError {
    margin-right: 0.5rem;
  }

  .notificationIconSuccess {
    fill: var(--ids-color-option-green-500);
  }

  .notificationIconError {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-red-500);
  }

  .notificationLabelSuccess {
    color: var(--ids-color-option-green-500);
  }

  .notificationLabelError {
    color: var(--ids-color-option-red-500);
  }
}

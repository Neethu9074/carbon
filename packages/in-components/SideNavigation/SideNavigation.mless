@import '~in-themes/active.less';

:local {
  .nav {
    overflow: hidden;
  }

  .title {
    font-size: 0.875rem;
    text-transform: uppercase;
    margin: 0.25rem 0;
    padding: 0.375rem 0.5rem;
    color: var(--ids-color-option-neutral-500);
  }

  .tabList {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }

  .tab {
    display: flex;
    align-items: center;
    color: var(--ids-color-option-neutral-700);
    font-size: 0.875rem;
    height: 2.25rem;
    padding: 0.375rem 1rem;
    margin: 0.125rem 0;
    border-radius: @lib__shapes__radius_small;
    cursor: pointer;
    gap: 0.5rem;

    &:hover {
      background: var(--ids-color-option-neutral-300);
    }
  }

  .tabSelected {
    background: var(--ids-color-option-neutral-600);
    color: #fff;

    .icon {
      fill: #fff;
    }

    &:hover {
      color: #fff;
      background: var(--ids-color-option-neutral-700);

      .icon {
        fill: #fff;
      }
    }
  }

  .icon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-700);
  }

  .link {
    text-decoration: none;
    color: var(--ids-color-option-neutral-700);

    &:hover {
      color: var(--ids-color-option-teal-500);
      text-decoration: none;
    }
  }
}

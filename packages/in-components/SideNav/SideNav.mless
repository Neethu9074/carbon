@import '~in-themes/mixins.less';

:local {
  .container {
    padding-left: 1rem;
    position: fixed;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    margin: 1.25rem 0;

    color: var(--ids-color-option-neutral-600);
    font-size: var(--ids-font-size-option-body-regular);
    line-height: 1.25rem;

    &:hover {
      cursor: pointer;
    }

    &.selected {
      color: var(--ids-color-option-neutral-900);
    }
  }

  .label {
    .flexbox();
  }
}

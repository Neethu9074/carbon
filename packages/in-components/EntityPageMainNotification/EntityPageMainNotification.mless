@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;

    width: fit-content;

    margin: 3rem 0 2rem;
  }

  .framed {
    padding: 2rem 1rem 1rem;
    border-radius: 0.25rem;
    border: 1px solid var(--ids-color-option-neutral-400);
    box-shadow: 0 0.375rem 0.75rem 0 var(--ids-color-option-neutral-400);
  }

  .withBackground {
    background-color: #fff;
  }

  .light {
    box-shadow: 0 0.375rem 0.75rem 0 var(--ids-color-option-neutral-700);
  }

  .icon {
    margin-bottom: 0.5rem;
    fill: var(--ids-color-option-neutral-600);
  }

  .title {
    margin: 0;

    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 600;
  }

  .explanation {
    width: 28rem;

    margin: 1rem 1.5rem;

    text-align: center;
    line-height: 1.25rem;
    font-size: 0.8125rem;
    color: var(--ids-color-option-neutral-700);
  }
}

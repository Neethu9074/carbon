@import '~in-themes/active.less';

:local {
  .well {
    margin: 0 auto;
    max-width: 34.375rem;
    padding: 0.625rem 1rem;
    background: var(--ids-color-option-white);
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-large);
    box-shadow: var(--ids-shadow-option-subtle);

    & > * {
      margin: 2rem 1rem;
    }
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .indicator {
    fill: @lib__colors__N300;
  }

  .withMargin {
    margin-left: 0.5rem;
  }

  .tooltipItem {
    line-height: 1.25rem;
    &:not(:last-child) {
      padding-bottom: 0.5rem;
      border-bottom: solid 1px @lib__colors__N500;
    }
    &:not(:first-child) {
      padding-top: 0.5rem;
    }
    font-weight: 300;
  }
}

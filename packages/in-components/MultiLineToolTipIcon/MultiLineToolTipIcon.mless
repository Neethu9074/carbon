@import '~in-themes/mixins.less';

:local {
  .indicator {
    fill: var(--ids-color-option-neutral-300);
  }

  .withMargin {
    margin-left: 0.5rem;
  }

  .tooltipItem {
    line-height: 1.25rem;
    &:not(:last-child) {
      padding-bottom: 0.5rem;
      border-bottom: solid 1px var(--ids-color-option-neutral-500);
    }
    &:not(:first-child) {
      padding-top: 0.5rem;
    }
    font-weight: 300;
  }

  .label {
    margin: 0 0 0 0.5rem;
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-500);
    font-weight: 500;
  }

  .container {
    display: inline-flex;
    align-items: center;
  }
}

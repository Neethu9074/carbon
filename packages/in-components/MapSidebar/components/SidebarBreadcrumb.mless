@import '~in-themes/active.less';

:local {
  .sidebarBreadcrumb {
    position: absolute;
    top: 0;
    left: 21rem;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 2.25rem;

    background: #fff;
    border-radius: 0.125rem;
  }
  .crumb {
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1rem;
  }

  .crumbLink {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  .crumbIcon {
    opacity: 0.5;
    fill: @lib__colors__N700Medium;

    &:hover {
      opacity: 1;
      fill: @lib__colors__blue800;
    }
  }
  .crumbIconSelected {
    opacity: 1;
    fill: @lib__colors__blue800;
  }
}

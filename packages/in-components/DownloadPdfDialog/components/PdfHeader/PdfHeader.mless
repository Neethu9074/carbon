:local {
  .pdfHeader {
    width: 100%;
    max-width: 62.5rem;
    position: absolute;
    bottom: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
  }

  .logo {
    margin-bottom: 1.5rem;
  }

  .header {
    margin: 1rem 1rem 1.5rem;
  }

  .timeRange {
    margin-bottom: 1rem;
  }
}

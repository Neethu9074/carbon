:local {
  .list {
    overflow-y: scroll;
    max-height: 20rem;
    width: 30rem;
  }

  .noTags {
    font-size: 0.875rem;
    color: #6b8088;
  }

  .activeTags {
    padding: 0 0 0.5rem 0;
  }

  .button {
    display: block;
  }

  .carbonButton {
    margin-top: 0.75rem;
    :global(.cds--g90) {
      background-color: transparent;
    }
  }
}

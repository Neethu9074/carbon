@import '~in-themes/active.less';

:local {
  .error {
    fill: @lib__colors__red800;
    margin: 0.5rem auto 0;
    display: block;
  }
  .loadingBarContainer {
    width: 15rem;
    height: 0.625rem;
    margin: 1rem 0 0.5rem;
  }
  .horizontalIndicator {
    height: 0.5rem;
    border-radius: 0.3125rem;
  }
}

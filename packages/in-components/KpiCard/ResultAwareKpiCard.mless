:local {
  .error {
    fill: var(--ids-color-option-red-500);
    margin: 0.5rem auto 0;
    display: block;
  }
  .loadingBarContainer {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: left;
    justify-content: flex-start;
  }

  .skeleton {
    margin-top: 0;
    display: block;
    width: 50%;
    height: 2.375rem;
  }
}

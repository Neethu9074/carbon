@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    padding: 0.625rem 1rem;
    .ellipsis();
    position: relative;
    background: @lib__colors__white;
    border-radius: @lib__shapes__radius_large;
    box-shadow: @lib__shadows__subtle;
  }

  .borderless {
    border-left: 0;
  }

  .shadowless {
    box-shadow: none;
  }

  .centerValue {
    text-align: center;
  }

  .useMaxAvailableHeight {
    height: 100%;
  }

  .title {
    color: @lib__colors__N700Medium;
    font-size: 1rem;
    font-weight: 200;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .centerTitle {
    justify-content: center;
  }

  .action {
    display: none;
    margin: -4px 0;
  }

  .actionIcon {
    fill: @lib__colors__N600Light;
    cursor: pointer;
  }

  .wrapper:hover .showLongVariantOnHover {
    .action {
      display: inline-flex;
    }

    .actionIcon {
      display: none;
    }
  }

  .major,
  .minor {
    color: @lib__colors__N900Primary;
  }

  .major {
    font-size: 2.375rem;
  }

  .minor {
    font-size: 1.5rem;
  }

  .companion {
    color: @lib__colors__N700Medium;
    font-size: 1rem;
    font-weight: 200;
    padding-left: 1rem;
  }

  .actions {
    position: absolute;
    top: 0.625rem;
    right: 1rem;
    display: flex;
    align-items: center;
  }
}

@import '~in-themes/mixins.less';

:local {
  .wrapper {
    padding: 0.625rem 1rem;
    position: relative;
    border-radius: var(--ids-border-radius-option-large);
  }

  .wrapper .kpibody {
    padding: 0;
    line-height: unset;
  }

  .wrapper .kpiheader {
    padding: 0;
  }

  :global(.cds--tile) {
    border-radius: 0;
    line-height: unset;
  }

  .borderless {
    border-left: 0;
  }

  .shadowless {
    box-shadow: none;
  }

  .centerValue {
    text-align: center;
  }

  .modal {
    .widgetInModal();
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    min-height: 1.9rem;

    color: var(--cds-text-primary);
    font-size: 1rem;
    font-weight: 600;
  }

  .flexTooltip {
    display: flex;
    flex-grow: 2;
    align-items: flex-start;
  }

  .centerTitle {
    justify-content: center;
  }

  .major,
  .minor {
    color: var(--ids-color-option-neutral-900);
  }

  .major {
    font-size: 1.5rem;

    &.bigMajor {
      font-size: 2.375rem;
    }
  }

  .minor {
    font-size: 1rem;

    &.bigMinor {
      font-size: 1.5rem;
    }
  }

  .companion {
    color: var(--ids-color-option-neutral-700);
    font-size: 1rem;
    font-weight: 200;
    padding-left: 1rem;
    display: inline-block;
  }

  .actions {
    display: flex;
    align-items: center;
  }

  .titleContainer {
    margin-right: 1rem;
    display: flex;
    align-items: flex-start;
  }

  .titleText {
    .ellipsis();
  }

  .contentText {
    .ellipsis();
    width: 100%;
    display: block;
  }

  .hidden {
    display: none;
  }

  .major,
  .minor {
    &.critical {
      color: var(--ids-color-option-red-700);
    }

    &.warning {
      color: var(--ids-color-option-yellow-500);
    }
  }

  .hasInfo {
    background-color: var(--ids-color-option-neutral-50);
  }
}

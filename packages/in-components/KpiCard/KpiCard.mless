@import '~in-themes/mixins.less';

:local {
  .wrapper {
    padding: 0.625rem 1rem;
    .ellipsis();
    position: relative;
    background: var(--ids-color-option-white);
    border-radius: var(--ids-border-radius-option-large);
    box-shadow: var(--ids-shadow-option-subtle);
  }

  .borderless {
    border-left: 0;
  }

  .shadowless {
    box-shadow: none;
  }

  .centerValue {
    text-align: center;
  }

  .useMaxAvailableHeight {
    height: 100%;
  }

  .title {
    display: flex;
    justify-content: space-between;
    align-items: center;

    min-height: 1.75rem;

    color: var(--ids-color-option-neutral-700);
    font-size: 1rem;
    font-weight: 200;
  }

  .flexTooltip {
    display: flex;
    flex-grow: 2;
    align-items: flex-start;
  }

  .centerTitle {
    justify-content: center;
  }

  .action {
    display: none;
    margin: -4px 0;
  }

  .actionIcon {
    fill: var(--ids-color-option-neutral-600);
    cursor: pointer;
  }

  .wrapper:hover .showLongVariantOnHover {
    .action {
      display: inline-flex;
    }

    .actionIcon {
      display: none;
    }
  }

  .major,
  .minor {
    color: var(--ids-color-option-neutral-900);
  }

  .major {
    font-size: 2.375rem;
  }

  .minor {
    font-size: 1.5rem;
  }

  .companion {
    color: var(--ids-color-option-neutral-700);
    font-size: 1rem;
    font-weight: 200;
    padding-left: 1rem;
  }

  .actions {
    display: flex;
    align-items: center;
  }

  .titleText {
    .ellipsis();
  }
}

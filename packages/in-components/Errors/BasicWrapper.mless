:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;

    width: 100%;
    height: 100%;

    background: var(--ids-color-option-neutral-50);
  }

  .title {
    margin-bottom: 1rem;
    color: var(--ids-color-option-neutral-500);
  }

  .text {
    margin-top: 0.25rem;

    color: var(--cds-text-primary);
    font-size: 0.875rem;
  }
}

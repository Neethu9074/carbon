@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    text-decoration: none;

    height: 2rem;

    margin: 0.5rem;
    padding: 0.25rem;

    background: var(--ids-color-option-neutral-200);
    border-radius: @lib__shapes__radius_large;
    cursor: pointer;
    color: var(
      --ids-color-option-neutral-600
    ) !important; // Temporary this component will be replaced with IconButtons in the future

    &:hover {
      text-decoration: none;
      color: var(
        --ids-color-option-neutral-800
      ) !important; // Temporary this component will be replaced with IconButtons in the future

      .icon {
        fill: var(--ids-color-option-neutral-800);
      }
    }
  }

  .dark {
    background: var(--ids-color-option-neutral-900);
    color: var(--ids-color-option-neutral-400) !important;

    .icon {
      fill: var(--ids-color-option-neutral-400);
    }

    &:hover {
      color: var(--ids-color-option-neutral-500) !important;
      .icon {
        fill: var(--ids-color-option-neutral-500);
      }
    }
  }

  .icon {
    fill: var(--ids-color-option-neutral-600);
  }

  .active {
    fill: var(--ids-color-option-blue-400);

    &:hover {
      fill: var(--ids-color-option-blue-500);
    }
  }

  .appendTop {
    margin-top: 1px;
    border-radius: 0 0 @lib__shapes__radius_large @lib__shapes__radius_large;
  }

  .appendBottom {
    margin-bottom: 1px;
    border-radius: @lib__shapes__radius_large @lib__shapes__radius_large 0 0;
  }

  .appendLeft {
    margin-left: 1px;
    border-radius: 0 @lib__shapes__radius_large @lib__shapes__radius_large 0;
  }

  .appendRight {
    margin-right: 1px;
    border-radius: @lib__shapes__radius_large 0 0 @lib__shapes__radius_large;
  }
}

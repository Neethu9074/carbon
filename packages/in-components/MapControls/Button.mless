@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    text-decoration: none;

    height: 2rem;

    margin: 0.5rem;
    padding: 0.25rem;

    background: @lib__colors__N200;
    border-radius: @lib__shapes__radius_large;
    cursor: pointer;
    color: @lib__colors__N600Light !important; // Temporary this component will be replaced with IconButtons in the future

    &:hover {
      text-decoration: none;
      color: @lib__colors__N800Dark !important; // Temporary this component will be replaced with IconButtons in the future

      .icon {
        fill: @lib__colors__N800Dark;
      }
    }
  }

  .dark {
    background: @lib__colors__N900Primary;
    color: @lib__colors__N400 !important;

    .icon {
      fill: @lib__colors__N400;
    }

    &:hover {
      color: @lib__colors__N500 !important;
      .icon {
        fill: @lib__colors__N500;
      }
    }
  }

  .icon {
    fill: @lib__colors__N600Light;
  }

  .active {
    fill: var(--ids-color-option-blue-400);

    &:hover {
      fill: var(--ids-color-option-blue-500);
    }
  }

  .appendTop {
    margin-top: 1px;
    border-radius: 0 0 @lib__shapes__radius_large @lib__shapes__radius_large;
  }

  .appendBottom {
    margin-bottom: 1px;
    border-radius: @lib__shapes__radius_large @lib__shapes__radius_large 0 0;
  }

  .appendLeft {
    margin-left: 1px;
    border-radius: 0 @lib__shapes__radius_large @lib__shapes__radius_large 0;
  }

  .appendRight {
    margin-right: 1px;
    border-radius: @lib__shapes__radius_large 0 0 @lib__shapes__radius_large;
  }
}

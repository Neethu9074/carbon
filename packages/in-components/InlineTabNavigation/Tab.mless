:local {
  .tab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 2.5rem;
    padding: 0 0.75rem;
    color: var(--ids-color-option-neutral-600);
    font-size: 0.875rem;
    font-weight: 400;
    border-bottom: 3px solid transparent;

    &.interactive {
      cursor: pointer;

      &:hover,
      &.active {
        color: var(--ids-color-option-neutral-900);
      }

      &:hover {
        border-bottom-color: var(--ids-color-option-neutral-600);
      }

      &.active {
        cursor: default;
        border-bottom-color: var(--cds-border-interactive);
        font-weight: 600;
      }
    }

    &.disabled {
      color: var(--ids-color-option-neutral-400);
    }
  }

  .withoutBottomBorder {
    border-bottom: 0;
  }

  .tabInner {
    display: flex;
    align-items: center;
  }

  .tabIcon {
    margin-right: 0.5em;
  }
}

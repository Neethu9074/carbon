@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    justify-content: stretch;
    align-items: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    background-color: var(--ids-color-option-white);
  }
}

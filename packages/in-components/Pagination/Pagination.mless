@import '~in-themes/active.less';

:local {
  .pagination {
    display: flex;
    justify-content: center;
    font-size: 0.875rem;
    padding: 1rem 0;
  }

  .control {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 2rem;
    height: 2rem;

    color: var(--ids-color-option-neutral-700);
    background: var(--ids-color-option-white);
    border: 1px solid var(--ids-color-option-neutral-300);
    border-left: none;

    &:first-child {
      border-radius: 2px 0 0 2px;
      border-left: 1px solid var(--ids-color-option-neutral-300);
    }

    &:last-child {
      border-radius: 0 2px 2px 0;
    }

    &:hover {
      background: var(--ids-color-option-neutral-100);
      color: var(--ids-color-option-neutral-900);
      cursor: pointer;
    }
  }

  .disabled {
    color: var(--ids-color-option-neutral-500);
    pointer-events: none;

    .icon {
      fill: var(--ids-color-option-neutral-500);
    }
  }

  .active {
    color: @lib__colors__primary1;
  }

  .icon {
    fill: var(--ids-color-option-neutral-700);
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    background-color: var(--ids-color-option-neutral-50);
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0.75rem;
  }

  .headerContent {
    display: flex;
    align-items: flex-start;
    padding-top: 0.375rem;
    font-size: 1rem;
    flex-grow: 1;

    .ellipsis();
  }

  .headerActions {
    margin-left: 0.5rem;
  }

  .expandIcon {
    border-radius: var(--ids-border-radius-small);
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-500);
    cursor: pointer;

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .expandedContentWrapper {
    padding: 0.75rem;
  }
}

:local {
  .wrapper {
    position: relative;

    display: flex;
    align-items: center;

    flex-grow: 1;
  }

  .wrapperWithPadding {
    padding: 1rem 0;
  }

  .wrapperdark {
    background: var(--ids-color-option-neutral-800);
  }

  .helpIcon {
    cursor: pointer;
    margin-right: 0.5rem;

    fill: var(--ids-color-option-neutral-700);
    &:hover {
      fill: var(--ids-color-option-neutral-500);
    }
  }

  .helpIcondark {
    fill: var(--ids-color-option-white);
    &:hover {
      fill: var(--ids-color-option-neutral-200);
    }
  }

  .inputWrapper {
    display: flex;
    align-items: center;

    width: 100%;
    max-width: ~'calc(100% - 12rem)';
    height: 1.875rem;

    background: var(--ids-color-option-white);
    border: 1px solid var(--ids-color-option-neutral-400);
  }

  .inputWrapperNoRightBorder {
    border-right: 0;
  }

  .inputWrapperdark {
    background: var(--ids-color-option-neutral-900);
    border: 1px solid var(--ids-color-option-neutral-600);
  }

  .withoutSaveFilter {
    flex: 1;
    width: 15rem; // just a usual size of a average DFQ
    max-width: unset;
  }

  .button {
    display: flex;
    align-items: center;
    justify-content: center;

    height: 1.875rem;
    padding: 0 0.625rem;

    background: var(--ids-color-option-neutral-50);
    border: 1px solid var(--ids-color-option-neutral-300);
    color: var(--ids-color-option-neutral-700);
    cursor: pointer;
  }

  .buttondark {
    background: var(--ids-color-option-neutral-900);
    border: 1px solid var(--ids-color-option-neutral-700);
    color: var(--ids-color-option-neutral-50);
  }

  .icon {
    fill: var(--ids-color-option-neutral-700);
  }

  .icondark {
    fill: var(--ids-color-option-white);
  }

  .filtersSpaceholder {
    border-right: 1px solid var(--ids-color-option-neutral-300);
    height: 1.875rem;
  }
}

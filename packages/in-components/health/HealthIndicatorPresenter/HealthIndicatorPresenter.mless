:local {
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--ids-border-radius-option-medium);
    font-size: var(--ids-font-size-option-body-regular);
    font-weight: 600;
    color: #3d464d;

    &:hover {
      text-decoration: none;
    }
  }

  .iconWarning {
    path:first-of-type {
      fill: black !important;
    }
    path:last-of-type {
      fill: #8e6a00 !important;
    }
  }

  .icon {
    margin: 0 2px 0 0;
  }

  .okayIcon {
    fill: var(--ids-color-option-green-500);
  }
}

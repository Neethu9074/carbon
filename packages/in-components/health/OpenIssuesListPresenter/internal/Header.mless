@import '~in-themes/active.less';

:local {
  .header {
    position: relative;
    padding: 0;
    margin: 0;
    border-bottom: 1px solid var(--ids-color-option-neutral-300);

    display: flex;
    align-items: center;
    justify-content: space-between;

    font-size: @lib__typography__h200__font-size;
    font-weight: 300;
    color: var(--ids-color-option-neutral-700);
    background: var(--ids-color-option-neutral-200);
  }

  .title {
    padding: 0.75rem 1rem;
  }

  .more {
    font-size: @lib__typography__h100__font-size;
    color: var(--ids-color-option-neutral-700);
    display: block;
  }

  .close {
    fill: var(--ids-color-option-neutral-500);
    padding: 0.5rem;

    &:hover {
      fill: var(--ids-color-option-neutral-800);
    }
  }
}

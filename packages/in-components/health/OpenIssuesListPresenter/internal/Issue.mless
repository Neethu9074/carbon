:local {
  .issue {
    margin: 0;
    padding: 1rem 0.75rem 1rem 3.1rem;
    list-style: none;
    border-top: 1px solid var(--ids-color-option-neutral-300);
    position: relative;

    &:first-child {
      border-top: 0;
    }
  }

  .link,
  .link:hover,
  .link:active,
  .link:focus {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  // Changed the visited color and active:hover:visited to override carbonised link styling
  .link:visited,
  .link:active:hover:visited,
  .link:visited:hover {
    color: inherit !important; // important was needed to override in Instana theme
  }

  .clickable:hover {
    cursor: pointer;
    background: var(--ids-color-option-neutral-50);

    .stripe {
      // overwrite background color defined via style attribute on DOM node
      background-color: var(--ids-color-option-blue-500) !important;
      width: 2.5rem;
    }

    .stripeIcon {
      opacity: 1;
    }
  }

  .stripe {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.5rem;

    display: flex;
    justify-content: center;
    align-items: center;
    // position above warning icon
    z-index: 1;
    transition: width 0.2s ease-in-out, background-color 0.2s ease-in-out;
  }

  .stripeIcon {
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.2s ease-in-out 0.05s;
  }

  .title {
    font-size: var(--ids-font-size-option-heading-200);
    color: var(--ids-color-option-neutral-900);
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    position: relative;
  }

  .icon {
    position: absolute;
    margin-left: -2.188rem;
  }

  .iconWarning {
    path:first-of-type {
      fill: black;
    }
    path:last-of-type {
      fill: #8e6a00;
    }
  }

  .description {
    margin: 0;
    font-size: var(--ids-font-size-option-heading-100);

    & p:last-child {
      margin-bottom: 0;
    }
  }

  .descriptionTooLong {
    margin: 0;
    font-style: italic;
    display: block;
  }

  .startTime {
    padding: 0 0 0 0.25rem;
    color: var(--ids-color-option-neutral-600);
  }

  .timeSection {
    margin: 1rem 0 0;
  }
}

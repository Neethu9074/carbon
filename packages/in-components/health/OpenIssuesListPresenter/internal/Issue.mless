:local {
  .issue {
    div {
      column-gap: var(--cds-spacing-03);
    }
  }

  .iconWarning {
    path:first-of-type {
      fill: black;
    }
    path:last-of-type {
      fill: #8e6a00;
    }
  }

  .icon {
    vertical-align: middle;
  }

  .fixSuggestion {
    font-size: var(--cds-helper-text-01-font-size, 0.75rem);
    font-weight: var(--cds-helper-text-01-font-weight, 400);
    letter-spacing: var(--cds-helper-text-01-letter-spacing, 0.02rem);
    line-height: var(--cds-help-text-01-line-height, 1rem);
    color: var(--cds-text-secondary, #525252);
    word-break: break-all;
    p:last-child {
      margin-bottom: 0;
    }
  }

  .descriptionTooLong {
    margin-bottom: var(--cds-spacing-05);
  }

  div.tag {
    margin: 0 var(--cds-spacing-03) 0 0;
  }
}

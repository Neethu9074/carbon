:local {
  .issues {
    :global {
      .cds--contained-list__header {
        display: none;
      }
      button.cds--contained-list-item__content {
        padding: var(--cds-spacing-05);
      }
    }
    border-top: 1px solid var(--cds-border-subtle);
    border-bottom: 1px solid var(--cds-border-subtle);
    overflow-y: auto;
    @height-of-header-footer: 15rem;
    max-height: calc(70vh - @height-of-header-footer);
  }

  .loading {
    width: 20rem;
  }
}

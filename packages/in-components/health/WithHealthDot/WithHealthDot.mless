:local {
  .wrapper {
    position: relative;
    width: fit-content;
  }

  .dot {
    position: absolute;
    top: 0;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--ids-color-option-neutral-50);
    border-radius: var(--ids-border-radius-option-round);
  }
}

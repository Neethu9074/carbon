@import '~in-themes/active.less';

:local {
  .wrapper {
    position: relative;
    width: fit-content;
    padding-top: 1px;
  }

  .dot {
    position: absolute;

    top: -0.08rem;
    width: 0.5rem;
    height: 0.5rem;

    border-radius: 50%;
    border: 1px solid @lib__colors__N050;
  }
}

:local {
  .wrapper {
    position: relative;
    width: fit-content;
    padding-top: 1px;
  }

  .dot {
    position: absolute;

    top: -0.08rem;
    width: 0.5rem;
    height: 0.5rem;

    border-radius: var(--ids-border-radius-option-round);
    border: 1px solid var(--ids-color-option-neutral-50);
  }
}

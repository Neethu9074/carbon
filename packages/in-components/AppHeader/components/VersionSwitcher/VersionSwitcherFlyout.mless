@import '~in-themes/active.less';

:local {
  .flyout {
    background: #fff;
    max-width: 31.25rem;
  }

  .item, .item:hover {
    color: @lib__colors__N900Primary;
    text-decoration: none;
    position: relative;
    display: block;
    padding: 0.825rem 0.825rem 0.825rem 1.45rem;
    margin: 1rem;

    &:first-child {
      margin-bottom: 0;
    }

    &:last-child {
      margin-top: .213rem;
    }
  }

  .active, .active:hover, .item:hover {
    background: @lib__colors__N200;

    &::before {
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: .5rem;
      content: "";
      display: block;
      background: @lib__colors__green800;
    }
  }

  .active, .active:hover {
    cursor: default;
  }

  .title {
    margin: 0 0 0.625rem;
    font-size: 1rem;
    font-weight: 500;
    display: flex;
    align-items: center;
  }

  .description {
    color: #47525D;
    font-size: 0.875rem;
    margin: 0;
  }

  .beta {
    font-size: 0.8rem;
    border: 2px solid black;
    font-weight: bold;
    border-radius: 8px;
    padding: 1px 5px;
    margin: 0 0 0 5px;
  }

  .learnMore {
    position: absolute;
    top: 1.7rem;
    right: 1.9rem;
  }
}

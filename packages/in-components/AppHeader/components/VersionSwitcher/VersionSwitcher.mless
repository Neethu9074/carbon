@import '~in-themes/active.less';

:local {
  .switcher {
    position: absolute;
    top: 0.7rem;
    left: 7.4rem;
    display: flex;
    align-items: center;
  }

  .arrow {
    fill: @lib__colors__N400;
    padding: .1rem;

    &:hover {
      fill: #fff;
    }
  }

  .arrow.active {
    fill: #fff;

    &:hover {
      fill: @lib__colors__N400;
    }
  }

  .state {
    color: @lib__colors__N400;
    margin: 0 0 0 1rem;
    font-size: 1rem;
  }

  .beta {
    color: @lib__colors__N200;
    font-weight: bold;
    border-radius: 8px;
    border: 2px solid @lib__colors__N200;
    padding: 2px 4px;
    margin: 0 0 0 0.4rem;
    font-size: 0.7rem;
  }
}

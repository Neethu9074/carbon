@import '~in-themes/active.less';

:local {
  .block {
    display: flex;
    align-items: center;
    position: relative;

    white-space: nowrap;
    cursor: pointer;

    &:hover {
      .avatar {
        fill: #fff;
      }

      .icon {
        fill: white;
      }
    }

    &__expanded {
      .avatar {
        fill: #fff;
      }

      .icon {
        fill: white;
      }
    }
  }

  .icon {
    fill: @lib__colors__N500;
  }

  .avatar {
    margin-left: 1.5rem;
    fill: @lib__colors__N500;
  }

  .notificationDot {
    position: absolute;
    top: 0.25rem;
    left: 2.875rem;
    background: #ffde00;
    border-radius: 100%;
    height: 0.50rem;
    width: 0.5rem;
  }

  .in-tenant-switcher {
    max-height: 14.75rem;
    overflow-y: auto;
  }
}
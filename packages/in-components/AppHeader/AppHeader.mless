@import '~in-themes/active.less';

:local {
  .header {
    height: 3rem;

    display: flex;
    justify-content: center;
    align-items: center;

    background: @lib__colors__navy900;
    position: relative;
  }

  .right {
    position: absolute;
    right: 0.5rem;

    display: flex;
    align-items: center;
    justify-content: center;
  }
}

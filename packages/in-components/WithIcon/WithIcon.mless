@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    // this is required for making the contained label ellipsis correctly
    min-width: 0;

    & + .wrapper {
      margin-left: 0.5rem;
    }
    :global {
      .carbonTooltipPopoverWrapper {
        width: 100%;
      }
    }
    :global {
      .cds--popover-container {
        width: 100%;
      }
    }
  }

  .linkEntityIcon {
    margin-right: 0.25rem;
  }

  .pluginIcon {
    margin-right: 0.5rem;
  }

  .childWrapper {
    .ellipsis();
  }

  .innerWrapper {
    width: 100%;
    display: inline-flex;
    align-items: center;
  }
}

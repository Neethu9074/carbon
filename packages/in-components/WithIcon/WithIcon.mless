@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    // this is required for making the contained label ellipsis correctly
    min-width: 0;

    & + .wrapper {
      margin-left: 0.5rem;
    }
  }

  .pluginIcon,
  .linkEntityIcon {
    fill: @lib__colors__N700Medium;
  }

  .linkEntityIcon {
    margin-right: 0.25rem;
  }

  .pluginIcon {
    margin-right: 0.5rem;
  }

  .specialIndicator {
    position: absolute;
    left: -6px;
    height: 6px;
    width: 6px;
    background-color: @lib__colors__orange800;
    border-radius: 50%;
    display: inline-block;
  }

  .childWrapper {
    width: 100%;
    .ellipsis();
  }
}

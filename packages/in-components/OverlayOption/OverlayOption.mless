@import '~in-themes/active.less';

:local {
  .option {
    font-weight: 600;
    font-size: 0.75rem;
    padding: 0.4rem 0.8rem;
  }

  .align-center {
    justify-content: center;
  }

  .align-left {
    justify-content: flex-start;
  }

  .disabled {
    cursor: not-allowed;

    &:hover,
    &:focus {
      outline: 1px var(--ids-color-option-neutral-700) dotted;
      background: unset;
    }

    & * {
      color: var(--ids-color-option-neutral-500) !important;
      svg {
        fill: var(--ids-color-option-neutral-500) !important;
      }
    }
  }
}

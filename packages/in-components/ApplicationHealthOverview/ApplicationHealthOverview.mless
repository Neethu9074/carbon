:local {
  .container {
    display: flex;
    flex-direction: column;
    flex: 1;
    max-height: calc(100% - 3rem);
  }

  .content {
    flex: 1;
    overflow: auto;
  }

  .pagination {
    > div {
      padding-bottom: 0em;
    }
  }
  .paginationSmallWidth {
    :global(.cds--pagination__left) {
      display: none;
    }
    :global(.cds--pagination__right) {
      width: inherit;
    }
  }

  .disabledHealthIndicator {
    pointer-events: none;
    line-height: 0;
  }

  .healthIndicator {
    line-height: 0;
  }
}

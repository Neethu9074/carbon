:local {
  .healthBar {
    height: 1rem;
    display: flex;
    border-radius: 1rem;
  }

  .critical {
    background-color: var(--ids-color-option-red-500);
  }

  .warning {
    background-color: var(--ids-color-option-yellow-500);
  }

  .healthy {
    background-color: var(--ids-color-option-green-500);
  }

  .label {
    font-size: 0.75rem;
  }
}

@import '~in-themes/active.less';

:local {
  .dropdownButton {
    justify-content: space-between;
  }

  .dropdownButtonIndicator {
    margin: -0.25rem 0 -0.25rem 0.5rem;
  }

  .icon-xl {
    margin: -0.25rem 0 -0.25rem 0.5rem;
  }

  .icon-compact {
    margin: -0.25rem -0.3rem -0.25rem 0.5rem;
  }
}

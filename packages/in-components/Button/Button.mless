@import '~in-themes/active.less';

:local {

  .button {
    color: black;
    font-family: @font-family-sans-serif;
    font-weight: bold;
    text-decoration: none;
    text-align: center;
    border: 0;
    border-radius: 0.188rem;
    cursor: pointer;
    display: inline-block;

    transition: background 0.25s ease-in-out, color 0.25s ease-in-out;

    &:hover, &:focus {
      text-decoration: none;
    }

    & + .button {
      margin-left: 0.5rem;
    }
  }

  .default {
    .buttonStyle(
      // bg
      #9fffff,
      // hover bg
      darken(#9fffff, 20%),
      // font
      black,
      // hover font
      black,
      // outlined color
      #06b7ba,
      // outlined hovercolor
      #1b7071);
  }

  .secondary {
    .buttonStyle(
      // bg
      #92a5ae,
      // hover bg
      #6b8088,
      // font
      #fff,
      // hover font
      #fff,
      // outlined color
      #92a5ae,
      // outlined hovercolor
      #6b8088);
  }

  .danger {
    .buttonStyle(
      // bg
      #d9534f,
      // hover bg
      #c9302c,
      // font
      #fff,
      // hover font
      #fff,
      // outlined color
      #d43f3a,
      // outlined hovercolor
      #ac2925);
  }

  .warning {
    .buttonStyle(
      // bg
      #ffde00,
      // hover bg
      #e6c700,
      // font
      #1e3036,
      // hover font
      #1e3036,
      // outlined color
      #ffc107,
      // outlined hovercolor
      #d39e00);
  }

  .primary {
    .buttonStyle(
      // bg
      #337ab7,
      // hover bg
      #286090,
      // font
      #fff,
      // hover font
      #fff,
      // outlined color
      #2e6da4,
      // outlined hovercolor
      #204d74);
  }

  .info {
    .buttonStyle(
      // bg
      #5bc0de,
      // hover bg
      #31b0d5,
      // font
      #fff,
      // hover font
      #fff,
      // outlined color
      #46b8da,
      // outlined hovercolor
      #269abc);
  }

  .success {
    .buttonStyle(
      // bg
      #5cb85c,
      // hover bg
      #449d44,
      // font
      #fff,
      // hover font
      #fff,
      // outlined color
      #4cae4c,
      // outlined hovercolor
      #398439);
  }

  .lg {
    padding: 0.625rem 0.938rem;
    font-size: 0.688rem;
  }

  .sm {
    padding: 0.375rem 0.625rem;
    font-size: 0.625rem;
  }

  .xs {
    padding: 0.188rem 0.313rem;
    font-size: 0.563rem;
  }

  .disabled {
    cursor: not-allowed;
    opacity: 0.6;
    outline: 0;
  }
}


.buttonStyle(@bg, @hoverBg, @font, @hoverFont, @borderOutline, @borderHoverOutline) {
  &, &.disabled:hover {
    background: @bg;
    color: @font;
  }

  &:hover {
    color: @hoverFont;
    background: @hoverBg;
  }

  &.outlineOnly {
    &, &.disabled, &.disabled:hover {
      background: transparent;
      border: 1px solid @borderOutline;
      color: @borderOutline;
    }

    &:hover {
      background: transparent;
      border: 1px solid @borderHoverOutline;
      color: @borderHoverOutline;
    }
  }
}

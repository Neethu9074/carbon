:local {
  .base {
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    :global(.cds--radio-button__label) {
      white-space: nowrap;
    }
    border-right: 1px solid var(--cds-button-separator);
  }
  .advanced {
    border-right: none;
    padding: 0.75rem 1rem 0.5rem 1rem;
  }
}

:local {
  .chart {
    position: relative;
    width: 100%;

    & + .chart {
      margin-top: 1rem;
    }
  }

  .chartAxisWrapper {
    position: relative;
    display: flex;
    align-items: flex-start;
  }

  .canvas {
    display: block;
    max-width: 100%;
  }

  .markerLanesWrapper {
    position: relative;
    height: 100%;
  }

  .tableModal {
    z-index: var(--ids-z-index-option-overlays);
    :global(.cds--modal-content) {
      padding-left: 0px;
      padding-right: 0px;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .chart {
    position: relative;
    width: 100%;

    & + .chart {
      margin-top: 1rem;
    }
  }

  .chartAxisWrapper {
    position: relative;
    display: flex;
    align-items: flex-start;
  }

  .canvas {
    display: block;
    max-width: 100%;
  }

  .markerLanesWrapper {
    position: relative;
    height: 100%;
  }
}

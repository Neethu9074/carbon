@import '~in-themes/active.less';

:local {
  .chart {
    position: relative;
    width: 100%;

    margin: 0 0 1rem 0;
  }

  .chartAxisWrapper {
    position: relative;
    display: flex;
    align-items: flex-start;
  }

  .canvas {
    display: block;
    max-width: 100%;
  }

  .markerLanesWrapper {
    position: relative;
    height: 100%;
  }
}

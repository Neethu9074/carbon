:local {
  .wrapper {
    width: 100%;
  }

  .chart {
    position: relative;
    width: fit-content;
  }

  .canvas,
  .timeAxisCanvas {
    display: block;
  }

  .timeAxisCanvas {
    height: 3.125rem;
  }

  .chartAxisWrapper {
    position: relative;
    display: flex;
    align-items: flex-start;
  }
}

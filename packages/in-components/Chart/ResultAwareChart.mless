:local {
  .loadingBarContainer {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: left;
    justify-content: flex-start;
  }

  .skeletonWrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-around;
  }

  .legendSkeleton {
    margin-top: 0;
    display: block;
    width: 20%;
    height: 1rem;
  }

  .chartSkeleton {
    margin-top: 1.375rem;
    display: block;
    width: 100%;
    height: 100%;
  }

  .pieSkeleton {
    display: block;
    border-radius: var(--ids-border-radius-round);
    padding: 1rem;
    margin: 0 auto;
  }
  .liveModeIcon {
    padding: 0;
  }
  .disabledChart {
    background-color: var(--ids-color-option-neutral-50);
  }
}

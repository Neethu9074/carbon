@import '~in-themes/active.less';

:local {
  .stateWrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    height: 100%;
  }

  .progressText {
    font-size: 1.125rem;
    padding-bottom: 0.5rem;
  }

  .loadingBarContainer {
    width: 15rem;
    height: 0.625rem;
    margin: 1rem 0 0.5rem;
  }

  .horizontalIndicator {
    height: 0.5rem;
    border-radius: 0.3125rem;
  }
}

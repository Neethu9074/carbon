@import '~in-themes/active.less';

:local {
  .contextMenu {
    position: absolute;
    top: 2rem;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    background: @lib__colors__white;
    color: @lib__colors__N800Dark;
    border-radius: @lib__shapes__radius_large;

    box-shadow: @lib__shadows__subtle;
    border: 1px solid rgba(0, 0, 0, 0.16);
  }

  .leftAligned {
    left: 100%;
  }

  .rightAligned {
    right: 0;
  }

  .button {
    justify-content: flex-start;

    width: 100%;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;

    border: none;
    background: @lib__colors__white;
    border-radius: 0;

    & + .button {
      margin-left: 0;
    }

    &:hover {
      border: none;
    }
  }

  .contextMenuActionsButtonsWrapper {
    position: absolute;
    top: -1.75rem;
    width: 4.25rem;

    display: flex;
  }

  .contextMenuOpenButtonIcon {
    margin: -0.5rem;
  }
}

:local {
  .tooltip {
    position: absolute;
    top: 1.5rem;
    bottom: 1.875rem;
    left: 3.125rem;
    right: 3.125rem;
    z-index: 1;
  }

  .glassPane {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;

    margin-left: -1px;
    border-left: 1px solid red;
  }

  .content {
    margin-left: 5px;
  }

  .leftAlignedContent {
    margin-left: ~'calc(-100% - 5px)';
  }
}

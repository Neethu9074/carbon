:local {
  .tooltip {
    position: absolute;
    bottom: 0;
    left: 3rem;
    right: 3rem;
  }

  .top {
    top: 1.5rem;
  }

  .bottom {
    top: 0;
  }

  .glassPane {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 1.5625rem;

    margin-left: -1px;
    border-left: 1px solid red;
  }

  .content {
    margin-left: 5px;
  }

  .leftAlignedContent {
    margin-left: ~'calc(-100% - 5px)';
  }
}

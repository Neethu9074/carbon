@import '~in-themes/active.less';

:local {
  .tooltip {
    position: absolute;
    top: 0;
    bottom: 1.875rem;
    left: 3.125rem;
    right: 3.125rem;

    // position above remaining chart content.
    z-index: 1;

    font-size: 0.875rem;
  }

  .glassPane {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;

    margin-left: -1px;
    border-left: 1px solid rgba(0,0,0,0.24);
  }

  .rightAlignedContent {
    position: absolute;
    left: 1rem;
  }

  .leftAlignedContent {
    position: absolute;
    right: ~'calc(100% + 1rem)';
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-width: 12rem;
    color: @lib__colors__N800Dark;
    font-size: 0.875rem;
  }

  .labelWrapper {
    display: flex;
    align-items: center;
  }

  .dot {
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }

  .aggregation {
    color: @lib__colors__N600Light;
    text-transform: lowercase;
    margin-left: 0.25rem;
  }

  .value {
    margin-left: 2rem;
    font-weight: bold;
    color: @lib__colors__N900Primary;
  }
}

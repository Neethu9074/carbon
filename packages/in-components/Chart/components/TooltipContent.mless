:local {
  .tooltipContent {
    width: 13rem;
    padding: 0.25rem 0.438rem;
    background: #21282e;
    border-radius: 0.188rem;
    font-size: 0.688rem;
    color: #6b8088;
  }

  .heading {
    display: flex;
    justify-content: space-between;

    width: 100%;
    margin-bottom: 0.25rem;

    color: #dfdfdf;
    border-bottom: 1px solid #525252;
    padding-bottom: 0.1875rem;
  }

  .rollupLabel {
    color: #6b8088;
  }

  .aggregation {
    color: #6b8088;
    text-transform: lowercase;
    font-weight: bold;
  }

  .tooltipMetricList {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .spacer {
    width: 100%;
    border-top: 1px dashed #525252;
  }

  .metricValue {
    display: flex;
    justify-content: space-between;
    padding: 0.125rem 0;
    margin: 0 0.125rem;
    font-weight: bold;
  }
}

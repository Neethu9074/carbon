@import '~in-themes/active.less';

:local {
  .tooltipContent {
    width: 18rem;
    padding: 1rem 1rem 0.5rem;
    background: @lib__colors__white;
    color: @lib__colors__N800Dark;
    border-radius: @lib__shapes__radius_large;
    box-shadow: @lib__shadows__subtle;
  }

  .heading {
    display: flex;

    width: 100%;
    margin-bottom: 1rem;
  }

  .rollupLabel {
    color: @lib__colors__N600Light;
    margin-left: 0.25rem;
  }

  .spacer {
    width: 100%;
    border-top: 1px dashed @lib__colors__N600Light;
    margin-bottom: 0.5rem;
  }

  .tooltipMetricList {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .metricValue {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.5rem;
  }

  .entry {
    display: flex;
    align-items: center;

    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dot,
  .rect {
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
  }

  .dot {
    border-radius: 50%;
  }

  .aggregation {
    color: @lib__colors__N600Light;
    text-transform: lowercase;
    margin-left: 0.25rem;
  }

  .value {
    font-weight: bold;
    color: @lib__colors__N900Primary;
  }
}

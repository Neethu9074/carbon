@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .tooltipContent {
    max-width: 18rem;
    padding: 1rem 1rem 0.5rem;
    background: @lib__colors__white;
    color: @lib__colors__N800Dark;
    border-radius: @lib__shapes__radius_large;

    box-shadow: @lib__shadows__subtle;
    border: 1px solid rgba(0, 0, 0, 0.16);
  }

  .heading {
    display: flex;

    width: 100%;
    margin-bottom: 1rem;

    font-size: 0.75rem;
    .ellipsis();
  }

  .rollupLabel {
    color: @lib__colors__N600Light;
    margin-left: 0.25rem;
  }

  .tooltipMetricList {
    list-style: none;
    margin: 0;
    padding: 0;

    & + .tooltipMetricList {
      border-top: 1px dashed @lib__colors__N600Light;
      margin-top: 0.5rem;
      padding-top: 0.8rem;
    }
  }

  .metricValue {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.5rem;

    .ellipsis();
  }

  .entry {
    display: flex;
    align-items: center;

    .ellipsis();
  }

  .label {
    .ellipsis();
  }

  .dot,
  .rect {
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
  }

  .dot {
    border-radius: 50%;
  }

  .aggregation {
    color: @lib__colors__N600Light;
    text-transform: lowercase;
    margin-left: 0.25rem;
  }

  .value {
    margin-left: 1rem;
    font-weight: bold;
    color: @lib__colors__N900Primary;
  }

  .infoSection {
    .flexbox();
    white-space: nowrap;
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
    font-weight: 600;
    border-top: 1px solid @lib__colors__N300;
    padding-top: 0.25rem;
  }

  .infoIcon {
    margin-right: 0.25rem;
    margin-left: -0.125rem;
    fill: @lib__colors__N600Light;
  }
}

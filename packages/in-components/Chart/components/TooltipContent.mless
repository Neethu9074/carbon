:local {
  .tooltipContent {
    display: flex;
    flex-direction: column;

    background: var(--ids-color-option-white);
    color: var(--ids-color-option-neutral-800);
    border-radius: var(--ids-border-radius-option-large);
    font-size: 0.75rem;
    box-shadow: var(--ids-shadow-option-subtle);
    border: 1px solid var(--ids-color-option-neutral-300);
  }

  .header,
  .footer {
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
    width: 100%;
    padding: 0 0.5rem;
    line-height: 2;
    background: var(--ids-color-option-neutral-200);
  }

  .header {
    border-bottom: var(--ids-color-option-neutral-300);
    border-top-left-radius: var(--ids-border-radius-option-large);
    border-top-right-radius: var(--ids-border-radius-option-large);
  }

  .footer {
    border-top: 1px solid var(--ids-color-option-neutral-300);
    border-bottom-left-radius: var(--ids-border-radius-option-large);
    border-bottom-right-radius: var(--ids-border-radius-option-large);
  }

  .footer {
    color: var(--ids-color-option-neutral-600);
  }

  .key {
    fill: var(--ids-color-option-neutral-600);
    background: var(--ids-color-option-white);
    border: 1px solid var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-option-small);
    margin: 0 0.25rem;

    & + .key {
      margin-left: 0;
    }
  }

  .dataSeries {
    overflow: hidden;
    padding: 0.2rem 0.5rem;

    // the scrollbar requires relative positioning
    position: relative;
  }

  .scrollBar {
    position: absolute;
    top: 0;
    right: 0;
    width: 0.3rem;
    background: var(--ids-color-option-neutral-500);
    border-radius: var(--ids-border-radius-option-medium);
    display: none;
  }

  .rollupLabel {
    color: var(--ids-color-option-neutral-600);
    margin-left: 0.25rem;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;

    & + .entries {
      border-top: 1px dashed var(--ids-color-option-neutral-300);
      margin-top: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  .entry {
    display: flex;
    align-items: baseline;
    line-height: 1.5;
    padding-bottom: 0.25rem;

    &:last-child {
      padding-bottom: 0;
    }
  }

  .dot,
  .rect {
    min-width: 0.75rem;
    min-height: 0.75rem;
    flex-shrink: 0;
    margin-right: 0.25rem;

    // Manually tweaking the alignment because we cannot rely on baseline alignment
    position: relative;
    top: 0.0938rem;
  }

  .dot {
    border-radius: var(--ids-border-radius-option-round);
  }

  .label {
    width: 100%;
    min-width: 3.25rem;
    overflow: hidden;
    overflow-wrap: break-word;
  }

  .labelBlank {
    width: 100%;
    min-width: 3.25rem;
    overflow: hidden;
    overflow-wrap: break-word;
    font-style: italic;
  }

  .timeShift {
    color: var(--ids-color-option-neutral-600);
    text-transform: lowercase;
    white-space: nowrap;
  }

  .value {
    flex-shrink: 0;
    margin-left: 0.15rem;
    font-weight: bold;
    color: var(--ids-color-option-neutral-900);
  }

  .companionValue {
    flex-shrink: 0;
    font-size: x-small;
    color: var(--ids-color-option-neutral-600);
    text-align: right;
  }

  .aggregation {
    flex-shrink: 0;
    min-width: 0.75rem;
    margin-left: 0.25rem;
    text-align: right;
  }

  .aggregationIcon {
    // Manually tweaking the alignment because we cannot rely on baseline alignment
    position: relative;
    top: 2px;
  }
}

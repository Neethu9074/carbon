@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .legend {
    display: flex;
    justify-content: space-between;

    width: 100%;
    height: 1rem;
    line-height: 1rem;
    font-size: 0.875rem;
    overflow: hidden;
  }

  .expandedLegend {
    // position above .overlay
    z-index: 3;
    background: white;
    position: absolute;
    width: 100%;
    margin-left: -1rem;
    margin-right: -1rem;
    padding: 0rem 1rem;
    width: calc(100% + 2rem);
    padding-bottom: 1rem;
    height: auto;
    transition: padding-bottom linear 0.2s;
  }

  .metricList {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    overflow: hidden;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .metric {
    display: flex;
    align-items: center;

    margin-right: 1rem;

    &:last-child {
      margin-right: 0;
    }
  }

  .disabledMetric {
    color: rgb(156, 156, 156);
  }

  .toggleable {
    cursor: pointer;
    line-height: 1rem;
    max-width: 100%;
  }

  .dot {
    max-width: 0.75rem;
    max-height: 0.75rem;
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }

  .disabledDot {
    background: none !important;
    border: 2px solid @lib__colors__N400;
  }

  .disabledIcon {
    fill: @lib__colors__N400 !important;
  }

  .timeShift {
    fill: @lib__colors__N700Medium;
    margin: 0 0 0 0.2rem;
  }

  .overlay {
    position: absolute;
    bottom: -1rem;
    background: @lib__colors__N900Primary;
    opacity: 0.4;
    top: 0;
    left: -1rem;
    right: -1rem;
    // position below .expandedLegend and above the ChartOverlay component
    z-index: 2;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
  }

  .arrowIcon {
    cursor: pointer;
    transition: all linear 0.2s;
    outline: none;
    margin-top: -0.25rem;
  }

  .iconUp {
    transform: rotate(180deg);
  }

  .legendContainer {
    height: 1rem;
  }

  .legendLabel {
    .ellipsis();
  }
}

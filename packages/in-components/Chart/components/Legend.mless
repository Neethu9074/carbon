:local {
  .legend {
    display: flex;
    justify-content: space-between;

    width: 100%;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }

  .metricList {
    display: flex;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .metric {
    display: flex;
    align-items: center;

    padding: 0.125rem 0;
    margin-right: 1rem;
    cursor: pointer;
  }

  .disabledMetric {
    color: rgb(156, 156, 156);
  }

  .dot {
    max-width: 0.75rem;
    max-height: 0.75rem;
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }

  .disabledDot {
    background: #ccc !important;
  }
}

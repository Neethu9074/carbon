@import '~in-themes/active.less';

:local {
  .legend {
    display: flex;
    justify-content: space-between;

    width: 100%;
    min-height: 2rem;
    height: auto;
    font-size: 0.875rem;
  }

  .metricList {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .metric {
    display: flex;
    align-items: center;

    margin-right: 1rem;

    &:last-child {
      margin-right: 0;
    }
  }

  .disabledMetric {
    color: rgb(156, 156, 156);
  }

  .toggleable {
    cursor: pointer;
  }

  .dot {
    max-width: 0.75rem;
    max-height: 0.75rem;
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }

  .disabledDot {
    background: none !important;
    border: 2px solid @lib__colors__N400;
  }

  .disabledIcon {
    fill: @lib__colors__N400 !important;
  }

  .timeShift {
    fill: @lib__colors__N700Medium;
    margin: 0 0 0 0.2rem;
  }
}

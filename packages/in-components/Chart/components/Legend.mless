:local {
  .legend {
    display: flex;
    justify-content: space-between;

    width: 100%;
  }

  .top {
    margin-bottom: 0.8rem;
  }
  .bottom {
    margin-top: 0.8rem;
  }

  .metricList {
    display: flex;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .metric {
    display: flex;
    align-items: center;

    padding: 0.125rem 0.25rem;
    margin: 0 0.125rem;
    cursor: pointer;

    font-weight: 500;
  }

  .disabledMetric {
    color: rgb(156, 156, 156);
  }

  .dot {
    width: 0.4375rem;
    height: 0.4375rem;
    margin-right: 0.25rem;
    border-radius: 50%;
  }

  .disabledDot {
    background: #ccc !important;
  }
}

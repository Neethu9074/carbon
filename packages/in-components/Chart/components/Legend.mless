:local {
  .legend {
    display: flex;
    justify-content: space-between;

    width: 100%;
    margin-bottom: 0.75rem;
    height: 2rem;
    font-size: 0.875rem;
  }

  .metricList {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;

    height: 2rem;
    margin: 0;
    padding: 0;

    list-style: none;
  }

  .metric {
    display: flex;
    align-items: center;

    margin-right: 1rem;
    cursor: pointer;

    &:last-child {
      margin-right: 0;
    }
  }

  .disabledMetric {
    color: rgb(156, 156, 156);
  }

  .dot {
    max-width: 0.75rem;
    max-height: 0.75rem;
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }

  .disabledDot {
    background: #ccc !important;
  }
}

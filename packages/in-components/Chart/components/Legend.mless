:local {
  .legend {
    display: flex;
    justify-content: space-between;

    width: 100%;

    margin-bottom: 0.25rem;
  }

  .metricList {
    display: flex;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .metric {
    padding: 0.125rem 0.25rem;
    margin: 0 0.125rem;
    font-weight: bold;
    cursor: pointer;
  }
}

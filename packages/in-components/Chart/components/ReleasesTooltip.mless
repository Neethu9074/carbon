@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .rightAlignedContent {
    position: absolute;
    left: 1px;
  }

  .leftAlignedContent {
    position: absolute;
    right: ~'calc(100% + 1px)';
  }

  .marker {
    width: 0;
    position: absolute;
    height: 100%;
    transition: all 0.5s;
  }

  .markerLine {
    width: 0;
    position: absolute;
    border-left: 2px dashed @lib__colors__N500;
    top: -8px;
    left: 0px;
    bottom: 0;
    z-index: 1;
  }

  .markerOffsetLine {
    width: 0;
    position: absolute;
    border-left: 2px dashed @lib__colors__white;
    top: -7px;
    left: 0.5px;
    bottom: 0;
  }

  .markerIcon {
    position: absolute;
    top: -32px;
    left: -12px;
  }

  .markerIconForeground {
    fill: @lib__colors__N500;
  }

  .markerIconBackground {
    fill: @lib__colors__N050;
  }

  .tooltipContent {
    max-width: 300px;
    padding: 1rem 1rem 0.5rem;
    background: @lib__colors__white;
    color: @lib__colors__N800Dark;
    border-radius: @lib__shapes__radius_large;

    box-shadow: @lib__shadows__subtle;
    border: 1px solid rgba(0, 0, 0, 0.16);
  }

  .heading {
    display: flex;

    width: 100%;
    margin-bottom: 1rem;

    font-size: 0.75rem;
    font-weight: normal;
    .ellipsis();
  }

  .subHeading {
    font-size: 0.875rem;
    font-weight: normal;
  }

  .timeCount {
    color: @lib__colors__N600Light;
  }

  .tooltipIcon {
    fill: @lib__colors__N500;
  }

  .subContent {
    display: flex;
    font-size: 0.75rem;
    font-weight: normal;
    align-items: center;
  }

  .releaseName {
    .ellipsis();
  }

  .onForegroundLayer {
    z-index: 1;
  }

  .onBaseLayer {
    z-index: auto;
  }
}

@import '~in-themes/active.less';

:local {
  .overlay {
    position: absolute;
    top: 22px;
    bottom: 30px;
    left: 0;
    right: 0;

    // above remaining chart content
    z-index: 1;

    font-size: 0.875rem;
  }

  .glassPane {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;

    cursor: pointer;
  }

  .glassPaneNonInteractive {
    cursor: default;
  }
}

@import '~in-themes/active.less';

:local {
  .eventDurationIndicatorWrapper {
    --height: 6px;

    position: absolute;
    left: 0;
    right: 0;
    height: var(--height);
    background: transparent;

    overflow-x: hidden;
  }

  .eventDuration {
    position: absolute;
    height: 2px;
    width: 100%;
    background: currentColor;
    top: calc(50% - 1px);
  }

  .startIndicator {
    position: absolute;
    height: var(--height);
    width: var(--height);
    margin-left: calc((var(--height) / 2) * -1);
    border-radius: @lib__shapes__radius_round;
    background: currentColor;
  }

  .endIndicator {
    position: absolute;
    height: 100%;
    width: 2px;
    margin-left: -2px;
    background: currentColor;
  }

  .triggeringTimeIndicator {
    position: absolute;
    width: 0;
    height: 0;
    border-top: calc(var(--height) / 2) solid transparent;
    border-left: var(--height) solid currentColor;
    border-bottom: calc(var(--height) / 2) solid transparent;
  }
}

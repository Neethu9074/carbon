:local {
  .sectionTitle {
    font-size: 0.75rem;
    margin-bottom: 1rem;
  }

  .list {
    max-height: 21rem;
    overflow-y: auto;

    :global(.li-link) {
      display: block;
    }
  }

  .listItem {
    line-height: 1.25rem;
    justify-content: initial;
  }
}

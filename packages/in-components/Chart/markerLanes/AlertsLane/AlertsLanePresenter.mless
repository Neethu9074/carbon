@import '~in-themes/active.less';

:local {
  .sectionTitle {
    font-size: 0.75rem;
    margin-bottom: 1rem;
  }

  .list {
    max-height: 21rem;
    overflow-y: auto;
  }

  .listItem {
    line-height: 1.25rem;
    justify-content: initial;
  }
}

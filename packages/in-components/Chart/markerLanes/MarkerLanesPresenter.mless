@import '~in-themes/active.less';

:local {
  .markerLanesContainer {
    position: relative;
    padding: 0.5rem 0;
  }

  .markerLanesWrapper {
    position: relative;

    > div:nth-child(even) {
      background-color: @lib__colors__N050;
    }
  }

  .left,
  .right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 25%;
  }

  .left {
    left: 0;
  }

  .right {
    right: 0;
  }

  .hoverLine {
    position: absolute;
    background: currentColor;
    width: 1px;
    opacity: 0.5;
    pointer-events: none;
  }
}

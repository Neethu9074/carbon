@import '~in-themes/active.less';

:local {
  .markerLanesContainer {
    padding: 0.5rem 0 0 0;
  }

  .markerLanesWrapper {
    > div:nth-of-type(even) {
      background-color: @lib__colors__N050;
    }
  }

  .left,
  .right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 25%;
  }

  .left {
    left: 0;
  }

  .right {
    right: 0;
  }
}

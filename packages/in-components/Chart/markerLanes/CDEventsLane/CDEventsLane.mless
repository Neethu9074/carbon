:local {
  .tooltipContent {
    line-height: 1.25rem;
    width: max-content;
    font-weight: 300;
  }

  .withBottomBorder {
    padding-bottom: 0.5rem;
    border-bottom: solid 1px var(--ids-color-option-neutral-500);
  }

  .withTopPadding {
    padding-top: 0.5rem;
  }

  .name {
    font-weight: normal;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .laneItem {
    position: absolute;
    top: 0;
    bottom: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 1px;

    &:hover:before {
      content: '';
      position: absolute;
      width: calc(var(--lane-height) - 0.25rem);
      height: calc(var(--lane-height) - 0.25rem);
      border-radius: @lib__shapes__radius_round;
      background: @lib__colors__N600Light;
      opacity: 0.3;
    }
  }
}

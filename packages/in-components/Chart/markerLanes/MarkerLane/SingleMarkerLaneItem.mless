@import '~in-themes/mixins.less';

:local {
  .laneItem {
    position: absolute;
    top: 0;
    bottom: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 1px;

    &:not(.hideHoverEffect):hover:before {
      content: '';
      position: absolute;
      width: calc(var(--lane-height) - 0.25rem);
      height: calc(var(--lane-height) - 0.25rem);
      border-radius: var(--ids-border-radius-option-round);

      box-shadow: inset 0 0 0 calc(var(--lane-height) - 0.25rem) rgba(99, 114, 130, 0.3); // var(--ids-color-option-neutral-600) ;
      pointer-events: none;
    }
  }
}

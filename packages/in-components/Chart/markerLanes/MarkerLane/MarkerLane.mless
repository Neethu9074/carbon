@import '~in-themes/active.less';

:local {
  .lane {
    --lane-height: 1.5rem;

    position: relative;
    height: var(--lane-height);
    line-height: var(--lane-height);
    overflow: hidden;
  }

  .lanePostChart {
    border-bottom: 1px @lib__colors__N300 solid;
  }

  .laneLabel {
    position: absolute;
    user-select: none;
    cursor: default;
  }

  .laneLabelText {
    color: @lib__colors__N600Light;
    background: rgba(253, 253, 253, 0.8);
  }

  .hoverAreaContainer {
    display: block;
  }

  .loadingIndicatorContainer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
  }
}

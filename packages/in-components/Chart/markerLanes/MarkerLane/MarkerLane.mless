@import '~in-themes/mixins.less';

:local {
  .lane {
    --lane-height: 1.5rem;

    position: relative;
    height: var(--lane-height);
    line-height: var(--lane-height);
    overflow: hidden;
  }

  .lanePostChart {
    border-bottom: 1px @lib__colors__N300 solid;
  }

  .laneLabel {
    position: absolute;
    user-select: none;
    cursor: default;
  }

  .laneLabelText {
    color: @lib__colors__N600Light;
    background: rgba(253, 253, 253, 0.8);
  }

  .laneError {
    background: var(--colors-transparent);
    display: flex;
    justify-content: center;
  }

  .laneErrorIconText {
    color: @lib__colors__N600Light;
    display: flex;
    align-items: center;
    max-width: 100%;
  }

  .laneErrorIconTextWrapper {
    width: 100%;
  }

  .laneErrorIcon {
    flex: 0;
    margin-right: 0.25rem;
  }

  .laneErrorLabelText {
    flex-shrink: 1;
    .ellipsis();
  }

  .tryAgain {
    // override button's size, and (smaller) font as in marker lanes
    font-size: inherit;
    padding: 0.25rem 0.5rem;
    background: var(--colors-transparent);
  }

  .hoverAreaContainer {
    display: block;
  }

  .loadingIndicatorContainer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
  }
}

@import '~in-themes/active.less';

:local {
  .lane {
    --lane-height: 1.5rem;

    position: relative;
    height: var(--lane-height);
    line-height: var(--lane-height);
    overflow: hidden;

    border-bottom: 1px @lib__colors__N300 solid;
  }

  .laneLabel {
    position: absolute;
    user-select: none;
    cursor: default;
  }

  .laneLabelText {
    color: @lib__colors__N600Light;
    background: rgba(253, 253, 253, 0.5);
  }

  .marker {
    position: relative;
    top: 0;
    bottom: 0;
    padding: 4px;
  }
}

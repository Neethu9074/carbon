@import '~in-themes/active.less';

:local {
  .lane {
    --lane-height: 1.5rem;

    position: relative;
    height: var(--lane-height);
    line-height: var(--lane-height);
    overflow: hidden;

    border-bottom: 1px @lib__colors__N300 solid;
  }

  .laneLabel {
    position: absolute;
    user-select: none;
    cursor: default;
    z-index: 2;
  }

  .laneLabelText {
    color: @lib__colors__N600Light;
    background: rgba(253, 253, 253, 0.5);
  }

  .laneItem {
    position: absolute;
    top: 0;
    bottom: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 1px;
    z-index: 1;

    &:hover:before {
      content: '';
      position: absolute;
      width: calc(var(--lane-height) - 0.25rem);
      height: calc(var(--lane-height) - 0.25rem);
      border-radius: @lib__shapes__radius_round;
      background: @lib__colors__N600Light;
      opacity: 0.3;
    }
  }

  .marker {
    position: relative;
    top: 0;
    bottom: 0;
    padding: 4px;
  }
}

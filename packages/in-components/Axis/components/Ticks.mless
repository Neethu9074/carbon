@import '~in-themes/active.less';

:local {
  .ticks {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
  }

  .verticalTickLabel,
  .horizontalTickLabel {
    position: absolute;
    white-space: nowrap;
    font-size: 0.6875rem;
  }

  .verticalTickLabel {
    color: var(--ids-color-option-neutral-700);
  }

  .horizontalTickLabel {
    display: flex;
    flex-direction: column;
    align-items: center;

    margin-left: -18px;
    color: var(--ids-color-option-neutral-600);
    width: 3.5rem;
  }

  .horizontalTickFirstLabel {
    margin-bottom: 3px;
  }

  .verticalTick,
  .horizontalTick {
    position: absolute;
    background: var(--ids-color-option-neutral-400);
  }

  .verticalTick {
    height: 1px;
  }

  .horizontalTick {
    width: 1px;
  }
}

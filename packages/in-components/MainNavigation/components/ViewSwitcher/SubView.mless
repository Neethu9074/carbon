@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .subView {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.5rem;
  }

  .link {
    display: flex;

    width: ~'calc(100% - 1rem)';
    padding: 0 0 0 3.5rem;
    line-height: 3rem;
    margin: 0 0.5rem;

    border: 0;
    font-size: 0.875rem;
    color: var(--ids-color-option-neutral-400) !important;
    background: transparent;
    user-select: none;
    cursor: pointer;
    .ellipsis();

    &:hover {
      background: var(--ids-color-option-neutral-700);
      color: white !important;
      text-decoration: none;
    }
  }

  .activeLink {
    color: white !important;
    background: var(--ids-color-option-blue-500);

    &:hover {
      background: var(--ids-color-option-blue-500);
    }
  }

  .label {
    color: var(--ids-color-option-neutral-400) !important;
  }
}

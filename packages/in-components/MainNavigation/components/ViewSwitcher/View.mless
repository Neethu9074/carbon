@import '~in-themes/mixins.less';

:local {
  @hover-color: rgba(246, 193, 193, 0.23);
  @border: 0.1875rem solid var(--ids-color-option-blue-500);

  .view {
    position: relative;
    margin: 0.25rem 0;
  }

  .collapsed,
  .collapsedActive,
  .collapsedActiveWithChildren {
    .wrapper {
      width: ~'calc(100% - 1.5rem)';
      margin: 0 0.75rem;
      border-radius: var(--ids-border-radius-option-round);
    }
  }

  .collapsedActive {
    svg {
      margin: 0 0.5rem 0 0.3125rem;
    }
  }

  .collapsed,
  .collapsedActive {
    .link {
      padding: 0.5rem 0.5rem;
    }
  }

  .collapsedActive,
  .activeSidebarExpanded {
    .icon {
      fill: white;
    }
  }

  .activeSidebarExpanded {
    .wrapper {
      background: var(--ids-color-option-blue-500);
      &:hover {
        background: var(--ids-color-option-blue-500);
      }
    }
    .label {
      color: white;
      font-weight: bold;
    }
  }

  .activeSidebarExpanded,
  .collapsedActive {
    &:hover {
      .icon {
        fill: white;
      }
    }
  }

  .collapsedActive {
    .wrapper {
      border: @border;
      padding: 0;
    }
    .link {
      padding: 0.3125rem 0rem;
    }
    &:hover {
      .wrapper {
        background: none;
      }
    }
  }

  .collapsedActiveWithChildren {
    svg {
      margin: 0 0.5rem 0 0.3125rem;
    }
    .wrapper {
      width: ~'calc(100% - 1.5rem)';
      margin: 0 0.75rem;
      padding: 0;

      background: var(--ids-color-option-blue-500);

      border: @border;
      border-radius: var(--ids-border-radius-option-round) var(--ids-border-radius-option-round)
        var(--ids-border-radius-option-large) var(--ids-border-radius-option-round);

      &:hover {
        background: var(--ids-color-option-blue-500);
        border: @border;
      }

      .link {
        position: relative;
        padding: 0.3125rem 0;

        &::before {
          position: absolute;
          top: 0px;
          height: 2.625rem;
          width: 2.625rem;
          background: var(--ids-color-option-navy-900);
          border-radius: var(--ids-border-radius-option-round);
          z-index: 0;
          content: '';
        }
      }

      .icon {
        z-index: 1;
      }
    }
  }

  .expanded {
    background: var(--ids-color-option-neutral-800);

    .wrapper {
      background: var(--ids-color-option-neutral-800);
      &:hover {
        background: var(--ids-color-option-neutral-700);
      }
    }

    .expandIcon {
      &:hover {
        background: var(--ids-color-option-neutral-600);
      }
    }
  }

  .wrapper,
  .link {
    display: flex;
    align-items: center;
  }

  .wrapper {
    justify-content: space-between;

    width: ~'calc(100% - 1rem)';
    margin: 0 0.5rem;

    border-radius: 0;
    transition: border-radius 0.25s ease-in-out;
    cursor: pointer;

    &:hover {
      background: @hover-color;

      .expandIcon {
        fill: white;
      }
    }
  }

  .link {
    width: 100%;
    padding: 0.5rem 0.75rem;
    user-select: none;
    &:hover {
      text-decoration: none;
    }
    &:focus:not(:focus-visible) {
      outline: none;
    }
  }

  .icon {
    fill: var(--ids-color-option-neutral-400);
    margin-right: 0.75rem;
  }

  .label {
    color: var(--ids-color-option-neutral-400);
    font-size: 0.875rem;
    max-width: 10.25rem;
    margin-right: 0.5rem;
    .ellipsis();
  }

  .expandIcon {
    padding: 0.5rem;
    fill: var(--ids-color-option-neutral-400);

    &:hover {
      background: var(--ids-color-option-neutral-700);
      border-radius: var(--ids-border-radius-option-round);
    }
  }
}

:local {
  .profileMenu {
    padding: 1rem 0;

    &_label {
      color: var(--cds-text-secondary);
    }

    &_header {
      padding: 0rem 1rem;
    }

    &_unitTenantSection {
      padding: 0rem 1rem;
    }

    &_teamFocusSection {
      padding: 0rem 1rem;
    }

    &_switcherDivider {
      inline-size: calc(100% - 2rem);
    }
  }
}

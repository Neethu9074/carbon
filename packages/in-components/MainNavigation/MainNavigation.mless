@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .carbonUIShell {
    .print(none);
  }

  .navigation,
  .background {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;

    .print();
  }

  .backPlane {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
  }

  .navigation {
    width: @main-navigation-width;
    transition: width 0.2s ease-in-out;

    padding: 1.0625rem 0 4rem 0;

    background: var(--ids-color-option-navy-900);
    box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.24);

    overflow: hidden;
    z-index: var(--ids-z-index-option-main-navigation);
  }

  .expandedNavigation {
    width: 17.5rem;
    overflow-y: auto;
  }

  .background {
    right: 0;

    background: rgba(216, 216, 216, 0.5);
    z-index: var(--ids-z-index-option-main-navigation-background);
  }
}

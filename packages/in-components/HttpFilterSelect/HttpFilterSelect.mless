:local {
  .filterGroup {

    line-height: 1.25rem;

    & > * {
      vertical-align: middle;
    }

    &:not(:first-child) {
      margin-left: 2rem;
    }

    & span:first-child {
      font-weight: bold;
      margin-right: .5rem;
    }
  }

  .selectWrapper {
    display: inline-block;

    & > div:first-child {
      min-width: 20rem;
    }
  }
}

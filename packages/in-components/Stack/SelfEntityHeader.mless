:local {
  .entity {
    display: flex;
    align-items: center;

    padding: 0.375rem 1rem;
    width: 100%;

    background: var(--ids-color-option-neutral-700);
    border-bottom: 1px solid var(--ids-color-option-neutral-400);
    cursor: pointer;

    &:hover {
      background: var(--ids-color-option-neutral-500);
    }
  }

  .icon {
    fill: var(--ids-color-option-white);
    margin-right: 0.5rem;
  }

  .label {
    color: var(--ids-color-option-white);
  }
}

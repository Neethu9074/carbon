:local {
  .searchInputWrapper {
    padding: 0.5rem;
    background: var(--ids-color-option-neutral-50);
  }

  .searchInput {
    background: #fff;
  }

  .overlay {
    width: 26rem;
    @height: 20rem;
    min-height: @height;
    height: @height;
    max-height: @height;

    border-radius: var(--ids-border-radius-option-medium);
  }

  .option {
    justify-content: space-between;
    font-weight: normal;
    height: 3rem;
  }

  .disabled {
    font-weight: normal;
    height: 3rem;
    color: grey;
  }
  .paginationSmallWidth {
    :global(.cds--pagination__left) {
      display: none;
    }
    :global(.cds--pagination__right) {
      width: inherit;
    }
  }
}

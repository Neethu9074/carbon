@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    padding: 0 1rem 0;
  }

  .label {
    color: var(--ids-color-option-neutral-600);
    margin-bottom: 0.125rem;
    font-weight: 600;
  }
  .select {
    border: 0;
    background: transparent;
    color: var(--ids-color-option-neutral-600);
  }
}

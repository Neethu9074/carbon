:local {
  .icon {
    margin-left: 0.25rem;
    fill: var(--ids-color-option-neutral-600);
  }

  .itemWrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .entityWrapper {
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .chartWrapper {
    display: flex;
    align-items: center;
  }

  .chartItemWrapper {
    padding-left: 1rem;
  }

  .severity {
    width: 8px;
    height: 8px;
    border-radius: 100%;
  }

  .severityBad {
    background-color: var(--ids-color-option-red-500);
  }

  .dot {
    margin-right: 0.25rem;
    width: 8px;
    height: 8px;
  }
}

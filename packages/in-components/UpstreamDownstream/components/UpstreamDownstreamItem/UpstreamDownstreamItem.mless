@import '~in-themes/active.less';

:local {
  .icon {
    margin-left: 0.25rem;
    fill: @lib__colors__N600Light;
  }

  .itemWrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .entityWrapper {
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .chartWrapper {
    display: flex;
    align-items: center;
  }

  .chartItemWrapper {
    width: 11rem;
    padding-left: 1rem;
  }

  .severity {
    width: 8px;
    height: 8px;
    border-radius: 100%;
  }

  .severityBad {
    background-color: @lib__colors__failure;
  }

  .dot {
    margin-right: 0.25rem;
    width: 8px;
    height: 8px;
  }
}

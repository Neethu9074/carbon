:local {
  .pane {
    max-height: 60vh;
    overflow-y: scroll;
    width: 50rem;
  }

  .emptyPane {
    align-items: center;
    display: flex;
    flex-direction: column;
    width: 50rem;
    height: 60vh;
    justify-content: center;
  }

  .emptyMessage {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 0.25rem;
  }
}

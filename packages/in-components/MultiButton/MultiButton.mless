:local {
  .icon {
    fill: var(--ids-color-option-white);
    margin: -0.25rem 0 -0.25rem 0.25rem;
  }

  .buttonWrapper {
    display: flex;
    flex-direction: column;
  }

  .integrationButton {
    padding-right: 2rem;
    border-radius: 0;
    justify-content: flex-start;

    & + .integrationButton {
      margin-left: 0;
    }
  }
}

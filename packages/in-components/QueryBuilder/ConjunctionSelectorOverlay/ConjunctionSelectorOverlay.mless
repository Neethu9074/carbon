:local {
  .list {
    max-width: 6rem;
  }

  .paranthesis {
    display: flex;

    & > * {
      width: 100%;
      border-left: 1px solid var(--ids-color-option-neutral-400);
      border-top: 1px solid var(--ids-color-option-neutral-400);

      &:first-child {
        border-left: 0;
      }
    }
  }

  .clear {
    font-weight: 500;
    justify-content: space-between;
    color: var(--ids-color-option-neutral-600);

    svg {
      fill: var(--ids-color-option-neutral-600);
    }
  }
}

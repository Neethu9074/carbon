@import '~in-themes/mixins.less';

:local {
  .apiQuery {
    max-width: 30rem;
  }

  .header {
    justify-content: space-between;
    min-width: 30rem;
    padding: 1rem 1.5rem;
  }

  .content {
    max-height: 15rem;
    overflow: auto;
  }

  .toggleWrapper {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    height: 2rem;
    line-height: 1.5rem;
    padding: 0.5rem 0.75rem;
  }

  .toggleWrapperText {
    max-width: 50%;
    margin-left: 0.5rem;
    line-height: 1.5rem;
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-500);
    .ellipsis();
  }
}

:global {
  :local(.content) .language-json .token.property {
    color: var(--ids-color-option-pink-500);
  }
}

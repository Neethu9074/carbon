@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    flex-direction: column;
    width: max-content;
    padding: 8px 0;
  }

  .topTextWithTooltip {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: start;
    height: 2rem;
  }

  .topText {
    padding: 0 1rem 0 0;
    margin: 0;
  }

  .adjustmentIcon {
    fill: @lib__colors__N500;
  }

  .bottomText {
    padding: 0;
    height: 1rem;
  }
}

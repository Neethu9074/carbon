:local {
  .name {
    padding: 0.0225rem 0.3125rem;
    margin-top: -0.25rem;
    margin-bottom: -0.25rem;
    border-right: 1px solid var(--ids-color-option-neutral-300);
    border-bottom: none;
    border-top: none;
    line-height: 2;

    font-weight: 600;

    color: var(--query-builder-element-color);

    &:focus,
    &:active,
    &:hover {
      outline: none;
      color: var(--ids-color-option-blue-400);

      .icon {
        fill: var(--ids-color-option-blue-400);
      }
    }
  }

  .wrapper {
    position: relative;
    margin-right: 1rem;
    height: 0.5625rem;
  }

  .icon {
    // The icon's size triggers a very weird flexbox behavior for its parent element.
    // Work around this behavior by positioning this one absolutely to its wrapper.
    position: absolute;
    top: -0.245rem;
    left: 0;

    fill: var(--ids-color-option-neutral-700);
    cursor: pointer;

    &:hover,
    &:active,
    &:focus {
      fill: var(--ids-color-option-blue-400);
      outline: none;
    }
  }
}

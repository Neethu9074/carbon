@import '~in-themes/active.less';

:local {
  .icon {
    padding-top: 0.0225rem;
    padding-bottom: 0.0225rem;
    border-left: 1px solid @lib__colors__N400;
    border-bottom: none;
    border-top: none;
    line-height: 2;
    cursor: pointer;

    fill: @lib__colors__N400;
    cursor: pointer;

    &:hover,
    &:active,
    &:focus {
      fill: var(--ids-color-option-blue-400);
      border-color: var(--ids-color-option-blue-400);
      outline: none;
    }
  }

  // to avoid having two borders next to each other
  .nextToBooleanSelector {
    border-left: none;

    &:hover,
    &:active,
    &:focus {
      margin-left: -1px;
      border-left: 1px solid var(--ids-color-option-blue-400);
    }
  }
}

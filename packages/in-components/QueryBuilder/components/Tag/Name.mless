@import '~in-themes/active.less';

:local {
  .name {
    margin-right: 0.25rem;
    font-weight: 600;

    color: var(--query-builder-element-color);

    border: 0;
    background: none;
    padding: 0 0.25rem 0 0.1875rem;
    border: 1px solid transparent;
    border-radius: var(--ids-border-radius-medium);
    cursor: pointer;

    &:focus,
    &:active,
    &:hover {
      outline: none;
      color: var(--ids-color-option-blue-400);

      .icon {
        fill: var(--ids-color-option-blue-400);
      }
    }
  }

  .icon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem;

    fill: var(--ids-color-option-neutral-400);
  }
}

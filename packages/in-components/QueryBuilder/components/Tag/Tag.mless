@import '~in-themes/active.less';

:local {
  .tag,
  .tag_dark {
    display: inline-flex;
    align-items: center;

    max-height: 1.6875rem;

    padding: 0.1875rem 0rem 0.1875rem 0.25rem;

    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: @lib__shapes__radius_medium;
    font-weight: 500;
    // Ensure that all tags have the same height. No matter whether they render
    // an input field or not!
    line-height: 1.6;
    cursor: pointer;

    &:focus,
    &:active,
    &:hover {
      outline: 0;
      border-color: var(--ids-color-option-blue-400);
    }
  }

  .tag {
    background: var(--ids-color-option-neutral-50);
    white-space: nowrap;
    &:focus,
    &:active,
    &:hover {
      background: var(--ids-color-option-neutral-200);
    }
  }

  // Hide invalid marker when already editing the tag filter.
  .invalid:not(:focus-within):not(:focus) {
    border-color: var(--ids-color-option-red-500);
  }

  .tag_dark {
    background: var(--ids-color-option-neutral-900);
    &:focus,
    &:active,
    &:hover {
      background: var(--ids-color-option-neutral-700);
    }
  }

  .booleanPlaceholder {
    line-height: 20px;
    font-weight: 600;
  }
}

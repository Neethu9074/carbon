@import '~in-themes/mixins.less';

:local {
  .inputValueViewer,
  .inputValueViewer_disablehover,
  .inputValueViewer_dark {
    max-width: 7.5rem;
    padding: 0.0225rem 0.3125rem;
    line-height: 2;

    &:focus,
    &:active,
    &:hover {
      outline: 0;
      color: var(--ids-color-option-blue-400);
    }
    .ellipsis();
  }

  .inputValueViewer_disablehover,
  .inputValueViewerBackground_disablehover {
    cursor: not-allowed;
    max-width: 7.5rem;
    padding: 0.0225rem 0.3125rem;
    line-height: 2;
    color: var(--query-builder-element-color);
    font-weight: 600;
    background: var(--colors-gray-100);

    &:focus,
    &:active,
    &:hover {
      outline: 0;
      color: var(--query-builder-element-color);
    }
    .ellipsis();
  }

  .inputValueViewerBackground {
    background: var(--ids-color-option-white);
  }

  .inputValueViewerBackground_dark {
    background: var(--ids-color-option-neutral-800);
  }
}

@import '~in-themes/active.less';

:local {
  .booleanValue {
    padding: 0.0225rem 0.3125rem;
    margin-top: -0.25rem;
    margin-bottom: -0.25rem;
    border-right: 1px solid var(--ids-color-option-neutral-300);
    border-bottom: none;
    border-top: none;
    line-height: 2;

    cursor: pointer;

    &:hover {
      color: var(--ids-color-option-neutral-600);
      outline: none;
      background: var(--ids-color-option-neutral-200);
      border-bottom: 1px solid;
      border-top: 1px solid;
      border-left: 1px solid;
      margin-left: -1px;
      border-color: var(--ids-color-option-blue-400);
    }

    .booleanValue {
      background: var(--ids-color-option-neutral-50);
      color: var(--ids-color-option-neutral-900);
    }

    &:focus,
    &:active {
      outline: none;
      background: var(--ids-color-option-neutral-200);
      border-bottom: 1px solid;
      border-top: 1px solid;
      border-left: 1px solid;
      margin-left: -1px;
      border-color: var(--ids-color-option-blue-400);
    }
  }
}

@import '~in-themes/active.less';

:local {
  .draggableWrapper {
    display: inline-block;
  }

  .bracket,
  .bracket_dark {
    display: inline;

    padding: 0.3rem;

    color: var(--ids-color-option-green-500);
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: @lib__shapes__radius_medium;
    font-weight: 500;
    line-height: @lib__typography__line-height;
    cursor: pointer;

    &:focus,
    &:active,
    &:hover {
      outline: 0;
      background: var(--ids-color-option-neutral-200);
      border-color: var(--ids-color-option-blue-400);
    }
  }

  .bracket {
    background: var(--ids-color-option-neutral-50);
  }

  .bracket_dark {
    background: var(--ids-color-option-neutral-900);
  }

  .invalid {
    background: @lib__colors__failure10;
    color: var(--ids-color-option-red-500);
    border: 1px solid var(--ids-color-option-red-500);
  }
}

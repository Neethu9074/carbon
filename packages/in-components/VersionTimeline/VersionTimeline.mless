:local {
  .view {
    position: relative;
    padding-top: 3rem;
    width: 100%;
  }

  .version,
  .gap {
    position: absolute;
    bottom: 50%;

    min-height: 1rem;
    min-width: 1px;
  }

  .version {
    background: var(--ids-color-option-blue-400);
    cursor: pointer;

    &:hover {
      background: var(--ids-color-option-indigo-500);
    }
  }

  .selected {
    background: var(--ids-color-option-deep-purple-500);

    &:hover {
      background: var(--ids-color-option-indigo-500);
    }
  }

  .even {
    bottom: ~'calc(50% + 0.5rem)';
  }

  .gap {
    min-height: 2rem;
    background: #ff404044;
  }

  .header {
    margin-bottom: 1rem;
  }

  .time {
    font-weight: bold;
  }
}

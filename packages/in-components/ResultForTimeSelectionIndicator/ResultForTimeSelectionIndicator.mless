@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;

    background: var(--ids-color-option-neutral-100);
    padding: 0.5rem 1rem;
  }

  .notificationWrapper {
    display: flex;
    align-items: center;

    color: var(--ids-color-option-neutral-600);
  }

  .icon {
    margin: 0 0.5rem 0 -0.25rem;

    fill: var(--ids-color-option-neutral-800);
  }
}

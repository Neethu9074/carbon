@import '~in-themes/active.less';

:local {
  .noLink {
    cursor: not-allowed;
    color: @lib__colors__N500;
  }

  .analyzeButton {
    margin-right: 0.5rem;
  }

  .italic {
    font-style: italic;
  }

  .logLevelPill {
    min-width: 3.125rem;
  }

  .logLevelPillCell {
    span {
      display: grid;
      place-items: center;
    }
  }

  .headCell {
    white-space: nowrap;
  }
}

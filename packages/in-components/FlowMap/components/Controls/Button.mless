@import '~in-themes/active.less';

:local {
  .button {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    background: @lib__colors__N300;
    cursor: pointer;

    &:hover {
      background: @lib__colors__N400;
    }
  }

  .enabledButton {
    background: @lib__colors__light-blue800;
    color: #fff;

    &:hover {
      background: #178cc7;
    }
  }

  .icon {
    fill: #fff;
  }
}

:local {
  .endpointsServiceWrapper {
    display: flex;
    flex-direction: column;
  }

  .header {
    display: flex;
    align-items: center;
    height: 1.625rem;
    margin: 0 0.75rem;
  }

  .pluginIcon {
    margin-right: 0.75rem;
  }

  .entityLink {
    font-size: 0.875rem;
    max-width: 12rem;
  }

  .tooltipContent {
    width: 15.625rem;
    background: white;
  }
}

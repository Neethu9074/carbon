:local {
  .mediumContent {
    display: flex;
    flex-direction: column;
  }

  .spacer {
    height: 0.3125rem;
  }

  .header {
    display: flex;
    align-items: center;
    height: 2.625rem;
    margin-left: 0.75rem;
  }

  .pluginIcon {
    margin-right: 0.25rem;
  }

  .entityLink {
    font-size: 0.875rem;
    max-width: 12rem;
  }

  .line {
    width: 100%;
    border-bottom: 1px solid #e8eef0;
    margin: 0.5rem 0;
  }

  .metrics {
    margin: 0.375rem 1rem;
  }
}

:local {
  .children {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;

    display: flex;
    flex-direction: column;

    list-style: none;
    margin: 0;
    padding: 0;

    background: white;
  }

  .child {
    position: relative;
    width: 100%;
    padding: 0.25rem 0.5rem;

    border-top: 1px dashed #e8eef0;
    font-weight: 200;

    &:first-child {
      border-top: 1px solid #e8eef0;
    }
  }

  .entityLink {
    font-size: 0.875rem;
    max-width: 12rem;
  }
}

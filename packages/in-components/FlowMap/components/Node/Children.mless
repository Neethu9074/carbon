:local {
  .children {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;

    display: flex;
    flex-direction: column;

    list-style: none;
    margin: 0;
    padding: 0;

    background: white;
  }

  .child {
    padding: 0.25rem 0.5rem;
    border-top: 1px solid black;

    // &:first-child {
    //   border-top: 0;
    // }
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 15.625rem;
    height: 2rem;
    padding: 0 0.5rem;

    background: white;
    border-radius: 3px;
  }

  .loadingIcon,
  .errorIcon {
    margin-left: 0.5rem;
  }

  .loadingIcon {
    fill: @lib__colors__primary2;
  }

  .errorIcon {
    fill: @lib__colors__failure;
  }

  .totalReminaingNodesLabel {
    color: @lib__colors__N500;
    margin-left: 0.5rem;
  }
}

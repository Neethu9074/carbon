:local {
  .wrapper {
    position: absolute;
  }

  .node {
    position: absolute;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding: 0.25rem 0.5rem 0.25rem 0.75rem;
    background: white;
    font-weight: 500;
    border-radius: 3px;
    border: 1px solid transparent;
    border-left: 4px solid #479bcc;

    &:hover {
      box-shadow: 0px 0px 5px 0px rgba(0, 0, 0, 0.2);
    }
  }

  .selected {
    border: 1px solid #1fb7b9;
    border-left: 4px solid #1fb7b9;
  }

  .sm {
    left: -23px;
    top: -12px;
    width: 46px;
    height: 24px;
  }

  .mid {
    left: -90px;
    top: -25px;
    width: 180px;
    height: 50px;
  }

  .lg {
    left: -125px;
    top: -50px;
    width: 250px;
    height: 100px;
  }

  .line {
    display: flex;
    align-items: center;
  }

  .pluginIcon {
    margin-right: 0.5rem;
  }

  .expandIcon {
    padding: 0.25rem;
    margin-left: 0.25rem;
    cursor: pointer;

    &:hover {
      fill: #479bcc;
    }
  }

  .expandButtonRight,
  .expandButtonLeft {
    position: absolute;
    top: ~'calc(50% - 10px)';

    display: flex;
    align-items: center;
    justify-content: center;

    width: 20px;
    height: 20px;
    background: #1fb7b9;
    border-radius: 50%;

    cursor: pointer;

    &:hover {
      background: #5bdee0;
    }
  }

  .expandButtonRight {
    right: -10px;
  }

  .expandButtonLeft {
    left: -12px;
  }
}

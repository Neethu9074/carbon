:local {
  .node {
    position: absolute;

    display: flex;
    flex-direction: column;
    justify-content: center;

    font-weight: 500;
    border-radius: 3px;
    box-shadow: 0px 0px 0.875rem 0px rgba(0, 0, 0, 0.1);

    border: 1px solid transparent;
  }

  .selected {
    border: 1px solid #1fb7b9;
  }

  .rootLabel {
    position: absolute;
    top: -0.8125rem;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 5.3125rem;
    height: 0.8125rem;

    background: #1fb7b9;
    color: white;
    font-size: 0.625rem;
    font-weight: 300;
    border-radius: 0.25rem 0.25rem 0 0;
    left: ~'calc(50% - 5.3125rem / 2)';
  }
}

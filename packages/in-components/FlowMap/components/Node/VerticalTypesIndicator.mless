:local {
  .verticalTypesIndicator {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .typeIndicator {
    width: 0.25rem;
    flex-grow: 1;

    &:first-child {
      border-top-left-radius: 0.1875rem;
    }

    &:last-child {
      border-bottom-left-radius: 0.1875rem;
    }
  }
}

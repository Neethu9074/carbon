:local {
  .expandButtonRight,
  .expandButtonLeft {
    position: absolute;
    top: ~'calc(50% - 11px)';

    display: flex;
    align-items: center;
    justify-content: center;

    width: 1.375rem;
    height: 1.375rem;
    background: #1fb7b9;
    border-radius: 50%;

    cursor: pointer;

    &:hover {
      background: #5bdee0;
    }
  }

  .expandButtonRight {
    right: -1.5625rem;
  }

  .expandButtonLeft {
    left: -1.5625rem;
  }

  .errorneousExpandIcon {
    background: #ff4229;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    position: relative;

    width: 100%;
    height: 100%;
    background: @lib__colors__N050;
    overflow: hidden;
  }

  .canvas {
    display: block;
    width: 100%;
  }

  .overlay {
    position: absolute;

    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }
}

:local {
  .wrapper {
    position: relative;

    width: 100%;
    height: 100%;
    background: #f1f6f9;
    overflow: hidden;
  }

  .canvas {
    display: block;
    width: 100%;
  }

  .overlay {
    position: absolute;

    top: 0;
    left: 0;
    right: 0;
    bottom: 0;

    border: 1px solid rgb(203, 217, 226);
  }
}

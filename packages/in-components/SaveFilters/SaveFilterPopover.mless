:local {
  .saveFilterPopoverContainer {
    width: 18rem;
    padding: 0.75rem;
    box-sizing: border-box;
  }

  .buttonWrapper {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;

    button {
      flex: 1;
    }
  }
  .textInputContainer {
    position: relative;
  }
  .characterCounter {
    position: absolute;
    right: 0;
  }
}

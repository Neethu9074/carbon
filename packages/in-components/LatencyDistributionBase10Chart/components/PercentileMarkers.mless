@import './shared.less';

:local {
  .wrapperContainer {
    position: absolute;
    top: 0;
  }

  .percentiles {
    position: absolute;
    top: 0;
    left: 50%;
    overflow: visible;
    padding: 0;
    font-size: 0.6875rem;
    border: 0.05rem solid @lib__colors__N500;
    border-radius: 3px;
    padding: 0.05rem 0.1rem;
    background-color: @lib__colors__white;
    opacity: 1;
    white-space: nowrap;
    user-select: none;
  }

  .dottedLine {
    position: absolute;
    top: 0;
    border-left: 1px dashed @lib__colors__N500;
  }
}

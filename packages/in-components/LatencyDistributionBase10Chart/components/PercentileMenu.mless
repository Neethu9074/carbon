:local {
  .list {
    margin: 0;
    padding: 0;
  }

  .item {
    display: flex;
    align-items: center;

    width: 5rem;
    padding: 0.2rem;
    border-bottom: 1px solid var(--ids-color-option-neutral-300);

    list-style: none;

    &:last-child {
      border-bottom: 0;
    }

    &.child {
      margin-left: 1rem;
    }
  }

  .percentileButton {
    position: absolute;
    right: 0;
    height: 2rem;
  }
}

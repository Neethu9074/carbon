@import './shared.less';
@import '~in-themes/mixins.less';

:local {
  .tooltipContent {
    position: absolute;
    z-index: @z-index__tooltipContent;
    transform: translate(0, 100%);
    display: flex;
    flex-direction: column;
    min-width: 12rem;
    max-width: 20rem;

    background: var(--ids-color-option-white);
    color: var(--ids-color-option-neutral-800);
    border-radius: var(--ids-border-radius-large);
    font-size: 0.75rem;
    box-shadow: var(--ids-shadow-option-subtle);
    border: 1px solid var(--ids-color-option-neutral-300);
  }

  .header {
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
    width: 100%;
    padding: 0 0.5rem;
    line-height: 2;
    background: var(--ids-color-option-neutral-200);
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    border-top-left-radius: var(--ids-border-radius-large);
    border-top-right-radius: var(--ids-border-radius-large);
  }

  .entries {
    padding: 0.2rem 0.5rem;
    margin: 0;
    list-style: none;
  }

  .entry {
    display: flex;
    align-items: center;
    line-height: 1.75;
  }

  .dot {
    min-width: 0.75rem;
    min-height: 0.75rem;
    flex-shrink: 0;
    margin-right: 0.25rem;
    border-radius: var(--ids-border-radius-round);
  }

  .label {
    width: 100%;
    .ellipsis();
  }

  .timeShift {
    color: var(--ids-color-option-neutral-600);
    text-transform: lowercase;
  }

  .aggregation {
    .flexbox();
    flex-shrink: 0;
    margin-left: 0.5rem;
    text-align: right;
  }

  .value {
    flex-shrink: 0;
    margin-left: 0.25rem;
    font-weight: bold;
    color: var(--ids-color-option-neutral-900);
  }
}

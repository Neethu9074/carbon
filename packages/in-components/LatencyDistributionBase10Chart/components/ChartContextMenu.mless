@import './shared.less';

:local {
  .contextMenu {
    position: absolute;
    top: 2rem;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    background: @lib__colors__white;
    color: @lib__colors__N800Dark;
    border-radius: @lib__shapes__radius_large;

    box-shadow: @lib__shadows__subtle;
    border: 1px solid rgba(0, 0, 0, 0.16);
  }

  .rightAligned {
    right: 0;
  }

  .buttonWrapper {
    & + .buttonWrapper {
      margin-left: 0.5rem;
    }
  }

  .button {
    justify-content: flex-start;

    width: 100%;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;

    border: none;
    background: @lib__colors__white;
    border-radius: 0;

    & + .button {
      margin-left: 0;
    }

    &:hover {
      border: none;
    }
  }

  .contextMenuActionsButtonsWrapper {
    position: absolute;
    display: flex;
    top: -1px;
    transform: translate(-100%, 4px);
    width: auto;
    height: 26px;
    z-index: @z-index__contextMenuActionsButtonsWrapper;
  }

  .contextMenuOpenButtonIcon {
    margin: -0.5rem;
  }
}

@import './components/shared.less';

:local {
  .container {
    display: block;
    position: relative;
    margin-bottom: 2rem;
  }

  .lines {
    position: absolute;
    top: 0;
    left: 0;
  }

  .horizontalLine {
    position: relative;
    border-top: 1px solid @lib__colors__N600Light;
    opacity: 0.2;
    z-index: @z-index__horizontalLine;
  }

  .header {
    position: relative;
    height: 2rem;
  }

  .percentileButton {
    position: absolute;
    display: flex;
    justify-content: space-between;
    right: 0;
    height: 2rem;
  }
}

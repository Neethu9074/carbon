@import './components/shared.less';

:local {
  .container {
    display: block;
    position: relative;
    margin-bottom: 2rem;
  }

  .lines {
    position: absolute;
    top: 0;
    left: 0;
  }

  .horizontalLine {
    position: relative;
    border-top: 1px solid var(--ids-color-option-neutral-600);
    opacity: 0.2;
    z-index: @z-index__horizontalLine;
  }

  .header {
    position: relative;
    height: 2rem;
  }

  .titleWrapper {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }

  .title {
    font-weight: 600;
    text-transform: capitalize;
  }

  .aggregation {
    text-transform: lowercase;
  }
}

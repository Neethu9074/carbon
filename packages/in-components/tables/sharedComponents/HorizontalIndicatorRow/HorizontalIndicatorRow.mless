@import '~in-themes/active.less';

:local {
  .tr {
    padding: 0;

    &:first-child .indicator {
      // the indicator may not use any vertical space
      left: 0;
      right: 0;
      position: absolute;
    }

    &:last-child .td {
      border-bottom-left-radius: @lib__shapes__radius_small;
      border-bottom-right-radius: @lib__shapes__radius_small;
      overflow: hidden;
    }
  }

  .td {
    padding: 0;
    position: relative;
  }

  .indicator {
    position: static;
    width: 100%;
  }

  .hiddenTr {
    display: none;
  }
}

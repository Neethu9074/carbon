:local {
  .tr {
    padding: 0;

    &:first-child .indicator {
      // the indicator may not use any vertical space
      left: 0;
      right: 0;
      position: absolute;
    }

    &:last-child .td {
      border-bottom-left-radius: 4px;
      border-bottom-right-radius: 4px;
      overflow: hidden;
    }
  }

  .td {
    padding: 0;
    position: relative;
  }

  .indicator {
    position: static;
    width: 100%;
  }

  .hiddenTr {
    display: none;
  }
}

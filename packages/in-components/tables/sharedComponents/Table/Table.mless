@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .table {
    width: 100%;
    background: #fff;
    border-radius: @lib__shapes__radius_small;
    border-collapse: initial;
  }

  .fixedLayout {
    table-layout: fixed;
  }

  .tableInCard {
    border-radius: 0;
    box-shadow: none;
    border: 0;
  }

  .tr {
    color: @lib__colors__N900Primary;
    font-size: 0.875rem;
    background: #fff;

    &:nth-child(even) {
      background: @lib__colors__N050;
    }

    &.depth-2 {
      & > td:first-child {
        padding-left: 54px;
      }
    }

    &.active > .td {
      background: #eff5f9;
    }

    &.dull {
      opacity: 0.5;
    }

    &.selected:nth-child(even) {
      background: @lib__colors__table-row-selected-even;
    }

    &.selected:nth-child(odd) {
      background: @lib__colors__table-row-selected-odd;
    }
  }

  .trClickable:hover {
    background: @lib__colors__faded-blue800 !important;
    cursor: pointer;
  }

  .trRegular {
    @padding: 1.125rem;

    & > .td,
    & > .th {
      padding-top: @padding;
      padding-bottom: @padding;
    }
  }

  .trCompact {
    @padding: 0.75rem;

    & > .td,
    & > .th {
      padding-top: @padding;
      padding-bottom: @padding;
    }
  }

  .trMinimal {
    @padding: 0;

    & > .td,
    & > .th {
      padding: @padding;
      padding-left: 1rem;
    }
  }

  .th {
    color: @lib__colors__N700Medium;
    font-size: 0.75rem;
    font-weight: normal;
    padding: 0.8125rem 0;
    background: #fff;
    padding-left: 1rem;
    padding-right: 1rem;
    border-top: 1px solid @lib__colors__N400;
    border-bottom: 1px solid @lib__colors__N400;

    &:first-child {
      border-left: 1px solid @lib__colors__N400;
    }

    &:last-child {
      border-right: 1px solid @lib__colors__N400;
    }

    &:hover {
      color: @lib__colors__N800Dark;
    }

    &.noWrap {
      white-space: nowrap;
    }
  }

  .td {
    position: relative;
    border-bottom: 1px solid @lib__colors__N300;

    padding-left: 1rem;
    padding-right: 1rem;

    &:first-child {
      border-left: 1px solid @lib__colors__N300;
    }
    &:last-child {
      border-right: 1px solid @lib__colors__N300;
    }

    &.noWrap {
      white-space: nowrap;
    }

    &.ellipsis {
      .ellipsis();
    }

    &.active {
      font-weight: bold;
    }
  }

  .erroneousRowTh,
  .erroneousRowTd {
    max-width: 3.75rem;
    padding-right: 0;

    & + .th,
    & + .td {
      padding-left: 0.8rem;
    }
  }

  .erroneousRowIcon {
    // Chrome cannot center align the exclamation mark when it is located in certain contexts
    display: inline;
    padding: 0 6px;
    border-radius: 50%;
    background: #ff5d3b;
    color: white;
    font-size: 0.75rem;
    text-align: center;
  }

  .severityIndicatorCellContentWrapperIndicator {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
  }
}

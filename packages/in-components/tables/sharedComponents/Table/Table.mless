:local {
  .table {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e8eef0;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    border-radius: 4px;
    border-collapse: initial;
  }

  .tableInCard {
    border-radius: 0;
    box-shadow: none;
    border: 0;
  }

  .tr {
    color: #16363e;
    font-size: 0.875rem;
    font-weight: 400;
    background: #fff;

    &:first-child td {
      border-top: 0;
    }

    &:nth-child(even) {
      background: #fafbfc;
    }

    &:hover {
      background: #eff5f6;
    }

    &.depth-2 {
      & > td:first-child {
        padding-left: 54px;
      }
    }
  }

  .th {
    font-weight: 300;
    color: #698189;
    text-transform: uppercase;
    font-size: 0.75rem;
    padding: 0.625rem 0;
    background: #fff;
    border-bottom: 1px solid #d2dfe4;

    &:first-child {
      padding-left: 1rem;
    }
  }

  .td {
    border-top: 1px solid #e4ebed;
    padding: 0.75rem 0;

    &:first-child {
      padding-left: 1rem;
    }

    .tr:first-child > .tr {
      border-top: 0;
    }

    .tr:last-child > .td {
      border-bottom: 1px solid #e4ebed;
    }
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .table {
    width: 100%;
    background: #fff;
    border-radius: @lib__shapes__radius_small;
    border-collapse: initial;
  }

  .tableInCard {
    border-radius: 0;
    box-shadow: none;
    border: 0;
  }

  .tr {
    color: @lib__colors__N900Primary;
    font-size: 0.875rem;
    background: #fff;

    &:first-child td {
      border-top: 0;
    }

    &:nth-child(even) {
      background: @lib__colors__N050;
    }

    &:hover {
      background: #2483b314;
    }

    &.depth-2 {
      & > td:first-child {
        padding-left: 54px;
      }
    }

    &.active > .td {
      background: #EFF5F9;
    }

    &.dull {
      opacity: 0.5;
    }
  }

  .trRegular {
    @padding: 1.25rem;

    & > .td, & > .th {
      padding-top: @padding;
      padding-bottom: @padding;
    }

    & > .td > .severityIndicatorCellContentWrapper > .severityIndicatorCellContentWrapperIndicator {
      top: @padding * -1px;
      bottom: @padding * -1px;
    }
  }

  .trCompact {
    @padding: 0.75rem;

    & > .td, & > .th {
      padding-top: @padding;
      padding-bottom: @padding;
    }

    & > .td > .severityIndicatorCellContentWrapper > .severityIndicatorCellContentWrapperIndicator {
      top: @padding * -1px;
      bottom: @padding * -1px;
    }
  }

  .th {
    color: @lib__colors__N700Medium;
    font-size: 0.75rem;
    font-weight: normal;
    padding: 0.8125rem 0;
    background: #fff;
    border-bottom: 1px solid @lib__colors__N400;
    padding-left: 1rem;
    padding-right: 1rem;

    &:hover {
      color: @lib__colors__N800Dark;
    }

    &.noWrap {
      white-space: nowrap;
    }
  }

  .td {
    border-top: 1px solid @lib__colors__N200;

    padding-left: 1rem;
    padding-right: 1rem;

    .tr:first-child > .tr {
      border-top: 0;
    }

    &.noWrap {
      white-space: nowrap;
    }

    &.ellipsis {
      .ellipsis();
    }

    &.active {
      font-weight: bold;
    }
  }

  .erroneousRowTh, .erroneousRowTd {
    padding-right: 0;

    & + .th, & + .td {
      padding-left: 0.8rem;
    }
  }

  .erroneousRowIcon {
    // Chrome cannot center align the exclamation mark when it is located in certain contexts
    display: inline;
    padding: 0 6px;
    border-radius: 50%;
    background: #ff5d3b;
    color: white;
    font-size: .75rem;
    text-align: center;
  }

  .severityIndicatorCellContentWrapper {
    position: relative;
  }

  .severityIndicatorCellContentWrapperIndicator {
    position: absolute;
    left: -1rem;
    width: 2px;
  }
}

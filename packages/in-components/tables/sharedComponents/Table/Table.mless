@import '~in-themes/active.less';

:local {
  .table {
    width: 100%;
    background: #fff;
    border-radius: @lib__shapes__radius_small;
    border-collapse: initial;
  }

  .tableInCard {
    border-radius: 0;
    box-shadow: none;
    border: 0;
  }

  .tr {
    color: @lib__colors__N900Primary;
    font-size: 0.875rem;
    background: #fff;

    &:first-child td {
      border-top: 0;
    }

    &:nth-child(even) {
      background: @lib__colors__N050;
    }

    &:hover {
      background: @lib__colors__N100;
    }

    &.depth-2 {
      & > td:first-child {
        padding-left: 54px;
      }
    }
  }

  .trRegular {
    height: 3.5rem;
  }

  .trCompcat {
    height: 2.5rem;
  }

  .th {
    color: @lib__colors__N700Medium;
    text-transform: capitalize;
    font-size: 0.75rem;
    font-weight: normal;
    padding: 0.8125rem 0;
    background: #fff;
    border-bottom: 1px solid @lib__colors__N400;

    &:first-child {
      padding-left: 1rem;
    }

    &:hover {
      color: @lib__colors__N800Dark;
    }
  }

  .td {
    border-top: 1px solid @lib__colors__N200;

    &:first-child {
      padding-left: 1rem;
    }

    .tr:first-child > .tr {
      border-top: 0;
    }
  }
}

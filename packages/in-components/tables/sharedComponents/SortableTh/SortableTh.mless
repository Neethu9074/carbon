@import '~in-themes/active.less';

:local {
  .column,
  .column:hover {
    display: flex;
    align-items: center;

    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .column:hover {
    .test {
      opacity: 1;
    }
  }

  .activeColumn {
    color: @lib__colors__N900Primary;
    font-weight: bold;

    &:hover {
      color: @lib__colors__N900Primary;
    }
  }

  .test {
    opacity: 0;
    fill: @lib__colors__N600Light;
    margin-left: 0.5rem;
  }

  .icon {
    margin-left: 0.5rem;
  }
}

:local {
  .wrapper {
    display: flex;
    align-items: center;
    margin-left: -1rem;
    padding-left: 1rem;
  }
  .dataTableErrorBorder {
    border-left: 2px solid var(--cds-support-error);
  }
  .dataTableWarningBorder {
    border-left: 2px solid var(--cds-support-warning);
  }
  .dataTableGreenBorder {
    border-left: 2px solid var(--cds-support-success);
  }
}

:global(table.cds--data-table--lg) :local(.wrapper) {
  min-height: var(--cds-layout-size-height-lg);
}

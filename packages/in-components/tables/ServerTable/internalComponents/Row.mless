:local {
  .row {
    color: #16363e;
    font-size: 0.875rem;
    font-weight: 400;

    &:nth-child(even) {
      background: #FAFBFC;
    }

    &:hover {
      background: #F4F7F8;
    }
  }

  .cell {
    border-top: 1px solid #E4EBED;
    padding: .75rem 0;

    &:first-child {
      padding-left: 1rem;
    }
  }

  .row:first-child > .cell {
    border-top: 0;
  }

  .row:last-child > .cell {
    border-bottom: 1px solid #E4EBED;
  }
}

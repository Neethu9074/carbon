:local {
  .row {
    color: #16363e;
    font-size: 0.875rem;
    font-weight: 400;

    &:hover {
      background: #f4f7f8;
    }

    &:nth-child(even) {
      background: #fafbfc;

      &:hover {
        background: #f4f7f8;
      }
    }
  }

  .cell {
    border-top: 1px solid #e8eef0;
    height: 3rem;

    &:first-child {
      padding-left: 1rem;
    }
  }
}

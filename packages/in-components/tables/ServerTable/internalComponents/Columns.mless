:local {
  .column {
    font-weight: 300;
    color: #698189;
    text-transform: uppercase;
    font-size: 0.75rem;
    padding: 0.625rem 0;
    background: #fff;
    cursor: pointer;
    border-bottom: 1px solid #d2dfe4;

    &:first-child {
      padding-left: 1rem;
    }
  }

  .icon {
    margin: 0 0 0.125rem 0.375rem;
  }
}

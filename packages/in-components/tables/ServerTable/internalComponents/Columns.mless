:local {
  .column {
    display: flex;
    align-items: center;

    font-weight: 300;
    color: #698189;
    text-transform: uppercase;
    font-size: 0.75rem;
    padding: 0.625rem 0;
    background: #fff;
    border-bottom: 1px solid #d2dfe4;
    cursor: pointer;

    &:first-child {
      padding-left: 1rem;
    }
  }

  .sortIcons {
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    height: 0.8125rem;
    margin-left: 0.375rem;
  }
}

:local {
  .columnWrapper {
    border-bottom: 1px solid #d2dfe4;

    &:first-child {
      padding-left: 1rem;
    }
  }

  .column {
    display: flex;
    align-items: center;

    text-decoration: none;
    font-weight: 300;
    color: #698189;
    text-transform: uppercase;
    font-size: 0.75rem;
    padding: 0.625rem 0;
    background: #fff;

    &:hover {
      text-decoration: none;
    }
  }

  .sortableColumn {
    cursor: pointer;
  }

  .icon {
    margin: 0 0 0.125rem 0.375rem;
  }
}

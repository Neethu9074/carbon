:local {
  .paginationWrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 1rem;
  }

  .tableAsCard {
    border-radius: 0;
    box-shadow: none;
    border: 0;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.25rem 0.5rem;
  }

  .rightHeader {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .noData,
  .error {
    padding: 1rem;
  }

  .pagination {
    justify-content: center;
    margin: 1rem 0 0;
  }

  .paginationInCard {
    margin-bottom: 1rem;
  }
}

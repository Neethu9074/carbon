:local {
  .paginationWrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 1rem;
  }

  .table {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e8eef0;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    border-radius: 4px;
    border-collapse: initial;
  }

  .tableAsCard {
    border-radius: 0;
    box-shadow: none;
    border: 0;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.25rem 0.5rem;
  }

  .rightHeader {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .noData, .error {
    padding: 1rem;
  }

  .pagination {
    justify-content: center;
    margin: 1rem 0 0;
  }

  .paginationInCard {
    margin-bottom: 1rem;
  }
}

:local {
  .table {
    width: 100%;
    background: #FFFFFF;
    border: 1px solid #E8EEF0;
    box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
    border-radius: 4px;
    border-collapse: initial;
  }

  .tableAsCard {
    border-radius: 0;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.25rem 0.5rem;
  }

  .rightHeader {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .noData {
    padding: 1rem;
  }
}

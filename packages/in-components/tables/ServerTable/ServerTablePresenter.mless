:local {
  .paginationWrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 1rem;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.5rem 0;
  }

  .rightHeader {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .pagination {
    justify-content: center;
    margin: 1rem 0 0;
  }
}

:local {
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.5rem 0;
  }

  .rightHeader {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .paginationWrapper {
    display: flex;
    justify-content: center;

    width: 100%;

    margin: 1rem 0;
  }
}

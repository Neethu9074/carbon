@import 'in-components/HistogramChart/shared.less';

:local {
  .wrapperContainer {
    position: absolute;
    width: 100%;
  }

  .bucket {
    position: absolute;
    top: 0;
  }
  .stackedBar {
    position: absolute;
    bottom: 1px;
    display: flex;
    flex-direction: column-reverse;
  }

  .bar {
    position: absolute;
    bottom: 1px;
    left: 1px;
    z-index: @z-index__bar;
  }
}

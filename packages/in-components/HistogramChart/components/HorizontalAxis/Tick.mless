:local {
  .tickContainer {
    position: absolute;
    user-select: none;
  }

  .tick {
    position: relative;
    border-left: 1px solid var(--ids-color-option-neutral-800);
    height: 6px;
  }

  .tickHidden {
    height: 6px;
  }

  .tickValues {
    position: absolute;
    color: var(--ids-color-option-neutral-800);
    font-size: 0.5625rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .tickContainer:last-child .tickValues {
    left: 0;
  }
}

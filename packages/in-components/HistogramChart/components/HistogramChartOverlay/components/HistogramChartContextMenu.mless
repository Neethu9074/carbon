@import 'in-components/HistogramChart/shared.less';

:local {
  .contextMenu {
    position: absolute;
    top: 2rem;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    background: var(--ids-color-option-white);
    color: var(--ids-color-option-neutral-800);
    border-radius: var(--ids-border-radius-option-large);

    box-shadow: var(--ids-shadow-option-subtle);
    border: 1px solid rgba(0, 0, 0, 0.16);
  }

  .rightAligned {
    right: 0;
  }

  .buttonWrapper {
    & + .buttonWrapper {
      margin-left: 0.5rem;
    }
  }

  .button {
    justify-content: flex-start;

    width: 100%;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;

    border: none;
    background: var(--ids-color-option-white);
    border-radius: 0;

    & + .button {
      margin-left: 0;
    }

    &:hover {
      border: none;
    }

    &:global(.carbonButton) {
      white-space: nowrap;
    }
  }

  .contextMenuCarbonButtonWrapper {
    position: absolute;
    display: flex;
    transform: translate(-100%, 4px);
    width: auto;
    height: 26px;
    z-index: @z-index__contextMenuActionsButtonsWrapper;
    top: -0.3rem;
    background: var(--ids-color-option-white);
  }

  .contextMenuOpenButtonIcon {
    margin: -0.5rem;
  }
}

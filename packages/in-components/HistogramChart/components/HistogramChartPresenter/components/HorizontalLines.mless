@import 'in-components/HistogramChart/shared.less';
@import '~in-themes/active.less';

:local {
  .lines {
    position: absolute;
    top: 0;
    left: 0;
  }

  .horizontalLine {
    position: relative;
    border-top: 1px solid var(--ids-color-option-neutral-600);
    opacity: 0.2;
    z-index: @z-index__horizontalLine;
  }
}

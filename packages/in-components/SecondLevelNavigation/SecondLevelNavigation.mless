@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .nav {
    overflow: auto;
  }

  .navLight {
    background: @lib__colors__N800Dark;
    border-bottom: none;
    border-top: none;
  }

  .tabList {
    display: flex;
    align-items: flex-end;
    height: 4rem;
  }

  .tabListWithGroups {
    height: 5rem;
  }

  .tabListLight {
    .tab {
      color: @lib__colors__N300;
      line-height: 1.5rem;

      &:hover {
        color: #fff;
      }
    }
    .tabSelected {
      color: #fff;
      border-bottom: 3px solid @lib__colors__cyan800;
    }
  }

  .tab {
    display: flex;
    align-items: flex-start;

    margin: 0 2rem 0 0.125rem;
    padding-bottom: 0.25rem;

    font-size: 0.875rem;
    border-bottom: 3px solid transparent;

    color: @lib__colors__N600Light;
    .icon {
      fill: @lib__colors__N600Light;
    }

    .ellipsis();

    &:hover {
      border-bottom: 3px solid @lib__colors__N600Light;
    }
  }

  .content {
    display: flex;
    align-items: center;

    height: 2rem;
  }

  .tabSelected {
    border-bottom: 3px solid @lib__colors__cyan800;
    cursor: default;

    color: @lib__colors__N800Dark;
    .icon {
      fill: @lib__colors__N800Dark;
    }
  }

  .tabDisabled {
    color: @lib__colors__N400;

    &:hover {
      border-bottom: 3px solid transparent;
      cursor: not-allowed;
    }
  }

  .link {
    text-decoration: none;
    color: @lib__colors__N500;

    &:hover {
      text-decoration: none;
      color: @lib__colors__N500;
    }
  }

  .icon {
    margin-right: 0.25rem;
  }

  .addSeparator {
    margin-left: 1rem;
    padding-left: 1rem;
    position: relative;

    &::before {
      position: absolute;
      top: -1.125rem;
      left: 0;
      bottom: 0.375rem;
      width: 1px;
      background: @lib__colors__N300;
      content: '';
    }
  }

  .addGroupSeparator {
    margin-left: 1rem;
    padding-left: 1rem;
    position: relative;

    &::before {
      position: absolute;
      top: -2.125rem;
      left: 0;
      bottom: 0.375rem;
      width: 1px;
      background: @lib__colors__N300;
      content: '';
    }
  }

  .group {
    display: flex;
    flex-direction: column;
  }

  .groupLabel {
    font-size: 0.75rem;
    font-weight: 400;
    margin-bottom: 1rem;
    color: @lib__colors__N500;
  }

  .groupSelected {
    font-weight: 500;
    color: @lib__colors__N800Dark;
  }

  .groupLabelExtraMargin {
    margin-left: 2rem;
  }

  .groupTabsWrapper {
    display: flex;
  }
}

@import '~in-themes/mixins.less';

:local {
  .nav {
    overflow: auto;
    flex-shrink: 0;
  }

  .navLight {
    background: var(--ids-color-option-neutral-800);
    border-bottom: none;
    border-top: none;
  }

  .tabList {
    display: flex;
    align-items: flex-end;
    height: 4rem;
  }

  .tabListWithGroups {
    height: 5rem;
  }

  .tabListLight {
    .tab {
      color: var(--ids-color-option-neutral-300);
      line-height: 1.5rem;

      &:hover {
        color: #fff;
      }
    }
    .tabSelected {
      color: #fff;
      border-bottom: 3px solid var(--ids-color-option-teal-400);
    }
  }

  .tab {
    display: flex;
    align-items: flex-start;

    margin: 0 2rem 0 0.125rem;
    padding-bottom: 0.25rem;

    font-size: 0.875rem;
    border-bottom: 3px solid transparent;

    color: var(--ids-color-option-neutral-600);
    .icon {
      fill: var(--ids-color-option-neutral-600);
    }

    .ellipsis();

    &:hover {
      border-bottom: 3px solid var(--ids-color-option-neutral-600);
    }
  }

  .content {
    display: flex;
    align-items: center;

    height: 2rem;
  }

  .tabSelected {
    border-bottom: 3px solid var(--ids-color-option-teal-400);
    cursor: default;

    color: var(--ids-color-option-neutral-800);
    .icon {
      fill: var(--ids-color-option-neutral-800);
    }
  }

  .tabDisabled {
    color: var(--ids-color-option-neutral-400);

    &:hover {
      border-bottom: 3px solid transparent;
      cursor: not-allowed;
    }
  }

  .link {
    text-decoration: none;
    color: var(--ids-color-option-neutral-500);

    &:hover {
      text-decoration: none;
      color: var(--ids-color-option-neutral-500);
    }
    /* removes the focus indicator after link was clicked with mouse */
    &:focus:not(:focus-visible) {
      outline: none;
    }
  }

  .icon {
    margin-right: 0.25rem;
  }

  .postIcon {
    margin-left: 0.25rem;
  }

  .addSeparator {
    margin-left: 1rem;
    padding-left: 1rem;
    position: relative;

    &::before {
      position: absolute;
      top: -1.125rem;
      left: 0;
      bottom: 0.375rem;
      width: 1px;
      background: var(--ids-color-option-neutral-300);
      content: '';
    }
  }

  .addGroupSeparator {
    margin-left: 1rem;
    padding-left: 1rem;
    position: relative;

    &::before {
      position: absolute;
      top: -2.125rem;
      left: 0;
      bottom: 0.375rem;
      width: 1px;
      background: var(--ids-color-option-neutral-300);
      content: '';
    }
  }

  .group {
    display: flex;
    flex-direction: column;
  }

  .groupLabel {
    font-size: 0.75rem;
    font-weight: 400;
    margin-bottom: 1rem;
    color: var(--ids-color-option-neutral-500);
  }

  .groupSelected {
    font-weight: 500;
    color: var(--ids-color-option-neutral-800);
  }

  .groupLabelExtraMargin {
    margin-left: 2rem;
  }

  .groupTabsWrapper {
    display: flex;
  }
}

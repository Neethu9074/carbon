@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .twoRowWrapper {
    display: flex;
    align-items: center;
  }

  .label {
    display: flex;
    align-items: center;

    font-size: 0.75rem;
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N500;
  }

  .breadcrumb {
    text-decoration: none;
    color: @lib__colors__N500;
    max-width: 250px;
    .ellipsis();

    .breadcrumbContent {
      .ellipsis();
    }

    &:hover {
      color: @lib__colors__N700Medium;
      text-decoration: none;
    }
  }
}

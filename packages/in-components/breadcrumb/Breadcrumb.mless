@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .breadcrumb {
    padding: 0.25rem 0.5rem;
    border-radius: var(--ids-border-radius-medium);

    color: var(--ids-color-option-neutral-500) !important;
    text-decoration: none;
    cursor: pointer;
    .ellipsis();

    .breadcrumbContent {
      .ellipsis();
    }
  }

  .clickable {
    &:hover {
      background: var(--ids-color-option-neutral-700);
      color: var(--ids-color-option-neutral-50) !important;

      text-decoration: none;

      .icon {
        fill: var(--ids-color-option-neutral-50);
      }
    }
  }

  .activeBreadcrumb {
    font-weight: bold;
  }

  .twoRowWrapper {
    display: flex;
    align-items: center;
  }

  .icon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-500);
  }
}

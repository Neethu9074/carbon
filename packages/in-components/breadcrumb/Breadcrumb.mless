@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .breadcrumb {
    padding: 0.25rem 0.5rem;
    border-radius: @lib__shapes__radius_medium;

    color: @lib__colors__N500;
    text-decoration: none;
    cursor: pointer;
    .ellipsis();

    .breadcrumbContent {
      .ellipsis();
    }
  }

  .clickable {
    &:hover {
      background: @lib__colors__N700Medium;
      color: @lib__colors__N050;

      text-decoration: none;

      .icon {
        fill: @lib__colors__N050;
      }
    }
  }

  .activeBreadcrumb {
    font-weight: bold;
  }

  .twoRowWrapper {
    display: flex;
    align-items: center;
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N500;
  }
}

:local {
  .twoRowWrapper {
    display: flex;
    flex-direction: column;
  }

  .label {
    font-size: 0.75rem;
    margin-bottom: 0.125rem;
  }

  .breadcrumb {
    text-decoration: none;
    color: #a5b6be;

    &:last-child {
      color: #fff;
    }

    &:hover {
      color: #fff;
    }
  }
}

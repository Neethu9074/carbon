@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .twoRowWrapper {
    display: flex;
    align-items: center;
  }

  .label {
    display: flex;
    align-items: center;

    font-size: 0.75rem;
  }

  .icon {
    margin-right: 0.5rem;
    fill: #ffffff8f;
  }

  .breadcrumb {
    text-decoration: none;
    color: #ffffff8f;
    max-width: 250px;
    .ellipsis();

    &:hover {
      color: #ffffffb8;
      text-decoration: none;
    }

    &:last-child {
      color: #fff !important;

      .label {
        color: #ffffff8f;
      }
    }
  }
}

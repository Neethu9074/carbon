@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .twoRowWrapper {
    display: flex;
    align-items: center;
  }

  .label {
    display: flex;
    align-items: center;

    font-size: 0.75rem;
  }

  .icon {
    margin-right: 0.5rem;
    fill: rgba(255,255,255,0.56);
  }

  .breadcrumb {
    text-decoration: none;
    color: rgba(255,255,255,0.56);
    max-width: 250px;
    .ellipsis();

    &:hover {
      color: rgba(255,255,255,0.7);
      text-decoration: none;
    }

    &:last-child {
      color: #fff !important;

      .label {
        color: rgba(255,255,255,0.56);
      }
    }
  }
}

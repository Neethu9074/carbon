@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .twoRowWrapper {
    display: flex;
    flex-direction: column;

    &:last-child {
      & > .breadcrumb {
        display: flex;
        align-items: center;
        color: #fff;
      }

      & > .label {
        color: #ffffff8f;
      }
    }
  }

  .label {
    font-size: 0.75rem;
  }

  .breadcrumb {
    text-decoration: none;
    color: #ffffff8f;
    max-width: 250px;
    .ellipsis();

    &:hover {
      color: #ffffffb8;
      text-decoration: none;
    }
  }
}

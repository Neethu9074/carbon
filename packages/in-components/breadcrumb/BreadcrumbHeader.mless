@import '~in-themes/active.less';

:local {
  .breadcrumbHeader {
    background: @lib__colors__navy800;
    overflow: hidden;
    color: #ffffff8f;
    font-size: 0.875rem;
    font-weight: lighter;
    box-shadow: @lib__shadows__pronounced;
  }

  .container {
    max-width: @max-width * 1px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    align-items: center;
    height: 3rem;
  }

  .chevron {
    margin: 0.75rem;
  }

  .chevronIcon {
    fill: #ffffff3d;
  }
}

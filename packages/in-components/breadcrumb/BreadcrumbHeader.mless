@import '~in-themes/active.less';

:local {
  .breadcrumbHeader {
    background: @lib__colors__N050;
    border-bottom: 1px solid @lib__colors__N300;
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: lighter;
  }

  .dark {
    background: @lib__colors__N900Primary;
  }

  .container {
    display: flex;
    align-items: center;

    height: @header__height * 1px;

    max-width: @max-width * 1px;
    margin-left: auto;
    margin-right: auto;
  }

  .useFullAvailableWidth {
    max-width: 100%;
    margin-left: 1.5rem;
    margin-right: 1.5rem;
  }

  .chevron {
    margin: 0.75rem;
  }

  .chevronIcon {
    fill: @lib__colors__N400;
  }
}

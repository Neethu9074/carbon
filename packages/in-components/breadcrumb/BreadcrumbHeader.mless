@import '~in-themes/active.less';

:local {
  .wrapper {
    width: 100%;
    max-width: 100%;

    overflow: hidden;
  }

  .container {
    display: flex;
    align-items: center;

    height: 3.5rem;
  }

  .highlightLastChild {
    & > *:last-child {
      font-weight: 500;
    }
  }

  .chevron {
    margin: 0.5rem;
  }

  .chevronIcon {
    fill: @lib__colors__N400;
  }
}

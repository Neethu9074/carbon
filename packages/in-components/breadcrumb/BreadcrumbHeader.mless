@import '~in-themes/active.less';

:local {
  .container {
    display: flex;
    align-items: center;

    height: @header__height * 1px;
    max-width: @max-width * 1px;
  }

  .useFullAvailableWidth {
    width: 100%;
    margin-left: 1.5rem;
    margin-right: 1.5rem;
  }

  .chevron {
    margin: 0.75rem;
  }

  .chevronIcon {
    fill: @lib__colors__N400;
  }
}

@import '~in-themes/active.less';

:local {
  .container {
    display: flex;
    align-items: center;

    height: @header__height * 1px;
    max-width: @max-width * 1px;
  }

  .useFullAvailableWidth {
    width: 100%;
    max-width: 100%;

    margin-left: 1.5rem;
    margin-right: 1.5rem;
    overflow: hidden;
  }

  .highlightLastChild {
    & > *:last-child {
      font-weight: 500;
    }
  }

  .chevron {
    margin: 0.5rem;
  }

  .chevronIcon {
    fill: @lib__colors__N400;
  }
}

@import '~in-themes/active.less';

:local {
  .breadcrumbHeader {
    background: #47626a;
    color: #fff;
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: lighter;
  }

  .container {
    max-width: @max-width * 1px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    align-items: center;
    height: 3.125rem;
  }

  .chevron {
    margin: 0 1.4rem;
  }
}

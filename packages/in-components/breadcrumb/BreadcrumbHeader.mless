:local {
  .wrapper {
    width: 100%;
    max-width: 100%;

    overflow: hidden;
  }

  .container {
    display: flex;
    align-items: center;

    height: 3.5rem;
  }

  .highlightLastChild {
    & > *:last-child {
      font-weight: 500;
    }
  }

  .chevronIcon {
    margin: 0 0.25rem;
    fill: var(--ids-color-option-neutral-400);
  }
}

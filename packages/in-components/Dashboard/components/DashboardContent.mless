:local {
  .mainContent {
    height: 100%;
    position: relative;
    background: #eef2f4;
  }

  .wrapper {
    width: 100%;
    height: ~'calc(100% - 36px)';

    display: flex;

    overflow-x: hidden;
    overflow-y: scroll;
    // establish this element as an offset wrapper so that offset calculations work for
    // dashboard navigation.
    position: relative;
  }

  .sidebar {
    width: 274px;
    height: 100%;
  }

  .content {
    width: ~'calc(100% - 274px)';
    height: 100%;
    padding: 0 0 0.3rem 0;
    box-sizing: border-box;

    &::after {
      width: 100%;
      height: 1rem;
      content: ' ';
      display: block;
    }
  }

  .notFoundDialog {
    padding: 1rem 1rem 1rem 18.75rem;
    max-width: 50rem;
  }
}

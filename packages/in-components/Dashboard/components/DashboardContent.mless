@import '~in-themes/active.less';
@import '~in-themes/mediaQueries.less';

:local {
  .mainContent {
    height: 100%;
    position: relative;
  }

  .wrapper {
    width: 100%;
    min-height: ~'calc(100vh - 128px)';
    display: flex;

    overflow-x: hidden;
    overflow-y: scroll;
    // establish this element as an offset wrapper so that offset calculations work for
    // dashboard navigation.
    position: relative;
  }

  .sidebar {
    background: @lib__colors__N050;
    min-height: 100%;
  }

  .content {
    width: ~'calc(100% - 320px)';
    height: 100%;
    box-sizing: border-box;
    background: #fff;
    padding: 1rem 0 1rem 1rem;

    &::after {
      width: 100%;
      height: 1rem;
      content: ' ';
      display: block;
    }
  }

  @media @min-medium-screen {
    .content {
      width: ~'calc(100% - 400px)';
    }
  }

  .notFoundDialog {
    padding: 1rem 1rem 1rem 18.75rem;
    max-width: 50rem;
  }
}

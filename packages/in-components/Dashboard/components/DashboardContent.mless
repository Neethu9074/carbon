@import '~in-themes/active.less';

:local {
  .mainContent {
    height: 100%;
    position: relative;
  }

  .wrapper {
    width: 100%;
    height: ~'calc(100% - 36px)';
    background: @lib__colors__N050;

    display: flex;

    overflow-x: hidden;
    overflow-y: scroll;
    // establish this element as an offset wrapper so that offset calculations work for
    // dashboard navigation.
    position: relative;
  }

  .sidebar {
    height: 100%;
  }

  .content {
    width: 100%;
    height: 100%;
    padding: 0 0 0.3rem 0;
    box-sizing: border-box;
    background: #fff;

    &::after {
      width: 100%;
      height: 1rem;
      content: ' ';
      display: block;
    }
  }

  .notFoundDialog {
    padding: 1rem 1rem 1rem 18.75rem;
    max-width: 50rem;
  }
}

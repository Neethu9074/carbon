@import '~in-themes/active.less';

:local {
  .breadcrumbContainer {
    display: flex;
    align-items: center;
  }
  .dashboardBreadcrumb {
    float: right;
    width: 100%;
    height: 3rem;
    margin: 0;
    padding: 0;

    overflow: hidden;
    list-style: none;

    display: flex;
    align-items: center;
  }

  .crumbSeperator {
    margin: 0 0.5rem;
  }

  .crumbWrapper {
    display: flex;
    align-items: center;
  }
  .crumbElementLink {
    font-size: 0.875rem;
    font-weight: lighter;
    display: flex;
    align-items: center;
    color: @lib__colors__N500;
    text-decoration: none;
  }
  .crumbElementIcon {
    margin: 0 0.3rem 0 0;
  }
  .crumElementIconSelected {
    > a {
      color: @lib__colors__N700Medium;
    }
  }

  .crumbElement {
    &:hover {
      > a {
        color: @lib__colors__N700Medium;
        text-decoration: none;
      }
    }
  }
  .crumbElementSelected {
    > a {
      color: @lib__colors__N700Medium;
    }
  }
}

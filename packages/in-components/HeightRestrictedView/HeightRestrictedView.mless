:local {
  .view {
    overflow-x: hidden;
    overflow-y: auto;
    position: relative;
  }

  .scrollableIndicator {
    background: #fff;
    height: 100px;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to bottom, rgba(255,255,255,0) 0%,rgba(255,255,255,1) 100%);
    pointer-events: none
  }
}

@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    flex-direction: column;

    overflow: hidden;
  }

  .type {
    display: flex;
    align-items: center;

    margin-bottom: 0.25rem;

    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-600);
  }

  .label {
    color: var(--ids-color-option-neutral-900);
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    .ellipsis();
  }

  .link {
    font-size: 0.875rem;
    .ellipsis();
  }

  .withEllipsis {
    .ellipsis();
    max-width: 20rem;
  }
}

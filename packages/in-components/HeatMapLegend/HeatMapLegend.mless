:local {
  .wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--ids-color-text-primary-on-light);
  }

  .label {
    &::first-letter {
      text-transform: uppercase;
    }
  }

  .values {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ids-color-text-primary-on-light);
    font-weight: 500;
    padding: 0 0 2px;
    font-size: 0.7rem;
  }

  .colors {
    width: 12.5rem;
    height: 0.4rem;
  }
}

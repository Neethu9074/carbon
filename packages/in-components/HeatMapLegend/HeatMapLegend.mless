@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    flex-direction: column;
    color: var(--ids-color-option-neutral-600);
  }

  .values {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ids-color-option-neutral-600);
    font-weight: 500;
    padding: 0 0 2px;
    font-size: 0.7rem;
  }

  .colors {
    width: 12.5rem;
    height: 0.4rem;
  }
}

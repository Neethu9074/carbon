:local {
  .pdfExportLayout {
    --max-width-export-layout: 90rem;

    width: 100%;
    max-width: 8.27in;
    height: 100%;
    top: 0;
    left: -100%;
    pointer-events: none;

    opacity: 1;
    position: absolute;
    display: block;
    box-sizing: border-box;
  }

  .fullWidth {
    max-width: var(--max-width-export-layout);
  }

  .landscape {
    max-width: 11.69in;
  }
}

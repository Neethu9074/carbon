:local {
  .buttonGroup {
    display: flex;
    align-items: center;
  }

  .segmented {
    border: 1px solid var(--ids-color-option-neutral-400);
  }

  .button {
    background: #fff;
    color: var(--ids-color-option-neutral-700);
    border-radius: 0;
    cursor: pointer;

    &:hover {
      background: var(--ids-color-option-neutral-300);
      color: var(--ids-color-option-neutral-700);
    }

    & + .button {
      margin-left: 0.25rem;
    }
  }

  .segmented {
    background: var(--ids-color-option-neutral-50);
    color: var(--ids-color-option-neutral-800);
    border: 1px solid var(--ids-color-option-neutral-400);

    svg {
      fill: var(--ids-color-option-neutral-800);
    }

    &:hover {
      border: 1px solid var(--ids-color-option-neutral-500);
      background: var(--ids-color-option-neutral-100);

      svg {
        fill: var(--ids-color-option-neutral-800);
      }
    }

    & + .button {
      margin-left: 0;
    }
  }

  .active {
    background: var(--ids-color-option-blue-400);
    border: 1px solid var(--ids-color-option-blue-400);
    color: #fff;

    svg {
      fill: #fff;
    }

    &:hover {
      background: var(--ids-color-option-blue-400);
      color: #fff;
    }

    &:hover {
      border: 1px solid var(--ids-color-option-blue-400);
      background: #148cc8;

      svg {
        fill: #fff;
      }
    }
  }

  .disabledWidget {
    background-color: var(--ids-color-option-neutral-50);
  }

  .first {
    border-top-left-radius: var(--ids-border-radius-option-medium);
    border-bottom-left-radius: var(--ids-border-radius-option-medium);
  }

  .last {
    border-top-right-radius: var(--ids-border-radius-option-medium);
    border-bottom-right-radius: var(--ids-border-radius-option-medium);
  }
}

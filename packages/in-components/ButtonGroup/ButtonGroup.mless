:local {
  .group {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;

    & > * {
      display: block;
      margin-top: 1px;
      border-radius: 0;

      & + * {
        margin-left: 0 !important;
      }

      &:first-child {
        margin-top: 0;
        border-top-left-radius: 0.188rem;
        border-top-right-radius: 0.188rem;
      }

      &:last-child {
        border-bottom-left-radius: 0.188rem;
        border-bottom-right-radius: 0.188rem;
      }
    }
  }

}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .flyoutMessage {
    background: #fff;
    font-size: 0.8rem;
    max-width: 24rem;
    padding: 1rem 0.8rem;
    margin: 0 0 1rem;
    border-radius: @lib__shapes__radius_medium;
    overflow: hidden;

    box-shadow: var(--ids-shadow-option-strong);

    display: flex;

    p {
      margin: 0.75rem 0;
    }

    --line-height-title: 1.5rem;
  }

  .info {
    border-left: 6px solid var(--ids-color-option-teal-500);
  }

  .warning {
    border-left: 6px solid rgb(255, 222, 0);
  }

  .danger {
    border-left: 6px solid rgb(255, 66, 41);
  }

  .clickable {
    cursor: pointer;
  }

  .icon {
    align-self: flex-start;
    fill: var(--ids-color-option-teal-500);
    vertical-align: middle;
  }

  .msg {
    max-width: 100%;
    color: var(--ids-color-option-neutral-700);
    font-weight: @lib__typography__body__font-size;
    .breakWord();

    em {
      color: var(--ids-color-option-blue-500);
      font-style: normal;
    }
  }

  .verticallyCenterMsg {
    display: flex;
    align-items: center;
  }

  .title {
    font-size: @lib__typography__h200__font-size;
    font-weight: 600;
    line-height: var(--line-height-title);
    margin: 0 0 0.25rem;
  }

  .content {
    margin: 0.5rem 0;
  }
}

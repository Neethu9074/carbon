@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .flyout {
    display: flex;
    align-items: center;
    justify-content: flex-start;

    max-width: 21rem;

    margin-bottom: 1rem;
    padding: 1rem;

    font-size: 0.8rem;
    border-radius: 4px;
    background: @lib__colors__N700Medium;
  }

  .warning {
    border-left: 3px solid @lib__colors__yellow800;
  }

  .clickable {
    cursor: pointer;
  }

  .icon {
    margin-right: 0.75rem;
    fill: @lib__colors__yellow800;
  }

  .msg {
    color: @lib__colors__yellow800;
    font-weight: bold;
    .breakWord();
  }

  .button {
    outline: none;
  }

  .content {
    margin-bottom: 0.75rem;
  }

  p {
    margin: 0.75rem 0;
  }
}

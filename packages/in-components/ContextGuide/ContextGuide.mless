:local {
  .leftButton {
    border-radius: var(--ids-border-radius-small) 0 0 var(--ids-border-radius-small);
    margin-right: 1px;
  }

  .rightButton {
    border-radius: 0 var(--ids-border-radius-small) var(--ids-border-radius-small) 0;
  }
}

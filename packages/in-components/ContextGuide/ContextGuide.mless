:local {
  .leftButton {
    border-radius: var(--ids-border-radius-option-small) 0 0 var(--ids-border-radius-option-small);
  }

  .rightButton {
    border-radius: 0 var(--ids-border-radius-option-small) var(--ids-border-radius-option-small) 0;
  }
}

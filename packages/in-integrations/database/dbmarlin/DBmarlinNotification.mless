@import '~in-themes/active.less';

:local {
  .message {
    box-sizing: border-box;
    padding: 0.625rem;
    background-color: #fafbfc;
    box-shadow: 0px 1px 4px 0px rgba(0, 0, 0, 0.16);

    border-radius: @lib__shapes__radius_small;
    color: @lib__colors__N600Light;

    & + .message {
      margin-top: 0.5rem;
    }
  }

  .firstLine {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .small {
    padding: 6px 10px;
  }

  .bold {
    font-weight: bold;
  }

  .content {
    width: 100%;
    font-size: 0.875rem;
    line-height: 1.5rem;
    text-align: center;
  }
}

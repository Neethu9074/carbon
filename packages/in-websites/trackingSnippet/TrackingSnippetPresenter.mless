@import '~in-themes/active.less';

:local {
  .snippetWrapper {
    align-items: top;
    justify-content: space-between;
  }

  .snippet {
    flex-grow: 1;
    margin: 0 1rem 0 0;
  }

  .options {
    width: 15rem;
  }

  .option {
    display: flex;
    justify-content: flex-start;
    margin-bottom: 0.75rem;
  }

  .label {
    margin: 0;
    height: 1.5rem;
    display: flex;
    align-items: center;
    color: var(--ids-color-option-neutral-700);
    font-size: var(--ids-font-size-option-body-small);
  }

  .helpWrapper {
    display: flex;
    align-items: center;

    &:active .help,
    &:hover .help {
      /* replaced old less variable links__hover__decoration
       *  even when it does not make sense here...
       */
      fill: underline;
    }
  }

  .toggle {
    color: var(--ids-color-option-neutral-700);
    font-size: var(--ids-font-size-option-body-small);
    display: flex;
  }

  .button {
    padding-top: 0.75rem;
    padding-bottom: 1rem;
  }

  .help {
    fill: var(--ids-color-option-neutral-700);
    margin-left: 0.25rem;
  }
}

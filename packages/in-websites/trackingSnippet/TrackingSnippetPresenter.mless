@import '~in-themes/active.less';

:local {
  .snippetWrapper {
    align-items: top;
    justify-content: space-between;
  }

  .buttonContent {
    display: grid;
    grid-template-columns: 9.375rem 8.125rem;
    column-gap: 0.25rem;
    align-items: center;
    height: 2.5rem;
    font-size: var(--ids-font-size-option-body-small);
  }

  .sriOption {
    display: flex;
    align-items: center;
  }

  .snippet {
    flex-grow: 1;
    margin: 0 1rem 0 0;
  }

  .options {
    width: 15rem;
  }

  .option {
    display: flex;
    justify-content: flex-start;
    margin-bottom: 0.75rem;
  }

  .label {
    margin: 0;
    display: flex;
    align-items: center;
    color: var(--ids-color-option-blue-700);
    font-size: var(--ids-font-size-option-body-small);
  }

  .gridContainer {
    margin: 0.25rem;
    align-items: center;
    width: 18.75rem;
  }

  .helpWrapper {
    display: flex;
    align-items: center;

    &:active .help,
    &:hover .help {
      /* replaced old less variable links__hover__decoration
       *  even when it does not make sense here...
       */
      fill: underline;
    }
  }

  .help {
    fill: var(--ids-color-option-blue-500);
    margin-left: 0.25rem;
  }

  .optionText {
    display: flex;
  }
}

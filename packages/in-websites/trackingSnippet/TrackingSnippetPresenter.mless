@import '~in-themes/active.less';

:local {
  .snippetWrapper {
    align-items: top;
    justify-content: space-between;
  }

  .snippet {
    flex-grow: 1;
    margin: 0 1rem 0 0;
  }

  .options {
    width: 15rem;
  }

  .option {
    display: flex;
    justify-content: flex-start;
    margin-bottom: 12px;
  }

  .label {
    margin: 0;
    display: flex;
    align-items: center;
    color: var(--ids-color-option-blue-700);
    font-size: var(--ids-font-size-option-body-small);
  }

  .helpWrapper {
    display: flex;
    align-items: center;

    &:active .help,
    &:hover .help {
      fill: @links__hover__decoration;
    }
  }

  .help {
    fill: var(--ids-color-option-blue-500);
  }
}

@import '~in-themes/active.less';

:local {
  .container {
    height: 100%;
    margin: 8px;
  }

  .list {
    list-style: none;
    // reset some browser styles
    margin: 0;
    padding: 0;
  }

  .item.selected {
    background-color: @lib__colors__N600Light;
    border-radius: @lib__shapes__radius_small;
    color: @lib__colors__white;
  }

  .item {
    height: 2rem;
    display: flex;
    align-items: center;
    font-size: @lib__typography__body__font-size;
    color: @lib__colors__N700Medium;
    padding: 0.5rem;

    &:hover {
      color: @lib__colors__teal800;
      cursor: pointer;
    }

    &:not(:last-child) {
      margin-bottom: 0.5rem;
    }
  }

  .rightSeperator {
    border-right: 1px solid @lib__colors__N300;
    padding-right: 1rem;
  }
}

:local {
  pre.meta {
    max-height: 11rem;
    padding: 1rem;
  }

  .address {
    padding: 1rem 1rem 0;
  }

  .city {
    display: block;
    font-weight: 500;
    font-size: 1.1rem;
  }

  .countryAndContinent {
    font-weight: 300;
    font-size: 0.85rem;
    padding: 0.1rem 0 0;
    display: block;
  }
}

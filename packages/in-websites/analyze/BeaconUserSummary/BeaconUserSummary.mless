@import '~in-themes/active.less';

:local {
  .summary {
    color: @lib__colors__N600Light;
  }

  pre.meta {
    max-height: 100%;
    padding: 1rem;
  }

  .address {
    padding: 1rem 1rem 0;
  }

  .city {
    display: block;
    font-weight: 500;
    font-size: 1.1rem;
  }

  .countryAndContinent {
    font-weight: 300;
    font-size: 0.85rem;
    padding: 0.1rem 0 0;
    display: block;
  }

  .metaCard {
    max-height: 16.8rem;
    height: 100%;
  }
}

:local {
  .summary {
    color: var(--ids-color-option-neutral-600);
  }

  .meta {
    max-height: 100%;
    height: 100%;
  }

  .address {
    padding: 1rem 1rem 0;
  }

  .city {
    display: block;
    font-weight: 500;
    font-size: 1rem;
  }

  .countryAndContinent {
    font-size: 0.875rem;
    padding: 0.3rem 0 0;
    display: block;
  }

  .metaCard {
    max-height: 16.8rem;
    height: 100%;
  }
}

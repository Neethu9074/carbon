@import '~in-themes/mixins.less';

:local {
  .user {
    display: flex;
    display: flex;
    align-items: center;
    margin: 0 0 1rem;
  }

  .avatar {
    border-radius: 50%;
    width: 48px;
    height: 48px;
  }

  .info {
    margin: 0 0 0 10px;
  }

  .first {
    font-weight: semibold;
    font-size: 1.125rem;
    .ellipsis();
  }

  .second {
    font-size: .875rem;
    margin: 0.2rem 0 0;
    .ellipsis();
  }

  .third {
    font-size: 0.675rem;
    margin: 0.2rem 0 0;
    .ellipsis();
  }
}

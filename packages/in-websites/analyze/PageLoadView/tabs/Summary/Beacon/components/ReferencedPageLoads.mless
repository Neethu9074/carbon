:local {
  .pageLoad {
    padding: 1rem;
    border-top: 1px solid var(--ids-color-option-neutral-400);
    background: var(--ids-color-option-neutral-200);
    display: flex;
    justify-content: space-between;
  }

  .leftSide {
    display: flex;

    & > *:nth-child(1) {
      max-width: 20rem;
      width: 20rem;
    }
  }

  .button {
    margin: 0 1rem 0 0;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .beacon {
    padding: 1rem;
    border-top: 1px solid @lib__colors__N400;
    background: @lib__colors__N050;
    color: @lib__colors__N600Light;
    position: relative;

    .highlightingBase();
  }

  .highlighted {
    .highlightingActive();
  }

  .erroneous::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: @lib__colors__failure;
    content: "";
  }

  .header {
    display: flex;
    justify-content: space-between;
  }

  .leftHeader {
    display: flex;
    align-items: center;

    & > * {
      max-width: 8rem;
      width: 8rem;

      &:first-child {
        width: 2.3rem;
        text-transform: uppercase;
      }

      &:nth-child(2) {
        max-width: 20rem;
        width: 20rem;
      }
    }
  }

  .rightHeader {
    display: flex;
    align-items: center;
  }

  .body {
    margin: 2.2rem 0 1rem 4rem;
  }
}

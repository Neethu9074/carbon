@import '~in-themes/mixins.less';

:local {
  .beacon {
    border-top: 1px solid var(--ids-color-option-neutral-400);
    background: var(--ids-color-option-neutral-50);
    color: var(--ids-color-option-neutral-600);
    position: relative;

    .highlightingBase();
  }

  .highlighted {
    .highlightingActive();
  }

  .erroneous::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--ids-color-option-red-500);
    content: '';
  }

  .header {
    padding: 1rem;
    display: flex;
    justify-content: space-between;

    &:hover,
    &:focus {
      outline: 0;
      background: var(--ids-color-option-neutral-300);
      cursor: pointer;
    }
  }

  .leftHeader {
    display: flex;
    align-items: center;

    & > * {
      max-width: 8rem;
      width: 8rem;

      &:first-child {
        width: 2.6rem;
        text-transform: uppercase;
      }

      &:nth-child(2) {
        max-width: 20rem;
        width: 20rem;
        padding-left: 1rem;
      }
    }
  }

  .rightHeader {
    display: flex;
    align-items: center;
  }

  .body {
    margin: 1.2rem 1rem 0 5rem;
    padding-bottom: 2rem;
  }
}

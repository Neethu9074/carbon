@import '~in-themes/active.less';

:local {
  .tooltipWrapper {
    padding: 0.5rem;

    .tooltipContent > div,
    .tooltipContent > span {
      margin: 0 0 0.5rem 0;

      >:last-child {
        font-weight: bold;
      }
    }

    .tooltipContent > span {
      text-transform: uppercase;
    }
  }
}
:local {
  .closeIcon {
    cursor: pointer;
    fill: var(--ids-color-option-neutral-500);
    display: block;
    margin: 0 0 0 0.5rem;

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .analyticsLink {
    color: var(--ids-color-option-neutral-600);

    &:hover {
      color: var(--ids-color-option-neutral-600);
      text-decoration: none;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .container {
    margin: 0.5rem;
  }

  .jsErrorTextInput {
    background-color: @lib__colors__N100;
  }

  .errorMessageSelectWrapper {
    margin-bottom: 1.5rem;
  }

  .helpText {
    margin-bottom: 0.5rem;
  }

  .jsErrorsSelectAdvanceMode {
    align-self: flex-end;
  }

  .jsErrorsSelectButtonAdvanceMode {
    float: right;
  }
}

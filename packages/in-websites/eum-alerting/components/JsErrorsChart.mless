@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .container {
    margin: 0.5rem;
  }

  .placeholder {
    min-width: 25rem;
    min-height: 13.75rem;
  }

  .message {
    display: flex;
    align-items: center;
    justify-content: center;

    background-color: @lib__colors__N200;
    color: @lib__colors__N600Light;
    height: 14.375rem;
    width: 100%;
    margin-top: 1.5rem;
    padding: 0 0.5rem 0.5rem;

    > span {
      margin-left: 0.5rem;
    }

    > svg {
      fill: @lib__colors__N600Light;
    }
  }

  .metricSelect {
    width: 148px;
  }

  .controls {
    display: grid;
    grid-template-columns: repeat(4, min-content);
    column-gap: 0.5rem;
  }
}

@import '~in-themes/active.less';

:local {
  .list {
    display: flex;
    align-content: stretch;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    color: @lib__colors__N600Light;
    cursor: pointer;
    flex-grow: 1;
    font-size: @lib__typography__body-bold__font-size;
    line-height: 1.25rem;
    padding: 0.5rem 0 0 1rem;
  }

  .itemActive {
    color: @lib__colors__N900Primary;
    font-weight: 600;
  }

  .label {
    display: inline-block;
    height: 100%;
    // .5rem padding + border-height tpo prevent up/down jumping when switching tabs
    padding-bottom: 0.6875rem;
  }

  .labelActive {
    border-bottom: 3px solid @lib__colors__teal800;
    padding-bottom: 0.5rem;
  }

  .content {
    border: 1px solid @lib__colors__N300;
    padding: 0.5rem;
  }
}

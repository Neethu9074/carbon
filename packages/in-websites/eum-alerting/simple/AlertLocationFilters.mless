@import '~in-themes/active.less';

:local {
  .container {
    margin: 1rem 0.5rem 0 0;
    width: 36.25rem;
  }

  .wrapper {
    border: 1px solid @lib__colors__N300;
  }

  .filterList {
    padding: 0 1rem;
    // TODO: the position rule is onle for first iteration and must be removed in iteration
    position: relative;
  }

  // TODO: this class is onle for first iteration and must be removed in iteration 2
  .disableHover {
    position: absolute;
    height: 100%;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 5;
  }
}

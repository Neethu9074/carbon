@import '~in-themes/active.less';

:local {
  .headline {
    grid-column: 1 / span 3;
    color: @lib__colors__N900Primary;
    font-size: @lib__typography__h700__font-size;
    line-height: 2.5rem;
    margin: 0.5rem;
    font-weight: normal;
  }

  .alertChannelsContainer {
    grid-column: 1 / span 3;
    height: 25rem;
    overflow: auto;
  }

  .alertLocationFiltersWrapper {
    grid-column: 1 / span 2;
    padding: 0 0.5rem;
    margin-top: 0.5rem;
  }
}

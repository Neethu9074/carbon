@import '~in-themes/active.less';

:local {
  .container {
    margin: 0.5rem;
    width: 25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .message {
    display: flex;
    align-items: center;
    justify-content: center;

    background-color: @lib__colors__N200;
    color: @lib__colors__N600Light;
    height: 14.375rem;
    width: 100%;
    margin-top: 1.5rem;
    padding: 0 0.5rem 0.5rem;

    > span {
      margin-left: 0.5rem;
    }

    > svg {
      fill: @lib__colors__N600Light;
    }
  }

  .thresholdInput {
    margin-left: 3.75rem;
  }
}

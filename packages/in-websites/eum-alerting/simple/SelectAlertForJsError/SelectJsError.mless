@import '~in-themes/active.less';

:local {
  .container {
    color: @lib__colors__N900Primary;
    font-size: @lib__typography__body__font-size;
    line-height: 1.25rem;
    margin: 0.5rem;
  }

  .message {
    display: flex;
  }

  .label {
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
  }

  .icon {
    margin: 0.5rem 1.5rem 0 0;
    fill: @lib__colors__N600Light;
  }
}

  "definitions": {
    "missingResourceTimingsLearnMoreLabel": "Learn how to get visibility into cross-origin resources",
    "missingResourceTimingsExplanation": "Resource timing data collection is subject to same-origin policy restrictions. This means that collection of resource timings is restricted to resources retrieved from the origin of the HTML document and resources served by origins which explicitly allow this.",
    "scriptErrorLearnMoreLabel": "Learn how to get visibility into these errors",
    "scriptErrorExplanation": "Error type, message and stack trace are inaccessible due to browser security mechanisms, i.e. the same-origin policy. This typically means that the error was caused by a script that is hosted on an origin different from the origin of the HTML document. JavaScript files retrieved from content-delivery networks and advertisement services are most commonly responsible for these.",
    "stackTraceExplanation01SuccessfullyTranslated": "Successfully translated",
    "stackTraceExplanation02CouldNotDownloadJavaScriptMissingAuthentication": "Could not download JavaScript source file because of missing authentication (HTTP status code 401).",
    "stackTraceExplanation03CouldNotDownloadJavaScriptFailedAuthorization": "Could not download JavaScript source file because of failed authorization (HTTP status code 403).",
    "stackTraceExplanation04CouldNotDownloadJavaScriptFileWasNotFound": "Could not download JavaScript source file because the file was not found (HTTP status code 404).",
    "stackTraceExplanation05CouldNotDownloadJavaScriptHTTPRequestFailed": "Could not download JavaScript source file because the HTTP request failed and was not a 401, 403 or 404.",
    "stackTraceExplanation06NoReferenceToSourceMap": "No reference to source map in HTTP header nor as annotation in JavaScript source file.",
    "stackTraceExplanation07AnUnknownErrorHappened": "An unknown error happened during the identification of the source map file.",
    "stackTraceExplanation08CouldNotDownloadSourceMapMissingAuthentication": "Could not download source map file because of missing authentication (HTTP response code 401).",
    "stackTraceExplanation14CouldNotDownloadSourceMapailedAuthorization": "Could not download source map file because of failed authorization (HTTP status code 403).",
    "stackTraceExplanation09CouldNotDownloadSourceMapFileWasNotFound": "Could not download source map file because the file was not found (HTTP status code 404).",
    "stackTraceExplanation10CouldNotDownloadSourceMapHTTPRequestFailed": "Could not download source map file because the HTTP request failed and was not a 401, 403 or 404.",
    "stackTraceExplanation11SourceMapFileParsingFailed": "Source map file parsing failed.",
    "stackTraceExplanation12AnUnknownErrorOccurred": "An unknown error occurred while processing the source map file.",
    "stackTraceExplanation13CouldNotFindOriginalMapping": "Could not find original mapping for a combination of line and column number via the source map. This can happen after releases for users that are running outdated versions of your JavaScript files.",
    "stackTraceExplanation15TranslationIsOnlyPossible": "Translation is only possible when a reference to a line number is included in the stack trace line.",
    "stackTraceExplanation16ThisStackTraceLinesFileReferenceDoesNotPoint": "This stack trace line's file reference does not point to a JavaScript file. Source map based stack trace line translation only works when the source is a JavaScript file.",
    "stackTraceExplanation17CouldCotEstablishTCPTLSConnectionJavaScript": "Could not establish a TCP / TLS connection to the host serving the JavaScript file.",
    "stackTraceExplanation18CouldCotEstablishTCPTLSConnectionSourceMap": "Could not establish a TCP / TLS connection to the host serving the source map file.",
    "stackTraceExplanation19ARequestTimeoutOccurredJavaScript": "A request timeout occurred when trying to retrieve the JavaScript file.",
    "stackTraceExplanation20ARequestTimeoutOccurredJavaScriptSourceMap": "A request timeout occurred when trying to retrieve the JavaScript file. source map file."

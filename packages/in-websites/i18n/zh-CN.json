  "definitions": {
    "missingResourceTimingsLearnMoreLabel": "了解如何显示跨源资源",
    "missingResourceTimingsExplanation": "资源计时数据收集受同源策略限制。这意味着，资源计时收集限于从 HTML 文档源检索到的资源，以及显式允许此操作的源所提供的资源。",
    "scriptErrorLearnMoreLabel": "了解如何查看这些错误",
    "scriptErrorExplanation": "错误类型、消息和堆栈跟踪由于浏览器安全机制（即同源策略）而不可访问。这通常意味着该错误是由与 HTML 文档源不同的源上托管的脚本引起的。从内容交付网络和广告服务检索到的 JavaScript 文件是最常见的原因。",
    "stackTraceExplanation01SuccessfullyTranslated": "已成功转换",
    "stackTraceExplanation02CouldNotDownloadJavaScriptMissingAuthentication": "由于缺少认证，因此无法下载 JavaScript 源文件（HTTP 状态码 401）。",
    "stackTraceExplanation03CouldNotDownloadJavaScriptFailedAuthorization": "由于授权失败，因此无法下载 JavaScript 源文件（HTTP 状态码 403）。",
    "stackTraceExplanation04CouldNotDownloadJavaScriptFileWasNotFound": "由于找不到 JavaScript 源文件，因此无法下载该文件（HTTP 状态码 404）。",
    "stackTraceExplanation05CouldNotDownloadJavaScriptHTTPRequestFailed": "由于 HTTP 请求失败，因此无法下载 JavaScript 源文件，且 HTTP 状态码不是 401、403 或 404。",
    "stackTraceExplanation06NoReferenceToSourceMap": "未在 HTTP 头中引用源映射，也未作为JavaScript 源文件中的注释。",
    "stackTraceExplanation07AnUnknownErrorHappened": "在标识源映射文件期间发生了未知错误。",
    "stackTraceExplanation08CouldNotDownloadSourceMapMissingAuthentication": "由于缺少认证，因此无法下载源映射文件（HTTP 响应码 401）。",
    "stackTraceExplanation14CouldNotDownloadSourceMapailedAuthorization": "由于授权失败，因此无法下载源映射文件（HTTP 状态码 403）。",
    "stackTraceExplanation09CouldNotDownloadSourceMapFileWasNotFound": "由于找不到源映射文件，因此无法下载该文件（HTTP 状态码 404）。",
    "stackTraceExplanation10CouldNotDownloadSourceMapHTTPRequestFailed": "由于 HTTP 请求失败，因此无法下载源映射文件，且 HTTP 状态码不是 401、403 或 404。",
    "stackTraceExplanation11SourceMapFileParsingFailed": "源映射文件解析失败。",
    "stackTraceExplanation12AnUnknownErrorOccurred": "处理源映射文件时发生了未知错误。",
    "stackTraceExplanation13CouldNotFindOriginalMapping": "无法通过源映射找到某个行号和列号组合的原始映射。对于正在运行过时版本的 JavaScript 文件的用户，可能会在新版本发布之后发生此情况。",
    "stackTraceExplanation15TranslationIsOnlyPossible": "仅当对行号的引用包含在堆栈跟踪行中时，才可能进行转换。",
    "stackTraceExplanation16ThisStackTraceLinesFileReferenceDoesNotPoint": "此堆栈跟踪行的文件引用未指向 JavaScript 文件。仅当源是 JavaScript 文件时，基于源映射的堆栈跟踪行转换才有效。",
    "stackTraceExplanation17CouldCotEstablishTCPTLSConnectionJavaScript": "无法与提供 JavaScript 文件的主机建立 TCP/TLS 连接。",
    "stackTraceExplanation18CouldCotEstablishTCPTLSConnectionSourceMap": "无法与提供源映射文件的主机建立 TCP/TLS 连接。",
    "stackTraceExplanation19ARequestTimeoutOccurredJavaScript": "尝试检索 JavaScript 文件时发生请求超时。",
    "stackTraceExplanation20ARequestTimeoutOccurredJavaScriptSourceMap": "尝试检索 JavaScript 文件时发生请求超时。源映射文件。"
  },

:local {
  .tearsheet h4 {
    font-size: var(--cds-heading-02-font-size, 1rem);
    font-weight: var(--cds-heading-02-font-weight, 600);
    font-size: var(--cds-heading-02-font-size, 1rem);
    font-weight: var(--cds-heading-02-font-weight, 600);
  }

  .stepDescription {
    color: var(--cds-text-secondary, #525252);
    font-size: var(--cds-label-02-font-size);
    margin-top: -0.5rem;
    margin-bottom: 1rem;
  }

  .textInput {
    width: 40%;
  }

  .textArea {
    margin-top: 1rem;
  }
}

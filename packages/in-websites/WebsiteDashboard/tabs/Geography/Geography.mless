@import '~in-themes/active.less';

:local {
  .wrapper {
    position: relative;
  }

  .link {
    position: absolute;
    top: 0.625rem;
    left: 3.625rem;
  }

  .mapSwitchIconLight,
  .mapSwitchIconDark {
    padding: 3px;
    border-radius: 50%;
  }

  .mapSwitchIconDark {
    fill: #a7a7a7;
    border: 1px solid @lib__colors__N400;
  }

  .mapSwitchIconLight {
    fill: #a7a7a7;
    border: 1px solid @lib__colors__N400;
  }

  .heatMapLegend {
    position: absolute;
    bottom: 0.5rem;
    right: 2.4375rem;
  }
}

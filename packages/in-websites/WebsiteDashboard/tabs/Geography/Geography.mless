:local {
  @right: 1.5rem;

  .wrapper {
    position: relative;
  }

  .controlWrapperClassName {
    position: absolute;
    right: @right;
    bottom: ~'calc((100% - 16px)/2)';
  }

  .to3D {
    position: absolute;
    bottom: ~'calc((100% - 100px)/2)';
    right: @right;
    width: 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    color: var(--ids-color-option-neutral-600);

    &:hover {
      color: var(--ids-color-option-neutral-800);
    }
  }

  .to2D {
    position: absolute;
    bottom: 32.8125rem;
    right: @right;
    width: 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    color: var(--ids-color-option-neutral-400);

    &:hover {
      color: var(--ids-color-option-neutral-500);
    }
  }

  .globeWrapper {
    position: relative;
    height: 100%;
  }

  .footerText {
    position: absolute;
    color: var(--ids-color-option-white);
    bottom: 1rem;
    left: 1rem;
    margin: 0;
    font-size: 12px;
    font-weight: 300;
  }
}

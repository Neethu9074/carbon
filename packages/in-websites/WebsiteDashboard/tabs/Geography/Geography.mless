@import '~in-themes/active.less';

:local {
  .wrapper {
    position: relative;
  }

  .controlWrapperClassName {
    position: absolute;
    right: 2rem;
    bottom: 4.5rem;
  }

  .to3D {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    width: 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    color: @lib__colors__N600Light;

    &:hover {
      color: @lib__colors__N800Dark;
    }
  }
}

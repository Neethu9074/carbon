:local {
  pre.code {
    padding: 1rem;
  }

  .scriptErrorExplanation {
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .scriptErrorActionWrapper {
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    justify-content: center;
  }
}

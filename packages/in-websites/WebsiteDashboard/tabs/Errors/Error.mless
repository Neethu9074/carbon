:local {
  pre.code {
    padding: 1rem;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 1.3rem;
  }

  .stackTraceActions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
}

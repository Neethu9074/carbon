:local {
  .group {
    margin-bottom: 0;
  }

  .input {
    width: 300px;
    height: 31px;
  }

  .title h2,
  .trackingScriptTitle h2 {
    margin: unset;
  }

  .configurationBlock {
    padding: 1.5rem;
  }
  .title {
    padding-bottom: 0.5rem !important;
  }
  .trackingScriptTitle {
    padding-bottom: 2rem !important;
  }
}

@import '~in-themes/active.less';

:local {
  .buttons {
    position: absolute;
    right: 1.5rem;
    bottom: 32.8125rem;
  }

  .buttonRow {
    display: flex;
  }

  .buttonColumn {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .countryLabel {
    position: absolute;

    padding: 0.125rem 0.25rem;

    background: rgba(255, 255, 255, 0.31);
    border-radius: 0 3px 3px 3px;
    font-weight: 700;
  }

  .to2D {
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    color: @lib__colors__N400;

    &:hover {
      color: @lib__colors__N500;
    }
  }

  .placeholder {
    margin: 0.5rem;
  }
}

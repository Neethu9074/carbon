:local {
  .group {
    max-width: 37.5rem;
    margin: 0 auto;
  }

  .actionWrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .input {
    width: 100%;
    height: 31px;
  }

  .button {
    flex-shrink: 0;
    margin-left: 1rem;
  }
}

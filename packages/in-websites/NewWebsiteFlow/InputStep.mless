:local {
  .group {
    max-width: 37.5rem;
    margin: 0 auto;
  }

  .actionWrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
  }

  .input {
    width: 100%;
    height: 31px;
  }

  .teamDropdown {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .button {
    flex-shrink: 0;
    margin-top: 1rem;
    align-self: flex-end;
  }
}

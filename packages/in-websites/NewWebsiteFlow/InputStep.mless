:local {
  .group {
    margin: 0 auto;
  }

  .actionWrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
  }

  .input {
    width: 100%;
    height: 31px;
  }

  .teamDropdown {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .button {
    flex-shrink: 0;
    margin-top: 1rem;
    align-self: flex-end;
  }

  .title {
    font-weight: 600;
    font-size: 16px;
  }

  .message {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .dropdownRow {
    width: 100%;
    display: flex;
    align-items: flex-end;
    gap: 20px;
  }

  .teamsSelector {
    width: 100%;
  }
}

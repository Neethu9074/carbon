@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .user {
    display: flex;
    display: flex;
    align-items: center;
    margin: 0 0 1.4rem;
    border-bottom: 1px solid #d8d8d8;
    padding: 0 0 1rem;
  }

  .info {
    margin: 0 0 0 1.3rem;
    width: 100%;
    overflow: hidden;
  }

  .first {
    display: flex; // to vertically align firstBeaconIsMissingUserData
  }

  .firstText {
    font-weight: semibold;
    font-size: 1.125rem;
    max-width: 100%;
    .ellipsis();
  }

  .firstBeaconIsMissingUserDataLink {
    flex-shrink: 0;
  }

  .firstBeaconIsMissingUserData {
    fill: @lib__colors__yellow800;
    margin: 0 0 0 0.4rem;
  }

  .second {
    font-size: 0.875rem;
    margin: 0.2rem 0 0;
    max-width: 100%;
    .ellipsis();
  }

  .third {
    font-size: 0.675rem;
    margin: 0.3rem 0 0;
    max-width: 100%;
    .ellipsis();
  }

  .noUserData {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .clickableRow {
    cursor: pointer;
  }

  .rect {
    width: 0.75rem;
    height: 0.75rem;

    margin-right: 0.5rem;
  }

  .rectPlaceHolder {
    display: inline-block;
    width: 0.5rem;
  }

  .name {
    .ellipsis();
  }

  .labelCell {
    position: relative;

    &:hover {
      .filterButton {
        display: flex;
      }
    }
  }

  .filterButton {
    position: absolute;
    right: 1rem;

    display: none;
  }

  .groupLabel {
    color: @lib__colors__blue800;
    cursor: pointer;

    &:hover {
      text-decoration: underline;
    }
  }

  .cell {
    display: flex;
    align-items: center;
  }

  .metricValue {
    font-size: 0.875rem;
  }

  .serviceIcon,
  .timeIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }

  .serviceLink {
    color: @lib__colors__N600Light;
  }
}

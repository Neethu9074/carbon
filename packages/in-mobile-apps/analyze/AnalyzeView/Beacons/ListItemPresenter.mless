@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .item {
    max-width: 17rem;
    display: block;
    font-weight: 400;
    font-size: 0.8rem;
    text-decoration: none;

    &:hover {
      text-decoration: none;

      .label {
        text-decoration: underline;
      }
    }

    &.active {
      .label {
        font-weight: bold;
      }
    }
  }

  .label {
    display: block;
    max-width: 100%;
    .ellipsis();
  }

  .secondRow {
    display: flex;
    justify-content: space-between;
    margin: 0.3rem 0 0;
    color: @lib__colors__N700Medium;
  }
}

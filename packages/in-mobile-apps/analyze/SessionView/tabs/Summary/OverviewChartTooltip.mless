@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .tooltipWrapper {
    padding: 0.5rem;
  }

  .labelRow {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .label {
    max-width: 15rem;
    .ellipsis();
    font-weight: bold;
  }

  .timings {
    list-style: none;
    margin: 0;
  }

  .timing {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .key {
    color: @lib__colors__N800Dark;
    font-weight: 500;
    margin-right: 1rem;
  }

  .value {
    color: @lib__colors__N900Primary;
    margin: 0;
  }
}

@import '~in-themes/active.less';

:local {
  .group {
    border-top: 1px solid @lib__colors__N400;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;

    &:hover, &:focus {
      outline: 0;
      background: @lib__colors__N300;
      cursor: pointer;
    }
  }

  .left {
    display: flex;
    align-items: center;
  }

  .viewName {
    font-size: .875rem;
    font-weight: 500;
    color: @lib__colors__N600Light;
    margin: 0 0 0 0.5rem;
  }

  .beacons {
    margin: 1rem 1.5rem 1rem;
  }

  .viewIcon {
    fill: @lib__colors__N900Primary;
  }

  .learnHow {
    margin: 0 0 0 1rem;
  }
}

:local {
  .group {
    border-top: 1px solid var(--ids-color-option-neutral-400);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;

    &:hover,
    &:focus {
      outline: 0;
      background: var(--ids-color-option-neutral-300);
      cursor: pointer;
    }
  }

  .left {
    display: flex;
    align-items: center;
  }

  .viewName {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ids-color-option-neutral-600);
    margin: 0 0 0 0.5rem;
  }

  .beacons {
    margin: 1rem 1.5rem 1rem;
  }

  .viewIcon {
    fill: var(--ids-color-option-neutral-900);
  }

  .learnHow {
    margin: 0 0 0 1rem;
  }
}

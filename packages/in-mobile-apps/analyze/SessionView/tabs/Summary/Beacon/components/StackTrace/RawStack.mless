@import '~in-themes/mixins.less';

:local {
  pre.code {
    padding: 1rem;
    background: var(--ids-color-option-neutral-200);
    border-radius: var(--ids-border-radius-option-small);
  }

  .address {
    color: var(--ids-color-option-neutral-500);
    .ellipsis();
    flex-shrink: 0;
    margin: 0 0.375rem;
  }

  .selectedLine {
    background: var(--ids-color-option-neutral-300);
  }
}

:local {
  .dialog {
    width: 59rem;
  }

  .removableRow {
    display: flex;
    justify-content: space-between;
  }

  .removeButton {
    fill: var(--ids-color-option-blue-500);
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 1.6rem;
  }

  .addButton {
    margin-bottom: 1rem;
  }

  .snippetWrapper {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .snippet {
    flex-grow: 1;
    margin: 0 1rem 0 0;
  }

  .input {
    width: 100%;
    margin-right: 0.5rem;
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }
}

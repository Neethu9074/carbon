:local {
  .group {
    margin-bottom: 0;
  }

  .actionWrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .input {
    width: 100%;
    height: 31px;
  }

  .button {
    flex-shrink: 0;
    margin-left: 1rem;
  }
}

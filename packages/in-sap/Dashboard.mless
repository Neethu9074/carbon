:local {
  .icon {
    fill: var(--ids-color-option-neutral-500);
    margin-right: 0;
  }

  .label {
    color: var(--ids-color-option-neutral-500);
    font-weight: bold;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .center {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }

  .row {
    display: flex;
    flex-direction: row;
    justify-content: center;
    height: 100%;
  }

  .container {
    display: flex;
    width: 300px;
    height: 100px;
  }

  .availcontainer {
    display: flex;
    width: 200px;
  }

  .table {
    width: '100%';
    font-weight: bold;
    flex: 1;
  }

  .leftcontent {
    flex: 1;
    padding: 5px;
    font-weight: bold;
    border-spacing: 5px;
  }

  .rightcontent {
    display: flex;
    padding: 5px;
    align-items: center;
    border-spacing: 5px;
  }
}

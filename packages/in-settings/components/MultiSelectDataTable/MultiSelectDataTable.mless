:local {
  .actionIcons {
    text-align: end !important;
  }
  .loadingIcon {
    padding: 0 14px;
  }
  .tableBatchAction {
    :global {
      .cds--batch-summary__para {
        margin-bottom: 0;
      }
    }
  }
  .emptyState {
    padding: 16px;
    align-items: center;
  }
  .toastContainer {
    position: fixed;
    top: 6rem;
    right: 1.25rem;
    z-index: var(--ids-z-index-option-message-flyout);
  }
}

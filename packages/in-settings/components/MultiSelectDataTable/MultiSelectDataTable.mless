:local {
  .actionIcons {
    text-align: end !important;
  }
  .loadingIcon {
    padding: 0 14px;
  }
  .tableBatchAction {
    :global {
      .cds--batch-summary__para {
        margin-bottom: 0;
      }
    }
  }
  .emptyState {
    padding: 16px;
    align-items: center;
  }
  .toastMessage {
    width: auto;
    :global(.cds--toast-notification__subtitle) {
      margin-bottom: 0;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .line {
    height: 1px;
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .saveCancelRow {
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .button {
    min-width: 5.5rem;
    margin: 0 0.5rem;
  }
}

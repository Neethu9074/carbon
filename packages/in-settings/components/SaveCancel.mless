:local {
  .line {
    height: 1px;
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .saveCancelRow {
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .button {
    min-width: 5.5rem;
    margin: 0 0.5rem;
  }

  .saveButtonIntegrationContainer {
    display: flex;
    flex-direction: row;
    margin: 1rem 0;
  }

  .integrationButton {
    min-width: 5.5rem;
    background-color: var(--cds-link-primary);
    color: var(--ids-color-option-white);
    &:hover {
      background-color: var(--cds-background-inverse-hover);
    }
  }
}

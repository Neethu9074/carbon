@import '~in-themes/mixins.less';

:local {
  .icon {
    margin-right: 0.5rem;
    vertical-align: text-bottom;
  }

  .header {
    .breakWord();
    padding: 1.5rem 0 0.25rem;
    font-size: 1.5rem;
    font-weight: 500;
    display: inline-block;
  }
}

:local {
  .unsavedDialogContainer {
    & > button {
      margin-right: -0.75rem;
    }
  }

  .unsaveModalWrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .unsaveModalButtons {
    display: flex;
    justify-content: center;
    padding: 0.5rem 1.5rem;
    margin: -1.5rem;
    gap: 1.2rem;
    background: var(--ids-color-option-neutral-400);
  }

  .unsaveModalContent {
    margin-bottom: 3rem;
    & > span {
      font-size: 1rem;
    }
  }
}

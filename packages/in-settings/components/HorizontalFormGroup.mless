:local {
  .helpTextWrapper {
    display: flex;
    justify-content: flex-start;
    align-items: center;

    padding: 0.5rem 1rem;

    border-bottom: 1px solid var(--ids-color-option-neutral-300);

    &:nth-child(even) {
      background: var(--ids-color-option-neutral-50);
    }
  }

  .withoutBottomBorder {
    border-bottom: 0;
  }

  .helpIconSpacer {
    width: 1rem;
  }

  .group {
    flex-grow: 1000;

    height: 2rem;
    display: flex;
    align-items: center;
    position: relative;
    justify-content: space-between;

    & label {
      margin: 0 0.625rem;
    }
  }

  .groupWithoutHelp {
    & label {
      margin: 0;
    }
  }
}

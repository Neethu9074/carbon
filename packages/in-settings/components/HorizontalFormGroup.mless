@import '~in-themes/active.less';

:local {

  .group {
    display: flex;
    align-items: center;

    border-bottom: 1px solid @lib__colors__N300;
    padding: 0.5rem 1rem 0.5rem 1.625rem;

    & > label {
      margin: 0 0.625rem;
    }

    &:nth-child(even) {
      background: @lib__colors__N050;
    }
  }
}

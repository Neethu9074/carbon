@import '~in-themes/mixins.less';

:local {
  .sectionHeading {
    align-items: center;
    color: var(--cds-text-primary);
    display: flex;
    font-size: 1rem;
    font-weight: bold;
    margin: 0 0 1.5rem;
    padding-top: 1rem;

    & + .sectionHelp {
      margin-top: -0.7rem;
      margin-bottom: 1.3rem;
    }
  }

  .sectionHeadingWithoutTopPadding {
    padding-top: 0;
  }

  .sectionHelp {
    .bodyCopy();
    font-weight: 300;

    & > p:last-child {
      margin-bottom: 0;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .sectionHeading {
    align-items: center;
    color: @lib__colors__primary1;
    display: flex;
    font-size: 1rem;
    font-weight: bold;
    margin: 0 0 1.5rem;
    padding-top: 1rem;

    & + .sectionHelp {
      margin-top: -0.7rem;
      margin-bottom: 1.3rem;
    }
  }

  .sectionHeadingWithoutTopPadding {
    padding-top: 0;
  }

  .sectionHelp {
    font-size: .9rem;
    font-weight: 100;
    line-height: 1.4;

    & > p:last-child {
      margin-bottom: 0;
    }
  }
}

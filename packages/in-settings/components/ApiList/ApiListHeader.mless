@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.5rem 0 0.5rem 0.5rem;
  }

  .right {
    display: flex;
    align-items: center;
  }

  .itemName {
    text-transform: capitalize;
    font-size: 1.375rem;
  }

  .itemCount {
    color: @lib__colors__N500;
  }

  .searchInput {
    margin-left: 0.5rem;
  }
}

:local {
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.5rem 0 0.5rem 0.5rem;
  }

  .right {
    display: flex;
    align-items: center;
  }

  .itemName {
    text-transform: capitalize;
    font-size: 1.375rem;
  }

  .itemCount {
    color: var(--ids-color-option-neutral-500);
    margin-left: 0.25rem;
  }

  .searchInput {
    margin-left: 0.5rem;
  }

  .paginationWrapper {
    display: flex;
    justify-content: center;
    margin: 1rem 0;
  }
}

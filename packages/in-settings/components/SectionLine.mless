:local {
  .line {
    height: 1px;
    width: 100%;
    background: var(--ids-color-option-neutral-300);
  }

  .marginBottom {
    margin-bottom: 1.25rem;
  }

  .fullWidth {
    position: relative;

    &:after,
    &:before {
      background: var(--ids-color-option-neutral-300);
      position: absolute;
      content: '';
      height: 1px;
      width: 100%;
    }

    &:after {
      right: -100%;
    }

    &:before {
      left: -100%;
    }
  }
}

:local {
  .createNewButton {
    margin-right: 1.5rem;
  }

  a:not([href]):not([tabindex]).createNewButton {
    color: var(--ids-color-option-teal-500);
  }

  .selectCheckbox {
    padding-top: 0.95rem !important;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .selectCheckboxHead {
    width: 2rem;
  }

  .headerWithSelectAllButton {
    margin-right: 0.5rem;
  }

  .deleteWrapper {
    text-align: right;
  }
  .deleteIcon {
    margin-left: 0.5rem;
  }
  .withBottomPadding {
    padding-bottom: 5rem;
  }

  .icon {
    fill: var(--ids-color-option-blue-500);
  }

  .disabled {
    opacity: 0.6;
    cursor: default;
  }
}

@import '~in-themes/active.less';

:local {
  .createNewButton {
    margin-right: 1.5rem;
  }

  .selectCheckbox {
    padding-top: 0.95rem !important;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .selectCheckboxHead {
    width: 2rem;
  }

  .headerWithSelectAllButton {
    margin-right: 0.5rem;
  }

  .deleteWrapper {
    text-align: right;
  }
}

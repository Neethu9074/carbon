@import '~in-themes/active.less';

:local {
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;

    margin-top: 2rem;
    padding-top: 0.5rem;

    border-top: 1px solid @lib__colors__N300;
  }

  .messageWrapper {
    width: 100%;
    margin-bottom: 1rem;
  }

  .buttonLine {
    display: flex;
    align-items: center;
  }
}

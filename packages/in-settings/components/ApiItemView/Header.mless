@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .backNavigationWrapper {
    display: flex;
    align-items: center;

    font-size: 0.875rem;
  }

  .icon {
    margin-right: 0.5rem;

    fill: @lib__colors__blue800;
  }
}

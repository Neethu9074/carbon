:local {
  .column {
    display: flex;
    align-items: center;
  }

  .inputEditSection {
    display: flex;
  }

  .inputField,
  .readonlyLabel {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .readonlyExtra {
    font-weight: 300;
    font-size: 0.875rem;
    color: var(--ids-color-option-neutral-500);
    margin-left: 0.75rem;
  }

  .editIcon,
  .saveButton {
    margin-left: 0.25rem;
  }

  .deleteButton {
    margin-right: 0.75rem;
  }
}

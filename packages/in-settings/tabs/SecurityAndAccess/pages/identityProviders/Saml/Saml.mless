:local {
  .list {
    margin: 0.5rem 0;
    padding: 0 0 0 1rem;

    & > li {
      line-height: 1rem;
    }
  }

  .input {
    width: 100%;

    margin-right: 0.5rem;
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .descriptionText {
    max-width: 50rem;
  }
  .samlForm {
    &_fileContainer {
      :global .cds--btn ~ .cds--file-container {
        display: none;
      }
    }
    &_selectedFile {
      max-inline-size: none;
      p {
        margin-bottom: 0;
      }
      :global .cds--file__selected-file {
        max-inline-size: none;
        p {
          margin-bottom: 0;
        }
      }
    }
  }
}

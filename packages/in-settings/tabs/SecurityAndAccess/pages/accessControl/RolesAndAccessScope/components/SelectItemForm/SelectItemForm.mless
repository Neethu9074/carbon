:local {
  .wrapper {
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
  }

  .content {
    height: 100%;
    padding: 0 1.5rem 1.5rem;
    overflow: auto;
  }

  .subHeader {
    padding: 0.5rem 1.5rem 1rem;
  }
}

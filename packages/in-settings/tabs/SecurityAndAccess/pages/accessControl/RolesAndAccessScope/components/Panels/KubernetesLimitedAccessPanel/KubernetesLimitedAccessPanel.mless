:local {
  .contentHeader {
    display: block;
    align-items: center;
    gap: var(--ids-border-radius-option-large);
    padding: var(--ids-border-radius-option-large);
    background: var(--ids-color-option-neutral-200);
    border: 1px solid var(--ids-color-option-neutral-300);
    border-left: none;
    border-right: none;
  }
}

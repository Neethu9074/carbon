:local {
  .menuButtonsContainer {
    position: relative;
  }

  .menuButtonsWrapper {
    padding: var(--cds-layout-density-padding-inline-normal);
    position: absolute;
    right: 0;
    top: 0;
    z-index: var(--ids-z-index-option-map-overlay-controls);
  }
}

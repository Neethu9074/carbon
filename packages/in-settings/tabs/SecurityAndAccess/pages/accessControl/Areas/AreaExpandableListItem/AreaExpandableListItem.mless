:local {
  .container {
    display: flex;
    width: 70%;
    align-items: center;
  }

  .iconContainer {
    display: flex;
    align-items: center;
    width: 2.5rem;
  }

  .icon {
    fill: var(--ids-color-option-neutral-900);
  }

  .column {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .columnsContainer {
    width: 100%;
    max-width: 70%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .secondColumnContainer {
    min-width: 15rem;
  }

  .skeleton {
    display: block;

    width: 100%;
    height: 1rem;

    margin: 0.1rem 0;
  }

  .iconDisabled {
    fill: var(--ids-color-option-neutral-400);
  }

  .listItemDisabled {
    padding: 0.5rem 1rem;
    background: var(--ids-color-option-neutral-50);
  }

  .columnDisabled span {
    color: var(--ids-color-option-neutral-500);
  }
}

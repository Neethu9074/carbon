:local {
  .cards {
    display: flex;
  }

  .nameAndDescriptionCard {
    :global(.c4p--card__footer) {
      justify-content: right;
    }
    :global(.cds--text-input) {
      background-color: var(--cds-background);
    }
    :global(.cds--text-area) {
      background-color: var(--cds-background);
    }
  }

  .row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    column-gap: 1rem;
    margin-bottom: 1rem;
    margin-top: 1rem;
  }

  .column {
    display: flex;
    flex-direction: column;
    flex-basis: 100%;
    flex: 1;
  }
}

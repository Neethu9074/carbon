:local {
  .icon {
    margin-right: 0.5rem;

    fill: var(--ids-color-option-neutral-600);
  }

  .titleSkeleton {
    display: block;

    width: 200px;
    height: 1rem;

    margin-right: 0.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: 0.5rem 1rem;

    width: 30rem;

    margin-top: 2rem;
  }

  .pointer {
    cursor: pointer;
  }

  .confirmationDialog {
    display: inline-block;
    font-size: var(--ids-font-size-option-body-large);
  }

  .confirmationDialogButton {
    margin-top: 2rem;
  }
}

:local {
  .headline {
    display: flex;
    align-items: center;
  }

  .avatar {
    margin-right: 0.75rem;
  }

  .roles {
    max-width: 17rem;
  }

  .nameSkeleton {
    display: block;

    width: 200px;
    height: 1rem;

    margin-right: 0.5rem;
  }

  .title {
    font-size: 1.25rem;
    font-weight: 600;
  }
}

:local {
  .qrCanvas {
    width: 10rem;
    height: 10rem;
    margin: 1.5rem 4rem;
  }

  .input {
    width: 9rem;
  }

  .scratchCodesSection {
    margin-top: 2rem;
  }

  .scratchCodes {
    padding: 0 0 0 2rem;
  }

  .scratchCode {
    padding: 0.25rem 0;
    font-size: 0.875rem;
  }
}

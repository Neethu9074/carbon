@import '~in-themes/active.less';

:local {
  .form {
    display: flex;
    flex-direction: column;
    color: @lib__colors__N700Medium;
    font-size: @lib__typography__body-bold__font-size;
  }

  .flexColumn {
    display: flex;
    flex-direction: column;
  }

  .role,
  .messageBox {
    margin: 2rem 0;
  }

  .greyText {
    color: @lib__colors__N600Light;
  }
}

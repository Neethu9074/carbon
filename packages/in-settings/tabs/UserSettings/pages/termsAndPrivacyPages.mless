@import '~in-themes/active.less';

:local {
  .form {
    display: flex;
    flex-direction: column;
    color: var(--ids-color-option-neutral-700);
    font-size: var(--ids-font-size-option-body-bold);
  }

  .flexColumn {
    display: flex;
    flex-direction: column;
  }

  .role,
  .messageBox {
    margin: 2rem 0;
  }

  .greyText {
    color: var(--ids-color-option-neutral-600);
  }
}

:local {
  .page {
    padding: 0;
  }
  .titleSection {
    padding: 0.5rem 0 1rem 0;
  }
  .timeRange {
    display: grid;
    grid-template-columns: 8rem 1fr;
    grid-auto-rows: auto;
    gap: 3rem;

    label {
      display: flex;
      align-items: center;
      margin: 0;
      gap: 0.25rem;
      font-weight: 600;
    }
  }
  .noLogVolumeData {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 1rem;
    padding: 3rem;
  }
}

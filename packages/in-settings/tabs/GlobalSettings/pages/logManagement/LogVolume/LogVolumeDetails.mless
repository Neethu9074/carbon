:local {
  .tableGrid {
    display: grid;
    grid-template-areas: 'label . gb gb arrow';
    grid-template-columns: 16rem auto 10rem 10rem 2rem;
    justify-content: normal;
  }

  .logVolumeCategories {
    .tableGrid();
    padding: 0.75rem 0.75rem 0.75rem 2rem;
    font-weight: bold;
    background-color: var(--ids-color-option-white);
    color: var(--ids-color-option-neutral-600);
    border: none;
    outline: none;
    position: relative;
  }

  .logVolumeCategories:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 2rem;
    bottom: 0;
    width: calc(100% - 4rem);
    height: 1px;
    background-color: var(--ids-color-option-neutral-300);
  }

  .logVolumeCategories:first-child {
    border-top: 1px solid var(--ids-color-option-neutral-400);
  }

  .tableGB {
    grid-area: gb;
    display: flex;
    justify-content: right;
  }

  .tableLabel {
    grid-area: label / span 2;
    justify-content: left;
    display: flex;
  }

  .LogVolumeDetailsContainer {
    margin: 2rem 0;
  }

  .LogVolumeDetails {
    .tableGrid();
    background: #e6e6e6;
    padding: 1.25rem;

    span {
      font-size: 1.5rem;
      font-weight: 500;
    }
  }

  .retentionDays {
    .tableGrid();
    align-items: center;
    width: 100%;
    font-weight: bold;
    color: black;
  }

  .logVolumeItems {
    border: none;
    li {
      font-weight: 600;
      display: flex;
      justify-content: space-between;
    }
  }

  .collapseRow {
    vertical-align: middle;
    margin-left: 1rem;
    grid-area: arrow;
  }

  .loadingMock {
    padding-top: 2rem;
  }

  .loadingIndicator {
    display: block;
    width: auto;
  }

  .skeleton {
    .loadingIndicator();
    height: 12rem;
    margin: 0 var(--cds-layout-density-padding-inline-local) var(--cds-layout-density-padding-inline-local)
      var(--cds-layout-density-padding-inline-local);
  }
}

.retentionPeriod {
  display: flex;
  padding: 0;
  flex-direction: column;

  svg {
    place-self: center;
  }

  > section {
    transition: background-color 150ms ease-in-out;
    &:first-of-type {
      padding: 0.75rem 1rem;
    }
    width: 100%;
  }
}

.retentionPeriodWithGroups {
  &:hover {
    cursor: pointer;
    background-color: #e6e6e6;
  }
}

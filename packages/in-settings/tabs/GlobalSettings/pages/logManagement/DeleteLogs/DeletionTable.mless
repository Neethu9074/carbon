:local {
  .deleteButton {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
  }

  .deletionTable {
    margin-top: 1rem;
    border: 1px solid var(--ids-color-option-neutral-400);
  }

  .stateContainer {
    display: grid;
    place-items: center;
    width: 100%;
    height: 32rem;
  }

  .emptyState {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .skeleton {
    display: block;

    width: 80%;
    height: 1rem;

    margin-right: 0.5rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .deleteLogsSummaryCard {
    padding: 1rem 1rem 0 0;
  }

  .deleteLogsTableCard {
    padding: 0;
  }

  .emptyTable {
    background-color: white;

    :global(.cds--data-table tbody) {
      display: none;
    }
    :global(.table-row) {
      display: grid;
    }
  }

  .statusIcon {
    display: grid;
    place-items: center;
  }

  .spinner {
    max-height: 18px;
    max-width: 18px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid #c6c6c6;
    border-right-color: var(--cds-link-primary);
    animation: l2 1s infinite linear;
  }
  @keyframes l2 {
    to {
      transform: rotate(1turn);
    }
  }
}

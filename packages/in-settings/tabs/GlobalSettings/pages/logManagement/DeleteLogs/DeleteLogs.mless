:local {
  .dialog {
    > div {
      max-width: 40rem;
      min-width: 40rem;
    }
  }

  .tearsheet {
    > div {
      width: calc(100% - 8rem) !important;
      height: calc(100% - 8rem) !important;
      position: absolute !important;
      top: 5rem !important;
    }
  }

  .confirmationDescription {
    margin-bottom: 0.5rem;
  }

  .titleSection {
    display: flex;
    align-items: center;
    justify-content: space-between;
    > div {
      > h1 {
        padding: 0;
      }
    }
  }

  .timeSection {
    display: flex;
    gap: 1rem;
  }

  .descriptionSection {
    padding: 0 0 1rem;
  }

  .noPadding {
    padding: 0;
    background: inherit;
  }

  .validationMessage {
    height: 0;
  }

  .underline {
    margin: 0 1ch;
    text-decoration: underline;
  }

  .hiddenHeading {
    visibility: hidden;
  }

  .untilDateInput {
  }
}

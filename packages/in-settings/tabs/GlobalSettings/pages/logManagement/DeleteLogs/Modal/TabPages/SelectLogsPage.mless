:local {
  .selectLogsContainer {
    padding: 2rem;
  }

  .selectLogsDescription {
    padding: 1rem 0; // suggestion: do layout in parent?
    font-size: 0.875rem; // better use cds-variables or
    // Typography component directly
    color: var(--cds-text-secondary);
  }

  .logsToDeleteCard {
    > div > div {
      padding: 0 !important;
      > span {
        font-weight: bold;
      }
    }
  }

  .selectLogsTimeSection {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    padding-bottom: 0.75rem;
  }

  .selectLogsTimePicker {
    min-width: 12rem;
    max-width: 12rem;
  }

  .loggingInteraction {
    display: flex;
    gap: 1rem;
    flex-direction: column;
  }

  .loggingInteraction > section:first-of-type {
    > div {
      background-color: var(--cds-layer);
      padding: 0;
    }
  }

  .loadingIndicator {
    display: block;
    width: 100%;
  }

  .skeleton {
    .loadingIndicator();
    height: 6rem;
    margin: 0 var(--cds-layout-density-padding-inline-local) var(--cds-layout-density-padding-inline-local)
      var(--cds-layout-density-padding-inline-local);
  }
}

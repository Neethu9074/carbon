:local {
  .confirmSelectionContainer {
    padding: 2rem;
  }

  .confirmSelectionTitle {
    font-size: 1.25rem;
  }

  .confirmSelectionDescription {
    padding: 1rem 0;
    font-size: 0.875rem;
    color: var(--cds-text-secondary);
  }
  .confimSelectionDetailsBox {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .confimSelectionDatesContainer {
    display: flex;
    flex-direction: row;
    gap: 4rem;
    > div {
      display: flex;
      flex-direction: row;
      gap: 1rem;
    }
  }
  .confimSelectionDatesContainer:nth-of-type(3) > div:nth-of-type(2) {
    margin-left: 2.6rem;
  }

  .confimSelectionDatesContainer:nth-of-type(2) {
    margin-bottom: 1rem;
  }

  .confimSelectionDetailsBox span:nth-of-type(2) {
    font-weight: bold;
  }
  .confimSelectionDatesContainer span:nth-of-type(2) {
    font-weight: bold;
  }

  .confirmSelectionDetails {
    padding: 2rem;
  }

  .confirmSelectionReasonInput {
    max-width: 18rem;
    padding: 2rem 0 1rem 0;
  }

  .confirmSelectionValidationInput {
    max-width: 18rem;
    padding: 1rem 0;
  }
}

:local {
  .configurator {
    // same height as all other input fields on this page
    height: 2rem;

    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1.6;

    color: var(--query-builder-element-color);

    padding: 0.1875rem 0 0.1875rem 0.4375rem;
    background: var(--ids-color-option-neutral-50);

    flex: 1 0 8rem; // 8rem to easily fit into narrow AlertConfig dialog

    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-medium);

    display: flex;
    align-items: center;
    justify-content: flex-start;

    cursor: pointer;
  }
  .configuratorWithSecondLevelKey {
    border-right: none;
  }

  .selectPayloadButton {
  }

  .tagName {
    margin-right: 0.5rem;
    background: transparent;
    flex: 1 1 0%;
    min-width: 5rem;
    max-width: max-content; // to avoid unneeded extra "gap"

    white-space: nowrap; // do not wrap into 2 lines, but cut overflow
    overflow: hidden;
    text-overflow: ellipsis;

    &:focus,
    &:active,
    &:hover {
      outline: none;
      color: var(--ids-color-option-blue-400);

      .icon {
        fill: var(--ids-color-option-blue-400);
      }
    }
  }

  .icon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem;

    fill: var(--ids-color-option-neutral-400);
  }

  .keyEqualsOperator {
    padding: 0.0225rem 0.3125rem;
    margin: -0.25rem 0;
    border: none;
    border-left: 1px solid var(--ids-color-option-neutral-300);
    line-height: 2;

    white-space: nowrap;

    background: var(--ids-color-option-neutral-50);
  }

  // To enforce expanding and filling the possible width
  .keyNameValue {
    flex: 1 1 0%;
    width: 2rem;
  }
}

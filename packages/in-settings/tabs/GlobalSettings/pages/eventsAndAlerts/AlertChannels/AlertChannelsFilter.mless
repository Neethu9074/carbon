@import '~in-themes/mixins.less';

:local {
  .filterButton {
    width: 3rem;
    block-size: 3rem;
  }
  .header {
    padding: 0.5rem 1rem 0.5rem 1rem;
  }

  .content {
    padding: 0rem 1rem 1rem 1rem;
    overflow-y: scroll;
    height: 20rem;
  }

:local {
  .inputDeleteWrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .input {
    width: 100%;
    margin-right: 1rem;
  }

  .inputContainer {
    width: 100%;
  }

  .deleteButton {
    align-items: center;
    width: 6.25rem;
    height: 1.75rem;
    padding: 0 0.938rem;
  }

  .addButtonWrapper {
    display: flex;
    justify-content: flex-end;
    margin: 0 0.188rem 0.563rem 0;
  }

  .addLink {
    text-decoration: underline;
    cursor: pointer;
  }

  .inputCheckboxWrapper {
    margin-bottom: 1rem;
  }

  .inHelpifyWrapper {
    justify-content: flex-start;
    align-items: center;
  }

  .inHelpifyWrapperContent {
    display: flex;
    align-items: center;
    width: fit-content;
  }

  .usernameLabel {
    margin-bottom: 0;
  }
  .emailsEventTypeDropdown {
    width: 18.75rem;
  }
  .textAreaInput {
    width: 21.1rem;
  }
  .lettering {
    filter: brightness(0);
  }
  .previewBox {
    width: 37.5rem;
    border: 0.125rem var(--ids-color-option-neutral-400) solid;
    padding: 1rem;
  }
  .previewOpenStatus {
    width: 35rem;
    height: 0.625rem;
    background-color: var(--ids-color-option-yellow-500);
  }
  .previewClosedStatus {
    width: 35rem;
    height: 0.625rem;
    background-color: var(--ids-color-option-green-500);
  }
  .previewChangeStatus {
    width: 35rem;
    height: 0.625rem;
    background-color: var(--ids-color-option-neutral-500);
  }
  .descriptionText {
    color: var(--ids-color-option-neutral-600);
  }
}

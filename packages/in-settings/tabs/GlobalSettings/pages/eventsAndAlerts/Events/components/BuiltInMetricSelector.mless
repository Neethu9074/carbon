:local {
  .item {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ids-color-option-neutral-700);
    cursor: pointer;

    &:hover {
      background-color: rgba(230, 239, 255, 0.69);
    }

    &.selected {
      background-color: rgba(230, 239, 255, 0.69);
    }
  }

  .subtleMetric {
    font-weight: 100;
    color: var(--ids-color-option-neutral-500);
    margin-left: 0.25rem;
  }
}

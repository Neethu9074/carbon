:local {
  .wrapper {
    position: relative;
  }
  .inputGroup {
    display: flex;
    align-items: center;
    color: #333;
    background-color: var(--ids-color-option-neutral-50);
    background-image: none;
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-medium);
    font-size: 0.75rem;
    position: relative;
  }

  .inputGroupOpen {
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background: var(--ids-color-option-white);
    border-color: #b3b3b3 #ccc #d9d9d9;
    position: relative;
  }

  .input {
    flex-grow: 1;
    background: none transparent;
    border: 0 none;
    cursor: default;
    display: inline-block;
    box-shadow: none;
    font-family: inherit;
    font-size: inherit;
    margin: 0;
    outline: none;
    line-height: 1.0625rem;
    padding: 0.5rem 0 0.5rem 0.625rem;
  }

  .list {
    padding: 0;
    margin: 0;
    border: 1px solid var(--ids-color-option-neutral-400);
    border-collapse: collapse;
    max-height: 12.875rem;
    overflow-y: scroll;
    position: absolute;
    left: 0;
    width: 100%;
    background: #fff;
    z-index: 1;
  }

  .listClosed {
    background: none transparent;
    border: 0 none;
    padding: 0;
    margin: 0;
  }

  .listItem {
    list-style: none;
    padding: 0.5rem 0.625rem;
    background-color: white;
    cursor: pointer;
  }

  .listItemNoResult {
    list-style: none;
    padding: 0.5rem 0.625rem;
    color: #757575;
  }

  .toggleButton {
    fill: var(--ids-color-option-neutral-500);
  }

  .clearButton {
    fill: var(--ids-color-option-neutral-500);
    padding: 0.188rem;
    border-left: solid 1px var(--ids-color-option-neutral-300);
  }
  .higlightedText {
    color: var(--ids-color-option-teal-500);
  }
  .gap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .elementsWrapper {
    display: grid;
    grid-template-columns: 89% 10%;
    gap: 0.25rem;
    align-items: stretch;
  }

  .comboHighlightedText {
    background: var(--cds-highlight);
    font-weight: var(--cds-heading-01-font-weight);
  }
}

:local {
  .header {
    font-size: var(--ids-font-size-option-body-bold);
  }

  .ruleBoxWithBorder {
    padding: 1rem;
    border: 1px solid var(--ids-color-option-neutral-400);
  }

  .conditionWrapper {
    flex: 1;
  }

  .disabledDelete,
  .disabledDelete:focus,
  .disabledDelete:hover {
    cursor: not-allowed;
    outline: none;
  }

  .deleteMargin {
    margin-top: 1rem;
  }

  .logicalOperator {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
}

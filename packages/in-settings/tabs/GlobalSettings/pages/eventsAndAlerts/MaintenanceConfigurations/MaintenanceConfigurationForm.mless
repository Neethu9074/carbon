:local {
  .messageWrapper {
    margin-bottom: 1rem;
  }

  .submessageWrapper {
    margin-top: 0.5rem;
  }

  .unscheduleButton {
    margin-top: 1.5rem;
    margin-right: 1rem;
  }

  .queryLoading {
    height: 13px;
    margin: 0.5rem 0;
  }
  .mwWrapper {
    grid-column: 1 / span 3;
    margin-bottom: 5rem;
  }
  .labelWithTooltip {
    label {
      margin-right: 0.5rem;
      margin-bottom: 0;
    }
  }
  .smallInput {
    width: 4rem;
  }
  .medInput {
    width: 5rem;
  }
  .largeInput {
    width: 8rem;
  }
  .inputContainer {
    width: 65%;
    margin: 0.5rem;
  }

  .previewContainer {
    background-color: #fafbfc;
    height: 10rem;
    padding: 0.5rem;
    border: 1px solid #dfe4e8;
    margin-left: 0.5rem;
  }
  .stepTitle {
    font-size: var(--ids-font-size-option-heading-200);
    font-weight: 600;
    line-height: 1.5rem;
    // allow beta badge placed besides the title
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .timezoneMessage {
    width: 85%;
  }
  .gap {
    gap: 1rem;
  }
  .bottomSpace {
    padding-bottom: 0.5rem;
  }
  .previewBadge {
    margin-top: 0;
    margin-bottom: 0;
  }
}

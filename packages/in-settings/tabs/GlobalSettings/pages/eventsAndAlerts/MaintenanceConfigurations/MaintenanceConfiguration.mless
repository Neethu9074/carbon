:local {
  .headerIcon {
    display: inline-block;
    position: relative;
    top: 0.5rem;
  }
  .dialog {
    width: 75vw;
    max-height: 90vh;
    height: calc(100vh - 14rem);
    padding-bottom: 6rem;
  }
  .simpleDialog {
    width: 60vw;
    height: fit-content;
  }
  .shareFeedback {
    padding: 0;
    width: fit-content;
  }
}

@import '~in-themes/active.less';

:local {
  .flexWrapper {
    display: flex;
    align-items: center;
  }
  .keyValueEllipsis {
    white-space: normal !important;
    text-overflow: ellipsis;
    overflow: initial;
  }

  .searchInput {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    padding-bottom: 0.5rem;
  }

  .hide {
    display: none;
  }

  .fontItalic {
    font-style: italic;
  }

  .infoIcon {
    margin-left: 0.5rem;
    fill: @lib__colors__N400;
  }

  .stateDropdown {
    margin-right: 0.5rem;
    width: 12rem;
  }

  .selectAll {
    padding-bottom: 0.5rem;
    font-style: italic;
  }

  .reportSummary {
    display: flex;
    align-items: center;
  }

  .grid {
    display: grid;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .container {
    width: max-content;
    margin: 0 0 0.5rem 0;
  }

  .noBottomMargin {
    margin: 0;
  }

  .icon {
    margin: 0 0.5rem 0 0;
  }

  .ellipsis {
    .ellipsis();
  }

  .noImport {
    max-width: 0.75rem;
    max-height: 0.75rem;
    min-width: 0.75rem;
    min-height: 0.75rem;
    border-radius: 50%;
    background-color: #ccd1d7;
  }

  .padNoImportLabel {
    margin-left: 1.25rem;
  }

  .padIcon {
    margin-left: 0.5rem;
    padding-right: 0.75rem;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .apiTokenColContainer {
    .flexbox();

    div:first-of-type {
      min-width: 30%;
      font-style: italic;
    }
  }

  .confirmationDialog {
    display: inline-block;
    font-size: @lib__typography__body-large__font-size;
  }

  .confirmationDialogButton {
    margin-top: 2rem;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .apiTokenColContainer {
    .flexbox();

    div:first-of-type {
      min-width: 30%;
      font-style: italic;
    }
  }

  .confirmationDialog {
    display: inline-block;
    font-size: @lib__typography__body-large__font-size;
  }

  .confirmationDialogButton {
    margin-top: 2rem;
  }

  .apiTokenLabel {
    font-size: 1.25rem;
    font-weight: 600;
  }

  // do to styles in reboot.lees for :not([href]):not([tabindex])
  // this is the only location we see this, so fixing it locally
  a:not([href]):not([tabindex]),
  a:not([href]):not([tabindex]):hover,
  a:not([href]):not([tabindex]):focus {
    color: var(--colors-primary1);
  }
}

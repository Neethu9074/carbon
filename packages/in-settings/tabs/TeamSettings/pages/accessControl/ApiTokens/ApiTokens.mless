@import '~in-themes/mixins.less';

:local {
  .apiTokenColContainer {
    .flexbox();

    div:first-of-type {
      font-style: italic;
      .ellipsis();
    }
  }

  .confirmationDialog {
    display: inline-block;
    font-size: var(--ids-font-size-option-body-large);
  }

  .confirmationDialogButton {
    margin-top: 2rem;
  }

  .confirmationDialogMessage {
    max-width: 32rem;
  }

  .apiTokenLabel {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .message {
    white-space: pre;
  }
}

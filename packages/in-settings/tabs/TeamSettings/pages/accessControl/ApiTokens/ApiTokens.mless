@import '~in-themes/mixins.less';

:local {
  .apiTokenColContainer {
    .flexbox();

    div:first-of-type {
      min-width: 30%;
      font-style: italic;
    }
  }

  .confirmationDialog {
    display: inline-block;
    font-size: var(--ids-font-size-option-body-large);
  }

  .confirmationDialogButton {
    margin-top: 2rem;
  }

  .apiTokenLabel {
    font-size: 1.25rem;
    font-weight: 600;
  }
}

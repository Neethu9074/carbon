@import '~in-themes/mixins.less';

:local {
  .allProperties {
    display: flex;
    flex-direction: row;
    overflow-x: hidden;
  }

  .avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    margin-right: 1rem;
  }

  .narrowColumn {
    width: 4rem;
  }

  .ellipsis {
    .ellipsis();
  }
}

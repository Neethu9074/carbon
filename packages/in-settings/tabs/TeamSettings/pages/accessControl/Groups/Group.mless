@import '~in-themes/active.less';

:local {
  .headline {
    display: flex;
    align-items: center;
  }

  .icon {
    margin-right: 0.5rem;

    fill: @lib__colors__N600Light;
  }

  .title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .titleSkeleton {
    display: block;

    width: 200px;
    height: 1rem;

    margin-right: 0.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: 0.5rem 1rem;

    width: 30rem;

    margin-top: 2rem;
  }

  .pointer {
    cursor: pointer;
  }

  .confirmationDialog {
    display: inline-block;
    font-size: @lib__typography__body-large__font-size;
  }

  .confirmationDialogButton {
    margin-top: 2rem;
  }
}

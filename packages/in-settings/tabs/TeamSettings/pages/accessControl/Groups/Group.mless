@import '~in-themes/active.less';

:local {
  .headline {
    display: flex;
    align-items: center;
  }

  .icon {
    margin-right: 0.5rem;

    fill: @lib__colors__N600Light;
  }

  .title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .titleSkeleton {
    display: block;

    width: 200px;
    height: 1rem;

    margin-right: 0.5rem;
  }
}

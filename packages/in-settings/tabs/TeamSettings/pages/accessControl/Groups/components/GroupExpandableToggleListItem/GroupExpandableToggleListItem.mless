@import '~in-themes/active.less';

:local {
  .icon {
    fill: var(--ids-color-option-neutral-900);
  }

  .liOverride {
    display: flex;
    flex-direction: column;
  }

  .fullWidth {
    width: 100%;
  }

  .textContainer {
    display: flex;
    width: 20rem;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: center;
  }
}

@import '~in-themes/active.less';

:local {
  .container {
    display: flex;
    width: 100%;
    align-items: center;
  }

  .iconContainer {
    display: flex;
    align-items: center;
    width: 2.5rem;
  }

  .icon {
    fill: @lib__colors__N900Primary;
  }

  .column {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .columnsContainer {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .secondColumnContainer {
    min-width: 15rem;
  }

  .skeleton {
    display: block;

    width: 100%;
    height: 1rem;

    margin: 0.1rem 0;
  }

  .iconDisabled {
    fill: @lib__colors__N400;
  }

  .listItemDisabled {
    padding: 0.5rem 1rem;
    background: @lib__colors__N050;
  }

  .columnDisabled span {
    color: @lib__colors__N500;
  }
}

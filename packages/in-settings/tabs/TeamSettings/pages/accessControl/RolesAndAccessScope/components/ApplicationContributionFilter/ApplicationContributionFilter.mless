:local {
  .contributionFilter {
    border: 1px solid var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-option-small);
    padding: 1rem 1rem 0rem 1rem;
    margin-bottom: 1rem;

    &_applicationScope {
      div {
        margin: 0;
      }

      div:first-child {
        border: none;
        flex-direction: column-reverse;
        display: flex;

        div {
          padding-left: 0rem;
          padding-right: 0rem;
        }
      }
    }

    &_queryBuilder {
      margin: 1rem 0;
      display: block;
      align-items: center;
      width: 100%;
    }

    &_queryBuilderExpression {
      width: 85%;
      display: inline-block;
    }

    &_clearButton {
      width: 15%;
      display: inline-block;
    }

    &_groupLabel {
      display: flex;
      gap: 6px;
      flex-direction: column;
      width: 100%;
    }

    &_wrapper {
      margin-top: 1rem;
      &_servicesLiveList {
        div:first-child {
          margin-right: 0;
        }
      }
    }

    &_errorMessage {
      display: block;
      margin: 0.5rem 0;
      color: var(--ids-color-option-red-500);
    }
  }
}

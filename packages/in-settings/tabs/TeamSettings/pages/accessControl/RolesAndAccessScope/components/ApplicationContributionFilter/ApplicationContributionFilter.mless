:local {
  .contributionFilter {
    border: 1px solid var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-option-small);
    padding: 1rem 1rem 0rem 1rem;
    margin-bottom: 1rem;

    &_applicationScope {
      div label div {
        width: 100%;
        div:nth-of-type(2) {
          margin: 0;
        }
      }
      div:first-child {
        border: none;
        margin-bottom: 0;
        div {
          padding-left: 0;
        }
      }
    }
    &_queryBuilder {
      margin: 1rem 0;
      display: flex;
      align-items: center;
      width: 100%;
    }

    &_queryBuilderExpression {
      flex-grow: 1;
    }
    &_groupLabel {
      display: flex;
      gap: 6px;
      flex-direction: column;
      width: 30%;
    }
    &_wrapper {
      &_servicesLiveList {
        div:first-child {
          margin-right: 0;
        }
      }
    }
  }
}

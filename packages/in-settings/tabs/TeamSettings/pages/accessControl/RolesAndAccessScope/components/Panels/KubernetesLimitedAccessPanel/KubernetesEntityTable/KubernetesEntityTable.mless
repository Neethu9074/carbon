:local {
  .abbreviatedContent {
    display: inline-block;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    max-width: 29.21rem;
  }
  .obsolete {
    max-width: 27.45rem;
  }
}

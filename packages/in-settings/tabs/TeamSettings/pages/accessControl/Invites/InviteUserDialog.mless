:local {
  .dialogBody {
    width: 66.25rem;
    height: calc(100vh - 14rem);
    padding: 0 1.5rem;
    max-height: 40vh;
    overflow: auto;
  }

  .row {
    margin-bottom: -20px;
  }

  .button {
    margin-top: 10px;
  }

  .removeButton {
    fill: var(--ids-color-option-blue-500);
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 1rem;
  }

  .sentIcon {
    fill: var(--ids-color-option-green-500);
    flex-grow: 0;
    flex-shrink: 0;
    margin: 1.5rem 0 0 -0.5rem;
  }

  .message {
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .alreadyExistsIcon {
    fill: var(--ids-color-option-yellow-500);
    flex-grow: 0;
    flex-shrink: 0;
    margin: 1.5rem 0 0 -0.5rem;
  }

  .description {
    margin-bottom: 1rem;
  }
}

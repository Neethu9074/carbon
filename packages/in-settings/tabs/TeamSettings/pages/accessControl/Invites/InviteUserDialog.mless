@import '~in-themes/active.less';

:local {
  .dialog {
    max-height: 400px;
    overflow: scroll;
  }

  .row {
    margin-bottom: -20px;
  }

  .button {
    margin-top: 10px;
  }

  .removeButton {
    fill: @lib__colors__blue800;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 1.5rem 0 0 -0.5rem;
  }
}

@import '~in-themes/active.less';

:local {
  .dialog {
    max-height: 400px;
    overflow: auto;
  }

  .row {
    margin-bottom: -20px;
  }

  .button {
    margin-top: 10px;
  }

  .removeButton {
    fill: var(--ids-color-option-blue-500);
    flex-grow: 0;
    flex-shrink: 0;
    margin: 1.5rem 0 0 -0.5rem;
  }

  .sentIcon {
    fill: @lib__colors__green800;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 1.5rem 0 0 -0.5rem;
  }

  .message {
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .alreadyExistsIcon {
    fill: @lib__colors__yellow800;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 1.5rem 0 0 -0.5rem;
  }

  .description {
    margin-bottom: 1rem;
  }
}

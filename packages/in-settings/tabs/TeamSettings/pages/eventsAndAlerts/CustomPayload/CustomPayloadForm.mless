@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .row {
    vertical-align: top;
  }

  .colName,
  .colType,
  .colValue {
    width: 100%;
  }

  .prefix {
    padding-right: 0.25rem;
  }

  .key {
    flex: 1;
  }

  .delete {
    cursor: pointer;
    fill: @lib__colors__primary2;

    &:hover {
      fill: @lib__colors__N700Medium;
    }
  }

  .disabled {
    opacity: 0.6;
    cursor: default;
  }

  .controls {
    display: flex;
    align-items: center;
    height: 2rem;
  }

  .rightAligned {
    justify-content: flex-end;
  }
}

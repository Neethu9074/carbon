:local {
  .input-delete-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .input {
    width: 100%;
    margin-right: 1rem;
  }

  .delete-button {
    align-items: center;
    width: 6.25rem;
    height: 1.75rem;
    padding: 0 0.938rem;
  }

  .add-button-wrapper {
    display: flex;
    justify-content: flex-end;
    margin: 0 0.188rem 0.563rem 0;
  }

  .add-link {
    text-decoration: underline;
    cursor: pointer;
  }

  .input_checkbox_wrapper {
    margin-bottom: 1rem;
  }

  .in-helpify-wrapper {
    justify-content: flex-start;
    align-items: center;
    &__content {
      display: flex;
      align-items: center;
      width: fit-content;
    }
  }

  .username_label {
    margin-bottom: 0;
  }
}

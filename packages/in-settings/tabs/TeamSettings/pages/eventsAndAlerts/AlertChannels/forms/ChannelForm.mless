:local {
  .inputDeleteWrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .input {
    width: 100%;
    margin-right: 1rem;
  }

  .deleteButton {
    align-items: center;
    width: 6.25rem;
    height: 1.75rem;
    padding: 0 0.938rem;
  }

  .addButtonWrapper {
    display: flex;
    justify-content: flex-end;
    margin: 0 0.188rem 0.563rem 0;
  }

  .addLink {
    text-decoration: underline;
    cursor: pointer;
  }

  .inputCheckboxWrapper {
    margin-bottom: 1rem;
  }

  .inHelpifyWrapper {
    justify-content: flex-start;
    align-items: center;
  }

  .inHelpifyWrapperContent {
    display: flex;
    align-items: center;
    width: fit-content;
  }

  .usernameLabel {
    margin-bottom: 0;
  }
}

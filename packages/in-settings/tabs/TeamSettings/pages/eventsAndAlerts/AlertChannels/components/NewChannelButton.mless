@import '~in-themes/active.less';

:local {
  .createNewButton {
    margin-right: 0.5rem;
  }

  .alertChannelButton {
    & + .alertChannelButton {
      border-top: 1px solid var(--ids-color-option-neutral-50);
      display: flex;
      justify-content: space-between;

      &:hover {
        border: 1px solid var(--ids-color-option-neutral-500);
      }
    }
  }
}

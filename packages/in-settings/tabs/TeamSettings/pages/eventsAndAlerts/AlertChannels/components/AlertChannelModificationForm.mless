@import '~in-themes/active.less';

:local {
  .messageSection {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .betaMarker {
    margin-left: auto;
    align-self: flex-start;
  }
  .documentation {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .documentation a {
    font-weight: bold;
  }
}

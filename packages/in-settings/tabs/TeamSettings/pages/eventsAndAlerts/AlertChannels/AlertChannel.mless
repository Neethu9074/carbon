@import '~in-themes/active.less';

:local {
  .row {
    &:nth-child(even) {
      background: var(--ids-color-option-neutral-50);
    }
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    margin-top: 0 !important;
    color: var(--ids-color-option-neutral-600);
  }

  .rowInnerPadding {
    padding: 0.5rem;
  }

  .titleRow {
    font-weight: normal;
    padding: 0.5rem;
  }

  .invalid {
    color: @lib__colors__red800;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .filterDropdown {
    margin-right: 0.5rem;
  }

  .severityDropdown {
    width: 13.5rem;
  }

  .entityTypeDropdown {
    width: 10rem;
  }

  .invalid {
    color: @lib__colors__red800;
  }

  .stateDropdown {
    margin-right: 0.5rem;
    width: 8rem;
  }

  .fourLines {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4; /* number of lines to show */
    line-height: 1.15rem; /* fallback */
    max-height: 4.6rem; /* fallback, line-height x number of lines */
  }

  .ellipsis {
    .ellipsis();
  }

  .deprecated {
    color: @lib__colors__red800;
  }

  .migrated {
    color: @lib__colors__green800;
  }
}

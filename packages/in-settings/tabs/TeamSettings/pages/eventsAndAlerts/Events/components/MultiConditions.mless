@import '~in-themes/active.less';

:local {
  .header {
    font-size: @lib__typography__body-bold__font-size;
  }

  .ruleBoxWithBorder {
    padding: 1rem;
    border: 1px solid @lib__colors__N400;
  }

  .conditionWrapper {
    flex: 1;
  }

  .disabledDelete,
  .disabledDelete:focus,
  .disabledDelete:hover {
    cursor: not-allowed;
    outline: none;
  }

  .andPill {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
}

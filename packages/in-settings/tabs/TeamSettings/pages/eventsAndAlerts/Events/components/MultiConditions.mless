@import '~in-themes/active.less';

:local {
  .header {
    font-size: @lib__typography__body-bold__font-size;
  }

  .ruleBoxWithBorder {
    padding: 1rem;
    border: 1px solid @lib__colors__N400;
  }

  .conditionWrapper {
    flex: 1;
  }

  .hidden {
    visibility: hidden;
  }

  .andPill {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
}

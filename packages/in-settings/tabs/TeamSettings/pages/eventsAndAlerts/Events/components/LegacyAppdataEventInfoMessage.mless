/* Some improved styling in lieu with the planned, modern design
 * of the Message component.
 * This will soon be obsolete again.
 *
 * Don't use and rely on this functionality.
 */
:local {
  .modern {
    strong {
      font-weight: var(--ids-font-weight-option-body-bold);
    }
    a,
    .withMargin {
      margin-left: 0.75rem;
    }
    color: var(--ids-color-text-primary-on-light);
  }
}

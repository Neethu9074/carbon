@import '~in-themes/active.less';

:local {
  .item {
    max-width: 42rem;
    display: inline-block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .subtleMetric {
    font-weight: 100;
    color: @lib__colors__N500;
    margin-left: 0.25rem;
  }
}

@import '~in-themes/active.less';

:local {
  .item {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: @lib__colors__N700Medium;
    padding: 8px 10px;
    cursor: pointer;

    &:hover {
      background-color: rgba(230, 239, 255, 0.69);
    }

    &.selected {
      background-color: rgba(230, 239, 255, 0.69);
    }
  }

  .subtleMetric {
    font-weight: 100;
    color: @lib__colors__N500;
    margin-left: 0.25rem;
  }
}

@host__scope__tag__line_height: 2.5;

:local {
  .configurator {
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1.6;

    color: var(--query-builder-element-color);
    height: 2rem;

    padding: 0.1875rem 0.3rem 0.1875rem 0.4375rem;
    background: var(--ids-color-option-neutral-50);
    width: fit-content;

    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-medium);

    display: flex;
    align-items: center;
  }

  .tagName {
    margin-right: 0.5rem;
    background: transparent;
  }

  .icon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem;

    fill: var(--ids-color-option-neutral-400);
  }

  .removeIconContainer {
    line-height: @host__scope__tag__line_height;
    border-left: 1px solid var(--ids-color-option-neutral-400);
  }

  .removeIcon {
    // icons have a built in margin so we need to subtract it when it is used in smaller frames
    margin: -0.5rem -0.25rem -0.5rem 0.25rem;

    fill: var(--ids-color-option-neutral-400);
    cursor: pointer;

    &:hover,
    &:active,
    &:focus {
      fill: var(--ids-color-option-blue-400);
      outline: none;
    }
  }

  .operator {
    padding: 0.0225rem 0.3125rem;
    margin-top: -0.25rem;
    margin-bottom: -0.25rem;
    border-left: 1px solid var(--ids-color-option-neutral-300);
    border-right: 1px solid var(--ids-color-option-neutral-300);
    border-bottom: none;
    border-top: none;
    line-height: @host__scope__tag__line_height;

    cursor: pointer;

    &:hover {
      color: var(--ids-color-option-neutral-600);
      outline: none;
      background: var(--ids-color-option-neutral-200);
      border-bottom: 1px solid;
      border-top: 1px solid;
      border-color: var(--ids-color-option-blue-400);
    }

    .operator {
      background: var(--ids-color-option-neutral-50);
      color: var(--ids-color-option-neutral-900);
    }

    .operator_dark {
      background: var(--ids-color-option-neutral-900);
      color: var(--ids-color-option-neutral-50);
    }

    &:focus,
    &:active {
      outline: none;
      background: var(--ids-color-option-neutral-200);
      border-bottom: 1px solid;
      border-top: 1px solid;
      border-color: var(--ids-color-option-blue-400);
    }
  }

  .disabledTagInput {
    background-color: transparent;
    cursor: not-allowed;
  }

  .disabled {
    cursor: not-allowed;
  }
}

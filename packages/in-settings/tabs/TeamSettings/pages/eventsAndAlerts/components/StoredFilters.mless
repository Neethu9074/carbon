@import '~in-themes/active.less';

:local {
  .filtersList {
    background: @lib__colors__white;
    border-radius: @lib__shapes__radius_medium;
    border: 1px solid @lib__colors__N400;
    color: @lib__colors__N700Medium;
    font-size: @lib__typography__body-small__font-size;
    letter-spacing: 0;
    line-height: 1rem;
    max-height: 12.5rem;
    overflow-y: auto;
    padding: 1rem 0.6rem 0.4rem 0.6rem;
    position: absolute;
    right: 0;
    width: 15.625rem;
    z-index: 10;
  }

  .posAbove {
    top: -12.5625rem;
  }

  .posBelow {
    top: 2.0625rem;
  }

  .heading {
    color: @lib__colors__N600Light;
    font-weight: 600;
    padding-left: 0.5rem;
  }

  .list {
    font-size: 0.75rem;
    list-style: none;
    margin: 0 0 0;
    padding: 0 0 0;
  }

  .listItem {
    color: @lib__colors__N700Medium;
    margin: 0.5rem 0;
    padding: 0.25rem 0.5rem;

    &:hover {
      background: @lib__colors__N300;
      cursor: pointer;
    }
  }

  .noFiltersHelpText {
    color: @lib__colors__N500;
    line-height: 1.875rem;
    margin-left: 0.625rem;
  }
}

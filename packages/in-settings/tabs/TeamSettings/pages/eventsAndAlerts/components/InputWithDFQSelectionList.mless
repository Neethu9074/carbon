@import '~in-themes/active.less';

:local {
  .container {
    position: relative;
  }

  .inputWithSelectionList {
    background-color: #fafbfc;
    border: 1px solid #d4d8db;
    border-radius: 2px;
    display: inline-flex;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    width: 100%;
  }

  .input {
    border: none;
    height: 30px;
    padding-right: 0;
    width: 100%;
  }

  .icon {
    align-self: center;
    margin: 0 0.5rem;
    fill: @lib__colors__N500;

    &:focus {
      outline: 0;
      fill: @lib__colors__N900Primary;
    }

    &:hover {
      fill: @lib__colors__N900Primary;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .input {
    width: 100%;
  }

  .messageWrapper {
    margin-bottom: 1rem;
  }

  .submessageWrapper {
    margin-top: 0.5rem;
    height: 2rem;
  }

  .contentWrapper {
    margin: 1rem 0 1rem 0;
    display: flex;
    align-items: center;
  }

  .messages {
    margin-left: 0.5rem;
  }

  .settings {
    margin-left: 0.5rem;
  }

  .unscheduleButton {
    margin-top: 1.5rem;
    margin-right: 1rem;
  }

  .queryLoading {
    height: 13px;
    margin: 0.5rem 0;
  }
}

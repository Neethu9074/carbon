:local {
  .cardDiv {
    min-width: 18rem;
    margin-bottom: 0.6rem;
    border: 1px solid var(--ids-color-option-neutral-400);
    &:hover {
      background-color: var(--ids-color-option-neutral-200);
      cursor: pointer;
    }
  }

  .titleSection {
    padding: 0.5rem 0 1rem 0;
  }

  .cardBody {
    display: grid;
  }

  .cardHeader {
    padding: 1rem 1rem 0.5rem 1rem !important;
  }

  .toggle {
    padding: 0 1rem 1rem 1rem !important;
  }

  .marginRight {
    margin-right: 1rem;
  }

  .breadcrumb {
    font-size: var(--ids-font-size-option-body-regular);
    padding: 0 !important;
  }

  .breadcrumbLink {
    color: var(--cds-link-primary);
  }

  .skeleton {
    display: block;
    height: 2rem;
    margin: var(--cds-layout-density-padding-inline-local) !important;
  }

  .card {
    min-width: 18rem;
    border: 1px solid var(--ids-color-option-neutral-400);
    padding: 0 !important;
  }

  .cardFooter {
    margin-top: 4rem;
  }

  .cardButton {
    width: 100%;
  }
}

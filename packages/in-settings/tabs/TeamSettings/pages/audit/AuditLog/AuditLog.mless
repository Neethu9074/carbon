@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    margin-right: 1rem;
  }

  .narrowColumn {
    width: 3rem;
  }

  .text {
    height: 2.625rem;
    .ellipsis()
  }

  .fullName {
    font-weight: bold;
    padding: 0 0 2px;
  }

  .time {
    font-weight: 300;
  }
}

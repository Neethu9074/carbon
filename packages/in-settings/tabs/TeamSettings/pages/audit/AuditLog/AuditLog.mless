@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .text {
    .ellipsis();
  }

  .fullName {
    font-weight: bold;
    padding: 0 0 2px;
  }

  .time {
    font-weight: 300;
  }

  .avatar {
    text-align: center;
  }

  .markdown p:last-child {
    margin-bottom: 0;
  }
}

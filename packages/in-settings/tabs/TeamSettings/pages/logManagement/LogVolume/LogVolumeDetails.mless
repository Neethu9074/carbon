:local {
  .LogVolumeDetailsContainer {
    margin: 2rem 0;
  }
  .LogVolumeDetails {
    display: flex;
    justify-content: space-between;
    background: #ebf1f7;
    padding: 0.5rem 1rem;
  }
  .logVolumeItems {
    border: none;

    li {
      font-weight: 600;
    }
  }
}

:local {
  .LogVolumeDetailsContainer {
    margin: 2rem 0;
  }

  .LogVolumeDetails {
    display: flex;
    justify-content: space-between;
    background: #ebf1f7;
    padding: 0.5rem 1rem;
  }

  .totalVolumes {
    display: flex;
    gap: 2rem;
    justify-content: flex-end;
    margin-right: 2rem;
  }

  .logVolumeItems {
    border: none;
    li {
      font-weight: 600;
      display: flex;
      justify-content: space-between;
    }
  }

  .logVolumeCategories {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    font-weight: 600;
    background-color: var(--ids-color-option-white);
    & > div {
      color: var(--ids-color-option-neutral-600);
    }
    border: none;
    outline: none;
  }

  .collapseRow {
    vertical-align: middle;
    margin-left: 1rem;
  }

  .loadingMock {
    padding-top: 2rem;
  }

  .loadingIndicator {
    display: block;
    width: auto;
  }

  .retentionDays {
    font-weight: bold;
  }
  .volumeGB {
    min-width: 100px;
    text-align: right;
    flex: 0 0 50%;
  }
  .volumeCategoriesGB {
    .volumeGB();
    text-align: left;
    min-width: 70px;
  }

  .skeleton {
    .loadingIndicator();
    height: 12rem;
    margin: 0 var(--cds-layout-density-padding-inline-local) var(--cds-layout-density-padding-inline-local)
      var(--cds-layout-density-padding-inline-local);
  }
}

:local {
  .LogVolumeDetailsContainer {
    margin: 2rem 0;
  }
  .LogVolumeDetails {
    display: flex;
    justify-content: space-between;
    background: #ebf1f7;
    padding: 0.5rem 1rem;
  }
  .logVolumeItems {
    border: none;

    li {
      font-weight: 600;
    }
  }

  .loadingMock {
    padding-top: 2rem;
  }

  .loadingIndicator {
    display: block;
    width: auto;
  }

  .retentionDays {
    font-weight: bold;
  }

  .skeleton {
    .loadingIndicator();
    height: 12rem;
    margin: 0 var(--cds-layout-density-padding-inline-local) var(--cds-layout-density-padding-inline-local)
      var(--cds-layout-density-padding-inline-local);
  }
}

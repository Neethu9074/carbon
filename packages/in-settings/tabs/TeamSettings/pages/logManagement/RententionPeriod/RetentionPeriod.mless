:local {
  .titleSection {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .confirmationDialogContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;

    > span:first-child {
      margin-bottom: 1rem;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
  .card {
    max-width: fit-content;
    padding-right: 10rem;
    box-shadow: var(--ids-shadow-option-subtle);
    border-radius: var(--ids-border-radius-option-large);
  }
  .title,
  .body {
    min-height: 1.9rem;
    color: var(--ids-color-option-neutral-700);
    font-size: 1rem;
    font-weight: 200;
  }
  .body p {
    font-weight: 200;
  }
  .number {
    font-size: 3rem;
    color: black;
  }

  .typo {
    padding: 0.5rem 0 0.25rem;
  }
}

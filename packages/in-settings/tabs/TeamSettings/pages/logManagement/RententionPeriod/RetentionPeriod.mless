:local {
  .titleSection {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .link {
    margin-left: 0.5rem;
  }
  .confirmationDialogContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;

    > span:first-child {
      margin-bottom: 1rem;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
  .card {
    max-width: fit-content;
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
    margin-bottom: 0.6rem;
    padding-right: 10rem;
    box-shadow: var(--ids-shadow-option-subtle);
  }
  .title,
  .body {
    line-height: 1.5rem;
    color: var(--ids-color-option-neutral-700);
    font-size: 1rem;
    font-weight: 300;
  }
  .body p {
    font-weight: 300;
    margin: 0;
  }
  .number {
    font-size: 2.375rem;
    font-weight: 400;
    color: var(--ids-color-text-primary-on-light);
  }

  .typo {
    padding: 0.5rem 0 0.25rem;
  }
}

:local {
  .titleSection {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .confirmationDialogContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;

    > span:first-child {
      margin-bottom: 1rem;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
}

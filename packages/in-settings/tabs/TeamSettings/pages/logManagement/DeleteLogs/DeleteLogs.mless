@import '~in-themes/active.less';

:local {
  .confirmationDescription {
    margin-bottom: 0.5rem;
  }

  .titleSection {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .confirmationDialogContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;

    > span:first-child {
      margin-bottom: 1rem;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }

  .buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: -1.5rem;
    padding: 0.5rem 1.5rem;
    background: var(--ids-color-option-neutral-400);
  }

  .loadingButton {
    svg {
      margin: -0.5rem 0rem;
    }
    display: flex;
    gap: 0.5rem;
  }

  .page {
    > section:last-of-type {
      margin-top: 2rem;
    }
    main {
      width: 85%;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
  }
}

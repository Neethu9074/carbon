:local {
  .dialog {
    max-width: 30rem;
    min-width: 30rem;
  }

  .confirmationDescription {
    margin-bottom: 0.5rem;
  }

  .titleSection {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .validationMessage {
    height: 0;
    margin: -0.125rem 0;
  }

  .deleteLogsButton {
    font-weight: bold;
    margin-bottom: auto;
    margin-top: 0.5rem;
  }

  .deleteUntilSection {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 1.5rem;

    input {
      width: 100%;
    }
  }

  .confirmationDialogContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;

    > span:first-child {
      margin-bottom: 1rem;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }

  .buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: -1.5rem;
    padding: 0.5rem 1.5rem;
    background: var(--ids-color-option-neutral-400);
  }

  .loadingButton {
    svg {
      margin: -0.5rem 0rem;
    }
    display: flex;
    gap: 0.5rem;
  }

  .page {
    padding: 0;
    main {
      width: 85%;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
  }

  .toast {
    display: flex;
    flex-direction: column;
  }
}

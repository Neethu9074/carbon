:local {
  .deletionTable {
    margin-top: 1rem;
    border: 1px solid var(--ids-color-option-neutral-400);
  }

  .stateContainer {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    height: 32rem;
  }

  .emptyState {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .tableSection {
    h2 {
      margin-left: 1rem;
    }
  }

  .skeleton {
    display: block;

    width: 80%;
    height: 1rem;

    margin-right: 0.5rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
}

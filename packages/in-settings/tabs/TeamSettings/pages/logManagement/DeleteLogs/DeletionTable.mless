:local {
  .deletionTable {
    margin-top: 1rem;
    border: 1px solid var(--ids-color-option-neutral-400);
  }

  .stateContainer {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    height: 32rem;
  }

  .emptyState {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .skeleton {
    display: block;

    width: 80%;
    height: 1rem;

    margin-right: 0.5rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .deleteLogsSummaryCard {
    padding: 1rem 1rem 0 0;
  }

  .deleteLogsTableCard {
    padding: 0;
  }

  .emptyTable {
    :global(.cds--data-table tbody) {
      display: none;
    }
    :global(.table-row) {
      display: grid;
    }
  }
}

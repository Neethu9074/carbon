@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .row {
    vertical-align: top;
  }

  .colName,
  .colType,
  .colValue {
    width: 100%;
  }

  .prefix {
    padding-right: 0.25rem;
  }

  .key {
    flex: 1;
  }

  .disabled {
    opacity: 0.6;
    cursor: default;
  }
}

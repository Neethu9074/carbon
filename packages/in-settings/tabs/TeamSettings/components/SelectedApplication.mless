@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .item {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 0.75rem;
    white-space: nowrap;
    padding: 0.375rem 0.5rem;
    text-decoration: none;
    height: 1.875rem;
    color: @lib__colors__N600Light; // place-holder color
    background-color: @lib__colors__N050;
    border: 1px solid @lib__colors__N400;
    border-radius: 3px;
  }

  .item:hover {
    text-decoration: none;
  }

  .hasValue {
    color: #333;
  }

  .icon {
    fill: @lib__colors__N600Light;
    position: relative;
    top: 1px;
  }

  .text {
    max-width: 20rem;
    // adjust for overflow-hidden that will hide parts of certain characters
    line-height: 1.3;
    .ellipsis();
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .propertyContainer {
    display: flex;
    flex-direction: column;
    margin-right: 2.5rem;
  }

  .propertyLabel {
    text-transform: uppercase;
    color: @lib__colors__N600Light;
    max-width: 20rem;
    .ellipsis();
  }

  .propertyValue {
    max-width: 20rem;
    .ellipsis();
  }
}

@import '~in-themes/mixins.less';

:local {
  .propertyContainer {
    display: flex;
    flex-direction: column;
    margin-right: 2.5rem;
  }

  .propertyLabel {
    text-transform: uppercase;
    color: var(--ids-color-option-neutral-600);
    max-width: 20rem;
    .ellipsis();
  }

  .propertyValue {
    max-width: 20rem;
    .ellipsis();
  }
}

@import '~in-themes/active.less';

:local {

  .dialog {
    width: 80vw;
    max-width: 100rem;
  }

  .listFormGroup {
    height: ~'calc(90vh - 180px)';
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1rem 0 0;
  }

  .tableScrollWrapper {
    display: block;
    overflow-y: auto;
    height: ~'calc(100vh - 420px)';
  }
}

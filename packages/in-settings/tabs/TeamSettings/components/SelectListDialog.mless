@import '~in-themes/active.less';

:local {

  .dialog{
    width: 80vw;
    max-width: 100rem;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1rem 0 0;
  }

  .tableHeightWrapper {
    display: block;
    overflow-y: auto;
    border-bottom: 1px solid @lib__colors__N400;
  }
}

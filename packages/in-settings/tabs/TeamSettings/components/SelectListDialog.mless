@import '~in-themes/active.less';

:local {
  .dialog {
    width: 80vw;
    max-width: 80rem;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1rem 0 0;
  }

  .actionButton {
    z-index: 1;
  }

  .tableScrollWrapper {
    display: block;
    overflow-y: auto;
  }

  .errorMessage {
    margin: 0;
    text-align: center;
  }
}

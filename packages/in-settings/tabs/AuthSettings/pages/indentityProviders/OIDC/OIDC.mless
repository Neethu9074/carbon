 :local {
  .list {
    margin: 0.5rem 0;
    padding: 0 0 0 1rem;

    & > li {
      line-height: 1rem;
    }
  }

  .input {
    width: 100%;

    margin-right: 0.5rem;
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .descriptionText {
    max-width: 50rem;
  }
}

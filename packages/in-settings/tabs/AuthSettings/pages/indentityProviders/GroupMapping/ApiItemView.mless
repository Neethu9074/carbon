:local {
  .wrapper {
    padding: 0 1rem 4rem;
  }

  .controls,
  .customControls {
    display: flex;
    align-items: center;
  }

  .controls {
    justify-content: space-between;
  }

  .backNavigationWrapper {
    display: flex;
    align-items: center;

    font-size: 0.875rem;
    margin-bottom: 2rem;
  }

  .icon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-blue-500);
  }

  .messageWrapper {
    margin: 0.5rem 0 1rem 0;
    min-height: 2.125rem;
  }
}

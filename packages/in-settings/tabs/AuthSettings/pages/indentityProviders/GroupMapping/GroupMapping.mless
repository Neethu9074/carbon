@import '~in-themes/mixins.less';

:local {
  .delete {
    cursor: pointer;
    fill: var(--ids-color-option-blue-500);

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .instanaGroup div {
    width: 100%;
  }

  .description {
    max-width: 950px;
    margin-top: 1rem;
  }

  .margin {
    margin-bottom: 0.5rem;
  }
}

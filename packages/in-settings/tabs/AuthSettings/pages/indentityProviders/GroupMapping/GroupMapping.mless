@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .delete {
    cursor: pointer;
    fill: @lib__colors__primary2;

    &:hover {
      fill: @lib__colors__N700Medium;
    }
  }

  .instanaGroup div {
    width: 100%;
  }

  .description {
    max-width: 950px;
    margin-top: 1rem;
  }

  .margin {
    margin-bottom: 0.5rem;
  }
}

:local {
  .icon {
    background-color: var(--ids-color-option-teal-500);
    border-radius: var(--ids-border-radius-option-round);
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ids-color-option-neutral-700);
  }

  .pageIndicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    background-color: var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-round);
    flex-shrink: 0;
  }

  .highlightCurrentPage {
    border: 2px solid var(--ids-color-option-teal-500);
  }

  .line {
    width: 100%;
    height: 0;
    border: 1px solid var(--ids-color-option-neutral-400);
  }
}

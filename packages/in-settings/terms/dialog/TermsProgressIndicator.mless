@import '~in-themes/active.less';

:local {
  .icon {
    background-color: @lib__colors__teal800;
    border-radius: 50%;
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: @lib__colors__N700Medium;
  }

  .pageIndicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    background-color: @lib__colors__N400;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .highlightCurrentPage {
    border: 2px solid @lib__colors__teal800;
  }

  .line {
    width: 100%;
    height: 0;
    border: 1px solid @lib__colors__N400;
  }
}

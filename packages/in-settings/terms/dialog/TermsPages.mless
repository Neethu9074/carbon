:local {
  .flexColumn {
    display: flex;
    flex-direction: column;
  }

  .pullRight {
    float: right;
  }

  .flexRow {
    display: flex;
    align-items: center;
  }

  .hidden {
    visibility: hidden;
  }

  .container {
    height: 100%;
    position: relative;
  }

  .pageContent {
    height: 100%;
    color: var(--ids-color-option-neutral-700);
    font-size: var(--ids-font-size-option-body-bold);
    padding: 0 1.5rem 5rem;
    overflow-y: auto;
    line-height: 1.6;
  }

  .indentedImage {
    .pullRight();
    margin-right: 1.25rem;
  }

  .heading {
    font-size: var(--ids-font-size-option-heading-400);
    font-weight: var(--ids-font-weight-option-heading-400);
    margin-top: 0.75rem;
  }

  .warningText {
    display: flex;
    align-items: center;
    color: var(--ids-color-option-yellow-500);
    font-weight: normal;
    font-size: var(--ids-font-size-option-body-small);
    margin-left: 0.1875rem;
    height: 1.25rem;

    span {
      margin-left: 0.25rem;
    }

    svg {
      fill: var(--ids-color-option-yellow-500);
    }
  }

  .errorText {
    .warningText();
    color: var(--ids-color-option-red-500);

    svg {
      fill: var(--ids-color-option-red-500);
    }
  }

  .inputField {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
    width: 21.25rem;
  }

  .buttons {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;

    button {
      width: 6.25rem;
    }

    button:nth-of-type(2) {
      margin-left: 1.5rem;
    }
  }

  .disabled,
  .disabled:focus,
  .disabled:hover {
    cursor: not-allowed;
    outline: 0;
    background: rgba(244, 169, 160, 0.48);
  }
  .profileCheckbox {
    padding-top: 1rem;

    :global(.cds--form__helper-text) {
      margin: -1rem 0 0 2rem;
    }
  }
}

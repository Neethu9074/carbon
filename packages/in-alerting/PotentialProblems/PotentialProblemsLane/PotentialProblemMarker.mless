@import '~in-themes/mixins.less';

:local {
  .marker {
    --item-height: 0.5rem;
    position: absolute;
    background: transparent;
    border: 2px solid var(--ids-color-option-deep-purple-500);
    height: var(--item-height);
    border-radius: calc(var(--item-height) / 2);
  }

  .clickable {
    cursor: pointer;
  }

  .marker:hover {
    --hover-color: rgba(99, 114, 130, 0.3); // var(--ids-color-option-neutral-600)
    box-shadow: 0 0 0 0.25rem var(--hover-color);
    background: var(--hover-color);
  }
}

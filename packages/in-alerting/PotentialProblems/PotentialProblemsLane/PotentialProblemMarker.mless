@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .marker {
    --item-height: 0.5rem;
    position: absolute;
    background: transparent;
    border: 2px solid @lib__colors__deep-purple800;
    height: var(--item-height);
    border-radius: calc(var(--item-height) / 2);
    cursor: pointer;
  }

  .marker:hover {
    --hover-color: rgba(99, 114, 130, 0.3); // @lib__colors__N600Light
    box-shadow: 0 0 0 0.25rem var(--hover-color);
    background: var(--hover-color);
  }
}

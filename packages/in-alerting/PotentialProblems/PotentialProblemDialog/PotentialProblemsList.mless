@import '~in-themes/mixins.less';

:local {
  .list {
    border: none;
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
  }

  .listItem {
    border: none;
  }

  .itemInnerWrapper {
    display: flex;
    align-items: center;
  }

  .icon {
    margin-right: 1rem;
    fill: var(--ids-color-option-blue-400);
  }

  .itemName {
    color: var(--ids-color-option-neutral-600);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .itemDescription {
    color: var(--ids-color-option-neutral-900);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .type {
    text-transform: capitalize;
  }
}

@import '~in-themes/mixins.less';

:local {
  .container {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 40.5rem;
  }

  .headline {
    color: var(--ids-color-option-neutral-600);
    font-size: var(--ids-font-size-option-heading-500);
    font-weight: var(--ids-font-weight-option-heading-500);
    line-height: 2rem;
    margin-bottom: 1rem;
  }

  .entity {
    display: flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--ids-color-option-neutral-500);
    margin: 0 0 0.25rem -0.125rem;

    svg {
      fill: currentColor;
    }
  }

  .duration {
    display: flex;
    align-items: center;
    color: var(--ids-color-option-neutral-600);
    line-height: 1.25rem;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;

    > svg {
      fill: currentColor;
    }
  }

  .durationDevider {
    margin: 0 0.25rem;
  }

  .description {
    font-size: 0.875rem;
    color: var(--ids-color-option-neutral-900);
    margin-bottom: 4rem;
  }

  .chartWrapper {
    width: 80%;
    margin: 0 auto;
  }

  .controls {
    display: flex;
    justify-content: center;
    margin-top: auto;
  }

  .icon {
    margin-right: 0.125rem;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .textPrimary {
    color: @lib__colors__N900Primary;
    font-size: 0.875rem;
    font-weight: bold;
  }

  .textSecondary {
    color: @lib__colors__N700Medium;
    font-size: 0.875rem;
    font-weight: normal;
  }

  .itemContainer {
    padding: 0.25rem 0;
  }

  .description {
    width: 6.25rem;
  }

  .date {
    white-space: nowrap;
  }

  .name {
    .breakWord();
    width: 18.75rem;
  }

  .icon {
    fill: @lib__colors__N600Light;
  }
}

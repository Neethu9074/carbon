@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .textPrimary {
    color: var(--ids-color-option-neutral-900);
    font-size: 0.875rem;
    font-weight: bold;
  }

  .textSecondary {
    color: var(--ids-color-option-neutral-700);
    font-size: 0.875rem;
    font-weight: normal;
  }

  .itemContainer {
    padding: 0.25rem 0;
  }

  .description {
    width: 100px;
  }

  .date {
    white-space: nowrap;
  }

  .name {
    .breakWord();
    width: 18.75rem;
  }

  .icon {
    fill: var(--ids-color-option-teal-500);
  }
}

:local {
  .contentArea {
    height: 100%;
    padding-right: 2rem;
    padding-bottom: 2rem;
  }

  .color900 {
    color: var(--ids-color-option-neutral-900);
  }

  .contentWrapper {
    padding-left: 2.5rem;
    padding-right: 2rem;
    overflow-y: auto;
    overflow-x: hidden;
  }

  @media (max-width: 1500px) {
    .contentWrapper {
      padding-left: 2rem;
    }
  }
}

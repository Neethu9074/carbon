@import '~in-themes/mixins.less';

:local {
  .card {
    background: #fff;
    border-top-left-radius: var(--ids-border-radius-option-small);
    border-top-right-radius: var(--ids-border-radius-option-small);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: var(--ids-color-option-neutral-200);
    border-top-left-radius: var(--ids-border-radius-option-small);
    border-top-right-radius: var(--ids-border-radius-option-small);
  }

  .whiteBg {
    background: none;
  }

  .noSubContent {
    max-height: 3.125rem;
  }

  .clickableHeader {
    cursor: pointer;
  }

  .nonClickable {
    cursor: default;
  }

  .framed {
    border: 1px solid var(--ids-color-option-neutral-200);
    border-radius: var(--ids-border-radius-option-small);

    &.darkFrame {
      border: 1px solid var(--ids-color-option-neutral-300);
    }
  }

  .twoLineTitleLabel {
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-600);
    .ellipsis();
  }

  .twoLineTitle {
    margin-bottom: 0.25rem;
    font-size: 0.875rem;
    color: var(--ids-color-option-neutral-900);
    .ellipsis();
  }

  .title {
    font-size: 1rem;
    font-weight: 200;
    color: var(--ids-color-option-neutral-700);
    .ellipsis();
    margin: 0 1rem 0 0;
  }

  .titleSubContent {
    font-size: 0.8rem;
    font-weight: 200;
    color: var(--ids-color-option-neutral-700);
    padding: 0 0 0 0.5rem;
  }

  .body {
    padding: 1rem;
  }

  .bodyWithoutPadding {
    padding: 0;
  }

  .useMaxAvailableHeight {
    height: 100%;
  }
}

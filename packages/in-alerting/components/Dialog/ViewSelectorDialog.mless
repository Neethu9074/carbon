:local {
  .listView {
    padding-left: 1rem;
    margin: 0;
    li {
      list-style-type: disc;
    }
  }

  .wrapper {
    display: flex;
    flex-flow: column;
    gap: 0.25rem;
    height: 10.75rem;
  }

  .rightAction {
    width: 100%;
    display: flex;
    flex-flow: row;
    justify-content: flex-end;
  }

  .leftAction {
    left: 0;
  }

  .footerAction {
    display: flex;
  }
}

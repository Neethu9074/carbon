@import '~in-themes/mixins.less';

:local {
  .row {
    vertical-align: top;
    & > td {
      vertical-align: top;
    }
  }

  .colName {
    width: 100%;
  }

  .colValue {
    flex-direction: row !important;
    vertical-align: middle;
    align-items: stretch;
    min-height: 2rem; // for suggestion button aligned in the middle
    flex-wrap: wrap; // forcing validation message in next line
  }

  .colType {
  }

  .prefix {
    padding-right: 0.25rem;
  }

  .key {
    flex: 1;
    width: 5rem; // min width, can expand
  }

  .delete {
    cursor: pointer;
    fill: var(--ids-color-option-blue-500);

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .disabled {
    opacity: 0.6;
    cursor: default;
  }

  .controls {
    display: flex;
    align-items: center;
    height: 2rem;
  }

  .fullWidth {
    width: 100%;
  }
  .customPayloadTearsheet {
    > div:first-child {
      padding: 0 0 1rem 0;
    }
  }

  .tableContent {
    :global .cds--data-table-content {
      overflow-x: visible;
    }
  }
}

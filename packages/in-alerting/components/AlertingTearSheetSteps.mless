:local {
  .label {
    margin: 1.5rem 0;
    line-height: 1.5rem;
    padding: 0.375rem 0.5rem 0.875rem 0;

    &.selected {
      margin-bottom: 0rem;
    }
  }

  .clickable {
    &:hover {
      cursor: pointer;
    }
  }
  .optional {
    line-height: var(--ids-line-height-option-heading-500);
    padding-left: 8%;
    margin-bottom: 0;
  }
  .tabSelected {
    border-bottom: 0.188rem solid var(--ids-color-option-teal-400);
  }

  .inline {
    display: flex;
    align-items: baseline;
  }

  .index {
    word-break: auto-phrase;
  }

  .alignIcon {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
  }
  .threeColumns {
    display: grid;
    grid-template-columns: 8% 82% 10%;
    width: 100%;
  }
}

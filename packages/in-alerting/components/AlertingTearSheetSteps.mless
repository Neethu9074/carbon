:local {
  .label {
    display: flex;
    margin: 1.5rem 0;
    line-height: 1.5rem;
    padding: 0.375rem 0 0.875rem 0;

    &:hover {
      cursor: pointer;
    }

    &.selected {
      margin-bottom: 0rem;
    }

    &.flexColumn {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .optional {
    line-height: var(--ids-line-height-option-heading-500);
    padding-left: 1.25rem;
    margin-bottom: 0;
  }
  .tabSelected {
    border-bottom: 0.188rem solid var(--ids-color-option-teal-400);
    padding-bottom: 0.25rem;
  }

  .inline {
    display: flex;
    align-items: baseline;
  }

  .index {
    word-break: auto-phrase;
  }
  .lightColor {
    color: var(--ids-color-text-primary-on-light);
  }
  .color600 {
    color: var(--ids-color-option-neutral-600);
  }
}

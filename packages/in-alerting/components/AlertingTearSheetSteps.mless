:local {
  .label {
    display: flex;
    margin: 1.5rem 0;
    color: var(--ids-color-option-neutral-600);
    line-height: 1.5rem;

    &:hover {
      cursor: pointer;
    }

    &.selected {
      color: var(--ids-color-option-neutral-900);
      margin-bottom: 0rem;
    }

    &.flexColumn {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .optional {
    font-size: var(--ids-font-size-option-heading-100);
    font-weight: var(--ids-font-weight-option-heading-500);
    line-height: var(--ids-line-height-option-heading-500);
    padding-left: 1.25rem;
    margin-bottom: 0;
  }
  .tabSelected {
    border-bottom: 0.188rem solid var(--ids-color-option-teal-400);
    padding-bottom: 0.25rem;
  }

  .inline {
    display: flex;
    align-items: baseline;
  }

  .index {
    word-break: auto-phrase;
  }
}

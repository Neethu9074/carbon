:local {
  .container {
    width: 100%;
    height: 100%;
  }

  .showPadding {
    padding-top: 1.5rem;
  }

  .headline {
    line-height: 2.5rem;
    margin: 0.5rem;
    display: flex;
    align-items: center;
  }

  .block {
    display: flex;
  }
}

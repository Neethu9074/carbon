@import '~in-themes/mixins.less';

:local {
  .latestButton {
    padding: 0rem;
  }

  .labelWrapper {
    .spaceBetweenFlexbox();

    margin: 1rem 0 1.5rem;
  }

  .left {
    margin-right: 2rem;
  }

  .left,
  .right {
    .flexbox();
  }

  .iconsContainer {
    display: flex;
    & > * {
      margin-right: 0.5rem;
    }
  }

  .name {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .badge {
    margin-right: 1rem;
  }

  .bottomSpace {
    margin: 0 0 1.5rem 0;
  }
}

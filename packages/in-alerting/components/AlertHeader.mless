@import '~in-themes/mixins.less';

:local {
  .latestButton {
    padding: 0rem;
  }

  .labelWrapper {
    .spaceBetweenFlexbox();

    margin: 1rem 0 1.5rem;
  }

  .left {
    margin-right: 2rem;
  }

  .left,
  .right {
    .flexbox();
  }

  .alertIcon {
    margin-right: 0.5rem;
  }

  .name {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .badge {
    margin-right: 1rem;
  }

  .alertIcon {
    margin-right: 1.5rem;

    &SeverityLow {
      fill: var(--ids-color-option-yellow-500);
    }

    &SeverityHigh {
      fill: var(--ids-color-option-red-500);
    }
  }

  .bottomSpace {
    margin: 0 0 1.5rem 0;
  }
  .whiteSpace {
    white-space: pre;
  }
}

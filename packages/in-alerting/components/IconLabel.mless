@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .container {
    width: max-content;
    margin: 0 0 0.5rem 0;
  }

  .noBottomMargin {
    margin: 0;
  }

  .icon {
    margin: 0 0.5rem 0 0;
  }

  .ellipsis {
    .ellipsis();
  }
}

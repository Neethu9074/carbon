:local {
  .formFooter {
    display: flex;
    justify-content: space-between;
    height: 4rem;
    background-color: var(--ids-color-option-neutral-100);
    border-top: 1px solid var(--ids-color-option-neutral-300);
    align-items: center;
    padding: 0rem 2rem;
  }
  .button {
    margin-right: 0.5rem;
    max-width: 6.875rem;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .outerWrapper {
    padding: 1rem;

    background: var(--ids-color-option-neutral-100);
    border: 1px solid var(--ids-color-option-neutral-300);
    margin: 0 0 1rem 0;
  }

  .innerWrapper {
    display: flex;

    padding: 1rem;

    background: var(--ids-color-option-white);
    border: 1px solid var(--ids-color-option-neutral-300);

    .breakWord();
  }

  .icon {
    margin-right: 1rem;
  }

  .heading {
    color: var(--ids-color-option-neutral-700);
    line-height: 1.5rem;
  }

  .text {
    margin: 0;

    font-size: 0.875rem;
    line-height: 1.125rem;
  }

  .badgeWrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-right: 1rem;
    justify-content: space-around;
  }

  .badge {
    display: block;
    position: relative;
    width: 100%;
  }
}

:local {
  .simpleDropdown {
    color: var(--ids-color-option-neutral-700);
    font-weight: normal;
    &:hover {
      background-color: transparent;
    }
  }

  // Carbon has a visually hidden label that is getting used however it is
  // causing a positioning clash and a scroll bar.
  .visuallyHiddenLabel {
    :global .cds--visually-hidden {
      position: fixed;
    }
  }
}

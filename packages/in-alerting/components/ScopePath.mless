@import '~in-themes/active.less';

:local {
  .container {
    width: max-content;
    margin: 0 0 0.5rem 0;
  }

  .noBottomMargin {
    margin: 0;
  }

  .icon {
    margin: 0 0.25rem 0 0;
    fill: @lib__colors__N900Primary;
  }

  .separator {
    margin: 0 0.25rem;
    fill: @lib__colors__N600Light;
  }

  .link {
    white-space: normal;
    word-break: break-word;
    color: @lib__colors__N900Primary;
  }
}

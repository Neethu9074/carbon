:local {
  .container {
    width: max-content;
    margin: 0 0 0.5rem 0;
  }

  .noBottomMargin {
    margin: 0;
  }

  .icon {
    margin: 0 0.25rem 0 0;
  }

  .separator {
    margin: 0 0.25rem;
    fill: var(--ids-color-option-neutral-600);
  }

  .link {
    white-space: normal;
    word-break: break-word;
    color: var(--ids-color-option-neutral-900);
  }
}

:local {
  .outerContainer {
    background: var(--cds-layer);
  }

  .container {
    display: grid;
    height: calc(100vh - 8rem); // removing height of the carbon header (3rem)+ page header (5 rem)
    grid-template-columns: 16rem 1fr;
    grid-template-rows: 1fr 4rem;
    grid-template-areas:
      'sidebar content'
      'sidebar footer';
  }
  .containerWithMsg {
    height: calc(
      100vh - 12rem
    ); // adjusting the height of container on displaying msg, reducing the height with header height.
  }

  .sidebar {
    grid-area: sidebar;
    border-right: 1px solid var(--ids-color-option-neutral-300);
    padding: 2rem 0 2rem 2.25rem;
    overflow-y: auto;
    max-height: calc(100vh - 5rem);
  }

  .content {
    grid-area: content;
    padding: 2rem 0 0 3rem;
    height: calc(100vh - 12rem);
    overflow-y: auto;
    overflow-x: hidden;
  }
  .contentWithMsg {
    height: calc(
      100vh - 16rem
    ); // adjusting the height of content on displaying msg, reducing the height with header height + footer.
  }

  .footer {
    grid-area: footer;
  }
  .errorInfo {
    padding: 0 2rem 1.8rem 0;
  }
}

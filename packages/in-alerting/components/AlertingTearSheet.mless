:local {
  .container {
    display: grid;
    height: calc(100vh - 7.75rem); // removing height of the carbon header (3rem)+ page header (4.75 rem)
    grid-template-columns: 14.5rem 1fr;
    grid-template-rows: 1fr 4rem;
    grid-template-areas:
      'sidebar content'
      'sidebar footer';
    background: var(--ids-color-option-white);
  }

  .sidebar {
    grid-area: sidebar;
    border-right: 1px solid var(--ids-color-option-neutral-300);
    padding: 2rem 0 2rem 2rem;
    overflow-y: auto;
    max-height: calc(100vh - 5rem);
  }

  .content {
    grid-area: content;
    padding: 2rem 0 0 3rem;
    height: calc(100vh - 12rem);
    overflow-y: auto;
    overflow-x: hidden;
  }

  .footer {
    grid-area: footer;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .allProperties {
    display: flex;
    flex-direction: row;
    overflow-x: hidden;
  }

  .secText {
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-600);
  }

  .ellipsis {
    max-width: 90%;
    display: block;
    .ellipsis();
  }
}

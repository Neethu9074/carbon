@import '~in-themes/mixins.less';

:local {
  .secText {
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-600);
  }

  .ellipsis {
    max-width: 90%;
    display: block;
    .ellipsis();
  }

  .okayIcon {
    fill: var(--ids-color-option-green-500);
  }

  .icon {
    margin: 0 2px 0 0;
  }

  .dotPadding {
    margin-right: 0.1rem;
  }
}

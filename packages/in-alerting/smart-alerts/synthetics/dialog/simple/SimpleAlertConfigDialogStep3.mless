:local {
  .container {
    grid-column: 1 / span 3;
    overflow: auto;
    padding: 2.5rem 0.5rem;
  }
  .subtitle {
    font-size: var(--ids-font-size-option-heading-200);
    margin: 0.5rem;
    grid-column: 1 / span 3;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
}

@import '~in-themes/active.less';

:local {
  .centered {
    display: inline-flex;
    align-items: center;
  }

  .filters {
    display: flex;
    color: var(--ids-color-option-neutral-700);
  }

  .filterIcon {
    fill: var(--ids-color-option-neutral-700);
  }
}

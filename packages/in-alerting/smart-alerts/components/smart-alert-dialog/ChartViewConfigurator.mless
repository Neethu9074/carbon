@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .container {
    height: min-content;
  }

  .labelWithGap {
    margin-right: 0.5rem;
  }

  .expanding {
    flex: 1;
  }

  .defaultSize {
    margin-top: 1rem;
    height: 21rem;
  }

  .withSelection {
    margin-top: 1rem;
    min-height: 23rem;
  }

  .headerTransparent {
    background-color: transparent;
  }
}

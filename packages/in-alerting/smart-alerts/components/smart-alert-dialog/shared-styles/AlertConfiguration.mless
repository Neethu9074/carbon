@import '~in-themes/active.less';

:local {
  .alertChannelsWrapper {
    margin: -1px;
  }

  .paddingBodyWrapper {
    padding: 1rem;
  }

  .evaluationType {
    border-radius: @lib__shapes__radius_small;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .lightCardHeader {
    border-bottom: 1px solid @lib__colors__N300;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }

  .tilesRow {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem; // a minimal horizontal gap
    justify-content: space-between;
  }

  .tile {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }
  .keyValueExtraGap {
    gap: 0.5rem;
  }
}

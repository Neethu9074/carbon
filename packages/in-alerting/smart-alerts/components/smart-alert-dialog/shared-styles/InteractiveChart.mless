@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .container {
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_small;
    border-top: 0;
  }

  .message {
    display: flex;
    align-items: center;
    justify-content: center;

    background-color: @lib__colors__N200;
    color: @lib__colors__N600Light;
    height: 14.375rem;
    width: 100%;
    margin-top: 1.5rem;
    padding: 0 0.5rem 0.5rem;

    > span {
      margin-left: 0.5rem;
    }

    > svg {
      fill: @lib__colors__N600Light;
    }
  }

  .wideControl {
    width: 12.25rem;
  }

  .narrowControl {
    width: 6rem;
  }

  .disabledControl:disabled {
    color: @lib__colors__N900Primary;
  }

  .controls {
    display: grid;
    grid-template-columns: repeat(5, min-content);
    column-gap: 0.5rem;
    padding: 1rem 0.5rem 0 0.5rem;
  }

  .chartHeader {
    background-color: transparent;
  }
}

@import '~in-themes/active.less';

:local {
  .queryBuilderWrapper {
    display: flex;
  }

  // The query builder add button pushes itself down by 3px.
  .queryBuilderPositionCorrection {
    > button {
      position: relative;
      top: 0;
    }
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .propContainer {
    .flexbox();
    border-bottom: 1px solid @lib__colors__N300;
    color: @lib__colors__N900Primary;
    font-size: 0.875rem;
    padding: 1rem;

    &:last-child {
      border-bottom: none;
    }
  }

  .leftContent {
    .flexbox();
    line-height: 1.5rem;
    width: 14rem;
    color: @lib__colors__N900Primary;
  }

  .rightContent {
    .flexbox();
    width: 100%;
  }

  .iconWrapper {
    .flexbox();
    width: 2rem;
  }

  .icon {
    fill: @lib__colors__N600Light;
  }
}

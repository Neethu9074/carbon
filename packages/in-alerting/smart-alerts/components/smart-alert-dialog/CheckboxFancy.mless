@import '~in-themes/active.less';

:local {
  .label  {
    display: flex;
    align-items: center;
    line-height: 1.25rem;
    font-size: 14px;
  }

  .control {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    line-height: 1.25rem;
  }

  .controlWrapper {
    align-self: flex-start;
  }

  .labelText {
    padding-top: 0.0938rem;
  }

  .sizeDefault {
    transform: scale(0.5);
  }

  .sizeLarge {
    transform: scale(0.667);
    margin-right: 0.2rem;
  }

  .sizeLarger {
    transform: scale(0.75);
    margin-right: 0.4rem;
  }

  .sizeLargest {
    transform: scale(1);
    margin-right: 0.6rem;
  }

  .checkbox {
    background-image: url('data:image/svg+xml;base64,');
  }

  .checkbox:checked {
    background-image: url('data:image/svg+xml;base64,');
  }

  .checkbox:disabled {
    background-image: url('data:image/svg+xml;base64,');
  }

  .checkbox:checked:disabled {
    background-image: url('data:image/svg+xml;base64,');
  }

  .radiobutton {
    background-image: url('data:image/svg+xml;base64,');
  }

  .radiobutton:checked {
    background-image: url('data:image/svg+xml;base64,');
  }

  .radiobutton:disabled {
    background-image: url('data:image/svg+xml;base64,');
  }

  .radiobutton:checked:disabled {
    background-image: url('data:image/svg+xml;base64,');
  }

  .withControlsGrayscale {
    filter: grayscale(1);
  }
}

@import '~in-themes/active.less';

:local {
  .dialog {
    width: 66.25rem;
    height: 530px;
    &.advancedMode {
      max-height: 90vh;
      height: calc(100vh - 14rem);
    }
  }

  .slideInContainer {
    padding: 0 1.375rem;
  }
}

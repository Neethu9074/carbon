@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .column {
    display: flex;
    flex-direction: column;
  }
  .name {
    .breakWord();
    line-height: 1.25rem;
  }
  .nameSubtext {
    color: @lib__colors__N600Light;
    font-size: @lib__typography__body-small__font-size;
    line-height: 1rem;
  }
}

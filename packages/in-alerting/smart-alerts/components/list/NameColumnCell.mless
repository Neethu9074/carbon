@import '~in-themes/mixins.less';

:local {
  .main {
    padding-right: 1rem;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .column {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    // to allow a very small minimum column width,
    // it will expand and fill the possible space
    min-width: 4rem;
    flex: 1;
  }

  .name {
    .ellipsis();

    color: var(--ids-color-option-neutral-900);
    line-height: 1.25rem;
  }

  .nameSubtext {
    .ellipsis();
    color: var(--ids-color-option-neutral-600);
    font-size: var(--ids-font-size-option-body-small);
    line-height: 1rem;
  }
}

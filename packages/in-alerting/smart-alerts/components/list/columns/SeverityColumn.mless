:local {
  .iconWarning {
    cursor: auto;
    svg {
      path:first-of-type {
        fill: var(--ids-color-option-black);
      }
      path:last-of-type {
        fill: var(--cds-support-warning);
      }
    }
  }

  .iconCritical {
    cursor: auto;
    svg {
      fill: var(--cds-support-error) !important;
    }
  }
}

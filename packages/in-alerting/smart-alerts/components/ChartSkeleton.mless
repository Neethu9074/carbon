:local {
  .skeletonWrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-around;
    height: 12rem;
  }

  .legendSkeleton {
    margin-top: 0;
    display: block;
    width: 20%;
    height: 1rem;
  }

  .chartSkeleton {
    margin-top: 1.375rem;
    display: block;
    width: 100%;
    height: 100%;
  }
}

:local {
  .description {
    padding-left: 2rem;
    margin-top: 1rem;
  }
  .granularityContainer {
    display: grid;
    align-items: start;
    grid-template-columns: 15% 85%;
    padding-top: 1.5rem;

    & > div > div {
      padding: 0px 1.5rem !important;
    }
  }
}

@import '~in-themes/mixins.less';

:local {
  .allProperties {
    display: flex;
    flex-direction: row;
    overflow-x: hidden;
  }

  .ellipsis {
    .ellipsis();
  }
  .grid3 {
    display: grid;
    grid-template-columns: 43% 32% 25%;
    grid-template-rows: min-content auto;
    grid-column-gap: 1rem;
    width: 100%;
    align-items: center;
  }
  .grid2 {
    grid-template-columns: 50% 45%;
  }
  .color900 {
    color: var(--ids-color-option-navy-900);
  }
  .colorDanger {
    color: var(--cds-button-danger-secondary);
    &:hover {
      background: var(--ids-color-option-red-100);
      color: var(--cds-button-danger-secondary);
    }
  }
}

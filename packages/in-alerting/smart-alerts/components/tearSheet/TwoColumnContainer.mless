:local {
  .container {
    display: grid;
    grid-template-areas: 'main secondary';
    grid-template-columns: 2fr 1fr;
    border-radius: var(--ids-border-radius-option-small);
    border: 1px solid var(--ids-color-option-neutral-300);
  }

  .mainAreaLeft {
    grid-template-columns: 1fr 3fr;
    grid-template-areas: 'secondary main';
  }

  .mainArea {
    border-radius: inherit;
    grid-area: main;
    padding: 0.5rem 0.5rem 0.5rem 0.5rem;
  }

  .mainAreaContent {
    border-radius: inherit;
    border: 1px solid var(--ids-color-option-neutral-300);
  }

  .removeMainAreaContentBorder {
    border: none;
  }

  .secondaryArea {
    grid-area: secondary;
    padding: 0.5rem;

    &.borderRight {
      border-left: none;
      border-right: 1px solid var(--ids-color-option-neutral-300);
    }
  }

  .removePadding {
    padding: 0;
  }

  .columnHeader {
    display: flex;
    align-items: center;

    :nth-child(2) {
      margin: 0 0 0.3rem 0.5rem;
    }
  }
  .alertProsWrapper {
    display: grid;
    grid-template-columns: 60% 38%;
    grid-template-rows: min-content auto;
    grid-column-gap: 1rem;
    width: 100%;
    align-items: flex-start;
    padding-top: 1.5rem;
  }
  .alertProsForm {
    border-right: 1px solid var(--ids-color-option-neutral-300);
    padding-right: 2.4rem;
    padding-top: 1.5rem;
    > div {
      border: none;
    }
  }
  .alertProsPreview {
    padding-left: 1.4rem;
  }
}

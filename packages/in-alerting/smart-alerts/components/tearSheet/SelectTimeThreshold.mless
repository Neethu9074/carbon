:local {
  .triggerAlertContainer {
    display: grid;
    align-items: center;
    justify-items: start;
    padding-top: 1.5rem;
    grid-template-columns: 15% 85%;
    grid-gap: 1rem;
  }
  .width80 {
    width: 80%;
  }
}

:local {
  .triggerAlertContainer {
    display: grid;
    align-items: center;
    justify-items: stretch;
    padding-top: 1.5rem;
    grid-template-columns: 15% 1fr;
    grid-gap: 1rem;
  }
  .label {
    width: 5rem;
    word-wrap: break-word;
  }
}

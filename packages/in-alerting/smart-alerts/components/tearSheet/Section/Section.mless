:local {
  .section {
    display: grid;
    grid-template-columns: 11rem 1fr;
    align-items: center;
    justify-items: start;
    width: 100%;
    min-height: 2rem;
  }

  .title {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    width: var(--titleWidth);
  }

  .hasError {
    color: var(--ids-color-option-red-500);
  }

  .content {
    width: calc(100% - var(--titleWidth));
    flex-grow: 1;
  }

  .actions {
    flex-shrink: 0;
  }
}

:local {
  .titleRowContainer {
    display: grid;
    align-items: center;
    grid-template-columns: 15% 45% 30% 5%;
    grid-gap: 1rem;

    > div input::placeholder {
      opacity: 0.5;
    }
  }
  .noPlaceholder {
    grid-template-columns: 15% 1fr;
  }
  .noPlaceholderTooltip {
    grid-template-columns: 15% 2fr 1fr;
  }
  .btnWidth100 {
    width: 100%;
    > button {
      width: 100%;
    }
  }
  .titleValidation {
    padding-left: 15%;
    margin-left: 1rem;
  }
}

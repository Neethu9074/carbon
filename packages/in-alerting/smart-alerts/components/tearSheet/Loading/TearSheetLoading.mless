@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .firstRow {
    margin-top: @grid__gutter * 1px;
  }

  .leftSection {
    width: 100%;
    height: 22.5rem;
    display: block;
  }

  .sectionName {
    width: 100%;
    height: 15.563rem;
    display: block;
  }

  .header {
    width: 100%;
    height: 4rem;
    display: block;
  }

  .title {
    width: 50%;
    height: 2rem;
    display: block;
  }

  .sectionTitle {
    width: 60%;
    height: 2rem;
    display: block;
  }

  .lightMode {
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-option-large);
    box-shadow: var(--ids-shadow-option-subtle);
  }
}

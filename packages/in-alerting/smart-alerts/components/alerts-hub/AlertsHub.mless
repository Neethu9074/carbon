@import '~in-themes/active.less';

:local {
  .headline {
    color: var(--ids-color-option-neutral-900);
    font-size: var(--ids-font-size-option-heading-700);
    line-height: 2.5rem;
    margin-bottom: 0.5rem;
    font-weight: normal;
  }
  .mainRow {
    margin-top: 4rem;
    height: 50%;
  }
  .container {
    height: 100%;

    font-size: var(--ids-font-size-option-body-regular);
    color: var(--ids-color-option-neutral-600);
    padding: 0.5rem 0 0.5rem 0.5rem;
  }
}

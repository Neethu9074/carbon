:local {
  .noDataTile {
    width: 100%;
    padding: 2.5rem 2rem 2.5rem;
    :global(.c4p--empty-state__content) {
      width: 15.5rem;
    }
  }

  .whitebg {
    background-color: var(--ids-color-option-white);
  }

  .carbonRightHeader {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    z-index: 2;
  }

  .radio {
    width: 3rem;
  }

  :global(.cds--data-table) tbody.empty-table-body tr {
    height: 14rem;
  }

  :global(.cds--data-table) tbody.empty-table-body tr td {
    display: flex;
    align-items: flex-start;
    padding-top: 2rem;
    border-block-end: 0;
  }

  :global(.cds--data-table).empty-table-wrapper tbody th,
  :global(.cds--data-table).empty-table-wrapper tbody tr:hover td {
    border-block-end: 0;
  }

  :global(.cds--data-table) tbody.empty-table-body,
  :global(.cds--data-table) tbody.empty-table-body tr:not([data-child-row]):hover,
  :global(.cds--data-table) tbody.empty-table-body tr[data-child-row]:hover > td {
    background-color: transparent;
  }
  :global(.cds--data-table) td .empty-table {
    position: absolute;
    max-width: 16.6rem;
  }

  .table-fixed-layout {
    table-layout: fixed;
  }
}

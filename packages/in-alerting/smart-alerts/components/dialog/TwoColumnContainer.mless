:local {
  .container {
    display: grid;
    grid-template-areas: 'main secondary';
    grid-template-columns: 2fr 1fr;
    border-radius: var(--ids-border-radius-small);
    border: 1px solid var(--ids-color-option-neutral-300);
  }

  .headline {
    color: var(--ids-color-option-neutral-900);
    font-size: var(--ids-font-size-option-heading-300);
    font-weight: 500;
    line-height: 2rem;
    margin-left: 0.5rem;
  }

  .mainAreaLeft {
    grid-template-columns: 1fr 2fr;
    grid-template-areas: 'secondary main';
  }

  .mainArea {
    border-radius: inherit;
    grid-area: main;
    padding: 1rem 0.5rem 0.5rem 0.5rem;
  }

  .mainAreaContent {
    border-radius: inherit;
    border: 1px solid var(--ids-color-option-neutral-300);
  }

  .removeMainAreaContentBorder {
    border: none;
  }

  .secondaryArea {
    grid-area: secondary;
    border-left: 1px solid var(--ids-color-option-neutral-300);
    background-color: var(--ids-color-option-neutral-100);
    padding: 0.5rem;

    &.borderRight {
      border-left: none;
      border-right: 1px solid var(--ids-color-option-neutral-300);
    }
  }

  .removePadding {
    padding: 0;
  }

  .columnHeader {
    display: flex;
    align-items: center;

    :nth-child(2) {
      margin: 0 0 0.3rem 0.5rem;
    }
  }
}

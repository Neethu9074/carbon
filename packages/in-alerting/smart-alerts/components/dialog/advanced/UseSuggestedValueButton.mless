:local {
  .buttonWrapper {
    margin-left: auto;
  }

  .multiThresholdButtonWrapper {
    margin-left: 2rem;
    margin-right: unset;
  }

  .loadingIndicator {
    width: unset;
    flex-grow: 1;
    justify-content: flex-end;
  }

  .multiThresholdLoadingIndicator {
    flex-grow: unset;
    margin-left: 1rem;
  }

  .loadingIndicatorText {
    margin: 0 0.5rem;
    min-width: 10rem;
  }
}

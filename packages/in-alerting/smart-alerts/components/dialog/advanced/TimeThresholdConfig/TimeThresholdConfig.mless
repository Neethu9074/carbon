:local {
  .alertConfigItemContainer {
    display: grid;
    align-items: center;
    justify-items: start;
    min-height: 5.3125rem;

    /* to have have the main label aligned with content, separately from any error message */
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;

    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    &.columns4 {
      grid-template-columns: 10% 20% repeat(2, auto);
    }
    &.columns3 {
      grid-template-columns: 10% 20% 70%;
    }
    &.itemWithLabelGrid {
      grid-template-columns: 20% 80%;
    }
    &.leftPaddingNoIcon {
      padding-left: 1rem;
    }
  }

  .icon {
    justify-self: center;
    fill: var(--ids-color-option-neutral-600);
  }

  .alertThresholdConfigContainer {
    div:last-child {
      border-bottom: 0;
    }
  }

  .formGroup {
    padding: 0.5rem;
  }

  .toggle {
    justify-self: end;
  }

  .operatorLabel {
    color: var(--ids-color-option-neutral-700);
    font-size: 0.875rem;
    font-weight: normal;
    margin-left: 0.625rem;
  }

  .thresholdTypeSelection {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    color: var(--ids-color-option-neutral-700);
    padding: 0.5rem 0.5rem 0.5rem 0.25rem;
  }

  .errorMessage {
    padding-left: 0.5rem;
  }

  .input {
    width: 5.625rem;
  }

  .checkbox {
    align-items: flex-start; // align top, even when text broken up in lines
    &:hover {
      cursor: pointer;
    }
  }

  .checkboxDisabled {
    align-items: flex-start; // align top, even when text broken up in lines
    color: var(--ids-color-option-neutral-500);
  }

  .checked {
    font-weight: bold;
    background-color: var(--ids-color-option-white);
  }

  .configureImpactControlsWrapper {
    // allow more than one entries that will each start on a new grid row
    grid-column-start: 2;
    width: 100%;
    padding: 0 1rem;
    display: grid;
    grid-template-columns: 25% auto auto;
    align-items: center;

    .errorMessageBelowInput {
      // error message should be aligned with input field
      grid-column-start: 2;
      padding-left: 0.5rem;
    }
  }

  .configureSingleControlWrapper {
    padding: 0 1rem;
  }
}

@import '~in-themes/mixins.less';

:local {
  .previewArea {
    border-left: 1px solid var(--ids-color-option-neutral-300);
    background-color: var(--ids-color-option-neutral-100);
    padding: 1rem;
  }

  .alertPreview {
    background-color: var(--ids-color-option-white);
    border-left: 6px solid;
    border-radius: var(--ids-border-radius-option-small);
    box-shadow: var(--ids-shadow-option-strong);
    color: var(--ids-color-option-neutral-600);
    min-height: 12.5rem;
    padding: 0.5rem;
    overflow: hidden;
    .breakWord();

    display: flex;

    &.severityLow {
      border-color: var(--ids-color-option-yellow-500);
    }

    &.severityHigh {
      border-color: var(--ids-color-option-red-500);
    }

    p {
      padding-left: 0.5rem;
    }
  }
  .alertPreviewTearSheeet {
    min-height: 10.5rem;
  }

  .multiThresholdAlertPreview {
    min-height: 6rem;
  }

  .alertPreviewContent {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .alertPreviewHeadline {
    color: var(--ids-color-option-neutral-900);
    font-size: var(--ids-font-size-option-heading-300);
    font-weight: 500;
    margin-left: 0.5rem;
    line-height: 1.5rem;
  }

  .alertLevelIcon {
    &.severityLow {
      fill: var(--ids-color-option-yellow-500);
    }

    &.severityHigh {
      fill: var(--ids-color-option-red-500);
    }
  }

  .space {
    margin-right: 1rem;
  }

  .divider:after {
    content: '/';
    margin-left: 0.5rem;
    margin-right: 0.5rem;
  }

  .centered {
    .flexbox();
  }

  .siteAndPageNames {
    display: flex;
  }

  .filterIcon {
    fill: currentColor;
    margin-right: 0.25rem;
  }
}

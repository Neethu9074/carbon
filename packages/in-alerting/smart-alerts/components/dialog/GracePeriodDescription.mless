:local {
  .container {
    display: flex;
    align-items: center;
    line-height: 1.25rem;
    padding: 1rem;
  }

  .label {
    color: var(--ids-color-option-neutral-600);
    font-size: 0.75rem;
  }

  .icon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-600);
  }
}

:local {
  .thresholdConditionForBuiltInAlert {
    color: var(--ids-color-option-neutral-700);
    gap: 1rem;
  }

  .thresholdValueWithValidationMessage {
    padding: 1rem 0;
  }

  .multiThresholdValueWithValidationMessage {
    padding: 0.5rem 0;
  }

  .narrowControl {
    width: 6rem;
  }

  .toolTip {
    display: flex;
    align-items: center;
  }

  .topPaddingCarbonInput {
    padding-top: 1.25rem;
  }

  .topPaddingInput {
    padding-top: 1.75rem;
  }
}

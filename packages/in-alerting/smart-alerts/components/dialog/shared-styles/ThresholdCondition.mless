:local {
  .thresholdConditionForBuiltInAlert {
    color: var(--ids-color-option-neutral-700);
    gap: 1rem;
  }

  .multiThresholdValueWithValidationMessage {
    padding: 0.5rem 0;
  }

  .narrowControl {
    width: 6rem;
    :global .cds--number__input-wrapper {
      width: 12rem;
    }
  }

  .toolTip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .topPaddingInput {
    padding-top: 1.75rem;
  }

  .numberInput {
    :global .cds--number__input-wrapper {
      width: 12rem;
      input {
        height: 2.05rem;
      }
    }
  }
}

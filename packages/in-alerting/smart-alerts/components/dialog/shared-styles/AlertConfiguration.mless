:local {
  .alertChannelsWrapper {
    margin: -1px;
  }

  .paddingBodyWrapper {
    padding: 1rem;
  }

  .evaluationType {
    border-radius: var(--ids-border-radius-option-small);
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
  }

  .lightCardHeader {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }

  .title {
    font-size: 1.375rem;
    font-weight: 500;
    display: flex;
  }
}

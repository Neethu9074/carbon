@import '~in-themes/mixins.less';
:local {
  .message {
    display: flex;
    align-items: center;
    justify-content: center;

    background-color: var(--ids-color-option-neutral-200);
    color: var(--ids-color-option-neutral-600);
    height: 14.375rem;
    width: 100%;
    padding: 0 0.5rem 0.5rem;

    > span {
      margin-left: 0.5rem;
    }

    > svg {
      fill: var(--ids-color-option-neutral-600);
    }
  }

  .whiteBackground {
    background-color: var(--ids-color-option-white);
  }
}

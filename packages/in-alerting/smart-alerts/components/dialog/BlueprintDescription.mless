@import '~in-themes/mixins.less';

:local {
  .container {
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    color: var(--ids-color-option-neutral-600);
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.5rem 0 0.5rem 0.5rem;
    min-height: 15.625rem;
  }

  .headline {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
    margin-bottom: 0.5rem;
    // allow beta badge placed besides the title
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header {
    margin-bottom: 0;
  }

  .button {
    align-self: flex-end;
    flex-grow: 0;
  }

  .text {
    font-size: inherit;
    color: currentColor;
    // margin: 0 0 10px 0;
    .breakWord();
    white-space: normal;
  }
}

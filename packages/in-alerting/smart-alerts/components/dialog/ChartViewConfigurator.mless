@import 'in-themes/active.less';

:local {
  .container {
    // this magic number was found by measuring the height which is needed after
    // it was finally loaded and rendered.
    //
    // we should consider figure out an improved layout, after some issues in the
    // chart itself will be improved.
    //
    // see also comment here:
    // https://github.ibm.com/instana/ui-client/pull/9161#discussion_r6011985
    min-height: 296px;
  }

  .labelWithGap {
    margin-right: 0.5rem;
  }

  .expanding {
    flex: 1;
  }

  .withSelection {
    margin-top: 1rem;
    min-height: 23rem;
  }

  .headerTransparent {
    background-color: transparent;
  }

  .singleChartViewConfig {
    font-size: var(--ids-font-size-option-body-regular);
  }

  .flexItem {
    display: flex;
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 0.5rem;
    align-items: center;
  }
  .boxBorder {
    border: 1px solid var(--ids-color-option-neutral-300);
    padding: 0.75rem;
  }
}

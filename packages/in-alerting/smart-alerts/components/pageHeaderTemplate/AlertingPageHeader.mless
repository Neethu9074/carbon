:local {
  .spaceBetween {
    justify-content: space-between;
    padding-top: 1rem;
    background-color: var(--ids-color-option-white);
    padding-left: 1.5rem;
    height: 4.75rem;
    box-shadow: 0px 10px 16px -8px rgba(0, 0, 0, 0.3);
    position: relative;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .fullWidth {
    width: 100%;
  }

  .alertIcon {
    margin-right: 1.5rem;

    &SeverityLow {
      fill: @lib__colors__warning;
    }

    &SeverityHigh {
      fill: @lib__colors__failure;
    }
  }

  .column {
    display: flex;
    flex-direction: column;
  }

  .nameListColumn {
    padding-right: 1rem;
  }

  .name {
    .breakWord();
    line-height: 1.25rem;
  }

  .nameSubtext {
    color: @lib__colors__N600Light;
    font-size: @lib__typography__body-small__font-size;
    line-height: 1rem;
  }

  .space {
    margin-right: 1rem;
  }

  .bigSpace {
    margin-right: 2rem;
  }

  .moreItems {
    color: @lib__colors__N600Light;
  }

  .moreEntities {
    .moreItems();
    cursor: pointer;
  }

  .overlayContentWrapper {
    width: 50rem;
  }
}

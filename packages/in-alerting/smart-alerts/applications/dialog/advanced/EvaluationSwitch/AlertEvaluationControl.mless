@import '~in-themes/active.less';

:local {
  .container {
    display: flex;
    align-items: flex-start;

    line-height: 1.25rem;

    border-radius: var(--ids-border-radius-small);
    border: 1px solid var(--ids-color-option-neutral-300);
    padding: 1rem;
  }

  .options {
    margin-left: 1rem;
    align-items: center;
    color: var(--ids-color-option-neutral-900);
  }

  .readOnlyAlertEvaluationContainer {
    border: 1px solid var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-small);
  }
}

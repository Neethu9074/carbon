:local {
  .container {
    display: flex;
    align-items: flex-start;

    line-height: 1.25rem;

    border-radius: var(--ids-border-radius-option-small);
    border: 1px solid var(--ids-color-option-neutral-300);
    padding: 1rem;
  }

  .options {
    margin-left: 1rem;
    align-items: center;
    color: var(--ids-color-option-neutral-900);
  }

  .readOnlyAlertEvaluationContainer {
    border: 1px solid var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-option-small);
  }

  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
      padding-left: 0.5rem;
    }

    &.optionBoxUnchecked {
      svg {
        fill: var(--ids-color-option-neutral-600);
      }

      * {
        color: var(--ids-color-option-neutral-600);
      }
    }
  }

  .tearSheetOptions {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    align-items: flex-start;
    padding-top: 1.5rem;
  }
}

:local {
  .verticalAlignedCells {
    align-items: normal;
  }
  .optionBox {
    width: 60rem;
    &.optionBox {
      border: none;
      border-radius: 0;
    }

    &.optionBoxUnchecked {
      svg {
        fill: var(--ids-color-option-neutral-600);
      }

      color: var(--ids-color-option-neutral-600);
    }
  }

  .staticOrAdaptiveOption {
    align-self: center;
  }

  .topMargin {
    margin-top: 1rem;
  }

  .bottomMargin {
    margin-bottom: 1rem;
  }

  .sidePadding {
    padding: 0 1rem;
  }
}

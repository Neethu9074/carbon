:local {
  .icon {
    width: 1.5rem;
    height: 1.5rem;
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-700);
  }

  .content {
    display: flex;
    align-items: flex-start;
  }

  .notSupported {
    display: inline-flex;
    margin: 0 0 0 5px;
  }
  .pillContent {
    display: flex;
    align-items: center;

    & > svg {
      padding-right: 3px;
    }
  }
}

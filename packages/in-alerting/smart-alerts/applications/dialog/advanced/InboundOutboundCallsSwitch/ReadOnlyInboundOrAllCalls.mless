@import '~in-themes/active.less';

:local {
  .icon {
    fill: var(--ids-color-option-teal-500);
    margin: 0 4px;
  }

  .content {
    width: 85%;
  }

  .title {
    color: var(--ids-color-option-teal-500);
    font-size: 0.75rem;
  }

  .container {
    display: flex;
    align-items: center;
    color: var(--ids-color-option-neutral-900);
    font-size: var(--ids-font-size-option-body-regular);
    line-height: 1.25rem;
    border: 1px solid var(--ids-color-option-neutral-400);
    border-radius: var(--ids-border-radius-medium);
    padding: 0.5rem;
  }
}

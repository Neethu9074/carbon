@import '~in-themes/mixins.less';

:local {
  .fullWidth {
    width: 100%;
  }

  .alertIcon {
    &SeverityLow {
      fill: var(--ids-color-option-yellow-500);
    }

    &SeverityHigh {
      fill: var(--ids-color-option-red-500);
    }
  }

  .column {
    display: flex;
    flex-direction: column;
  }

  .nameListColumn {
    padding-right: 1rem;
    gap: 1.5rem;
  }

  .name {
    .breakWord();
    line-height: 1.25rem;
  }

  .nameSubtext {
    color: var(--ids-color-option-neutral-600);
    font-size: var(--ids-font-size-option-body-small);
    line-height: 1rem;
  }

  .space {
    margin-right: 0.2rem;
  }

  .bigSpace {
    margin-right: 2rem;
  }

  .moreItems {
    color: var(--ids-color-option-neutral-600);
  }

  .moreEntities {
    .moreItems();
    cursor: pointer;
  }

  .overlayContentWrapper {
    width: 50rem;
  }

  .centered {
    display: inline-flex;
    align-items: center;
  }

  .filters {
    display: flex;
    color: var(--ids-color-option-neutral-700);
  }
  .ellipsis {
    .ellipsis();
  }
  .maxWidth70 {
    max-width: 70%;
  }
  .maxWidth100 {
    max-width: 100%;
  }
}

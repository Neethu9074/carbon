:local {
  .button {
    border-radius: 1.5rem;
    border: none;
    transition: background-color 250ms;
    box-shadow: var(--ids-shadow-option-pronounced);

    font-size: var(--ids-font-size-option-body-regular);
    font-weight: bold;
    line-height: 1.25rem;
    text-transform: uppercase;

    &:hover {
      cursor: pointer;
      text-decoration: none;
    }
  }
}

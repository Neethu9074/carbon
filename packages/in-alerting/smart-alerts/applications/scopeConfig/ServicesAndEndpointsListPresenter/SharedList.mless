:local {
  .greyCheckbox {
    filter: grayscale(100%);
  }

  .last {
    animation: highlight 1000ms ease-out;
  }

  @keyframes highlight {
    0% {
      background-color: var(--ids-color-option-blue-400);
    }
    100% {
      background-color: white;
    }
  }

  .iconLabelTouched {
    font-weight: 600;
  }

  .listItem {
    background: var(--ids-color-option-neutral-100);
  }

  .emptyListPlaceholderMessage {
    width: 100%;
  }

  .customListItem {
    background: var(--ids-color-option-white);
  }

  .viewOnly {
    cursor: not-allowed;
  }
}

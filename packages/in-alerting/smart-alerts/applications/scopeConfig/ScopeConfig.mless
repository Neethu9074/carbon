:local {
  .lightCardHeader {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    padding: 0.5rem;
  }

  .lightCardTitle {
    width: max-content;
    margin: 0 1rem 0.25rem 0;
    font-weight: normal;
  }

  .lightCardHeaderControlsSelectionTitle {
    color: var(--ids-color-option-neutral-600);
  }

  .lightCardHeaderControlsSearchInputWrapper {
    width: 9.375rem;
  }

  .lightCardHeaderControlsDirtyStateIndicator {
    margin-right: 0.25rem;
    font-size: 1rem;
  }

  .scopeConfigContainer {
    background: var(--ids-color-option-neutral-100);
  }

  .clearButtonWrapper {
    display: flex;
    flex-direction: row-reverse;
  }
  .alignEnd {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    margin-top: 4.5rem;
    align-items: flex-start;
  }
  .servicesAndEndpointsListPresenterWrapper {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
  }

  .toggleDialogUsage {
    > button {
      position: inherit;
      top: 0;
      display: flex;
    }
  }

  .scopeConfigContainerTearSheetView {
    background: var(--ids-color-option-white);
    padding: 1rem;
  }

  .listHeight {
    height: 20.25rem;
  }
  .list {
    max-height: 20.25rem;
    overflow: auto;
    border: 1px solid var(--ids-color-option-neutral-300);
  }

  .carbonVariant {
    .listHeight {
      height: 25.5rem;
    }
    .list {
      max-height: 25.5rem;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: 40% 58%;
    grid-template-rows: min-content auto;
    grid-column-gap: 1rem;
    width: 100%;
    align-items: center;
  }

  .alignRight {
    justify-content: flex-end;
    column-gap: 0.5rem;
  }

  .tearSheetLightCardHeader {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    padding: 1rem 0.75rem;
  }

  .subtitle {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .searchContext {
    width: 9rem;
  }
}

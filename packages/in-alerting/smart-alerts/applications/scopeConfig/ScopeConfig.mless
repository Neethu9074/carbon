:local {
  .lightCardHeader {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    padding: 0.5rem;
  }

  .lightCardTitle {
    width: max-content;
    margin: 0 1rem 0.25rem 0;
    font-weight: normal;
  }

  .lightCardHeaderControlsSelectionTitle {
    color: var(--ids-color-option-neutral-600);
  }

  .lightCardHeaderControlsSearchInputWrapper {
    width: 9.375rem;
    margin-left: 1rem;
  }

  .lightCardHeaderControlsDirtyStateIndicator {
    margin-right: 0.25rem;
    font-size: 1rem;
  }

  .scopeConfigContainer {
    background: var(--ids-color-option-neutral-100);
  }

  .alertFilterConfiguratorWrapper {
    padding-left: 1rem;
  }

  .clearButtonWrapper {
    display: flex;
    flex-direction: row-reverse;
  }

  .servicesAndEndpointsListPresenterWrapper {
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
  }

  .alertFilterConfiguratorWrapperBottomPadding {
    padding-bottom: 1rem;
  }

  .toggleDialogUsage {
    > button {
      position: inherit;
      top: 0;
      display: flex;
    }
  }
}

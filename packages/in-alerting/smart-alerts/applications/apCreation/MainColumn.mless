@import '~in-themes/active.less';

:local {
  .iconWarning {
    fill: var(--ids-color-option-yellow-500);
  }

  .iconCritical {
    fill: var(--ids-color-option-red-500);
  }

  .labelTextWrapper {
    white-space: break-spaces;
  }
}

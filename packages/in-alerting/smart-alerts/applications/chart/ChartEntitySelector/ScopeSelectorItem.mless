@import '~in-themes/mixins.less';

@gap: 0.25rem;

:local {
  .selectorItem {
    flex-wrap: wrap;
  }

  .separator {
    margin: 0 @gap;
    fill: var(--ids-color-option-neutral-600);
  }

  .cutOffText {
    .ellipsis();
  }

  .smallColumn {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;

    flex-shrink: 1;
    .ellipsis();
    gap: @gap; // between icon and label
  }

  .normalColumn {
    display: flex;
    align-items: center;

    flex-wrap: nowrap;
    flex-shrink: 1;
    .ellipsis();
    gap: @gap; // between icon and label
  }

  .entityIcon {
    vertical-align: middle;
    margin-right: @gap;
  }

  .icon {
    fill: var(--ids-color-option-neutral-600);
  }

  .fullColumn {
    display: inline-flex;
    flex-flow: row;
    gap: @gap;
    white-space: normal; // enable line-break
    font-size: var(--ids-font-size-option-body-regular);

    word-break: break-word;
    .in-browser-ff & {
      overflow-wrap: anywhere;
    }

    & > svg {
      align-self: flex-start; // icon at top

      vertical-align: middle;

      margin-top: calc(
        var(--ids-font-size-option-body-regular) - var(--ids-font-size-option-body-small) / 2
      ); // adjust to also have the icon properly aligned when in all fits in one row
      margin-bottom: calc(
        var(--ids-font-size-option-body-regular) - var(--ids-font-size-option-body-small) / 2
      ); // adjust to also have the icon properly aligned when in all fits in one row
    }
  }
}

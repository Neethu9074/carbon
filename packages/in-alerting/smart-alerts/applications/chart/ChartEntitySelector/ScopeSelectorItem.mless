@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

@gap: 0.25rem;

:local {
  .selectorItem {
    flex-wrap: wrap;
  }

  strong {
    color: black;
  }

  .separator {
    margin: 0 0 0 @gap;
    fill: @lib__colors__N600Light;
  }

  .smallColumn {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;

    max-width: 40%;
    flex-shrink: 1;
    .ellipsis();
  }

  .normalColumn {
    display: flex;
    align-items: center;

    flex-wrap: nowrap;
    flex-shrink: 1;
    .ellipsis();
  }

  .entityIcon {
    vertical-align: middle;
    margin-right: @gap;
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }

  .fullColumn {
    display: inline-flex;
    flex-flow: row;
    white-space: normal; // enable line-break
    font-size: @lib__typography__body__font-size;

    word-break: break-word;
    .in-browser-ff & {
      overflow-wrap: anywhere;
    }

    & > svg {
      align-self: flex-start; // icon at top

      vertical-align: middle;

      margin-top: (@lib__typography__body__font-size - @lib__typography__body-small__font-size) / 2; // adjust to also have the icon properly aligned when in all fits in one row
      margin-bottom: (@lib__typography__body__font-size - @lib__typography__body-small__font-size) / 2; // adjust to also have the icon properly aligned when in all fits in one row
    }
  }
}

@import '~in-themes/active.less';

:local {
    .icon {
      fill: @lib__colors__teal800;
      margin: 0 4px;
    }

    .content {
      width: 85%;
    }

    .title {
      color: @lib__colors__teal800;
      font-size: 0.75rem;
    }

  .container {
    display: flex;
    align-items: center;
    color: @lib__colors__N900Primary;
    font-size: @lib__typography__body__font-size;
    line-height: 1.25rem;
    border: 1px solid @lib__colors__N400;
    border-radius: @lib__shapes__radius_medium;
    padding: 0.5rem;

  }
}

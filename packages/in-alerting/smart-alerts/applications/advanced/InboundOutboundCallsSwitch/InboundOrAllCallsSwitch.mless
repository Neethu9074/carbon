@import '~in-themes/active.less';

:local {
  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
    }

    &.optionBoxUnchecked {
      svg {
        fill: @lib__colors__N600Light;
      }

      * {
        color: @lib__colors__N600Light;
      }
    }
  }

  .inboundOutboundCallsSwitchContainer {
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_small;
  }
}

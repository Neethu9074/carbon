:local {
  .thresholdConditionItem {
    display: grid;
    grid-column-gap: 2rem;
    grid-row-gap: 0.5rem;
    align-items: center;
    justify-items: start;
    min-height: 4rem;

    button,
    input,
    .checkbox,
    label {
      font-size: var(--ids-font-size-option-body-small);
    }
    label {
      margin-bottom: 0;
    }
    label + button {
      margin-left: 0.5rem;
    }
    input {
      margin-right: 0.5rem;
    }
    button + input {
      margin-left: 0.5rem;
    }

    color: var(--ids-color-option-neutral-700);
  }

  .displayInTwoColumns {
    grid-template-columns: 10% 90%;
  }

  .icon {
    justify-self: center;
    fill: var(--ids-color-option-neutral-600);
  }

  .label {
    padding: 0 0.5rem 0 0;
  }

  .input {
    width: 5.625rem;
  }

  .checkbox {
    &:hover {
      cursor: pointer;
    }
    &.checked {
      font-weight: bold;
    }
  }
}

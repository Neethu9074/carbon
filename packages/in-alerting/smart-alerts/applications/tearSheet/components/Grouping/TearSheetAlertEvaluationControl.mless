:local {
  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
      padding-left: 0.5rem;
    }

    &.optionBoxUnchecked {
      svg {
        fill: var(--ids-color-option-neutral-600);
      }

      * {
        color: var(--ids-color-option-neutral-600);
      }
    }
  }

  .options {
    align-items: center;
    color: var(--ids-color-option-neutral-900);
  }

  .readOnlyAlertEvaluationContainer {
    border: 1px solid var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-option-small);
  }
}

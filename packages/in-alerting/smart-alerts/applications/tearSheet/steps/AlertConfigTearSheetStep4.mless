:local {
  .container {
    display: flex;
    grid-column-gap: 1rem;
    grid-row-gap: 0.5rem;
    width: 100%;
    align-items: center;
    padding-top: 1.5rem;
  }

  .container60_40 {
    display: grid;
    grid-template-columns: 50% 48%;
    grid-template-rows: min-content auto;
    grid-column-gap: 2rem;
    grid-row-gap: 0.5rem;
    width: 100%;
    height: 100%;
    align-items: center;
  }

  .thresholdContent {
    display: grid;
    grid-template-columns: 20% 20% 50%;
    grid-template-rows: min-content auto;
    gap: 0.5rem;
    width: 100%;
    height: 100%;
  }

  .thresholdValue {
    display: grid;
    grid-template-columns: 40% 40%;
    grid-template-rows: min-content auto;
    gap: 0.5rem;
    width: 100%;
    align-items: center;
    height: 100%;
  }

  .boxBorder {
    border: 1px solid var(--ids-color-option-neutral-300);
  }

  .label {
    width: 6.06rem;
    min-width: 6.06rem;
  }

  .longLabel {
    width: 9.5rem;
  }

  .content {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-items: start;
    min-height: 4rem;
  }

  .fullWidth {
    width: 100%;
  }
}

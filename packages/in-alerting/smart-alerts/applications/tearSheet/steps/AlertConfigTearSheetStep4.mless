:local {
  .container {
    display: grid;
    grid-template-columns: 10% 90%;
    grid-template-rows: min-content auto;
    grid-column-gap: 1rem;
    grid-row-gap: 0.5rem;
    width: 100%;
    align-items: center;
  }

  .container40_60 {
    display: grid;
    grid-template-columns: 40% 58%;
    grid-template-rows: min-content auto;
    grid-column-gap: 2rem;
    grid-row-gap: 0.5rem;
    width: 100%;
    height: 100%;
    align-items: center;
  }

  .thresholdContent {
    display: grid;
    grid-template-columns: 20% 20% 50%;
    grid-template-rows: min-content auto;
    grid-column-gap: 0.5rem;
    grid-row-gap: 0.5rem;
    width: 100%;
    height: 100%;
  }

  .thresholdValue {
    display: grid;
    grid-template-columns: 40% 40%;
    grid-template-rows: min-content auto;
    grid-column-gap: 0.5rem;
    grid-row-gap: 0.5rem;
    width: 100%;
    align-items: center;
    height: 100%;
  }
}

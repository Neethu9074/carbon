:local {
  .container {
    display: grid;
    grid-template-columns: 1fr 2fr;
    grid-template-rows: min-content auto;
    grid-column-gap: 0.5rem;
    grid-row-gap: 0.5rem;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--ids-color-option-white);
    border-radius: var(--ids-border-radius-option-small) var(--ids-border-radius-option-small) 0 0;
    height: 5rem;
    padding: 0 0 0 1.5rem;
  }

  .titleContainer {
    display: flex;
    align-items: flex-end;
  }
}

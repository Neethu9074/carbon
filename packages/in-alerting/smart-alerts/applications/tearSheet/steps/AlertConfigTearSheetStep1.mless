:local {
  .container {
    display: grid;
    grid-template-columns: 30% 70%;
    grid-template-rows: min-content auto;
    grid-column-gap: 0.5rem;
    grid-row-gap: 0.5rem;
  }

  .titleContainer {
    display: flex;
    align-items: flex-end;
  }
}

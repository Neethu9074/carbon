@import '~in-themes/active.less';

:local {
  .filters {
    display: flex;
    color: @lib__colors__N700Medium;
  }

  .centered {
    display: inline-flex;
    align-items: center;
  }

  .space {
    margin-right: 1rem;
  }

  .divider:after {
    content: '/';
    margin-left: 0.5rem;
    margin-right: 0.5rem;
  }

  .filterIcon {
    fill: @lib__colors__N700Medium;
  }
}

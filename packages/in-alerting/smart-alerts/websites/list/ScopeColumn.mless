:local {
  .filters {
    display: flex;
    color: var(--ids-color-option-neutral-700);
  }

  .centered {
    display: inline-flex;
    align-items: center;
  }

  .space {
    margin-right: 1rem;
  }

  .pageNames {
    margin-right: 1rem;
    margin-top: 0.5rem;
  }

  .viewMore {
    margin-left: 1rem;
  }

  .divider:after {
    content: '/';
    margin-left: 0.5rem;
    margin-right: 0.5rem;
  }

  .filterIcon {
    fill: var(--ids-color-option-neutral-700);
  }

  :global(.cds--popover-container) {
    display: flex;
  }
}

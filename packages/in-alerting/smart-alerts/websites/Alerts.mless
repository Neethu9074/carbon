@import '~in-themes/active.less';

:local {
  .fullWidth {
    width: 100%;
  }

  .centered {
    display: inline-flex;
    align-items: center;
  }

  .filters {
    display: flex;
    color: var(--ids-color-option-neutral-700);
  }

  .space {
    margin-right: 1rem;
  }

  .divider:after {
    content: '/';
    margin-left: 0.5rem;
    margin-right: 0.5rem;
  }

  .alertIcon {
    margin-right: 1.5rem;

    &SeverityLow {
      fill: var(--ids-color-option-yellow-500);
    }

    &SeverityHigh {
      fill: var(--ids-color-option-red-500);
    }
  }

  .filterIcon {
    fill: var(--ids-color-option-neutral-700);
  }

  .column {
    display: flex;
    flex-direction: column;
  }

  .name {
    color: var(--ids-color-option-neutral-900);
    max-width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.25rem;
  }

  .nameSubtext {
    color: var(--ids-color-option-neutral-600);
    font-size: var(--ids-font-size-option-body-small);
    line-height: 1rem;
  }
}

:local {
  .container {
    margin: 0 0.5rem;
  }

  .height {
    height: 16rem;
  }

  .jsErrorTextInput {
    background-color: var(--ids-color-option-neutral-100);
  }

  .errorMessageSelectWrapper {
    margin-bottom: 1.5rem;
  }

  .helpText {
    margin-bottom: 0.5rem;
  }

  .jsErrorsSelectAdvanceMode {
    align-self: flex-end;
  }

  .jsErrorsSelectButtonAdvanceMode {
    float: right;
  }
}

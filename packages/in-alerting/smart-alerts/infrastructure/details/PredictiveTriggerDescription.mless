:local {
  .container {
    display: flex;
    align-items: center;
    color: var(--ids-color-option-neutral-900);
    font-size: var(--ids-font-size-option-body-regular);
    line-height: 1.25rem;

    padding: 1rem;

    p {
      margin: 0;
    }
  }

  .label {
    color: var(--ids-color-option-neutral-600);
    font-size: 0.75rem;
  }

  .icon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-600);
  }
}

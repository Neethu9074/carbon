:local {
  .gridWrapper {
    display: grid;
    grid-template-columns: 10% 15% 75%;
    align-items: center;
    justify-items: start;
    background: var(--ids-color-option-neutral-50);
    padding: 1rem 0.5rem;
    color: var(--ids-color-option-neutral-700);

    button,
    input,
    .checkbox,
    label {
      font-size: var(--ids-font-size-option-body-small);
    }
    input {
      margin-right: 0.5rem;
    }

    .thresholdCheckbox:disabled {
      cursor: not-allowed;
    }
  }

  .icon {
    justify-self: center;
    fill: var(--ids-color-option-neutral-600);
  }

  .label {
    margin-left: 0.5rem;
  }

  .content {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
  }
}

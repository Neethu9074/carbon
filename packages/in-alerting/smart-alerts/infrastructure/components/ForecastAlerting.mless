:local {
  .container {
    padding: 0.75rem;
  }

  .header {
    justify-content: space-between;
  }

  .headline {
    color: var(--ids-color-option-neutral-900);
    font-size: var(--ids-font-size-option-heading-300);
    font-weight: 500;
    line-height: 2rem;
  }

  .description {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ids-color-option-neutral-700);
    font-size: var(--ids-font-size-option-body-small);
  }

  .summary {
    display: block;
    margin: 0 1rem;
    margin-bottom: 1rem;
    font-size: var(--ids-font-size-option-body-regular);
  }

  .timeframeError {
    margin: 0 1rem;
  }
}

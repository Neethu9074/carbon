:local {
  .externalLink {
    display: flex;
    justify-content: space-between;
    text-decoration: none;
    flex-direction: row-reverse;
  }

  .menuWithExternalLink {
    /* overriding this was the only way possible to be able to have the label
     * filling the whole space, so that the "punch-out" or external-link icon
     * can be put at the right end of the space, aligned with the other
     * more-menu expandable-icons
     */
    :global(.cds--side-nav__link-text) {
      display: inline-flex;
      flex: 1;
      justify-content: space-between;
      align-items: center;
    }
  }

  .emailAddress {
    color: var(--cds-text-secondary);
    font-size: var(--ids-font-size-option-body-small);
  }

  .signOutButton {
    height: 3.5rem;
    cursor: pointer;

    :global(.cds--side-nav__item) {
      height: 100%;
    }

    :global(.cds--side-nav__item a.cds--side-nav__link) {
      height: 100%;
    }
  }
}

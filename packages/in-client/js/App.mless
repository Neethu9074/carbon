@import '~in-themes/mixins.less';

@import './SameServerFonts.css';

:local {
  :global(.shell-wrapper) {
    .print(none);
  }

  .content {
    position: relative;

    margin-top: 48px;

    @media (min-width: 1056px) {
      margin-left: 48px;
    }

    .print();
  }

  @page {
    size: 8.5in 11in;
    margin: 0.25in;
  }

  @media print {
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      background: var(--ids-color-option-white);
    }
  }
}

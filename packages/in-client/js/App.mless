@import '~in-themes/mixins.less';

:local {
  .content {
    position: relative;
    margin-left: 4.5rem;
  }

  .contentCarbon {
    position: relative;
    margin-left: 48px;
    margin-top: 48px;

    .print();
  }

  @media print {
    print-color-adjust: exact;

    body {
      background: var(--ids-color-option-white);
    }
  }
}

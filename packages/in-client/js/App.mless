@import '~in-themes/mixins.less';

:local {
  :global(.shell-wrapper) {
    .print(none);
  }

  .content {
    position: relative;
    margin-left: 48px;
    margin-top: 48px;

    .print();
  }

  @media print {
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      background: var(--ids-color-option-white);
    }
  }
}

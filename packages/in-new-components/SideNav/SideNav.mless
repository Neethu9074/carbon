@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .container {
    padding-left: 1rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    margin: 1.25rem 0;

    color: @lib__colors__N600Light;
    font-size: @lib__typography__body__font-size;
    line-height: 1.25rem;

    &:hover {
      cursor: pointer;
    }

    &.selected {
      color: @lib__colors__N900Primary;
    }
  }

  .label {
    .flexbox();
  }
}

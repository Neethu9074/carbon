@import '~in-themes/active.less';

:local {
  .container {
    display: grid;
    grid-template-columns: 1fr 2fr 2fr;
    grid-template-rows: min-content auto;
    grid-column-gap: 0.5rem;
    grid-row-gap: 0.5rem;

    height: 29.375rem;
    margin-top: 2rem;
    width: 100%;

    overflow-x: auto;
  }

  .headline {
    grid-column: 1 / span 3;
    color: @lib__colors__N900Primary;
    font-size: @lib__typography__h700__font-size;
    line-height: 2.5rem;
    margin: 0.5rem;
    font-weight: normal;
  }
}

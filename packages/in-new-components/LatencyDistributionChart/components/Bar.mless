@import '~in-themes/active.less';

:local {
  .barOuter {
    display: flex;
    align-items: flex-end;

    &:hover {
      background: darken(#fff, 10%);

      .barInner {
        background: lighten(@lib__colors__light-blue800, 10%);
      }
    }
  }

  .barInner {
    background: @lib__colors__light-blue800;
    min-height: 2px;
  }

  .tooltipContent {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-width: 12rem;
  }

  .labelWrapper {
    display: flex;
    align-items: center;
  }

  .dot {
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }

  .value {
    margin-left: 2rem;
    font-weight: bold;
    color: @lib__colors__N900Primary;
  }
}

@import '~in-themes/active.less';

:local {
  .horizontalAxis {
    display: flex;
    justify-content: space-between;
    padding: 0 11px;
    border-top: 1px solid #8c969a;
  }

  .tickContainer {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tick {
    border-left: 1px solid #8c969a;
    height: 4px;
    width: 1px;
  }

  .tickValues {
    white-space: nowrap;
    color: @lib__colors__N700Medium;
    font-size: 0.5625rem;
    line-height: 1.4;
  }
}

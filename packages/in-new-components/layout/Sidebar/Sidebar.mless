:local {
  .sidebar {
    right: 0;
    width: 40%;
    min-width: 750px;
    max-width: 100vw;

    overflow-x: hidden;
    overflow-y: auto;

    padding: 1.5rem;

    background: #fff;
    box-shadow: 0 0 32px 0 rgba(0, 0, 0, 0.16);
    z-index: 1;
  }

  @media (min-width: 1000px) {
    .sidebar {
      max-width: 50vw;
    }
  }

  @media (min-width: 1280px) {
    .sidebar {
      max-width: 43.75rem;
    }
  }

  @media (min-width: 1920px) {
    .sidebar {
      max-width: 50rem;
    }
  }
}

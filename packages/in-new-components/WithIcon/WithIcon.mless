@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
  }

  .pluginIcon,
  .linkEntityIcon {
    margin-right: 0.25rem;
    fill: @lib__colors__N900Primary;
  }

  .pluginIcon {
    margin-right: 0.5rem;
  }

  .specialIndicator {
    position: absolute;
    left: -6px;
    height: 6px;
    width: 6px;
    background-color: @lib__colors__orange800;
    border-radius: 50%;
    display: inline-block;
  }
}

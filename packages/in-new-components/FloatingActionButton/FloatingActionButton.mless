@import '~in-themes/active.less';

:local {
  .button {
    background-color: @lib__colors__light-blue800;
    border-radius: 1.5rem;
    border: none;
    color: @lib__colors__white;
    padding: 0.75rem;
    position: fixed;

    &:hover {
      cursor: pointer;
    }
  }

  .bottomRight {
    bottom: 1.5rem;
    right: 1.5rem;
  }

  .hasIcon {
    padding-right: 1.25rem;
  }

  .withShadow {
    box-shadow: @lib__shadows__pronounced;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon {
    fill: @lib__colors__white;
    margin-right: 0.5rem;
  }

  .label {
    font-size: @lib__typography__body__font-size;
    font-weight: bold;
    line-height: 1.25rem;
    text-transform: uppercase;
  }
}

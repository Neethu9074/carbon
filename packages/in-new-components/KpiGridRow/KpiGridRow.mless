@import '~in-themes/active.less';

:local {
  .row {
    margin: 0;
    border: 1px solid @lib__colors__N200;
    margin-left: -1px * (@grid__gutter / 2);
    margin-right: -1px * (@grid__gutter / 2);

    & + .row {
      margin-top: 0.5rem;
      border-top: 0;
    }
  }

  .col {
    padding-right: 0.75rem;
    padding-left: 0.75rem;
  }

  @media (min-width: 1280px) {
    .col {
      border-left: 1px solid @lib__colors__N200;

      &:first-child {
        border-left: 0;
      }
    }
  }
}

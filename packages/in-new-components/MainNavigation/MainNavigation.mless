@import '~in-themes/active.less';

:local {
  .navigation,
  .background {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
  }

  .backPlane {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
  }

  .navigation {
    width: @main-navigation-width;
    transition: width 0.2s ease-in-out;

    padding: 1.0625rem 0 4rem 0;

    background: @lib__colors__navy900;
    box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.24);

    overflow: hidden;
    z-index: @z-index__main-navigation;
  }

  .expandedNavigation {
    width: 17.5rem;
    overflow-y: auto;
  }

  .background {
    right: 0;

    background: rgba(216, 216, 216, 0.5);
    z-index: @z-index__main-navigation-background;
  }
}

@import '~in-themes/active.less';

:local {
  .navigation {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;

    width: 4.5rem;
    transition: width 0.2s ease-in-out;

    padding: 1.375rem 0 4rem 0;

    background: @lib__colors__navy900;

    overflow: hidden;
    z-index: @z-index__main-navigation;
  }

  .expandedNavigation {
    width: 17.5rem;
    overflow-y: auto;
  }
}

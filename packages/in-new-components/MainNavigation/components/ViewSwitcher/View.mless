@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  @hover-color: rgba(246, 193, 193, 0.23);
  @border: 0.1875rem solid @lib__colors__blue800;

  .view {
    position: relative;
    margin: 0.25rem 0;
  }

  .collapsed,
  .collapsedActive,
  .collapsedActiveWithChildren {
    .wrapper {
      width: ~'calc(100% - 1.5rem)';
      margin: 0 0.75rem;
      border-radius: 50%;
    }
  }

  .collapsedActive {
    .link {
      margin: 0 0.5rem 0 0.3125rem;
    }
  }

  .collapsed,
  .collapsedActive {
    .link {
      padding: 0.5rem 0.5rem;
    }
  }

  .collapsedActive,
  .activeSidebarExpanded {
    .icon {
      fill: white;
    }
  }

  .activeSidebarExpanded {
    .wrapper {
      background: @lib__colors__blue800;
      &:hover {
        background: @lib__colors__blue800;
      }
    }
    .label {
      color: white;
      font-weight: bold;
    }
  }

  .activeSidebarExpanded,
  .collapsedActive {
    &:hover {
      .icon {
        fill: white;
      }
    }
  }

  .collapsedActive {
    .wrapper {
      border: @border;
      padding: 0;
    }
    .link {
      padding: 0.3125rem 0rem;
    }
    &:hover {
      .wrapper {
        background: none;
      }
    }
  }

  .collapsedActiveWithChildren {
    .wrapper {
      width: ~'calc(100% - 1.5rem)';
      margin: 0 0.75rem;
      padding: 0;

      background: @lib__colors__blue800;

      border: @border;
      border-radius: 50% 50% 5px 50%;

      &:hover {
        background: @lib__colors__blue800;
        border: @border;
      }

      .link {
        position: relative;
        margin: 0 0.5rem 0 0.3125rem;
        padding: 0.3125rem 0;

        &::before {
          position: absolute;
          top: 0px;
          left: -0.3125rem;
          height: 2.625rem;
          width: 2.625rem;
          background: @lib__colors__navy900;
          border-radius: 50%;
          z-index: 0;
          content: '';
        }
      }

      .icon {
        z-index: 1;
      }
    }
  }

  .expanded {
    background: @lib__colors__N800Dark;

    .wrapper {
      background: @lib__colors__N800Dark;
      &:hover {
        background: @lib__colors__N700Medium;
      }
    }

    .expandIcon {
      &:hover {
        background: @lib__colors__N600Light;
      }
    }
  }

  .wrapper,
  .link {
    display: flex;
    align-items: center;
  }

  .wrapper {
    justify-content: space-between;

    width: ~'calc(100% - 1rem)';
    margin: 0 0.5rem;

    border-radius: 0;
    transition: border-radius 0.25s ease-in-out;
    cursor: pointer;

    &:hover {
      background: @hover-color;

      .expandIcon {
        fill: white;
      }
    }
  }

  .link {
    width: 100%;
    padding: 0.5rem 0.75rem;
    user-select: none;
    &:hover {
      text-decoration: none;
    }
  }

  .icon {
    fill: @lib__colors__N400;
    margin-right: 0.75rem;
  }

  .label {
    color: @lib__colors__N400;
    font-size: 0.875rem;
    max-width: 10.25rem;
    .ellipsis();
  }

  .expandIcon {
    padding: 0.5rem;
    fill: @lib__colors__N400;

    &:hover {
      background: @lib__colors__N700Medium;
      border-radius: 50%;
    }
  }
}

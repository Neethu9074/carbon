@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  @hover-color: rgba(246, 193, 193, 0.23);

  .view {
    position: relative;
    margin-bottom: 0.25rem;
  }

  .collapsed {
    .wrapper {
      width: ~'calc(100% - 1.5rem)';
      margin-left: 0.75rem;
      border-radius: 50%;
    }
    .link {
      margin: 0 0.5rem 0 0.25rem;
    }
  }

  .collapsedActive,
  .activeSidebarExpanded {
    .wrapper {
      background: @lib__colors__blue800;
    }
    .link {
      margin: 0 0.5rem 0 0.25rem;
    }
    .icon {
      fill: white;
    }
  }

  .activeSidebarExpanded {
    .label {
      color: white;
      font-weight: bold;
    }
  }

  .collapsedActive {
    .wrapper {
      width: ~'calc(100% - 1.5rem)';
      margin-left: 0.75rem;
      border-radius: 50%;
    }
  }

  .collapsedActiveWithChildren {
    .wrapper {
      width: ~'calc(100% - 1.5rem)';
      margin-left: 0.75rem;
      padding: 0;

      background: @lib__colors__blue800;

      border: 0.25rem solid @lib__colors__blue800;
      border-radius: 50% 50% 5px 50%;

      &:hover {
        background: @hover-color;
        border-radius: 50% 50% 5px 50%;
        padding: 0.25rem;
        border: none;

        .expandIcon {
          fill: white;
        }

        .link {
          &::before {
            display: none;
          }
        }
      }

      .link {
        position: relative;
        margin: 0 0.5rem 0 0.25rem;
        padding: 0.25rem 0;

        &::before {
          position: absolute;
          top: 0px;
          left: -0.25rem;
          height: 2.5rem;
          width: 2.5rem;
          background: @lib__colors__navy900;
          border-radius: 50%;
          z-index: 0;
          content: '';
        }
      }

      .icon {
        z-index: 1;
      }
    }
  }

  .expanded {
    background: @lib__colors__N800Dark;

    .wrapper {
      background: @lib__colors__N800Dark;
      &:hover {
        background: @lib__colors__N700Medium;
      }
    }

    .expandIcon {
      &:hover {
        background: @lib__colors__N600Light;
      }
    }
  }

  .activeSidebarExpanded {
    .link {
      margin: 0 0.5rem;
    }
  }

  .wrapper,
  .link {
    display: flex;
    align-items: center;
    width: ~'calc(100% - 1rem)';
    margin: 0 0.5rem;
  }

  .wrapper {
    justify-content: space-between;

    padding: 0 0 0 0.25rem;

    border-radius: 0;
    transition: border-radius 0.2s ease-in-out;
    cursor: pointer;

    &:hover {
      background: @hover-color;

      .expandIcon {
        fill: white;
      }
    }
  }

  .link {
    padding: 0.5rem 0;
    &:hover {
      text-decoration: none;
    }
  }

  .icon {
    fill: @lib__colors__N400;
    margin-right: 0.75rem;
  }

  .label {
    color: @lib__colors__N400;
    font-size: 0.875rem;
    max-width: 10.25rem;
    .ellipsis();
  }

  .expandIcon {
    padding: 0.5rem;
    fill: @lib__colors__N400;

    &:hover {
      background: @lib__colors__N700Medium;
      border-radius: 50%;
    }
  }
}

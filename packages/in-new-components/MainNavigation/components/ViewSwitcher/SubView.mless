@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .subView {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.5rem;
  }

  .link {
    display: flex;

    width: ~'calc(100% - 1rem)';
    padding: 1rem 1rem 1rem 3.5rem;
    margin: 0 0.5rem;

    border: 0;
    font-size: 0.875rem;
    color: @lib__colors__N400 !important;
    background: transparent;
    user-select: none;
    cursor: pointer;
    .ellipsis();

    &:hover {
      background: @lib__colors__N700Medium;
      color: white !important;
      text-decoration: none;
    }
  }

  .activeLink {
    color: white !important;
    background: @lib__colors__blue800;

    &:hover {
      background: @lib__colors__blue800;
    }
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .list {
    display: flex;
    flex-direction: column;

    margin: 0;
    padding: 0;
  }

  .spacer {
    height: 1.5rem;
  }

  .incidentMenu {
    position: relative;
  }

  .issueIndicatorSmall,
  .issueIndicator {
    position: absolute;
    left: 2.4375rem;
    top: 0.3125rem;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 1.125rem;
    height: 1.125rem;

    border-radius: 50%;
    font-weight: bold;
  }

  .issueIndicator {
    font-size: 0.6875rem;
  }

  .issueIndicatorSmall {
    font-size: 0.5rem;
  }

  .signOutButton {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
  }

  .userEmail {
    max-width: 11.5rem;

    font-size: 10px;
    color: @lib__colors__primary1;
    .ellipsis();
  }
}

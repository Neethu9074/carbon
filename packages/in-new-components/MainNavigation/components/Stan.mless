:local {
  .wrapper {
    position: relative;

    height: 2rem;

    margin: 0 1.3125rem 1.5rem;
    overflow: hidden;
  }

  .content {
    position: absolute;
    left: 0;

    display: flex;
    align-items: center;

    transition: left 0.25s ease-in-out;
    white-space: nowrap;
  }

  .label {
    color: white;
  }

  .stan {
    width: 1.8125rem;
    height: 2.0625rem;
    margin-right: 1rem;

    background: url('data:image/png;base64,');

    background-size: contain;
    background-repeat: no-repeat;
  }
}

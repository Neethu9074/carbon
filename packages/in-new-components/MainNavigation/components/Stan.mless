:local {
  .wrapper {
    position: relative;

    width: 2rem;
    height: 2rem;

    margin-left: 1.25rem;
    overflow: hidden;
  }

  .expandedWrapper {
    width: 10rem;
  }

  .content {
    position: absolute;
    left: 0;

    display: flex;
    align-items: center;

    transition: left 0.25s ease-in-out;
    white-space: nowrap;
  }

  .label {
    color: white;
  }

  .stan {
    width: 2rem;
    height: 2rem;
    margin-right: 0.5rem;

    background: url('data:image/png;base64,');

    background-size: contain;
    background-repeat: no-repeat;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    height: 2rem;
    overflow: hidden;
  }

  .content {
    display: flex;
    align-items: center;

    transition: left 0.25s ease-in-out;
    white-space: nowrap;
  }

  .label {
    color: white;
  }

  .icon {
    margin-right: 1rem;
    fill: @lib__colors__N400;
  }
}

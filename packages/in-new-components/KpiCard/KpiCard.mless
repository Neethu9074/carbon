@import '~in-themes/active.less';

:local {
  .wrapper {
    padding: 0.625rem 1rem;
    border-left: 3px solid @lib__colors__N200;
  }

  .title {
    color: @lib__colors__N700Medium;
    font-size: 1rem;
    font-weight: 200;
  }

  .major,
  .minor {
    color: @lib__colors__N900Primary;
  }

  .major {
    font-size: 2.375rem;
  }

  .minor {
    font-size: 1.5rem;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    padding: 0.625rem 1rem;
    .ellipsis();
  }

  .light {
    border-left: 3px solid @lib__colors__N200;
  }

  .lightV2 {
    background: @lib__colors__white;
    border-radius: @lib__shapes__radius_large;
    box-shadow: @lib__shadows__subtle;
  }

  .borderless {
    border-left: 0;
  }

  .title {
    color: @lib__colors__N700Medium;
    font-size: 1rem;
    font-weight: 200;
  }

  .major,
  .minor {
    color: @lib__colors__N900Primary;
  }

  .major {
    font-size: 2.375rem;
  }

  .minor {
    font-size: 1.5rem;
  }

  .companion {
    color: @lib__colors__N700Medium;
    font-size: 1rem;
    font-weight: 200;
    padding-left: 1rem;
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 1rem 0 0 0.5rem;
    height: @header__height * 1px;
    position: relative;
    background: white;
  }

  .type {
    display: block;
    margin: 0 0 0.25rem;

    color: @lib__colors__N600Light;
    font-size: 0.875rem;
  }

  .label {
    margin: 0 1rem 0 0;

    color: @lib__colors__N900Primary;
    font-size: @lib__typography__h300__font-size;
    font-weight: 400;

    max-width: 54vw;
    .ellipsis();
  }

  .labelAligned {
    display: flex;
    align-items: center;
  }

  .typeSkeleton {
    width: 6.25rem;
    height: 1rem;
    margin: 0 0 0.25rem;
    display: block;
  }

  .labelSkeleton {
    width: 12.5rem;
    height: 1.813rem;
    display: block;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N900Primary;
  }
}

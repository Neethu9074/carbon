@import '~in-themes/active.less';

:local {
  .icon {
    margin-left: 0.25rem;
    fill: @lib__colors__N600Light;
  }

  .itemWrapper {
    display: grid;
    grid-template-columns: 2fr 1fr 60%;
    grid-gap: 0.75rem;
    align-items: center;
    width: 100%;
  }

  .leftWrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .entityWrapper {
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .chartWrapper {
    display: grid;
    grid-template-columns: 50% 50%;
    align-items: center;
    justify-items: end;
  }

  .severity {
    width: 8px;
    height: 8px;
    border-radius: 100%;

  }

  .severityBad {
    background-color: @lib__colors__failure;
  }
}

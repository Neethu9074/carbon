@import '~in-themes/active.less';

:local {
  .groupHead {
    padding: 1rem 1rem 0.2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .relationshipText {
    color: @lib__colors__blue800;
    margin-bottom: 0.125rem;
  }

  .seeAll {
    padding: 1rem;
    display: grid;
    place-content: center;
  }
}

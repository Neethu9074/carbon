@import '~in-themes/active.less';

:local {
  .groupHead {
    padding: 1rem 1rem 0.2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .groupHeadText {
    margin-bottom: 0.125rem;
    font-weight: 500;
  }

  .seeAll {
    padding: 1rem;
    display: grid;
    place-content: center;
  }
}

@import '~in-themes/active.less';

:local {
  .section {
    display: flex;
    align-items: flex-start;
    align-items: center;
    width: 100%;
    min-height: 2rem;
  }

  .title {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    width: 11rem;
    white-space: nowrap;
  }

  .hasError {
    color: @lib__colors__failure;
  }

  .titleText {
    margin: 0 0 0 0.5rem;

    &:first-child {
      margin-left: 0;
    }
  }

  .content {
    width: 100%;
    flex-grow: 1;
  }

  .actions {
    flex-shrink: 0;
  }
}

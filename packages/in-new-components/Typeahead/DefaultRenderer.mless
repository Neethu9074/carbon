@import '~in-themes/active.less';

:local {
  .list {
    position: absolute;
    left: 0;

    width: 100%;
    max-height: 12.875rem;

    margin: 0;
    padding: 0;

    border: 1px solid @lib__colors__N400;
    border-collapse: collapse;
    overflow-y: scroll;
    background: #fff;
    z-index: 1;
  }

  .listItem {
    list-style: none;
    padding: 0.5rem 0.625rem;
    background-color: white;
    cursor: pointer;
  }

  .higlightedText {
    color: @lib__colors__primary1;
  }
}

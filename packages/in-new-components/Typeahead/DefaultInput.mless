@import '~in-themes/active.less';

:local {
  .inputGroup {
    display: flex;
    align-items: center;
    color: #333;
    background-color: @lib__colors__N050;
    background-image: none;
    border: 1px solid @lib__colors__N400;
    border-radius: 0.1875rem;
    font-size: 0.75rem;
    position: relative;
  }

  .inputGroupOpen {
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background: #fff;
    border-color: #b3b3b3 #ccc #d9d9d9;
    position: relative;
  }

  .input {
    flex-grow: 1;
    background: none transparent;
    border: 0 none;
    cursor: default;
    display: inline-block;
    box-shadow: none;
    font-family: inherit;
    font-size: inherit;
    margin: 0;
    outline: none;
    line-height: 1.0625rem;
    padding: 0.5rem 0 0.5rem 0.625rem;
  }

  .toggleButton {
    fill: #999;
  }
}

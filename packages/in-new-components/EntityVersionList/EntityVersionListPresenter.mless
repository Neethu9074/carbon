@import '~in-themes/active.less';

:local {
  .frame {
    display: flex;
    flex-direction: column;
    align-items: center;

    max-width: 31.375rem;
    min-width: 31.375rem;
    padding: 2rem 1rem 1rem;

    border-radius: 0.25rem;
    border: 1px solid @lib__colors__N400;
    box-shadow: 0 0.375rem 0.75rem 0 @lib__colors__N400;
  }

  .icon {
    margin-bottom: 0.5rem;
    fill: @lib__colors__N900Primary;
  }

  .title {
    line-height: 2rem;
    font-size: 1.5rem;
  }

  .explanation {
    margin: 1rem 1.5rem 2rem;

    text-align: center;
    line-height: 1.25rem;
    font-size: 0.8125rem;
    color: @lib__colors__N700Medium;
  }

  .list {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .item {
    list-style: none;

    border: 1px solid @lib__colors__N400;
    border-bottom: 0;

    &:nth-child(even) {
      background: @lib__colors__N050;
    }

    &:last-child {
      border-bottom: 1px solid @lib__colors__N400;
    }
  }

  .link {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 0.75rem;
    color: @lib__colors__N700Medium;
    cursor: pointer;

    &:hover {
      background: @lib__colors__faded-blue800;
      text-decoration: none;
    }
  }

  .fromTimestamp,
  .toTimestamp {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    width: 100%;
  }

  .fromTimestamp {
    text-align: right;
  }

  .toSpan {
    margin: 0 2rem;
    color: @lib__colors__N600Light;
  }
}

@import '~in-themes/active.less';

:local {
  .listHeading {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    padding: 0.75rem;

    font-size: 0.8125rem;
    color: @lib__colors__N700Medium;
    border: 1px solid @lib__colors__N400;
    border-bottom: 0;
  }

  .list {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .item,
  .headerItem {
    list-style: none;

    border: 1px solid @lib__colors__N400;
    border-bottom: 0;
  }

  .item {
    &:nth-child(even) {
      background: @lib__colors__N050;
    }

    &:last-child {
      border-bottom: 1px solid @lib__colors__N400;
    }
  }

  .headerItem {
    background: @lib__colors__N200;
  }

  .link {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 0.75rem;
    color: @lib__colors__N700Medium;
    cursor: pointer;

    &:hover {
      background: @lib__colors__faded-blue800;
      text-decoration: none;
    }
  }

  .fromTimestamp,
  .toTimestamp {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    width: 100%;
  }

  .fromTimestamp {
    text-align: right;
  }

  .toSpan {
    margin: 0 2rem;
    color: @lib__colors__N600Light;
  }
}

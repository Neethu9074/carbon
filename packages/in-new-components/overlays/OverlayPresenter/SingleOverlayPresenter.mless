@import '~in-themes/active.less';

:local {
  .overlay {
    position: fixed;
    z-index: @z-index__overlays;

    &::after,
    &::before {
      border: solid transparent;
      content: ' ';
      height: 0;
      width: 0;
      position: absolute;
      pointer-events: none;
    }

    &.style--popover {
      border-radius: @lib__shapes__radius_medium;
      box-shadow: @lib__shadows__strong;

      .overlay-style(#fff, 1px, rgba(0, 0, 0, 0.161));
    }

    &.style--tooltip {
      border-radius: @lib__shapes__radius_small;
      color: #fff;
      display: flex;
      align-items: center;

      .overlay-style(#0c1415, 0px, #0c1415);
    }

    .overlay-style(@background, @border-width, @border-color) {
      background: @background;
      border: @border-width solid @border-color;
    }
  }

  .inContentArea {
    position: absolute;
    z-index: @z-index__overlays-in-content-area;
  }

  .behindSidebar {
    z-index: @z-index__overlays-behind-sidebar;
  }
}

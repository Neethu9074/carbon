@import '~in-themes/active.less';

:local {
  .view {
    position: relative;
    padding-top: 3rem;
    width: 100%;
  }

  .version,
  .gap {
    position: absolute;
    bottom: 50%;

    min-height: 1rem;
    min-width: 1px;
  }

  .version {
    background: @lib__colors__light-blue800;
    cursor: pointer;

    &:hover {
      background: @lib__colors__indigo800;
    }
  }

  .selected {
    background: @lib__colors__deep-purple800;

    &:hover {
      background: @lib__colors__indigo800;
    }
  }

  .even {
    bottom: ~'calc(50% + 0.5rem)';
  }

  .gap {
    min-height: 2rem;
    background: #ff404044;
  }

  .header {
    margin-bottom: 1rem;
  }

  .time {
    font-weight: bold;
  }
}

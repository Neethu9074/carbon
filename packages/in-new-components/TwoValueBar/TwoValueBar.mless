:local {
  .wrapper {
    font-size: 0.75rem;
    width: 10rem;
  }

  .bar {
    position: relative;
    background: #64aade;
    border-radius: 2px;
    overflow: hidden;
    height: 7px;
    min-width: 6.25rem;
  }

  .fill {
    position: absolute;
    top: 0;
    bottom: 0;
    background: #d3e600;
  }

  .rightToLeft {
    right: 0;
  }

  .leftToRight {
    left: 0;
  }

  .values {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .value1,
  .value2 {
    // increase zIndex
    position: relative;
    margin: 4px 0 0 0;
    display: inline-block;
  }

  .value1 {
    margin-right: 2rem;
    text-align: left;
  }

  .value2 {
    text-align: right;
  }
}

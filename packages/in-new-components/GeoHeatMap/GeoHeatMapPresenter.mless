:local {
  .wrapper {
    position: relative;
  }

  .zoom {
    position: absolute;
    right: 0;
    bottom: 2.5rem;
  }

  .home {
    position: absolute;
    right: 0;
    bottom: 0;
  }

  .legend {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
  }
}

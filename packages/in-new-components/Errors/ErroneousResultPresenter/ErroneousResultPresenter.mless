:local {
  .errors {
    list-style: none;
    display: block;
    margin: 0;
    padding: 0;
  }

  .bottomMargin {
    margin-bottom: 1rem;
  }

  .error {
    background: #ff5d3b;
    border-radius: 3px;
    color: #fff;
    font-weight: bold;
    padding: 0.3rem;
    line-height: 1.3;
    display: block;
  }

  .item {
    & + .item {
      margin-top: 0.125rem;
    }
  }
}

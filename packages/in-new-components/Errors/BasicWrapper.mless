@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;

    width: 100%;
    height: 100%;

    background: @lib__colors__N050;
  }

  .title {
    margin-bottom: 1rem;
  }

  .text {
    margin-top: 0.25rem;

    color: @lib__colors__N500;
    font-size: 0.875rem;
  }
}

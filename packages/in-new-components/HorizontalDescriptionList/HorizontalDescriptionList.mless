@import '~in-themes/mixins.less';

:local {
  .list {
  }

  .item {
    display: flex;
    line-height: 1.3;

    & + .item {
      margin-top: 0.5rem;
    }
  }

  .verticalDisplay {
    flex-direction: column;
  }

  .title {
    width: 10rem;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 0 0.3rem 0 0;
    font-weight: 500;
    .ellipsis();
  }

  .description {
    margin: 0;
    .breakWord();
  }
}

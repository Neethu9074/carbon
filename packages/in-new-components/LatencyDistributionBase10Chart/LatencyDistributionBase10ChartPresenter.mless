@import '~in-themes/active.less';

:local {
  .container {
    display: flex;
    align-items: flex-start;
    position: relative;
  }

  .bars {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    padding: 0 11px;
  }

  .lines {
    position: absolute;
    top: 0;
    left: 0;
  }

  .horizontalLine {
    border-top: 1px solid @lib__colors__N300;
  }

  .legend {
    height: 2rem;
    display: flex;
    justify-content: space-between;
  }

  .metric {
    display: flex;
  }

  .dot {
    max-width: 0.75rem;
    max-height: 0.75rem;
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }
}

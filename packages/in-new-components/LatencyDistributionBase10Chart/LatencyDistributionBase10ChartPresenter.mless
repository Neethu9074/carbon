@import './components/shared.less';

:local {
  .container {
    display: block;
    position: relative;
    margin-bottom: 2rem;
  }

  .lines {
    position: absolute;
    top: 0;
    left: 0;
  }

  .horizontalLine {
    position: relative;
    border-top: 1px solid @lib__colors__N600Light;
    opacity: 0.2;
    z-index: @z-index__horizontalLine;
  }

  .header {
    position: relative;
    height: 2rem;
  }

  .legend {
    position: absolute;
    left: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }

  .dot {
    background-color: @color_calls;
    max-width: 0.75rem;
    max-height: 0.75rem;
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }

  .percentileButton {
    position: absolute;
    display: flex;
    justify-content: space-between;
    right: 0;
    height: 2rem;
  }
}

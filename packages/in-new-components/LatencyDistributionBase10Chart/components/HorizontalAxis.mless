@import '~in-themes/active.less';

:local {
  .horizontalAxis {
    position: absolute;
    left: 0;
    bottom: 0;
    border-bottom: 1px solid @lib__colors__N800Dark;
  }

  .tickContainer {
    position: absolute;
    user-select: none;
  }

  .tick {
    position: relative;
    border-left: 1px solid @lib__colors__N800Dark;
    height: 6px;
  }

  .tickValues {
    position: absolute;
    color: @lib__colors__N800Dark;
    font-size: 0.5625rem;
    line-height: 1.4;
    white-space: nowrap;
    left: 50%;
    transform: translate(-50%, 0);
  }

  .tickContainer:first-child .tickValues {
    transform: translate(-25%, 0);
  }

  .tickContainer:last-child .tickValues {
    transform: translate(-75%, 0);
  }
}

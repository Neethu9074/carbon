@import './shared.less';

:local {
  .wrapperContainer {
    position: absolute;
    width: 100%;
  }

  .bucket {
    position: absolute;
    top: 0;
  }

  .bar {
    position: absolute;
    bottom: 1px;
    left: 1px;
    z-index: @z-index__bar;
  }
}

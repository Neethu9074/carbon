@import '~in-themes/active.less';

:local {
  .barOuter {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: space-between;
    position: relative;

    &:hover {
      cursor: pointer;

      .barInner {
        background: lighten(@lib__colors__light-blue800, 10%);
      }
      .percentiles {
        z-index: 2;
      }
      .barStrike {
        border-right: 0.05rem solid @lib__colors__N700Medium;
      }
    }

    .barInner {
      flex-shrink: 0;
    }

    .barStrike {
      position: absolute;
      bottom: 0;
      left: 0;
    }

    .percentiles {
      font-size: 0.5rem;
      border: 0.05rem solid @lib__colors__N500;
      border-radius: 3px;
      padding: 0.05rem 0.1rem;
      flex-shrink: 0;
      background-color: @lib__colors__white;
      opacity: 1;
      z-index: 1;
      white-space: nowrap;
    }

    .dottedLine {
      border-right: 0.05rem dashed @lib__colors__N500;
      height: 100%;
    }
  }

  .barInner {
    background: @lib__colors__light-blue800;
    min-height: 2px;
    width: 100%;
  }

  .barStrike {
    width: 50%;
  }

  .tooltipContent {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-width: 8rem;
  }

  .labelWrapper {
    display: flex;
    align-items: center;
  }

  .dot {
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
    background: @lib__colors__light-blue800;
  }

  .value {
    margin-left: 2rem;
    font-weight: bold;
    color: @lib__colors__N900Primary;
  }
}

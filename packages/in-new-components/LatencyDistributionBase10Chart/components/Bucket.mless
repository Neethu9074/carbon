@import '~in-themes/active.less';

:local {
  .barOuter {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: space-between;
    position: relative;

    &:hover {
      cursor: pointer;

      .percentiles {
        z-index: 2;
      }
      .barStrike {
        border-right: 0.05rem solid @lib__colors__N700Medium;
      }
    }

    .barInner {
      flex-shrink: 0;
      z-index: 1;
    }

    .barStrike {
      position: absolute;
      bottom: 0;
      left: 0;
    }

    .percentiles {
      font-size: 0.5rem;
      border: 0.05rem solid @lib__colors__N500;
      border-radius: 3px;
      padding: 0.05rem 0.1rem;
      flex-shrink: 0;
      background-color: @lib__colors__white;
      opacity: 1;
      z-index: 1;
      white-space: nowrap;
    }

    .dottedLine {
      border-right: 0.05rem dashed @lib__colors__N500;
      height: 100%;
    }
  }

  .barInner {
    background: @lib__colors__light-blue800;
    min-height: 2px;
    width: 100%;
  }

  .barStrike {
    width: 50%;
  }

  .tooltipContent {
    display: flex;
    flex-direction: column;

    min-width: 8rem;
    max-width: 18rem;
    padding: 1rem 1rem 0.5rem;
    background: @lib__colors__white;
    color: @lib__colors__N800Dark;
    border-radius: @lib__shapes__radius_large;

    box-shadow: @lib__shadows__subtle;
    border: 1px solid rgba(0, 0, 0, 0.16);
  }

  .labelWrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 0.7rem;
  }

  .labelWrapper:first-child {
    margin: 0;
  }

  .dot {
    min-width: 0.75rem;
    min-height: 0.75rem;
    margin-right: 0.375rem;
    border-radius: 50%;
    background: @lib__colors__light-blue800;
  }

  .value {
    margin-left: 2rem;
    font-weight: bold;
    color: @lib__colors__N900Primary;
  }
}

@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3rem;
    padding-left: 1rem;
    padding-right: 1rem;
    background: @lib__colors__N200;
    border-radius: @lib__shapes__radius_small;
  }

  .framed {
    border: 1px solid @lib__colors__N200;
  }

  .title {
    font-size: 1rem;
    font-weight: 200;
    color: @lib__colors__N700Medium;
  }

  .body {
    padding: 1rem;
  }

  .bodyWithoutPadding {
    padding: 0;
  }
}

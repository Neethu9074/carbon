:local {
  @border-radius: 3px;

  .card {
    overflow: hidden;
    border: 1px solid #E8EEF0;
    box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
    border-radius: 4px;
  }

  .header {
    padding: .5rem 1rem;
    background: #F4F7F8;
    border-top-left-radius: @border-radius;
    border-top-right-radius: @border-radius;
  }

  .title {
    font-size: 1rem;
    color: #698189;
  }

  .body {
    padding: 16px;
  }

  .bodyWithoutPadding {
    padding: 0;
  }
}

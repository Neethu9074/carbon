:local {
  @border-radius: 3px;

  .card {
    overflow: hidden;
    border: 1px solid #e8eef0;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    border-radius: 4px;
  }

  .header {
    display: flex;
    justify-content: space-between;
    background: #f4f7f8;
    border-top-left-radius: @border-radius;
    border-top-right-radius: @border-radius;
  }

  .title {
    margin: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 200;
    color: #698189;
  }

  .body {
    padding: 16px;
  }

  .bodyWithoutPadding {
    padding: 0;
  }
}

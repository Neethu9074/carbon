@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: @lib__colors__N200;
    border-top-left-radius: @lib__shapes__radius_small;
    border-top-right-radius: @lib__shapes__radius_small;
  }

  .clickableHeader {
    cursor: pointer;
  }

  .nonClickable {
    cursor: default;
  }

  .framed {
    border: 1px solid @lib__colors__N200;
    border-radius: @lib__shapes__radius_small;

    &.darkFrame {
      border: 1px solid @lib__colors__N300;
    }
  }

  .twoLineTitleLabel {
    font-size: 0.75rem;
    color: @lib__colors__N600Light;
    .ellipsis();
    margin-bottom: 0.25rem;
  }

  .twoLineTitle {
    font-size: 0.875rem;
    color: @lib__colors__N900Primary;
    .ellipsis();
  }

  .title {
    font-size: 1rem;
    font-weight: 200;
    color: @lib__colors__N700Medium;
    .ellipsis();
    margin: 0 1rem 0 0;
  }

  .titleSubContent {
    font-size: 0.8rem;
    font-weight: 200;
    color: @lib__colors__N700Medium;
    padding: 0 0 0 0.5rem;
  }

  .body {
    padding: 1rem;
    background: #fff;
  }

  .bodyWithoutPadding {
    padding: 0;
  }

  .useMaxAvailableHeight {
    height: 100%;
  }
}

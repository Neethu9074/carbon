@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3rem;
    padding-left: 1rem;
    padding-right: 1rem;
    background: @lib__colors__N200;
    border-top-left-radius: @lib__shapes__radius_small;
    border-top-right-radius: @lib__shapes__radius_small;
  }

  .framed {
    border: 1px solid @lib__colors__N200;
    border-radius: @lib__shapes__radius_small;
  }

  .title {
    font-size: 1rem;
    font-weight: 200;
    color: @lib__colors__N700Medium;
    .ellipsis();
    margin: 0 1rem 0 0;
  }

  .titleSubText {
    font-size: 0.8rem;
    font-weight: 200;
    color: @lib__colors__N700Medium;
    padding: 0 0 0 0.5rem;
  }

  .body {
    padding: 1rem;
  }

  .bodyWithoutPadding {
    padding: 0;
  }
}

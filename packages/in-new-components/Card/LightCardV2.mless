@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  @header-height: 4.625rem;

  .card {
    display: flex;
    flex-direction: column;
    background: @lib__colors__white;

    border: 1px solid @lib__colors__N400;
    border-radius: @lib__shapes__radius_large;
    box-shadow: @lib__shadows__subtle;
  }

  .useMaxAvailableHeight {
    height: 100%;
  }

  .title {
    margin-right: 1rem;

    font-size: 1.375rem;
    color: @lib__colors__N900Primary;
    font-weight: 500;

    .ellipsis();
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    max-height: @header-height;

    padding: 1.5rem 1rem 1.5rem 1.5rem;

    white-space: nowrap;
  }

  .icon {
    fill: @lib__colors__N700Medium;
    margin-right: 0.5rem;
  }

  .left {
    .ellipsis();
  }

  .left,
  .right {
    display: flex;
    align-items: center;
  }

  .body {
    padding: 0 1rem 1rem;
    flex-grow: 1;
    // In Safari the body doesn't automatically grow vertically the same way it does
    // in other browsers. While the body may vertically grow, child elements cannot
    // use a CSS rule like height: 100%. This is because the height of .body is
    // not defined on .body, but instead imposed upon .body.
    // This is weird…
    // This ensures that the body's height is defined.
    height: ~"calc(100% - @{header-height})";
  }
}

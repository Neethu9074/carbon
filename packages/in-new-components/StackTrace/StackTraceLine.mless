@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .line {
    display: flex;
    align-items: center;
    color: @lib__colors__N500;
    font-family: @font-family-monospace;
    padding: .5rem .625rem;

    border: 1px solid @lib__colors__N500;
    border-top: 0;
    background: @lib__colors__N100;
    overflow-wrap: break-word;

    &:first-child {
      border-top: 1px solid @lib__colors__N500;
      border-top-left-radius: @lib__shapes__radius_small;
      border-top-right-radius: @lib__shapes__radius_small;
    }

    &:last-child {
      border-bottom-left-radius: @lib__shapes__radius_small;
      border-bottom-right-radius: @lib__shapes__radius_small;
    }
  }

  .filler {
    flex-shrink: 0;
    margin: 0 0.4rem;
  }

  .withoutExtraWhitespace {
    margin: 0;
  }

  .value {
    color: @lib__colors__N900Primary;
    .ellipsis();
  }

  .noShrinking {
    flex-shrink: 0;
  }

  .file {
    flex-shrink: 2;
  }

  .name {
    flex-shrink: 1;
  }
}

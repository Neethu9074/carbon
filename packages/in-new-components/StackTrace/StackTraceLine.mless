@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: @lib__colors__N500;
    font-family: @font-family-sans-serif;

    border: 1px solid @lib__colors__N500;
    border-top: 0;
    background: #fff;

    &:first-child {
      border-top: 1px solid @lib__colors__N500;
      border-top-left-radius: @lib__shapes__radius_small;
      border-top-right-radius: @lib__shapes__radius_small;
    }

    &:last-child {
      border-bottom-left-radius: @lib__shapes__radius_small;
      border-bottom-right-radius: @lib__shapes__radius_small;
    }
  }

  .line {
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 0.45rem 0.625rem;
  }

  .filler {
    flex-shrink: 0;
    margin: 0 0.4rem;
  }

  .withoutExtraWhitespace {
    margin: 0;
  }

  .value {
    color: @lib__colors__N900Primary;
    line-height: 1.2;
    .ellipsis();
  }

  .noShrinking {
    flex-shrink: 0;
  }

  .file {
    flex-shrink: 2;
  }

  .name {
    flex-shrink: 0.5;
    font-weight: 600;
  }
}

@import '~in-themes/active.less';

:local {
  .tag {
    color: @lib__colors__N700Medium;
    background: @lib__colors__N200;
  }

  .default {
    padding: 0.25rem 0.375rem 0.1875rem;
    border-radius: @lib__shapes__radius_large;
  }

  .default-rounded {
    padding: 0.25rem 0.375rem 0.1875rem;
    border-radius: @lib__typography__body-small__font-size;
  }
}

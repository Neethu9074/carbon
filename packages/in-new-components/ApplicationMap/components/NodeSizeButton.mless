@import '~in-themes/active.less';

:local {
  .sizeMetricLabel {
    margin-left: 0.25rem;

    font-size: 0.875rem;
    color: @lib__colors__N600Light;
  }

  .expandIcon {
    fill: @lib__colors__N600Light;
  }

  .contextMenu {
    width: 9rem;

    padding: 1rem;
    margin: 0;

    background: #fff;
  }

  .metric {
    position: relative;

    display: flex;
    align-items: center;

    padding: 0.5rem 2.5rem 0.5rem 0.5rem;
    list-style: none;
    background: #fff;
    cursor: pointer;

    &:hover {
      background: @lib__colors__N100;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    position: relative;

    width: 100%;
    height: 100%;
    background: #fff;
    overflow: hidden;

    border: 1px solid @lib__colors__N100;
  }

  .overlay,
  .centerWrapper {
    position: absolute;

    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }

  .icon {
    fill: @lib__colors__N500;
  }

  .canvas {
    display: block;
    width: 100%;
  }
}

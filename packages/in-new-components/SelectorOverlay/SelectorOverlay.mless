@import '~in-themes/active.less';

:local {
  .searchInputWrapper {
    padding: 0.5rem;
    border-bottom: 1px solid @lib__colors__N300;
    background: @lib__colors__N050;
  }

  .searchInput {
    background: #fff;
  }

  .overlay {
    width: 26rem;
    @height: 20rem;
    min-height: @height;
    height: @height;
    max-height: @height;

    border-radius: @lib__shapes__radius_medium;
  }

  .filterList {
    border-bottom: 1px solid @lib__colors__N400;
  }

  .option {
    justify-content: space-between;
    font-weight: normal;
  }

  .loading {
    margin: 0 auto;
  }
}

@import '~in-themes/active.less';

:local {
  .button {
    color: black;
    font-family: @font-family-sans-serif;
    font-weight: bold;
    font-size: 0.875rem;
    text-decoration: none;
    border: 0;
    border-radius: @lib__shapes__radius_small;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    &:hover,
    &:focus {
      text-decoration: none;
    }

    & + .button {
      margin-left: 0.5rem;
    }
  }

  .normal {
    padding: 0.5rem 0.625rem;

    .icon {
      margin: -0.25rem 0.5rem -0.25rem 0;
    }
  }

  .compact {
    padding: 0.25rem 0.625rem;

    .icon {
      margin-right: 0.5rem;
    }
  }

  .disabled,
  .disabled:focus,
  .disabled:hover {
    cursor: not-allowed;
    outline: 0;

    svg {
      fill: #d5dfe4;
    }
  }

  .primary {
    .buttonStyle(
        // bg
          @lib__colors__primary1,
        // hover bg
          #12978e,
        // font
          #fff,
        // hover font
          #fff,
        //font size
          @lib__typography__button__font-size,
        //font weight
          @lib__typography__button__font-weight
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: #2ca9a07a;
    }
  }

  .secondary {
    .buttonStyle(
        // bg
          @lib__colors__N050,
        // hover bg
          @lib__colors__N100,
        // font
          @lib__colors__N800Dark,
        // hover font
          @lib__colors__N800Dark,
        //font size
          @lib__typography__button__font-size,
        //font weight
          normal
      )
      ;;

    border: 1px solid @lib__colors__N400;

    &:hover {
      border: 1px solid @lib__colors__N500;
    }

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      color: @lib__colors__N700Medium;
      border: 1px solid #e2e4e6;
      background: #fcfcfd;
    }
  }

  .action {
    .buttonStyle(
        // bg
          @lib__colors__white,
        // hover bg
          #e8f6f8,
        // font
          @lib__colors__primary1,
        // hover font
          @lib__colors__primary1,
        //font size
          @lib__typography__button__font-size,
        //font weight
          normal
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      color: #2ca9a07a;
      background: @lib__colors__white;
    }
  }

  .subtle {
    .buttonStyle(
        // bg
          @lib__colors__white,
        // hover bg
          @lib__colors__N300,
        // font
          @lib__colors__N600Light,
        // hover font
          @lib__colors__N600Light,
        //font size
          @lib__typography__button__font-size,
        //font weight
          200
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      color: #62757d7a;
      background: @lib__colors__white;
    }
  }

  .create {
    .buttonStyle(
        // bg
          @lib__colors__success,
        // hover bg
          #31a56b,
        // font
          #fff,
        // hover font
          #fff,
        //font size
          @lib__typography__button__font-size,
        //font weight
          normal
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: #91dab0;
    }
  }

  .danger {
    .buttonStyle(
        // bg
          @lib__colors__failure,
        // hover bg
          #cc4238,
        // font
          #fff,
        // hover font
          #fff,
        //font size
          @lib__typography__button__font-size,
        //font weight
          @lib__typography__button__font-weight
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: #dc4b417a;
    }
  }

  .warning {
    .buttonStyle(
        // bg
          @lib__colors__warning,
        // hover bg
          #f0bc00,
        // font
          #fff,
        // hover font
          #fff,
        //font size
          @lib__typography__button__font-size,
        //font weight
          @lib__typography__button__font-weight
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: #ffd86d;
    }
  }
}

.buttonStyle(@bg, @hoverBg, @font, @hoverFont, @fontSize, @fontWeight) {
  & {
    background: @bg;
    color: @font;
    font-size: @fontSize;
    font-weight: @fontWeight;

    svg {
      fill: @font;
    }
  }

  &:hover {
    color: @hoverFont;
    background: @hoverBg;

    svg {
      fill: @hoverFont;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .button {
    color: black;
    font-family: @font-family-sans-serif;
    font-weight: bold;
    font-size: 0.875rem;
    text-decoration: none;
    border: 0;
    border-radius: @lib__shapes__radius_small;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transition: background-color 250ms;

    &:hover,
    &:focus {
      text-decoration: none;
    }

    & + .button {
      margin-left: 0.5rem;
    }
  }

  .dropdownButton {
    justify-content: space-between;
  }

  .noAutoMargin {
    & + .button {
      margin-left: 0;
    }
  }

  .noText {
    height: 1.75rem;
    width: 1.75rem;
  }

  .disabled,
  .disabled:focus,
  .disabled:hover {
    cursor: not-allowed;
    outline: 0;

    svg {
      fill: @lib__colors__N300 !important;
    }
  }

  .primary {
    .buttonStyle(
        // bg
          @lib__colors__primary1,
        // hover bg
          #12978e,
        // font
          #fff,
        // hover font
          #fff,
        //font size
          @lib__typography__button__font-size,
        //font weight
          @lib__typography__button__font-weight
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: #95dada;
    }
  }

  .primaryv2 {
    .buttonStyle(
        // bg
          @lib__colors__light-blue800,
        // hover bg
          #148cc8,
        // font
          #fff,
        // hover font
          #fff,
        //font size
          @lib__typography__button__font-size,
        //font weight
          @lib__typography__button__font-weight
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: #86cff3;
    }
  }

  .secondary {
    .buttonStyle(
        // bg
          @lib__colors__N050,
        // hover bg
          @lib__colors__N100,
        // font
          @lib__colors__N800Dark,
        // hover font
          @lib__colors__N800Dark,
        //font size
          @lib__typography__button__font-size,
        //font weight
          normal
      )
      ;;

    border: 1px solid @lib__colors__N400;

    &:hover {
      border: 1px solid @lib__colors__N500;
    }

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      color: @lib__colors__N400;
      border: 1px solid #e2e4e6;
      background: #fcfcfd;
    }
  }

  .secondaryDarker {
    .buttonStyle(
        // bg
          @lib__colors__N300,
        // hover bg
          @lib__colors__N100,
        // font
          @lib__colors__N800Dark,
        // hover font
          @lib__colors__N800Dark,
        //font size
          @lib__typography__button__font-size,
        //font weight
          normal
      )
      ;;

    border: 1px solid @lib__colors__N400;

    &:hover {
      border: 1px solid @lib__colors__N500;
    }

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      color: @lib__colors__N400;
      border: 1px solid #e2e4e6;
      background: #fcfcfd;
    }
  }

  .action {
    .buttonStyle(
        // bg
          @lib__colors__transparent,
        // hover bg
          #e8f6f8,
        // font
          @lib__colors__primary1,
        // hover font
          @lib__colors__primary1,
        //font size
          @lib__typography__button__font-size,
        //font weight
          normal
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      color: rgba(44, 169, 160, 0.48);
      background: @lib__colors__white;
    }
  }

  .subtle {
    .buttonStyle(
        // bg
          @lib__colors__transparent,
        // hover bg
          @lib__colors__N300,
        // font
          @lib__colors__N600Light,
        // hover font
          @lib__colors__N600Light,
        //font size
          @lib__typography__button__font-size,
        //font weight
          200
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      color: rgba(98, 117, 125, 0.48);
      background: @lib__colors__white;
    }
  }

  .subtle_dark {
    .buttonStyle(
        // bg
          @lib__colors__transparent,
        // hover bg
          @lib__colors__N300,
        // font
          @lib__colors__white,
        // hover font
          @lib__colors__N600Light,
        //font size
          @lib__typography__button__font-size,
        //font weight
          200
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      color: rgba(98, 117, 125, 0.48);
      background: @lib__colors__white;
    }
  }

  .create {
    .buttonStyle(
        // bg
          @lib__colors__success,
        // hover bg
          #31a56b,
        // font
          #fff,
        // hover font
          #fff,
        //font size
          @lib__typography__button__font-size,
        //font weight
          normal
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: #91dab0;
    }
  }

  .danger {
    .buttonStyle(
        // bg
          @lib__colors__failure,
        // hover bg
          #cc4238,
        // font
          #fff,
        // hover font
          #fff,
        //font size
          @lib__typography__button__font-size,
        //font weight
          @lib__typography__button__font-weight
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: rgba(220, 75, 65, 0.48);
    }
  }

  .warning {
    .buttonStyle(
        // bg
          @lib__colors__warning,
        // hover bg
          #f0bc00,
        // font
          @lib__colors__N900Primary,
        // hover font
          @lib__colors__N900Primary,
        //font size
          @lib__typography__button__font-size,
        //font weight
          @lib__typography__button__font-weight
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: #ffd86d;
      color: @lib__colors__N600Light;
    }
  }

  .warning {
    .buttonStyle(
        // bg
          @lib__colors__warning,
        // hover bg
          #f0bc00,
        // font
          @lib__colors__N900Primary,
        // hover font
          @lib__colors__N900Primary,
        //font size
          @lib__typography__button__font-size,
        //font weight
          @lib__typography__button__font-weight
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: #ffd86d;
    }
  }

  .info {
    .buttonStyle(
        // bg
          @lib__colors__chart__self100,
        // hover bg
          @lib__colors__navy800,
        // font
          @lib__colors__white,
        // hover font
          @lib__colors__white,
        //font size
          @lib__typography__button__font-size,
        //font weight
          @lib__typography__button__font-weight
      )
      ;;

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      background: @lib__colors__N400;
    }
  }

  .fixedInline {
    height: 1.75rem;
    width: 1.75rem;

    .buttonStyle(
        // bg
          @lib__colors__N050,
        // hover bg
          @lib__colors__N100,
        // font
          @lib__colors__N800Dark,
        // hover font
          @lib__colors__N800Dark,
        //font size
          @lib__typography__button__font-size,
        //font weight
          normal
      )
      ;;

    border: 1px solid @lib__colors__N400;

    &:hover {
      border: 1px solid @lib__colors__N500;
    }

    &.disabled,
    &.disabled:hover,
    &.disabled:focus {
      color: @lib__colors__N400;
      border: 1px solid #e2e4e6;
      background: #fcfcfd;
    }
  }

  .xl {
    padding: 0.3rem 1rem;
    height: 3.375rem;
    font-size: 1rem;
    font-weight: 600;

    .icon {
      margin: -0.25rem 0.5rem -0.25rem 0;

      &.noHorizontalMargin {
        margin-right: 0;
      }
    }

    .dropdownButtonIndicator {
      margin: -0.25rem 0 -0.25rem 0.5rem;
    }
  }

  .normal {
    padding: 0.5rem 0.625rem;

    .icon {
      margin: -0.25rem 0.5rem -0.25rem 0;

      &.noHorizontalMargin {
        margin-right: 0;
      }
    }

    .dropdownButtonIndicator {
      margin: -0.25rem 0 -0.25rem 0.5rem;
    }
  }

  .compact {
    padding: 0.25rem 0.625rem;
    line-height: 1.15;

    .icon {
      margin-right: 0.5rem;

      &.noHorizontalMargin {
        margin-right: 0;
      }
    }

    .dropdownButtonIndicator {
      margin: -0.25rem -0.3rem -0.25rem 0.5rem;
    }
  }
}

.buttonStyle(@bg, @hoverBg, @font, @hoverFont, @fontSize, @fontWeight) {
  & {
    background: @bg;
    color: @font;
    font-size: @fontSize;
    font-weight: @fontWeight;

    svg {
      fill: @font;
    }
  }

  &:hover {
    color: @hoverFont;
    background: @hoverBg;

    svg {
      fill: @hoverFont;
    }
  }
}

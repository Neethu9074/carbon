@import '~in-themes/active.less';

:local {
  .button {
    color: black;
    font-family: @font-family-sans-serif;
    font-weight: bold;
    font-size: 0.875rem;
    text-decoration: none;
    border: 0;
    border-radius: 0.188rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1.1;

    transition: background 0.25s ease-in-out, color 0.25s ease-in-out;

    &:hover,
    &:focus {
      text-decoration: none;
    }

    & + .button {
      margin-left: 0.5rem;
    }
  }

  .primary {
    .buttonStyle(
      // bg
      #00babb,
      // hover bg
      #00a1a3,
      // font
      #fff,
      // hover font
      #fff,
      );
  }

  .secondary {
    .buttonStyle(
      // bg
      #e7eef0,
      // hover bg
      #dde7ec,
      // font
      #47626a,
      // hover font
      #47626a);
  }

  .danger {
      .buttonStyle(
        // bg
        #d9534f,
        // hover bg
        #c9302c,
        // font
        #fff,
        // hover font
        #fff);
    }

  .normal {
    padding: 0.875rem 1.25rem;
  }

  .compact {
    padding: 0.5rem 0.75rem;
  }

  .icon {
    margin: 0 0.5rem 0 0;
  }

  .disabled, .disabled:focus, .disabled:hover {
    background: #fff;
    color: #D5DFE4;
    cursor: not-allowed;
    outline: 0;
    border: 1px solid #d5dfe4;

    svg {
      fill: #D5DFE4;
    }
  }
}

.buttonStyle(@bg, @hoverBg, @font, @hoverFont) {
  & {
    background: @bg;
    color: @font;

    svg {
      fill: @font;
    }
  }

  &:hover {
    color: @hoverFont;
    background: @hoverBg;

    svg {
      fill: @hoverFont;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .button {
    color: black;
    font-family: @font-family-sans-serif;
    font-weight: bold;
    font-size: 0.875rem;
    text-decoration: none;
    border: 0;
    border-radius: @lib__shapes__radius_small;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1.1;

    transition: background 0.25s ease-in-out, color 0.25s ease-in-out;

    &:hover,
    &:focus {
      text-decoration: none;
    }

    & + .button {
      margin-left: 0.5rem;
    }
  }

  .primary {
    .buttonStyle(
      // bg
      @lib__colors__primary1,
      // hover bg
      #12978e,
      // font
      #fff,
      // hover font
      #fff,
      //font size
      @lib__typography__button__font-size,
      //font weight
      @lib__typography__button__font-weight
      );;
  }

  .secondary {
    .buttonStyle(
      // bg
      @lib__colors__N050,
      // hover bg
      @lib__colors__N100,
      // font
      @lib__colors__N800Dark,
      // hover font
      @lib__colors__N800Dark,
      //font size
      @lib__typography__button__font-size,
      //font weight
      normal
      );;

    border: 1px solid @lib__colors__N400;

    &:hover {
      border: 1px solid @lib__colors__N500;
    }
  }

  .action {
    .buttonStyle(
      // bg
      @lib__colors__white,
      // hover bg
      rgba(0, 189, 203, 0.08),
      // font
      @lib__colors__primary1,
      // hover font
      @lib__colors__primary1,
      
      //font size
      @lib__typography__button__font-size,

      //font weight
      normal
      );;
  }

  .subtle {
    .buttonStyle(
      // bg
      @lib__colors__white,
      // hover bg
      @lib__colors__N100,
      // font
      @lib__colors__N800Dark,
      // hover font
      @lib__colors__N800Dark,
      //font size
      @lib__typography__button__font-size,
      //font weight
      200
      );;
  }

  .danger {
    .buttonStyle(
      // bg
      @lib__colors__failure,
      // hover bg
      #cc4238,
      // font
      #fff,
      // hover font
      #fff,
            
      //font size
      @lib__typography__button__font-size,

      //font weight
      normal
      );;
  }

  .normal {
    padding: 0.5rem 0.625rem;

    .icon {
      margin: -0.25rem 0.5rem -0.25rem 0;
    }
  }

  .compact {
    padding: 0.25rem 0.625rem;

    .icon {
      margin-right: 0.5rem;
    }
  }

  .disabled,
  .disabled:focus,
  .disabled:hover {
    cursor: not-allowed;
    outline: 0;

    svg {
      fill: #d5dfe4;
    }
  }

  .primaryDisabled,
  .primaryDisabled:hover,
  .primaryDisabled:focus {
    background: #2ca9a07a;
  }

  .secondaryDisabled,
  .secondaryDisabled:hover,
  .secondaryDisabled:focus {
    color: @lib__colors__N700Medium;
  }

  .actionDisabled,
  .actionDisabled:hover,
  .actionDisabled:focus {
    color: #2ca9a07a;
  }

  .subtleDisabled,
  .subtleDisabled:hover,
  .subtleDisabled:focus {
    color: #62757d7a;
  }

  .dangerDisabled,
  .dangerDisabled:hover,
  .dangerDisabled:focus {
    background: #dc4b417a;
  }
}

.buttonStyle(@bg, @hoverBg, @font, @hoverFont, @fontSize, @fontWeight) {
  & {
    background: @bg;
    color: @font;
    font-size: @fontSize;
    font-weight: @fontWeight;

    svg {
      fill: @font;
    }
  }

  &:hover {
    color: @hoverFont;
    background: @hoverBg;

    svg {
      fill: @hoverFont;
    }
  }
}

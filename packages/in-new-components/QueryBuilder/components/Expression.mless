@import '~in-new-components/QueryBuilder/shared.less';
@import '~in-themes/active.less';

:local {
  .expression {
    display: inline;

    padding: 0.4375rem 0px;

    line-height: @query-builder-line-height;
    border: 1px solid transparent;
    border-radius: 3px;

    &:focus,
    &:hover {
      outline: 0;

      & > * {
        &:first-child {
          border-color: transparent;
          background: 0;
        }
      }
    }
  }

  .completeExpression {
    &:focus,
    &:hover {
      & > * {
        &:last-child {
          border-color: transparent;
          background: 0;
        }
      }
    }
  }

  .expressioncolor_0 {
    background: #f8ecff;
    border: 1px solid #dca1ff;
  }

  .expressioncolor_1 {
    background: #ffeaf5;
    border: 1px solid #ffa4d3;
  }
}

@import '~in-themes/active.less';

:local {
  .expression {
    display: inline;

    border: 1px solid transparent;
    padding: 0.375rem 0px;

    &:focus,
    &:hover {
      outline: 0;
      border-radius: 3px;

      & > * {
        &:first-child {
          border-color: transparent;
          background: 0;
        }
      }
    }
  }

  .completeExpression {
    &:focus,
    &:hover {
      & > * {
        &:last-child {
          border-color: transparent;
          background: 0;
        }
      }
    }
  }

  .expressioncolor_0 {
    &:focus,
    &:hover {
      background: #f8ecff;
      border: 1px solid @lib__colors__purple800;
    }
  }

  .expressioncolor_1 {
    &:focus,
    &:hover {
      background: #ffeaf5;
      border: 1px solid @lib__colors__pink800;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .draggableWrapper {
    display: inline-block;
  }

  .bracket,
  .bracket_dark {
    display: inline;

    padding: 0.3rem;

    color: @lib__colors__success;
    border: 1px solid @lib__colors__N400;
    border-radius: @lib__shapes__radius_medium;
    font-weight: 500;
    line-height: @lib__typography__line-height;
    cursor: pointer;

    &:focus,
    &:active,
    &:hover {
      outline: 0;
      background: @lib__colors__N200;
      border-color: @lib__colors__light-blue800;
    }
  }

  .bracket {
    background: @lib__colors__N050;
  }

  .bracket_dark {
    background: @lib__colors__N900Primary;
  }

  .invalid {
    background: @lib__colors__failure10;
    color: @lib__colors__failure;
    border: 1px solid @lib__colors__failure;
  }
}

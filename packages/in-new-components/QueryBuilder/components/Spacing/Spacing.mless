@import '~in-themes/active.less';

:local {
  .visible {
    outline: 0;
    &::after {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(50% - 1px);
      border-right: 2px solid @lib__colors__light-blue800;
    }
  }

  .letter,
  .word {
    display: inline-block;
    padding: 0.3rem 0;
    position: relative;
    cursor: text;
    line-height: @lib__typography__line-height;

    &:focus,
    &:active,
    &:hover {
      .addIndicator {
        display: flex;
      }

      .hoverEnabler {
        display: block;
      }
    }
  }

  .letter {
    width: 2px;

    @keyframes blinking-letter-caret {
      0%,
      100% {
        background: @lib__colors__light-blue800;
      }
      50% {
        background: transparent;
      }
    }

    &:focus,
    &:active {
      outline: 0;
      background: @lib__colors__light-blue800;
      animation-name: blinking-letter-caret;
      animation-duration: 1s;
      animation-iteration-count: infinite;
      animation-timing-function: step-end;
    }
  }

  .word {
    width: 0.5rem;
    position: relative;

    &:focus,
    &:active {
      outline: 0;

      @keyframes blinking-word-caret {
        0%,
        100% {
          border-color: @lib__colors__light-blue800;
        }
        50% {
          border-color: transparent;
        }
      }

      &::after {
        content: '';
        display: block;
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc(50% - 1px);
        border-right: 2px solid @lib__colors__light-blue800;
        animation-name: blinking-word-caret;
        animation-duration: 1s;
        animation-iteration-count: infinite;
        animation-timing-function: step-end;
      }
    }
  }

  // This elements exists so that users can click on the add indicator when
  // this is only shown via hover on the spacing. Without this it would not
  // be possible to go from the spacing hover effect to the addIndicator without
  // a mouseLeave event triggering.
  .hoverEnabler {
    height: 0.5rem;
    position: absolute;
    // avoid addIndicator to be below tag input fields
    z-index: 1;
    bottom: -0.5rem;
    left: -0.2rem;
    right: -0.2rem;
    display: none;
  }

  .addSuggestionIndicator,
  .closeBracketSuggestionIndicator {
    // avoid indicators to be below tag input fields
    z-index: 1;
  }

  .addIndicator {
    // addIndicator always has to be on top of everything. It is set to 2 here because it can happen that e.g. a
    // addSuggestionIndicator and an addIndicator are next to each other (can be done when adding only an opening bracket
    // and hovering next to it on its right). In this case, the addIndicator has to be on top of the suggestionIndicator.
    z-index: 2;
  }

  .addIndicator,
  .addSuggestionIndicator,
  .closeBracketSuggestionIndicator {
    display: flex;
    align-items: flex-end;
    justify-content: center;

    position: absolute;
    top: 1.8125rem;
    height: 1.1875rem;

    padding-bottom: 0.125rem;

    font-weight: 500;
    color: @lib__colors__failure;
    background: @lib__colors__failure10;
    border: 1px solid @lib__colors__failure;
    border-radius: @lib__shapes__radius_medium;

    &:hover {
      font-weight: bold;
      cursor: pointer;
    }

    &::after {
      content: '';
      position: absolute;
      top: -0.25rem;
      left: calc(50% - 0.1875rem);
      border-width: 1px 0px 0px 1px;
      border-style: solid;
      pointer-events: none;
      border-color: @lib__colors__failure;
      background: @lib__colors__failure10;
      transform: rotateZ(45deg);
      width: 0.375rem;
      height: 0.375rem;
    }
  }

  .addIndicator {
    --width: 1rem;

    display: none;
    left: calc(50% - var(--width) / 2);
    width: var(--width);

    background: @lib__colors__N050;
    border: 1px solid @lib__colors__light-blue800;
    &::after {
      border-color: @lib__colors__light-blue800;
      background: @lib__colors__N050;
    }
  }

  .addSuggestionIndicator {
    --width: 2.25rem;

    left: calc(50% - var(--width) / 2);
    width: var(--width);
  }

  .closeBracketSuggestionIndicator {
    --width: 1.5rem;

    left: calc(50% - var(--width) / 2);
    width: var(--width);
  }
}

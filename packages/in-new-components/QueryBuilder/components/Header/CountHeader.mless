:local {
  .headerWithTooltip {
    display: flex;
    flex-direction: row;
  }
  .header {
    display: flex;
    flex-direction: column;

    width: max-content;

    padding-left: 1rem;
    padding-right: 1rem;

    .groupCount {
      padding: 0;
    }

    .itemCount {
      padding: 0;
    }
  }
}

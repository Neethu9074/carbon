@import '~in-themes/active.less';

:local {
  .booleanValue {
    padding: 0.0225rem 0.3125rem;
    margin-top: -0.25rem;
    margin-bottom: -0.25rem;
    border-right: 1px solid @lib__colors__N300;
    border-bottom: none;
    border-top: none;
    line-height: 2;

    cursor: pointer;

    &:hover {
      color: @lib__colors__N600Light;
      outline: none;
      background: @lib__colors__N200;
      border-bottom: 1px solid;
      border-top: 1px solid;
      border-left: 1px solid;
      margin-left: -1px;
      border-color: @lib__colors__light-blue800;
    }

    .booleanValue {
      background: @lib__colors__N050;
      color: @lib__colors__N900Primary;
    }

    &:focus,
    &:active {
      outline: none;
      background: @lib__colors__N200;
      border-bottom: 1px solid;
      border-top: 1px solid;
      border-left: 1px solid;
      margin-left: -1px;
      border-color: @lib__colors__light-blue800;
    }
  }
}

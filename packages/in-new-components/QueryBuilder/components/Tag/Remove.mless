@import '~in-themes/active.less';

:local {
  .icon {
    padding-top: 0.0225rem;
    padding-bottom: 0.0225rem;
    border-left: 1px solid @lib__colors__N400;
    border-bottom: none;
    border-top: none;
    line-height: 2;
    cursor: pointer;

    fill: @lib__colors__N400;
    cursor: pointer;

    &:hover, &:active, &:focus {
      fill: @lib__colors__light-blue800;
      border-color: @lib__colors__light-blue800;
      outline: none;
    }
  }

  .hasBooleanSelectorBefore {
    // to avoid having two borders next to each other
    margin-left: -1px;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    position: relative;
    margin-right: 1.5rem;
    height: 0.5625rem;
  }

  .icon {
    // The icon's size triggers a very weird flexbox behavior for its parent element.
    // Work around this behavior by positioning this one absolutely to its wrapper.
    position: absolute;
    top: -0.45rem;
    left: 0;

    fill: @lib__colors__N700Medium;
    cursor: pointer;

    &:hover,
    &:active,
    &:focus {
      fill: @lib__colors__light-blue800;
      outline: none;
    }
  }
}

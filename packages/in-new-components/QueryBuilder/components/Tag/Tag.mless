@import '~in-themes/active.less';

:local {
  .tag,
  .tag_dark {
    display: inline-flex;
    align-items: center;

    max-height: 1.6875rem;

    padding: 0.1875rem 0rem 0.1875rem 0.25rem;

    border: 1px solid @lib__colors__N400;
    border-radius: @lib__shapes__radius_medium;
    font-weight: 500;
    // Ensure that all tags have the same height. No matter whether they render
    // an input field or not!
    line-height: 1.6;
    cursor: pointer;

    &:focus,
    &:active,
    &:hover {
      outline: 0;
      border-color: @lib__colors__light-blue800;
    }
  }

  .tag {
    background: @lib__colors__N050;
    &:focus,
    &:active,
    &:hover {
      background: @lib__colors__N200;
    }
  }

  // Hide invalid marker when already editing the tag filter.
  .invalid:not(:focus-within):not(:focus) {
    border-color: @lib__colors__failure;
  }

  .tag_dark {
    background: @lib__colors__N900Primary;
    &:focus,
    &:active,
    &:hover {
      background: @lib__colors__N700Medium;
    }
  }

  .booleanPlaceholder {
    line-height: 20px;
    font-weight: 600;
  }
}

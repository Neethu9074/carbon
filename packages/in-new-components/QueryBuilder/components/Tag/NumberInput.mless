@import '~in-themes/active.less';

:local {
  .input {
    max-width: 7.5rem;
    width: 65px;
    padding: 0.0225rem 0.3125rem;
    padding-right: 0px;

    line-height: 2;
    border: none;

    background: @lib__colors__white;

    &:focus,
    &:active,
    &:hover {
      outline: 0;
      color: @lib__colors__light-blue800;
    }

    &::placeholder {
      color: @lib__colors__N400;
      opacity: 1; /* Firefox */
    }
  }

  .invalid {
    margin-left: -1px; // to avoid having two borders next to each other
    border-left: 1px solid @lib__colors__failure;
    background: @lib__colors__failure10;
  }
}

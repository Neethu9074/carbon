@import '~in-themes/active.less';

:local {
  .operator {
    margin-right: 0.25rem;
    padding: 0.0225rem 0.3125rem;

    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_large;

    cursor: pointer;

    &:hover {
      color: @lib__colors__N600Light;
      outline: none;
      background: @lib__colors__N200;
      border-color: @lib__colors__light-blue800;
    }

    .operator {
      background: @lib__colors__N050;
      color: @lib__colors__N900Primary;
    }

    .operator_dark {
      background: @lib__colors__N900Primary;
      color: @lib__colors__N050;
    }

    &:focus,
    &:active {
      outline: none;
      background: @lib__colors__N200;
      border-color: @lib__colors__light-blue800;
    }
  }
}

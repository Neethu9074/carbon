@import '~in-themes/active.less';

:local {
  .name {
    margin-right: 0.25rem;
    font-weight: 600;
    color: @lib__colors__N900Primary;

    &:hover {
      color: @lib__colors__N600Light;
    }
  }

  .icon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem;

    fill: @lib__colors__N700Medium;
  }
}

@import '~in-themes/active.less';

:local {
  .name {
    margin-right: 0.25rem;
    font-weight: 600;

    color: var(--query-builder-element-color);

    border: 0;
    background: none;
    padding: 0 0.25rem 0 0.1875rem;
    border: 1px solid transparent;
    border-radius: @lib__shapes__radius_medium;
    cursor: pointer;

    &:focus,
    &:active,
    &:hover {
      outline: none;
      color: @lib__colors__light-blue800;

      .icon {
        fill: @lib__colors__light-blue800;
      }
    }
  }

  .icon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem;

    fill: @lib__colors__N400;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .list {
    position: absolute;
    // avoid list elements to be below tag input fields and make them on the same level as addIndicators
    z-index: 1;
    left: 0;

    max-height: 12.875rem;
    min-width: 15rem;
    overflow: auto;
    max-width: 30rem;

    .breakWord();

    cursor: default;
  }

  .highlighted {
    background: @lib__colors__faded-blue800;
  }

  .input,
  .input_dark {
    max-width: 7.5rem;

    margin-right: 0.25rem;

    line-height: 0.75rem;
    border: 1px solid transparent;
    border-radius: @lib__shapes__radius_small;

    &:focus,
    &:active,
    &:hover {
      outline: 0;
    }

    &::placeholder {
      color: @lib__colors__N400;
      opacity: 1; /* Firefox */
    }
  }

  .input {
    background: @lib__colors__white;
  }

  .input_dark {
    background: @lib__colors__N800Dark;
  }

  .invalid {
    border: 1px solid @lib__colors__failure;
  }

  .option {
    justify-content: flex-start;
    width: 100%;
  }

  .skeleton {
    margin: 0.375rem 0;
    height: 0.75rem;
  }

  .moreOptionsLabel {
    font-size: 0.6875rem;
    color: @lib__colors__N600Light;
  }
}

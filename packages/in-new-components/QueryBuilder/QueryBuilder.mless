@import '~in-new-components/QueryBuilder/shared.less';
@import '~in-themes/active.less';

:local {
  .queryBuilder {
    // required in order to execute offset calculations via JS (see offsetX, offsetY access)
    position: relative;

    display: inline-block;
    font-size: 0.75rem;
    line-height: @query-builder-line-height;
    user-select: none;

    &:hover {
      cursor: text;
    }
  }

  .emptyQueryHelpText {
    margin-left: 0.125rem;

    color: @lib__colors__N400;
    pointer-events: none;
  }
}

@import '~in-themes/active.less';

:local {
  .searchInputWrapper {
    padding: 0.5rem;
  }

  .overlay {
    width: 26rem;

    border-radius: @lib__shapes__radius_medium;
  }

  .content {
    min-height: 30rem;
  }

  .filterList,
  .searchInputWrapper {
    border-bottom: 1px solid @lib__colors__N400;
  }

  .filterList,
  .list {
    min-width: 20rem;
    max-width: 20rem;
  }

  .option {
    justify-content: space-between;
    font-weight: normal;
  }
}

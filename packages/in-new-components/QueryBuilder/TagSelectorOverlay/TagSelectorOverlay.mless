@import '~in-themes/active.less';

:local {
  .searchInputWrapper {
    padding: 0.5rem;
  }

  .overlay {
    width: 26rem;

    border-radius: @lib__shapes__radius_medium;
  }

  .content {
    @height: 20rem;
    min-height: @height;
    max-height: @height;
  }

  .filterList {
    border-bottom: 1px solid @lib__colors__N400;
  }

  .option {
    justify-content: space-between;
    font-weight: normal;
  }
}

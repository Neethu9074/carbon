@import '~in-themes/active.less';

:local {
  .queryBuilderSection {
    background: @lib__colors__white;
    color: @lib__colors__N900Primary;
    fill: @lib__colors__N900Primary;
  }

  .queryBuilderSection_dark {
    background: @lib__colors__N700Medium;
    color: @lib__colors__white;
    fill: @lib__colors__white;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    // Visually align group by "box" with the first box of the query builder (which has an offset
    // due to the leading whitespace).
    margin-left: 0.125rem;
    margin-right: 0.25rem;
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1.6;

    color: var(--query-builder-element-color);
    max-height: 1.6875rem;

    padding: 0 0.3rem 0 0.25rem;
    background: @lib__colors__N050;
    width: fit-content;

    border: 1px solid @lib__colors__N400;
    border-radius: @lib__shapes__radius_medium;

    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .metric, .aggregation, .renderer {
    line-height: 2;
    padding: 0.0938rem 0.375rem;

    &:not(:last-child) {
      border-right: 1px solid #DFE4E8;
    }

    &:first-child {
      padding-left: 0;
      margin-left: 0.1875rem;
    }
  }

  .aggregation, .renderer {
    font-weight: 400;
  }

  .selectable {
    &:focus,
    &:active,
    &:hover {
      outline: none;
      color: @lib__colors__light-blue800;

      .icon {
        fill: @lib__colors__light-blue800;
      }
    }
  }

  .removeIcon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem -0.5rem 0;

    fill: @lib__colors__N400;
    cursor: pointer;

    &:hover, &:active, &:focus {
      fill: @lib__colors__light-blue800;
      outline: none;
    }
  }
}

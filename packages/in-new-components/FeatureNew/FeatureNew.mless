@import '~in-themes/active.less';

:local {
  .newMarker {
    background: @lib__colors__N100;
    border-radius: @lib__shapes__radius_small;
    color: @lib__colors__N800Dark;
    border: 1px solid @lib__colors__N400;
    padding: 0.5rem 0.625rem;
    height: 2.6875rem;
    display: flex;
    align-items: center;
  }

  .newPill {
    margin-right: 0.4rem;
  }

  .newLink {
    margin-left: 0.2rem;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    width: 100%;
    max-width: 87.5rem;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0 auto;
    display: flex;
    flex-direction: row-reverse;
  }

  .betaMarker {
    box-shadow: 0px 0px 25px 0px rgba(0, 0, 0, 0.3);
    width: 11.625rem;
    z-index: 2;
    background: #fff;
  }

  .header {
    background: #000;
    color: #fff;
    padding: 0.25rem 1rem;
    border-top-left-radius: @lib__shapes__radius_medium;
    border-top-right-radius: @lib__shapes__radius_medium;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .headerTitle {
    font-size: 0.75rem;
    font-weight: 400;
    margin: 0 1rem 0 0;
  }

  .arrowIcon {
    fill: @lib__colors__N600Light;
  }

  .body {
    padding: 1rem;
    font-size: 0.75rem;
  }
}
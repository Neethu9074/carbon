@import '~in-themes/active.less';

:local {
  .wrapper {
    width: 100%;
    max-width: @max-width * 1px;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0 auto;
    display: flex;
    flex-direction: row-reverse;
    pointer-events: none;
  }

  .betaMarker {
    box-shadow: @lib__shadows__soft;
    width: 17.5rem;
    z-index: 2;
    background: #fff;
    pointer-events: all;
  }

  .header {
    background: #000;
    color: #fff;
    padding: 0.5rem 1rem;
    border-top-left-radius: @lib__shapes__radius_medium;
    border-top-right-radius: @lib__shapes__radius_medium;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .headerTitle {
    font-size: .9rem;
    font-weight: 400;
    margin: 0 1rem 0 0;
  }

  .arrowIcon {
    fill: @lib__colors__N600Light;
  }

  .body {
    padding: 1rem;
    font-size: .9rem;
    line-height: 1.5;
  }

  .buttonWrapper {
    display: flex;
    justify-content: center;
  }
}
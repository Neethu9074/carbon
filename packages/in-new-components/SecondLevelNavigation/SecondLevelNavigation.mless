@import '~in-themes/active.less';

:local {
  .nav {
    font-size: 1.375rem;
    font-weight: lighter;
    overflow: hidden;
  }

  .navLight {
    background: @lib__colors__N800Dark;
    border-bottom: none;
    border-top: none;
  }

  .tabList {
    display: flex;
    align-items: flex-end;
    height: 4rem;
  }

  .tabListLight {
    .tab {
      color: @lib__colors__N300;
      line-height: 1.5rem;

      &:hover {
        color: #fff;
      }
    }
    .tabSelected {
      color: #fff;
      border-bottom: 3px solid @lib__colors__cyan800;
    }
  }

  .tab {
    display: flex;
    align-items: center;

    padding-bottom: 0.75rem;
    margin: 0 2rem 0 0.125rem;

    font-size: 1rem;
    border-bottom: 3px solid transparent;

    &:hover {
      border-bottom: 3px solid @lib__colors__N600Light;

      .icon {
        fill: @lib__colors__N500;
      }
    }
  }

  .tabSelected {
    color: @lib__colors__N900Primary;
    border-bottom: 3px solid @lib__colors__cyan800;
    cursor: default;

    .icon {
      fill: @lib__colors__N500;
    }
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N500;
  }

  .link {
    text-decoration: none;
    color: @lib__colors__N500;

    &:hover {
      text-decoration: none;
      color: @lib__colors__N500;
    }
  }

  .addSeparator {
    margin-left: 1rem;
    padding-left: 1rem;
    position: relative;

    &::before {
      position: absolute;
      top: -1.125rem;
      left: 0;
      bottom: 0.375rem;
      width: 1px;
      background: @lib__colors__N300;
      content: '';
    }
  }
}

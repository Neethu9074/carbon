@import '~in-themes/active.less';

:local {
  .fullWithWraper {
    padding: 0 2rem;
  }

  .nav {
    background: @lib__colors__N050;
    font-size: 1.375rem;
    font-weight: lighter;
    overflow: hidden;
    border-bottom: 1px solid @lib__colors__N300;
    height: @header__height * 1px;
  }

  .navLight {
    background: @lib__colors__N800Dark;
    border-bottom: 0px;
  }

  .tabList {
    display: flex;
    align-items: flex-end;
    height: @header__height * 1px;
  }

  .tabListLight {
    .tab {
      color: @lib__colors__N300;
      line-height: 1.5rem;

      &:hover {
        color: #fff;
      }
    }
    .tabSelected {
      color: #fff;
      border-bottom: 3px solid @lib__colors__primary1
    }
  }

  .tab {
    display: flex;
    align-items: center;

    font-size: 1rem;
    padding: 0 1rem 0.75rem;
    border-bottom: 3px solid transparent;

    &:hover {
      border-bottom: 3px solid @lib__colors__N400;

      .icon {
        fill: @lib__colors__N500;
      }
    }
  }

  .tabSelected {
    color: @lib__colors__N500;
    border-bottom: 3px solid @lib__colors__N500;
    cursor: default;

    .icon {
      fill: @lib__colors__N500;
    }
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N500;
  }

  .link {
    text-decoration: none;
    color: @lib__colors__N500;

    &:hover {
      text-decoration: none;
      color: @lib__colors__N500;
    }
  }

  .addSeparator {
    margin-left: 1rem;
    padding-left: 1rem;
    position: relative;

    &::before {
      position: absolute;
      top: -0.3rem;
      left: 0;
      bottom: 0.7rem;
      width: 2px;
      background: #84969c;
      content: '';
    }
  }
}

@import '~in-themes/active.less';

:local {
  .nav {
    background: @lib__colors__navy800;
    font-size: 22px;
    font-weight: lighter;
    overflow: hidden;
  }

  .tabList {
    display: flex;
    align-items: flex-end;

    height: 4rem;
  }

  .tab {
    display: flex;
    align-items: center;

    font-size: 1rem;
    padding: 0 1rem 1rem;
    border-bottom: 3px solid transparent;

    &:hover {
      border-bottom: 3px solid #fff;

      .icon {
        fill: #fff;
      }
    }
  }

  .tabSelected {
    color: #fff;
    border-bottom: 3px solid #fff;
    cursor: default;

    .icon {
      fill: #fff;
    }
  }

  .icon {
    margin-right: 0.5rem;
    fill: rgba(255,255,255,0.56);
  }

  .link {
    text-decoration: none;
    color: rgba(255,255,255,0.56);

    &:hover {
      text-decoration: none;
      color: #fff;
    }
  }

  .addSeparator {
    margin-left: 1rem;
    padding-left: 1rem;
    position: relative;

    &::before {
      position: absolute;
      top: -0.3rem;
      left: 0;
      bottom: 0.7rem;
      width: 2px;
      background: #84969C;
      content: "";
    }
  }
}

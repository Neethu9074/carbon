@import '~in-themes/active.less';

:local {
  .header {
    font-size: @lib__typography__h300__font-size;
    color: @lib__colors__N900Primary;
    padding: 1.375rem 2.188rem;
    margin: 0;
    background: #fff;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .more {
    font-size: @lib__typography__h100__font-size;
    color: @lib__colors__N700Medium;
    display: block;
  }
}

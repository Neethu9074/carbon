@import '~in-themes/active.less';

:local {
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: @lib__shapes__radius_medium;
    font-size: @lib__typography__body__font-size;
    font-weight: 600;
    color: #fff;
    padding: 1px 6px 1px 3px;
  }

  .icon {
    margin: 0 2px 0 0;
  }
}

@import '~in-themes/active.less';

:local {
  .groupingConfigurator {
    // Visually align group by "box" with the first box of the query builder (which has an offset
    // due to the leading whitespace).
    margin-left: 0.125rem;
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1.6;

    color: var(--query-builder-element-color);
    max-height: 1.6875rem;

    padding: 0.1875rem 0.3rem 0.1875rem 0.4375rem;
    background: @lib__colors__N050;
    width: fit-content;

    border: 1px solid @lib__colors__N400;
    border-radius: @lib__shapes__radius_medium;

    display: flex;
    align-items: center;

    cursor: pointer;
  }

  .noActiveGroupingButton {
    margin-top: 0.125rem;
  }

  .groupName {
    margin-right: 0.5rem;

    &:focus,
    &:active,
    &:hover {
      outline: none;
      color: @lib__colors__light-blue800;

      .icon {
        fill: @lib__colors__light-blue800;
      }
    }
  }

  .icon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem;

    fill: @lib__colors__N400;
  }

  .removeIcon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem -0.5rem 0.25rem;

    fill: @lib__colors__N400;
    cursor: pointer;

    &:hover, &:active, &:focus {
      fill: @lib__colors__light-blue800;
      outline: none;
    }
  }

  .entityIcon {
    // The icon's size triggers a very weird flexbox behavior for its parent element.
    // Work around this behavior by positioning this one absolutely to its wrapper.
    // position: absolute;
    // top: -.45rem;
    // left: 0;

    fill: @lib__colors__N700Medium;
    cursor: pointer;

    &:hover, &:active, &:focus {
      fill: @lib__colors__light-blue800;
      outline: none;
    }
  }
}

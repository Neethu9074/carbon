@import '~in-themes/active.less';

:local {
  .pagination {
    display: flex;
    font-size: 0.875rem;
  }

  .action {
    color: @lib__colors__N600Light;
    text-decoration: none;

    &:hover {
      color: @lib__colors__primary1;
      text-decoration: none;
    }
  }

  .disabledAction,
  .disabledAction:hover {
    color: @lib__colors__N600Light;
    cursor: default;
    text-decoration: none;
  }

  .center {
    margin: 0 1rem 1rem;
  }

  .current,
  .separator,
  .last {
    color: @lib__colors__N900Primary;
  }
}

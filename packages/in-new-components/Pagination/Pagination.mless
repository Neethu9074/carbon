:local {
  .pagination {
    display: flex;
    font-size: 0.875rem;
    font-weight: 400;
  }

  .action {
    color: #1fb7b9;
    text-decoration: none;
  }

  .disabledAction,
  .disabledAction:hover {
    color: #698189;
    cursor: default;
    text-decoration: none;
  }

  .center {
    margin: 0 1rem;
  }

  .current,
  .separator,
  .last {
    color: #16363e;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .dashboardHeader {
    padding: 0 1.5rem;
  }
  .default {
    background: @lib__colors__N050;
  }
  .light {
    background: @lib__colors__white;
  }
  .dark {
    background: @lib__colors__N800Dark;
    .label {
      color: @lib__colors__white;
    }
    .icon {
      fill: @lib__colors__white;
    }
    .contextIcon,
    .contextEndIcon {
      fill: @lib__colors__N400;
    }
    .context {
      color: @lib__colors__N400;
    }
  }

  .firstLine,
  .leftContent,
  .rightContent,
  .buttonLine {
    .flexbox();
  }

  .rightContent {
    justify-content: flex-end;
  }

  .firstLine {
    justify-content: space-between;
    padding: 1rem 0;
    max-width: 100%;
  }

  .contextIcon,
  .contextEndIcon,
  .icon {
    margin-right: 0.5rem;
  }

  .contextIcon,
  .contextEndIcon {
    fill: @lib__colors__N600Light;
  }

  .contextEndIcon {
    margin-left: 0.5rem;
  }

  .icon {
    fill: @lib__colors__N900Primary;
  }

  .contextWrapper {
    .flexbox();

    & + .contextWrapper {
      margin-left: 0.5rem;
    }
  }

  .context,
  .label {
    font-size: 1.375rem;
    line-height: 2rem;
    font-weight: 500;
    .ellipsis();
  }

  .context {
    color: @lib__colors__N600Light;
  }

  .label {
    color: @lib__colors__N900Primary;
    margin-right: 0.75rem;
  }

  .buttonLine {
    display: inline-flex;
    min-height: 3.125rem;
    padding-bottom: 1rem;
    width: 100%;

    & > div {
      display: inherit;
    }
  }

  .withSecondary {
    display: flex;
    justify-content: space-between;
  }

  .secondaryActions {
    justify-self: flex-end;
  }
}

// loading state definitions
.labelSkeleton {
  width: 12.5rem;
  height: 1.813rem;
  display: block;
}

.buttonSkeleton {
  width: 7.5rem;
  height: 2rem;
  display: block;
}

.iconSkeleton {
  width: 2rem;
  height: 2rem;
  display: block;
}

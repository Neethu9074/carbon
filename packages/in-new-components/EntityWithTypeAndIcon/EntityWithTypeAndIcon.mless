@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
  }

  .entityIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__N600Light;
  }

  .type {
    margin-bottom: 0.25rem;
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
  }

  .labelWrapper {
    display: flex;
    flex-direction: column;
  }

  .label {
    color: @lib__colors__N900Primary;
    font-size: 0.875rem;
  }

  .link {
    font-size: 0.875rem;
  }
}

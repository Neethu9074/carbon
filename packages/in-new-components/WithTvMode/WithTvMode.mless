@import '~in-themes/active.less';

:local {
  .tvMode {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background: @lib__colors__N100;
    z-index: @z-index__tv-mode;
    overflow: hidden auto;
  }
}

:local {
  .chartContainer {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    margin: 0 0 1rem 0;
    transform: rotateX(-90);
  }

  .chart {
    padding: 1rem;
    display: flex;
    align-items: center;
    flex: 1;
    overflow: hidden;
  }

  .svg {
    margin-top: 1rem;
    transform: rotateZ(-90deg);
    height: 100%;
    width: 100%;
  }
}

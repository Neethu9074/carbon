@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    .flexbox();
    white-space: nowrap;
  }

  .dot {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }

  .label {
    max-width: 12.5rem;
    .ellipsis();
  }

  .timeShift {
    color: @lib__colors__N600Light;
    text-transform: lowercase;
    margin-left: 0.25rem;
  }

  .percentage {
    color: @lib__colors__N600Light;
    margin-left: 0.25rem;
  }
}

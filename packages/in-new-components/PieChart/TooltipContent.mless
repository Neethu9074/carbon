@import '~in-themes/mixins.less';

:local {
  .tooltip {
    display: grid;
    grid-template-columns: auto 1rem auto;
    white-space: nowrap;
  }

  .secText {
    color: @lib__colors__N600Light;
    text-transform: lowercase;
    margin-left: 0.25rem;
  }

  .toltipDot {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    margin-right: 0.375rem;
    border-radius: 50%;
  }
}

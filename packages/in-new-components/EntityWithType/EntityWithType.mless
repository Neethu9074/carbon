@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    flex-direction: column;

    overflow: hidden;
  }

  .type {
    display: flex;
    align-items: center;

    margin-bottom: 0.25rem;

    font-size: 0.75rem;
    color: @lib__colors__N600Light;
  }

  .label {
    color: @lib__colors__N900Primary;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    .ellipsis();
  }

  .link {
    font-size: 0.875rem;
    .ellipsis();
  }

  .withEllipsis {
    .ellipsis();
    max-width: 20rem;
  }
}

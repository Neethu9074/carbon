@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    flex-direction: column;

    overflow: hidden;
  }

  .type {
    margin-bottom: 0.25rem;
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
  }

  .label {
    color: @lib__colors__N900Primary;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    .ellipsis();
  }

  .link {
    font-size: 0.875rem;
    .ellipsis();
  }
}

@import '~in-themes/active.less';

:local {
  .facetedSearchResultContainer {
    display: flex;
    flex-direction: row;
  }

  .sparkChartWrapper {
    margin: 0 0.4rem;
    min-width: 9rem;
  }

  .resultContainer {
    flex: 1;
    min-width: 0;
  }

  .groupLabel {
    display: flex;
    align-items: center;
  }

  .arrowRight {
    fill: @lib__colors__N400;
    // Have the icon use less vertical space.
    margin-top: -0.3rem;
    margin-bottom: -0.3rem;
  }

  .list {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    overflow: hidden;
  }

  .label {
    width: '30%';
    min-width: 15rem;
    margin-right: 1rem;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
  }

  .center {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }

  .rect {
    width: 0.75rem;
    height: 0.75rem;
  }

  .metrics {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
  }

  .italic {
    font-style: italic;
  }
}

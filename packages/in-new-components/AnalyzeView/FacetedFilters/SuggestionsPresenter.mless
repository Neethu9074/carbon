@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .loading {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .suggestion {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .addSuggestion {
    font-size: 0.75rem;
    display: flex;
    justify-content: space-between;
    width: 100%;
    color: @lib__colors__N900Primary;
    &:hover {
      color: @lib__colors__light-blue800;
    }
  }

  .count {
    margin-left: 1rem;
  }

  .label {
    .ellipsis();
  }

  .buttonRow {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .showMore {
    font-size: 0.75rem;
    padding: 0;
  }

  .useAsGroup {
    font-size: 0.75rem;
    padding: 0;
  }
}

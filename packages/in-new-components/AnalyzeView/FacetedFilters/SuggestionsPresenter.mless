@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .typoSettings {
    font-size: 0.75rem;
    line-height: 0.75rem;
  }

  .suggestion {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .addSuggestion {
    .typoSettings();
    display: flex;
    justify-content: space-between;
    width: 100%;
    color: @lib__colors__N800Dark;
    &:hover {
      color: @lib__colors__light-blue800;
    }
  }

  .count {
    margin-left: 1rem;
  }

  .label {
    .ellipsis();
  }

  .buttonRow {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .loadMore {
    .typoSettings();
    padding: 0;
    color: @lib__colors__light-blue800;
    &:hover {
      background: transparent;
      color: @lib__colors__light-blue800;
    }
  }

  .addAsGroup {
    .typoSettings();
    padding: 0;
    color: @lib__colors__light-blue800;
    &:hover {
      background: transparent;
      color: @lib__colors__light-blue800;
    }
  }

  .skeletonContainer {
    display: block;
    width: 100%;
    height: 0.75rem;
    border-radius: 0.25rem;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .suggestion {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .label {
    .ellipsis();
    color: @lib__colors__light-blue800;
  }

  .icon {
    fill: @lib__colors__light-blue800;
  }
}

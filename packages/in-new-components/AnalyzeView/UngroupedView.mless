@import '~in-themes/active.less';

:local {
  .facetedSearchResultContainer {
    display: flex;
    flex-direction: row;
  }

  .resultContainer {
    flex: 1;
    overflow: hidden;
  }

  .helpIcon {
    fill: @lib__colors__N600Light;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
}

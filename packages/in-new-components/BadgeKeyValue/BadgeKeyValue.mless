@import '~in-themes/active.less';

:local {
  .badgeWrapper {
    display: flex;

    box-shadow: 0px 2px 1px 0px @lib__colors__N200;
    overflow: hidden;
  }

  .badge {
    display: flex;
    align-items: center;

    box-sizing: border-box;
    padding: 0.4375rem 0.625rem;
    font-weight: 100;

    color: @lib__colors__N900Primary;
    text-align: center;
    white-space: nowrap;
    vertical-align: baseline;
  }

  // Using both classes (.badge and .badgeKey) to get a higher specifity here so that we can override the
  // border-radius set in .mid/.sm.
  .badge.badgeKey {
    background: @lib__colors__primary1;
    color: #fff;
    font-size: 0.875rem;
    padding-left: 0.75rem;
    border-radius: 1rem 0 0 1rem;
  }

  // Using both classes (.badge and .badgeValue) to get a higher specifity here so that we can override the
  // border-radius set in .mid/.sm.
  .badge.badgeValue {
    background: #fff;
    font-size: 0.875rem;
    color: @lib__colors__N800Dark;

    border-radius: 0 1rem 1rem 0;
    border: 1px solid @lib__colors__N400;
    border-left: 0;
  }
}

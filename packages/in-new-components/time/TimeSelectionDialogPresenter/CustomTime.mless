@import '~in-themes/active.less';

:local {
  .wrapper {
    width: 20rem;
    border-right: 1px solid @lib__colors__N300;
  }

  .from {
    margin: 1rem 1.5rem;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .to {
    margin: 0.3rem 1.5rem;
  }

  .errors {
    margin: 0.3rem 1.5rem;
  }

  .buttons {
    margin: 0 1rem 1rem 0;
    display: flex;
    justify-content: flex-end;
  }
}

@import '~in-themes/active.less';

:local {
  .inputs {
    display: flex;
    align-items: flex-start;
  }

  .controls {
    display: flex;
    justify-content: space-between;

    margin-top: 3rem;
  }

  .to {
    margin: 0.5rem 1rem 0 1rem;

    font-size: 0.75rem;
    font-weight: 500;
  }

  .button {
    width: 9rem;
    height: 2rem;
  }

  .notes {
    height: 1rem;

    margin-top: 0.5rem;
  }

  .error {
    margin: 0;
  }

  .icon {
    fill: @lib__colors__N600Light;
    margin-right: 0.5rem;
  }

  .help {
    color: @lib__colors__N600Light;
  }

  .mark {
    display: flex;
    flex-direction: column;
    align-items: center;

    color: @lib__colors__N600Light;
  }
}

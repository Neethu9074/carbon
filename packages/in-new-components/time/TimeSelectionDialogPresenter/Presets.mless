:local {
  .wrapper {
    width: 24.75rem;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 1rem;

    & + .row {
      margin-top: 0.25rem;
    }

    &:first-child {
      margin-top: 0.5rem;
    }

    &:last-child {
      margin-bottom: 0.5rem;
    }
  }
}

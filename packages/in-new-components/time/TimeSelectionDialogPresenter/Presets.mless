@import '~in-themes/active.less';

:local {
  .wrapper {
    width: 24.75rem;
  }

  .col {
    padding: 0.25rem 0.25rem;
    a {
      margin: 0 0.5rem;
      line-height: 1.5rem;
    }
    & + .row {
      margin-top: 0.25rem;
    }

    &:last-child {
      margin-bottom: 0.5rem;
    }
  }

  .header {
      padding: 0.25rem 0.5rem;
      line-height: 2rem;
      font-weight: normal;
      font-size: 1rem;
      background: @lib__colors__N200;
      color: @lib__colors__N700Medium;
      margin-left: 0.5rem;
      margin-right: 0.5rem;
      margin-bottom: 0rem;
    }

  .button {
      margin: 0 1.5rem 1rem 0.5rem;
      width: 10rem;
      font-size: small;
      justify-content: flex-left;
    }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 1rem;

    & + .row {
      margin-top: 0.25rem;
    }

    &:first-child {
      margin-top: 0.5rem;
    }

    &:last-child {
      margin-bottom: 0.5rem;
    }
  }

  .newRow {
      .row();
      justify-content: flex-end;

    }

  .dialog {
      width: 50vw;
      max-width: 100rem;
    }
}

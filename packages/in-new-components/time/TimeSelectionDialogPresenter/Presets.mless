@import '~in-themes/active.less';

:local {
  .wrapper {
    width: 24.75rem;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 1rem;

    & + .row {
      margin-top: 0.25rem;
    }

    &:first-child {
      margin-top: 0.5rem;
    }

    &:last-child {
      margin-bottom: 0.5rem;
    }
  }

  .item {
    padding: 0.5rem;
    color: @lib__colors__N700Medium;
    font-size: 0.875rem;
    text-decoration: none;
    display: block;
    flex-basis: 48%;
    border-radius: @lib__shapes__radius_small;

    transition: background 0.2s ease-in-out, color 0.2s ease-in-out;
  }

  .item:hover {
    background: @lib__colors__N300;
    text-decoration: none;
  }

  .activeItem {
    background: @lib__colors__N900Primary;
    color: #fff;
    text-decoration: none;

    &:hover {
      background: @lib__colors__N900Primary;
      cursor: default;
    }
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    width: 24.75rem;
  }

  .header {
    padding: 0.25rem 0.5rem;
    line-height: 2rem;
    font-weight: normal;
    font-size: 1rem;
    background: @lib__colors__N200;
    color: @lib__colors__N700Medium;
    margin-bottom: 0rem;
  }

  .button {
    padding: 0.25rem 0.675rem;
  }

  .dialog {
    width: 50vw;
    max-width: 100rem;
  }

  .container {
    display: flex;
    flex-grow: 1;
    min-width: 0;

    align-content: stretch;
    margin-top: 0.25rem;
    padding: 0.25rem;
    line-height: 1.5rem;

  }

  .leftColumn {
    padding: 0.25rem;
    min-width: 50%;
  }

  .rightColumn {
    min-width: 50%;
    padding: 0.25rem;
  }

  .releases {
    a {
        width: 100%;
        display: inline-block;
        .ellipsis();
        vertical-align:top;
     }
  }


}

@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;

    width: 44.75rem;
    height: 5rem;
    padding: 1.5rem 2rem;

    background: @lib__colors__navy800;
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__primary1;
  }

  .title {
    color: #fff;
    margin: 0 2.5rem 0 0;
    font-weight: 400;
    white-space: nowrap;
  }

  .text {
    margin: 0;
    color: @lib__colors__N300;
    line-height: 1.25rem;
  }
}

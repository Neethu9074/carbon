@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    flex-direction: column;
    width: 50rem;

    background: @lib__colors__white;
  }

  .tabs {
    height: 3rem;

    border-bottom: 1px solid @lib__colors__N300;
  }

  .tab > div {
    display: flex;
    justify-content: center;

    width: 25rem;

    margin-right: 0;

    cursor: pointer;
    font-weight: 500;
  }
}

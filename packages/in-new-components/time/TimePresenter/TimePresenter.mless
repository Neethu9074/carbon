:local {
  .wrapper {
    display: flex;
    align-items: center;
    text-decoration: none;

    &:hover {
      text-decoration: none;

      .timeIcon, .toggleIcon {
        fill: #fff;
      }

      .timeSetting {
        color: #fff;
      }
    }
  }

  .timeIcon, .toggleIcon {
    fill: #698189;
  }
  .timeIconExpanded, .toggleIconExpanded {
    fill: #fff;
  }

  .timeSetting {
    color: #698189;
    margin: 0 .5rem;
    font-size: .875rem;
    font-weight: 500;
  }
  .timeSettingExpanded {
    color: #fff;
  }

  .tooltip {
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .tooltipFrom, .tooltipTo {

  }

  .tooltipLabel {
    color: #698189;
    margin: .3rem 0 0.5rem;
  }
}

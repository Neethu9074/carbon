@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    text-decoration: none;

    &:hover {
      text-decoration: none;

      .timeIcon,
      .toggleIcon {
        fill: #fff;
      }

      .timeSetting {
        color: #fff;
      }
    }
  }

  .timeIcon {
    fill: @lib__colors__primary1;
  }

  .toggleIcon {
    fill: #7d8b8f;
  }

  .timeIconExpanded,
  .toggleIconExpanded {
    fill: #fff;
  }

  .timeSetting {
    color: #fff;
    margin-left: 0.25rem;
    font-size: 0.875rem;
  }
  .timeSettingExpanded {
    color: #fff;
  }

  .tooltip {
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .tooltipLabel {
    color: #698189;
    margin: 0.3rem 0 0.5rem;
  }
}

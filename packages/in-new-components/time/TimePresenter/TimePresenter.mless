@import '~in-themes/active.less';

:local {
  .timePresenter {
    height: 100%;
    border-left: 1px solid @lib__colors__N400;
    display: flex;
    align-items: center;
    padding: 0 1rem;
  }

  .wrapper {
    display: flex;
    align-items: center;
    text-decoration: none;

    &:hover {
      text-decoration: none;

      .timeSetting {
        color: @lib__colors__N500;
      }

      .timeIcon {
        fill: @lib__colors__N600Light;
      }
    }
  }

  .timeWrapper {
    display: flex;
    flex-direction: column;
  }

  .timeIcon {
    fill: @lib__colors__N800Dark;
    margin-right: 0.5rem;
  }

  .toggleIcon {
    margin-left: 1rem;
    fill: @lib__colors__N800Dark;
  }

  .toggleIconExpanded {
    fill: @lib__colors__N600Light;
  }

  .timeSettingTop {
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: normal;
  }

  .timeSetting {
    color: @lib__colors__N800Dark;
    font-size: 1rem;
    line-height: 1rem;
    font-weight: 600;
  }

  .timeSettingTopExpanded {
    color: @lib__colors__N600Light;
  }

  .timeSettingExpanded {
    color: @lib__colors__N600Light;
  }

  .tooltip {
    display: flex;
    align-items: center;
    flex-direction: column;

    color: @lib__colors__N900Primary;
  }

  .tooltipLabel {
    margin: 0.3rem 0 0.5rem;
  }
}

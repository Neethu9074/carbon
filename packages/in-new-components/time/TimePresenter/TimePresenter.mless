@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    text-decoration: none;

    &:hover {
      text-decoration: none;

      .timeIcon {
        display: none;
      }

      .timeIconHighlight {
        display: block;
      }

      .timeSetting {
        color: #fff;
      }
    }
  }

  .timeIcon {
    display: block;
    fill: #fff;
  }

  .timeIconHighlight {
    display: none;
    fill: #fff;
  }

  .timeIconExpanded {
    display: none;
  }

  .timeIconHighlightExpanded {
    display: block;
  }

  .toggleIcon {
    fill: #7d8b8f;
  }

  .toggleIconExpanded {
    fill: #fff;
  }

  .timeSetting {
    color: #fff;
    margin-left: 0.25rem;
    font-size: 0.875rem;
  }

  .timeSettingExpanded {
    color: #fff;
  }

  .tooltip {
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .tooltipLabel {
    color: @lib__colors__N600Light;
    margin: 0.3rem 0 0.5rem;
  }
}

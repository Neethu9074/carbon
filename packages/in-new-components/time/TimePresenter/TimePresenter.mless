@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    text-decoration: none;

    &:hover {
      text-decoration: none;

      .timeSetting {
        color: @lib__colors__N500;
      }

      .timeIcon {
        fill: @lib__colors__N600Light;
      }
    }
  }

  .timeIcon {
    fill: @lib__colors__N500;
  }

  .toggleIcon {
    fill: @lib__colors__N500;
  }

  .toggleIconExpanded {
    fill: @lib__colors__N600Light;
  }

  .timeSetting {
    color: @lib__colors__N600Light;
    margin-left: 0.25rem;
    font-size: 0.6875rem;
    line-height: 0.8125rem;
    font-weight: 700;
  }

  .timeSettingExpanded {
    color: @lib__colors__N600Light;
  }

  .tooltip {
    display: flex;
    align-items: center;
    flex-direction: column;

    color: @lib__colors__N900Primary;
  }

  .tooltipLabel {
    margin: 0.3rem 0 0.5rem;
  }
}

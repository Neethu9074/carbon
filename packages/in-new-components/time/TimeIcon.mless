@import '~in-themes/active.less';

:local {
  .iconWrapper {
    position: relative;
  }

  .timeIcon {
    display: block;
    fill: #7d8b8f;
  }

  .dark {
    background: @lib__colors__navy900;
    border: 1px solid @lib__colors__navy900;
  }

  .light {
    background: #fff;
    border: 1px solid #fff;
  }

  .timeIconExpanded {
    fill: #fff;
  }

  .pastLiveDataIndicator {
    position: absolute;
    top: -0.25rem;
    left: -0.5rem;

    border-radius: 50%;

    fill: @lib__colors__primary1;
  }
}

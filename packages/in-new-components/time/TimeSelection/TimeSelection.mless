@import '~in-themes/active.less';

:local {
  .timePresenter {
    position: absolute;
    top: 0;
    right: 0;

    display: flex;

    height: @header__height * 1px;
    width: 17.5rem;

    border-left: 1px solid #2d4048;
    align-items: center;
    padding: 0 2rem 0 2rem;
  }

  .light {
    border-left: 1px solid @lib__colors__N400;
  }

  .time {
    margin: 0 0.5rem 0 0;
  }
}

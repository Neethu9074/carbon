:local {
  .playWitHeaderClassEnable {
    display: block;
  }
  .playWitHeaderClassDisable {
    display: none;
  }

  .playWithInstana {
    top: 0px;
    position: fixed;
    width: stretch;
    height: 57px;
    left: 0px;
    display: flex;
    background: rgb(23, 161, 230);
    z-index: 124;
    color: white;
    align-items: center;
    width: 100%;

    .headerHeading {
      flex-grow: 1;
      font-weight: 300;
      font-size: 28px;
      margin: 0;
      margin-left: 100px;
    }

    .readyToMonitor {
      margin-right: 12px;
      font-size: 0.875rem;
      margin-top: 14px;
    }

    .buttonFreeTrial {
      width: 100px;
      margin-right: 12px;
      font-weight: bold;
    }

    .buttonDemo {
      margin-right: 24px;
    }
  }
}

:local {
  .playWitHeaderClassEnable {
    display: block;
  }

  .playWitHeaderClassDisable {
    display: none;
  }

  .playWithInstana {
    top: 0px;
    position: fixed;
    width: stretch;
    height: 57px;
    left: 0px;
    display: flex;
    background: rgb(23, 161, 230);
    z-index: 125;
    color: white !important;
    align-items: center;
    width: 100%;

    .headerHeading {
      flex-grow: 1;
      margin-left: 100px;
      color: white !important;
      h2 {
        color: white;
      }
    }

    .readyToMonitor {
      margin-right: 12px;
      font-size: 0.875rem;
      span {
        color: white;
      }
    }

    .buttonFreeTrial {
      width: 100px;
      margin-right: 12px;
      font-weight: bold;
    }

    .buttonDemo {
      margin-right: 24px;
    }
  }
}

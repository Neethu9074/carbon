@import '~in-themes/active.less';

:local {
  .buttons {
    position: absolute;
    right: 2rem;
    bottom: 2rem;
  }

  .buttonRow {
    display: flex;
    align-items: center;
  }

  .buttonColumn {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .countryLabel {
    position: absolute;

    padding: 0.125rem 0.25rem;

    background: #ffffff4f;
    border-radius: 0 3px 3px 3px;
    font-weight: 700;
  }

  .to2D {
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    color: @lib__colors__N400;
    width: 2rem;

    &:hover {
      color: @lib__colors__N500;
    }
  }

  .placeholder {
    width: 2rem;
    height: 2rem;
    margin: .5rem;
  }
}

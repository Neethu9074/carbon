:local {
  .wrapper {
    position: absolute;
    left: 2rem;
    top: 2rem;
  }

  .list {
    margin: 0;
    padding: 0;
  }

  .listItem {
    list-style: none;
    color: #fff;
    font-size: 1rem;
    padding: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .barWrapper {
    margin-top: 0.125rem;
  }

  .bar {
    height: 0.5rem;
    animation-duration: 2s;
    animation-name: slidein;
  }

  @keyframes slidein {
    from {
      width: 0%;
    }

    to {
      width: 100%;
    }
  }
}

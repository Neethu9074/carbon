@import '~in-themes/active.less';

:local {
  .button {
    margin-left: 0.5rem;
    margin-right: 0.5rem;
  }

  .icon {
    fill: @lib__colors__white;
    margin: -0.25rem 0 -0.25rem 0.25rem;
  }

  .tableWrapper {
    max-height: 20rem; // allows to have 5 1/2 services visible before scrolling
    overflow-y: auto;
  }

  .labelColumn {
    padding-right: 3rem;
    max-width: 20rem;
  }
}

:local {
  .switcher {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #47626A;
    height: 3.125rem;
  }

  .item {
    display: block;
    padding: 0 1rem;
  }

  .link {
    font-weight: bold;
    color: #BCC9D0;
    text-transform: uppercase;
    text-decoration: none;
  }

  .active, .link:hover, .link:active {
    color: #fff;
    text-decoration: none;
  }
}

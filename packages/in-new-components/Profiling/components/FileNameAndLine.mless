@import '~in-themes/mixins.less';

:local {
  .fileName {
    color: @lib__colors__N500;
    .ellipsis();
    flex-shrink: 1;
  }

  .fileNameWithSourceCode {
    &:hover {
      text-decoration: underline;
      cursor: pointer;
    }
  }
}

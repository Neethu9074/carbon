@import '~in-themes/active.less';

:local {
  .link {
    display: inline-flex;
    align-items: center;
    margin: 0 0 1.3rem;
    font-size: 0.9rem;
  }

  .icon {
    fill: @lib__colors__blue800;
  }

  .withoutMargin {
    margin: 0;
  }
}

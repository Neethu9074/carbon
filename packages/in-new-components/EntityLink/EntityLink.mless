@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
  }

  .specialIndicator {
    position: absolute;
    left: -6px;
    top: 0.5rem;
    height: 6px;
    width: 6px;
    background-color: @lib__colors__orange800;
    border-radius: 50%;
    display: inline-block;
  }
}

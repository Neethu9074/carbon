@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
  }

  .specialIndicator {
    position: absolute;
    left: 0.5625rem;
    top: 1.75rem;
    height: 6px;
    width: 6px;
    background-color: @lib__colors__orange800;
    border-radius: 50%;
    display: inline-block;
  }
}

@import '~in-themes/active.less';

:local {
  .message {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    background: @lib__colors__N200;
    border-radius: @lib__shapes__radius_small;
    border: 1px solid @lib__colors__N400;
    box-sizing: border-box;
    min-height: 2.5rem;
    padding: 0.625rem;
    color: @lib__colors__N600Light;
  }

  .icon {
    align-self: flex-start;
    margin-right: 0.5rem;
    line-height: 1.5rem;

    &.smallSize {
      line-height: 1.25rem;
    }
  }

  .content {
    width: 100%;
    font-size: 1rem;
    line-height: 1.5rem;

    &.smallSize {
      font-size: 0.75rem;
      line-height: 1.25rem;
    }
  }

  .dismiss {
    fill: @lib__colors__N500;
    cursor: pointer;
    margin: 0 0 0 1rem;
    align-self: baseline;

    &:hover {
      fill: darken(@lib__colors__N500, 20%);
    }
  }
}

@import '~in-themes/active.less';

:local {
  @darkyellow : darken(@lib__colors__warning, 15%);
  @lightyellow : lighten(@lib__colors__warning, 45%);
  @darkgreen : darken(@lib__colors__success, 15%);
  @lightgreen : lighten(@lib__colors__success, 45%);
  @darkred : darken(@lib__colors__failure, 15%);
  @lightred : lighten(@lib__colors__failure, 35%);

  .message {
    box-sizing: border-box;
    padding: 0.625rem;

    border-radius: @lib__shapes__radius_small;
    color: @lib__colors__N600Light;

    & + .message {
      margin-top: 0.5rem;
    }
  }

  .firstLine {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .small {
    padding: 6px 10px;
  }

  .bold {
    font-weight: bold;
  }

  .neutral {
    border: 1px solid @lib__colors__N400;
    background: @lib__colors__N200;
  }

  .success {
    background: @lightgreen;
    border: 1px solid @darkgreen;
    color: @darkgreen;
    .icon {
      fill: @darkgreen;
    }
  }

  .warning {
    background: @lightyellow;
    border: 1px solid @darkyellow;
    color: @darkyellow;
    .icon {
      fill: @darkyellow;
    }
  }

  .error {
    background: @lightred;
    border: 1px solid @darkred;
    color: @darkred;
    .icon {
      fill: @darkred;
    }
  }

  .icon {
    align-self: flex-start;
    margin-right: 0.5rem;
  }

  .content {
    width: 100%;
    font-size: 0.875rem;
    line-height: 1.5rem;

    &.smallSize {
      font-size: 0.75rem;
      line-height: 1.25rem;
    }
  }

  .dismiss {
    fill: @lib__colors__N500;
    cursor: pointer;
    margin: 0 0 0 1rem;
    align-self: baseline;

    &:hover {
      fill: darken(@lib__colors__N500, 20%);
    }
  }

  .description {
    width: 100%;
    margin-top: 0.25rem;

    color: @lib__colors__N600Light;
    font-weight: 400;
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  .descriptionSmallSize {
    font-size: 0.625rem;
    line-height: 1rem;
  }
}

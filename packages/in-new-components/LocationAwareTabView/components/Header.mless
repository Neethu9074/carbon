@import '~in-themes/active.less';

:local {
  .header {
    background: @lib__colors__N050;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .fullWidthWrapper {
    width: 100%;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .link {
    display: block;

    color: @lib__colors__N700Medium;
    text-decoration: none;
    cursor: pointer;

    &:hover {
      color: black;
      text-decoration: none;
    }
  }

  .selectedLink {
    color: #232627;
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .icon {
    fill: @lib__colors__N700Medium;
  }
}

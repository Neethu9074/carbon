@import '~in-themes/active.less';

:local {
  .header {
    box-shadow: 0px 10px 16px -13px rgba(0, 0, 0, 0.3);
  }

  .link {
    display: block;

    color: @lib__colors__N700Medium;
    text-decoration: none;
    cursor: pointer;

    &:hover {
      color: black;
      text-decoration: none;
    }
  }

  .selectedLink {
    color: #232627;
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .icon {
    fill: @lib__colors__N700Medium;
  }
}

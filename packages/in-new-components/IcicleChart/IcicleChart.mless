:local {
  .chart {
    position: relative;
    background: #fff;
    font-size: 14px;
  }

  .frame {
    position: absolute;
    background: blue;
    min-width: 3px;
    cursor: pointer;
    border: 1px solid #fff;

    &:hover {
      filter: brightness(0.95);
    }
  }

  .label {
    color: white;
    margin-left: 2px;
    overflow: hidden;
    white-space: nowrap;
  }

  .indicator {
    position: absolute;
    background: red;
    width: 2px;
  }
}

:local {
  .chart {
    position: relative;
    background: #fff;
    margin-bottom: 2rem;
  }

  .frame {
    position: absolute;
    min-width: 3px;
    cursor: pointer;
    border: 1px solid #fff;

    &:hover {
      filter: brightness(0.95);
    }
  }

  .label {
    color: white;
    margin-left: .4rem;
    margin-top: 2px;
    overflow: hidden;
    white-space: nowrap;
  }

  .parentIndicator {
    position: absolute;
    background: red;
    width: 2px;
  }

  .errorIndicator {
    display: flex;
    float: left;
    margin: -0.5rem -0.5rem;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 1px solid #fff;
    font-size: 0.625rem;
    background: #ff5d3b;
    color: white;
  }
}

:local {
  .chart {
    background: #fff;
  }

  .frame {
    position: absolute;
    background: blue;
    min-width: 3px;
    cursor: pointer;
    border: 1px solid #fff;

    .label {
      color: white;
      margin-left: 2px;
      vertical-align: middle;
      overflow: hidden;
    }

    &:hover {
      filter: brightness(0.95);
    }
  }

  .indicator {
    position: absolute;
    background: red;
    width: 2px;
  }
}

:local {
  .chart {
    background: #fff;
    padding: 0.75rem 1.5rem 0;
    margin-bottom: 0.25rem;
    overflow: hidden;
  }

  .frameWrapper {
    margin-top: 1rem;
  }

  .frame {
    position: absolute;
    background: blue;
    min-width: 2px;
    border-radius: 2px;
    cursor: pointer;
    border: 1px solid #fff;

    .label {
      color: white;
      margin-left: 1px;
      vertical-align: middle;
      overflow: hidden;
    }

    &:hover {
      filter: brightness(0.95);
    }
  }
}

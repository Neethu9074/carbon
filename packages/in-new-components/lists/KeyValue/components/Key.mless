@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .label {
    display: block;

    max-width: 100%;

    color: @lib__colors__N600Light;
    font-size: 0.75rem;
    font-weight: 400;
  }

  .ellipsis {
    .ellipsis();
  }

  .multiline {
    white-space: normal;
    word-break: break-word;
  }
}

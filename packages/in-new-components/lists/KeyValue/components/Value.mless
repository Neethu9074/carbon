@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .value {
    display: block;

    max-width: 100%;

    color: @lib__colors__N900Primary;
    font-size: 0.75rem;
    line-height: 0.875rem;
    font-weight: 500;

    .ellipsis();
  }

  .accentuated {
    font-size: 0.875rem;
  }
}

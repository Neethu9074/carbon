@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .value {
    display: block;

    max-width: 100%;

    font-size: 0.75rem;
    font-weight: 500;

    .ellipsis();
  }

  .accentuated {
    font-size: 0.875rem;
  }

  .default {
    color: @lib__colors__N900Primary;
  }

  .blue {
    color: @lib__colors__blue800;
  }
}

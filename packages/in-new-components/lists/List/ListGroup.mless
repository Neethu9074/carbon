@import '~in-themes/active.less';

:local {
  .groupHead {
    border-top: 1px solid @lib__colors__N400;
    margin-bottom: 0.125rem;
    padding: 1.2rem 1rem 0.2rem;

    font-size: 0.75rem;
    font-weight: 500;

    &:first-child {
      border-top: 0;
    }
  }

  .sticky {
    position: sticky;
    top: 0;
    background-color: @lib__colors__white;
    border-bottom: 1px solid @lib__colors__N400;
    padding: 1.2rem 1rem 0.325rem;
    margin-bottom: -1px;
  }

  .moreItems {
    text-indent: 5rem;
  }
}

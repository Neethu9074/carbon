@import '~in-themes/active.less';
@import '~in-new-components/layout/Stack/spacings.less';

:local {
  .list {
    margin: 0;
    padding: 0;

    .spacings();
  }

  .mediumBorderRadius {
    .borderRadius(@lib__shapes__radius_medium);
  }

  .borderRadius(@radius) {
    border-radius: @radius;

    & > .listItem {
      &:first-child {
        border-top-left-radius: @radius;
        border-top-right-radius: @radius;

        & > .itemContent {
          border-top-left-radius: @radius;
          border-top-right-radius: @radius;
        }
      }

      &:last-child {
        border-bottom-left-radius: @radius;
        border-bottom-right-radius: @radius;

        & > .itemContent {
          border-bottom-left-radius: @radius;
          border-bottom-right-radius: @radius;
        }
      }
    }
  }

  .framed {
    border: 1px solid @lib__colors__N400;
  }

  .framedTopBottom {
    border-top: 1px solid @lib__colors__N400;
    border-bottom: 1px solid @lib__colors__N400;
  }

  .frameChildren {
    .frameTableChildren();
  }

  .frameTableChildren() {
    border: 0px solid @lib__colors__N400;

    & > .listItem {
      border: 1px solid @lib__colors__N400;
    }

    & > .listItem {
      border-top: 1px solid @lib__colors__N400;
      border-bottom: 1px solid @lib__colors__N400;
    }
  }

  .frameOnlyChildren {
    border-top: 1px solid @lib__colors__N400;
    border-bottom: 1px solid @lib__colors__N400;
  }

  .listItem {
    display: flex;
    flex-direction: column;
    list-style: none;
    transition: background 0.2s ease-in-out;
    background: @lib__colors__white;

    &:nth-child(even) {
      background: @lib__colors__N050;
    }

    &:nth-child(n + 2) {
      border-top: 1px solid @lib__colors__N400;
    }

    & > .list {
      margin-left: 0.7rem;
      border-top: 0;
      border-bottom: 0;
    }
  }

  .mediumListItemBorderRadius {
    .borderRadius(@lib__shapes__radius_medium);
  }

  .noAlternatingBg {
    &:nth-child(even) {
      background: @lib__colors__white;
    }
  }

  .link {
    &:hover,
    &:focus {
      text-decoration: none;
      background: @lib__colors__faded-blue800;
      // Outline is commonly cut-off. Better implement a manual outline
      // via background color. Not quite as prominent though…
      outline: 0;
    }
  }

  .itemContent {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;

    font-size: 0.875rem;
    color: @lib__colors__N900Primary;
  }

  .itemContentWithNestedContent {
    padding: 0.5rem 1rem;
  }

  .itemContentExpanded {
    border-bottom: 1px solid @lib__colors__N400;
  }

  .compact {
    padding: 0.25rem 0.75rem;
  }

  .borderless {
    padding: 0;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .clickable {
    cursor: pointer;

    &:hover,
    &:focus {
      background: @lib__colors__faded-blue800;
      // Outline is commonly cut-off. Better implement a manual outline
      // via background color. Not quite as prominent though…
      outline: 0;
    }
  }

  .expanded, .active {
    background: @lib__colors__faded-blue800;
    &:nth-child(even) {
      background: @lib__colors__faded-blue800;
    }
  }

  .expandIcon {
    margin-left: 0.5rem;
  }

  .nestedContent {
    padding: 0.75rem 1rem;
  }
}

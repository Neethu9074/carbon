@import '~in-themes/active.less';

:local {
  .list {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .framed {
    border: 1px solid @lib__colors__N400;
  }

  .listItem {
    display: flex;
    flex-direction: column;
    list-style: none;

    transition: background 0.2s ease-in-out;
    background: @lib__colors__white;
    &:nth-child(even) {
      background: @lib__colors__N050;
    }

    &:nth-child(n + 2) {
      border-top: 1px solid @lib__colors__N400;
    }
  }

  .itemContent {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;

    font-size: 0.875rem;
    color: @lib__colors__N900Primary;
  }

  .itemContentWithNestedContent {
    padding: 0.5rem 1rem;
  }

  .itemContentExpanded {
    border-bottom: 1px solid @lib__colors__N400;
  }

  .compact {
    padding: 0.25rem 0.75rem;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .clickable {
    cursor: pointer;

    &:hover {
      background: @lib__colors__faded-blue800;
    }
  }

  .expanded {
    background: @lib__colors__faded-blue800;
    &:nth-child(even) {
      background: @lib__colors__faded-blue800;
    }
  }

  .expandIcon {
    margin-left: 0.5rem;
  }

  .nestedContent {
    padding: 0.75rem 1rem;
  }
}

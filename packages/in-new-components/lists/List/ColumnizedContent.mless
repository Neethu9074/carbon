@import '~in-themes/mixins.less';

:local {
  .flexColumn {
    flex-grow: 1;
    .ellipsis();
  }

  .verticallyCenter {
    display: flex;
    align-items: center;
  }

  .forceMinimumWidth {
    flex-grow: 0;
  }

  .maxHeight {
    align-items: stretch;
  }
}

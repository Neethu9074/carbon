@import '~in-themes/active.less';

:local {
  .buttonGroup {
    display: flex;
    align-items: center;
  }

  .segmented {
    border: 1px solid @lib__colors__N400;
  }

  .button {
    background: #fff;
    color: @lib__colors__N700Medium;
    border-radius: 0;
    cursor: pointer;

    &:hover {
      background: @lib__colors__N300;
      color: @lib__colors__N700Medium;
    }

    & + .button {
      margin-left: 0.25rem;
    }
  }

  .segmented {
    background: @lib__colors__N050;
    color: @lib__colors__N800Dark;
    border: 1px solid @lib__colors__N400;

    svg {
      fill: @lib__colors__N800Dark;
    }

    &:hover {
      border: 1px solid @lib__colors__N500;
      background: @lib__colors__N100;

      svg {
        fill: @lib__colors__N800Dark;
      }
    }

    & + .button {
      margin-left: 0;
    }
  }

  .active {
    background: @lib__colors__light-blue800;
    border: 1px solid @lib__colors__light-blue800;
    color: #fff;

    svg {
      fill: #fff;
    }

    &:hover {
      background: @lib__colors__light-blue800;
      color: #fff;
    }

    &:hover {
      border: 1px solid @lib__colors__light-blue800;
      background: #148cc8;

      svg {
        fill: #fff;
      }
    }
  }

  .first {
    border-top-left-radius: @lib__shapes__radius_medium;
    border-bottom-left-radius: @lib__shapes__radius_medium;
  }

  .last {
    border-top-right-radius: @lib__shapes__radius_medium;
    border-bottom-right-radius: @lib__shapes__radius_medium;
  }
}

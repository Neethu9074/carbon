@import '~in-themes/active.less';

:local {
  .nav {
    font-weight: lighter;
    overflow: hidden;
  }

  .title {
    font-size: 0.875rem;
    text-transform: uppercase;
    margin: 0.25rem 0;
    padding: 0.375rem 0.5rem;
    color: @lib__colors__N500;
  }

  .tabList {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }

  .tab {
    display: flex;
    align-items: center;

    font-size: 0.875rem;
    height: 2.25rem;
    padding: 0.375rem 0.5rem;
    margin: 0.25rem 0;
    border-radius: @lib__shapes__radius_small;

    &:hover {
      color: @lib__colors__N500;
      background: @lib__colors__faded-blue800;

      .icon {
        fill: @lib__colors__N500;
      }
    }
  }

  .tabSelected {
    background: @lib__colors__N600Light;
    color: #fff;
    cursor: default;

    .icon {
      fill: #fff;
    }

    &:hover {
      color: #fff;
      background: @lib__colors__N700Medium;

      .icon {
        fill: #fff;
      }
    }
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N700Medium;
  }

  .link {
    text-decoration: none;
    color: @lib__colors__N700Medium;

    &:hover {
      text-decoration: none;
      color: #fff;
    }
  }
}

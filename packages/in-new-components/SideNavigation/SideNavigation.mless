@import '~in-themes/active.less';

:local {
  .nav {
    font-weight: lighter;
    overflow: hidden;
  }

  .title {
    font-weight: bold;
    margin: 0 0 0.5rem 1rem;
    color: @lib__colors__N500;
  }

  .tabList {
    display: flex;
    flex-direction: column;
    padding: 0 1rem 0 1rem;
  }

  .tab {
    display: flex;
    align-items: center;

    font-size: 0.8rem;
    padding: 0.5rem 1rem;

    &:hover {
      color: @lib__colors__N500;

      .icon {
        fill: @lib__colors__N500;
      }
    }
  }

  .tabSelected {
    background: @lib__colors__N700Medium;
    color: #fff;
    cursor: default;

    .icon {
      fill: #fff;
    }

    &:hover {
      color: #fff;

      .icon {
        fill: #fff;
      }
    }
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N700Medium;
  }

  .link {
    text-decoration: none;
    color: @lib__colors__N700Medium;

    &:hover {
      text-decoration: none;
      color: #fff;
    }
  }
}

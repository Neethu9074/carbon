@import '~in-themes/active.less';

:local {
  .nav {
    overflow: hidden;
  }

  .title {
    font-size: 0.875rem;
    text-transform: uppercase;
    margin: 0.25rem 0;
    padding: 0.375rem 0.5rem;
    color: @lib__colors__N500;
  }

  .tabList {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }

  .tab {
    display: flex;
    align-items: center;

    color: @lib__colors__N700Medium;
    font-size: 0.875rem;
    height: 2.25rem;
    padding: 0.375rem 1rem;
    margin: 0.125rem 0;
    border-radius: @lib__shapes__radius_small;
    cursor: pointer;

    &:hover {
      background: @lib__colors__N300;
    }
  }

  .tabSelected {
    background: @lib__colors__N600Light;
    color: #fff;

    .icon {
      fill: #fff;
    }

    &:hover {
      color: #fff;
      background: @lib__colors__N700Medium;

      .icon {
        fill: #fff;
      }
    }
  }

  .icon {
    margin-right: 0.5rem;
    fill: @lib__colors__N700Medium;
  }

  .link {
    text-decoration: none;
    color: @lib__colors__N700Medium;

    &:hover {
      color: @lib__colors__teal800;
      text-decoration: none;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .animate {
    background-size: 200% 100%;
    animation: indeterminate 5s ease infinite;
  }

  .skeleton {
    background: #f2f2f2;
    background: linear-gradient(90deg, @lib__colors__N200, @lib__colors__N100, @lib__colors__N200);
    .animate();
  }

  .lightMode {
    background: @lib__colors__white;
    background: linear-gradient(90deg, @lib__colors__N050, @lib__colors__white, @lib__colors__N050);
    opacity: 0.7;
    .animate();
  }

  @keyframes indeterminate {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
}

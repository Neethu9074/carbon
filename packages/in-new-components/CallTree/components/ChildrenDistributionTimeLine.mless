:local {
  .childrenDistributionTimeLine {
    position: relative;

    min-width: 61.8%;
    max-width: 61.8%;
    height: 1.3125rem;
  }

  .line {
    position: absolute;
    top: 0.625rem;
    left: 0;
    right: 0;

    border-bottom: 1px solid #d5dfe4;
  }

  .childSpanIndicator,
  .spanIndicator {
    position: absolute;

    min-width: 1px;
  }

  .spanIndicator {
    top: 0.4375rem;

    height: 0.4375rem;
  }

  .childSpanIndicator {
    top: 0.9375rem;

    height: 0.25rem;
    opacity: 0.5;
    cursor: pointer;

    &:hover {
      opacity: 1;
    }
  }

  .networkTime {
    position: absolute;
    top: 0;

    height: 0.4375rem;
  }

  .networkTimeBar {
    width: 100%;
    height: 0.4375rem;
    opacity: 0.25;
  }

  .spanDuration {
    padding: 0 0.25rem;
    font-size: 0.875rem;
    color: #16363e;
    background: white;
  }

  .spanDurationWrapper {
    position: absolute;
    top: -0.25rem;
  }

  .leftAlignedSpanDurationWrapper {
    left: 100%;
  }

  .rightAlignedSpanDurationWrapper {
    left: 0;
  }

  .leftAlignedSpanDuration {
    margin-left: 0.25rem;
  }

  .rightAlignedSpanDuration {
    margin-right: 0.25rem;
    margin-left: -100%;
    width: 100%;
  }

  .errorIndicator {
    position: absolute;
    top: -1.5rem;
    left: 0;
  }
}

@import '~in-themes/active.less';

:local {
  .label {
    font-size: 0.875rem;
    margin-bottom: 0;
    margin-top: 0.375rem;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    align-items: center;
  }

  .aggregations {
    background-color: @lib__colors__white;
  }
}

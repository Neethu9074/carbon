@import '~in-themes/active.less';

:local {
  .useTransition {
    transition: 0.5s ease-in-out;
  }

  .container {
    position: relative;
    overflow-x: hidden;
  }

  .content {
    // Create a new stacking context: The content must be positioned underneath the header
    // underneath the slide in content
    z-index: 1;
  }

  .header {
    position: absolute;
    top: 0;
    width: 100%;

    background: @lib__colors__white;
    z-index: 3;

    visibility: hidden;
    transition: visibility 0.1s 0.3s;
  }

  .slideIn.header {
    visibility: visible;
    transition: unset;
  }

  .inputBlocker {
    position: absolute;
    z-index: 2;
    top: 5rem;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0);
    pointer-events: none;
    .useTransition();
  }

  .slider {
    position: absolute;
    background: @lib__colors__white;
    z-index: 3;
    box-shadow: -5px 0 5px -5px rgba(0, 0, 0, 0);
    height: calc(100% - 5rem);
    top: 5rem;
    right: -100%;
    white-space: nowrap;
    width: 100%;
    .useTransition();
    transition-property: box-shadow 0.1s 0.5s, transform;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .slideIn {
    &.inputBlocker {
      pointer-events: all;
      background: rgba(0, 0, 0, 0.25);
    }

    &.slider {
      transform: translateX(-100%);
      width: 100%;
      box-shadow: -5px 0 5px -5px rgba(0, 0, 0, 0.24);
    }
  }
}

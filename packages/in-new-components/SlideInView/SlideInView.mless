@import '~in-themes/active.less';

:local {
  .container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow-x: hidden;
  }

  .staticContent {
    // Create a new stacking context: The content must be positioned underneath the header
    // underneath the slide in content
    z-index: 1;
  }

  .enforceMaxHeightForStaticContent {
    max-height: 100%;
    overflow: auto;
  }

  .inputBlocker {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    transition: background 0.5s ease-in-out;
  }

  .header {
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    right: 0;
  }

  .slideInContent {
    position: absolute;
    z-index: 3;
    width: 100%;
    right: -100%;
    top: 0;
    bottom: 0;
    background: @lib__colors__white;
    transition: box-shadow 0.1s 0.5s ease-in-out, transform 0.5s ease-in-out;
    transform: translateX(0%);
    box-shadow: -5px 0 5px -5px rgba(0, 0, 0, 0);
    overflow-x: hidden;
    overflow-y: auto;
  }
}

@import '~in-themes/active.less';

:local {
  .useTransition {
    transition: 0.5s ease-in-out;
  }

  .container {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    position: absolute;
    top: 0;
    width: 100%;

    background: @lib__colors__white;
    border-radius: @lib__shapes__radius_small @lib__shapes__radius_small 0 0;
    height: 5rem;
    padding: 1.5rem;
    z-index: @z-index__dialog;

    visibility: hidden;
    transition: visibility 0.1s 0.3s;
  }

  .scrollShadow {
    box-shadow: @lib__shadows__subtle;
  }

  .slideIn.header {
    visibility: visible;
    transition: unset;
  }

  .titleContainer {
    display: flex;
    align-items: center;
  }

  .title {
    color: @lib__colors__N800Dark;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 2rem;
    margin-bottom: 0;
  }

  .mainContentWrapper {
    background: @lib__colors__white;
  }

  .mainContentInner {
    background: rgba(0, 0, 0, 0.25);
  }

  .mainContent {
    .useTransition();
  }

  .slideIn.mainContent {
    opacity: 0.25;
  }

  .slider {
    position: absolute;
    background: @lib__colors__white;
    box-shadow: -5px 0 5px -5px rgba(0, 0, 0, 0);
    height: calc(100% - 5rem);
    margin-top: 5rem;
    right: -100%;
    white-space: nowrap;
    width: 100%;
    z-index: @z-index__dialog;
    .useTransition();
    transition-property: box-shadow 0.1s 0.5s, transform;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .slideIn.slider {
    transform: translateX(-100%);
    width: 100%;
    box-shadow: -5px 0 5px -5px rgba(0, 0, 0, 0.24);
  }
}

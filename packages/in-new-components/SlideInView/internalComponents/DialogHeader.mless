@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    background: @lib__colors__white;
    border-radius: @lib__shapes__radius_small @lib__shapes__radius_small 0 0;
    height: 5rem;
    padding: 1.5rem;
  }

  .scrollShadow {
    box-shadow: @lib__shadows__subtle;
  }

  .titleContainer {
    display: flex;
    align-items: center;
  }

  .title {
    color: @lib__colors__N800Dark;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 2rem;
    margin-bottom: 0;
  }
}

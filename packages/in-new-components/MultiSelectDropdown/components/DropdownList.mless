@import '~in-themes/active.less';

:local {

  .dropdownList {
    position: absolute;
    background: @lib__colors__white;
    z-index: 4;
    width: 12rem;
    padding: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.161);
    border-radius: @lib__shapes__radius_medium;
    box-shadow: @lib__shadows__strong;
  }

  .rowWrapper {
  
  }

  .selectAllButton {
    font-size: 0.75rem;
    margin-left: -0.625rem;
  }

  .setButton {
    float: right;
    margin-top: -0.125rem;
    margin-right: -0.625rem;
  }
}

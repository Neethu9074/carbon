@import '~in-themes/active.less';

:local {

  .dropdownButton {
    color: black;
    font-family: @font-family-sans-serif;
    font-size: 0.875rem;
    border-radius: @lib__shapes__radius_small;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    &:hover,
    &:focus {
      text-decoration: none;
      outline: 0;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .dropdown {
    display: block;
  }

  .dropdownList {
    position: absolute;
    background: @lib__colors__white;
    z-index: @z-index__overlays;
    width: 12rem;
    padding: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.161);
    border-radius: @lib__shapes__radius_medium;
    box-shadow: @lib__shadows__strong;
  }

  .dropdownButton {
    color: black;
    font-family: @font-family-sans-serif;
    font-size: 0.875rem;
    border-radius: @lib__shapes__radius_small;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    &:hover,
    &:focus {
      text-decoration: none;
      outline: 0;
    }
  }

  .selectAllButton {
    font-size: 0.75rem;
    margin-left: -0.625rem;
  }

  .setButton {
    float: right;
    margin-top: -0.125rem;
    margin-right: -0.625rem;
  }
}

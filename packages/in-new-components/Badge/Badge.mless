:local {
  .badge {
    display: inline-block;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    vertical-align: baseline;

    border: 1px solid;
  }

  .mid {
    font-weight: 700;
    padding: 0.25rem 0.375rem 0.1875rem;
    font-size: 0.75rem;
    border-radius: 0.1875rem;
  }

  .sm {
    padding: 0.0625rem 0.3125rem 0.125rem;
    font-size: 0.6875rem;
    border-radius: 0.125rem;
    font-weight: 500;
  }
}

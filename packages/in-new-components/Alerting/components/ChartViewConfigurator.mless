@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .container {
    height: min-content;
  }

  .headerTransparent {
    background-color: transparent;
  }

  .headline {
    color: @lib__colors__N700Medium;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
    margin: 0;
  }
}

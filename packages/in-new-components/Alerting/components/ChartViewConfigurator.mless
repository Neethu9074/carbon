@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .container {
    height: min-content;
  }

  .defaultSize {
    margin-top: 1rem;
    height: 21rem;
  }

  .withSelection {
    margin-top: 1rem;
    height: 23rem;
  }

  .headerTransparent {
    background-color: transparent;
  }
}

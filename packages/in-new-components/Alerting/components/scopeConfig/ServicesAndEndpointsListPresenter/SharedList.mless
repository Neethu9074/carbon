@import '~in-themes/active.less';

:local {
  .greyCheckbox {
    filter: grayscale(100%);
  }

  .last {
    animation: highlight 1000ms ease-out;
  }

  @keyframes highlight {
    0% {
      background-color: @lib__colors__light-blue800;
    }
    100% {
      background-color: white;
    }
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .item {
    display: flex;
    flex-direction: column;
  }

  .selectedItem {
    font-weight: bold;
  }

  .createdDate {
    color: @lib__colors__N500;
  }

  .changeDescription {
    display: flex;
    align-items: center;

    color: @lib__colors__N500;
    padding-top: 2px;
    font-size: 12px;
  }

  .icon {
    margin-right: 0.25rem;
    fill: @lib__colors__N600Light;
  }
}

@import '~in-themes/active.less';

:local {
  .container {
    display: grid;
    grid-column-gap: 1rem;
    grid-template-areas: 'content sideNav';
    grid-template-columns: 5fr 1fr;
    height: 100%;
  }

  .scrollWrapper {
    overflow: auto;
    grid-area: content;
  }

  .content {
    border-right: 1px solid @lib__colors__N300;
    padding-right: 0.875rem;
    min-height: 720px;
  }

  .sideNav {
    grid-area: sideNav;
  }

  .controls {
    display: flex;
    justify-content: center;
    margin-top: 3.75rem;
    grid-column-start: 1;
    grid-column-end: -1;
    margin: 0 -1.5rem -1.5rem -1.5rem;
    padding: 1rem 0;
    background-color: @lib__colors__N100;
    border-top: 1px solid @lib__colors__N300;
    max-height: 4.0625rem;
  }

  .button {
    width: 6.25rem;
  }

  .title {
    color: @lib__colors__N900Primary;
    font-size: @lib__typography__h200__font-size;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .divider {
    background-color: @lib__colors__N200;
    border-radius: @lib__shapes__radius_small;
    height: 0.25rem;
    margin: 2rem auto 1rem auto;
    width: 16.875rem;
  }

  .icon {
    background-color: @lib__colors__N400;
    border-radius: 50%;
    margin-left: 0.5rem;
    fill: @lib__colors__white;

    &.checked {
      background-color: @lib__colors__teal800;
      color: @lib__colors__teal800;
    }
  }
}

:local {
  .metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .metric {
    margin: 0 1rem;
  }

  .metricLink {
    text-decoration: none;
    color: #47626a;
    font-size: 0.875rem;
  }

  .active {
    color: #0c1415;
    text-decoration: underline;
  }

  .noDataFound {
    margin: 1rem;
  }
}

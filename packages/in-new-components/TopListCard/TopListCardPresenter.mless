@import '~in-themes/active.less';

:local {
  .metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .metric {
    margin-right: 0.5rem;
  }

  .active {
    color: #fff;
    background: @lib__colors__light-blue800;

    &:hover {
      color: #fff;
      background: @lib__colors__light-blue800;
      cursor: default;
    }
  }
}

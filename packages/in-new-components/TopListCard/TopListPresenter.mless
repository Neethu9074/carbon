:local {
  .topList {
    width: 100%;
    padding: 0 1rem;

    & ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }

  .viewAll {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1em;

    .viewAllInner {
      margin-right: 1em;
    }

    & a {
      font-size: 14px;
      color: #1fb7B9;
      line-height: 1rem;
    }
  }
}

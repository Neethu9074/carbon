@import '~in-themes/active.less';

:local {
  .topListRow {
    margin-bottom: 1rem;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .titles {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bar {
    position: relative;
    width: 100%;
    height: 0.1875rem;
    margin: 0.25rem 0 1.5rem 0;
    background: @lib__colors__N300;
    border-radius: 0.125rem;
  }

  .barInner {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    border-radius: 0.125rem 0 0 0.125rem;
  }

  .hairLine {
    position: absolute;
    width: 1px;
    height: 12px;
    left: -1px;
  }

  .contributedContentLeftAligned,
  .contributedContentRightAligned {
    position: absolute;
    top: 0.25rem;
  }

  .contributedContentLeftAligned {
    left: 0.25rem;
  }

  .contributedContentRightAligned {
    right: 0.25rem;
  }

  .label {
    margin-right: 1rem;

    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;

    font-size: 0.875rem;
    color: @lib__colors__N700Medium;
  }

  .metric {
    font-size: 0.875rem;
    font-weight: 600;
    color: @lib__colors__N900Primary;
  }
}

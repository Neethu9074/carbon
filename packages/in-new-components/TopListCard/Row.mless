:local {
  .topListRow {
    margin-bottom: 1rem;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .titles {
    display: flex;
    justify-content: space-between;
    align-items: center;

    color: #0c1415;
    font-weight: 400;
    font-size: 0.75rem;
  }

  .bar {
    position: relative;
    width: 100%;
    height: 0.25rem;
    margin: 0.3438rem 0 0.3rem 0;
    background: #e8eef0;
    overflow: hidden;
    border-radius: 0.125rem;
  }

  .barInner {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    background: #4bc4ff;
    border-radius: 0.125rem 0 0 0.125rem;
  }
}

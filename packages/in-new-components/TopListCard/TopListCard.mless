:local {
  .topListCardActions {
    color: pink;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    align-items: center;

    & li {
      display: inline-block;
      margin-right: 1rem;
    }
  }

  .tabLikeButton {
    padding-left: 0;
    padding-right: 0;
    background: none;
    border: none;
    font-weight: normal;
    font-size: inherit;
  }
}

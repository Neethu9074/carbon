@import '~in-themes/active.less';

:local {
  .topListWrapper {
    width: 100%;
  }

  .topList {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .label {
    font-size: 0.875rem;
    font-weight: 400;
    text-decoration: none;

    transition: color 0.25s ease-in-out;
  }
}

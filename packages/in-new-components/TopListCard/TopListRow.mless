:local {
  .topListRow {
    margin: 1rem 0;
  }

  .titles {
    display: flex;
    justify-content: space-between;
  }

  .title {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    color: #16363E;
    font-weight: 600;
    font-size: .875rem;
  }

  .bar {
    position: relative;
    width: 100%;
    height: 0.25rem;
    margin: .75rem 0 0.3rem 0;
    background: #e8eff0;
    overflow: hidden;
    border-radius: 2px;
  }

  .barInner {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    background: #5DD8EF;
    border-radius: 2px 0 0 2px;
  }

  .metric {
    color: #16363E;
    font-weight: 600;
    font-size: .875rem;
  }
}

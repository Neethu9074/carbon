:local {
  .topListRow {
    margin: 1rem 0;
  }

  .titles {
    display: flex;
    justify-content: space-between;
  }

  .bar {
    position: relative;
    width: 100%;
    height: 0.25rem;
    margin: .75rem 0 0.3rem 0;
    background: #e8eff0;
    overflow: hidden;
    border-radius: 2px;
  }

  .barInner {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    height: 0.25rem;
    background: #00aed9;
    opacity: 0.5;
    border: 1px solid #979797;
    border-radius: 2px 0 0 2px;
  }
}

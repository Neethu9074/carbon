@import '~in-themes/active.less';

:local {
  .configurator {
    display: inline-flex;
    justify-content: space-between;
  }

  .select {
    &:hover,
    &:active,
    &:focus {
      outline: none;
    }
    &:hover {
      z-index: 2; // this is done in order to display border-right
    }
  }

  .selectButton {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }

  .sorting {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;

    &:hover {
      z-index: 1; // this is done in order to display border-right
    }
    margin-left: -1px; // this is done in order to display border-left

    &:hover,
    &:active,
    &:focus {
      outline: none;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .configurator {
    display: inline-flex;
    justify-content: space-between;
  }

  .select {
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;

    &:hover,
    &:active,
    &:focus {
      outline: none;
    }
    &:hover {
      z-index: 2; // this is done in order to display border-right
    }
  }

  .sorting {
    border-radius: 0px;

    &:hover {
      z-index: 1; // this is done in order to display border-right
    }
    margin-left: -1px; // this is done in order to display border-left

    &:hover,
    &:active,
    &:focus {
      outline: none;
    }
  }
}

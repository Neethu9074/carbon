@import '~in-themes/active.less';

:local {
  .menu {
    max-width: 12.5rem;
    max-height: 31.25rem;
    overflow: hidden auto;
    margin: 0;
    padding: 0;
    list-style: none;
    background: @lib__colors__white;
    box-shadow: @lib__shadows__pronounced;
  }
}

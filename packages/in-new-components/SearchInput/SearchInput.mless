@import '~in-themes/active.less';

:local {
  .wrapper {
    position: relative;
    width: 100%;
  }

  .icon {
    position: absolute;
    right: 0;
    top: 0.25rem;

    fill: @lib__colors__N500;
    margin-right: 0.25rem;
  }

  .searchInput {
    width: 100%;
    border: 1px solid @lib__colors__N400;
  }

  .searchInputHasText + svg {
    display: none;
  }

  .hasError {
    background: #ff40401f;
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    border: 1px solid @lib__colors__N400;
    background: @lib__colors__N050;
  }

  .icon {
    fill: @lib__colors__N500;
    margin-right: 0.5rem;
  }

  .searchInput {
    width: 100%;
    border: none;
    &:focus {
      outline: none;
    }
  }

  .hasError {
    background: #ff40401f;
  }

  .hasFocus {
    .browserDefaultFocusStyles();
  }
}

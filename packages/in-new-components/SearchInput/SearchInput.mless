@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;

    border: 1px solid @lib__colors__N400;
    border-radius: @lib__shapes__radius_small;
    background-color: @lib__colors__N050;
  }

  .searchInput {
    border: 0;
    width: 104px;

    &:focus {
      width: 142px;
    }
  }

  .icon {
    fill: @lib__colors__primary1;
    margin: 0 0.25rem;
  }
}

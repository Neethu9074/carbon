@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
    border: 1px solid @lib__colors__N400;
    background: @lib__colors__N050;
    width: 100%;
    padding: 2px;
  }

  .wrapperDisabled {
    cursor: not-allowed;
  }

  .icon {
    fill: @lib__colors__N500;
    margin-right: 0.5rem;
    margin-left: auto;
  }

  .withoutIcon {
    fill: @lib__colors__N400;
  }

  .searchInput {
    width: 100%;
    min-width: 0; // allow flex-item to shrink below it's "default" width

    border: none;
    &:focus {
      outline: none;
    }
  }

  .hasError {
    background: #ff40401f;
  }

  .useTransparency {
    background: transparent;
  }

  .hasFocus {
    .browserDefaultFocusStyles();
  }
}

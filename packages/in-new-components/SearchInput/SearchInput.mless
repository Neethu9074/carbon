@import '~in-themes/active.less';

:local {
  .wrapper {
    position: relative;
    width: 100%;
  }

  .searchInput {
    width: 100%;

    padding-right: 2rem;

    border: 1px solid @lib__colors__N400;
  }

  .icon {
    position: absolute;
    right: 0;
    top: 0.25rem;

    fill: @lib__colors__primary1;
    margin: 0 0.25rem;
  }
}

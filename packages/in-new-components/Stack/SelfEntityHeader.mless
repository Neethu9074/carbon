@import '~in-themes/active.less';

:local {
  .entity {
    display: flex;
    align-items: center;

    padding: 0.375rem 1rem;
    width: 100%;

    background: @lib__colors__N700Medium;
    border-bottom: 1px solid @lib__colors__N400;
    cursor: pointer;

    &:hover {
      background: @lib__colors__N500;
    }
  }

  .icon {
    fill: @lib__colors__white;
    margin-right: 0.5rem;
  }

  .label {
    color: @lib__colors__white;
  }
}

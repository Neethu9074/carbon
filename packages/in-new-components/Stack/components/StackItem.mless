@import '~in-themes/active.less';

:local {
  .icon {
    margin-left: 0.25rem;
    fill: @lib__colors__N600Light;
  }

  .itemWrapper {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
  }

  .label {
    display: flex;
    align-items: center;
  }

  .chartWrapper {
    display: flex;
    flex-direction: row;
    align-items: center;

    & > div {
      padding-left: 1rem;
    }
  }

  .profileIcon {
    margin-left: 0.25rem;
    fill: @lib__colors__N600Light;
  }
}

@import '~in-themes/active.less';

:local {
  .emptyPane {
    align-items: center;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: center;
  }

  .emptyMessage {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 0.25rem;
  }

  .detailMessage {
    font-size: 1rem;
    margin-top: 0.5rem;
    color: @lib__colors__N600Light;
  }
}
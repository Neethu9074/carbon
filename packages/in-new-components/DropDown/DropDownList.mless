@import '~in-themes/active.less';

:local {
  .wrapper {
    position: absolute;
    top: ~'calc(100% + 0.25rem)';
    left: 0;
    right: 0;

    padding: 0.5rem;

    background: #fff;
    box-shadow: @lib__shadows__subtle;
  }

  .list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    margin: 0;
    padding: 0;
  }

  .item {
    display: flex;
    align-items: center;
    justify-content: flex-start;

    width: 100%;

    padding: 0.5rem 2.5rem 0.5rem 0.5rem;

    list-style: none;
    background: #fff;
    cursor: pointer;

    &:hover {
      background: @lib__colors__N100;
    }
  }
}

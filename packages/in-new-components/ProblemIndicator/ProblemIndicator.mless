@import '~in-themes/active.less';

:local {
  .wrapper {
    padding: 0.5rem 1rem;
    border-radius: @lib__shapes__radius_small;
  }

  .header {
    display: flex;
    align-items: center;
  }

  .icon {
    border-radius: @lib__shapes__radius_small;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 .5rem 0 0;
    width: 1.375rem;
    height: 1.375rem;
    font-size: 1rem;
  }

  .title {
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }

  .description {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .danger {
    &.wrapper {
      background-color: #fdf4f9;
    }

    .icon {
      background-color: @lib__colors__failure;
      color: #fff;
    }

    .title {
      color: @lib__colors__failure;
    }
  }

  .warning {
    &.wrapper {
      background-color: #fff9e5;
    }

    .icon {
      background-color: @lib__colors__warning;
      color: @lib__colors__N900Primary;
    }

    .title {
      color: #ebb800;
    }
  }
}

@import '~in-themes/active.less';

:local {
  .mouseEventsWrapper {
    display: inline-block;
    height: 100%;
  }

  .toggleButton {
    height: 100%;
    line-height: 1rem;
    padding: 0 1.4rem 0 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-family: @font-family-sans-serif;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;

    cursor: pointer;

    &:hover,
    &:focus {
      text-decoration: none;
      outline: 0;
    }

    & + .toggleButton {
      margin-left: 0.5rem;
    }
  }

  .icon {
    margin-left: 0;
    margin-right: 0.25rem;
    fill: @lib__colors__N800Dark;
  }

  .iconLight {
    fill: #fff;
  }

  .on {
    opacity: 1;
    color: @lib__colors__green800;

    .icon {
      fill: @lib__colors__green800;
    }
  }

  .off {
    color: @lib__colors__N800Dark;

    &.hover:not(.disabled) {
      color: @lib__colors__N600Light;
    }
  }

  .offLight {
    color: #fff;

    &.hover:not(.disabled) {
      color: @lib__colors__N600Light;
    }
  }

  .disabled,
  .disabled:focus,
  .disabled:hover {
    cursor: not-allowed;
  }
}

@import '~in-themes/active.less';

:local {
  .InMapOverlaycontrols {
    position: absolute;
    bottom: 1.25rem;
    right: 1.25rem;
    display: flex;
    align-items: flex-end;
    transition: bottom 0.25s ease-in-out;
  }
}

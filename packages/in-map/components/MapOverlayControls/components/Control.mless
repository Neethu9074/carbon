:local {
  .inControl {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ids-color-option-neutral-500);
    transition: background 0.25s ease-in-out;

    &:hover {
      background: var(--ids-color-option-teal-400);

      svg {
        fill: var(--ids-color-option-neutral-800) !important;
      }
    }
  }

  .inControlActive {
    background: var(--ids-color-option-white);

    svg {
      fill: var(--ids-color-option-neutral-800) !important;
    }
  }
}

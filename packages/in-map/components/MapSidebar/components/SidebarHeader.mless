@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .sidebarHeader {
    padding: 0 0 1rem 0;
  }
  .entity {
    display: flex;
    align-items: flex-start;
  }

  .entityIcon {
    margin: 0.25rem 0.75rem 0 0;
    fill: @lib__colors__N900Primary;
  }

  .entityLabel {
    word-break: break-all;
    font-size: 0.875rem;
    font-weight: normal;
    color: @lib__colors__N900Primary;
    margin: 0 0 0.4rem;
    // word-break: break-all;
  }

  .entityType {
    font-size: 0.75rem;
    color: @lib__colors__N600Light;
    margin: 0 0.35rem 0 0;
  }

  .typeIdWrapper {
    word-break: break-all;
    line-height: 1.8;
  }
}

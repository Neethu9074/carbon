:local {
  .sidebarHeader {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1rem;
    box-sizing: border-box;

    background: var(--ids-color-option-neutral-50);
    border-top-left-radius: 0.125rem;
    border-top-right-radius: 0.125rem;
  }
}

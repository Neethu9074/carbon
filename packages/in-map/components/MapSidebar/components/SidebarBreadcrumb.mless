:local {
  .sidebarBreadcrumb {
    position: absolute;
    top: 0;
    left: 26.3rem;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 2.25rem;

    background: #fff;
    border-radius: var(--ids-border-radius-option-small);
  }

  .crumb {
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1rem;
  }

  .crumbLink {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  .crumbIcon {
    opacity: 0.5;
    fill: var(--ids-color-option-neutral-700);

    &:hover {
      opacity: 1;
      fill: var(--ids-color-option-blue-500);
    }
  }
  .crumbIconSelected {
    opacity: 1;
    fill: var(--ids-color-option-blue-500);
  }
}

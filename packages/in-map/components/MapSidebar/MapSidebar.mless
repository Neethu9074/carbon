:local {
  .mapSidebar {
    position: absolute;
    top: 14.6rem;
    left: 2.6rem;
    width: 20.5rem;
    background: #fff;
    border-radius: var(--ids-border-radius-option-small);
    max-height: ~'calc(100vh - 200px)';
  }

  .scrollWrapper {
    overflow-y: auto;
    overflow-x: hidden;
    & > div {
      width: 20.5rem;
    }

    &NoBanner {
      max-height: ~'calc(100vh - 400px)';
    }
    &Banner {
      max-height: ~'calc(100vh - 446px)';
    }
  }
}

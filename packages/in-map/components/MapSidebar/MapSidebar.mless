:local {
  .mapSidebar {
    position: absolute;
    top: 12rem;
    left: 2.6rem;
    width: 20.5rem;
    background: #fff;
    border-radius: 0.125rem;
  }
  .scrollWrapper {
    overflow-y: auto;
    overflow-x: hidden;

    & > div {
      width: 20.5rem;
    }
  }
}

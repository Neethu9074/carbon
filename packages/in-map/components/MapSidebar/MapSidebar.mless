:local {
  .mapSidebar {
    position: absolute;
    top: 14.6rem;
    left: 2.6rem;
    width: 20.5rem;
    background: #fff;
    border-radius: 0.125rem;
    max-height: ~'calc(100vh - 200px)';
  }
  .scrollWrapper {
    overflow-y: auto;
    overflow-x: hidden;
    max-height: ~'calc(100vh - 400px)';

    & > div {
      width: 20.5rem;
    }
  }
}

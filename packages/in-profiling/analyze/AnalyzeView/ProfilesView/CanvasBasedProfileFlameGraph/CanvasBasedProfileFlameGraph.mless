:local {
  .wrapper {
    width: 100%;
  }

  .canvasWrapper {
    position: relative;
  }

  .canvas {
    position: absolute;
    display: block;
    max-width: 100%;
  }

  .resetButton,
  .resetButtonPlaceholder {
    margin-bottom: 1px;
  }

  .resetButton {
    width: 100%;
  }

  .controlButton {
    margin-bottom: 0.5rem;
    height: 2.125rem;
  }

  .resetButtonPlaceholder {
    height: 1.5rem;
  }
}

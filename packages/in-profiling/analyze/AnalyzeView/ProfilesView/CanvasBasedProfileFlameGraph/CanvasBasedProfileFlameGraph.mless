@import '~in-themes/active.less';

:local {
  .wrapper {
    width: 100%;
  }

  .canvasWrapper {
    position: relative;
  }

  .canvas {
    display: block;
    max-width: 100%;
  }

  .button {
    & + .button {
      margin-left: 0;
    }
  }

  .resetButton,
  .resetButtonPlaceholder {
    margin-bottom: 1px;
  }

  .resetButton {
    width: 100%;
  }

  .controlButton {
    margin-bottom: 0.25rem;
    height: 2.125rem;
  }

  .resetButtonPlaceholder {
    height: 1.5rem;
  }
}

@import '~in-themes/active.less';

:local {
  .profile {
    padding: 0.5rem 0 0.5rem 0.5rem;

    border-top: 1px solid @lib__colors__N300;
    border-left: 1px solid @lib__colors__N300;
    border-right: 1px solid @lib__colors__N300;
    overflow-x: auto;

    &:last-child {
      border-bottom: 1px solid @lib__colors__N300;
    }

    &:nth-child(odd) {
      background: @lib__colors__N100;
    }
  }
}

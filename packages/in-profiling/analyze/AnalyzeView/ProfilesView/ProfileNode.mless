@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .row {
    .flexbox();
    padding: 0.3125rem 0 0.25rem;
  }

  .expandedRow {
    position: relative;

    &::before {
      position: absolute;
      top: -0.375rem;
      left: -0.5rem;

      width: 0.5rem;
      height: 1.25rem;

      border-bottom: 1px solid @lib__colors__N400;
      border-left: 1px solid @lib__colors__N400;
      content: '';
    }
  }

  .selectedRow {
    background: @lib__colors__N200;
  }

  .highlightedRow {
    background: @lib__colors__primary1;
  }

  .nonHighlightedRow {
    transition: background 5s;
  }

  .childrenWrapper {
    padding-left: 1rem;
  }

  .children {
    position: relative;
  }

  .verticalLine {
    position: absolute;
    top: -0.375rem;
    bottom: 0;
    width: 1px;
    left: -0.5rem;
    background: @lib__colors__N400;
  }

  .expandIcon {
    margin-right: 0.5rem;
    fill: @lib__colors__primary1;
  }

  .focusedIcon {
    fill: @lib__colors__cyan800;
  }

  .iconPlaceHolder {
    width: 1.625rem;
    height: 0.25rem;
    margin-right: 0.125rem;
  }

  .iconPlaceHolderWithLine {
    border-bottom: 1px solid @lib__colors__N400;
  }
}

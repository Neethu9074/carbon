:local {
  .line {
    display: flex;
    justify-content: space-between;

    padding: 0.25rem 0;
  }

  .signature {
    overflow: hidden;
  }

  .selectedLine {
    background: var(--ids-color-option-neutral-300);
  }

  .icon {
    fill: var(--ids-color-option-neutral-700);
  }

  .iconPlaceholder {
    min-width: 1rem;
  }

  .percent {
    margin-left: 0.25rem;

    color: var(--ids-color-option-neutral-500);
  }
}

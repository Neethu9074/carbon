@import '~in-themes/active.less';
:local {
  .line {
    display: flex;
    justify-content: space-between;

    padding: 0.25rem 0;
  }

  .signature {
    overflow: hidden;
  }

  .selectedLine {
    background: @lib__colors__N300;
  }

  .icon {
    fill: @lib__colors__N700Medium;
  }

  .iconPlaceholder {
    min-width: 1rem;
  }

  .percent {
    margin-left: 0.25rem;

    color: @lib__colors__N500;
  }
}

:local {
  .content {
    margin: 0 -1rem;
  }

  .hotspotLine {
    position: relative;
    height: 2rem;
  }

  .item {
    position: absolute;
    top: 0;
    height: 2rem;
    border: 1px solid transparent;
  }

  .item:hover {
    border: 1px dashed var(--ids-color-option-neutral-500);
  }

  .timeselectionIndicator {
    background: none;
  }

  .contentLoadingWrapper {
    justify-content: center;
  }
}

@import '~in-themes/active.less';

:local {
  .closeIcon {
    cursor: pointer;
    fill: @lib__colors__N500;
    display: block;
    margin: 0 0 0 0.5rem;

    &:hover {
      fill: @lib__colors__N700Medium;
    }
  }

  .contextLink {
    font-size: inherit;
    color: var(--colors-gray-600) !important;
    // needs important, - else gets overruled by of :visited, or :active styling
  }
}

:local {
  .closeIcon {
    cursor: pointer;
    fill: var(--ids-color-option-neutral-500);
    display: block;
    margin: 0 0 0 0.5rem;

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .contextLink {
    font-size: inherit;
    color: var(--ids-color-option-neutral-600) !important;
    // needs important, - else gets overruled by of :visited, or :active styling
  }
}

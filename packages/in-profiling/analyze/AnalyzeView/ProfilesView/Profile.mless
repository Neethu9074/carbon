@import '~in-themes/mixins.less';

:local {
  .header {
    .spaceBetweenFlexbox();
    margin-bottom: 1rem;
  }

  .leftSide {
    .flexbox();
  }

  .graphButton {
    margin-left: 1rem;
  }

  .icon {
    fill: var(--ids-color-option-neutral-500);
  }

  .numProfilesLabel {
    margin: 0 0.25rem 0 1.5rem;

    font-size: 0.875rem;
    color: var(--ids-color-option-neutral-600);
  }

  .searchInput {
    margin-left: 0.5rem;
  }

  .flameGraphContent {
    width: 100%;
  }

  .treeContent {
    width: max-content;
    min-width: 100%;
  }

  .timeselectionIndicator {
    margin-bottom: 1rem;

    border: 1px solid var(--ids-color-option-neutral-300);
  }

  .infiniteCircle {
    background: none;
  }

  .contentLoadingWrapper {
    justify-content: center;
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .header {
    padding: 1rem 1rem 0;
    background: @lib__colors__white;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .flexWrapper {
    .spaceBetweenFlexbox();

    width: 100%;
    padding: 0.5rem 0;
  }

  .icon {
    fill: @lib__colors__N500;
  }

  .treeContent,
  .flameGraphContent {
    padding: 0 1rem;
  }

  .flameGraphContent {
    width: 100%;
  }

  .treeContent {
    width: max-content;
  }
}

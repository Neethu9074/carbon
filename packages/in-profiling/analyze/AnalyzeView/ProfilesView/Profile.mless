@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .header {
    .spaceBetweenFlexbox();
    margin-bottom: 1rem;
  }

  .leftSide {
    .flexbox();
  }

  .graphButton {
    margin-left: 1rem;
  }

  .icon {
    fill: @lib__colors__N500;
  }

  .numProfilesLabel {
    margin: 0 0.25rem 0 1.5rem;

    font-size: 0.875rem;
    color: @lib__colors__N600Light;
  }

  .searchInput {
    margin-left: 0.5rem;
  }

  .flameGraphContent {
    width: 100%;
  }

  .treeContent {
    width: max-content;
    min-width: 100%;
  }

  .timeselectionIndicator {
    margin-bottom: 1rem;

    border: 1px solid @lib__colors__N300;
  }

  .infiniteCircle {
    background: none;
  }

  .contentLoadingWrapper {
    justify-content: center;
  }
}

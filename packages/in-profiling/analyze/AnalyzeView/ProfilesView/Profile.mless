@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .header {
    background: @lib__colors__white;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .firstRow {
    .spaceBetweenFlexbox();
    margin-bottom: 1rem;
  }

  .secondRow {
    .flexbox();
    margin-bottom: 0.5rem;
  }

  .icon {
    fill: @lib__colors__N500;
  }

  .treeContent,
  .flameGraphContent {
    padding: 0 1rem;
  }

  .flameGraphContent {
    width: 100%;
  }

  .treeContent {
    width: max-content;
  }
}

@import '~in-themes/mixins.less';

:local {
  .percentWrapper,
  .percent {
    .flexbox();

    height: 0.5rem;
    border-radius: 0.25rem;
  }

  .percentWrapper {
    width: 6.25rem;

    margin-right: 0.5rem;

    background: var(--ids-color-option-neutral-300);
    overflow: hidden;
  }

  .percent {
    background: var(--ids-color-option-blue-500);
  }

  .percentLabel {
    width: 3.75rem;
    color: var(--ids-color-option-neutral-700);
  }
}

@import '~in-themes/active.less';

:local {
  .profilesIndicatorWrapper {
    display: flex;
    align-items: flex-end;

    margin: 0 60px 0.75rem 0;
  }

  .profilesLabel {
    // must be in px because of alignment with the chart axis width which is always 60px
    min-width: 52px;
    max-width: 52px;
    margin-right: 8px;

    color: @lib__colors__N700Medium;
    font-size: 0.75rem;
    line-height: 0.625rem;
    text-align: end;
  }

  .bucketsWrapper {
    position: relative;

    width: 100%;
    height: 16px;

    border-top: 1px solid @lib__colors__N300;
    border-bottom: 1px solid @lib__colors__N400;
    overflow-x: hidden;
  }

  .profilesIndicator {
    position: absolute;
    bottom: 0;

    background: @lib__colors__blue800;
  }

  .tooltipTimeRow {
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .duration {
    color: @lib__colors__N600Light;
    margin-left: 0.25rem;
  }

  .numProfiles {
    font-weight: bold;
  }
}

:local {
  .popover-content {
    padding: 2rem;
    width: 250px;
  }

  .filter-label {
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .options-container {
    max-height: 200px;
    overflow-y: auto;
  }

  .button-container {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
  }
}

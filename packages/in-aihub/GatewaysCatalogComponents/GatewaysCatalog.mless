:local {
  .status-section {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
  }

  .status-section-title {
    font-size: var(--cds-heading-03-font-size, 1.25rem);
    font-weight: var(--cds-heading-03-font-weight, 400);
    line-height: var(--cds-heading-03-line-height, 1.4);
    letter-spacing: var(--cds-heading-03-letter-spacing, 0);
    padding: 1rem;
    padding-bottom: 0px;
  }

  .status-tile {
    padding: 0;
  }

  .status-tile-content {
    display: flex;
    width: 100%;
  }

  .active-button {
    background-color: #e0e0e0;
    color: #0f62fe;
    font-weight: 600;
  }

  .status-tile-item {
    flex: 1;
    cursor: pointer;
    transition: all 0.2s;
    padding: 1.5rem 2rem;
    text-align: left;

    .status-tile-label {
      font-size: 0.875rem;
      margin-bottom: 0.5rem;
      color: #525252;
    }

    .status-tile-count {
      font-family: IBM Plex Sans;
      font-weight: 300;
      font-size: 42px;
    }
    .status-tile-button {
      position: relative;
      right: 2rem;
    }
  }

  #gateways-table-container {
    min-height: 420px;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;

    .popover-open {
      .panel--container {
        opacity: 1;
        transform: translateX(0px);
      }
      :global(.cds--data-table-content),
      .table-skeleton,
      :global(.cds--pagination) {
        width: calc(100% - 336px);
        transform: translateX(336px);
      }
    }

    .filter--panel__close-wrapper:global(.cds--popover-container):not(:global(.cds--popover--auto-align)) {
      position: absolute;
      right: 0;
    }

    .filter--panel__close {
      position: relative;
    }

    .table-skeleton {
      margin-top: 1rem;
      transition: width 0.25s ease, transform 0.25s ease;
    }

    .empty-table-wrapper {
      height: 100%;
    }

    .empty-table-body {
      height: 100%;
    }

    .empty-table {
      padding: 2rem;
    }

    .table-fixed-layout {
      table-layout: fixed;
      transition: width 0.25s ease, transform 0.25s ease;
    }

    .empty-column {
      width: 3rem;
    }

    .filter-button-container:global(.cds--popover-container) {
      position: absolute;
      left: 0;
    }

    .toolbar-content {
      padding-left: 3rem;
    }

    :global(.cds--data-table) {
      tbody.empty-table-body {
        tr {
          height: 14rem;
          td {
            display: flex;
            align-items: flex-start;
            padding-top: 2rem;
            border-block-end: 0;
          }
        }
        &,
        tr:not([data-child-row]):hover,
        tr[data-child-row]:hover > td {
          background-color: transparent;
        }
      }

      &.empty-table-wrapper tbody {
        th,
        tr:hover td {
          border-block-end: 0;
        }
      }

      td .empty-table {
        position: absolute;
        max-width: 265px;
      }

      .tableRowItem {
        overflow: hidden;
        text-overflow: ellipsis;
      }
    }

    each(range(1%, 100%, 1), {
      .w-@{index} {
        width: @value;
      }
    });
    :global(.cds--table-sort.cds--table-sort--active) {
      width: 100%;
    }
  }
}

:local {
  .measure-tags {
    position: absolute;
    overflow: hidden;
    inset: -100vh 0 0 -100vw;
    max-inline-size: 100vw;
    pointer-events: none;
    visibility: hidden;
    display: flex; // Ensures single line overflow measurement
  }

  .filter--summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--cds-border-subtle);
  }

  .filter--summary-tag-and-overflow-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-grow: 1;
    margin-right: 1rem;
  }

  .filter-overflow-popover {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background-color: var(--cds-background-inverse);
    color: var(--cds-text-inverse);
    gap: 0.5rem;
  }
}

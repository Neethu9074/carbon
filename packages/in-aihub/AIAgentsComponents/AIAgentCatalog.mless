:local {
  .ai-agents-placeholder {
    padding: 2rem;
    text-align: center;
    background-color: var(--cds-layer);
    border-radius: 0.5rem;
    margin: 2rem 0;
  }

  .ai-agents-placeholder h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .ai-agents-placeholder p {
    color: var(--cds-text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }
}

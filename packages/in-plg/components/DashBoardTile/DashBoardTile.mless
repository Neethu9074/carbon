:local {
  .dashboardtile {
    &.cds--tile {
      background: var(--cds-layer-01);
      padding: 0;
    }
    .headerWrapper {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      .typography {
        color: var(--cds-tag-color-gray);
      }
    }
    .dragHandleIcon {
      cursor: grab;
    }
  }
}

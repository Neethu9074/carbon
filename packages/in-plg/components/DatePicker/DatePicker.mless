:local {
  .static:hover,
  .live {
    border-color: var(--ids-color-option-neutral-500);
  }

  .static:hover {
    background: var(--ids-color-option-neutral-100);
  }

  .live,
  .live:hover {
    background: var(--ids-color-option-neutral-500);
    color: var(--ids-color-option-white);

    svg {
      fill: var(--ids-color-option-white);
    }
  }
  .static,
  .live {
    border-radius: 0 var(--ids-border-radius-option-small) var(--ids-border-radius-option-small) 0;
  }
  .liveIcon {
    margin-left: 0.75rem;
  }
  .carbonLive,
  .carbonStatic {
    padding: 0.75rem 1rem;
  }
}

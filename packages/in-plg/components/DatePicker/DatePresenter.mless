:local {
  .carbonTimePicker {
    margin-right: -1px;
    height: 3rem;
    z-index: 1;
  }
  .carbonDisplayTimeWrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: -0.5rem;
  }
  .carbonTimeSetting {
    font-size: 0.875rem;
  }
  .carbonTimeSettingTop {
    font-size: 0.75rem;
  }
}

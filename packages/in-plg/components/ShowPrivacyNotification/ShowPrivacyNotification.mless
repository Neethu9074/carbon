:local {
  .title {
    color: var(--ids-color-option-white);
    font-weight: bold;
    font-size: 1rem;
  }
  .description {
    color: var(--ids-color-option-white);
    font-size: 0.875rem;
  }
  .notification {
    margin-top: 2rem;
    margin-left: 17.5rem;
    position: absolute;
  }
}

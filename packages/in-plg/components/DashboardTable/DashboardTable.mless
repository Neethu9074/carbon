:local {
  .noDatatile {
    width: 100%;
    padding: 2.5rem 2rem 2.5rem;
    :global(.c4p--empty-state__content) {
      width: 15.5rem;
    }
  }
  .addMoreButton {
    border-block-end: 1px solid var(--Border-border-strong-01, #8d8d8d);
  }
  .plgTableSearchBox {
    :global(.cds--search-input) {
      border-block-end: 1px solid var(--Border-border-strong-01, #8d8d8d);
    }
  }
  td.noDataTileCell,
  tbody tr:hover td.noDataTileCell {
    background: var(--cds-layer);
    border-block-end: none;
    border-block-start: none;
    padding-inline: 0;
  }
}

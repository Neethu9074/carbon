:local {
  .headerItemTile {
    width: 12.5rem;
    height: 11rem;
    padding: initial;
    > a {
      text-decoration: none;
    }
  }
  .tileButton {
    position: absolute;
    bottom: 0;
    width: 100%;
  }
  .tileGhostButton {
    left: -1rem;
  }
}

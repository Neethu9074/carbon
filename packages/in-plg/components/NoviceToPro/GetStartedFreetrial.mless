:local {
  .fullScreenModal {
    :global {
      .cds--modal-container.cds--modal-container--sm {
        max-height: none;
        width: 100vw;
        max-width: none;
      }
    }
  }
  .progressIndicator {
    padding-top: var(--cds-spacing-06);
    width: calc(var(--cds-spacing-11) * 11);
  }
  .spacing {
    margin-top: var(--cds-spacing-10);
  }
  .textWrapper {
    display: flex;
    width: 100%;
  }
  .text {
    width: 50%;
  }
  .imageWrapper {
    width: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 70%;
    overflow: hidden;
  }
  .image {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
  }
}

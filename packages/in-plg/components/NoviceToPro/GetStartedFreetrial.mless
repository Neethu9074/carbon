:local {
  .fullScreenModal {
    :global {
      .cds--modal-container.cds--modal-container--sm {
        max-height: none;
        width: 100vw;
        max-width: none;
      }
    }
  }
  .progressIndicator {
    padding-top: var(--cds-spacing-06);
    width: calc(var(--cds-spacing-11) * 11);
  }
  .radioTileSize {
    height: 230px;
  }
  .spacing {
    margin-top: var(--cds-spacing-10);
  }
  .textWrapper {
    display: flex;
    width: 100%;
  }
  .tileContent {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }
  .grid {
    gap: var(--cds-spacing-03);
    padding: var(--cds-spacing-05);
  }
  .text {
    width: 50%;
  }
  .roleSelector {
    display: flex;
    width: 100%;
  }
  .stepOne {
    width: 60%;
  }
  .imageWrapper {
    width: 40%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: var(--cds-spacing-12);
  }
  .image {
    width: 100%;
    max-width: 473px;
    object-fit: contain;
  }
  .text {
    word-break: auto-phrase;
  }
}

:local {
  .fullScreenModal {
    :global {
      .cds--modal-container.cds--modal-container--sm {
        max-height: none;
        width: 100vw;
        max-width: none;
      }
      .cds--modal-content.c4p--tearsheet__body {
        overflow: hidden;
      }
    }
  }
  .progressIndicator {
    padding-top: var(--cds-spacing-06);
    width: calc(var(--cds-spacing-11) * 11);
  }
  .imageWrapper {
    width: 40%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: var(--cds-spacing-12);
  }
  .roleSelector {
    display: flex;
    width: 100%;
    height: calc(var(--cds-spacing-11) * 5);
  }
  .stepOne {
    width: 60%;
  }
  .image {
    min-height: 100%;
    min-width: 70%;
    object-fit: contain;
  }
}

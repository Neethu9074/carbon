:local {
  .toolbar {
    border-block-end: 1px solid var(--cds-border-subtle);
    padding-inline-end: var(--cds-grid-margin);
    padding-top: 1rem;
  }

  .toolbarbottom {
    padding-bottom: 1rem;
  }
  .title {
    padding-left: 2.5rem;
  }
}

:local {
  .input {
    user-select: none;
    pointer-events: none;
  }
  .inputSmall {
    min-width: 15rem;
  }
  .inputLarge {
    min-width: 30rem;
  }
  .fullWidth {
    width: 100%;
  }
  .button {
    &:focus {
      outline: none; // Button with onClick property is showing an outline.
    }
  }
}

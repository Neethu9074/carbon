:local {
  .carbonColumn {
    margin-top: 0.5rem;
    margin-right: 0.5rem;
  }
  .carbonAccordionItem {
    .grid {
      padding: 0;
    }
    :global {
      .cds--accordion__heading {
        padding-right: 0; // Removes the right padding on the toggle button.
        .cds--accordion__title {
          padding-inline-start: 0; // Removes the left padding on the accordion title.
        }
      }
      .cds--accordion__content {
        padding: 0; // Removes the x-axis padding on the content.
      }
    }
  }
}

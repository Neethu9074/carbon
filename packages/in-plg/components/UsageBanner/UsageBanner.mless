:local {
  .section {
    z-index: 8001;
    position: fixed;
    right: 0px;
    margin-top: -3rem;
  }
  .description p {
    color: var(--ids-color-option-white);
    font-size: var(--cds-body-01-font-size);
    margin: auto;
    line-height: 1.25rem;
  }
  .verticalLine {
    width: 0.09rem;
    height: 1.5rem;
    background: var(--ids-color-option-neutral-600);
  }
  .bannerLink {
    // color: var(--ids-color-option-blue-400);
    text-decoration: underline;
  }
  .subText {
    margin-right: 0.75rem;
    margin-top: 0.5rem;
    font-size: 15px;
    font-weight: 500;
    color: var(--ids-color-option-white);
  }
}

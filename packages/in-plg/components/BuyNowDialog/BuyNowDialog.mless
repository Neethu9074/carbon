:local {
  .dialog {
    width: 63%;
    .allDialogcontent {
      padding: 0 1.5rem;
    }
  }
  .mainBodyDialog {
    width: 75%;
    margin: 2.5rem 0;
    border-right: 1px solid var(--ids-color-option-neutral-400);
  }
  .sidePanelDialog {
    width: 25%;
    margin: 2.5rem 0;
  }
  .mainBodyContent {
    width: 90%;
  }
  .dialogButton,
  a.dialogButton {
    min-width: calc(100% / 3);
    height: 4rem;
    position: sticky;
    bottom: 0;
    background-color: var(--ids-color-option-white);

    &.primaryButton {
      background-color: var(--cds-link-primary);
    }
  }
  a.dialogButton {
    text-decoration: none;
  }

  .tableContent {
    width: 30%;
  }
}

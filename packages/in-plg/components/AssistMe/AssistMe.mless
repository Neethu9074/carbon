:local {
  .button {
    color: var(--cds-icon-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .button :global(.cds--btn__icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
  }
}

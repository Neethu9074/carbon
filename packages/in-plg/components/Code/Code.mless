:local {
  .wrapper {
    width: 100%; //fix the code component size issue
    pre {
      margin-bottom: 0rem !important; //fix the show more button styling
    }
    button {
      box-shadow: none !important; // removes the drop shadow present under the "Show more" button
    }
  }
}

:local {
  .sidePanel {
    border-left: 1px solid var(--ids-color-option-neutral-400);
    width: 30%;
    display: flex;
    flex: 0 0 auto;
    margin-top: 10px;
  }
  .container {
    display: flex;
  }
  .mainContent {
    flex: 1 1 auto;
  }
  a.playWithButton {
    text-decoration: none;
  }
  .sidePanelBorder {
    border-bottom: 1px solid var(--ids-color-option-neutral-400);
    padding-bottom: 1.25rem;
  }
}

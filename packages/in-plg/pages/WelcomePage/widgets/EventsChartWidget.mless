:local {
  .eventsChartWrapper {
    overflow-x: hidden;
    padding: 1rem;
  }

  .eventsChartBottomSection {
    width: 100%;
    border-block-start: 1px solid var(--cds-layer-active-01);
  }

  .viewAllButtonArrowIcon {
    margin-left: 0.5rem;
    align-self: center;
  }

  a.eventButtonWrapper {
    text-decoration: none;
  }
  .noDataTile {
    width: 100%;
    padding: 2.5rem 2rem 2.5rem;
    :global(.c4p--empty-state__content) {
      width: 15.5rem;
    }
  }
}

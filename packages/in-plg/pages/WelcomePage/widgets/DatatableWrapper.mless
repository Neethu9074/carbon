:local {
  .dataTableWrapper {
    :global {
      .dashboardTable {
        table {
          table-layout: fixed;
          // The last <th> where favourites is present.
          th:last-child:not(:has(*)) {
            width: 1rem;
          }
          .favouriteIcon {
            position: relative;
            padding-inline-end: 8px;
            div {
              float: right;
            }
          }
        }
      }
    }
    // These style should be placed after the above "table-layout" as it needs to override it.
    &.noData {
      :global {
        .dashboardTable {
          table {
            table-layout: auto;
          }
        }
      }
    }
  }
}

:local {
  .tileGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, auto));
    gap: 1.5rem;
    margin-left: 1rem;
    margin-right: 1.5rem;
    position: relative;
  }

  .arrowIcon {
    font-size: 1.25rem;
    position: absolute;
    right: 1rem;
    bottom: 1rem;
  }
  .cardWrapper {
    position: relative;
  }
}

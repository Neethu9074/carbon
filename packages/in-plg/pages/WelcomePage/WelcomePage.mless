:local {
  .container {
    margin: 3rem 0 0;
    :global {
      // Address the outline issue in favourite icon
      button.cds--btn--ghost[aria-label='lib_actions_favorite_filled']:focus,
      button.cds--btn--ghost[aria-label='lib_actions_favorite']:focus {
        border-color: transparent;
        box-shadow: none;
        outline: none;
      }
    }
  }
}

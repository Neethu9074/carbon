:local {
  .quickLinksWrapperStyle {
    padding-bottom: 1rem;
    .buttonWithSeparator {
      align-items: center;
      gap: 0.5rem;
      margin-left: 0;
      text-decoration: none;
      &::after {
        content: '';
        position: absolute;
        right: -1px;
        top: 25%;
        bottom: 25%;
        width: 1px;
        background-color: var(--Border-border-strong-01, #8d8d8d);
      }

      &:last-child::after {
        display: none;
      }
    }
  }
}

:local {
  .playWithInstana {
    width: stretch;
    height: 57px;
    display: flex;
    background: rgb(23, 161, 230);
    z-index: 125;
    color: white !important;
    align-items: center;
    width: 100%;

    .headerHeading {
      flex-grow: 1;
      margin-left: 100px;
      color: white !important;
      h2 {
        color: white;
      }
    }

    .readyToMonitor {
      margin-right: 12px;
      font-size: 0.875rem;
      span {
        color: white;
      }
    }

    .buttonFreeTrial {
      width: 100px;
      margin-right: 12px;
      font-weight: bold;
    }
    .buttonDemo {
      margin-right: 24px;
    }
  }
  .newPlayWithInstana {
    width: stretch;
    display: flex;
    z-index: 8003;
    align-items: center;
    right: 0px !important;
    top: 0px !important;
    position: fixed;
  }
}

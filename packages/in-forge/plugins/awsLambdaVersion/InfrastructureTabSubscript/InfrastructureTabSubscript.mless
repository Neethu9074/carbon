@import '~in-themes/mixins.less';

:local {
  .infrastructureTabSubscript {
    color: var(--ids-color-option-neutral-500);
    font-size: 0.75rem;
    max-width: 32rem;
    .ellipsis();
  }

  .entityLink {
    color: var(--ids-color-option-neutral-500);
  }

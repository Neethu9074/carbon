@import '~in-themes/mixins.less';

:local {
  .infrastructureTabSubscript {
    color: var(--ids-color-option-neutral-500);
    font-size: 0.75rem;
    max-width: 32rem;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    .ellipsis();
  }

  .entityLink {
    color: var(--ids-color-option-neutral-500);
  }

  .entitiyIcon {
    margin: 0 0.125rem;
    fill: var(--ids-color-option-neutral-500);
    vertical-align: middle;
  }
}

:local {
  .wrapper:hover .showLongVariantOnHover {
    .action {
      display: inline-flex;
    }

    .actionIcon {
      display: none;
    }
  }

  .action {
    display: none;
    margin: -4px 0;
  }

  .actionIcon {
    fill: var(--ids-color-option-neutral-600);
    cursor: pointer;
  }
}

@import '~in-themes/active.less';

:local {
  .agentManagementContent {
    display: flex;
    color: @lib__colors__N600Light;
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .agentManagementDescription {
    max-width: 40rem;
    margin: 0 1.75rem 0 0;

    & > :first-child {
      margin-top: 0;
    }
  }
}

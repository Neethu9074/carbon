:local {
  .agentManagementContent {
    display: flex;
    color: var(--ids-color-option-neutral-600);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .agentManagementDescription {
    max-width: 40rem;
    margin: 0 1.75rem 0 0;

    & > :first-child {
      margin-top: 0;
    }
  }

  .kpiGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, auto));
    gap: 16px 0px;
    width: 100%;
    box-sizing: border-box;
  }
}

:local {
  .wrapper {
    display: flex;
    flex-wrap: wrap;
    margin-top: -0.5rem;
    margin-left: -0.5rem;
  }

  .wrapper > button {
    margin-top: 0.5rem;
    margin-left: 0.5rem;
  }

  .wrapper > a {
    margin-top: 0.5rem;
    margin-left: 0.5rem;
  }
}

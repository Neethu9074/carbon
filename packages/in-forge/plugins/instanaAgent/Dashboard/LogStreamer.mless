:local {
  .log {
    overflow: auto;
    max-height: 37rem;
    display: block;
    border-radius: var(--ids-border-radius-option-small);
    ::-webkit-scrollbar {
      height: 48px;
    }
  }

  pre {
    margin: 0;
    width: 100%;
  }

  .autoScroll {
    display: inline-flex;
    align-items: center;
    margin: 0 0 1rem 2rem;
  }

  .copyButton {
    float: right;
    position: relative;
    inset-block-end: calc(var(--cds-spacing-05) * -1);
    inset-inline-end: calc(var(--cds-spacing-03) * -1);
  }
}

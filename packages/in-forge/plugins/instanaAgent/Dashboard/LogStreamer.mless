:local {
  .log {
    font-family: Menlo, Monaco, Consolas, 'Courier New', monospace;
    line-height: 1.4;
    font-size: 0.688rem;

    overflow: auto;
    max-height: 37rem;
    display: block;
    background: #172429;
    padding: 0.5rem 0.6rem;
    border-radius: 2px;

    &::-webkit-scrollbar {
      -webkit-appearance: none;
      width: 8px;
      height: 8px;
    }
    &::-webkit-scrollbar-thumb {
      border-radius: 3px;
      background-color: #43565e;
      -webkit-box-shadow: 0 0 1px rgba(255, 255, 255, 0.5);
    }
  }

  .autoScroll {
    display: inline-flex;
    align-items: center;
    margin: 0 0 1rem 2rem;
  }

  .toggle {
    margin-left: 8px;
  }
}

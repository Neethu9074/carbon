:local {
  .wrapper {
    display: flex;
    align-items: center;
  }

  .link {
    display: flex;
    align-items: center;
  }

  .icon {
    margin-left: 0.125rem;
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-500);
  }
}

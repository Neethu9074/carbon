@import '~in-themes/mixins.less';

:local {
  .key,
  .value {
    width: 50%;
    .ellipsis();
  }

  .key {
    text-align: left;
  }

  .value {
    text-align: right;
  }

  .root {
    position: relative;
  }

  .root:hover .clipboard {
    display: block;
  }

  .clipboard {
    display: none;
    position: absolute;
    right: 0.5rem;
  }

  .tagsCard {
    margin-top: 1.5rem;
  }
}

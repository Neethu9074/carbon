:local {
  .fullViewWrapper {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--ids-color-option-neutral-900);
    overflow-y: auto;
  }
}

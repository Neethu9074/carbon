@import '~in-themes/active.less';

:local {
  .wrapper {
    padding: 1rem 1rem 1rem 1.5rem;

    background: @lib__colors__white;
  }

  .heading {
    margin-bottom: 1rem;

    font-size: 1.5rem;
    color: @lib__colors__N700Medium;
  }

  .contentWithNavigation {
    display: flex;
  }

  .navigationWrapper {
    width: 16rem;
  }

  .content {
    display: flex;
    flex-direction: column;

    width: 100%;
    max-height: 41rem;
    min-height: 41rem;

    padding: 0 1rem 0 2rem;

    overflow-y: auto;
  }
}

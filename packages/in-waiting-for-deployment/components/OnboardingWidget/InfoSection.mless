:local {
  .section {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.5rem 1rem 0.5rem 0.75rem;

    background: var(--ids-color-option-blue-500);
  }

  .leftContent {
    display: flex;
    align-items: center;
  }

  .rightContent {
    display: flex;
    align-items: center;
  }

  .icon {
    margin-right: 0.75rem;
    fill: var(--ids-color-option-white);
  }

  .description {
    margin-right: 2rem;

    font-size: 1rem;
    color: var(--ids-color-option-white);
    white-space: nowrap;
  }

  .subText {
    margin-right: 0.75rem;

    font-size: 0.875rem;
    font-style: italic;
    font-weight: 200;
    color: var(--ids-color-option-white);
  }

  .button {
    width: 12.5rem;
    justify-content: flex-start;
  }
}

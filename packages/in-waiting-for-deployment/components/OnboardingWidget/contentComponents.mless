@import '~in-themes/active.less';

:local {
  .description {
    margin-top: 0;
    font-size: 0.8125rem;
    color: @lib__colors__N700Medium;
  }

  .checkbox,
  .description,
  .row,
  .helpBox,
  .input,
  .textWithLink {
    margin-bottom: 0.5rem;
  }

  .input,
  .dropDown {
    min-width: 15rem;
  }

  .dropDown {
    & + .dropDown {
      margin-left: 0.5rem;
    }
  }

  .helpBox {
    padding: 0.75rem;

    background: @lib__colors__N200;
    color: @lib__colors__N600Light;
  }

  .helpBoxTitle {
    margin-top: 0;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .list {
    margin: 0;
    padding: 0 0 0 1.5rem;
  }

  .textWithLink {
    font-size: 0.8125rem;
    line-height: 1rem;
    color: @lib__colors__N700Medium;
  }

  .row {
    display: flex;
    align-items: center;
  }

  .rowItem {
    & + .rowItem {
      margin-left: 0.5rem;
    }
  }

  .dialog {
    width: 50rem;
    max-width: 50rem;
  }

  .dialogHeader {
    display: flex;
    align-items: center;
  }

  .closeIcon {
    cursor: pointer;
    fill: @lib__colors__N500;
    margin-left: 0.5rem;
    &:hover {
      fill: @lib__colors__N700Medium;
    }
  }
}

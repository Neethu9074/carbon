:local {
  .carbonSection {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem 0.75rem 0.5rem;
    // use correct token after G10 theme is implemented
    background: var(--cds-link-primary);
  }

  .leftContent {
    display: flex;
    align-items: center;
    margin-left: 0.5rem;
  }

  .description {
    font-size: 1rem;
    line-height: 1.5rem;
    color: var(--ids-color-option-white);
    white-space: nowrap;
  }
}

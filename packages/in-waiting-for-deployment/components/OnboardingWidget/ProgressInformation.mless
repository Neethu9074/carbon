:local {
  .wrapper {
    display: flex;
    align-items: center;
  }

  .goToInstanceButtonCarbon {
    margin-left: 1rem;
    :global(.cds--g90) {
      background-color: transparent;
    }
  }

  .stepsWithProgressBar {
    display: flex;
    flex-direction: column;
  }

  .steps {
    display: flex;
    align-items: center;

    margin-bottom: 0.5rem;
  }

  .step {
    display: flex;
    align-items: center;
    flex-direction: column;

    margin: 0 0.5rem;
    width: 4rem;
  }

  .stepSpacer {
    height: 3.5rem;
    width: 1px;

    margin: 0 1rem;

    background: var(--ids-color-option-white);
    opacity: 0.5;
  }

  .icon {
    fill: var(--ids-color-option-white);
    margin-bottom: 0.25rem;
  }

  .stepText {
    text-align: center;
    line-height: 1rem;
    color: var(--ids-color-option-white);
  }

  .progressBarWrapper {
    position: relative;

    height: 0.25rem;

    margin: 0 0.25rem;

    background: var(--ids-color-option-white);
  }

  .progressBar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
  }

  .progressBar0 {
    width: 20%;
    background: var(--ids-color-option-orange-500);
  }

  .progressBar50 {
    width: 50%;
    background: var(--ids-color-option-yellow-500);
  }

  .progressBar100 {
    width: 100%;
    background: var(--ids-color-option-green-500);
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    display: flex;
    align-items: center;
  }

  .goToInstanceButton {
    justify-content: flex-start;

    margin-left: 1rem;

    width: 12.5rem;
  }

  .stepsWithProgressBar {
    display: flex;
    flex-direction: column;
  }

  .steps {
    display: flex;
    align-items: center;

    margin-bottom: 0.5rem;
  }

  .step {
    display: flex;
    align-items: center;
    flex-direction: column;

    margin: 0 0.5rem;
    width: 4rem;
  }

  .stepSpacer {
    height: 3.5rem;
    width: 1px;

    margin: 0 1rem;

    background: @lib__colors__white;
    opacity: 0.5;
  }

  .icon {
    fill: @lib__colors__white;
    margin-bottom: 0.25rem;
  }

  .stepText {
    text-align: center;
    line-height: 1rem;
    color: @lib__colors__white;
  }

  .progressBarWrapper {
    position: relative;

    height: 0.25rem;

    margin: 0 0.25rem;

    background: @lib__colors__white;
  }

  .progressBar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
  }

  .progressBar0 {
    width: 20%;
    background: @lib__colors__orange800;
  }

  .progressBar50 {
    width: 50%;
    background: @lib__colors__yellow800;
  }

  .progressBar100 {
    width: 100%;
    background: @lib__colors__success;
  }
}

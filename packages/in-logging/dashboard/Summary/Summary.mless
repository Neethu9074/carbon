:local {
  .dashboardContainer {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 0 2rem 2rem 2rem;
  }
  .charts {
    display: flex;
    flex-direction: column;
    gap: 2rem;

    :global {
      .carbon-card-wrapper {
        padding: 2rem;
      }
    }
  }
}

:local {
  .content {
    margin: 0 2rem;
  }

  .crumbs {
    padding: 1.5rem 2rem 0;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .layout {
    margin: 0 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, 22rem);
    grid-template-rows: repeat(3, auto);
    gap: 2rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;

    span {
      font-weight: 700;
    }
  }

  .navButton {
    display: flex;
    justify-content: right;
    margin-top: auto;
  }

  .pictogramWrapper {
    padding: 1rem;
  }
}

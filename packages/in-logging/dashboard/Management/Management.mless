:local {
  .content {
    margin: 0 2rem;
  }

  .crumbs {
    padding: 0rem 2rem 2rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .popHoverContainer {
    > span {
      font-weight: 400;
      font-size: 14px;
      line-height: 18px;
      letter-spacing: 0.16px;
      color: var(--ids-color-option-neutral-500);
    }

    > p {
      white-space: pre-line;
    }

    > h1 {
      padding-top: 1rem;
      font-size: 26px;
      line-height: 36px;
      letter-spacing: 0px;
    }
  }

  .layout {
    margin: 0 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, 22rem);
    grid-template-rows: repeat(3, 16rem);
    gap: 2rem;
  }

  .card {
    display: grid;
    grid-template:
      'description description'
      'pictogram button';
    flex-direction: column;
    gap: 1rem;
    height: 100%;
  }

  .description {
    grid-area: description;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .navButton {
    grid-area: button;
    display: flex;
    justify-content: right;
    margin-top: auto;

    svg {
      max-width: 1.25rem;
      max-height: 1.25rem;
    }
  }

  .pictogramWrapper {
    grid-area: pictogram;
    display: flex;
    justify-content: flex-start;
    align-items: flex-end;

    svg {
      width: 3.5rem;
      height: 3.5rem;
    }
  }
}

@import '~in-themes/mixins.less';

:local {
  .logDetails {
    min-height: 100%;
    padding: 0.5rem 0.125rem;
    overflow: hidden;
  }

  .title {
    width: 100%;
    display: flex;
    gap: 0.5rem;

    header {
      width: 100%;
      display: flex;
      gap: 0.5rem;
      flex-direction: column;
      overflow: hidden;

      span {
        .ellipsis();
      }
    }
  }
  .justTitle {
    background-color: var(--ids-color-option-neutral-50);
    padding: 1.5rem;
  }
  .minusMargin {
    margin-top: -1.5rem;
  }

  .titleLevel {
    font-weight: bold;
    font-size: 0.875rem;
    line-height: 0.75rem;
  }
}

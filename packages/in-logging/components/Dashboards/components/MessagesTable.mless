:local {
  .noLink {
    cursor: not-allowed;
    color: var(--ids-color-option-neutral-500);
  }

  .analyzeButton {
    margin-right: 0.5rem;
  }

  .italic {
    font-style: italic;
  }

  .logLevelPill {
    width: 100%;
  }

  .logLevelPillCell {
    span {
      display: grid;
      place-items: center;
    }
  }

  .headCell {
    white-space: nowrap;
  }
}

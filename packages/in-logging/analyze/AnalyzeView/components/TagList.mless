@import '~in-themes/mixins.less';
@import '~in-themes/active.less';
:local {
  .tag {
    padding: 0.125rem 0.5rem;

    background: @lib__colors__N100;
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_medium;
    font-size: 0.8125rem;

    margin-bottom: 0.25rem;
    margin-right: 0.25rem;
  }

  .button {
    padding: 0.1875rem 0.75rem;
    margin-bottom: 0.25rem;
  }

  .icon {
    padding-bottom: 0.25rem;
  }

  .loadingIcon {
    fill: @lib__colors__light-blue800;
  }

  .link {
    overflow: hidden;

    &:hover {
      text-decoration: none;
    }
  }

  .clickable {
    &:hover {
      background: @lib__colors__N300;
      cursor: pointer;
    }
  }

  .dot {
    margin-right: 0.5rem;
  }

  .label {
    white-space: nowrap;
  }

  .label,
  .equals,
  .value {
    line-height: 1rem;
  }

  .label,
  .equals {
    color: @lib__colors__N500;
  }

  .equals {
    margin: 0 0.125rem;
  }

  .value {
    .ellipsis();
    color: @lib__colors__N900Primary;
  }
}

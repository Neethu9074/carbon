@import '~in-themes/mixins.less';
@import '~in-themes/active.less';
:local {
  .tag {
    padding: 0.125rem 0.5rem;

    background: @lib__colors__N100;
    border: 1px solid @lib__colors__N300;
    border-radius: @lib__shapes__radius_medium;
    font-size: 0.8125rem;

    & + .tag {
      margin-left: 0.5rem;
    }
  }

  .link {
    &:hover {
      text-decoration: none;
    }

    & + .link {
      margin-left: 0.5rem;
    }
  }

  .clickable {
    &:hover {
      background: @lib__colors__N300;
      cursor: pointer;
    }
  }

  .dot {
    margin-right: 0.5rem;
  }

  .label,
  .equals,
  .value {
    line-height: 1rem;
  }

  .label,
  .equals {
    color: @lib__colors__N500;
  }

  .equals {
    margin: 0 0.125rem;
  }

  .value {
    .ellipsis();
    color: @lib__colors__N900Primary;
  }
}

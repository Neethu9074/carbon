@import '~in-themes/mixins.less';

:local {
  .type {
    font-weight: 600;
    margin: 0.75rem 1rem 0.75rem 0;
  }

  .message {
    .ellipsis();
    margin: 0.75rem 0;

    &:hover {
      text-decoration: underline;
      cursor: pointer;
    }
  }
}

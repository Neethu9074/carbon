:local {
  .loadingWrapper {
    display: flex;
    justify-content: center;
  }

  .listItem {
    align-items: stretch;
    :global .li-actions {
      justify-content: flex-start;
      align-items: flex-start;
      button {
        margin: 0;
      }

      svg {
        margin: 0.25rem 0.3125rem;
      }
    }
  }

  .dateTime {
    margin: 0.7rem 0 0.7rem 0;
  }

  .healthColumn {
    margin: 0.4rem 1rem 0.4rem 0;
  }

  .squareHover:before {
    border-radius: var(--ids-border-radius-option-small) !important;
  }
  .squareHover:focus {
    border-radius: var(--ids-border-radius-option-small);
  }

  .centeredCopyButtonWrapper {
    margin-top: 4px;
    display: flex;
    align-items: flex-start;
    height: 100%;
  }

  .removeBackground {
    :global {
      .li-nestedContent {
        background: white !important;
      }
    }
  }
}

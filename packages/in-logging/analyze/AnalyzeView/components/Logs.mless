:local {
  .loadingWrapper {
    display: flex;
    justify-content: center;
  }

  .listItem {
    align-items: stretch;
    :global .li-actions {
      padding: 0.125rem 0;
      display: flex;
      justify-content: flex-start;
      align-items: flex-start;
      svg {
        margin: 0.25rem 0.3125rem;
      }
    }
  }

  .dateTime {
    margin: 0.5rem 0 0.5rem 0;
  }

  .healthColumn {
    margin: 0.5rem 0.5rem 0 0.5rem;
  }

  .copyButtonWrapper,
  .centeredCopyButtonWrapper {
    display: flex;

    margin-left: 0.25rem;
  }

  .centeredCopyButtonWrapper {
    align-items: flex-start;

    height: 100%;
  }
}

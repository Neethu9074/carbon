:local {
  .message {
    color: var(--ids-color-option-neutral-900);
    overflow-wrap: break-word;
    word-break: break-all;
    white-space: normal;
  }

  .hovered {
    cursor: pointer;
  }

  .parameter,
  .parameterClickable {
    color: var(--cds-link-primary);
    &:hover {
      text-decoration: underline;
      color: var(--cds-link-primary-hover);
    }
  }

  .parameterClickable {
    cursor: pointer;
  }

  .parameterOpen {
    text-decoration: underline;
  }

  .list {
    min-width: 12.5rem;
  }

  .listItem {
    align-items: center;
  }
}

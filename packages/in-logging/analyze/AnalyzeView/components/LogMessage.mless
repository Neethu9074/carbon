@import '~in-themes/active.less';

:local {
  .message {
    color: @lib__colors__N900Primary;
  }

  .hovered {
    text-decoration: underline;
    cursor: pointer;
  }

  .parameter {
    color: @lib__colors__N500;
    font-style: italic;

    cursor: pointer;
  }

  .parameterOpen {
    text-decoration: underline;
  }

  .list {
    min-width: 12.5rem;
  }

  .listItem {
    align-items: center;
  }
}

@import '~in-themes/active.less';

:local {
  .message {
    color: var(--ids-color-option-neutral-900);
    user-select: all;
  }

  .hovered {
    cursor: pointer;
  }

  .parameter,
  .parameterClickable {
    color: var(--ids-color-option-blue-500);
    &:hover {
      text-decoration: underline;
    }
  }

  .parameterClickable {
    cursor: pointer;
  }

  .parameterOpen {
    text-decoration: underline;
  }

  .list {
    min-width: 12.5rem;
  }

  .listItem {
    align-items: center;
  }
}

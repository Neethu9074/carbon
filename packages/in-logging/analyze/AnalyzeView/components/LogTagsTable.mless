:local {
  .tagContent {
    display: grid;
    grid-template-columns: 15rem auto 6rem;
    gap: 1rem 0;
    align-items: start;
    padding: 0;
  }

  .tagValue {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    word-break: break-word;
  }

  .groupHeader {
    padding: 0.25rem 0;
  }

  .hideTitle {
    > div:first-of-type {
      display: none;
    }
  }

  .actions {
    display: flex;
    justify-self: end;
    grid-column: 3;
    position: absolute;
    top: 0;
  }

  a.appListLink.appListLink {
    color: var(--cds-link-primary);

    &:hover {
      cursor: pointer;
      text-decoration: underline;
      color: var(--cds-link-primary-hover);
    }
  }

  .applicationList {
    overflow-y: scroll;
    max-height: 25rem;
  }

  .applicationListOverlay {
    width: 25rem;
  }

  .sparkcharts {
    grid-column: 2;
  }

  .tagSkeleton {
    width: 100%;
  }
}

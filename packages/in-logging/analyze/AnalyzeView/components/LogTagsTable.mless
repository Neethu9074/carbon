@import '~in-themes/mixins.less';

:local {
  .tagValue {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .tagLink {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: calc(100% - 8rem);

    > span {
      word-break: break-all;
    }
  }

  .tagActions {
    display: flex;
    height: 1.5rem;
    gap: 0.5rem;

    a,
    button {
      aspect-ratio: 1;
    }
  }

  .value {
    white-space: normal;
  }

  .li {
    min-height: 2rem;

    > div:first-child {
      height: 1.5rem;
      align-self: flex-start;
      display: flex;
      align-items: center;
    }
  }

  .liGroup {
    min-height: 2.5rem;
    max-height: 2.5rem;
  }

  .sparkchartsLi {
    min-height: 5rem;
    padding: 0 1rem 0 16rem;
    background: var(--colors-white);
    margin-top: -0.5rem;
  }

  .link {
    color: @lib__colors__blue800;

    cursor: pointer;

    &:hover {
      text-decoration: underline;
    }
  }

  .applicationList {
    overflow-y: scroll;
    max-height: 25rem;
  }

  .applicationListOverlay {
    width: 25rem;
  }
}

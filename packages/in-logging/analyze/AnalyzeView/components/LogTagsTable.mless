@import '~in-themes/mixins.less';

:local {
  .tagValue {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .tagLink {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: calc(100% - 8rem);

    > span {
      word-break: break-all;
    }
  }

  .tagActions {
    display: flex;
    height: 1.5rem;
    gap: 0.5rem;
    align-items: center;

    a,
    button {
      aspect-ratio: 1;
    }
  }

  .value {
    white-space: normal;
  }

  .li {
    min-height: 2rem;

    > div:first-child {
      height: 1.5rem;
      align-self: flex-start;
      display: flex;
      align-items: center;
    }
  }

  .liGroup {
    min-height: 2.5rem;
    max-height: 2.5rem;
  }

  .sparkchartsLi {
    flex-wrap: wrap;
  }

  .sparkcharts {
    padding: 0.8125rem 1rem 0.5rem 16rem;
  }

  .link {
    color: var(--cds-link-primary);

    cursor: pointer;

    &:hover {
      text-decoration: underline;
      color: var(--cds-link-primary-hover);
    }
  }

  .applicationList {
    overflow-y: scroll;
    max-height: 25rem;
  }

  .applicationListOverlay {
    width: 25rem;
  }

  .break {
    flex-basis: 100%;
  }

  .squareHover:before {
    border-radius: var(--ids-border-radius-option-small) !important;
  }
  .squareHover:focus {
    border-top: 0.313rem solid;
    border-bottom: 0.313rem solid;
    border-radius: var(--ids-border-radius-option-small);
    border-color: var(--cds-link-primary);
    box-shadow: inset 0 0 0 1px var(--cds-link-primary);
  }
}

@import '~in-themes/mixins.less';

:local {
  .value {
    .ellipsis();
  }

  .li {
    min-height: 2rem;
    max-height: 2rem;
  }

  .sparkchartsLi {
    min-height: 5rem;
    padding: 0 1rem 0 16rem;
    background: var(--colors-white);
    margin-top: -0.5rem;
  }

  .link {
    color: @lib__colors__blue800;

    cursor: pointer;

    &:hover {
      text-decoration: underline;
    }
  }

  .applicationList {
    overflow-y: scroll;
    max-height: 25rem;
  }

  .applicationListOverlay {
    width: 25rem;
  }
}

@import '~in-themes/mixins.less';

:local {
  .value {
    .ellipsis();
  }

  .li {
    min-height: 2rem;
    max-height: 2rem;
  }

  .link {
    color: @lib__colors__blue800;

    cursor: pointer;

    &:hover {
      text-decoration: underline;
    }
  }

  .applicationList {
    max-height: 25rem;

    overflow-y: scroll;
  }
}

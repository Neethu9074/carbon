@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .type {
    font-weight: 600;
    margin: 0.75rem 1rem 0 0;
  }

  .messageWrapper {
    margin-bottom: 0.75rem;

    white-space: break-spaces;
    word-break: break-word;
    hyphens: auto;
  }
}

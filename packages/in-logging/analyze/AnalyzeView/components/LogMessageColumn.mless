@import '~in-themes/mixins.less';

:local {
  .messageWrapper {
    display: flex;
    flex-direction: column;
  }

  .messageExpanded,
  .collapsedMessage {
    margin: 0.7rem 0 0.25rem 0;
  }

  .messageExpanded {
    span {
      word-break: keep-all;
      white-space: pre-wrap;
    }
  }

  .collapsedMessage {
    .ellipsis();
  }

  .stackTraceMessageWrapper {
    margin: 0.75rem 0;
  }

  .stackTrace {
    font-weight: 600;
    color: var(--cds-link-primary);
    &:hover {
      text-decoration: underline;
      cursor: pointer;
    }
  }
}

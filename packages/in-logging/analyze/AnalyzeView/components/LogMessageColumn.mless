@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .wrapper {
    min-height: 42px;
  }

  .messageWrapper {
    display: flex;
    justify-content: space-between;
  }

  .message {
    min-height: 1.5rem;

    margin: 0.5rem 0 0.25rem 0;
  }

  .messageExpanded {
    white-space: break-spaces;
    .breakWord();
  }

  .collapsedMessage {
    .ellipsis();
  }

  .tagsWrapper {
    flex-wrap: wrap;

    margin-bottom: 0.5rem;

    overflow: hidden;
  }
}

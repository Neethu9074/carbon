@import '~in-themes/mixins.less';

:local {
  .messageWrapper {
    display: flex;
    flex-direction: column;
  }

  .messageExpanded,
  .collapsedMessage {
    margin: 0.5rem 0 0.25rem 0;
  }

  .messageExpanded {
    white-space: break-spaces;
    .breakWord();
  }

  .collapsedMessage {
    .ellipsis();
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .wrapper {
    margin: 0.5rem 0;
  }

  .messageWrapper {
    display: flex;
    justify-content: space-between;
  }

  .messageExpanded {
    white-space: break-spaces;
  }

  .collapsedMessage {
    .ellipsis();
  }

  .icon {
    margin: 0 0.125rem 0 1rem;

    fill: @lib__colors__N900Primary;
  }

  .tagsWrapper {
    flex-wrap: wrap;

    margin-top: 0.5rem;

    overflow: hidden;
  }
}

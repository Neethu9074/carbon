@import '~in-themes/mixins.less';

:local {
  .messageWrapper {
    display: flex;
    justify-content: space-between;
  }

  .message {
    margin: 0.5rem 0 0.25rem 0;
  }

  .messageExpanded {
    white-space: break-spaces;
    .breakWord();
  }

  .collapsedMessage {
    .ellipsis();
  }

  .expandButton {
    height: 2.625rem;
  }
}

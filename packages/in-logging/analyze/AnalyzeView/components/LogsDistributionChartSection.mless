@import '~in-themes/active.less';

:local {
  .wrapper {
    margin-bottom: 24px;
  }

  .chartWrapper {
    padding: 1rem;

    background: @lib__colors__white;
    border-top: 1px solid @lib__colors__N400;
  }

  .header {
    margin: 0.5rem 0;

    &:empty {
      height: 1rem;
    }
  }

  .title {
    font-weight: 600;
  }
}

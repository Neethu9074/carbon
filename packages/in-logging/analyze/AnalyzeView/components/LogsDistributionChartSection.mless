:local {
  .wrapper {
    margin-bottom: 24px;
  }

  .chartWrapper {
    padding: 1rem;

    background: var(--ids-color-option-white);
    border-top: 1px solid var(--ids-color-option-neutral-400);
  }

  .header {
    &:empty {
      height: 1rem;
    }
  }

  .title {
    font-weight: 600;
  }
}

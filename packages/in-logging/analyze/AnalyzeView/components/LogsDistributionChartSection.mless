:local {
  .wrapper {
    margin-bottom: 24px;
  }

  .chartWrapper {
    padding: 1rem;
    background: var(--ids-color-option-white);
    div {
      box-shadow: none;
    }
  }

  .noBorder {
    border: none;
  }

  .header {
    margin: 0.5rem 0;

    &:empty {
      height: 1rem;
    }
  }

  .title {
    font-weight: 600;
  }
}

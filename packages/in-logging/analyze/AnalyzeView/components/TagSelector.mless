@import '~in-themes/active.less';

:local {
  .list {
    max-height: 20rem;
    width: 22rem;

    overflow-y: scroll;
  }

  .label {
    margin-bottom: 0.1875rem;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    padding: 0.5rem;

    background: @lib__colors__N050;
  }

  .searchInput {
    width: 100%;
  }
}

@import '~in-themes/active.less';

:local {
  .wrapper {
    margin: 0.5rem 0;
  }

  .content {
    color: @lib__colors__N900Primary;
    white-space: break-spaces;
  }

  .tagsWrapper {
    flex-wrap: wrap;

    margin-top: 0.5rem;

    overflow: hidden;
  }
}

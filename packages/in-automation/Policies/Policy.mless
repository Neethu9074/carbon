:local {
  .subTextFormField {
    color: var(--ids-color-option-neutral-600);
    margin: 0.5rem 0 0 0.5rem;
  }

  .subErrorTextFormField {
    margin-left: 0.5rem;
  }

  .spaceBetween {
    justify-content: space-between;
    background-color: var(--ids-color-option-white);
    padding: 0 1.5rem;
    padding-top: 1rem;
    height: 76px;
  }
  .selectDialog {
    padding: 0 3.5rem;
  }
  .select {
    width: 90vw;
  }
}

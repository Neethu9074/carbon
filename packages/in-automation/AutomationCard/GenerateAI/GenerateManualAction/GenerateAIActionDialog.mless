:local {
  .dialog {
    width: 80vw;
    height: 40vw;
    overflow-y: auto;
  }
  .contentSection {
    display: inline-flex;
    > div {
      min-height: 400px;
      width: 100%;
    }

    div {
      &:nth-child(1) {
        margin-right: 1rem;
        background-color: var(--cds-field);
        height: 100%;
      }

      &:nth-child(2) {
        width: 10%;
        position: relative;
        right: 4rem;
        top: 0.5rem;
      }
    }
  }

  .CodeWithAISlug {
    display: inline-flex;
    justify-content: space-between;
    background-color: var(--cds-layer);
    div {
      &:nth-child(2) {
        margin-top: 0.5rem;
        margin-right: 0.5rem;
      }
    }
  }

  .header {
    display: flex;
    padding: 0.6rem;
    background: var(--cds-layer-selected-01);
    align-items: center;
  }
}

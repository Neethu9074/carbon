:local {
  .dialog {
    width: 80vw;
    height: 40vw;
    overflow-y: auto;
    :global table th.table-column-width\.w-50 {
      width: 50px;
    }
  }
  .contentSection {
    display: inline-flex;
    > div {
      // Remove wrappper padding as it conflicts with overriding the background
      padding: initial;
      // Background for margin of .CodeMirror
      background-color: var(--cds-layer);
      border: none;
    }
    :global .CodeMirror {
      // Prevent text overflowing button
      margin-bottom: 2.5rem;
      // Add back padding we removed from wrapper
      padding: 0.25rem 0 0.25rem 0.5rem;
      // Desired height - margin for button
      height: 400px;
      // Editor background
      background-color: var(--cds-layer);
    }
    @media (max-width: 1500px) and (min-height: 600px) {
      :global .CodeMirror {
        height: 300px;
      }
    }
  }

  .CodeWithAISlug {
    display: inline-flex;
    justify-content: space-between;
    background-color: var(--cds-layer);
    div {
      &:nth-child(2) {
        margin-top: 0.5rem;
        margin-right: 0.5rem;
      }
    }
  }

  .header {
    display: flex;
    padding: 0.6rem;
    background: var(--cds-layer-selected-01);
    align-items: center;
  }

  .loadingContent {
    height: 400px;
    background-color: var(--cds-layer);
  }
}

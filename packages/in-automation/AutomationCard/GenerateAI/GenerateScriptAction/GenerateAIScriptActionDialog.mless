:local {
  .selectManualStepDiv {
    margin-bottom: 5rem;
  }

  .dialog {
    width: 80vw;
    height: 46vw;
    overflow-y: auto;
  }

  .stepsTile {
    border-bottom: 1px solid var(--cds-layer-selected-01);
  }
  .contentSection {
    display: inline-flex;
    > div {
      min-height: 400px;
    }

    div {
      &:nth-child(1) {
        margin-right: 1rem;
        background-color: var(--cds-field);
        height: 100%;
      }

      &:nth-child(2) {
        width: 10%;
        position: relative;
        right: 4rem;
        top: 0.5rem;
      }
    }
  }

  .CodeWithAISlug {
    display: inline-flex;
    min-height: 400px;
    justify-content: space-between;
    background-color: var(--cds-layer);
    div {
      &:nth-child(2) {
        margin-top: 0.5rem;
        margin-right: 0.5rem;
      }
    }
  }

  @media (max-width: 1500px) and (min-height: 600px) {
    .CodeWithAISlug {
      min-height: 300px;
    }
  }

  .header {
    display: flex;
    padding: 0.6rem;
    background: var(--cds-layer-selected-01);
    align-items: center;
  }

  .promptCode {
    // To allow the script button to be absolutely placed
    position: relative;
    > div {
      // Remove wrappper padding as it conflicts with overriding the background
      padding: initial;
      // Background for margin of .CodeMirror
      background-color: var(--cds-layer);
    }
    :global .CodeMirror {
      // Prevent text overflowing button
      margin-bottom: 2.5rem;
      // Add back padding we removed from wrapper
      padding: 0.25rem 0 0.25rem 0.5rem;
      // Desired height - margin for button
      height: calc(400px - 2.5rem);
      // Editor background
      background-color: var(--cds-layer);
      min-width: 450px;
    }
    @media (max-width: 1500px) and (min-height: 600px) {
      :global .CodeMirror {
        height: calc(337px - 2.5rem);
      }
    }
    .generateScriptButton {
      position: absolute;
      right: 0;
      bottom: 0;
    }
  }

  .noResults {
    background-color: var(--cds-layer);
    height: 400px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    font-size: var(--ids-font-size-option-body-regular);
  }
  .step2Description {
    display: flex;
    flex-direction: column;
  }

  .generateScriptStep {
    margin-bottom: 4rem;
  }
  .scriptSection {
    min-width: -moz-available;
    min-width: -webkit-fill-available;

    div {
      &:nth-child(1) {
        right: 2rem;
      }
    }
  }

  .generate-script-window {
    :global(.c4p--tearsheet-create__step--title) {
      font-size: var(--cds-heading-03-font-size, 1.25rem);
      font-weight: var(--cds-heading-03-font-weight, 400);
      line-height: var(--cds-heading-03-line-height, 1.4);
      letter-spacing: var(--cds-heading-03-letter-spacing, 0);
    }

    :global(.c4p--tearsheet__heading) {
      position: relative;
      display: flex;
      align-items: anchor-center;
      border-radius: var(--ids-border-radius-option-small) var(--ids-border-radius-option-small) 0 0;
    }

    :global(.cds--label) {
      font-size: var(--cds-body-01-font-size, 0.875rem);
      font-weight: var(--cds-body-01-font-weight, 400);
      line-height: var(--cds-body-01-line-height, 1.42857);
      letter-spacing: var(--cds-body-01-letter-spacing, 0.16px);
      margin-bottom: 1.5rem;
    }

    :global(
        .in-automation_AutomationCard_GenerateAI_GenerateScriptAction_GenerateAIScriptActionDialog_mless___CodeWithAISlug
      ) {
      font-size: 0.75rem;
    }
  }

  .configure-override {
    font-size: small;
  }

  .configure-override-close-dialog {
    z-index: 90001;
    position: relative;
  }
}

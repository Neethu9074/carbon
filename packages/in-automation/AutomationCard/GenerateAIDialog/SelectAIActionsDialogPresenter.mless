:local {
  .simpleDialog {
    width: 66.25rem;
    height: 50rem;
    padding: 0 1rem 1rem 1rem;
  }

  .container {
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
  }

  .actionModalPadding {
    padding: 0 1.5rem 4rem;
  }
  .actionModalFontSize {
    font-size: 0.8rem;
    font-weight: 400;
  }
  .dialog {
    width: 65%;
    > div > div > div {
      width: 95%;
    }
  }
  .actionDescriptionMargin dt {
    margin-bottom: 0.25rem;
  }

  .subTextFormField {
    color: var(--ids-color-option-neutral-600);
    margin: 0.5rem 0 0 0.5rem;
  }

  .subErrorTextFormField {
    margin-left: 0.5rem;
  }
  .heading {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
}

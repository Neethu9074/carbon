@import '~in-themes/mixins.less';

:local {
  .delete {
    cursor: pointer;
    fill: var(--ids-color-option-blue-500);

    &:hover {
      fill: var(--ids-color-option-neutral-700);
    }
  }

  .controls {
    justify-content: center;
    display: flex;
    align-items: center;
    height: 2rem;
  }

  .disabled {
    opacity: 0.6;
    cursor: default;
  }
}

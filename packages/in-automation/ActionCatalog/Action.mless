:local {
  .width100 {
    width: 100%;
  }

  .subTextFormField {
    color: var(--ids-color-option-neutral-600);
    margin: 0.5rem 0 0 0.5rem;
  }

  .subErrorTextFormField {
    margin-left: 0.5rem;
  }

  .parameterDialog {
    height: 100%;
    padding: 0 1.5rem;
  }
  .widthFitContent {
    width: fit-content;
  }
  .spaceBetween {
    justify-content: space-between;
    background-color: var(--ids-color-option-white);
    padding: 0 1.5rem;
    padding-top: 1rem;
    height: 76px;
  }

  .spaceBetweenSvgs {
    justify-content: space-between;
  }

  .scriptGenerationTile {
    height: 35%;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
  }

  .generateScriptArrow {
    position: absolute;
    right: 1rem;
  }
}

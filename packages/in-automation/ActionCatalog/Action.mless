@import '~in-themes/active.less';

:local {
  .spaceBetween {
    justify-content: space-between;
    padding-top: 1rem;
    background-color: @lib__colors__white;
    padding-left: 1.5rem;
    height: 76px;
  }
  .actionBody > div {
    padding-left: 0px;
  }
  .actionBody {
    fieldset {
      padding-left: 1.5rem;
    }
  }
}

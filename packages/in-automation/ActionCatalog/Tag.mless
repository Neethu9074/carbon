@import '~in-themes/mixins.less';

:local {
  .automationTag {
    display: inline-block;
    border-radius: 3px;

    padding: 4px 9px 4px 9px;
    margin: 0 4px 4px 0;

    text-align: left;
    .breakWord();
    line-height: 1.3;
    font-size: 12px;
    font-weight: 600;
    background: var(--ids-color-option-neutral-300);
  }
}

:local {
  .actionDescriptionMargin dt {
    margin-bottom: 0.25rem;
  }

  .manualContentMarkdown {
    background: var(--ids-color-option-neutral-50);
    display: flex;
    justify-content: space-between;
  }
  .actionModalFontSize {
    font-size: 0.8rem;
    font-weight: 400;
  }

  .codeBlock {
    list-style-type: none;
    margin: 0;
    padding: 1rem;
  }

  .codeBlock li {
    margin-bottom: 0.75rem;
  }
}

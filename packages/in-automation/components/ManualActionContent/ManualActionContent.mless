:local {
  .manualContentMarkdown {
    background: var(--ids-color-option-neutral-50);
    display: flex;
    justify-content: space-between;
  }

  .codeBlock {
    padding: 1rem;
    word-break: break-word;
    *:not(#copyActionButton) {
      all: revert;
    }
  }
  .aiSlug {
    margin-top: 0.4rem;
    margin-right: 0.4rem;
  }
}

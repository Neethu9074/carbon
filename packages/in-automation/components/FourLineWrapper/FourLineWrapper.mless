:local {
  .fourLines {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2; /* number of lines to show */
    line-height: 1.15rem; /* fallback */
    max-height: 3.45rem; /* Adjusted max-height for 3 lines (3 * 1.15rem) + a little extra for padding */
    padding: 0.7rem;
    box-sizing: border-box; /* Include padding in height calculations */
  }
}

:local {
  .fourLines {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4; /* number of lines to show */
    line-height: 1.15rem; /* fallback */
    max-height: 4.7rem; /* fallback, line-height x number of lines + 0.1 */
  }
}

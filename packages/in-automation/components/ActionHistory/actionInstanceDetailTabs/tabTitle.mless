@import '~in-themes/active.less';

:local {
  .title button {
    font-size: 0.875rem;
    border: none;
    text-decoration: none;
    color: @lib__colors__chart__self100;
    &:hover {
      text-decoration: none;
      color: @lib__colors__chart__self100;
      background: none;
      border-bottom: 3px solid @lib__colors__N600Light;
    }
    &:focus {
      outline: none;
    }
  }

  .active {
    button {
      border-bottom: 3px solid @lib__colors__cyan800;
      cursor: default;
      color: #3c444d;
    }
  }
}

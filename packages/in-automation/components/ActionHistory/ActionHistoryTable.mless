@import '~in-themes/mixins.less';

:local {
  .statusIndicator {
    position: relative;
    padding-left: 10px;
    font-size: 0.875rem;
    font-weight: normal;

    &::before {
      position: absolute;

      content: '';
      margin: 3px 8px 0px -13px;
      border: 5px solid;
      color: var(--ids-color-option-red-500);
      border-radius: var(--ids-border-radius-option-round);
    }

    &__success {
      &::before {
        color: var(--ids-color-option-green-500);
      }
    }

    &__fail {
      &::before {
        color: var(--ids-color-option-red-500);
      }
    }

    &__submitted {
      &::before {
        color: var(--ids-color-option-blue-500);
      }
    }
  }

  .ellipsis {
    .ellipsis();
  }

  .block {
    display: block;
  }
  .wrapper {
    display: inline-flex;
  }
}

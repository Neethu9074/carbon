@import '~in-themes/mixins.less';

:local {
  .statusIndicator {
    position: relative;
    padding-left: 10px;

    &::before {
      position: absolute;

      content: '';
      margin: 4px 8px 0px -13px;
      border: 5px solid;
      color: var(--ids-color-option-red-500);
      border-radius: var(--ids-border-radius-round);
    }

    &__success {
      &::before {
        color: var(--ids-color-option-green-500);
      }
    }

    &__fail {
      &::before {
        color: var(--ids-color-option-red-500);
      }
    }
  }

  .fourLines {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4; /* number of lines to show */
    line-height: 1.15rem; /* fallback */
    max-height: 4.6rem; /* fallback, line-height x number of lines */
  }

  .ellipsis {
    .ellipsis();
  }

  .block {
    display: block;
  }
  .wrapper {
    display: inline-flex;
  }
}

@import '~in-themes/active.less';

:local {
  .ActionInstanceDetailsTable {
    border: 1px solid var(--colors-gray-400);
    margin: 50px 50px 50px 50px;
    width: 700px;

    tr {
      background: #fff;
    }

    tr:nth-child(even) {
      background: var(--colors-gray-50);
    }

    th,
    td {
      color: var(--colors-gray-900);
      font-size: 0.875rem;
      font-weight: normal;
      padding: 0.8125rem 0;
      padding-left: 1rem;
      padding-right: 1rem;
      border-top: 1px solid var(--colors-gray-400);
      border-bottom: 1px solid var(--colors-gray-400);
      text-align: initial;
      min-width: 250px;
    }

    th {
      color: var(--colors-gray-700);
    }

    .headerRow td {
      color: var(--colors-gray-700);
      font-size: 0.75rem;
      font-weight: normal;
    }

    td {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
  }

  .paramsTab {
    margin: 3rem;
  }

  .detailDialog {
    max-width: 50vw;

    section {
      width: 50vw;
    }
  }
}

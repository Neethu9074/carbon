:local {
  .ActionInstanceDetailsTable {
    border: 1px solid var(--ids-color-option-neutral-400);
    margin: 0px 50px 50px 50px;
    width: 90%;
    table-layout: fixed;

    tr {
      background: #fff;
    }

    tr:nth-child(even) {
      background: var(--ids-color-option-neutral-50);
    }

    th,
    td {
      color: var(--ids-color-option-neutral-900);
      font-size: 0.875rem;
      font-weight: normal;
      padding: 0.8125rem 0;
      padding-left: 1rem;
      padding-right: 1rem;
      border-top: 1px solid var(--ids-color-option-neutral-400);
      border-bottom: 1px solid var(--ids-color-option-neutral-400);
      text-align: initial;
      width: 40%;
      word-wrap: break-word;
    }

    th {
      color: var(--ids-color-option-neutral-700);
    }

    .headerRow td {
      color: var(--ids-color-option-neutral-700);
      font-size: 0.75rem;
      font-weight: normal;
    }

    td {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
    .detailsLink {
      color: var(--cds-link-primary);
    }
  }

  .instanceTabContent {
    margin: 0rem 3rem 3rem 3rem;
    height: 34rem;
    overflow-y: auto;
  }

  .detailDialog {
    section {
      width: 65rem;
      overflow-y: hidden;
    }
    .detailsLink {
      display: flex;
      align-items: center;
      color: var(--cds-link-primary);
    }

    .singleHostLimit {
      padding-left: 0px;
    }
  }

  .ActionLaneTable {
    td,
    th {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
      height: 2.5rem;
      a {
        svg {
          position: relative;
          top: 4px;
        }
      }
    }
  }

  .titleWrapper {
    gap: 1rem;
    max-width: 40rem;
  }
  .actionInstanceIdContent {
    .actionInstanceId {
      top: 0.6rem;
      position: relative;
    }
  }
}

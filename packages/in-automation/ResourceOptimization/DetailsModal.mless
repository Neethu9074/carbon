:local {
  .detailsRow {
    border: 1px solid var(--cds-border-subtle);
    display: flex;
    width: 100%;
  }
  .agentRow {
    padding: 0.5rem;
  }

  .leftSection {
    flex: 1;
    border-right: 1px solid var(--cds-border-subtle);
    padding: 0.5rem;
  }

  .leftContent {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  }

  .turboLink {
    margin-top: auto;
  }

  .rightSection {
    flex: 1;
  }
  .paddingBox {
    padding: 0.5rem;
  }

  .resourceImpactsSection {
    display: flex;
    flex-direction: row;
    gap: 1rem;

    .resourceImpactsCol {
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      gap: 1rem;
    }
  }

  .smallText {
    color: var(--cds-text-helper);
    font-size: var(--ids-font-size-option-body-small);
    line-height: var(--ids-line-height-option-body-small);
    font-weight: var(--ids-font-weight-option-body-small);
  }
  .current {
    background-color: var(--cds-background);
    width: 10rem;
    > h2 {
      margin-left: 10px;
      color: var(--cds-text-secondary);
    }
  }
  .after {
    background-color: var(--cds-highlight);
    width: 10rem;
    > h2 {
      margin-left: 10px;
      color: var(--cds-text-secondary);
    }
  }
  .divider {
    height: 1px;
    background-color: var(--cds-border-subtle);
    border: none;
    width: 100%;
  }
  .appsScroll {
    overflow-y: auto;
    max-height: 9rem;
    display: flex;
    flex-direction: row;
  }

  .impactedAppsSection {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    .impactedAppsTitleRow {
      display: flex;
    }
    .impactedAppsTitle {
      flex: 1;
    }

    .impactedAppsCol {
      gap: 1rem;
      display: flex;
      flex-direction: column;
      flex: 1;
      flex-shrink: 0;
    }
  }
}

:local {
  .actionModalPadding {
    padding: 0 1.5rem 4rem;
  }
  .actionModalFontSize {
    font-size: 0.8rem;
    dd {
      width: 95%;
    }
  }
  .dialog {
    width: 65%;
  }
  .dialogWrapper {
    z-index: 9001;
    position: fixed;
  }
  .actionDescriptionMargin dt {
    margin-bottom: 0.25rem;
  }

  .subTextFormField {
    color: var(--ids-color-option-neutral-600);
    margin: 0.5rem 0 0 0.5rem;
  }

  .subErrorTextFormField {
    margin-left: 0.5rem;
  }
  .type {
    margin: 0 1rem 0 0;
    text-transform: uppercase;
  }
  .justifyContent {
    justify-content: space-between;
  }
  .parameterLabel {
    color: var(--ids-color-option-neutral-900);
  }
  .parameterContainer {
    overflow-y: scroll;
    height: 100%;
  }
  .alignStretch {
    align-items: stretch;
  }
  .borderRight {
    border-right: 1px solid var(--ids-color-option-neutral-300);
    padding-right: 1rem;
  }
  #hostLimit > div {
    height: auto;
    min-height: 2rem;
    > :last-child {
      height: auto;
    }
  }

  .logsLink {
    color: var(--cds-link-primary);
  }
}

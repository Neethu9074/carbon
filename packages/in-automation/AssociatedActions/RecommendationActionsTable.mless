@import '~in-themes/mixins.less';
:local {
  .cursorPointer {
    cursor: pointer;
  }
  .ellipsis {
    .ellipsis();
    display: block;
    width: 350px;
  }
  .title {
    font-size: 1.375rem;
    margin-top: 1.5rem;
    font-weight: 500;
    display: flex;
  }
}

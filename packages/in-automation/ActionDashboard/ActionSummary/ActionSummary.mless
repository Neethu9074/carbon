:local {
  .grid {
    gap: 1rem;
    margin-left: 1rem;
    margin-right: 1rem;
  }
  .customKPIMinor {
    font-size: 1.5rem;
  }
  .customKPIStyle {
    :global .card-body {
      > span > span:not(:only-child):last-child {
        padding-left: 2px;
      }
    }
  }
}

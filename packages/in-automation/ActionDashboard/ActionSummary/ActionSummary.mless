:local {
  .grid {
    gap: 1rem;
    margin-left: 1rem;
    margin-right: 1rem;
  }
  .customKPIStyle {
    :global [class*='__minor'] {
      font-size: 1.5rem;
    }
    :global [class*='__companion'] {
      padding-left: 2px;
    }
  }
}

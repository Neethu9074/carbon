:local {
  .titleStack {
    display: grid;
    justify-content: space-between;
  }
  .ghostBtn {
    display: flex;
    align-items: center;
    svg {
      margin-left: 8px;
    }
  }
  .testActionButton {
    border-left: 1px solid var(--cds-border-subtle-01);
    svg {
      stroke: var(--cds-link-primary, #0f62fe);
      stroke-width: 2px;
    }
  }
  .watsonxBtn {
    border-right: 1px solid var(--cds-border-subtle-01);
    &:not([disabled]) svg {
      fill: var(--cds-link-primary, #0f62fe);
    }
  }
  .borderBottom {
    border-bottom: 1px solid var(--cds-border-subtle-03);
  }
  .noHorizontalPaddings {
    padding-left: 0;
    padding-right: 0;
  }
  .customMarginY {
    :global .cds--css-grid-column {
      margin-bottom: 10px;
      margin-top: 5px;
    }
  }
  .authPassword {
    padding-left: 0;
    border: 0;
  }
}
:global .code-snippet-wrapper,
:global .code-snippet-wrapper-content {
  --cds-layer: var(--cds-background);
  margin-bottom: 0;
  font-size: 0.75rem;
}
:global .code-snippet-wrapper {
  width: 50%;
  pre {
    width: 100%;
  }
}

@media (max-width: 1280px) {
  :global .code-snippet-wrapper {
    width: 100%;
  }
}

:local {
  .widgetInfo {
    margin-top: 0.25rem;
  }

  .widgetConfigGridContainer {
    font-size: var(--ids-font-size-option-body-bold);
    font-weight: var(--ids-font-weight-option-body-bold);
  }

  .configLabel {
    padding: 0.25rem 0.25rem 0 0.25rem;
    color: var(--ids-color-option-neutral-600);
  }

  .configValue {
    padding: 0 0.25rem 0.25rem 0.25rem;
    color: var(--ids-color-option-neutral-800);
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .loadingBarContainer {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .noPadding {
    padding: 0;
  }

  .modal {
    .widgetInModal();
  }

  .noPaddingTitle {
    .noPaddingWidgetTitle();
  }

  .title {
    font-size: var(--ids-font-size-option-heading-600);
    font-weight: var(--ids-font-weight-option-heading-600);
    color: var(--ids-color-option-neutral-800);
    background-color: var(--ids-color-option-white);
  }

  .chart {
    --slo-chart-offset: 1.9rem;
    padding: 0.5rem 1rem 1.5rem;
    min-height: 12rem;
    height: calc(100% - var(--header-height) - var(--slo-chart-offset));

    &.noPadding {
      padding: 0;
    }
  }
}

:local {
  @color-configuration-icon-size: 0.75rem;

  .wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .color {
    border-radius: var(--ids-border-radius-round);
    width: @color-configuration-icon-size;
    height: @color-configuration-icon-size;
  }

  .groupedColorChoice {
    width: @color-configuration-icon-size;
    height: @color-configuration-icon-size;
  }

  .withLabel {
    margin-right: 0.5rem;
  }
}

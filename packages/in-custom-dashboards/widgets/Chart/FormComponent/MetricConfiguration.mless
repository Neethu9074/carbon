@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .title {
    margin: 0 1rem;
    .ellipsis();
  }

  .hasError {
    color: var(--ids-color-option-red-500);
  }

  .timeShifted {
    display: inline-flex;
    align-items: center;
  }

  .timeShiftIndicator {
    fill: var(--ids-color-option-neutral-600);
    margin: 0 0 0 0.2rem;
  }

  .highlighted {
    .highlightingActive();
  }
}

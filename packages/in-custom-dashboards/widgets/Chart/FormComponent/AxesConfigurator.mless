@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    display: flex;
    align-items: stretch;

    & > * {
      max-width: 100%;
    }
  }

  .dualAxis > * {
    max-width: 50%;

    &:first-child {
      border-right: 0;
    }
  }

  .axis {
    background: var(--ids-color-option-neutral-50);
    flex: 1;
  }

  .axisToggler {
    padding: 0;
    align-items: center;
  }

  .listItem {
    display: block;
  }

  .pill {
    cursor: pointer;
  }

  .pillWrapper {
    padding: 0 1rem;
  }

  .minMax {
    display: flex;
    justify-content: stretch;
  }

  .minMaxGroup {
    width: 100%;
    margin: 0;

    &:first-child {
      margin-right: 1rem;
    }
  }

  .dragHandleWrapper {
    display: flex;
  }

  .dragHandle {
    margin-right: 0.5rem;
    cursor: grab;
    fill: var(--ids-color-option-neutral-500);

    &:hover,
    &:active,
    &:focus {
      fill: var(--ids-color-option-neutral-600);
    }
  }

  .title {
    margin: 0 0.5rem;
    .ellipsis();
  }

  .timeShifted {
    display: inline-flex;
    align-items: center;
  }

  .timeShiftIndicator {
    fill: var(--ids-color-option-neutral-600);
    margin: 0 0 0 0.2rem;
  }

  .dragAndDropHelpText {
    padding: 3rem 0;
    margin: 0;
    text-align: center;
    color: var(--ids-color-option-neutral-600);
    background: var(--ids-color-option-neutral-300);
    border-radius: var(--ids-border-radius-option-small);
  }

  .shareMaxValueContainer {
    width: 100%;
    display: flex;
    align-items: center;
  }

  .draggableItem {
    min-height: 3.5rem;
  }
}

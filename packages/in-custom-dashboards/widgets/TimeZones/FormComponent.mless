@import '~in-themes/active.less';

:local {
  .timeZone {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .left {
    width: 100%;
  }

  .right {
    flex-shrink: 0;
  }

  .dragHandle {
    height: 1.5rem;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 1.5rem;

    & > svg {
      cursor: inherit;

      &:hover {
        cursor: inherit;
      }
    }
  }

  .label {
    margin-right: 1.5rem;
    flex-shrink: 0;
  }

  .timeZoneSelection {
    flex-shrink: 0;
  }

  .timeZoneLabel {
    width: 100%;
    flex-grow: 1;
    margin-left: 1.5rem;
  }

  .removeButton {
    fill: @lib__colors__N600Light;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 1.5rem;
  }
}

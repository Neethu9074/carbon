@import '~in-themes/mixins.less';

:local {
  .widgetCardWrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .loadingIndicator {
    position: absolute;
    width: 100%;
  }

  .cardBody {
    min-height: 12rem;
    height: 100%;
  }

  .modal {
    .widgetInModal();
  }

  .noPaddingTitle {
    .noPaddingWidgetTitle();
  }
}

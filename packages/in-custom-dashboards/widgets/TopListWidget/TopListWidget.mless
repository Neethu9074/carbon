@import '~in-themes/active.less';

:local {
  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;

    height: 100%;
  }

  .link {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .link,
  .linkPlaceHolder {
    margin: 1.5rem 0 0.75rem;
  }

  .linkPlaceHolder {
    height: 1rem;
  }

  .customHeaderWrapper {
    margin-right: 0.5rem;
  }

  .starIcon {
    fill: @lib__colors__N600Light;
  }

  .starIconFilled {
    fill: @lib__colors__yellow800;
  }
}

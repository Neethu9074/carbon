@import '~in-themes/active.less';

:local {
  .header {
    display: flex;
    align-items: center;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;

    height: ~'calc(100% - 4rem)';
  }

  .link {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .customHeaderWrapper {
    margin-right: 0.5rem;
  }

  .starIcon {
    fill: @lib__colors__N600Light;
  }

  .starIconFilled {
    fill: @lib__colors__yellow800;
  }
}

@import '~in-themes/active.less';

:local {
  .header {
    cursor: grab;
  }

  .card:hover {
    box-shadow: @lib__shadows__strong;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;

    height: 100%;
  }

  .link {
    margin-bottom: 0.75rem;

    font-size: 0.875rem;
    font-weight: 600;
  }

  .customHeaderWrapper {
    margin-right: 0.5rem;
  }

  .starIcon {
    fill: @lib__colors__N600Light;
  }

  .starIconFilled {
    fill: @lib__colors__yellow800;
  }
}

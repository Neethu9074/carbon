:local {
  .list {
    width: 100%;
  }

  .listItem {
    display: flex;
    align-items: center;
    justify-content: space-between;

    overflow: hidden;
    width: 100%;
  }

  .column {
    flex-grow: 1;
    overflow: hidden;
  }

  .skeleton {
    display: block;

    height: 1rem;

    margin: 0.5rem 0;
  }
}

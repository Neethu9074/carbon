:local {
  .list {
    width: 100%;
  }

  .listItem {
    display: grid;
    grid-template-columns: 1.5rem 3rem 1fr 1fr 1fr 1fr 1fr 1fr 3rem;

    overflow: hidden;
    width: 100%;
  }

  .column {
    overflow: hidden;
  }

  .skeleton {
    display: block;

    height: 1rem;

    margin: 0.5rem 0;
  }
}

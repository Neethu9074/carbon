@import '~in-themes/active.less';

:local {
  .header {
    position: relative;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }

  .cardWithStrongShadow {
    box-shadow: @lib__shadows__strong;
  }

  .dragHandleIcon {
    position: absolute;
    top: 0.25rem;
    left: ~'calc(50% - 0.75rem)';

    cursor: grab;

    fill: @lib__colors__N300;
    &:hover {
      fill: @lib__colors__N400;
    }
  }

  .link {
    margin: 1.5rem 0 0.75rem;

    font-size: 0.875rem;
    font-weight: 600;
  }

  .linkPlaceHolder {
    height: 1rem;
  }
}

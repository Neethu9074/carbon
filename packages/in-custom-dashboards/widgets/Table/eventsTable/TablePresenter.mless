:local {
  .container {
    width: 100%;
    height: 100%;
  }
  .heightAuto {
    height: 26rem !important;
    margin: 1.5rem 0rem;
  }
  .tableContent {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .title {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    align-items: center;
  }
}

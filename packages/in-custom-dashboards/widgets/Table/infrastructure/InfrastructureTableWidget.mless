@import '~in-themes/mixins.less';

:local {
  .widgetCard {
    position: relative;
    width: 100%;
    height: 100%;

    .visibleScrollbar();
  }

  .modal {
    .widgetInModal();
  }

  .viewFullTableLink {
    margin: 1rem 0 0.875rem 0;
  }

  .wrapper {
    padding: 1px 5px 0 0; // needed for rendering the search bar when having focus.
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
}

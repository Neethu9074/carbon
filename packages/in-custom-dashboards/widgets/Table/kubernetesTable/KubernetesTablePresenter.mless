@import '~in-themes/mixins.less';
@import '~in-themes/mediaQueries.less';

:local {
  .container {
    width: 100%;
    height: 100%;
  }
  .heightAuto {
    height: 26rem !important;
    margin: 1.5rem 0rem;
  }
  .tableContent {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .tableTitle {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    align-items: center;
  }

  .timelineColumn {
    max-width: 18.75rem;
    min-width: 6.25rem;
  }

  .widgetCard {
    width: 100%;
    height: 100%;
    overflow: auto;
    min-height: 20rem;
  }
  .carbonLoadMore {
    &:hover {
      color: var(--cds-background-hover);
    }
    display: grid;
  }

  .entityWrapper {
    display: flex;
    align-items: center;
    max-width: 100%;
  }

  .entityIcon {
    margin-right: 0.25rem;
    flex-shrink: 0;
    fill: var(--cds-icon-primary);
  }

  .text,
  .smallColumn,
  .title {
    .ellipsis();
  }

  .title {
    max-width: 40rem;
  }

  @media @min-medium-screen {
    .smallColumn {
      max-width: 25rem;
    }
  }

  .smallColumn {
    max-width: 18rem;
  }

  .emptyTableExplanation {
    width: 28rem;

    margin: 1rem 1.5rem;

    text-align: center;
    line-height: 1.25rem;
    font-size: 0.8125rem;
    color: var(--ids-color-option-neutral-700);
  }
}

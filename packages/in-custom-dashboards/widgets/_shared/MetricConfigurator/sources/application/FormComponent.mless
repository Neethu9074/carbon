@import '~in-themes/active.less';

:local {
  .groupingConfiguration {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .groupingConfigurationAlignment {
    display: flex;
    align-items: flex-start;
  }

  .groupingConfigurationDrop {
    padding: 0 0.75rem 0 0;
  }

  .groupingConfigurationToggle {
    margin-top: 1.5rem;
  }

  .groupingConfigurationLabel {
    margin-top: 1.8rem;
    padding: 0 0.75rem 0 0;
  }

  .select {
    width: 10rem;
  }
}

@import '~in-themes/active.less';

:local {
  .carbonConfigurator {
    overflow-wrap: anywhere;
  }
  .loadingWrapper {
    display: flex;
    align-items: center;
  }
  .loadingText {
    margin-left: 0.5rem;
  }
  .icon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem;

    fill: var(--ids-color-option-neutral-400);
  }
  .configuratorWithAdditionalContent {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: fit-content;
  }
  .metricUnitWrapper {
    display: flex;
    align-items: center;
  }
}

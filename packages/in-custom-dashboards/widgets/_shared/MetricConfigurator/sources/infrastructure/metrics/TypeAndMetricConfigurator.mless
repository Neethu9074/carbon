@import '~in-themes/active.less';

:local {
  .configurator {
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 2;

    padding: 0.1875rem 0.3rem 0.1875rem 0.4375rem;
    width: fit-content;

    display: flex;
    align-items: center;

    white-space: normal;
    overflow-wrap: anywhere;
    text-align: left;

    cursor: pointer;
  }
  .carbonConfigurator {
    overflow-wrap: anywhere;
  }
  .loadingWrapper {
    display: flex;
    align-items: center;
  }
  .loadingText {
    margin-left: 0.5rem;
  }
  .icon {
    // icons have a built in margin so we need to substract it when it is used in smaller frames
    margin: -0.5rem -0.25rem;

    fill: var(--ids-color-option-neutral-400);
  }
  .configuratorWithAdditionalContent {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: fit-content;
  }
  .metricUnitWrapper {
    display: flex;
    align-items: center;
  }
}

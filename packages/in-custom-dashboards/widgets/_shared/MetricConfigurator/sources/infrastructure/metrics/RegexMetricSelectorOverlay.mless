@import '~in-themes/active.less';

:local {
  .container {
    display: flex;
    flex-direction: column;
  }

  .typeSelector {
    width: 100%;
  }

  .wrapper {
    padding: 0.5rem;
    background: @lib__colors__N050;
    border-bottom: 1px solid @lib__colors__N300;
  }

  .input {
    background: @lib__colors__white;
    width: 100%;
    height: 2rem;
    padding: 0 0.5rem;
  }
}

@import '~in-themes/active.less';

:local {
  .container {
    display: flex;
    flex-direction: column;
  }

  .typeSelector {
    width: 100%;
  }

  .wrapper {
    padding: 0.5rem;
    background: var(--ids-color-option-neutral-50);
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    align-items: center;
  }

  .input {
    background: var(--ids-color-option-white);
    min-width: 0;
    flex-grow: 1;
  }

  .helpOverlay {
    padding: 1rem;
    background: var(--ids-color-option-neutral-50);
    max-height: 80vh;
    max-width: 75vh;
    overflow-y: auto;
  }

  .icon {
    fill: var(--ids-color-option-neutral-600);
  }
}

@import '~in-themes/active.less';

:local {
  .container {
    display: flex;
    flex-direction: column;
  }

  .typeSelector {
    width: 100%;
  }

  .wrapper {
    padding: 0.5rem;
    background: var(--ids-color-option-neutral-50);
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
  }

  .input {
    background: var(--ids-color-option-white);
    width: 100%;
    height: 2rem;
    padding: 0 0.5rem;
  }
}

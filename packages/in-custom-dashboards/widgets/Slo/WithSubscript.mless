@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
    .container {
      color: @lib__colors__N900Primary;
      width: 100%;
      display: flex;
      flex-direction: column;
      .ellipsis();
    }

    .smallTextAbove {
      position: relative;
      margin-top: 1em;
      font-size: .75rem;
      color: @lib__colors__N600Light;
    }
}

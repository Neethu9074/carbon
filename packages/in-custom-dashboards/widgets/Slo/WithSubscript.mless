@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {

  .container {
    width: 100%;
    display: flex;
    flex-direction: column;
    .ellipsis();
  }

  .smallTextAbove {
    vertical-align: baseline;
    position: relative;
    top: -0.1em;
    font-size: .7rem;
    color: @lib__colors__N600Light;
  }
}

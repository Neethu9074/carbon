@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .tilesContainer {
    display: grid;
    grid-column-gap: 0;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: var(--ids-color-option-neutral-300) 1px solid;
  }

  .listContainer {
    display: flex;
    flex-direction: column;
    justify-items: stretch;
    border-bottom: var(--ids-color-option-neutral-300) 1px solid;
  }
}

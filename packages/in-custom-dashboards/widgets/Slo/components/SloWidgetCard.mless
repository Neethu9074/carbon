@import '~in-themes/mixins.less';

:local {
  .cardWrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .loadingIndicator {
    position: absolute;
    height: 1rem;
    width: 100%;
  }

  .modal {
    .widgetInModal();
  }

  .noPaddingTitle {
    .noPaddingWidgetTitle();
  }

  .contentWrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 0.8rem;

    &.noPadding {
      padding: 0;
    }
  }
}

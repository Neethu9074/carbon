@import '~in-themes/active.less';

:local {
  .bodyNoPadding {
    padding: 0;
  }

  .title {
    font-size: @lib__typography__h600__font-size;
    font-weight: @lib__typography__h600__font-weight;
    color: @lib__colors__N800Dark;
    background-color: @lib__colors__white;
  }

  .apName {
    margin-left: -0.5rem;
    margin-bottom: 0.125rem;
    align-self: flex-end;
    font-size: @lib__typography__body__font-size;
    font-weight: 600;
    color: @lib__colors__N600Light;
  }

  .chart {
    padding-top: 0.5rem;
    padding-left: 1rem;
    padding-right: 1rem;
    grid-column-start: 0;
    grid-column-end: 3;
  }
}

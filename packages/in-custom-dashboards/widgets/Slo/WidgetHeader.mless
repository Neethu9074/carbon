@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

@grid_layout__breakpoint: 1300px;

:local {
  .tilesContainer {
    display: grid;
    grid-column-gap: 0;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: @lib__colors__N300 1px solid;

    @media (max-width: (@grid_layout__breakpoint - 1)) {
      // hide for narrow screens
      display: none;
    }
  }

  .listContainer {
    display: flex;
    flex-direction: column;
    justify-items: stretch;
    border-bottom: @lib__colors__N300 1px solid;

    @media (min-width: @grid_layout__breakpoint) {
      display: none;
    }
  }
}

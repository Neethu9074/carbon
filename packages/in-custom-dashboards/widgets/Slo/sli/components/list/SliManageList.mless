@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .ellipsis {
    font-size: 1rem;
    font-weight: 300;
    .ellipsis();
  }

  .iconButton {
    fill: var(--ids-color-option-blue-500);
  }

  .withIcon {
    margin-right: 0.5rem;
  }

  .nameColumn {
    max-width: 50rem;
  }

  .controls {
    display: flex;
    justify-content: flex-end;
  }

  .message {
    margin-left: 1rem;
    margin-right: 1rem;
  }

  .createButton {
    margin-right: 0.5rem;
  }

  .formWrapper {
    height: 100%;
    padding: 0 1rem;
  }
}

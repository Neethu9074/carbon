@import '~in-themes/active.less';

:local {
  .applicationName[disabled]{
    color: @lib__colors__N700Medium;
  }
  .oneLineLabel {
    margin-top: 0rem;
  }
  .boundaryLabel {
    margin-top: 2rem;
  }
  .helpIcon {
    fill: @lib__colors__N700Medium;
    margin-right: 0.25rem;
    vertical-align: text-top;
  }
  .linkDocs {
    font-size: 0.75rem;
    margin-top: 0.5rem;
  }
}

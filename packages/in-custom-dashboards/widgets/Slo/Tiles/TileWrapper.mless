@import '~in-themes/mixins.less';

:local {
  .wrapper {
    padding: 0.625rem 1rem;
    .ellipsis();
    position: relative;
  }

  .useMaxAvailableHeight {
    height: 100%;
  }

  .actions {
    position: absolute;
    top: 0.625rem;
    right: 1rem;
    display: flex;
    align-items: center;
  }
}

@import '~in-themes/mixins.less';

:local {
  .title {
    color: @lib__colors__N900Primary;
    font-size: 1rem;
  }

  .value {
    color: @lib__colors__N900Primary;
    font-size: @lib__typography__h700__font-size;
    font-weight: @lib__typography__h700__font-weight;
  }

  .leftSpace {
    padding-left: 0.25em;
  }

  .unit {
    font-size: 1.5rem;
  }

  .targetInfo {
    font-size: @lib__typography__body__font-size;
    font-weight: 600;
    line-height: 1.25rem;
    color: @lib__colors__N600Light;
  }
}

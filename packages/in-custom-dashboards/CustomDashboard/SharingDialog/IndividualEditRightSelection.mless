@import '~in-themes/active.less';

:local {
  .avatar {
    min-width: 2rem;
    min-height: 2rem;
    max-width: 2rem;
    max-height: 2rem;
    border-radius: 50%;
    margin-right: 0.75rem;
  }

  .loading {
    margin: 1rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wrapper {
    margin: 1.5rem 0;
  }

  .addWrapper {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin: 0 0 0.5rem;
  }

  .addInput {
    flex-grow: 1;
  }

  .addButton {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: @grid__gutter * 1px;
  }

  .delete {
    fill: @lib__colors__primary2;
  }
}

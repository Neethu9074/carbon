@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .layout {
    margin: 0 @grid__gutter * 0.5px;
  }

  .tvMode {
    margin: @grid__gutter * 0.5px;
  }

  .widget {
    break-inside: avoid;

    & > :last-child:not(div) {
      transition: opacity 0.3s ease-in-out;
      opacity: 0;
      background: none;

      &::after {
        width: 10px;
        height: 10px;
        border-color: var(--ids-color-option-neutral-800);
      }
    }

    &:has(.notInViewport) {
      .print(none);
    }

    &:hover {
      .more,
      .dragHandle,
      .zoom,
      .viewInAnalyze,
      & > :last-child {
        opacity: 1;
      }
    }
  }

  .moreMenuContainer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 0.5rem;
  }
  .carbonMoreMenuContainer {
    margin-left: 0.75rem;
  }
  .moreMenuContent {
    display: flex;
  }

  .viewInAnalyze {
    display: grid;
    place-items: center;
  }

  .zoom,
  .viewInAnalyze {
    transition: opacity 0.3s ease-in-out;
    opacity: 0;
    fill: var(--ids-color-option-neutral-500);

    &:hover,
    &:active,
    &:focus {
      opacity: 1;
      fill: var(--ids-color-option-neutral-600);
    }
  }

  .dragHandle {
    transition: opacity 0.3s ease-in-out;
    opacity: 0;
    cursor: grab;
    fill: var(--ids-color-option-neutral-500);

    &:hover,
    &:active,
    &:focus {
      opacity: 1;
      fill: var(--ids-color-option-neutral-600);
    }
  }

  .more {
    transition: opacity 0.3s ease-in-out;
    opacity: 0;

    &:active,
    &:focus {
      opacity: 1;
    }
  }

  .visibilityTrackWrapper {
    width: 100%;
    height: 100%;
  }
}

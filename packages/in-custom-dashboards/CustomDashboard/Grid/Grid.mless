@import '~in-themes/active.less';

:local {
  .layout {
    margin: 0 @grid__gutter * 0.5px @grid__gutter * 0.5px;
  }

  .tvMode {
    margin: @grid__gutter * 1px;
  }

  .widget {
    & > :last-child {
      transition: opacity .3s ease-in-out;
      opacity: 0;
      background: none;

      &::after {
        width: 10px;
        height: 10px;
        border-color: @lib__colors__N800Dark;
      }
    }

    &:hover {
      .more {
        opacity: 1;
      }

      & > :last-child {
        opacity: 1;
      }
    }
  }

  .widget:hover {
    & > :last-child {
      opacity: 1;
    }
  }

  .more {
    transition: opacity .3s ease-in-out;
    opacity: 0;

    &:active, &:focus {
      opacity: 1;
    }
  }
}

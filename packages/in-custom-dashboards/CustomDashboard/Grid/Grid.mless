@import '~in-themes/active.less';

:local {
  .layout {
    margin: 0 @grid__gutter * 0.5px;
  }

  .tvMode {
    margin: @grid__gutter * 0.5px;
  }

  .widget {
    & > :last-child:not(div) {
      transition: opacity .3s ease-in-out;
      opacity: 0;
      background: none;

      &::after {
        width: 10px;
        height: 10px;
        border-color: @lib__colors__N800Dark;
      }
    }

    &:hover {
      .more, .dragHandle, & > :last-child {
        opacity: 1;
      }
    }
  }

  .dragHandle {
    transition: opacity .3s ease-in-out;
    opacity: 0;
    cursor: grab;
    fill: @lib__colors__N500;

    &:hover, &:active, &:focus {
      opacity: 1;
      fill: @lib__colors__N600Light;
    }

    & + .more {
      margin-left: 0.5rem;
    }
  }

  .more {
    transition: opacity .3s ease-in-out;
    opacity: 0;

    &:active, &:focus {
      opacity: 1;
    }
  }

  .visibilityTrackWrapper {
    width: 100%;
    height: 100%;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .content {
    width: 8.27in;
    height: auto;
    overflow: hidden;
    display: block;
    object-fit: contain;
  }

  .container {
    width: 100%;
    max-width: 8.27in;
    height: auto;

    top: 0;
    left: 0;
    position: absolute;

    opacity: 0;
    pointer-events: none;

    display: block;
    box-sizing: border-box;

    :global {
      .search-input,
      .view-full-table,
      .show-results,
      .legend-arrow,
      .legend-dot,
      .legend-label,
      .hidden {
        display: none;
      }

      .legend-value {
        display: block;
      }

      .legend-container {
        height: auto;
      }
    }

    &.timeseries,
    &.histogram {
      max-width: 14in;

      :global {
        .legend-arrow,
        .legend-dot,
        .legend-label {
          display: block;
        }
      }
    }

    &.slo,
    &.apdex {
      max-width: 12in;
    }

    &.timeseries,
    &.histogram,
    &.slo,
    &.apdex {
      .content {
        width: 100%;
      }
    }

    &.markdown span {
      white-space: normal;
    }
  }

  .height {
    height: 70vh;
  }
}

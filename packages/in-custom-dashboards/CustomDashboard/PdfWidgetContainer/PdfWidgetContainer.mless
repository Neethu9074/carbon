@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .content {
    width: 8.27in;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .iframe {
    margin-left: 1rem;
  }

  .container {
    width: 100%;
    max-width: 8.27in;
    height: auto;

    top: 0;
    left: 0;
    position: absolute;

    opacity: 0;
    pointer-events: none;

    display: block;
    box-sizing: border-box;

    &.timeseries,
    &.histogram {
      max-width: 14in;
    }

    &.slo,
    &.apdex {
      max-width: 12in;
    }

    &.timeseries,
    &.histogram,
    &.slo,
    &.apdex {
      .content {
        width: 100%;
      }
    }

    &.markdown span {
      white-space: normal;
    }
  }

  .height {
    height: 70vh;
  }
}

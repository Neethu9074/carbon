:local {
  .overlay {
    min-width: 30rem;
    max-width: 30rem;
    max-height: 60vh;
    overflow: visible auto;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .addDashboard {
    margin: 0 0 0 2rem;
  }

  .tabs {
    padding-bottom: 0;
  }

  .lettering {
    filter: brightness(0.1);
  }

  .itemContent {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .leftMargin {
    margin-left: 0.5rem;
  }
}

:local {
  .loadMoreContainer {
    opacity: 0;
    height: 10px;
  }

  .searchBar {
    width: 100%;
    max-height: 2.5rem;
    display: flex;
    flex: 2.5;
  }

  .acknowledgment {
    margin-top: 1rem;
  }

  .popoverInfo {
    width: 288px;
    padding: 1rem;

    p,
    h2 {
      color: var(--cds-text-on-color);
    }
  }
}

:local {
  .additionalInfo {
    margin: 0.5rem 0;
  }
  .alert {
    color: var(--cds-text-secondary);
  }
  .iconWarning {
    svg {
      path:first-of-type {
        fill: var(--cds-text-primary);
      }
      path:last-of-type {
        fill: var(--cds-support-warning);
      }
    }
  }
}

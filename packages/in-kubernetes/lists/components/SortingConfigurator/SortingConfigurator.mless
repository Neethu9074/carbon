:local {
  .sortingConfigurator {
    width: 100%;
    max-height: 2.5rem;
    min-width: 22.5rem;
    margin-left: 1rem;
    display: flex;
    align-items: center;
    flex: 1;

    span {
      color: var(--cds-text-secondary);
    }
  }

  .button,
  .button svg {
    margin-left: 0.5rem;
  }
}

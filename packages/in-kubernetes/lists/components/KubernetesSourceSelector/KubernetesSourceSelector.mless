:local {
  li.menuitem {
    block-size: min-content !important;
    min-width: fit-content !important;
    padding: 1rem;
  }

  li.menuitem:not(first-child) {
    border-bottom: 0.0625rem solid var(--cds-border-subtle);
  }

  li.menuitem:last-child {
    border-bottom: none;
  }

  .option {
    grid-template-columns: 2rem auto;
    min-width: fit-content;
    align-items: center;
    display: flex;

    .option-icon-container {
      margin-right: 0.5rem;
    }
  }

  .optionText {
    display: flex;
    flex-direction: column;
  }

  .optionIcon {
    align-self: center;
    padding-right: 1.5rem;
  }

  .label,
  .description {
    grid-column-start: 2;
    text-wrap: wrap;
  }

  .menubutton {
    display: flex;
    align-items: center;
  }

  .selected-option .option-icon-container {
    margin-right: 0;
  }

  .icon {
    margin-right: 0.5rem;
  }

  .dropdownMenu ul {
    min-inline-size: 375px !important;
    padding: 0;
  }
}

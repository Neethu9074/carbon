@import '~in-themes/active.less';

:local {
  .clusterManagement {
    display: flex;
    align-items: center;

    color: @lib__colors__N500;
    font-size: 0.75rem;
  }

  .clusterManagementIcon {
    margin-left: 0.125rem;
    fill: @lib__colors__N500;
  }

  .clusterManagementLabel {
    margin-right: 0.25rem;
    color: @lib__colors__N500;
  }
}

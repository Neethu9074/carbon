@import '~in-themes/active.less';

:local {
  .clusterItem {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .clusterManagedBy {
    display: flex;
    align-items: center;

    color: @lib__colors__N500;
    font-size: 0.75rem;
  }

  .clusterManagedByIcon {
    margin-left: 0.125rem;
    fill: @lib__colors__N500;
  }

  .clusterManagedByLabel {
    margin-right: 0.25rem;
    color: @lib__colors__N500;
  }
}

:local {
  .argoCD {
    display: flex;
    flex-direction: column;
    padding: 1rem 2rem 3rem;
  }
  .tearsheet {
    > div {
      max-width: 70%;
      height: 90%;
      margin-bottom: 2%;
    }
  }
  .notification {
    white-space: nowrap;
  }
}

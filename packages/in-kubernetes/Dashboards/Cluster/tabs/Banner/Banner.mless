:local {
  .bannerSection {
    margin-left: calc(var(--cds-spacing-06) * -1);
    margin-right: calc(var(--cds-spacing-06) * -1);
    margin-top: calc(var(--cds-spacing-06) * -1);
    background: var(--cds-field-03);
  }

  .banner {
    display: flex;
    width: 100%;
    position: relative;

    > div {
      flex: 0 0 35%;
    }

    :nth-child(2) {
      flex: 1;
    }

    &:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      background: linear-gradient(
        180deg,
        rgba(138, 63, 252, 0.1) 0%,
        rgba(69, 137, 255, 0.03) 51.21%,
        rgba(255, 255, 255, 0) 128.32%
      );
      z-index: 0;
      pointer-events: none;
    }
    :global .cds--tag {
      margin-left: var(--cds-spacing-03);
      vertical-align: top;
    }
  }

  .leftContainer {
    margin-top: var(--cds-spacing-09);
    margin-left: var(--cds-spacing-09);
  }

  .product {
    > svg {
      margin-right: var(--cds-spacing-03);
      vertical-align: text-bottom;
    }
  }

  .illustration {
    display: flex;
    justify-content: flex-end;
    margin-right: var(--cds-spacing-09);
  }

  .buttonSection {
    display: flex;
    justify-content: right;
    background: var(--cds-field-03);
  }
  .cutOffText {
    hyphens: none;
  }

  .collapsibleContainer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .leftCollapsibleTag {
    margin-top: var(--cds-spacing-05);
    margin-left: var(--cds-spacing-07);
    padding-bottom: var(--cds-spacing-03);

    :global .cds--tag {
      margin-left: var(--cds-spacing-03);
      vertical-align: top;
    }
  }

  .secondaryCta {
    margin-left: var(--cds-spacing-07);
  }

  .primaryCta {
    display: flex;
    align-items: center;
  }
}

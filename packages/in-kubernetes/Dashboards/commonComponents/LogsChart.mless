@import '~in-themes/active.less';

:local {
  .wrapper:hover .showLongVariantOnHover {
    .action {
      display: inline-flex;
    }

    .actionIcon {
      display: none;
    }
  }

  .action {
    display: none;
    margin: -4px 0;
  }

  .actionIcon {
    fill: @lib__colors__N600Light;
    cursor: pointer;
  }
}

@import '~in-themes/mixins.less';
@import '~in-themes/active.less';

:local {
  .wrapper {
    padding: 0.5rem 0.5rem 1rem;
    min-width: 16rem;
    max-width: 20rem;
    overflow: hidden;
  }

  .heading {
    margin-bottom: 1rem;
  }

  .headerLabel {
    .ellipsis();
  }

  .list {
    margin: 0;
    padding: 0;
  }

  .item {
    display: flex;
    justify-content: space-between;

    list-style-type: none;

    & + .item {
      margin-top: 0.5rem;
    }
  }

  .key {
    color: @lib__colors__N500;
    margin-right: 1rem;
    white-space: nowrap;
  }

  .value {
    color: @lib__colors__N800Dark;
  }

  .metricValueSkeleton,
  .labelSkeleton {
    display: block;
    height: 0.75rem;
    width: 6.25rem;
  }

  .metricValueSkeleton {
    width: 3rem;
  }
}

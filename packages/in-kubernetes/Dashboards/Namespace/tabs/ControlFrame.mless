@import '~in-themes/active.less';

:local {
  .frame {
    display: flex;
    width: 100%;
  }

  .leftPanel {
    width: 13.75rem;
    margin-right: 0.5rem;
    border-right: 1px solid @lib__colors__N200;
  }

  .groupHeading {
    margin-bottom: 1rem;
    color: @lib__colors__N500;
  }

  .list {
    margin: 0 0 4rem 0;
    padding: 0;
  }

  .item {
    list-style: none;
    margin-bottom: 0.5rem;
  }

  .button {
    justify-content: flex-start;
    width: 12rem;
  }

  .rightPanel {
    width: 100%;
  }

  .header {
    display: flex;
    align-items: center;
    flex-direction: row-reverse;
    justify-content: space-between;

    height: 2rem;
    margin: 0 0.5rem 0.125rem 0.5rem;
  }

  .test {
    font-weight: bold;
  }
}

@import '~in-themes/mixins.less';

:local {
  .capacity_font {
    font-size: 1rem;
    color: #47525d;
    font-weight: 200;
  }
  .unit {
    color: var(--ids-color-option-neutral-900);
    font-size: 0.8rem;
  }
  .minor {
    color: var(--ids-color-option-neutral-900);
  }
  .minor {
    font-size: 1.5rem;
  }
}

:local {
  .list {
    align-items: center;
    display: flex;
    justify-content: space-between;
    overflow: hidden;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    width: 100%;
  }

  .label {
    width: '20%';
    min-width: 20rem;
    margin-right: 1rem;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
  }

  .namespace {
    width: '10%';
    min-width: 5rem;
    margin-right: 1rem;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
  }

  .status {
    width: '10%';
    min-width: 5rem;
    margin-right: 1rem;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
  }

  .metrics {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
  }

  .number {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
  }

  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .filterLabel {
    font-weight: 400;
    padding-top: 0.6rem;
  }

  .numericInput {
    display: inline-block;
    width: 4rem;
  }
}

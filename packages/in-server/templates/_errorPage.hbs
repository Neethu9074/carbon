<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <link rel="icon"
        type="image/png"
        href="favicon.png">
  <title>{{title}} - Instana</title>
  <link rel="stylesheet" href="/errorPages/main.css">
</head>
<body>
  <div class="left-side-content">
    <h1 class="title">
      {{title}}
    </h1>

    <p class="message">
      {{message}}
    </p>

    <a class="link-button" href="http://instana.statuspage.io/">
      Instana Status Page
    </a>
    <a class="link-button" href="https://support.instana.com/hc/en-us/requests/new">
      Support
    </a>
  </div>

  {{#if showStan}}
    <img src="/errorPages/stan-pulling-the-plug.png"
         alt="Stan pulling the plug (accidentally)"
         class="right-side-stan">
  {{/if}}
</body>
</html>

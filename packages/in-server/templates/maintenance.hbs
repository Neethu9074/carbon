<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Maintenance - Instana</title>

  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:700,400,300&amp;subset=latin,greek,vietnamese,latin-ext,cyrillic,cyrillic-ext" crossorigin="anonymous">

  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #fff;
      background: #43565E;
      font-family: "Open Sans", sans-serif;
    }
    .main {
      max-width: 25rem;
    }
    .title {
      font-size: 2.25rem;
      line-height: 2.5rem;
      font-weight: bold;
    }
    .message {
      color: #92A5AE;
      font-size: 1rem;
      line-height: 1.25rem;
    }
    .status-page-link {
      outline: none;
      cursor: pointer;
      background-color: #ffde00;
      color: #000;
      font-weight: bold;
      border: 1px solid transparent;
      border-radius: 0.31rem;
      padding: 0.37rem;
      cursor: pointer;
      text-decoration: none;
      font-size: 0.9rem;
      display: block;
      margin: 10px auto;
      width: 9.5rem;
      text-align: center;
    }
    .status-page-link:hover {
      background-color: #ffe957;
    }
  </style>
</head>
<body>
  <div class="main">
    <h1 class="title">
      Maintenance
    </h1>
    <p class="message">
      We are currently busy upgrading the system. Your environment will be back shortly.
    </p>
    <a class="status-page-link" href="http://instana.statuspage.io/">
      Instana Status Page
    </a>
  </div>
</body>
</html>

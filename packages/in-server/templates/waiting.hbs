<!doctype html>
<html>
<head profile="http://www.w3.org/2005/10/profile">
  <meta charset="UTF-8"
        name="viewport"
        content="initial-scale=1">

  <link rel="icon"
        type="image/png"
        href="favicon.png">

  <title>Instana</title>

  <link rel="stylesheet"
        href="/bundle/waiting-{{waitingCssChecksum}}.css">

  <script nonce="{{nonces.[0]}}">
    window.instana = {
      build: {{{build}}},
      config: {{{config}}},
      numberLocale: {{{numberLocale}}}
    };
  </script>

  {{#if eumTrackingApiKey}}
  <script nonce="{{nonces.[1]}}">
    (function(c,e,f,k,g,h,b,a,d){c[g]||(c[g]=h,b=c[h]=function(){
    b.q.push(arguments)},b.q=[],b.l=1*new Date,a=e.createElement(f),a.async=1,
    a.src=k,a.setAttribute('crossorigin', 'anonymous'),d=e.getElementsByTagName(f)[0],
    d.parentNode.insertBefore(a,d))})(window,document,'script',
    '//{{eumRetrievalDomain}}/eum.min.js','InstanaEumObject','ineum');
    ineum('key', '{{eumTrackingApiKey}}');
    ineum('reportingUrl', '//{{eumTrackingDomain}}');
    ineum('beaconBatchingTime', 3000);
    ineum('traceId', '{{backendTraceId}}');
    ineum('ignoreUrls', [/.*\/api\/data.*/i, /.*\/build\.json.*/i, /.*\/notifications\/.*.md.*/i, /^https:\/\/api\.mixpanel\.com\/track.*/i]);
    ineum('meta', 'build.tag', window.instana.build.tag);
    ineum('meta', 'build.revision', window.instana.build.revision);
    ineum('meta', 'build.date', window.instana.build.date);
    ineum('meta', 'tenant', window.instana.config.tenant);
    ineum('meta', 'unit', window.instana.config.tenantUnit);
    ineum('meta', 'region', window.instana.config.region);
  </script>
  {{/if}}
</head>
<body>
  <div id="main">
    <div class="in-index-centered-content">
      <svg class="in-index-centered-content__loading-spinner" x="0px" y="0px" viewBox="0 0 24 24">
        <path fill="#fff" d="M12,4a8,8,0,0,0-8,8H6a6,6,0,1,1,6,6v2A8,8,0,0,0,12,4Z"/>
      </svg>
    </div>
  </div>

  <noscript>
    <div class="in-index-centered-content">
      <div class="left-side">
        <h1 class="title">
          JavaScript disabled
        </h1>
        <p class="message">
          The Instana interface requires JavaScript. Please enable JavaScript in your browser to continue.
        </p>
      </div>
    </div>
  </noscript>

  <script src="/bundle/waiting-{{waitingJsChecksum}}.js"></script>
</body>
</html>

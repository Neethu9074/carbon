{
  "name": "ui-client",
  "version": "1.0.0",
  "description": "Instana frontend server",
  "main": "index.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node .",
    "test": "jest --testTimeout 5000",
    "test:watch": "jest --watch",
    "build:ssrclean": "cd generate-error-page-content && rm -rf dist",
    "build:pagesapp": "cd generate-error-page-content && vite build --ssr src/pageserver.jsx --outDir dist/server",
    "build:staticpages": "cd generate-error-page-content && vite build --outDir templates && yarn build:pagesapp && node prerender.mjs && yarn build:ssrclean"
  },
  "repository": {
    "type": "git",
    "url": "https://github.ibm.com/instana/ui-client.git"
  },
  "dependencies": {
    "@instana/collector": "^4.0.0",
    "cookie-parser": "^1.4.5",
    "d3-format": "3.1.0",
    "express": "4.21.2",
    "handlebars": "^4.7.7",
    "helmet": "7.1.0",
    "http-terminator": "^3.2.0",
    "i18next": "24.2.3",
    "i18next-http-middleware": "3.7.1",
    "js-yaml": "^4.0.0",
    "lodash": "^4.17.21",
    "node-fetch": "2.6.7",
    "pg": "^8.5.1",
    "pino": "^6.13.1",
    "pino-http": "^5.7.0",
    "pino-std-serializers": "^4.0.0",
    "uglify-js": "^3.14.3",
    "uuid": "^8.3.2"
  },
  "keywords": [
    "ui",
    "ui-client",
    "express"
  ],
  "devDependencies": {
    "@carbon/ibm-products": "2.55.0",
    "@carbon/icons-react": "11.45.0",
    "@carbon/react": "^1.72.0",
    "@vitejs/plugin-react": "^4.4.1",
    "fetch-mock-jest": "^1.5.1",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "sass": "^1.51.0",
    "vite": "^4.3.8"
  },
  "resolutions": {
    "lottie-web": ">=5.13.0"
  },
  "packageManager": "yarn@1.22.22"
}

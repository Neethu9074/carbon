<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Unauthorized - Instana</title>

  <script nonce="{{nonce}}">
    window.location.href = '{{{signInUrl}}}?returnUrl={{{returnUrlWithoutHash}}}' + encodeURIComponent(window.location.hash);
  </script>
</head>
<body>
  <main>
    <h1 class="title">
      Unauthorized
    </h1>

    <p class="message">
      You are not signed in.
    </p>
  </main>
</body>
</html>

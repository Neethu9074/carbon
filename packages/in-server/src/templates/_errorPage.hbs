<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <link rel="apple-touch-icon-precomposed" sizes="57x57" href="apple-touch-icon-57x57.png" />
  <link rel="apple-touch-icon-precomposed" sizes="72x72" href="apple-touch-icon-72x72.png" />
  <link rel="apple-touch-icon-precomposed" sizes="120x120" href="apple-touch-icon-120x120.png" />
  <link rel="apple-touch-icon-precomposed" sizes="152x152" href="apple-touch-icon-152x152.png" />
  <link rel="icon" type="image/png" href="favicon-32x32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="favicon-16x16.png" sizes="16x16" />
  <title>{{title}} - Instana</title>
  <link rel="stylesheet" href="/errorPages/main.css">
</head>
<body>
  <div class="left-side-content">
    <h1 class="title">
      {{title}}
    </h1>

    <p class="message">
      {{message}}
    </p>

    <a class="link-button" href="http://instana.statuspage.io/">
      Instana Status Page
    </a>
    <a class="link-button" href="https://support.instana.com/hc/en-us/requests/new">
      Support
    </a>
  </div>

  {{#if showStan}}
    <img src="/errorPages/stan-pulling-the-plug.png"
         alt="Stan pulling the plug (accidentally)"
         class="right-side-stan">
  {{/if}}
</body>
</html>

<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <link rel="apple-touch-icon-precomposed" sizes="57x57" href="apple-touch-icon-57x57.png" />
  <link rel="apple-touch-icon-precomposed" sizes="72x72" href="apple-touch-icon-72x72.png" />
  <link rel="apple-touch-icon-precomposed" sizes="120x120" href="apple-touch-icon-120x120.png" />
  <link rel="apple-touch-icon-precomposed" sizes="152x152" href="apple-touch-icon-152x152.png" />
  <link rel="icon" type="image/x-icon" href="favicon-32x32.png" sizes="any" />
  <title>{{title}} - Instana</title>
  <link rel="stylesheet" href="/errorPages/css/pageserver.css">
</head>
<body>

  {{> (whichError content) }}

  {{#if signOut}}
    <script nonce="{{nonce}}">
        document.getElementById('access-denied-signout-form').setAttribute("action", '{{{signOutUrl}}}?returnUrl={{{returnUrlWithoutHash}}}' + encodeURIComponent(window.location.hash));
    </script>
  {{/if}}
</body>
</html>

<!doctype html>
<html>
<head>
  <meta charset="UTF-8"
        name="viewport"
        content="initial-scale=1">

  <link rel="apple-touch-icon-precomposed" sizes="57x57" href="apple-touch-icon-57x57.png" />
  <link rel="apple-touch-icon-precomposed" sizes="72x72" href="apple-touch-icon-72x72.png" />
  <link rel="apple-touch-icon-precomposed" sizes="120x120" href="apple-touch-icon-120x120.png" />
  <link rel="apple-touch-icon-precomposed" sizes="152x152" href="apple-touch-icon-152x152.png" />
  <link rel="icon" type="image/x-icon" href="favicon-32x32.png" sizes="any" />
  <link rel="stylesheet" href="/bundle/compStyle-{{compStyleCssChecksum}}.css"/>

  <title>Instana</title>

  {{#each prefetchItems}}
  <link rel="{{rel}}" href="/bundle/{{fileName}}" as="{{as}}">
  {{/each}}

  <script nonce="{{nonce}}">
    window.instana = {
      user: {{{user}}},
      build: {{{build}}},
      config: {{{config}}},
      searchFields: {{{searchFields}}},
      settings: {{{settings}}},
      permissions: {{{permissions}}},
      tags: {{{tags}}},
      csrf: {{{csrf}}},
      numberLocale: {{{numberLocale}}},
      termsAndPrivacySettings: {{{termsAndPrivacySettings}}},
      termsAndPrivacyAccepted: {{{termsAndPrivacyAccepted}}},
      reportingData: {{{reportingData}}},
      starredItems: {{{starredItems}}}
    };
  </script>

  {{#if ibmCommonEnabled }}
     <script type="text/javascript" nonce="{{nonce}}">
      // this solution was found by re-engineering https://tags.tiqcdn.com/utag/ibm/web/prod/utag.js.
      // At the moment this is the simplest solution to or a work around, but it was not officially documented
      // Once the new design on cookie consent is delivered, it will be removed, and
      // the telium cookie banner will be used instead of the current Instana privacy consent dialog box.
      document.cookie = "notice_close=true"; // Manually closing the cookie banner since we are accepting it from the privacy dialog.
      window._ibmAnalytics = {
         "settings": {
            "name": "instana",
            "isSpa": true,
            "tealiumProfileName": "in-app-usage"
         },
          "trustarc": {
            "isCookiePreferencesInstalled": true,
      },
         "digitalData.page.pageInfo.walkme.enabled": {{walkmeEnabled}},
         "digitalData.page.pageInfo.walkme.id": "9ef25d161f0e453a8f3e4dea9390a967",
         "digitalData.page.pageInfo.walkme.test": {{walkmeTestEnabled}},
      };
      digitalData = {
         "page": {
            "pageInfo": {
               "ibm": {
                  "siteId": "IBM_" + _ibmAnalytics.settings.name,
               }
            },
            "category": {
               "primaryCategory": "PC110"
            }
         }
      };
     </script>
     <script nonce="{{nonce}}"src="//1.www.s81c.com/common/stats/ibm-common.js" type="text/javascript" async="async"></script>
  {{/if}}

  {{#if isAssistMeEnabled }}
    <script type="text/javascript" crossorigin="anonymous" nonce="{{nonce}}"
    async defer src="https://www.ibm.com/resources/assist-me/controller.js">
    </script>
  {{/if}}
  {{#if eumTrackingApiKey}}
  <script nonce="{{nonce}}">
    (function(s,t,a,n){s[t]||(s[t]=a,n=s[a]=function(){n.q.push(arguments)},
    n.q=[],n.v=2,n.l=1*new Date)})(window,"InstanaEumObject","ineum");

    ineum('key', '{{eumTrackingApiKey}}');
    ineum('trackSessions');
    ineum('reportingUrl', '//{{eumTrackingDomain}}');
    ineum('beaconBatchingTime', 1000);
    ineum('traceId', '{{backendTraceId}}');
    ineum('ignoreUrls', [/.*\/api\/data.*/i, /.*\/build\.json.*/i, /.*\/notifications\/.*.md.*/i]);
    ineum('ignoreErrorMessages', [/^script error/i, /^ResizeObserver loop/i, /^Unhandled promise rejection: Loading chunk/i]);
    ineum('user', instana.user.id, instana.user.fullName, instana.user.email);
    ineum('meta', 'build.tag', window.instana.build.tag);
    ineum('meta', 'build.revision', window.instana.build.revision);
    ineum('meta', 'build.date', window.instana.build.date);
    ineum('meta', 'tenant', window.instana.config.tenant);
    ineum('meta', 'unit', window.instana.config.tenantUnit);
    ineum('meta', 'region', window.instana.config.region);
    ineum('meta', 'instanaRegion', window.instana.config.instanaRegion);
    if (window.instana.termsAndPrivacySettings) {
      ineum('meta', 'allAnalyticsServices', window.instana.termsAndPrivacySettings.allAnalyticsServices);
      ineum('meta', 'walkmeAnalyticsServices', window.instana.termsAndPrivacySettings.walkmeAnalyticsServices);
      ineum('meta', 'assistmeGuidanceServices', window.instana.termsAndPrivacySettings.assistmeGuidanceServices);
      ineum('meta', 'allSupportAndResearchServices', window.instana.termsAndPrivacySettings.allSupportAndResearchServices);
      ineum('meta', 'productTips', window.instana.termsAndPrivacySettings.productTips);
      ineum('meta', 'testingGroup', window.instana.termsAndPrivacySettings.testingGroup);
      ineum('meta', 'selfDefinedRole', window.instana.termsAndPrivacySettings.dynamicRole || window.instana.termsAndPrivacySettings.role);
    }
  </script>
  {{#if eumEnableSri}}
  <script defer crossorigin="anonymous" integrity="{{eumAgentSri}}" src="https://{{eumRetrievalDomain}}/{{eumAgentVersion}}/eum.min.js"></script>
  {{else}}
  <script defer crossorigin="anonymous" src="https://{{eumRetrievalDomain}}/eum.min.js"></script>
  {{/if}}
  {{/if}}

</head>
<body>
  <div id="main">
    <div class="in-index-centered-content">
      <svg class="in-index-centered-content__loading-spinner" x="0px" y="0px" viewBox="0 0 24 24">
        <path fill="#fff" d="M12,4a8,8,0,0,0-8,8H6a6,6,0,1,1,6,6v2A8,8,0,0,0,12,4Z"/>
      </svg>
    </div>
  </div>

  <noscript>
    <div class="in-index-centered-content">
      <div class="left-side">
        <h1 class="title">
          JavaScript disabled
        </h1>
        <p class="message">
          The Instana interface requires JavaScript. Please enable JavaScript in your browser to continue.
        </p>
      </div>
    </div>
  </noscript>

  <script defer src="/bundle/index-{{indexJsChecksum}}.js"></script>
</body>
</html>

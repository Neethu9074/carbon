<!doctype html>
<html>
<head>
  <meta charset="UTF-8"
        name="viewport"
        content="initial-scale=1">

  <link rel="apple-touch-icon-precomposed" sizes="57x57" href="apple-touch-icon-57x57.png" />
  <link rel="apple-touch-icon-precomposed" sizes="72x72" href="apple-touch-icon-72x72.png" />
  <link rel="apple-touch-icon-precomposed" sizes="120x120" href="apple-touch-icon-120x120.png" />
  <link rel="apple-touch-icon-precomposed" sizes="152x152" href="apple-touch-icon-152x152.png" />
  <link rel="icon" type="image/x-icon" href="favicon-32x32.png" sizes="any" />
  <link rel="stylesheet" href="/bundle/compStyle-{{compStyleCssChecksum}}.css"/>

  <title>Instana</title>

  {{#each prefetchItems}}
  <link rel="{{rel}}" href="/bundle/{{fileName}}" as="{{as}}">
  {{/each}}

  <script nonce="{{nonce}}">
    window.instana = {
      user: {{{user}}},
      build: {{{build}}},
      config: {{{config}}},
      searchFields: {{{searchFields}}},
      settings: {{{settings}}},
      permissions: {{{permissions}}},
      tags: {{{tags}}},
      csrf: {{{csrf}}},
      numberLocale: {{{numberLocale}}},
      termsAndPrivacySettings: {{{termsAndPrivacySettings}}},
      termsAndPrivacyAccepted: {{{termsAndPrivacyAccepted}}},
      reportingData: {{{reportingData}}},
      starredItems: {{{starredItems}}}
    };
  </script>
  {{#if injectWalkMeScript }}
    <script type="text/javascript" nonce="{{nonce}}">
      (function() {
        var walkme = document.createElement('script');
        walkme.type = 'text/javascript';
        walkme.async = true;
        walkme.src = 'https://cdn.walkme.com/private-bucket/ibm/users/9ef25d161f0e453a8f3e4dea9390a967/walkme_9ef25d161f0e453a8f3e4dea9390a967_https.js';
        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(walkme, s);
        window._walkmeConfig = {smartLoad:true}; })();
    </script>
  {{/if}}
  {{#if injectWalkMeTestScript }}
  <script type="text/javascript" nonce="{{nonce}}">
    (function() {
    var walkme = document.createElement('script');
    walkme.type = 'text/javascript';
    walkme.async = true;
    walkme.src = 'https://cdn.walkme.com/private-bucket/ibm/users/9ef25d161f0e453a8f3e4dea9390a967/test/walkme_9ef25d161f0e453a8f3e4dea9390a967_https.js';
    var s = document.getElementsByTagName('script')[0];
    s.parentNode.insertBefore(walkme, s);
    window._walkmeConfig = {smartLoad:true}; })();
  </script>
  {{/if}}
  {{#if isAssistMeEnabled }}
    <script type="text/javascript" crossorigin="anonymous" nonce="{{nonce}}"
    async defer src="https://www.ibm.com/resources/assist-me/controller.js">
    </script>

    <script type="text/javascript" nonce="{{nonce}}">
      (function() {
        var walkme = document.createElement('script');
        walkme.type = 'text/javascript';
        walkme.async = true;
        walkme.src = 'https://cdn.walkme.com/private-bucket/ibm/users/9ef25d161f0e453a8f3e4dea9390a967/walkme_9ef25d161f0e453a8f3e4dea9390a967_https.js';
        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(walkme, s);
        window._walkmeConfig = {smartLoad:true}; })();
    </script>
  {{/if}}
  {{#if eumTrackingApiKey}}
  <script nonce="{{nonce}}">
    (function(s,t,a,n){s[t]||(s[t]=a,n=s[a]=function(){n.q.push(arguments)},
    n.q=[],n.v=2,n.l=1*new Date)})(window,"InstanaEumObject","ineum");

    ineum('key', '{{eumTrackingApiKey}}');
    ineum('trackSessions');
    ineum('reportingUrl', '//{{eumTrackingDomain}}');
    ineum('beaconBatchingTime', 1000);
    ineum('traceId', '{{backendTraceId}}');
    ineum('ignoreUrls', [/.*\/api\/data.*/i, /.*\/build\.json.*/i, /.*\/notifications\/.*.md.*/i, /^https:\/\/api(-js)?\.mixpanel\.com.*/i]);
    ineum('ignoreErrorMessages', [/^script error/i, /^ResizeObserver loop/i, /^Unhandled promise rejection: Loading chunk/i]);
    ineum('user', instana.user.id, instana.user.fullName, instana.user.email);
    ineum('meta', 'build.tag', window.instana.build.tag);
    ineum('meta', 'build.revision', window.instana.build.revision);
    ineum('meta', 'build.date', window.instana.build.date);
    ineum('meta', 'tenant', window.instana.config.tenant);
    ineum('meta', 'unit', window.instana.config.tenantUnit);
    ineum('meta', 'region', window.instana.config.region);
    ineum('meta', 'instanaRegion', window.instana.config.instanaRegion);
    if (window.instana.termsAndPrivacySettings) {
      ineum('meta', 'allAnalyticsServices', window.instana.termsAndPrivacySettings.allAnalyticsServices);
      ineum('meta', 'allSupportAndResearchServices', window.instana.termsAndPrivacySettings.allSupportAndResearchServices);
      ineum('meta', 'productTips', window.instana.termsAndPrivacySettings.productTips);
      ineum('meta', 'testingGroup', window.instana.termsAndPrivacySettings.testingGroup);
      ineum('meta', 'selfDefinedRole', window.instana.termsAndPrivacySettings.dynamicRole || window.instana.termsAndPrivacySettings.role);
    }
  </script>
  {{#if eumEnableSri}}
  <script defer crossorigin="anonymous" integrity="{{eumAgentSri}}" src="https://{{eumRetrievalDomain}}/{{eumAgentVersion}}/eum.min.js"></script>
  {{else}}
  <script defer crossorigin="anonymous" src="https://{{eumRetrievalDomain}}/eum.min.js"></script>
  {{/if}}
  {{/if}}

  {{#if mixpanelToken}}
  <script nonce="{{nonce}}">
    (function(e,a){if(!a.__SV){var b=window;try{var c,l,i,j=b.location,g=j.hash;c=function(a,b){return(l=a.match(RegExp(b+"=([^&]*)")))?l[1]:null};g&&c(g,"state")&&(i=JSON.parse(decodeURIComponent(c(g,"state"))),"mpeditor"===i.action&&(b.sessionStorage.setItem("_mpcehash",g),history.replaceState(i.desiredHash||"",e.title,j.pathname+j.search)))}catch(m){}var k,h;window.mixpanel=a;a._i=[];a.init=function(b,c,f){function e(b,a){var c=a.split(".");2==c.length&&(b=b[c[0]],a=c[1]);b[a]=function(){b.push([a].concat(Array.prototype.slice.call(arguments,0)))}}var d=a;"undefined"!==typeof f?d=a[f]=[]:f="mixpanel";d.people=d.people||[];d.toString=function(b){var a="mixpanel";"mixpanel"!==f&&(a+="."+f);b||(a+=" (stub)");return a};d.people.toString=function(){return d.toString(1)+".people (stub)"};k="disable time_event track track_pageview track_links track_forms register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user".split(" ");for(h=0;h<k.length;h++)e(d,k[h]);a._i.push([b,c,f])};a.__SV=1.2;b=e.createElement("script");b.setAttribute("crossorigin","anonymous");b.type="text/javascript";b.async=!0;b.src="undefined"!==typeof MIXPANEL_CUSTOM_LIB_URL?MIXPANEL_CUSTOM_LIB_URL:"file:"===e.location.protocol&&"//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js".match(/^\/\//)?"https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js":"//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";c=e.getElementsByTagName("script")[0];c.parentNode.insertBefore(b,c)}})(document,window.mixpanel||[]);
    window.mixpanel&&window.mixpanel.init('{{mixpanelToken}}');
  </script>
  {{/if}}

  {{#if appcuesId}}
  <script id="appcuesScript" async crossorigin="anonymous" src="//fast.appcues.com/{{appcuesId}}.js"></script>
  {{/if}}

</head>
<body>
  <div id="main">
    <div class="in-index-centered-content">
      <svg class="in-index-centered-content__loading-spinner" x="0px" y="0px" viewBox="0 0 24 24">
        <path fill="#fff" d="M12,4a8,8,0,0,0-8,8H6a6,6,0,1,1,6,6v2A8,8,0,0,0,12,4Z"/>
      </svg>
    </div>
  </div>

  <noscript>
    <div class="in-index-centered-content">
      <div class="left-side">
        <h1 class="title">
          JavaScript disabled
        </h1>
        <p class="message">
          The Instana interface requires JavaScript. Please enable JavaScript in your browser to continue.
        </p>
      </div>
    </div>
  </noscript>

  <script defer src="/bundle/index-{{indexJsChecksum}}.js"></script>
</body>
</html>

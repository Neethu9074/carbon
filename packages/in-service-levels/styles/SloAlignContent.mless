:local {
  .stackAlignCenter {
    display: flex;
    flex-flow: row;
    align-items: center;
  }

  .stackAlignEnd {
    display: flex;
    flex-flow: column;
    align-items: flex-end;
  }

  .overflowMenuItemContainer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
}

:local {
  .slo-filters-accordion {
    .slo-filters-accordion-item {
      :global(.cds--accordion__content) {
        padding-right: 1rem;
      }

      :global(.stack),
      :global(.cds--radio-button-group) {
        width: 100%;
      }

      .slo-filters-accordian-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
    }
  }
}

:local {
  .flyout--container {
    padding: 1rem;
  }

  .flyout--container .flyout--container__filters {
    display: grid;
    grid-template-columns: auto auto;
    gap: 1rem;
  }

  .flyout--label {
    font-weight: 600;
  }

  .filter-flyout-button-set:global(.cds--btn-set) :global(.cds--btn) {
    max-width: none;
    width: 50%;
  }
}

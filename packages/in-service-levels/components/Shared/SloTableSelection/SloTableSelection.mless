:local {
  .loadMore {
    justify-content: center;
    color: var(--cds-link-primary);
  }

  .checkBoxItem {
    margin-top: 3px;
  }

  .withError {
    border-color: var(--ids-color-option-red-500);
  }

  .disabled {
    pointer-events: none;
  }
}

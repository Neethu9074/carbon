:local {
  .cardHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.45rem;
  }

  .tagSet {
    :global(.c4p--tag-set-overflow__tag-item.c4p--tag-set-overflow__tag-item--default .cds--tag) {
      padding-bottom: 12px;
      font-size: 0.75rem;
    }
    :global(.c4p--tag-set-overflow__tag-list) {
      margin-bottom: 0;
    }
    :global(.c4p--tag-set-overflow__show-all-tags-link) {
      font-size: 0.75rem;
    }
  }
}

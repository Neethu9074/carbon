:local {
  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
      padding-left: 0rem;
      padding-right: 2rem;
    }

    &.optionBoxUnchecked {
      svg {
        fill: var(--ids-color-option-neutral-600);
      }

      * {
        color: var(--ids-color-option-neutral-600);
      }
    }
  }
  .endpointField {
    display: inline;
  }
}

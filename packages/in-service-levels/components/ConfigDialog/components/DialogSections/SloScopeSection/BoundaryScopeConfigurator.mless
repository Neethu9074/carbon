@import '~in-themes/active.less';

:local {
  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
      padding-left: 0rem;
      padding-right: 2rem;
    }

    &.optionBoxUnchecked {
      svg {
        fill: @lib__colors__N600Light;
      }

      * {
        color: @lib__colors__N600Light;
      }
    }
  }
}

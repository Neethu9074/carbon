:local {
  .notificationContainer {
    width: 20rem;
    :global {
      .cds--toast-notification__title {
        font-weight: normal;
      }
    }
  }

  .toggleContainer {
    width: 5rem;
  }

  .timeZoneLabelContainer {
    display: flex;
    padding: 0.25rem 0;
    gap: 0.25rem;
  }

  .selectField {
    width: 20rem;
    :global {
      .cds--list-box--sm {
        block-size: 3rem;
        max-block-size: 3rem;
      }
    }
  }
}

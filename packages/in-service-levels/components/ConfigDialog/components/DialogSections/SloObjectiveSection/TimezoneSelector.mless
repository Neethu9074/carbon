:local {
  .notificationContainer {
    width: 435px;
    :global {
      .cds--toast-notification__title {
        font-weight: normal;
      }
    }
  }
  .selectField {
    margin-top: 15px;
    :global {
      .cds--list-box--sm {
        block-size: 3rem;
        max-block-size: 3rem;
      }
    }
  }
}

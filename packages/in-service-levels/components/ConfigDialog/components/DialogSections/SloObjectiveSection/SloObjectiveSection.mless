:local {
  .estimatedBudgetSection {
    padding: var(--ids-border-radius-option-large);
    min-width: 15rem;
  }

  .estimatedBudgetSkeleton {
    height: var(--ids-font-size-option-body-bold);
    padding: var(--ids-border-radius-option-medium);
    margin: var(--ids-border-radius-option-medium);
    width: 80%;
  }

  .inputSection {
    flex: 1;
  }

  .objectiveInput {
    max-width: 10rem;
  }

  .percentageInput {
    display: inline-block;
    min-width: 10rem;
  }

  .selectField {
    width: auto;
  }
}

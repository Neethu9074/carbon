@import '~in-themes/active.less';

:local {
  .header {
    height: 2.25rem;
    padding: 0 0.75rem;
    background: #40535b;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
  }

  .headerCell {
    border-right: 1px solid #40535b;
    padding: 0;
    height: 100%;

    &:last-child {
      border-right: 0;
    }
  }

  .headerRight {
    display: flex;
    align-items: center;
  }

  .headerToggleCell {
    background: #6b8088;
    border-right: 1px solid #40535b;
    width: 1.6rem;
  }

  .cell {
    padding: 0 0.5rem;
    // allow bar charts to use 100% height
    height: 100%;
    line-height: 1.625rem;
    border-bottom: 1px solid #d5dfe4;
    border-left: 1px solid #d5dfe4;

    &:first-child {
      border-left: 0;
    }
  }

  .expanded {
    padding: 0.3rem 0.5rem 0.6rem;
    line-height: 1;
  }

  .columnHeader {
    background: #6b8088;
  }

  .expansionSwitch {
    height: 24px;
  }

  .paginationWrapper {
    transform: scale(0.85);
  }
}

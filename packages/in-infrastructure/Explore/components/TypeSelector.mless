@import '~in-themes/mixins.less';

:local {
  .dropdown {
    width: 15rem;
    max-height: 30vh;
    overflow-y: scroll;
  }

  .searchWrapper {
    padding: 0.5rem;
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    background: var(--ids-color-option-neutral-50);
  }

  .typeRow {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }

  .icon {
    padding-right: 0.25rem;
  }

  .header {
    font-size: 1.375rem;
    font-weight: 500;
    min-width: 10rem;
  }

  .headerButton {
    line-height: 1.15;
  }

  .defaultButton {
    background: var(--ids-color-option-white);
  }
}

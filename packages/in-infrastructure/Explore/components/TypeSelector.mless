@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .dropdown {
    width: 15rem;
    max-height: 30vh;
    overflow-y: scroll;
  }

  .searchWrapper {
    padding: 0.5rem;
    border-bottom: 1px solid @lib__colors__N300;
    background: @lib__colors__N050;
  }

  .typeRow {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }

  .icon {
    padding-right: 0.25rem;
  }

  .header {
    font-size: 1.375rem;
    font-weight: 500;
    min-width: 10rem;
  }

  .button {
    line-height: @lib__typography__line-height;
  }
}

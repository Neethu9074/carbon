@import '~in-themes/mixins.less';

:local {
  .metricLabel {
    padding-right: 2rem !important;
  }

  .entityLink {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background-color: @lib__colors__N700Medium;
  }
}

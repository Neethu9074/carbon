 @import '~in-themes/mixins.less';

:local {
  .content {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .label {
    .ellipsis();
    text-align: center;
  }

  .skeleton {
    width: 100%;
    height: 1rem;
  }
}

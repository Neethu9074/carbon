@import '~in-themes/mixins.less';

:local {
  .content {
    width: 100%;
    display: flex;
    flex-direction: row;
  }

  .label {
    .ellipsis();
    .alignLeft();
  }

  .aggregation {
    margin-left: 0.25rem;
  }

  .skeleton {
    width: 100%;
    height: 1rem;
  }
  .bdi {
    table-layout: fixed;
    width: auto;
    display: table;
    direction: rtl;
  }
  .carbonHeadercontent {
    display: flex;
    :global(.carbonTooltipPopoverWrapper) {
      text-align: left;
    }
  }
  .carbonHeaderEllipsis {
    .ellipsis();
  }
}

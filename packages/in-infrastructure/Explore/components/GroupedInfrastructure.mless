@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .list {
    width: 100%;

    & + .list {
      margin-top: 0.125rem;
    }
  }

  .icon {
    vertical-align: middle;
  }

  .metricLabel {
    padding-right: 2rem !important;
  }

  .wordBreak {
    word-break: break-word;
  }

  .italic {
    font-style: italic;
  }

  .carbonHeaderLabel {
    word-break: break-all;
    height: 1.9rem;
    white-space: inherit;
    overflow: hidden;
    text-overflow: ellipsis;
    align-content: center;
  }

  .carbonHeaderCountLabelColumn {
    white-space: inherit;
    overflow: hidden;
    text-overflow: ellipsis;
    align-content: center;
  }

  .carbonRowWordBreak {
    word-break: break-word;
    min-width: 3rem;
  }
  .bdi {
    .ellipsis();
    table-layout: fixed;
    width: 100%;
    display: table;
    direction: rtl;
  }
  .carbonHeaderEllipsis {
    .ellipsis();
    display: block;
    text-align: left;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mediaQueries.less';

:local {
  .mainContent {
    height: 100%;
    position: relative;
  }

  .wrapper {
    width: 100%;
    min-height: ~'calc(100vh - 128px)';
    display: flex;

    overflow-x: hidden;

    // establish this element as an offset wrapper so that offset calculations work for
    // dashboard navigation.
    position: relative;
  }

  .sidebar {
    background: @lib__colors__N100;
    min-height: 100%;
    border-right: 1px solid @lib__colors__N300;
  }

  .content {
    width: ~'calc(100% - 320px)';
    height: 100%;
    box-sizing: border-box;
    padding: 1rem 1.5rem 1rem 1rem;

    &::after {
      width: 100%;
      height: 1rem;
      content: ' ';
      display: block;
    }
  }

  .loadingIndicatorWrapper {
    display: flex;
    align-items: center;
    justify-content: center;

    padding-top: 45vh;
  }

  @media @min-medium-screen {
    .content {
      width: ~'calc(100% - 400px)';
    }
  }
}

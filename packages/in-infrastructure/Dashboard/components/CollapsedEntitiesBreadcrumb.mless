@import '~in-themes/active.less';

:local {
  .collapsedBreadcrumb {
    &:hover {
      .expandIcon {
        fill: var(--ids-color-option-neutral-50);
      }
    }
  }

  .flexWrapper {
    display: flex;
    align-items: center;
  }

  .expandIcon {
    margin-right: 0.5rem;
    fill: var(--ids-color-option-neutral-500);
  }

  .light {
    opacity: 0.6;
  }

  .listBreadcrumb {
    width: 100%;
  }
}

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .label {
    margin: 0.625rem 0 0 0;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    align-items: center;

    .ellipsis();
    .alignLeft();

    :global {
      .carbon-form-label {
        margin-bottom: 0;
      }
    }
  }

  .aggregations {
    background-color: var(--ids-color-option-white);
  }

  .skeleton {
    width: 100%;
    height: 1rem;
  }
}

.crossSeriesAggregationToggle {
  cursor: pointer;
  font-size: 18px;
  user-select: none;

  color: @inactive-color;
  font-weight: normal;
  opacity: 0.5;

  &.enabled {
    opacity: 1;
  }

  &.active {
    color: #24a148;
    font-weight: bold;
  }
}

@inactive-color: #8c8c8c;

@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .label {
    font-size: 0.875rem;
    margin-bottom: 0;
    margin-top: 0.375rem;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    .ellipsis();
    .alignLeft();
    align-items: center;
  }

  .aggregations {
    background-color: @lib__colors__white;
  }

  .skeleton {
    width: 100%;
    height: 1rem;
  }

  .overlay {
    width: 26rem;
  }
}

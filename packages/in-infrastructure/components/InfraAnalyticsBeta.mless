:local {
  .betaMarker {
    background: var(--ids-color-option-neutral-100);
    border-radius: var(--ids-border-radius-small);
    color: var(--ids-color-option-neutral-800);
    border: 1px solid var(--ids-color-option-neutral-400);
    padding: 0.5rem 0.625rem;
    height: 2.6875rem;
    display: flex;
    align-items: center;
    font-size: 0.875rem;
  }

  .betaPill {
    margin-right: 0.4rem;
  }

  .betaLink {
    margin-left: 0.2rem;
    text-decoration: none !important;
  }
}

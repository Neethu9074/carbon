@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .dialog {
    max-width: 55vw;
  }
  .heading {
    padding-left: 0.5rem;
  }
  .wrapper {
    padding: 0px 0.5rem 0.5rem 0.5rem;
  }
  .tooltip {
    hyphens: none;
  }
  .archBox {
    border: 1px solid var(--ids-color-option-neutral-300);
  }
  .archboxview {
    padding-top: 0.5rem;
  }
  .codeBox {
    padding-top: 1rem;
  }
  .curlCommandBox {
    padding: 1rem 0 3rem 0;
  }
  .controls {
    padding: 1rem 0;
    position: absolute;
    bottom: 0;
    right: 0;
    left: 0;

    button {
      min-width: 6.25rem;
    }
  }
}

:local {
  .node {
    height: 50px;
    width: 50px;
  }

  .exporterNode {
    background-color: #78a9ff;
  }

  .processorNode {
    background-color: #a6c8ff;
  }

  .receiverNode {
    background-color: #edf5ff;
  }

  .pipelineNode {
    background-color: #4589ff33;
  }
}

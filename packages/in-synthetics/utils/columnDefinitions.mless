@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .secText {
    font-size: 0.75rem;
    color: @lib__colors__N600Light;
  }

  .ellipsis {
    max-width: 90%;
    display: block;
    .ellipsis();
  }

  .label {
    font-weight: @lib__typography__h400__font-weight;
    margin-bottom: 0.25rem;
  }
}

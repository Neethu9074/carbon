@import '~in-themes/mixins.less';

:local {
  .header {
    justify-content: space-between;
    min-width: 30rem;
    padding: 1rem;
  }

  .content {
    padding-top: 1rem;
  }

  .primaryText {
    white-space: break-spaces;
    .breakWord();
    border-radius: 0;
    box-shadow: none;
  }

  .code {
    max-width: 42rem;
  }
}

:global {
  :local(.content) .language-json .token.property {
    color: var(--ids-color-option-pink-500);
  }
}

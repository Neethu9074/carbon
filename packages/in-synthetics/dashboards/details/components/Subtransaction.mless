:local {
  .subtransaction {
    border-top: 0.0625rem solid var(--ids-color-option-neutral-400);
    background: var(--ids-color-option-neutral-50);
    color: var(--ids-color-option-neutral-600);
    position: relative;
  }

  .erroneous::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.125rem;
    background: var(--ids-color-option-red-500);
    content: '';
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;

    &:hover,
    &:focus {
      outline: 0;
      background: var(--ids-color-option-neutral-300);
      cursor: pointer;
    }
  }

  .leftHeader {
    display: flex;
    align-items: center;
    overflow: hidden;

    & > * {
      &:nth-child(2) {
        max-width: 15rem;
        width: 15rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    }
  }

  .rightHeader {
    display: flex;
  }

  .body {
    margin: 1.2rem 1rem 0 5rem;
    padding-bottom: 2rem;
  }

  .type {
    margin: 0 1rem 0 0;
  }

  .subHeader {
    display: flex;
    flex-direction: column;
    margin: 0 3.5rem 0 0;
    line-height: 1.2;
  }

  .key {
    color: var(--ids-color-option-neutral-600);
    font-weight: 500;
    padding: 0 0 0.188rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .value {
    text-overflow: ellipsis;
  }
}

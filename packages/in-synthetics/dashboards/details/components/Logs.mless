@import '~in-themes/mixins.less';

:local {
  .loadingWrapper {
    display: flex;
    justify-content: center;
  }

  .listItem {
    align-items: stretch;
  }

  .dateTime {
    margin: 0.5rem 0 0.5rem 1.5rem;
  }

  .healthColumn {
    margin: 0.5rem 0.5rem 0 0.5rem;
  }

  .copyButtonWrapper,
  .centeredCopyButtonWrapper {
    display: flex;

    margin-left: 0.25rem;
  }

  .centeredCopyButtonWrapper {
    align-items: center;

    height: 100%;
  }

  .pill {
    min-width: 3.125rem;
    max-width: 5.125rem;

    .ellipsis();
  }

  .displayLinebreak {
    white-space: break-spaces;
    .breakWord();
    margin: 0.5rem 0 0.25rem 0;
  }

  .selectedRow {
    font-weight: bold;
  }

  .expandableCard {
    margin-bottom: 1rem;
  }
}

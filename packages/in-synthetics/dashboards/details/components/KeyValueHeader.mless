@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .subHeader {
    display: flex;
    flex-direction: column;
    margin: 0 3.5rem 0 1rem;
    line-height: 1.2;
  }

  .key {
    color: @lib__colors__N600Light;
    font-weight: 500;
    padding: 0 0 0.188rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .value {
    .ellipsis();
  }
}

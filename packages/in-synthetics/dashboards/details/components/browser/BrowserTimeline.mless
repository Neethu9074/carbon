:local {
  .timelineContainer {
    display: flex;
    flex-direction: column;
  }
  .entries {
    position: relative;
    height: 0.625rem;
  }

  .entry {
    position: absolute;
    height: 0.4375rem;
    min-width: 0.0625rem;
  }
}

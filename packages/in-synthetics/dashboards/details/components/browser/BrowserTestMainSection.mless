:local {
  .entries {
    height: 12.5rem;
    position: relative;
  }

  .entry {
    position: absolute;
    height: 0.3125rem;
    min-width: 0.0625rem;

    &:hover {
      cursor: pointer;
      opacity: 0.75;
    }
  }

  .tooltipWrapper {
    padding: 0.5rem;
  }

  .labelRow {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .label {
    max-width: 15rem;
    .ellipsis();
    font-weight: bold;
  }

  .timings {
    list-style: none;
    margin: 0;
  }

  .timing {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .key {
    color: var(--ids-color-option-neutral-800);
    font-weight: 500;
    margin-right: 1rem;
  }

  .value {
    color: var(--ids-color-option-neutral-900);
    margin: 0;
    max-width: 20rem;
    width: 20rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header {
    margin: 1.5rem 0 0.75rem;
  }
  .overviewChartContainer {
    padding: 0 1rem 1rem;
  }
}

:local {
  .failedTitle {
    color: #ff4229;
    :global(.card-header) {
      padding-bottom: 0;
    }
  }

  .errorMessageHeader {
    position: relative;
    color: var(--ids-color-option-neutral-900);
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.75rem;
  }
  .errorMessage {
    position: relative;
    color: var(--ids-color-option-neutral-900);
    margin-top: auto;
    margin-bottom: 0.75rem;
  }
  .stacktraceHeader {
    position: relative;
    margin-top: 1rem;
    margin-bottom: 0.75rem;
    span {
      font-weight: 600;
    }
  }
  .stacktraceMessage {
    position: relative;
    color: var(--ids-color-option-neutral-900);
    margin-top: auto;
    margin-bottom: 0.75rem;
  }
}

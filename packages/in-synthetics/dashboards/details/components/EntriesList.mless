:local {
  .groupFirstRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    &:hover,
    &:focus {
      outline: 0;
      background: var(--ids-color-option-neutral-300);
      cursor: pointer;
    }
  }

  .leftContent {
    display: flex;
    align-items: center;
    overflow: hidden;

    & > * {
      &:nth-child(2) {
        max-width: 15rem;
        width: 15rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      &:last-child {
        width: 70rem;
        margin: 0;
      }
    }
  }

  .rightContent {
    display: flex;
  }

  .pageName {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ids-color-option-neutral-600);
    margin: 0 0 0 0.5rem;
  }

  .entries {
    margin: 0rem 1.5rem 1rem;
  }

  .pageIcon path {
    fill: #a6a6a6;
  }

  .learnHow {
    margin: 0 0 0 1rem;
  }

  .bodyHeader {
    margin: 0 0 0.7rem;
    padding: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }
}

@import '~in-themes/mixins.less';

:local {
  .messageWrapper {
    display: flex;
    flex-direction: column;
  }

  .messageExpanded,
  .collapsedMessage {
    margin: 0.5rem 0 0.25rem 0;
  }

  .messageExpanded {
    white-space: break-spaces;
    .breakWord();
    cursor: pointer;
  }

  .collapsedMessage {
    .ellipsis();
  }

  .message {
    color: var(--ids-color-option-neutral-900);
  }

  .hovered {
    text-decoration: underline;
    cursor: pointer;
  }

  .parameter,
  .parameterClickable {
    color: var(--ids-color-option-neutral-500);
    font-style: italic;
  }

  .parameterClickable {
    cursor: pointer;
  }

  .parameterOpen {
    text-decoration: underline;
  }

  .list {
    min-width: 12.5rem;
  }

  .listItem {
    align-items: center;
  }
}

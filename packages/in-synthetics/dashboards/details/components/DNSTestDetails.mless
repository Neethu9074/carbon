:local {
  .dnsProperties {
    :global .cds--accordion__content {
      padding-inline-end: inherit;
    }
    :global .cds--tab-content {
      padding: 0;
    }
    :global .c4p--card__header {
      padding-bottom: 0;
    }
  }
  .emptyState {
    padding: 1rem;
  }
}

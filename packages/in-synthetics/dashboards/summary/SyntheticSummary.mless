@import '~in-themes/mixins.less';

:local {
  .label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ids-color-option-neutral-50);
    background: var(--ids-color-option-neutral-600);
    border-radius: 0.1rem;
    padding: 0.2rem 0.625rem;
    pointer-events: none;
    .ellipsis();
  }

  .metaInformation {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
}

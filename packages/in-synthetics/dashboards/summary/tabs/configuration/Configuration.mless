@import '~in-themes/mixins.less';

:local {
  // Configuration.tsx component
  .configuration {
    margin: auto;
    width: 50%;
  }
  // SettingsSection.tsx component.
  .configContainer {
    border: 0.0625rem solid var(--ids-color-option-neutral-300);
    padding: 0.625rem;
  }
  .configCheckbox {
    width: 50%;
  }
  .topSection {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
  }
  .bottomSection {
    margin-top: 1rem;
  }
  .expandableCard {
    margin-bottom: 1rem;
  }
  .configRow {
    border-bottom: 0.0625rem solid var(--ids-color-option-neutral-300);
    padding-bottom: 1rem;
  }
  .lastConfigRow {
    width: 100%;
    margin: 0 1rem 0 1rem;
  }
  .additionalOptionsRow {
    padding-left: 1rem;
  }
  .skeleton {
    display: block;

    width: 100%;
    height: 1rem;

    margin: 0.1rem 0;
  }
  .code {
    max-width: 100%;
  }
  .dialog {
    max-width: 40vw;
  }
  .confirmationDialogContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;
    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
  .buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: -1.5rem;
    padding: 0.5rem 1.5rem;
    background: var(--ids-color-option-neutral-400);
  }

  .urlConfig {
    .ellipsis();
  }

  .lastRow {
    border-bottom: none;
  }

  .loadMore {
    border-bottom: none;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 1rem;
    padding-bottom: 0;
  }
}

:global {
  :local(.content) .language-json .token.property {
    color: var(--ids-color-option-pink-500);
  }
}

@import '~in-themes/mixins.less';

:local {
  .metricLabel {
    white-space: nowrap;
  }

  .longLabel {
    max-width: 12.5rem;
    .ellipsis();
  }

  .popoverContent {
    :global(.cds--contained-list__header) {
      display: none;
    }
  }
  .noData {
    margin: 0.5rem;
  }
}

@import '~in-themes/mixins.less';

:local {
  .secText {
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-600);
  }

  .ellipsis {
    max-width: 90%;
    display: block;
    .ellipsis();
  }

  .label {
    font-weight: var(--ids-font-weight-option-heading-400);
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .okayIcon {
    fill: var(--ids-color-option-green-500);
  }

  .dotPadding {
    margin-right: 0.1rem;
  }

  .overlayHeader {
    position: relative;
    padding: 0;
    margin: 0;
    font-size: var(--ids-font-size-option-heading-200);
    font-weight: 300;
  }

  .title {
    font-weight: var(--ids-font-weight-option-heading-400);
    padding: 0.75rem 1rem;
  }

  .close {
    fill: var(--ids-font-size-option-heading-100);
    padding: 0.5rem;
  }

  .issues {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;

    @height-of-header-and-actions: 8.75rem;
    max-height: calc(70vh - @height-of-header-and-actions);
  }

  .issue {
    margin: 0;
    padding: 1rem 1rem 0.5rem 1rem;
    list-style: none;
    border-top: 1px solid var(--ids-color-option-neutral-300);
    position: relative;
    font-weight: var(--ids-font-weight-option-heading-400);

    &:first-child {
      border-top: 0;
    }
  }

  .labelApp {
    font-weight: var(--ids-font-weight-option-heading-400);
    margin-bottom: 0.25rem;
    cursor: pointer;
    color: var(--cds-link-primary);
  }

  // Locations column overlay styling

  .associationsList {
    max-height: 25rem;
    width: 30rem;
  }

  .locationItemsLeft {
    display: flex;
    align-items: center;
  }

  .locationItemsRight {
    display: flex;
  }

  .locationsLabel {
    font-weight: var(--ids-font-weight-option-heading-400);
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 1rem 0 1rem;
  }

  .associationsSidePanel {
    :global .cds--tab-content {
      padding: 0;
    }
    :global .cds--data-table th {
      border-block-end: none !important;
      border-block-start: none !important;
    }
    .noDataTile {
      padding: 2.5rem 2rem 2.5rem;
    }
  }
}

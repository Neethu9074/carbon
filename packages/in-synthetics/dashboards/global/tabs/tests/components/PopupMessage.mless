:local {
  .container {
    color: var(--ids-color-option-neutral-700);
    margin: 0.5rem 0;
    font-weight: var(--ids-font-weight-option-body-regular);
  }

  .title {
    font-size: var(--ids-font-size-option-heading-200);
    font-weight: 600;
    margin-top: 0.75rem;
  }

  .controls {
    font-size: var(--ids-font-size-option-heading-200);
    font-weight: 400;
  }
}

:local {
  .filterAccordion {
    .filterAccordionItem {
      :global(.cds--accordion__content) {
        padding-right: 1rem;
      }

      :global(.stack),
      :global(.cds--radio-button-group) {
        width: 100%;
      }

      .filterAccordionItemHeader {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
    }
  }
  .searchSortWrapper {
    display: flex;
    padding-bottom: 0.75rem;
  }
}

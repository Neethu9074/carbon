@import '~in-themes/active.less';

:local {
  .modalNotification {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    border: 1px solid;
    padding: 0.25rem 0.5rem;

    > button {
      margin-left: auto;

      &:hover {
        background: none;
      }
    }
    &-success {
      background: #e7f8f0;
      border-color: @lib__colors__success;
    }
    &-failure {
      background: #ffe0e0;
      border-color: #ff4040;
    }
  }
}

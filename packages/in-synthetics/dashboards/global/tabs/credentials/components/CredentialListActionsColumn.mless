:local {
  .dialog {
    max-width: 40vw;
  }
  .confirmationDialogContent {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;

    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }

  .buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: -1.5rem;
    padding: 0.5rem 1.5rem;
    background: var(--ids-color-option-neutral-400);
  }

  .editDialog {
    width: 80vw;
    height: 35vw;
    overflow-y: auto;
  }

  .stepOneWrapper {
    padding-right: 50%;
    padding-bottom: 2rem;
  }
}

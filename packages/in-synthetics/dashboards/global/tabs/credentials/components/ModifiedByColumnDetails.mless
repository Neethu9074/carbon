@import '~in-themes/mixins.less';

:local {
  .secText {
    font-size: 0.75rem;
    color: var(--ids-color-option-neutral-600);
  }

  .ellipsis {
    max-width: 90%;
    display: block;
    .ellipsis();
  }

  .label {
    font-weight: var(--ids-font-weight-option-heading-400);
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}

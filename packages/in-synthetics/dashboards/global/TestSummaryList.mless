:local {
  .listHeader {
    justify-content: flex-end;
  }

  .sortingConfiguratorWrapper {
    margin-right: 1rem;
  }

  .dropdownWidth {
    width: 14rem;
    :global .cds--list-box {
      max-block-size: 3rem !important;
    }
    :global .cds--dropdown {
      block-size: 3rem !important;
    }
  }

  .flyout {
    position: fixed;
    top: 6rem;
    right: 1.25rem;
    z-index: 300;
  }

  .toastMessage {
    :global .cds--actionable-notification__subtitle {
      padding: 0.5rem 0.5rem 0 0;
    }
  }
}

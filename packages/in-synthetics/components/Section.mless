@import '~in-themes/active.less';

:local {
  .container {
    padding-top: 2rem;
  }

  .heading {
    color: @lib__colors__N900Primary;
    font-size: 2rem;
    line-height: 2.5rem;
    margin: 0.5rem 0rem 1rem;
    font-weight: normal;
  }

  .subTitle {
    color: @lib__colors__teal800;
    font-size: 1rem;
    line-height: 1.2em;
    margin: 1rem 0rem 3rem 0rem;
  }

  .actionSubTitle {
    margin: 1rem 0rem;
  }

  .scriptSubTitle {
    margin: 0rem 0rem 3rem 0rem;
  }
}

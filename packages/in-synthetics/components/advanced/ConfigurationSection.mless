@import '~in-themes/active.less';

:local {
  .configContainer {
    border: 1px solid @lib__colors__N300;
    padding: 10px;
    margin-bottom: 2%;
  }

  .descriptionInput {
    flex: 1;
    .validationsBtn {
      padding-left: 0;
    }
  }

  .statusBox {
    width: 20%;
    font-weight: 600;
  }

  .validationsBtn {
    padding-left: 0;
  }

  .configCheckbox {
    width: 50%;
  }

  .deleteAction {
    display: flex;
    align-items: center;
  }
}

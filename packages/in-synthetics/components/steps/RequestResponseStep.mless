@import '~in-themes/active.less';

:local {
  .requestContainer {
    > div {
      width: 100%;
    }
  }

  .urlInput {
    flex: 1;
  }

  .subTitle {
    color: @lib__colors__teal800;
    font-size: 1rem;
    line-height: 1.2em;
    margin: 1rem 0rem;
  }

  .scriptUpload {
    flex: 1;
    z-index: 0;
  }
}

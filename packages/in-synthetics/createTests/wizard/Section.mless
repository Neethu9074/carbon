:local {
  .container {
    padding-top: 1rem;
  }

  .heading {
    color: var(--ids-color-option-neutral-900);
    font-size: 2rem;
    line-height: 2.5rem;
    margin: 0.5rem 0rem 1rem;
    font-weight: normal;
  }

  .subTitle {
    color: var(--ids-color-option-teal-500);
    font-size: 1rem;
    line-height: 1.2em;
    margin: 1rem 0rem 1rem 0rem;
  }

  .actionSubTitle {
    margin: 1rem 0rem;
  }

  .scriptSubTitle {
    margin: 0rem 0rem 3rem 0rem;
  }
}

:local {
  .subTitle {
    color: var(--ids-color-option-teal-500);
    font-size: 1rem;
    line-height: 1.2em;
    margin: 1rem 0rem;
  }

  .container {
    padding-bottom: 0;
    display: grid;
    max-height: calc(100vh - 5rem - 4rem - 3rem);
    grid-template-areas: 'content' 'errors';
    grid-auto-rows: 1fr min-content;
    overflow: auto;
  }

  .rightHeader {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .item {
    display: list-item;
    align-items: left;

    width: auto;
    padding: 0.3rem;
    border-bottom: 1px solid var(--ids-color-option-neutral-300);

    list-style: none;

    &:last-child {
      border-bottom: 0;
    }
  }
}

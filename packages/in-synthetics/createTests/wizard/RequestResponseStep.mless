:local {
  .requestContainer {
    > div {
      width: 100%;
    }
  }

  .urlInput {
    flex: 1;
  }

  .locationContainer {
    min-height: 25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scrollBox {
    min-height: 73.26%;
  }

  .subTitle {
    color: var(--ids-color-option-teal-500);
    font-size: 1rem;
    line-height: 1.2em;
    margin: 1rem 0rem;
  }

  .scriptUpload {
    flex: 1;
    z-index: 0;
  }
}

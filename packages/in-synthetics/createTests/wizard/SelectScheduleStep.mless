@import '~in-themes/active.less';

:local {
  .subTitle {
    color: @lib__colors__teal800;
    font-size: 1rem;
    line-height: 1.2em;
    margin: 1rem 0rem;
  }

  .radioGroup {
    > p {
      max-width: 100rem;
      margin: 0.2rem 0rem 1rem 1.5rem;
      color: @lib__colors__N700Medium;
    }
  }

  .outerBox {
    border: 1px solid @lib__colors__N300;
    padding: 10px;
    margin-bottom: 2%;
  }
}

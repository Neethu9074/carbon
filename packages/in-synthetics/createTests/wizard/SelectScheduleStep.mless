:local {
  .subTitle {
    color: var(--ids-color-option-teal-500);
    font-size: 1rem;
    line-height: 1.2em;
    margin: 1rem 0rem;
  }

  .radioGroup {
    > p {
      max-width: 100rem;
      margin: 0.2rem 0rem 1rem 1.5rem;
      color: var(--ids-color-option-neutral-700);
    }
  }

  .outerBox {
    border: 0.0625rem solid var(--ids-color-option-neutral-300);
    padding: 0.625rem;
    margin-bottom: 2%;
  }
}

:local {
  .container {
    padding: 0.5rem 0.5rem 0.5rem 0.5rem;
    display: grid;
    grid-template-columns: 1fr 2fr 2fr;
  }

  .spanTwoColumns {
    grid-column: 2 / span 2;
  }

  .bluePrintText {
    padding: 1rem;
    color: var(--ids-color-option-neutral-600);
  }

  .disabled {
    pointer-events: none;
  }

  .testTypeGrid {
    grid-template-columns: 2fr 2fr 2fr;
  }
}

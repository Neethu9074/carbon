:local {
  .propertiesContainer {
    border: 0.0625rem solid var(--ids-color-option-neutral-300);
    padding: 0.625rem;
    margin-bottom: 7%;
  }
  .runNow {
    border: 0.0625rem;
    padding: 0;
  }
  .descriptionInput {
    flex: 1;
    .validationsBtn {
      padding-left: 0;
    }
  }

  .addPropertyBtn {
    padding-left: 0;
  }

  .deleteProperty {
    align-self: center;
    margin-top: 1rem;
  }
}

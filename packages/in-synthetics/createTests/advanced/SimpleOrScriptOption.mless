@import '~in-themes/active.less';
@import '~in-themes/mixins.less';

:local {
  .wrapper {
    padding: 1rem 0.5rem 1rem 1rem;
    // border: 1px solid @lib__colors__N300;
    // border-radius: @lib__shapes__radius_large;
  }

  .icon {
    fill: @lib__colors__teal800;
    margin: 0 4px;
  }

  .content {
    width: 85%;
  }

  .title {
    color: @lib__colors__teal800;
    font-size: 1rem;
    font-weight: 600;
  }

  .description {
    font-size: 0.85rem;
    font-weight: 500;
    color: @lib__colors__N800Dark;
    margin-top: 0.5rem;

    .betaBadge {
      margin-top: 8px;
      width: max-content;
    }
  }

  .verticalAlignedCells {
    align-items: center;
  }

  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
    }

    &.optionBoxUnchecked {
      svg {
        fill: @lib__colors__N600Light;
      }

      color: @lib__colors__N600Light;
    }
  }

  .staticOrAdaptiveOption {
    align-self: center;
  }
}

:local {
  .wrapper {
    padding: 1rem 0.5rem 1rem 1rem;
    // border: 1px solid @lib__colors__N300;
    // border-radius: var(--ids-border-radius-option-large);
  }

  .icon {
    fill: var(--ids-color-option-teal-500);
    margin: 0 4px;
  }

  .content {
    width: 85%;
  }

  .title {
    color: var(--cds-text-primary);
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .description {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ids-color-option-neutral-800);
    margin-top: 0.5rem;
  }

  .verticalAlignedCells {
    align-items: center;
  }

  .optionBox {
    &.optionBox {
      border: none;
      border-radius: 0;
    }

    &.optionBoxUnchecked {
      svg {
        fill: var(--ids-color-option-neutral-600);
      }

      color: var(--ids-color-option-neutral-600);
    }
  }

  .staticOrAdaptiveOption {
    align-self: center;
  }
}

:local {
  .baseContainer {
    padding-bottom: 0.3125rem;
    display: grid;
    max-height: fit-content;
    grid-template-areas: 'content' 'errors';
    grid-auto-rows: 1fr min-content;
  }

  .rightHeader {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .outerBox {
    border: 0.0625rem solid var(--ids-color-option-neutral-300);
    padding: 0.625rem;
    margin-bottom: 2%;
  }

  .item {
    display: list-item;
    align-items: left;

    width: auto;
    padding: 0.3rem;
    border-bottom: 1px solid var(--ids-color-option-neutral-300);
    list-style: none;
  }

  .center {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0.625rem;
  }
}

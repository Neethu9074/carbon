:local {
  .configContainer {
    border: 1px solid var(--ids-color-option-neutral-300);
    padding: 10px;
    margin-bottom: 2%;
  }

  .descriptionInput {
    flex: 1;
    .validationsBtn {
      padding-left: 0;
    }
  }

  .statusBox {
    width: 20%;
    font-weight: 600;
  }

  .validationsBtn {
    padding-left: 0;
  }

  .configCheckbox {
    width: 50%;
  }

  .deleteAction {
    display: flex;
    align-items: center;
  }

  .deleteHeader {
    height: 4.5rem;
  }

  .deleteValidation {
    height: 2rem;
  }
}

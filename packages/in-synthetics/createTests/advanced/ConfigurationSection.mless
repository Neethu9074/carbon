:local {
  .configContainer {
    border: 0.0625rem solid var(--ids-color-option-neutral-300);
    padding: 0.625rem;
    margin-bottom: 2%;
  }

  .descriptionInput {
    flex: 1;
    .validationsBtn {
      padding-left: 0;
    }
  }

  .statusBox {
    width: 20%;
    font-weight: 600;
  }

  .validationsBtn {
    padding-left: 0;
  }

  .configCheckbox {
    width: 50%;
  }

  .deleteAction {
    align-self: center;
  }

  .deleteHeader {
    margin-top: 1rem;
  }

  .timeoutLabel {
    margin-bottom: 1rem;
  }

  .subText {
    color: var(--ids-color-option-neutral-600);
    font-size: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .row {
    margin-bottom: 0.5rem;
  }

  .alignText {
    display: flex;
    align-items: center;
  }

  .validityInput {
    margin: 0 1rem;
  }
}

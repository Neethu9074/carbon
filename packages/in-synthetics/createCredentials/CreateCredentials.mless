:local {
  .dialog {
    width: 80vw;
    height: 40vw;
    overflow-y: auto;
    [class*='carbonHeader'],
    [class*='carbonRightHeader'] {
      z-index: inherit;
    }
  }

  .stepOneWrapper {
    grid-column: 1 / span 2;
    margin-left: 0.5rem;
  }

  .stepTwoWrapper {
    grid-column: 1 / span 3;
    margin-left: 0.5rem;
  }
}

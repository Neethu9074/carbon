worker_processes             1;

error_log                    /var/log/nginx/error.log info;

pid                          /run/nginx.pid;

events {
  worker_connections         1024;
}

http {
  include                    mime.types;
  default_type               application/octet-stream;

  sendfile                   on;
  keepalive_timeout          65;
  client_max_body_size       0;

  log_format                 standard_format
                             '$remote_addr - $remote_user [$time_local] '
                             '"$request" $status $bytes_sent '
                             '"$http_referer" "$http_user_agent" "$gzip_ratio"';

  upstream api {
    server                   {{UI_BACKEND_PORT_8080_TCP_ADDR}}:{{UI_BACKEND_PORT_8080_TCP_PORT}};
  }

  upstream groundskeeper {
    server                   {{GROUNDSKEEPER_PORT_8280_TCP_ADDR}}:{{GROUNDSKEEPER_PORT_8280_TCP_PORT}};
  }

  server {
    listen                   80;
    server_name              example;

    access_log               /var/log/nginx/access.log standard_format buffer=32k;
    log_not_found            on;
    log_subrequest           on;

    gzip                     on;
    gzip_static              on;
    gzip_min_length          1100;
    gzip_buffers             4 32k;
    gzip_types               text/plain text/css application/javascript application/x-javascript text/xml application/xml+rss image/png;
    gzip_vary                on;
    gzip_disable             "MSIE [1-6]\.";

    ssi                      on;
    ssi_silent_errors        off;

    location ~* \.js\.map$ {
      auth_basic             "Restricted";
      auth_basic_user_file   .htpasswd;
      root                   /opt/www;
    }

    location /bundle {
      root                   /opt/www;
      expires                max;
    }

    location ~* ^(/|/index\.html)$ {
      root                   /opt/www;
      add_header             Cache-Control "private, no-cache, no-store, must-revalidate, max-age=0";
      add_header             X-Frame-Options deny;
      add_header             X-Content-Type-Options nosniff;
      add_header             X-XSS-Protection "1; mode=block";

      # TODO enable once we have TLS setup
      # TODO submit application to https://hstspreload.appspot.com/
      # once properly configured and live on instana.io
      #add_header             Strict-Transport-Security "max-age=10886400; includeSubDomains; preload";
    }

    location / {
      root                   /opt/www;
      autoindex              off;
      try_files              $uri $uri/index.html $uri/ =404;
    }

    location /api/data {
      proxy_pass             http://api/data;
      proxy_http_version     1.1;
      proxy_set_header       Upgrade $http_upgrade;
      proxy_set_header       Connection "upgrade";
    }

    location /auth/signIn {
      proxy_pass             http://groundskeeper/signIn;
      proxy_set_header       X-Real-IP $remote_addr;
      proxy_set_header       Host $host;
      proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /auth/signOut {
      proxy_pass             http://groundskeeper/signOut;
      proxy_set_header       X-Real-IP $remote_addr;
      proxy_set_header       Host $host;
      proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /auth/users/current {
      proxy_pass             http://groundskeeper/users/current;
      proxy_set_header       X-Real-IP $remote_addr;
      proxy_set_header       Host $host;
      proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    error_page               500 502 503 504 /50x.html;
    location = /50x.html {
      root                   html;
    }
  }
}

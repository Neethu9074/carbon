#!/bin/bash

export CONSUL_GETURL="http://localhost:8500/v1/catalog/service"
export CONSUL_PUTURL="http://localhost:8500/v1/agent/service/register"

consul_register() {
    JSON=$1
    j2 $JSON.j2 > $JSON
    ${CURL} -XPUT $CONSUL_PUTURL -d @$JSON
}

consul_discover_environment_single() {
    DEP=$1
    DEP_LOWER=${DEP,,}
    DEP_UPPER=$(echo ${DEP^^} | tr '-' '_')
    eval "export ${DEP_UPPER}_PORT=$(${CURL} ${CONSUL_GETURL}/$REGION-$ENVIRONMENT-${DEP_LOWER} | jq '.[0].ServicePort')"
    eval "export ${DEP_UPPER}_HOST=$(${CURL} ${CONSUL_GETURL}/$REGION-$ENVIRONMENT-${DEP_LOWER} | jq '.[0].Address' | tr -d '\"')"
    hostvar=${DEP_UPPER}_HOST
    portvar=${DEP_UPPER}_PORT
    echo "$REGION-$ENVIRONMENT-${DEP_LOWER}=${!hostvar}:${!portvar}" >> /var/discovery/dependencies
}

consul_discover_unit_single() {
    DEP=$1
    DEP_LOWER=${DEP,,}
    DEP_UPPER=$(echo ${DEP^^} | tr '-' '_')
    eval "export ${DEP_UPPER}_PORT=$(${CURL} ${CONSUL_GETURL}/$REGION-$ENVIRONMENT-$TENANT-$UNIT-${DEP_LOWER} | jq '.[0].ServicePort')"
    eval "export ${DEP_UPPER}_HOST=$(${CURL} ${CONSUL_GETURL}/$REGION-$ENVIRONMENT-$TENANT-$UNIT-${DEP_LOWER} | jq '.[0].Address' | tr -d '\"')"
    hostvar=${DEP_UPPER}_HOST
    portvar=${DEP_UPPER}_PORT
    echo "$REGION-$ENVIRONMENT-$TENANT-$UNIT-${DEP_LOWER}=${!hostvar}:${!portvar}" >> /var/discovery/dependencies
}

consul_discover_region_multiple() {
    DEP=$1
    DEP_LOWER=${DEP,,}
    DEP_UPPER=$(echo ${DEP^^} | tr '-' '_')
    eval "export ${DEP_UPPER}_HOSTS=$(${CURL} $CONSUL_GETURL/$REGION-$DATA_SCOPE-${DEP_LOWER} | jq '.[].Address' | while read a; do echo -n "${a:1:-1},"; done | head -c -1)
    eval "export ${DEP_UPPER}_PORT=$(${CURL} $CONSUL_GETURL/$REGION-$DATA_SCOPE-${DEP_LOWER} | jq '.[0].ServicePort')
    hostvar=${DEP_UPPER}_HOSTS
    portvar=${DEP_UPPER}_PORT
    echo "$REGION-$DATA_SCOPE-${DEP_LOWER}=${!hostvar}:${!portvar}" >> /var/discovery/dependencies
}

${CURL} "http://localhost:8500/v1/catalog/services" > /dev/null
if [ $? -eq 0 ]; then
    if [ -f "discovery/consul.discover" ]; then
        source discovery/consul.discover
    fi

    if [ -f "discovery/consul.register" ]; then
        source discovery/consul.register
    fi
fi

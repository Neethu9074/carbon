#!/bin/bash

set -e

consul_discover_unit_single "ui-backend"
consul_discover_unit_single "ui-tracker"

export UI_BACKEND_PORT_8080_TCP_PORT=$UI_BACKEND_PORT
export UI_BACKEND_PORT_8080_TCP_ADDR=$UI_BACKEND_HOST

export UI_BACKEND_PORT_8082_TCP_PORT=8082
export UI_BACKEND_PORT_8082_TCP_ADDR=$UI_BACKEND_HOST

export UI_TRACKER_PORT_8484_TCP_PORT=$UI_TRACKER_PORT
export UI_TRACKER_PORT_8484_TCP_ADDR=$UI_TRACKER_HOST


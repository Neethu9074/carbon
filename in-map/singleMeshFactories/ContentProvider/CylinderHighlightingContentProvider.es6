const MARGIN = 1.05;

const VERTICES = [
  // bottom
  MARGIN * 0.154, 1 - MARGIN, 0.475 * MARGIN,
  MARGIN * 0.293, 1 - MARGIN, 0.404 * MARGIN,

  MARGIN * 0.293, 1 - MARGIN, 0.404 * MARGIN,
  MARGIN * 0.404, 1 - MARGIN, 0.293 * MARGIN,

  MARGIN * 0.404, 1 - MARGIN, 0.293 * MARGIN,
  MARGIN * 0.475, 1 - MARGIN, 0.154 * MARGIN,

  MARGIN * 0.475, 1 - MARGIN, 0.154 * MARGIN,
  MARGIN * 0.5, 1 - MARGIN, 0 * MARGIN,

  MARGIN * -0.5, 1 - MARGIN, 0 * MARGIN,
  MARGIN * -0.475, 1 - MARGIN, 0.154 * MARGIN,

  MARGIN * -0.475, 1 - MARGIN, 0.154 * MARGIN,
  MARGIN * -0.404, 1 - MARGIN, 0.293 * MARGIN,

  MARGIN * -0.404, 1 - MARGIN, 0.293 * MARGIN,
  MARGIN * -0.293, 1 - MARGIN, 0.404 * MARGIN,

  MARGIN * -0.293, 1 - MARGIN, 0.404 * MARGIN,
  MARGIN * -0.154, 1 - MARGIN, 0.475 * MARGIN,

  MARGIN * -0.154, 1 - MARGIN, 0.475 * MARGIN,
  MARGIN * 0, 1 - MARGIN, 0.5 * MARGIN,

  MARGIN * 0, 1 - MARGIN, 0.5 * MARGIN,
  MARGIN * 0.154, 1 - MARGIN, 0.475 * MARGIN,

  // top
  MARGIN * 0.5, MARGIN, 0 * MARGIN,
  MARGIN * 0.475, MARGIN, -0.154 * MARGIN,

  MARGIN * 0.475, MARGIN, -0.154 * MARGIN,
  MARGIN * 0.404, MARGIN, -0.293 * MARGIN,

  MARGIN * 0.404, MARGIN, -0.293 * MARGIN,
  MARGIN * 0.293, MARGIN, -0.404 * MARGIN,

  MARGIN * 0.293, MARGIN, -0.404 * MARGIN,
  MARGIN * 0.154, MARGIN, -0.475 * MARGIN,

  MARGIN * 0.154, MARGIN, -0.475 * MARGIN,
  MARGIN * 0, MARGIN, -0.5 * MARGIN,

  MARGIN * 0, MARGIN, -0.5 * MARGIN,
  MARGIN * -0.154, MARGIN, -0.475 * MARGIN,

  MARGIN * -0.154, MARGIN, -0.475 * MARGIN,
  MARGIN * -0.293, MARGIN, -0.404 * MARGIN,

  MARGIN * -0.293, MARGIN, -0.404 * MARGIN,
  MARGIN * -0.404, MARGIN, -0.293 * MARGIN,

  MARGIN * -0.404, MARGIN, -0.293 * MARGIN,
  MARGIN * -0.475, MARGIN, -0.154 * MARGIN,

  MARGIN * -0.475, MARGIN, -0.154 * MARGIN,
  MARGIN * -0.5, MARGIN, 0 * MARGIN,

  // side
  MARGIN * 0.5, 1 - MARGIN, 0 * MARGIN,
  MARGIN * 0.5, MARGIN, 0 * MARGIN,

  MARGIN * -0.5, 1 - MARGIN, 0 * MARGIN,
  MARGIN * -0.5, MARGIN, 0 * MARGIN
];

const COLORS = [];
for (let i = 0; i <= VERTICES.length; i++) {
  COLORS[i] = 1;
}

export default {
  getVertices: () => {
    return VERTICES;
  },

  getColors: () => {
    return COLORS;
  }
};

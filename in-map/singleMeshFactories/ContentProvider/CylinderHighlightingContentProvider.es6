const MARGIN = 1.05;

const VERTICES = [
  MARGIN * -0.405, 1 - MARGIN, -0.294 * MARGIN,
  MARGIN * -0.476, 1 - MARGIN, -0.155 * MARGIN,

  MARGIN * -0.476, 1 - MARGIN, -0.155 * MARGIN,
  MARGIN * -0.500, 1 - MARGIN, 0.000 * MARGIN,

  MARGIN * -0.500, 1 - MARGIN, 0.000 * MARGIN,
  MARGIN * -0.476, 1 - MARGIN, 0.155 * MARGIN,

  MARGIN * -0.476, 1 - MARGIN, 0.155 * MARGIN,
  MARGIN * -0.405, 1 - MARGIN, 0.294 * MARGIN,

  MARGIN * -0.405, 1 - MARGIN, 0.294 * MARGIN,
  MARGIN * -0.294, 1 - MARGIN, 0.405 * MARGIN,

  MARGIN * -0.294, 1 - MARGIN, 0.405 * MARGIN,
  MARGIN * -0.155, 1 - MARGIN, 0.476 * MARGIN,

  MARGIN * -0.155, 1 - MARGIN, 0.476 * MARGIN,
  MARGIN * -0.000, 1 - MARGIN, 0.500 * MARGIN,

  MARGIN * -0.000, 1 - MARGIN, 0.500 * MARGIN,
  MARGIN * 0.155, 1 - MARGIN, 0.476 * MARGIN,

  MARGIN * 0.155, 1 - MARGIN, 0.476 * MARGIN,
  MARGIN * 0.294, 1 - MARGIN, 0.405 * MARGIN,

  MARGIN * 0.294, 1 - MARGIN, 0.405 * MARGIN,
  MARGIN * 0.405, 1 - MARGIN, 0.294 * MARGIN,

  // top
  MARGIN * 0.476, MARGIN, -0.155 * MARGIN,
  MARGIN * 0.405, MARGIN, -0.294 * MARGIN,

  MARGIN * 0.405, MARGIN, -0.294 * MARGIN,
  MARGIN * 0.294, MARGIN, -0.405 * MARGIN,

  MARGIN * 0.294, MARGIN, -0.405 * MARGIN,
  MARGIN * 0.155, MARGIN, -0.476 * MARGIN,

  MARGIN * 0.155, MARGIN, -0.476 * MARGIN,
  MARGIN * 0.000, MARGIN, -0.500 * MARGIN,

  MARGIN * 0.000, MARGIN, -0.500 * MARGIN,
  MARGIN * -0.155, MARGIN, -0.476 * MARGIN,

  MARGIN * -0.155, MARGIN, -0.476 * MARGIN,
  MARGIN * -0.294, MARGIN, -0.405 * MARGIN,

  MARGIN * -0.294, MARGIN, -0.405 * MARGIN,
  MARGIN * -0.405, MARGIN, -0.294 * MARGIN,

  MARGIN * 0.476, MARGIN, 0.155 * MARGIN,
  MARGIN * 0.500, MARGIN, 0.000 * MARGIN,

  MARGIN * 0.500, MARGIN, 0.000 * MARGIN,
  MARGIN * 0.476, MARGIN, -0.155 * MARGIN,

  MARGIN * 0.405, MARGIN, 0.294 * MARGIN,
  MARGIN * 0.476, MARGIN, 0.155 * MARGIN,

  // side
  MARGIN * -0.405, 1 - MARGIN, -0.294 * MARGIN,
  MARGIN * -0.405, MARGIN, -0.294 * MARGIN,

  MARGIN * 0.405, 1 - MARGIN, 0.294 * MARGIN,
  MARGIN * 0.405, MARGIN, 0.294 * MARGIN
];

const COLORS = [];
for (let i = 0; i <= VERTICES.length; i++) {
  COLORS[i] = 1;
}

export default {
  getVertices: () => {
    return VERTICES;
  },

  getColors: () => {
    return COLORS;
  }
};

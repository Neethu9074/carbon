const MARGIN = 1.05;

const VERTICES = [
  // top
  MARGIN * 0.032, MARGIN, -0.386 * MARGIN,
  MARGIN * 0.1, MARGIN, -0.304 * MARGIN,

  MARGIN * 0.032, MARGIN, -0.386 * MARGIN,
  MARGIN * -0.043, MARGIN, -0.427 * MARGIN,

  MARGIN * -0.043, MARGIN, -0.427 * MARGIN,
  MARGIN * -0.129, MARGIN, -0.439 * MARGIN,

  MARGIN * -0.129, MARGIN, -0.439 * MARGIN,
  MARGIN * -0.216, MARGIN, -0.425 * MARGIN,

  MARGIN * -0.216, MARGIN, -0.425 * MARGIN,
  MARGIN * -0.308, MARGIN, -0.365 * MARGIN,

  MARGIN * -0.308, MARGIN, -0.365 * MARGIN,
  MARGIN * -0.36, MARGIN, -0.295 * MARGIN,

  MARGIN * -0.36, MARGIN, -0.295 * MARGIN,
  MARGIN * -0.394, MARGIN, -0.122 * MARGIN,

  MARGIN * -0.394, MARGIN, -0.122 * MARGIN,
  MARGIN * -0.452, MARGIN, -0.105 * MARGIN,

  MARGIN * -0.452, MARGIN, -0.105 * MARGIN,
  MARGIN * -0.504, MARGIN, -0.061 * MARGIN,

  MARGIN * -0.504, MARGIN, -0.061 * MARGIN,
  MARGIN * -0.538, MARGIN, 0.024 * MARGIN,

  MARGIN * 0.1, MARGIN, -0.304 * MARGIN,
  MARGIN * 0.17, MARGIN, -0.32 * MARGIN,

  MARGIN * 0.17, MARGIN, -0.32 * MARGIN,
  MARGIN * 0.246, MARGIN, -0.316 * MARGIN,

  MARGIN * 0.246, MARGIN, -0.316 * MARGIN,
  MARGIN * 0.328, MARGIN, -0.281 * MARGIN,

  MARGIN * 0.328, MARGIN, -0.281 * MARGIN,
  MARGIN * 0.394, MARGIN, -0.205 * MARGIN,

  MARGIN * 0.394, MARGIN, -0.205 * MARGIN,
  MARGIN * 0.411, MARGIN, -0.112 * MARGIN,

  MARGIN * 0.411, MARGIN, -0.112 * MARGIN,
  MARGIN * 0.458, MARGIN, -0.098 * MARGIN,

  MARGIN * 0.458, MARGIN, -0.098 * MARGIN,
  MARGIN * 0.509, MARGIN, -0.04 * MARGIN,

  MARGIN * 0.509, MARGIN, -0.04 * MARGIN,
  MARGIN * 0.536, MARGIN, 0.015 * MARGIN,


  // bottom
  MARGIN * -0.394, 1 - MARGIN, 0.243 * MARGIN,
  MARGIN * -0.394, 1 - MARGIN, 0.243 * MARGIN,

  MARGIN * -0.452, 1 - MARGIN, 0.225 * MARGIN,
  MARGIN * -0.394, 1 - MARGIN, 0.243 * MARGIN,

  MARGIN * -0.504, 1 - MARGIN, 0.181 * MARGIN,
  MARGIN * -0.452, 1 - MARGIN, 0.225 * MARGIN,

  MARGIN * -0.538, 1 - MARGIN, 0.095 * MARGIN,
  MARGIN * -0.504, 1 - MARGIN, 0.181 * MARGIN,

  MARGIN * -0.394, 1 - MARGIN, 0.243 * MARGIN,
  MARGIN * -0.36, 1 - MARGIN, 0.251 * MARGIN,

  MARGIN * -0.36, 1 - MARGIN, 0.251 * MARGIN,
  MARGIN * 0.394, 1 - MARGIN, 0.251 * MARGIN,

  MARGIN * 0.394, 1 - MARGIN, 0.251 * MARGIN,
  MARGIN * 0.411, 1 - MARGIN, 0.249 * MARGIN,

  MARGIN * 0.411, 1 - MARGIN, 0.249 * MARGIN,
  MARGIN * 0.458, 1 - MARGIN, 0.23 * MARGIN,

  MARGIN * 0.458, 1 - MARGIN, 0.23 * MARGIN,
  MARGIN * 0.509, 1 - MARGIN, 0.173 * MARGIN,

  MARGIN * 0.509, 1 - MARGIN, 0.173 * MARGIN,
  MARGIN * 0.536, 1 - MARGIN, 0.116 * MARGIN,


  // side
  MARGIN * 0.536, 1 - MARGIN, 0.116 * MARGIN,
  MARGIN * 0.536, MARGIN, 0.015 * MARGIN,

  MARGIN * -0.538, 1 - MARGIN, 0.095 * MARGIN,
  MARGIN * -0.538, MARGIN, 0.024 * MARGIN
];

const COLORS = [];
for (let i = 0; i <= VERTICES.length; i++) {
  COLORS[i] = 1;
}

export default {
  getVertices: () => {
    return VERTICES;
  },

  getColors: () => {
    return COLORS;
  }
};

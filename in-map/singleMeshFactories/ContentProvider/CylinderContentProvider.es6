const indexWhereTopMeshBegins = 179;
const COLORS = new Array(VERTICES.length);
for (let i = 0; i <= indexWhereTopMeshBegins; i++) {
  COLORS[i] = 0.9;
}
for (let i = indexWhereTopMeshBegins + 1; i < VERTICES.length; i++) {
  COLORS[i] = 1;
}

export default {
  getVertices: () => {
    return VERTICES;
  },

  getColors: () => {
    return COLORS;
  }
};

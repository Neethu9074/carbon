// initialize an array with 1 values [1, 1, 1, 1, ...]
const DEFAULT_COLOR = Array.apply(null, Array(CYLINDER_VERTICES.length)).map(() => 1);

export default class CylinderContentProvider extends ContentProvider {

  constructor() {
    super();
    this.cachedColors = DEFAULT_COLOR;
  }

  getVertices() {

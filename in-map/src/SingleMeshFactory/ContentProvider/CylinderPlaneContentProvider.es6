const DEFAULT_COLOR = [];
for (let i = 0; i < CYLINDRIC_PLANE_VERTICES.length / 3; i++) {
  DEFAULT_COLOR.push(0.176, 0.25, 0.28);
}

export default class CylinderPlaneContentProvider extends ContentProvider {

  getVertices() {
    return CYLINDRIC_PLANE_VERTICES.slice();
  }

  getColors() {

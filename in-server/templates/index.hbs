      </svg>
      <p>
        Instana is loading...
      </p>
    </div>
  </div>

  <!-- this content is only rendered if there is no support for JS -->
  <noscript>
    <div class="in-index-centered-content">
      <div class="left-side">
        <h1 class="title">
          JavaScript disabled
        </h1>
        <p class="message">
          The Instana interface requires JavaScript. Please enable JavaScript in your browser to continue.
        </p>
      </div>
    </div>
  </noscript>
  <script src="/bundle/index-{{indexJsChecksum}}.js"
          integrity="{{indexJsSri}}"
          crossorigin="anonymous"></script>
</body>
</html>

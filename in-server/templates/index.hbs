<!doctype html>
<html>
<head profile="http://www.w3.org/2005/10/profile">
  <meta charset="UTF-8"
        name="viewport"
        content="user-scalable=no, width=device-width, initial-scale=1, maximum-scale=1">

  <link rel="icon"
        type="image/png"
        href="favicon.png">

  <title>Instana</title>

  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Open+Sans:700,400,300&subset=latin,greek,vietnamese,latin-ext,cyrillic,cyrillic-ext"
        crossorigin="anonymous">
  <link rel="stylesheet"
        href="/bundle/theme-{{theme}}-{{themeChecksum}}.css"
        integrity="{{themeSri}}">

  {{#each prefetchItems}}
  <link rel="{{rel}}" href="/bundle/{{fileName}}" as="{{as}}">
  {{/each}}

  <script nonce="{{nonces.[0]}}">
    window.instana = {
      user: {{{user}}},
      build: {{{build}}},
      config: {{{config}}},
      activeTheme: '{{theme}}',
      activeThemeConfig: {{{themeConfig}}},
      searchFields: {{{searchFields}}},
      settings: {{{settings}}}
    };
  </script>

  {{#if googleAnalyticsTrackingId}}
  <script nonce="{{nonces.[1]}}">
    if (window.instana.user.email.indexOf('@instana.com') === -1) {
      (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
      })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');
      ga('create', '{{googleAnalyticsTrackingId}}', 'auto');
      ga('send', 'pageview');
    }
  </script>
  {{/if}}

  {{#if eumTrackingApiKey}}
  <script nonce="{{nonces.[2]}}">
    (function(i,s,o,g,r,a,m){i['InstanaEumObject']=r;i[r]=i[r]||function(){
    (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
    m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
    })(window,document,'script','//{{eumTrackingDomain}}/eum.min.js','ineum');
    ineum('apiKey', '{{eumTrackingApiKey}}');
    ineum('reportingUrl', '//{{eumTrackingDomain}}');
    ineum('traceId', '{{backendTraceId}}');
    ineum('ignoreUrls', [/.*\/api\/data.*/]);
    ineum('meta', 'build-tag', window.instana.build.tag);
    ineum('meta', 'build-revision', window.instana.build.revision);
    ineum('meta', 'build-date', window.instana.build.date);
  </script>
  {{/if}}
</head>
<body>
  <div id="main">
    <!-- this content will be replaced by init.es6 when all the content is loaded -->
    <div class="in-index-centered-content">

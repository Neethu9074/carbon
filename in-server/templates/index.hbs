<!doctype html>
<html>
<head profile="http://www.w3.org/2005/10/profile">
  <meta charset="UTF-8"
        name="viewport"
        content="user-scalable=no, width=device-width, initial-scale=1, maximum-scale=1">

  <link rel="icon"
        type="image/png"
        href="favicon.png">

  <title>Instana</title>

  <script nonce="{{nonces.[0]}}">
    window.instana = {};
  </script>
  <script nonce="{{nonces.[1]}}">
    window.instana.user = <!--#include virtual="/auth/users/current" -->;
  </script>
  <script nonce="{{nonces.[2]}}">
    window.instana.build = <!--#include virtual="build.json" -->;
    window.instana.config = <!--#include virtual="config.json" -->;
    window.instana.activeTheme = '{{theme}}';
    window.instana.activeThemeConfig = {{{themeConfig}}};
  </script>

  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Open+Sans:700,400,300&subset=latin,greek,vietnamese,latin-ext,cyrillic,cyrillic-ext"
        crossorigin="anonymous">
  <link rel="stylesheet"
        href="/bundle/theme-{{theme}}-{{themeChecksum}}.css"
        integrity="{{themeSri}}">
</head>
<body>
  <div id="main"></div>
  <script src="/bundle/index-{{indexJsChecksum}}.js"
          integrity="{{indexJsSri}}"></script>
</body>
</html>

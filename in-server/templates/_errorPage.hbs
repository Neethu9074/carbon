<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Error - Instana</title>

  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css?family=Open+Sans:700,400,300&subset=latin,greek,vietnamese,latin-ext,cyrillic,cyrillic-ext"
        crossorigin="anonymous">

  <style>
    html, body {
      height: 100%;
      color: #fff;
      background: #43565E;
      font-family: "Open Sans", sans-serif;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .left-side {
      width: 22rem;
    }

    .title {
      font-size: 2.25rem;
      line-height: 2.5rem;
      font-weight: bold;
    }

    .message {
      color: #92A5AE;
      font-size: 1rem;
      line-height: 1.25rem;
    }
  </style>

  <title>{{title}} - Instana</title>
</head>
<body>
  <div class="left-side">
    <h1 class="title">
      {{title}}
    </h1>

    <p class="message">
      {{message}}
    </p>
  </div>

  <img src="" alt="Stan pulling the plug (accidentally)">
</body>
</html>

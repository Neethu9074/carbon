{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "ignorePaths":  ["**/node_modules/**", "build"],

  "extends": [
    "helpers:disableTypesNodeMajor"
  ],
  "packageRules": [
    {
      "matchRepositories": ["^@instana/types"],
      "enabled": false
    },
    {
      "matchSourceUrls": ["https://github.ibm.com/instana/ui-foundation"],
      "groupName": "ui-foundation",
      "labels": ["Review + Merge"],
      "enabled": true
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "ignorePaths":  ["**/packages/**", "**/node_modules/**", "**/storybook/**"],

  "extends": [
    "helpers:disableTypesNodeMajor"
  ],
  "packageRules": [
    {
      "matchRepositories": ["^@instana/types"],
      "enabled": false
    },
    {
      "excludePackagePatterns": ["^@instana"],
      "enabled": false
    },
    {
      "matchSourceUrls": ["https://github.ibm.com/instana/ui-foundation"],
      "groupName": "ui-foundation monorepo",
      "enabled": true
    }
  ]
}

ARG base_version

FROM containers.instana.io/instana/product/nodejs:${base_version} AS builder

COPY build/ /

RUN microdnf --nodocs --setopt=install_weak_deps=0 --setopt=tsflags=nodocs install -y gcc gcc-c++ make
RUN npm install --prefix /opt/instana/ui-client/target --production

FROM containers.instana.io/instana/product/nodejs:${base_version}

COPY --from=builder /opt/instana/ui-client/target /opt/instana/ui-client
COPY --from=builder /usr/bin/run.sh /usr/bin/run.sh
RUN mkdir -p /etc/instana/ui-client

ARG image_version
ARG branch
ARG commit_id

ENV COMPONENT_ID=""

ENV COM_INSTANA_COMMIT_ID="${commit_id}" \
    COM_INSTANA_BRANCH="${branch}" \
    COM_INSTANA_IMAGE_TAG="${image_version}"

LABEL com.instana.commit.id="${commit_id}" \
      com.instana.branch="${branch}" \
      com.instana.image.tag="${image_version}"

USER instana:instana

CMD ["/usr/bin/run.sh"]

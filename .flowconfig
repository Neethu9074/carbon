[ignore]
.*/build/.*
.*/deployment/.*

// In the end we might want to ignore node_modules completely and import library
// type definitions via flow-typed. OTOH, we can also exclude problematic
// npm packages one by one when we encounter issues. Not sure yet.
.*/node_modules/npm/.*

.*/target/.*

[include]

[libs]

[lints]

[options]
module.file_ext=.es6
module.file_ext=.js

[strict]

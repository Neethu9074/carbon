:local {
  .panel {
    background-color: var(--cds-layer-02);
    border: 1px solid var(--cds-layer);
    padding-top: 16px;
    min-height: 600px;
  }
  .contentContainer {
    display: flex;
    width: 100%;
    margin-left: 36px;
    margin-right: 36px;
    gap: 12px;
    justify-content: flex-start;
  }
  .columnContainer {
    display: flex;
    margin-top: 12px;
    gap: 12px;
    width: 380px;
    flex-direction: column;
  }
  .listContainer {
    width: 80%;
    display: flex;
    gap: 12px;
    flex-direction: column;
  }
  .listContainerOverflow {
    .listContainer();
    max-height: 440px;
    overflow-y: auto;
  }
  .contentHeader {
    margin-left: 36px;
    margin-bottom: 16px;
  }

  .contentTitle {
    font-size: 32px;
    font-weight: 400;
    line-height: 40px;
  }
  .columnTitle {
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    margin-bottom: 12px;
  }
  .pathCell {
    background-color: var(--cds-layer);
    padding: 4px;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    overflow-wrap: break-word;
    word-break: break-all;
  }
}

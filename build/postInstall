#!/bin/sh

linkModule() {
  name="$1"
  rm -f node_modules/$name
  ln -s "../packages/$name" "node_modules/$name"
}

echo "Symlinking node modules to node_modules to enable shorter require paths"
linkModule in-services
linkModule in-sdk
linkModule in-forge
linkModule in-map
linkModule in-themes
linkModule in-components
linkModule in-test
linkModule in-stores
linkModule in-hoc
linkModule in-client
linkModule in-charts
linkModule in-views
linkModule in-internal
linkModule roemitter
linkModule instalog
linkModule reactive-observables

# Try to install nginx for supported systems
echo "Trying to install nginx for supported systems"
nice -19 proxrox install

echo "Install commit hooks"
rm -f .git/hooks/pre-commit
node ./node_modules/husky/bin/install.js

#!/bin/sh

echo "Installing git commit hooks..."
rm -f .git/hooks/pre-commit
ln -s ../../build/hooks/pre-commit .git/hooks/pre-commit

echo "Symlinking node modules to node_modules to enable shorter require paths"
rm -f node_modules/in-*
ln -s ../in-services node_modules/in-services
ln -s ../in-sdk node_modules/in-sdk
ln -s ../in-forge node_modules/in-forge
ln -s ../in-map node_modules/in-map
ln -s ../in-themes node_modules/in-themes
ln -s ../in-components node_modules/in-components
ln -s ../in-test node_modules/in-test

# reinstall TypeScript type definitions
tsd reinstall

# Try to install nginx for supported systems
echo "Trying to install nginx for supported systems"
proxrox install

#!/bin/sh

echo "Installing git commit hooks..."
rm -f .git/hooks/pre-commit
ln -s ../../build/hooks/pre-commit .git/hooks/pre-commit

echo "Symlinking node modules to node_modules to enable shorter require paths"
rm -f node_modules/instana-ui-*
ln -s ../ui-services node_modules/instana-ui-services
ln -s ../ui-sdk node_modules/instana-ui-sdk
ln -s ../ui-forge node_modules/instana-ui-forge
ln -s ../ui-map node_modules/instana-ui-map
ln -s ../ui-themes node_modules/instana-ui-themes
ln -s ../ui-components node_modules/instana-ui-components

# Try to install nginx for supported systems
echo "Trying to install nginx for supported systems"
proxrox install

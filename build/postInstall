#!/bin/sh

set -e

linkModule() {
  name="$1"
  echo "linking $name"
  rm -rf "node_modules/$name"
  ln -s "../packages/$name" "node_modules/$name"
}

finished() {
  echo "✅"
  echo ""
}

echo "🛩  symlinking packages"
for name in `ls packages/`; do
  linkModule "$name" 2>&1 | sed 's/^/   /'
done
finished

echo "💣 installing commit hook"
rm -f .git/hooks/pre-commit
node ./node_modules/husky/bin/install.js 2>&1 | sed 's/^/   /'
finished

echo "🧑‍🏭 installing auxiliary CLI tools"
cd build/cli-tools
yarn
cd ../..
finished

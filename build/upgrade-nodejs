#!/bin/bash

# Only activate the following flag if you run into problems
# set -x

# Activate NVM. NVM activation will fail when the user does not
# have the Node.js version installed which is specified by the .nvmrc.
# We therefore source it in the beginning and enable strict error mode
# in the following line.

if command -v brew > /dev/null && brew list nvm >/dev/null 2>&1 ; then
  NVM_DIR=${NVM_DIR:-"$HOME/.nvm"}
  export NVM_DIR
  . "$(brew --prefix nvm)/nvm.sh"
else
  . "${NVM_DIR:-"$HOME/.nvm"}/nvm.sh"
fi

set -eo pipefail

NEW_NODE_VERSION=$(cat .nvmrc)

# make sure to delete the old node modules first before changing the node
# version.
rm -rf node_modules/

# also delete the .node-gyp dir. I encountered some issues when switching
# Node.js versions. This issue was probably resolved by now in node gyp,
# but better be safe than sorry.
rm -rf ~/.node-gyp

# we also update the in-server
rm -rf packages/in-server/node_modules

# we moved the files and it can happen that this files lead to a broken link
# force delete them therefore
rm -f in-themes/active.less
rm -f in-themes/active.json

# okay, actually install the current version
nvm install "$NEW_NODE_VERSION"
nvm use "$NEW_NODE_VERSION"
nvm alias default "$NEW_NODE_VERSION"

# prepare hook installation
rm -f .git/hooks/pre-commit
echo "" > .git/hooks/pre-commit

# install yarn
npm install -g yarn@1.22.5

# and install all the dependencies
yarn
cd packages/in-server
yarn

ACTUAL_NODE_VERSION=$(node --version)

if [[ "$NEW_NODE_VERSION" != "$ACTUAL_NODE_VERSION" ]]; then
  echo
  echo "I have installed v$NEW_NODE_VERSION but running 'node --version' reports as $ACTUAL_NODE_VERSION. It is"
  echo "likely that you also have Node.js installed via other means"
  echo "(installer, brew, apt-get, ...). This might cause problems. Please remove the"
  echo "other Node.js installation and make sure your system uses the Node.js version"
  echo 'installed by nvm. You might also want to check "which node" and "echo $PATH".'
  exit 1
fi

echo "Great success, Node.js $ACTUAL_NODE_VERSION is installed and this has also been set as your default Node.js version via nvm."
echo
echo "Please remember to reload your shell so that this new Node.js version is used!"

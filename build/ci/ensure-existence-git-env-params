#!/usr/bin/env bash

set -ex

# Jenkins only defines environment parameters when the build is triggered
# via a Git push. This is okay, but we also want to retain the ability to
# trigger builds manually via the Git UI. In this case, the GIT_BRANCH
# env param will not exist and we need to retrieve the value from the
# build parameter INSTANA_UICLIENT_BRANCH.

export THE_COMMIT="`git rev-parse HEAD`"
export THE_BRANCH="${GIT_BRANCH:-$INSTANA_UICLIENT_BRANCH}"

export THE_BRANCH=$(echo $THE_BRANCH | sed "s/^origin\///")

echo "INSTANA_UICLIENT_COMMIT=$THE_COMMIT" > git-env.properties
echo "INSTANA_UICLIENT_BRANCH=$THE_BRANCH" >> git-env.properties

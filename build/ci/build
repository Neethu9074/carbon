#!/usr/bin/env bash

. "$NVM_DIR/nvm.sh"

set -e

nvm use

nice -19 npm prune
nice -19 npm update
nice -19 npm install

cd in-server
nice -19 npm prune
nice -19 npm update
nice -19 npm install
cd ..

nice -19 npm run test
nice -19 npm run build

export GIT_COMMIT="`git rev-parse HEAD`"
export INSTANA_UICLIENT_BRANCH="`git rev-parse --abbrev-ref HEAD`"
j2 build/ci/build-props.properties.j2 > build-props.properties

j2 deployment/Dockerfile.j2 > target/Dockerfile

# Clear data from previous build to avoid retention of artefacts
# like JS files which names are changing on every build
rm -rf /var/lib/jenkins/ui-client_artefacts/build
mkdir -p /var/lib/jenkins/ui-client_artefacts/build

# copy artefacts for container creation
cp -R target /var/lib/jenkins/ui-client_artefacts/build/

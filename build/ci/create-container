#!/usr/bin/env bash

set -ex

rm -rf target
cp -R /var/lib/jenkins/ui-client_artefacts/build/target .

rm -f Dockerfile
mv target/Dockerfile .

if [[ -z "$INSTANA_CONTAINER_TAG" ]]; then
  VERSION="$BUILD_NUMBER"
else
  VERSION="$INSTANA_CONTAINER_TAG"
fi

IMAGE="ui-client/$INSTANA_UICLIENT_BRANCH"

if [ -z "$IMAGE" ]; then echo "no image provided"; exit 1; fi
if [ -z "$VERSION" ]; then echo "no version provided"; exit 2; fi

rm -rf deployment/ext-discovery
git clone git@github.com:instana/discovery.git deployment/ext-discovery

echo "Building Docker image ..."
docker build -t "registry-internal.instana.io/instana/$IMAGE" .
docker tag "registry-internal.instana.io/instana/$IMAGE" "registry-internal.instana.io/instana/$IMAGE:$VERSION"

echo "Publishing Docker image ..."
docker push "registry-internal.instana.io/instana/$IMAGE:latest"
docker push "registry-internal.instana.io/instana/$IMAGE:$VERSION"

if [[ "$INSTANA_UICLIENT_BRANCH" == "master" ]]; then
  echo "Docker image is public..."
  docker tag registry-internal.instana.io/instana/$IMAGE:latest registry-public.instana.io/instana/$IMAGE:latest
  docker push registry-public.instana.io/instana/$IMAGE:latest
fi

docker rmi registry-internal.instana.io/instana/$IMAGE:$VERSION || true
docker rmi registry-internal.instana.io/instana/$IMAGE:latest || true
docker rmi registry-public.instana.io/instana/$IMAGE:latest || true

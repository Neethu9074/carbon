---
  env:
    browser: true

  ecmaFeatures:
    # TODO enable arrow functions and destructuring
    # see http://eslint.org/docs/configuring/#specifying-language-options
    defaultParams: true

  globals:
    Promise: false
    require: false
    module: true

  rules:
    brace-style: [2, '1tbs', { 'allowSingleLine': true }]
    complexity: [2, 2]
    global-strict: [2, 'always']
    max-len: [2, 80, 4]
    no-use-before-define: [2, 'nofunc']
    quotes: [2, 'single', 'avoid-escape']

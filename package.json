{
  "name": "in-client",
  "version": "1.0.0-prerelease",
  "description": "Instana core frontend",
  "main": "index.js",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "./build/postInstall",
    "clean": "gulp clean",
    "build": "export BUILD_DEV='false' && gulp build",
    "try-build": "export BUILD_DEV='false' && gulp try-build",
    "test": "npm run lint && npm run execute-tests",
    "lint": "eslint --ext .es6 in-* gulpfile.js",
    "execute-tests": "gulp prepareTestExecution && mocha --require ./build/testHarness --reporter dot $(find in-* -name '*_test.es6')",
    "dev": "export BUILD_DEV='true' && export NODE_ENV='development' && gulp dev",
    "check-updates": "ncu",
    "check-licenses": "license-checker > licenses.txt"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    },
    "ghooks": {
      "pre-commit": "npm test"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/instana/in-client.git"
  },
  "author": "Ben Ripkens <ben@instana.com>",
  "dependencies": {
    "clipboard-js": "^0.2.0",
    "d3": "^3.5.5",
    "fixed-data-table": "^0.6.0",
    "hammerjs": "^2.0.4",
    "immutable": "^3.7.1",
    "instalog": "^1.0.0",
    "instana-ui-theme": "^1.8.0",
    "intl": "^0.1.4",
    "invariant": "^2.0.0",
    "lodash": "^4.0.0",
    "markdown-it": "6.0.0",
    "moment": "^2.10.3",
    "react": "^0.14.7",
    "react-addons-pure-render-mixin": "^0.14.7",
    "react-dom": "^0.14.7",
    "react-immutable-proptypes": "^1.0.0",
    "react-intl": "^1.2.0",
    "react-router": "^0.13.3",
    "reactive-observables": "^1.23.0",
    "roemitter": "^2.0.0",
    "socket.io-client": "1.3.7",
    "three": "^0.74.0",
    "tween.js": "^15.0.0"
  },
  "devDependencies": {
    "autoprefixer-loader": "^3.1.0",
    "babel": "^5.0.10",
    "babel-core": "^5.0.0",
    "babel-loader": "^5.0.0",
    "chai": "^3.0.0",
    "chai-string": "^1.1.2",
    "chai-subset": "^1.0.1",
    "css-loader": "^0.19.0",
    "cz-conventional-changelog": "1.1.4",
    "del": "^2.0.2",
    "eslint": "^1.1.0",
    "eslint-config-instana": "^3.0.0",
    "eslint-plugin-import-order": "^1.0.0",
    "eslint-plugin-react": "^2.5.2",
    "extract-text-webpack-plugin": "^0.8.2",
    "file-loader": "^0.8.1",
    "ghooks": "^1.0.3",
    "gulp": "^3.8.10",
    "gulp-cssnano": "2.0.0",
    "gulp-size": "^2.0.0",
    "gulp-util": "^3.0.3",
    "html-loader": "^0.3.0",
    "image-webpack-loader": "^1.6.1",
    "inquirer": "^0.9.0",
    "jsdom": "^2.0.0",
    "json-loader": "0.5.4",
    "less": "^2.3.1",
    "less-loader": "^2.0.0",
    "license-checker": "5.0.1",
    "markdown-loader": "^0.1.3",
    "mkdirp": "^0.5.1",
    "mocha": "^2.2.4",
    "mocha-jsdom": "^1.0.0",
    "node-libs-browser": "^0.5.2",
    "npm-check-updates": "2.5.6",
    "opn": "3.0.3",
    "proxrox": "^1.4.0",
    "proxyquire": "^1.4.0",
    "raw-loader": "^0.5.1",
    "run-sequence": "^1.1.2",
    "sinon": "^1.14.1",
    "sinon-chai": "^2.8.0",
    "style-loader": "^0.8.3",
    "url-loader": "^0.5.5",
    "webpack": "^1.5.3",
    "webpack-dev-server": "^1.7.0"
  },
  "publishConfig": {
    "registry": "https://repo-internal.instana.io/nexus/content/repositories/instana-npm-releases/"
  }
}

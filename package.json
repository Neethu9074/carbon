{
  "name": "in-client",
  "version": "1.0.0",
  "description": "Instana core frontend",
  "main": "index.js",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "./build/postInstall",
    "clean": "gulp clean",
    "build": "export BUILD_DEV='false' && gulp build",
    "try-build": "export BUILD_DEV='false' && gulp try-build",
    "test": "npm run test:unit && npm run test:lint && npm run test:flow",
    "test:lint": "eslint --ext .es6 in-* gulpfile.js",
    "test:unit": "export IS_TEST='true' && gulp prepareTestExecution && mocha --require ./build/testHarness --reporter dot $(find in-* -name '*_test.es6')",
    "test:flow": "flow; test $? -eq 0 -o $? -eq 2",
    "dev": "export BUILD_DEV='true' && export NODE_ENV='development' && gulp dev",
    "translateIconRegistry": "node in-components/SvgIcon/registryTranslator.js",
    "check-updates": "ncu",
    "check-licenses": "license-checker > licenses.txt",
    "check-bundle-size": "npm run build && source-map-explorer target/assets/bundle/index.js target/assets/bundle/index.js.map",
    "generateMetricOverview": "GENERATE_METRIC_OVERVIEW=true npm run test:unit",
    "precommit": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/instana/in-client.git"
  },
  "author": "Ben Ripkens <ben@instana.com>",

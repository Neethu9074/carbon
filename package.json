{
  "name": "in-client",
  "version": "1.0.0",
  "description": "Instana core frontend",
  "main": "index.js",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "./build/postInstall",
    "clean": "gulp clean",
    "build": "export BUILD_DEV='false' && gulp build",
    "try-build": "export BUILD_DEV='false' && gulp try-build",
    "test": "npm run execute-tests && npm run lint",
    "lint": "eslint --ext .es6 in-* gulpfile.js",
    "check-style": "jscs --preset=airbnb $(find in-* -name '*.es6')",
    "execute-tests": "export IS_TEST='true' && gulp prepareTestExecution && mocha --require ./build/testHarness --reporter dot $(find in-* -name '*_test.es6')",
    "dev": "export BUILD_DEV='true' && export NODE_ENV='development' && gulp dev",
    "translateIconRegistry": "node in-components/SvgIcon/registryTranslator.js",
    "check-updates": "ncu",
    "check-licenses": "license-checker > licenses.txt",
    "check-bundle-size": "npm run build && source-map-explorer target/assets/bundle/index.js target/assets/bundle/index.js.map"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    },
    "ghooks": {
      "pre-commit": "npm test"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/instana/in-client.git"
  },
  "author": "Ben Ripkens <ben@instana.com>",
  "dependencies": {
    "d3-format": "1.0.2",
    "fbjs": "0.8.3",
    "hammerjs": "^2.0.4",
    "highlight.js": "9.3.0",
    "immutable": "^3.8.1",
    "instalog": "^1.0.0",
    "instana-ui-theme": "^1.8.0",
    "invariant": "^2.2.1",
    "koijs": "^0.2.0",
    "lex": "1.7.9",
    "lodash": "^4.15.0",
    "markdown-it": "^7.0.0",
    "markdown-it-link-target": "^1.0.1",
    "moment": "^2.14.1",
    "react": "^15.3.1",
    "react-addons-perf": "15.3.1",
    "react-addons-pure-render-mixin": "^15.3.1",
    "react-day-picker": "^2.4.1",
    "react-dom": "^15.3.1",
    "react-immutable-proptypes": "^2.1.0",
    "react-infinite": "0.9.2",
    "react-motion": "^0.4.4",
    "react-router": "^2.8.0",
    "reactive-observables": "^1.32.0",
    "roemitter": "^2.0.0",
    "socket.io-client": "1.4.8",
    "three": "^0.81.0",
    "tween.js": "^15.0.0"
  },
  "devDependencies": {
    "autoprefixer": "6.3.6",
    "babel": "^6.0.0",
    "babel-cli": "^6.0.0",
    "babel-core": "^6.0.0",
    "babel-loader": "^6.0.0",
    "babel-preset-es2015": "^6.0.0",
    "babel-preset-react": "^6.0.0",
    "babel-preset-stage-2": "^6.0.0",
    "case-sensitive-paths-webpack-plugin": "1.1.3",
    "chai": "^3.0.0",
    "chai-string": "^1.1.2",
    "chai-subset": "^1.0.1",
    "css-loader": "^0.19.0",
    "cz-conventional-changelog": "1.1.4",
    "del": "^2.0.2",
    "eslint": "^1.1.0",
    "eslint-config-instana": "^3.0.0",
    "eslint-plugin-instana-import-order": "^1.0.0",
    "eslint-plugin-mocha": "^1.0.0",
    "eslint-plugin-react": "^2.5.2",
    "express": "4.14.0",
    "extract-text-webpack-plugin": "^0.8.2",
    "file-loader": "^0.8.1",
    "ghooks": "^1.0.3",
    "gulp": "^3.8.10",
    "gulp-cssnano": "2.0.0",
    "gulp-size": "^2.0.0",
    "gulp-util": "^3.0.3",
    "html-loader": "^0.3.0",
    "image-webpack-loader": "^1.6.1",
    "inquirer": "^0.9.0",
    "instana-nodejs-sensor": "1.13.0",
    "jscs": "2.11.0",
    "jsdom": "^2.0.0",
    "json-loader": "0.5.4",
    "less": "^2.3.1",
    "less-loader": "^2.0.0",
    "license-checker": "5.0.1",
    "markdown-loader": "^0.1.3",
    "meta-marked-loader": "1.1.0",
    "mkdirp": "^0.5.1",
    "mocha": "^2.2.4",
    "mocha-jsdom": "^1.0.0",
    "node-libs-browser": "^0.5.2",
    "npm-check-updates": "2.5.6",
    "opn": "3.0.3",
    "postcss-loader": "0.9.1",
    "proxrox": "^1.12.2",
    "proxyquire": "^1.4.0",
    "raw-loader": "^0.5.1",
    "run-sequence": "^1.1.2",
    "sinon": "^1.14.1",
    "sinon-chai": "^2.8.0",
    "source-map-explorer": "1.3.0",
    "style-loader": "^0.8.3",
    "url-loader": "^0.5.5",
    "webpack": "^1.5.3",
    "webpack-dashboard": "latest",
    "webpack-dev-middleware": "1.6.1",
    "webpack-dev-server": "^1.7.0"
  },
  "publishConfig": {
    "registry": "https://repo-internal.instana.io/nexus/content/repositories/instana-npm-releases/"
  }
}

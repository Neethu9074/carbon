{
  "name": "ui-client",
  "version": "1.0.0",
  "description": "Instana's Product Frontend",
  "main": "index.js",
  "license": "UNLICENSED",
  "scripts": {
    "clean": "gulp clean",
    "build": "BUILD_DEV=false node --max-old-space-size=4096 node_modules/.bin/gulp build",
    "try-build": "cd target && yarn && cd .. && BUILD_DEV=false gulp try-build",
    "test": "yarn run test:unit && yarn run test:typecheck && yarn run test:lint",
    "test:typecheck": "tsc --pretty --project tsconfig.json",
    "test:lint": "eslint --ext '.js,.jsx,.ts,.tsx' gulpfile.js packages",
    "test:lint:quiet": "eslint --ext '.js,.jsx,.ts,.tsx' --quiet gulpfile.js packages",
    "test:unit": "IS_TEST=true gulp prepareTestExecution && IS_TEST=true node --max-old-space-size=4096 ./node_modules/.bin/jest --testTimeout 6000 --reporters jest-simple-dot-reporter --all --ci",
    "test:storybook": "cd storybook && yarn && cd .. && IS_TEST=true gulp prepareTestExecution && IS_TEST=true node --max-old-space-size=4096 ./node_modules/.bin/jest --roots storybook --roots packages --testTimeout 6000 --reporters jest-simple-dot-reporter --all --ci",
    "test:storybook:watch": "yarn test:storybook --watch",
    "test:compression": "ls target/assets/bundle | grep \".js\" | grep -v \".js.map\" | grep -v \".json\" | xargs -I _ terser ./target/assets/bundle/_ -o /dev/null",
    "check:licenses": "build/create-license-report.sh",
    "check:bundle-size": "ANALYZE_BUNDLE=true yarn run build",
    "check:yarn-lock-exists": "./build/precommit/checkYarnLock.js",
    "dev": "yarn && BUILD_DEV=true NODE_ENV=development node --max-old-space-size=4096 node_modules/gulp/bin/gulp.js dev",
    "debug": "DETAILED_SOURCEMAPS=true DONT_OPEN_BROWSER=true && yarn dev",
    "start": "yarn dev",
    "dev:watch": "HOT_RELOAD=true yarn dev",
    "storybook": "BUILD_DEV=true NODE_ENV=development gulp prepareTestExecution && cd storybook && yarn install && yarn run foundation-build-copy && DEV_TOOLS=eval STORYBOOK=true BUILD_DEV=true NODE_ENV=development node --max-old-space-size=4096 node_modules/.bin/storybook dev -p 9001 -c config --no-version-updates",
    "storybookBuild": "gulp prepareTestExecution && cd storybook && yarn install && yarn run foundation-build-copy && node --max-old-space-size=4096 node_modules/.bin/storybook build -c config -o ../storybookTarget",
    "generateMetricOverview": "GENERATE_METRIC_OVERVIEW=true yarn run test:unit",
    "reformat": "prettier --write \"packages/**/*.{js,ts,tsx,less,mless,css}\"",
    "postinstall": "./build/postInstall"
  },
  "lint-staged": {
    "{(!(packages)/**/*.js),*.js}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "packages/**/*.js": [
      "./build/cli-tools/node_modules/.bin/import-sort --write",
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,mless,less}": [
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "./build/cli-tools/node_modules/.bin/import-sort --write",
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ]
  },
  "importSort": {
    ".js, .jsx, .es6, .es, .mjs, .ts, .tsx": {
      "style": "@instana/import-sort-style-simon"
    },
    ".ts, .tsx": {
      "style": "@instana/import-sort-style-simon",
      "parser": "import-sort-parser-typescript"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.ibm.com/instana/ui-client.git"
  },

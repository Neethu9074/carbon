{
  "name": "ui-client",
  "version": "1.0.0",
  "description": "Instana's Product Frontend",
  "main": "index.js",
  "license": "UNLICENSED",
  "scripts": {
    "clean": "gulp clean",
    "build": "export BUILD_DEV='false' && node --max-old-space-size=4096 node_modules/.bin/gulp build",
    "try-build": "export BUILD_DEV='false' && gulp try-build",
    "test": "yarn run test:unit && yarn run test:lint",
    "test:lint:typescript": "tsc --pretty --project tsconfig.json",
    "test:lint": "yarn run test:lint:typescript && eslint --ext '.js,.jsx,.ts,.tsx' gulpfile.js packages",
    "test:lint:quiet": "yarn run test:lint:typescript && eslint --ext '.js,.jsx,.ts,.tsx' --quiet gulpfile.js packages",
    "test:unit": "export IS_TEST='true' && gulp prepareTestExecution && node --max-old-space-size=4096 ./node_modules/.bin/jest --testTimeout 6000 --reporters jest-simple-dot-reporter --all --ci",
    "test:compression": "ls target/assets/bundle | grep \".js\" | grep -v \".js.map\" | grep -v \".json\" | xargs -I _ terser ./target/assets/bundle/_ -o /dev/null",
    "check:licenses": "build/create-license-report.sh",
    "check:bundle-size": "ANALYZE_BUNDLE=true yarn run build",
    "check:yarn-lock-exists": "./build/precommit/checkYarnLock.js",
    "dev": "unset npm_config_registry && yarn && export BUILD_DEV='true' && export NODE_ENV='development' && node --max-old-space-size=4096 node_modules/gulp/bin/gulp.js dev",
    "start": "yarn dev",
    "storybook": "cd storybook && unset npm_config_registry && yarn && cd .. && export STORYBOOK='true' && export BUILD_DEV='true' && export NODE_ENV='development' && gulp prepareTestExecution && export DEV_TOOLS='eval' && node --max-old-space-size=4096 ./storybook/node_modules/.bin/start-storybook -p 9001 -c storybook/config --no-version-updates",
    "storybookTest": "yarn run storybookBuild ; cd storybook ; export STORYBOOK='true' && yarn chromatic -d ../storybookTarget --list --exit-zero-on-changes",
    "storybookBuild": "cd storybook && unset npm_config_registry && yarn && cd .. && export STORYBOOK='true' && gulp prepareTestExecution && node --max-old-space-size=4096 ./storybook/node_modules/.bin/build-storybook -c storybook/config -o storybookTarget",
    "reformat": "prettier --write \"packages/**/*.{js,ts,tsx,less,mless,css}\"",
    "postinstall": "./build/postInstall",
    "precommit": "yarn run check:yarn-lock-exists && lint-staged && yarn test:lint:typescript && yarn run test:unit && git add README.md "
  },
  "lint-staged": {
    "{(!(packages)/**/*.js),*.js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.js": [
      "./build/cli-tools/node_modules/.bin/import-sort --write",
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,mless,less}": [
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "./build/cli-tools/node_modules/.bin/import-sort --write",
      "echo",
      "eslint --fix",
      "prettier --write"
    ]
  },
  "importSort": {
    ".js, .jsx, .es6, .es, .mjs, .ts, .tsx": {
      "style": "@instana/import-sort-style-simon"
    },
    ".ts, .tsx": {
      "style": "@instana/import-sort-style-simon",
      "parser": "import-sort-parser-typescript"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/instana/ui-client.git"
  },
  "dependencies": {
    "@instana/components": "^1.29.2",
    "@instana/format-date": "^1.1.7",
    "@instana/format-numbers": "^1.1.1",
    "@instana/hooks": "^1.4.7",

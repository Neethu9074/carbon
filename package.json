{
  "name": "in-client",
  "version": "1.0.0",
  "description": "Instana core frontend",
  "main": "index.js",
  "license": "UNLICENSED",
  "scripts": {
    "clean": "gulp clean",
    "cleanup-flow": "flow stop && rimraf /tmp/flow",
    "build": "export BUILD_DEV='false' && gulp build",
    "try-build": "export BUILD_DEV='false' && gulp try-build",
    "test": "yarn run test:unit && yarn run test:lint && yarn run test:flow",
    "test:lint": "eslint --ext .es6 gulpfile.js packages",
    "test:unit": "export IS_TEST='true' && gulp prepareTestExecution && mocha --timeout 6000 --max-old-space-size=4096 --require ./packages/in-test/testHarness --reporter dot $(find packages -name '*_test.es6')",
    "test:flow": "flow check",
    "check:licenses": "license-checker --production > licenses.txt",
    "check:bundle-size": "yarn run build && source-map-explorer target/assets/bundle/index.js target/assets/bundle/index.js.map",
    "check:yarn-lock-exists": "./build/precommit/checkYarnLock.js",
    "dev": "yarn && export BUILD_DEV='true' && export NODE_ENV='development' && node --max-old-space-size=4096 node_modules/gulp/bin/gulp.js dev",
    "storybook": "export BUILD_DEV='true' && export NODE_ENV='development' && gulp prepareTestExecution && start-storybook -p 9001 -c storybook/config",
    "storybookBuild": "gulp prepareTestExecution && build-storybook -c storybook/config -o storybookTarget",
    "translateIconRegistry": "node packages/in-components/SvgIcon/registryTranslator.js",
    "generateMetricOverview": "GENERATE_METRIC_OVERVIEW=true yarn run test:unit",
    "reformat": "prettier --single-quote --print-width 120 --write \"packages/**/*.{es6,less}\"",
    "postinstall": "./build/postInstall",
    "precommit": "yarn run check:yarn-lock-exists && yarn run test:unit && markdown-toc -i README.md && git add README.md && lint-staged"
  },
  "lint-staged": {
    "*.es6": [
      "eslint --ext .es6",
      "prettier --single-quote --print-width 120 --write",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/instana/in-client.git"
  },
  "author": "Ben Ripkens <ben@instana.com>",
  "dependencies": {
